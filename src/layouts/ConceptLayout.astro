---
/**
 * VISUAILS — de kale laag onder de conceptpagina's (/concept/*). 6 september 2026.
 *
 * WAAROM NIET Layout.astro. Lucas: *"Ik wil echt een gehele nieuwe look niet
 * wat er nu staat. Alles mag helemaal nieuw."* Layout.astro draagt de header, de
 * voet, de proefkaart, de cookiebalk en 5.000 regels global.css — precies de
 * look die hier ter discussie staat. Deze laag draagt alleen wat elk concept
 * nodig heeft en verder niets: de fonts, de twee merksymbolen, de kleurfamilie
 * uit KLEURENSCHEMA.md en een reset. Elk concept tekent zijn eigen navigatie,
 * zijn eigen voet en zijn eigen ritme.
 *
 * DE MERKSYMBOLEN WORDEN NIET OVERGETYPT. De paden van het woordmerk en de V
 * staan op precies één plek, in Layout.astro; hier worden ze bij de build uit
 * dat bestand gelezen. Dat kan omdat de conceptpagina's statisch zijn (de site
 * is `output: 'static'`; alleen de account-, admin- en api-routes draaien op de
 * Worker). Verandert het merk, dan verandert het hier mee — en de regel "nooit
 * zelf logo's maken" blijft staan.
 *
 * WAT ER NIET IN ZIT, EXPRES: geen ClientRouter, geen consent, geen analytics,
 * geen proefkaart. Het zijn voorbeelden om uit te kiezen, geen publieke pagina's.
 * `noindex` staat erop en de sitemap slaat /concept/ over (zie sitemap-and-404).
 */
import fs from 'node:fs';
import path from 'node:path';
/* DE LETTERS VAN DE NIEUWE STIJL (7 september 2026). Lucas: *"Pas de fonts wel
   aan naar eentje die er beter op aansluit, zoek online naar niche open source
   fonts."* Drie variabele, open source families — alle drie met een breedte-as,
   zodat de regel "nadruk is breedte" overal werkt:
     · Anybody (OFL, Etienne Aubert Bonn / ANRT) — de kop. Vlakke uiteinden,
       vierkante rondingen, breedte 50–150%. Technischer dan Hubot Sans en
       precies de alien-achtige snit die je zoekt.
     · Instrument Sans (OFL, Rodrigo Fuenzalida & Jordan Egstad) — de lopende
       tekst. Rustige neo-grotesk, breedte 75–100%.
     · Martian Mono (OFL, Evil Martians) — de labels. Een echte machineletter
       met een breedte-as van 75 tot 112,5%.
   Alle drie zelf gehost via @fontsource-variable; geen enkele externe verbinding. */
import '@fontsource-variable/anybody/standard.css';
import '@fontsource-variable/instrument-sans/standard.css';
import '@fontsource-variable/martian-mono/standard.css';

const laag = fs.readFileSync(path.resolve('src/layouts/Layout.astro'), 'utf8');
const symbool = (id: string) => {
  const m = laag.match(new RegExp(`<symbol id="${id}" viewBox[\\s\\S]*?</symbol>`));
  if (!m) throw new Error(`ConceptLayout: <symbol id="${id}"> niet gevonden in Layout.astro`);
  /* De Astro-commentaren {/* … *\/} in het symbool zijn geen HTML; weg ermee. */
  return m[0].replace(/\{\/\*[\s\S]*?\*\/\}/g, '');
};
const SYMBOLEN = `<svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">${symbool('wordmark')}${symbool('markglyph')}</svg>`;

const { title, description, lang = 'nl', grond = 'vel' } = Astro.props as {
  title: string; description: string; lang?: 'en' | 'nl'; grond?: 'vel' | 'wit' | 'inkt' | 'zaal';
};
---
<!doctype html>
<html lang={lang} data-grond={grond}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={`https://visuails.com/img/og-${lang}.png`} />
  <link rel="canonical" href={`https://visuails.com${Astro.url.pathname}`} />
  <meta name="robots" content="noindex, nofollow" />
  <meta name="color-scheme" content="light" />
  <link rel="icon" href="/favicon.ico" sizes="32x32" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
</head>
<body>
  <Fragment set:html={SYMBOLEN} />
  <slot />
</body>
</html>

<style is:global>
  /* ── DE FAMILIE, uit KLEURENSCHEMA.md — nergens anders vandaan ─────────── */
  :root {
    --vel: #F5F5F5; --wit: #FFFFFF; --inkt: #111111;
    --inkt-2: #454545; --inkt-3: #6E6E6E; --lijn: #DFDFDF; --lijn-sterk: #BDBDBD;
    --geel: #D2E04A; --geel-dim: #B8CC46; --geel-letter: #E4F474; --gloed: #9EB42F;
    --tint: rgb(210 224 74 / .14);
    --kop: "Anybody Variable", "Helvetica Neue", Arial, sans-serif;
    --tekst: "Instrument Sans Variable", "Helvetica Neue", Arial, sans-serif;
    --mono: "Martian Mono Variable", ui-monospace, "SFMono-Regular", Menlo, monospace;
    --x: clamp(1.25rem, 5.5vw, 6.5rem);
    --uit: cubic-bezier(.16, 1, .3, 1);
  }
  *, *::before, *::after { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; }
  body { margin: 0; overflow-x: clip; font-family: var(--tekst); font-size: 1rem; line-height: 1.55; color: var(--inkt); background: var(--vel); -webkit-font-smoothing: antialiased; }
  html[data-grond="wit"] body { background: var(--wit); }
  /* "zaal": de koele wand van een tentoonstellingsruimte. Gemeten op
     gentlemonster.com (6 sep 2026): hun grond is rgb(243,244,246) — een wit met
     een kleine koele slag, niet ons neutrale #F5F5F5. */
  html[data-grond="zaal"] body { background: #F3F4F6; }
  html[data-grond="inkt"] body { background: var(--inkt); color: var(--vel); }
  img { display: block; max-width: 100%; height: auto; }
  a { color: inherit; text-decoration: none; }
  h1, h2, h3, p, ul, ol, figure, table { margin: 0; }
  ul, ol { padding: 0; list-style: none; }
  table { border-collapse: collapse; width: 100%; }
  button { font: inherit; color: inherit; background: none; border: 0; padding: 0; cursor: pointer; }
  :focus-visible { outline: 2px solid currentColor; outline-offset: 4px; }
  ::selection { background: var(--geel); color: var(--inkt); }

  /* ── DE TWEE STEMMEN ────────────────────────────────────────────────────── */
  /* Martian Mono is een brede letter; op 82% blijft een lang label op één regel. */
  .mono { font-family: var(--mono); font-size: .75rem; font-weight: 400; font-stretch: 82%; letter-spacing: .04em; text-transform: uppercase; line-height: 1.4; }
  .kop { font-family: var(--kop); font-weight: 500; line-height: .96; letter-spacing: -.03em; text-wrap: balance; }
  .kop-smal { font-stretch: 78%; }
  .kop-breed { font-stretch: 125%; }
  .lopend { max-width: 34em; text-wrap: pretty; }

  /* Het accentwoord: een geel blok op kaphoogte, inkt erop — nooit gele letters
     op wit (DESIGN.md §21). Op inkt is het accentwoord wél een letter, in het
     lichtere lime dat Komma op zwart zet. */
  em { font-style: normal; background: linear-gradient(var(--geel), var(--geel)) no-repeat 0 .27em / 100% .9em; padding-inline: .04em; }
  .op-inkt em { background: none; color: var(--geel-letter); padding: 0; }

  /* ── DE KNOP: een pil, mono, één van twee ───────────────────────────────── */
  .knop { display: inline-flex; align-items: center; gap: .6em; min-height: 42px; padding: 0 1.35rem; border-radius: 999px; border: 1px solid currentColor; font-family: var(--mono); font-size: .72rem; letter-spacing: .06em; text-transform: uppercase; white-space: nowrap; transition: background-color .25s var(--uit), color .25s var(--uit), border-color .25s var(--uit); }
  .knop:hover { background: var(--inkt); color: var(--vel); border-color: var(--inkt); }
  .op-inkt .knop:hover { background: var(--vel); color: var(--inkt); border-color: var(--vel); }
  .knop-geel { background: var(--geel); border-color: var(--geel); color: var(--inkt); }
  .knop-geel:hover { background: var(--inkt); border-color: var(--inkt); color: var(--geel-letter); }
  .op-geel .knop:hover { background: var(--inkt); color: var(--geel-letter); border-color: var(--inkt); }
  .op-geel .knop-inkt { background: var(--inkt); border-color: var(--inkt); color: var(--geel-letter); }
  .op-geel .knop-inkt:hover { background: transparent; color: var(--inkt); }

  /* De pijl-link: tekst met een pijl die op hover uitschuift. */
  .pijl { display: inline-flex; align-items: center; gap: .5em; font-family: var(--mono); font-size: .72rem; letter-spacing: .06em; text-transform: uppercase; }
  .pijl::after { content: "→"; display: inline-block; transition: transform .3s var(--uit); }
  .pijl:hover::after { transform: translateX(.35em); }

  /* Het merk. Beide symbolen erven `color`; nooit samen in één ouder onder <body>
     (brand-lockup-guard). */
  .merkteken { display: block; width: auto; height: 22px; aspect-ratio: 702 / 813.25; fill: currentColor; }
  .woordmerk { display: block; width: 100%; height: auto; aspect-ratio: 1650 / 278; fill: currentColor; }

  /* ── BEWEGING: één maat, één curve ──────────────────────────────────────── */
  .rijst { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: no-preference) {
    .rijst { animation: rijst 1.1s var(--uit) both; animation-timeline: view(); animation-range: entry 0% entry 35%; }
    @keyframes rijst { from { opacity: 0; transform: translateY(18px); } }
    @supports not (animation-timeline: view()) { .rijst { animation: none; } }
  }
  .visueel-verborgen { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
</style>
