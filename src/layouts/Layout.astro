    transition: border-color .2s var(--ease), background .2s var(--ease); }
  .wa-launcher:hover { border-color: var(--ink-3); background: var(--surface-2); }
  .wa-launcher-i { width: 20px; height: 20px; flex: 0 0 auto; fill: none; stroke: currentColor; stroke-width: 1.7; }
  .wa-launcher-label { max-width: 0; overflow: hidden; opacity: 0;
