---
// VISUAILS — root layout. Ports the SvelteKit v2 +layout.svelte chrome
// (header/nav, mobile nav, footer, grain overlay, conversion bar) to Astro.
// <ClientRouter /> turns this into an SPA-like app with native browser
// View Transitions between pages — see src/scripts/interactions.js for the
// astro:page-load re-init hook that keeps reveal/magnetic/etc. working
// after a transition.
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
// Self-hosted Archivo (Fontsource) — served from our own build instead of
// Google's servers (AVG/GDPR-clean, no third-party connection). Same weights
// as the previous Google Fonts request so rendering is identical. font-display
// is 'swap' by default in Fontsource, matching the old &display=swap.
import '@fontsource/archivo/400.css';
import '@fontsource/archivo/500.css';
import '@fontsource/archivo/600.css';
import '@fontsource/archivo/700.css';
import '@fontsource/archivo/800.css';
import '@fontsource/archivo/900.css';
import '@fontsource/archivo/400-italic.css';
import '@fontsource/archivo/700-italic.css';
import { ui, dropHrefs, brandModelHref, ogLocale, localeNames, getLangFromPath, stripLang, localizedPath, useTranslations } from '../i18n/ui.js';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  noindex?: boolean;
}

// noindex is for the pages that exist to be arrived at, not found. Two use it:
// /thank-you and /nl/thank-you. Both were shipping `index, follow` while being
// absent from sitemap.xml — a contradiction search engines resolve in favour of
// the meta tag, which is the wrong way round. A thank-you page in the results
// costs a real conversion every time someone lands on it cold.
//
// The order-status lookup used to be the third. It is gone: /order-status is a
// 301 to the client portal at /o, which is a Pages Function and never renders
// through this layout. The portal sets its own, stricter headers —
// `noindex, nofollow, noarchive` as a meta tag AND an x-robots-tag response
// header, because a portal URL contains a token and a meta tag alone is only
// read by something that parses HTML. See src/lib/portal.js.
const { title, description, ogImage = '/img/banners-05.webp', noindex = false } = Astro.props;

// Privacy-first analytics. Cloudflare Web Analytics is cookieless and needs no
// consent banner (AVG/GDPR-clean). To switch it on: create a Web Analytics site
// in the Cloudflare dashboard, copy the token, and paste it below — the beacon
// only renders when a token is present, so the site ships analytics-ready with
// nothing loading until you opt in. Custom events (CTA clicks, "how did you
// find us?") are wired via track() in interactions.js and start reporting the
// moment a tool that supports them (e.g. Plausible/Umami) is added.
const CF_ANALYTICS_TOKEN = '';

// Language is derived from the URL: /nl/... → Dutch, else English.
const path = Astro.url.pathname;
const lang = getLangFromPath(path);
const t = useTranslations(lang);
const lp = (p: string) => localizedPath(lang, p);   // localize a base path for this language
const base = stripLang(path);                        // language-neutral path (for switcher + hreflang)

const drops = (ui[lang] || ui.en).drops.map((s: string[], i: number) => ({ href: dropHrefs[i], title: s[0], desc: s[1] }));

const isActive = (href: string) => (href === '/' ? base === '/' : base === href || base.startsWith(href + '/'));
const year = new Date().getFullYear();

// SEO — absolute canonical + OG image built off the configured site origin.
const SITE = 'https://visuails.com';
const canonical = new URL(lp(base), Astro.site ?? SITE).href;
const ogImageAbs = new URL(ogImage, Astro.site ?? SITE).href;

// hreflang alternates — the same page in each language, x-default → English.
const alternates = [
  { hreflang: 'en', href: new URL(base, Astro.site ?? SITE).href },
  { hreflang: 'nl', href: new URL(localizedPath('nl', base), Astro.site ?? SITE).href },
  { hreflang: 'x-default', href: new URL(base, Astro.site ?? SITE).href },
];
const switchLangs = ['en', 'nl'];

// The language switcher used to carry two 15x11 inline-SVG national flags.
// They were the last saturated colour in the site chrome — a Union Jack and a
// Dutch tricolour beside an ink-and-paper interface where the photography is
// meant to be the only colour on screen. The switcher already renders the
// locale abbreviation (EN / NL from localeNames), which is unambiguous, needs
// no flag-to-language mapping, and does not equate a language with a country.

// Structured data. The description used to end "delivered in about 24 hours".
// Section 13 of the brief removes every named delivery promise from anything
// that is not a capacity-gated Tier 1 order, and structured data is read by
// search engines and quoted back in results — it is the last place a stale
// promise should survive. It now says what the studio makes, not how fast.
const orgJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'VISUAILS',
  description:
    'Product-visual studio for clothing brands and modern e-commerce: catalog, lifestyle and video visuals built from a single product photo — a whole drop, or one product at a time.',
  url: SITE,
  logo: `${SITE}/img/logo-mark.webp`,
  image: `${SITE}/img/banners-09.webp`,
  email: 'hello@visuails.com',
  telephone: '+31625436130',
  priceRange: '€€',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Enschede',
    addressCountry: 'NL',
  },
  areaServed: 'Worldwide',
  sameAs: ['https://wa.me/31625436130'],
};
---

<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" href="/favicon.ico" sizes="32x32" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
  <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
  <meta name="theme-color" content="#F6F5F2" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImageAbs} />
  <meta property="og:url" content={canonical} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="VISUAILS" />
  <meta property="og:locale" content={ogLocale[lang]} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageAbs} />
  <script type="application/ld+json" set:html={JSON.stringify(orgJsonLd)} />
  <noscript>
    <style>
      /* Without JS the IntersectionObserver never runs, so force every
         reveal/split element to its visible state — crawlers and JS-off
         users see full content, not blank sections. */
      .reveal.pending, .split-word, .rm-inner { opacity: 1 !important; transform: none !important; }
      .cmp .cmp-after { animation: none !important; clip-path: inset(0 0 0 50%) !important; }
    </style>
  </noscript>
  <ClientRouter />
</head>
<body>
  <!-- SVG sprite — product-scene placeholder symbols, the chrome gradients and
       the outlined logotype. The product-scene gradient
       stops were blue-grey (#b7c0d1 / #8591a8 / #525d75); they are now cut from
       the same ink ramp as the interface, so the placeholder object reads as an
       unlit neutral form rather than a second, competing colour temperature.
       The white fills below are specular highlights on the object and stay
       white — that is how a lit surface behaves, not a palette leak. -->
  <svg width="0" height="0" style="position:absolute" aria-hidden="true">
    <defs>
      <linearGradient id="gObj" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#B0B1B4"/><stop offset="0.5" stop-color="#7F8083"/><stop offset="1" stop-color="#4C4D4F"/>
      </linearGradient>
      <linearGradient id="gGlass" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#D3D4D6" stop-opacity="0.97"/><stop offset="1" stop-color="#797A7D" stop-opacity="0.9"/>
      </linearGradient>
      <!-- Chrome, the logotype calibration. DESIGN.md's twelve stops are tuned
           for a SURFACE (the hero plane), where a band going nearly black on a
           nearly black ground is a reflection. A 17px word is not a surface:
           measured post --chrome-filter, the spec ramp puts 7 of 12 stops under
           3:1 on paper and 2 under 3:1 on ink, i.e. holes in the letterforms.
           These two keep the spec's stop positions, hues and all eight
           lightness reversals, with lightness remapped per ground.
           They are solved to 3.25:1, not to the 3:1 floor. The 0.25 is not
           padding: it is the gap between the model and the browser — three
           decimals of oklch, the browser's own conversion, gradient
           interpolation, 8-bit quantisation. Solved at exactly 3.0 the paper
           ramp measured 2.97:1 on the rendered mark, which is a fail by less
           than the rounding and a fail all the same. Same material, two
           calibrations, because one ground is light and one is dark. -->
      <linearGradient id="chromeInk" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="1646" y2="441">
        <stop offset="0%" stop-color="oklch(0.789 0.004 265)"/>
        <stop offset="9%" stop-color="oklch(0.905 0.006 265)"/>
        <stop offset="17%" stop-color="oklch(0.687 0.008 265)"/>
        <stop offset="26%" stop-color="oklch(0.948 0.003 250)"/>
        <stop offset="35%" stop-color="oklch(0.745 0.010 265)"/>
        <stop offset="44%" stop-color="oklch(0.564 0.006 265)"/>
        <stop offset="53%" stop-color="oklch(0.868 0.005 250)"/>
        <stop offset="62%" stop-color="oklch(0.970 0.002 85)"/>
        <stop offset="71%" stop-color="oklch(0.643 0.009 265)"/>
        <stop offset="80%" stop-color="oklch(0.818 0.004 265)"/>
        <stop offset="89%" stop-color="oklch(0.520 0.007 265)"/>
        <stop offset="100%" stop-color="oklch(0.709 0.012 265)"/>
      </linearGradient>
      <linearGradient id="chromePaper" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="1646" y2="441">
        <stop offset="0%" stop-color="oklch(0.394 0.004 265)"/>
        <stop offset="9%" stop-color="oklch(0.539 0.006 265)"/>
        <stop offset="17%" stop-color="oklch(0.268 0.008 265)"/>
        <stop offset="26%" stop-color="oklch(0.593 0.003 250)"/>
        <stop offset="35%" stop-color="oklch(0.340 0.010 265)"/>
        <stop offset="44%" stop-color="oklch(0.114 0.006 265)"/>
        <stop offset="53%" stop-color="oklch(0.494 0.005 250)"/>
        <stop offset="62%" stop-color="oklch(0.620 0.002 85)"/>
        <stop offset="71%" stop-color="oklch(0.214 0.009 265)"/>
        <stop offset="80%" stop-color="oklch(0.430 0.004 265)"/>
        <stop offset="89%" stop-color="oklch(0.060 0.007 265)"/>
        <stop offset="100%" stop-color="oklch(0.295 0.012 265)"/>
      </linearGradient>
      <!-- Same two ramps, second geometry. The monogram is near-square and the
           wordmark is 6:1, so one userSpaceOnUse gradient line cannot serve
           both: at the wordmark's length the whole monogram would sample the
           first third of the ramp and stop being metal. The DIRECTION is
           constant (15deg below horizontal, the surface's 105deg as a vector)
           because the light in this material has one direction; only the
           length changes, and it is the projection of each mark's own box onto
           that direction so the ramp lands inside the artwork rather than
           pad-clamping at a corner. Stops are duplicated, not inherited via
           href: gradient template inheritance is SVG2, its non-Chromium
           support is not something that can be verified here, and the failure
           mode is an invisible logo. Both copies are emitted by
           chrome_ramp.py, so the ramp still has one source. -->
      <linearGradient id="chromeInkMark" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="760" y2="203">
        <stop offset="0%" stop-color="oklch(0.789 0.004 265)"/>
        <stop offset="9%" stop-color="oklch(0.905 0.006 265)"/>
        <stop offset="17%" stop-color="oklch(0.687 0.008 265)"/>
        <stop offset="26%" stop-color="oklch(0.948 0.003 250)"/>
        <stop offset="35%" stop-color="oklch(0.745 0.010 265)"/>
        <stop offset="44%" stop-color="oklch(0.564 0.006 265)"/>
        <stop offset="53%" stop-color="oklch(0.868 0.005 250)"/>
        <stop offset="62%" stop-color="oklch(0.970 0.002 85)"/>
        <stop offset="71%" stop-color="oklch(0.643 0.009 265)"/>
        <stop offset="80%" stop-color="oklch(0.818 0.004 265)"/>
        <stop offset="89%" stop-color="oklch(0.520 0.007 265)"/>
        <stop offset="100%" stop-color="oklch(0.709 0.012 265)"/>
      </linearGradient>
      <linearGradient id="chromePaperMark" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="760" y2="203">
        <stop offset="0%" stop-color="oklch(0.394 0.004 265)"/>
        <stop offset="9%" stop-color="oklch(0.539 0.006 265)"/>
        <stop offset="17%" stop-color="oklch(0.268 0.008 265)"/>
        <stop offset="26%" stop-color="oklch(0.593 0.003 250)"/>
        <stop offset="35%" stop-color="oklch(0.340 0.010 265)"/>
        <stop offset="44%" stop-color="oklch(0.114 0.006 265)"/>
        <stop offset="53%" stop-color="oklch(0.494 0.005 250)"/>
        <stop offset="62%" stop-color="oklch(0.620 0.002 85)"/>
        <stop offset="71%" stop-color="oklch(0.214 0.009 265)"/>
        <stop offset="80%" stop-color="oklch(0.430 0.004 265)"/>
        <stop offset="89%" stop-color="oklch(0.060 0.007 265)"/>
        <stop offset="100%" stop-color="oklch(0.295 0.012 265)"/>
      </linearGradient>
    </defs>
    <symbol id="p-bottle" viewBox="0 0 120 150">
      <rect x="50" y="8" width="20" height="16" rx="3" fill="url(#gObj)"/>
      <rect x="46" y="22" width="28" height="10" rx="2" fill="#B6B7BA"/>
      <path d="M42 34 h36 a10 10 0 0 1 10 10 v82 a12 12 0 0 1 -12 12 h-32 a12 12 0 0 1 -12 -12 v-82 a10 10 0 0 1 10 -10 z" fill="url(#gGlass)"/>
      <rect x="46" y="70" width="28" height="46" rx="6" fill="#ffffff" opacity="0.18"/>
      <rect x="50" y="46" width="7" height="70" rx="3" fill="#ffffff" opacity="0.5"/>
    </symbol>
    <symbol id="p-sneaker" viewBox="0 0 160 110">
