  {/* ── THE CHROME KNOWS WHO IS SIGNED IN ──────────────────────────────────
      Lucas, August 2026: "Als iemand is ingelogd op de site wil ik dat hij ook
      echt op de site is ingelogd." Until now the nav said "Log in" to everyone,
      including a customer with a live session, because this site is
      output:'static' — one build, one HTML file per page, handed unchanged to
      every visitor. There is no request at render time to read a cookie from.
      Session state can therefore only be applied AFTER load, on the client,
      and this is the script that does it.

      WHY IT IS is:inline AND SITS HERE, not in a module at the foot of the
      page. A module is deferred: it runs after the document is parsed, which
      is after the header has painted, which is a visible flash of "Log in" on
      every page for a signed-in customer. An inline script placed directly
      after the markup it edits runs while the parser is still working, before
      that region is painted — so with a warm cache the correct state is the
      first one drawn.

      WHAT SHIPS IS THE SIGNED-OUT STATE, and that is not a compromise: it is
      the only state a static file CAN carry, it is what a crawler and a
      JS-less browser get, and it is correct for the overwhelming majority of
      visitors. Everything here is an enhancement on top of a nav that already
      works.

      ONE FETCH PER PAGE LOAD, AT MOST. window.visAccount() memoises its own
      promise, so /start's pipeline.js asking for the same answer costs nothing
      extra (see bindPrefill there). Between page loads a small snapshot in
      sessionStorage — signed in or not, and the label to draw, never the phone
      number or the VAT number — lets the chrome paint immediately and skip the
      network entirely while it is fresh. Two minutes is short enough that a
      sign-out in another tab corrects itself quickly and long enough that
      clicking through the site is not a request per click: /account/me is rate
      limited per IP, and an office behind one address browsing normally must
      not be able to exhaust that between them. */}
  <script is:inline define:vars={{ accountFresh: 120000 }}>
    (function () {
      if (window.__visAcct) return;
      window.__visAcct = 1;

      var KEY = 'vis_acct';
      var pending = null; // this page load's in-flight/settled request

      function snapshot() {
        try {
          var raw = sessionStorage.getItem(KEY);
          if (!raw) return null;
          var s = JSON.parse(raw);
          if (!s || s.v !== 1) return null;
          return Date.now() - s.at < accountFresh ? s : null;
        } catch (e) { return null; }
      }

      function remember(me) {
        try {
          sessionStorage.setItem(KEY, JSON.stringify({
            v: 1, at: Date.now(), in: !!me, label: me ? (me.label || me.email || '') : '',
          }));
        } catch (e) { /* private mode, quota, disabled — the fetch still works */ }
      }

      function forget() {
        try { sessionStorage.removeItem(KEY); } catch (e) { /* nothing to undo */ }
      }

      /**
       * The one place this site asks who is signed in.
       * Resolves to the /account/me payload, or null for "nobody" — including
       * for a network failure or a 429, because the honest fallback for "we
       * could not tell" is the state that reveals nothing about anyone.
       */
      window.visAccount = function () {
        if (pending) return pending;
        pending = fetch('/account/me', { headers: { Accept: 'application/json' }, credentials: 'same-origin' })
          .then(function (r) { return r.ok ? r.json() : null; })
          .then(function (me) {
            // A 200 with no email is not a session. account.js answers 401 for
            // that and this is the belt to its braces: nothing downstream may
            // treat an empty-but-successful body as someone being signed in.
            var ok = me && typeof me === 'object' && me.email ? me : null;
            remember(ok);
            return ok;
          })
          .catch(function () { return null; });
        return pending;
      };

      /** Draw one state or the other. `label` is only read when signed in. */
      function paint(signedIn, label) {
        var nodes = document.querySelectorAll('[data-acct]');
        for (var i = 0; i < nodes.length; i += 1) {
          nodes[i].hidden = (nodes[i].getAttribute('data-acct') === 'in') !== signedIn;
        }
        if (!signedIn) return;
        var labels = document.querySelectorAll('[data-acct-label]');
        for (var j = 0; j < labels.length; j += 1) labels[j].textContent = label || '';
      }

      function boot() {
        // Signing out has to drop the snapshot with it, or the next page draws
        // a signed-in bar from a cache that outlived the session.
        var outs = document.querySelectorAll('[data-acct-signout]');
        for (var i = 0; i < outs.length; i += 1) outs[i].addEventListener('submit', forget);

        var s = snapshot();
        // Coming back from /account — a fresh sign-in, or a sign-out — makes
        // any snapshot suspect regardless of its age. Ask again.
        var fromAccount = false;
        try {
          fromAccount = !!document.referrer
            && new URL(document.referrer).origin === location.origin
            && new URL(document.referrer).pathname.indexOf('/account') === 0;
        } catch (e) { /* an opaque referrer is simply not a reason to refetch */ }

        if (s && !fromAccount) {
          paint(s.in, s.label);
          return; // fresh enough to trust, so this page load costs no request
        }
        if (s) paint(s.in, s.label); // draw the stale guess, then correct it
        window.visAccount().then(function (me) { paint(!!me, me ? (me.label || me.email) : ''); });
      }

      boot();
      // ClientRouter swaps the whole document on a soft navigation, which
      // replaces the nav nodes this just painted and drops the submit
      // listeners with them. Re-running per page is the same lifecycle every
      // other script in this layout keeps; `pending` survives, so a soft
      // navigation costs no second request at all.
      document.addEventListener('astro:page-load', boot);
    })();
  </script>

