      <path d="M40 46 q10 -4 20 4 l24 18" fill="none" stroke="#ffffff" stroke-opacity="0.55" stroke-width="3"/>
      <path d="M14 92 h132 q0 10 -10 10 H22 q-8 0 -8 -10z" fill="#B6B7BA"/>
      <circle cx="52" cy="60" r="3" fill="#fff" opacity="0.7"/><circle cx="66" cy="68" r="3" fill="#fff" opacity="0.7"/>
    </symbol>
    <symbol id="p-jar" viewBox="0 0 120 130">
      <ellipse cx="60" cy="30" rx="34" ry="12" fill="#B6B7BA"/>
      <rect x="26" y="30" width="68" height="16" fill="#B6B7BA"/>
      <path d="M22 52 h76 v40 a20 20 0 0 1 -20 20 h-36 a20 20 0 0 1 -20 -20 z" fill="url(#gGlass)"/>
      <ellipse cx="60" cy="52" rx="38" ry="12" fill="url(#gObj)"/>
      <ellipse cx="60" cy="50" rx="24" ry="7" fill="#fff" opacity="0.35"/>
    </symbol>
    <symbol id="p-bag" viewBox="0 0 120 130">
      <path d="M40 40 a20 20 0 0 1 40 0" fill="none" stroke="url(#gObj)" stroke-width="6"/>
      <path d="M26 44 h68 l8 74 a6 6 0 0 1 -6 7 H24 a6 6 0 0 1 -6 -7 z" fill="url(#gGlass)"/>
      <rect x="26" y="44" width="68" height="8" fill="#ffffff" opacity="0.25"/>
      <circle cx="60" cy="82" r="7" fill="#fff" opacity="0.4"/>
    </symbol>
    <!-- The logotype, outlined. It was public/img/logo-wordmark-light.webp,
         a near-white raster — which (a) cannot take a gradient fill, so the
         chrome signature had nowhere to live, and (b) had gone invisible the
         moment the palette flipped to a paper ground: #EEF0F6 ink on #F6F5F2
         paper is 1.05:1. The paths below are traced from that exact file
         (99.59% coverage match, no structural deviation), so the letterforms
         are unchanged; only the material they are made of is. The path carries
         no fill attribute on purpose — fill is an inherited SVG property, so
         each <use> site sets it and the same symbol serves both grounds. -->
    <symbol id="wordmark" viewBox="0 0 1646 274">
