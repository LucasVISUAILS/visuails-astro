  @media (max-width: 600px) { .convbar em { display: none; } }

  /* WhatsApp launcher — a square block pinned to the left rail, so it never
     collides with the centred .convbar. 48px hit area at minimum; the label
     expands on pointer devices and stays available to screen readers on
     touch, where only the mark shows. */
  .wa-launcher { position: fixed; left: 20px; --wa-bottom: 20px; bottom: var(--wa-bottom); z-index: var(--z-bar);
    display: inline-flex; align-items: center; justify-content: center;
    width: 48px; height: 48px; padding: 0;
    background: var(--surface); border: 1px solid var(--line-strong); color: var(--ink);
    font-size: .88rem; font-weight: 600; line-height: 1; white-space: nowrap;
    transition: border-color var(--dur-1) var(--ease), background var(--dur-1) var(--ease); border-radius: var(--r-md); }
  .wa-launcher:hover { border-color: var(--ink-3); background: var(--surface-2); }
  /* fill, no stroke — the mark is a solid glyph now, not an outlined bubble.
