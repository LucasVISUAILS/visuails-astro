  <script>
    // Importing runs init() once immediately and registers the
    // astro:page-load listener for every ClientRouter navigation after —
    // see src/scripts/interactions.js. The hero shader is a separate module
    // with its own ClientRouter lifecycle; it no-ops on pages without its hook.
    //
    // ../scripts/motion.js (the GSAP scroll choreography) was imported here and
    // is gone. It was not partly dead — EVERY hook it queried (.hero-cover,
    // .ch-head, [data-spread], [data-zoom], [data-stagger], #develop, .vm-row,
    // .visual-marquee, .comet) appears on zero of the 84 built pages, so all
    // eight of its effects were no-oping while still pulling gsap +
    // ScrollTrigger (~70 KB) into every page. Deleted rather than lazy-loaded:
    // there is no live hook left to lazy-load it FOR. If that markup ever comes
    // back, the choreography has to come back with it — do not re-add this
    // import on its own, it will cost 70 KB and animate nothing.
    import '../scripts/interactions.js';
    /* shader-hero.js is hier weg — 7 augustus 2026. Het chroomveld dat het
     * tekende stond op één sectie van de homepage, en die sectie is herbouwd
     * zonder canvas (zie sectie 18 in HomeV2.astro: het was een tweede
     * ondergrond op een pagina die er één heeft). Het script zocht
     * #hero-shader, vond niets, en stopte netjes — maar het werd wel op alle
     * 84 pagina's opgehaald en uitgevoerd om dat vast te stellen. Zelfde
     * redenering als bij de choreografie hierboven: geen haak meer, dus geen
     * import. Komt het canvas ooit terug, dan komt deze regel ermee terug. */
    // Inertial scrolling. ~3 kB, off entirely under prefers-reduced-motion and
    // on touch; it drives the document's real scrollTop, so the sticky header
    // above and the view()-timeline reveals in global.css are unaffected. The
    // long argument for why a library and not `scroll-behavior: smooth` is at
    // the top of the module.
    import '../scripts/smooth-scroll.js';
  </script>
  {/* THE BEACON IS NOT RENDERED HERE ANY MORE, and that is the whole point of
      the consent banner. A <script> in the HTML fires before any script can
      have an opinion about it, which would make the banner decorative. The
      token is handed to consent.js instead, which appends the beacon only
      after an explicit yes — so "no" and "not answered yet" both mean the
      request is never made. See src/scripts/consent.js. */}
  <script is:inline define:vars={{ token: CF_ANALYTICS_TOKEN }}>
    window.__VIS_CF_TOKEN = token || '';
  </script>
  <script>
    import { initConsent } from '../scripts/consent.js';
    const boot = () => initConsent(window.__VIS_CF_TOKEN);
    boot();
    document.addEventListener('astro:page-load', boot);
  </script>
