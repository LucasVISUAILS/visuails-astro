  @media (max-width: 940px) { .nav-links, .nav-actions .btn, .nav-actions .lang-switch { display: none; } .menu-toggle { display: inline-flex; } }

  .site-footer { position: relative; margin-top: clamp(4.5rem, 9vw, 9rem); padding-block: clamp(3.5rem, 6vw, 5rem) 2.2rem; background: var(--bg-deep); box-shadow: inset 0 1px 0 var(--line); color: var(--ink-2); }
  .footer-grid { display: grid; grid-template-columns: 1.6fr 1fr 1fr 1.2fr; gap: 2rem; }
  @media (max-width: 860px) { .footer-grid { grid-template-columns: 1fr 1fr; gap: 2rem 1.5rem; } }
  @media (max-width: 520px) { .footer-grid { grid-template-columns: 1fr; } }
  .footer-brand p { color: var(--ink-3); font-size: .9rem; margin-top: .8rem; max-width: 34ch; }
  .footer-col h5 { font-family: var(--font-body); font-size: .75rem; letter-spacing: .08em; text-transform: uppercase; color: var(--ink-faint); margin-bottom: 1rem; font-weight: 600; }
  .footer-col ul { display: flex; flex-direction: column; gap: .6rem; list-style: none; margin: 0; padding: 0; }
  .footer-col a { color: var(--ink-2); font-size: .92rem; }
  .footer-col a:hover { color: var(--ink); }
  .footer-bottom { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 1rem; margin-top: 3rem; padding-top: 1.5rem; box-shadow: inset 0 1px 0 var(--line); color: var(--ink-faint); font-size: .82rem; }

  .convbar { position: fixed; left: 50%; bottom: 20px; transform: translateX(-50%) translateY(120%); opacity: 0; z-index: var(--z-bar); display: inline-flex; align-items: center; gap: 12px; padding: 8px 8px 8px 14px; background: var(--ink-900); border: 1px solid var(--line-strong); box-shadow: 6px 6px 0 0 oklch(0.16 0.006 265 / 0.22); max-width: calc(100vw - 24px); transition: transform .4s var(--ease), opacity .4s var(--ease); pointer-events: none; }
  .convbar.show { transform: translateX(-50%) translateY(0); opacity: 1; pointer-events: auto; }
  .convbar .cb-logo { height: 22px; flex: 0 0 auto; }
  .convbar em { font-style: normal; font-size: .92rem; font-weight: 500; color: var(--ink-2); white-space: nowrap; }
  .convbar .cb-cta { background: var(--accent); color: var(--accent-on); padding: 10px 18px; font-size: .9rem; font-weight: 600; white-space: nowrap; }
  .convbar .cb-close { width: 30px; height: 30px; color: var(--ink-3); font-size: 1.1rem; background: none; border: none; cursor: pointer; }
  @media (max-width: 600px) { .convbar em { display: none; } }

  /* WhatsApp launcher — a square block pinned to the left rail, so it never
     collides with the centred .convbar. 48px hit area at minimum; the label
     expands on pointer devices and stays available to screen readers on
     touch, where only the mark shows. */
  .wa-launcher { position: fixed; left: 20px; bottom: 20px; z-index: var(--z-bar);
    display: inline-flex; align-items: center; gap: 0;
    min-width: 48px; min-height: 48px; padding: 0 14px;
    background: var(--surface); border: 1px solid var(--line-strong); color: var(--ink);
