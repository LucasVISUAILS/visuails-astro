<style>
  .site-header { position: sticky; top: 0; z-index: var(--z-sticky); transition: background var(--dur) var(--ease), box-shadow var(--dur) var(--ease); }
  /* The scrolled bar was a translucent dark pane with backdrop-filter: blur(10).
     Both are gone. The blur re-rendered its backdrop every frame while the page
     moved under it — the single most expensive thing in the sticky header — and
     a frosted pane is the glassmorphism default this system rejects. A solid
     paper bar with a hairline under it is cheaper, hard-edged, and legible over
     any content, including a photograph. */
  .site-header.scrolled { background: var(--paper); box-shadow: 0 1px 0 var(--line-strong); }
  .nav { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; height: 76px; }
  .brand { font-family: var(--font-body); font-weight: 800; font-size: 1.26rem; color: var(--ink); display: inline-flex; align-items: center; gap: .5rem; }
  /* The logotype. 13px was smaller than the cap height of the nav labels beside
     it, and at that size the chrome bands are finer than the letter stems — the
     fill reads as dirt, not metal. 17px in a 76px bar is still restrained and
     lets twelve bands resolve across the word. The footer gets 24px because
     that is where the signature has room to be looked at. */
  .brand-word { height: 17px; width: auto; display: block; fill: var(--wordmark-fill); filter: var(--chrome-filter); }
  .site-footer .brand-word { height: 24px; }
  /* The monogram is the same material as the word, so it is the same mechanism:
     a fill-less symbol, a role-alias fill that .on-ink flips, and the chrome
     filter. It replaces logo-mark.webp, which was a cyan-to-periwinkle raster —
     the last saturated colour left on the site after the monochrome pass, and
     measured at 1.39:1 against the mobile drawer's paper ground, i.e. a logo
     you cannot see. A raster also cannot take a gradient fill or flip per
     ground, so this could not be fixed by recolouring the file. */
  .brand-mark { width: auto; display: block; fill: var(--mark-fill); filter: var(--chrome-filter); }
  /* Forced-colours and print both flatten or drop the gradient, so name the
     single-ink fallback rather than letting the mark disappear. */
  @media (forced-colors: active) { .brand-word, .brand-mark { fill: CanvasText; filter: none; } }
  @media print { .brand-word, .brand-mark { fill: #000; filter: none; } }
  .nav-links { display: flex; align-items: center; gap: .1rem; list-style: none; margin: 0; padding: 0; }
  .nav-links > li > a, .nav-trigger { display: inline-flex; align-items: center; gap: .35rem; padding: .55rem .8rem; font-size: .92rem; font-weight: 500; color: var(--ink-2); background: none; border: none; cursor: pointer; transition: color .22s var(--ease); font-family: var(--font-body); }
  .nav-links > li > a:hover, .nav-trigger:hover { color: var(--ink); }
  .nav-links > li > a[aria-current="page"] { color: var(--ink); }
  .nav-actions { display: flex; align-items: center; gap: .6rem; }
  .has-menu { position: relative; }
  .nav-menu { position: absolute; top: calc(100% + 10px); left: 0; min-width: 470px; background: var(--surface); border: 1px solid var(--line); padding: .6rem; display: grid; grid-template-columns: 1fr 1fr; gap: .25rem; opacity: 0; visibility: hidden; transform: translateY(8px); transition: opacity .26s var(--ease), transform .26s var(--ease), visibility .26s; box-shadow: 6px 6px 0 0 oklch(0.16 0.006 265 / 0.16); }
  .has-menu:hover .nav-menu, .has-menu:focus-within .nav-menu, .has-menu.menu-open .nav-menu { opacity: 1; visibility: visible; transform: translateY(0); }
  .nav-menu a { display: flex; flex-direction: column; gap: .15rem; padding: .7rem .85rem; }
  .nav-menu a:hover, .nav-menu a[aria-current="page"] { background: var(--surface-2); }
  .nav-menu .mi-title { color: var(--ink); font-weight: 600; font-size: .92rem; }
  .nav-menu .mi-desc { color: var(--ink-3); font-size: .8rem; line-height: 1.4; }
  .menu-toggle { display: none; width: 44px; height: 44px; align-items: center; justify-content: center; border: 1px solid var(--line-strong); background: none; cursor: pointer; }
  .menu-toggle span, .menu-toggle span::before, .menu-toggle span::after { content: ''; display: block; width: 18px; height: 2px; background: var(--ink); }
  .menu-toggle span::before { transform: translateY(-6px); } .menu-toggle span::after { transform: translateY(4px); }
  .btn-block { width: 100%; }

  /* Language switcher (EN · NL · DE). Desktop version lives in .nav-actions;
     a second copy sits inside the mobile drawer (.mobile-lang). */
  .lang-switch { display: inline-flex; align-items: center; gap: 2px; background: var(--surface); border: 1px solid var(--line-strong); padding: 3px; }
  .lang-switch .ls { display: inline-flex; align-items: center; gap: 5px; font-size: .74rem; font-weight: 700; letter-spacing: .03em; color: var(--ink-3); padding: 4px 9px; transition: color .18s var(--ease), background .18s var(--ease); }
  .lang-switch .ls:hover { color: var(--ink); }
  .lang-switch .ls.on { color: var(--ink); background: var(--accent-soft); box-shadow: inset 0 0 0 1px var(--accent-line); }
  .mobile-lang { align-self: center; margin-top: .5rem; }

  .mobile-nav { position: fixed; inset: 0; z-index: var(--z-modal); background: var(--bg); padding: 90px clamp(1.2rem,5vw,2.5rem) 2rem; transform: translateX(100%); transition: transform .4s var(--ease); overflow-y: auto; }
  .mobile-nav.open { transform: translateX(0); }
  /* Height only. The monogram is 639x655, not square, and the old <img> was
