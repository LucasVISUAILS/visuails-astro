---
/**
 * VISUAILS Studio — de schil van het klantdashboard, als Astro-layout.
 * 5 september 2026, fase 2 van "dashboard en /admin in Astro".
 *
 * WAT DIT VERVANGT. shellBody() en page() in src/lib/account.js: een handgeschreven
 * <html> met een handgekopieerde tokenset (public/account.css, 3.800 regels) die
 * naast de site stond in plaats van erin. Dit bestand laadt DEZELFDE global.css
 * en dezelfde fonts als src/layouts/Layout.astro, dus een token dat op de site
 * verandert, verandert hier mee. Wat Studio erbovenop nodig heeft — de zijbalk,
 * de bovenbalk, de lichte stand — staat in src/styles/studio.css.
 *
 * TWEE STANDEN. `schil` (standaard) is het dashboard mét zijbalk, voor een
 * ingelogde klant. `kaart` is één gecentreerde kaart zonder zijbalk: het
 * inlogscherm, "kijk in je mail", de dode link. Zelfde head, zelfde koppen,
 * andere romp.
 *
 * GEEN JAVASCRIPT, EN DAT IS EEN EIS. De CSP van dit dashboard (studioHeaders in
 * account.js) is default-src 'none' met alleen img/style/font 'self'. Er staat
 * hier dus geen <script>, geen ClientRouter, geen inline stijl. De taal en de
 * inklapstand zijn cookies, gezet via een GET met ?lang= en ?nav= —
 * zie sectionState() in account.js voor de omleiding. (Het thema was er ook een,
 * tot 14 oktober 2026: Studio is nu alleen licht.)
 *
 * DE KOPPEN. Astro laat een pagina zijn eigen antwoordkoppen zetten via
 * Astro.response.headers; dat gebeurt hier in de layout, zodat elke Studio-pagina
 * ze krijgt zonder er zelf aan te denken. no-store, noindex, en de CSP.
 */
import '../styles/global.css';
import { woordmerkSvg } from '../data/wordmarkPath.js';
import { ikoon } from '../data/iconen.js';
/* Levering 57 (17 oktober 2026, v35-studio a): het woordmerk met de elektrische lijn
   onder de muis, zoals op de site (woordmerkSvg; de beweging in global.css, de maten in
   studio-hal.css), en het uitlog-icoon uit het kit. */
const MERK_SVG = woordmerkSvg('st-woordmerk');
const UIT_IK = ikoon('pijl', 'st-uit-ik');
import { standKlasse } from '../data/status.js';
import '../styles/studio.css';
/* De hal (14 oktober 2026): Urbanist en studio-hal.css; alles daarin hangt
   onder body.studio.st-hal. Sinds afvinklijst 26 (v26-donker a, v26-schakelaar a)
   is dat de enige stand: geen donker scherm en geen weg terug naar de vorige. */
import '@fontsource-variable/urbanist/index.css';
import '../styles/studio-hal.css';
/* Sectie 22: Anybody voor de koppen, Figtree voor de tekst, Martian
   Mono voor de labels — alle drie variabel, open source en zelf gehost. Zie de
   noot bij --font-heading in global.css voor waarom deze drie. */
import '@fontsource-variable/anybody/standard.css';
import '@fontsource-variable/figtree/index.css';
import '@fontsource-variable/martian-mono/standard.css';

/* De Satoshi-schakelaar is op 21 september 2026 weggehaald — zie de noot op
   dezelfde plek in Layout.astro. */

const CHIP_STAND = { signal: 'in_production', warn: 'past_due' };

import { studioHeaders, studioNav, STUDIO_ICONS, ingelogdCookie, ingelogdCookieWeg, heeftIngelogdCookie } from '../lib/account.js';
import { heeftKlap } from '../lib/studioKoppen.js';
/* De melding bovenaan (ronde 9) — gezet in /admin/melding, zie src/lib/melding.js. */
import { leesMelding, meldingTekst } from '../lib/melding.js';
import { pagesContext } from '../lib/route.js';

interface Props {
  lang: 'nl' | 'en';
  title: string;
  t: Record<string, any>;
  thema?: 'licht' | 'donker';
  /** 'schil' = zijbalk + bovenbalk (ingelogd); 'kaart' = één kaart in het midden (inloggen). */
  vorm?: 'schil' | 'kaart';
  navDicht?: boolean;
  actief?: string;
  customer?: { brand?: string | null; name?: string | null; email: string } | null;
  /** De bovenbalk van de schil. */
  kop?: string;
  lede?: string;
  chip?: { tekst: string; toon?: string } | null;
  actie?: { href: string; label: string } | null;
  /** Een uitleg-tip (studioTip() in account.js), of null. */
  tip?: { id: string; weg: string; begrepen: string; sluit: string; h: string; tekst: string; punten: string[] } | null;
}

const {
  lang, title, t, thema = 'licht', vorm = 'schil', navDicht = false, actief = '',
  customer = null, kop = '', lede = '', chip = null, actie = null, tip = null,
} = Astro.props;

for (const [k, v] of Object.entries(studioHeaders())) Astro.response.headers.set(k, v);
/* vis_in (v31-me = a, src/data/cookies.js): de site vraagt /account/me alleen als
   dit cookie er staat. Elke Studio-pagina zet hem opnieuw, zodat hij zo lang leeft
   als de sessie (die schuift mee bij gebruik); een sessie van vóór 15 oktober 2026
   krijgt hem zo de eerste keer in Studio. Het inlogscherm (vorm 'kaart', dus geen
   sessie) haalt een achtergebleven vis_in weg. */
if (vorm === 'schil' && customer) Astro.response.headers.append('set-cookie', ingelogdCookie());
if (vorm === 'kaart' && !customer && heeftIngelogdCookie(Astro.request)) Astro.response.headers.append('set-cookie', ingelogdCookieWeg());

const melding = await leesMelding(pagesContext(Astro).env);
const meldingTxt = meldingTekst(melding, lang);
/* Valt de Engelse tekst terug op de Nederlandse, dan ook het label in het Nederlands. */
const MELDING_LABEL = (lang === 'nl' || !melding?.en)
  ? { info: 'Mededeling', druk: 'Drukte', storing: 'Storing' }
  : { info: 'Notice', druk: 'Busy', storing: 'Service issue' };
/* Alleen licht, alleen de hal (14 oktober 2026, v26-donker a). `thema` komt nog
   mee van de pagina's, maar themaCookie() in account.js geeft altijd 'licht'. */
const licht = true;
const hal = true;
const items = studioNav(t);
const naam = customer ? (customer.brand || customer.name || customer.email) : '';
const letter = (naam || '?').trim().charAt(0).toUpperCase();
const huidig = items.find((n) => n.key === actief)?.label || '';
const andereTaal = lang === 'nl' ? 'en' : 'nl';
const andereTaalLabel = lang === 'nl' ? 'English' : 'Nederlands';
/* De schakelaars houden de huidige weergave vast (ronde 8, S-N6): een relatieve
   `?lang=en` gooide `?tab=planning` of `?status=delivered` weg. sectionState()
   haalt na het zetten van de cookie alleen de eigen parameter eruit. */
const metParam = (k, v) => {
  const q = new URLSearchParams(Astro.url.search);
  for (const weg of ['lang', 'thema', 'nav']) q.delete(weg);
  q.set(k, v);
  return `?${q.toString()}`;
};

/* Het V-beeldmerk (MERK_V/MERK_VLAG) stond hier tot 19 september 2026. Dat
   merk is uit de roulatie; de zijbalk draagt nu het woordmerk uit
   src/data/wordmarkPath.js — dezelfde paden als #wordmark in Layout.astro. */
---
<!doctype html>
<html lang={lang} data-thema={licht ? 'licht' : 'donker'} data-klap={heeftKlap(Astro.request) ? '' : undefined}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow, noarchive">
  <meta name="color-scheme" content={licht ? 'light' : 'dark'}>
  <title>{title} — VISUAILS</title>
  {/* De tevredenheidsvraag op Bestellingen komt uit feedback.js met zijn eigen
      stylesheet (public/feedback.css, gedeeld met het klantportaal). Op tokens,
      dus hij kleurt mee met licht en donker. */}
  <link rel="stylesheet" href="/feedback.css">
  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
</head>
<body class={`studio ${vorm === 'kaart' ? 'st-kaartvorm' : 'st-schilvorm'}${licht ? '' : ' on-ink'}${hal ? ' st-hal' : ''}`}>
  {vorm === 'kaart' ? (
    <div class="st-kaartveld">
      {meldingTxt && <p class={`st-banner is-${melding.soort}`} role="status"><span class="st-banner-l">{MELDING_LABEL[melding.soort]}</span><span>{meldingTxt}</span></p>}
      <a class="st-merk st-merk-los" href="/" aria-label="VISUAILS">
        <Fragment set:html={MERK_SVG} />
      </a>
      <main class="st-kaart" id="inhoud">
        <slot />
      </main>
    </div>
  ) : (
    <div class={`st-shell${navDicht ? ' is-dicht' : ''}`}>
      <div class="st-kolom">
      <aside class="st-side">
        <div class="st-side-kop">
          <a class="st-merk" href="/" aria-label="VISUAILS">
            <Fragment set:html={MERK_SVG} />
          </a>
          <span class="st-sub">{t.dashSub}</span>
        </div>
        {/* Alleen op de telefoon: daar is er geen bovenbalk en geen zijbalkvoet. */}
        <div class="st-mob">
          <a href={metParam('lang', andereTaal)} lang={andereTaal} title={andereTaalLabel}>{andereTaal.toUpperCase()}</a>
          <form method="post" action="/account/logout"><button type="submit">{t.signOut}</button></form>
        </div>
        <nav class="st-nav" aria-label="Studio">
          {items.map((n) => (
            <a class={`st-navlink${n.key === actief ? ' is-actief' : ''}`} href={n.href} aria-current={n.key === actief ? 'page' : undefined} title={navDicht ? n.label : undefined}>
              <Fragment set:html={n.icon} /><span>{n.label}</span>
            </a>
          ))}
        </nav>
        <div class="st-side-voet">
          {customer && (
            <div class="st-wie" title={navDicht ? `${naam} · ${customer.email}` : undefined}>
              <span class="st-wie-letter" aria-hidden="true">{letter}</span>
              <span class="st-wie-tekst">
                <span class="st-wie-naam">{naam}</span>
                <span class="st-wie-mail">{customer.email}</span>
              </span>
            </div>
          )}
          <form method="post" action="/account/logout">
            <button class="st-uit" type="submit" title={navDicht ? t.signOut : undefined}>
              <Fragment set:html={UIT_IK} />
              <span>{t.signOut}</span>
            </button>
          </form>
        </div>
      </aside>
      </div>

      <div class="st-romp">
        {/* De bovenbalk (herontwerp 3 oktober 2026): inklappen, waar je bent, en
            rechts de taal. De paginatitel staat eronder. */}
        <div class="st-balk">
          <a class="st-klap" href={metParam('nav', navDicht ? 'open' : 'dicht')} title={navDicht ? t.navExpand : t.navCollapse} aria-label={navDicht ? t.navExpand : t.navCollapse}>
            <Fragment set:html={navDicht ? STUDIO_ICONS.expand : STUDIO_ICONS.collapse} />
          </a>
          <p class="st-kruim"><span>Studio</span>{huidig && <Fragment><i aria-hidden="true">/</i><b>{huidig}</b></Fragment>}</p>
          <div class="st-schakel">
            <span class="st-taal" aria-label={lang === 'nl' ? 'Taal' : 'Language'}>
              {lang === 'nl' ? <span aria-current="true">NL</span> : <a href={metParam('lang', 'nl')} lang="nl" title="Nederlands">NL</a>}
              {lang === 'en' ? <span aria-current="true">EN</span> : <a href={metParam('lang', 'en')} lang="en" title="English">EN</a>}
            </span>
          </div>
        </div>
        {meldingTxt && <p class={`st-banner is-${melding.soort}`} role="status"><span class="st-banner-l">{MELDING_LABEL[melding.soort]}</span><span>{meldingTxt}</span></p>}
        <header class="st-top">
          <div class="st-top-tekst">
            {/* In de hal: de kop in twee tonen, gesplitst op de eerste komma
                ("Welkom terug, | Mara"). Zonder komma één toon. */}
            {hal && kop.includes(', ')
              ? <h1 class="st-h1"><span class="l">{kop.slice(0, kop.indexOf(', ') + 1)}</span> {kop.slice(kop.indexOf(', ') + 2)}</h1>
              : <h1 class="st-h1">{kop}</h1>}
            {lede && <p class="st-lede">{lede}</p>}
          </div>
          {/* De kopchip zegt hoe de REKENING ervoor staat ("3 bestellingen lopen",
              "abonnement gepauzeerd"). Dat is een status, dus hij draagt het
              statuscomponent (20 september 2026). */}
          {chip && chip.tekst && <span class={standKlasse(CHIP_STAND[chip.toon] || 'received')}>{chip.tekst}</span>}
          {actie && <a class="btn btn-primary st-top-actie" href={actie.href}>{actie.label}</a>}
        </header>
        <main class="st-main" id="inhoud">
          {/* De uitleg-tip (afvinklijst 28, v28-tips = a): één per pagina, in de
              stroom zodat hij nooit een knop afdekt. Studio heeft geen script:
              "Begrepen" en het kruisje zijn links (?tipweg=<id>), en wat je
              wegklikt komt niet terug (cookie, zie src/data/tips.js). */}
          {tip && (
            <aside class="st-tip" role="note" aria-label={tip.h || t.tipLabel || 'Tip'} data-tip={tip.id}>
              <div class="st-tip-tekst">
                {tip.h && <p class="st-tip-h">{tip.h}</p>}
                {tip.tekst && <p>{tip.tekst}</p>}
                {tip.punten.length > 0 && <ul>{tip.punten.map((x) => <li>{x}</li>)}</ul>}
                <a class="btn btn-2nd btn-sm" href={tip.weg}>{tip.begrepen}</a>
              </div>
              <a class="st-tip-x" href={tip.weg} aria-label={tip.sluit}>×</a>
            </aside>
          )}
          <slot />
        </main>
      </div>
    </div>
  )}
</body>
</html>
