---
// VISUAILS — test sample. Ported from
// /tmp/visuails-rebuild/src/routes/test-sample/+page.svelte: a 2-step
// request wizard (style/model/product -> contact) inside one <form>.
//
// The Svelte source used $state(step) with class:hidden-step to keep both
// steps mounted so field values survive stepping back and forth. This is a
// static Astro page (no client framework state), so the step-switching is
// reimplemented as vanilla JS below, keeping the exact same markup/fields
// and the same "both steps stay in the DOM" behavior.
import Layout from '../../layouts/Layout.astro';

const styles = [
  { value: 'Phone-made', photo: '/img/lifestyle-phone-made-01.webp' },
  { value: 'Glow', photo: '/img/lifestyle-glow-01.webp' },
  { value: 'Flash', photo: '/img/lifestyle-flash-01.webp' },
  { value: 'Dunes', photo: '/img/lifestyle-dunes-01.webp' },
];
const roster = ['Aaron', 'Ava', 'Dana', 'Elias', 'Fabi', 'Lisa', 'Maegan', 'Rae', 'Ryan', 'Seme'];
---

<Layout
  title="Teste VISUAILS mit 1 Produkt — Test-Visual"
  description="Lade ein Produktfoto hoch und lass VISUAILS daraus ein professionelles E-Commerce-Visual machen. Sieh, wie es funktioniert, bevor du bestellst — 1 Test-Visual pro Unternehmen, von Hand geprüft."
>
  <!-- HERO -->
  <section class="page-hero"><div class="container">
    <span class="eyebrow-page">Test-Visual</span>
    <h1 class="display" style="font-size:clamp(2.4rem,5vw,4rem)">Teste VISUAILS mit <span class="accent-word">1 Produkt</span></h1>
    <p class="lead" style="margin-top:1.2rem">Lade ein Produktfoto hoch und sieh, wie daraus ein veröffentlichungsfertiges Visual wird — bevor du bestellst.</p>
    <div class="chip-row" style="margin-top:1.8rem">
      <span class="chip"><span class="dot"></span>1 Test pro Unternehmen</span>
      <span class="chip"><span class="dot"></span>Nur €0,99-Verifizierung</span>
      <span class="chip"><span class="dot"></span>Von Hand geprüft</span>
    </div>
  </div></section>

  <!-- WHAT YOU GET -->
  <section class="section-tight">
    <div class="container two-col">
      <div class="reveal pending">
        <h2>Ein Produkt, verwandelt in ein veröffentlichungsfertiges Visual.</h2>
        <p style="margin-top:1.1rem;color:var(--ink-3);max-width:52ch">Dieselbe Pipeline und menschliche Prüfung wie bei jeder bezahlten Bestellung — der ehrliche Weg, die Qualität zu beurteilen, bevor du dich festlegst.</p>
        <ul class="checklist" style="margin-top:1.4rem">
          <li><svg viewBox="0 0 24 24" class="i" style="stroke:var(--success)"><path d="M20 6L9 17l-5-5" /></svg><span>Ein hochauflösendes Visual, geliefert per Download-Link in der E-Mail.</span></li>
          <li><svg viewBox="0 0 24 24" class="i" style="stroke:var(--success)"><path d="M20 6L9 17l-5-5" /></svg><span>Ein echter Blick auf unsere Beleuchtung, Bildausschnitte und das Finish.</span></li>
          <li><svg viewBox="0 0 24 24" class="i" style="stroke:var(--success)"><path d="M20 6L9 17l-5-5" /></svg><span>Von einer Person geprüft, bevor es dich erreicht.</span></li>
          <li><svg viewBox="0 0 24 24" class="i" style="stroke:var(--success)"><path d="M20 6L9 17l-5-5" /></svg><span>Kein Abo — nur eine €0,99-Verifizierung, 1 Test pro Unternehmen.</span></li>
        </ul>
      </div>
      <div class="reveal pending">
        <div class="photo-band">
          <img src="/img/lifestyle-glow-03.webp" alt="Beispiel eines VISUAILS-Visuals, Glow-Stil" loading="lazy" />
          <div class="scrim"></div>
          <div class="caption"><p style="margin:0">Dein Test, von Hand geprüft</p></div>
        </div>
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section>
    <div class="container">
      <div class="section-head">
        <h2>So funktioniert der Test</h2>
        <p>Vier kurze Schritte von deinem Foto bis zum fertigen Visual in deinem Postfach.</p>
      </div>
      <div class="steps">
        <div class="step reveal pending"><div class="step-n">01</div><h3>Produktfoto hochladen</h3><p>Teile ein klares Foto des Produkts, mit dem wir arbeiten sollen.</p></div>
        <div class="step reveal pending"><div class="step-n">02</div><h3>Wähle einen Stil</h3><p>Wähle den Look und, wenn du magst, ein Modell — oder lass uns für dich wählen.</p></div>
        <div class="step reveal pending"><div class="step-n">03</div><h3>Wir erstellen es</h3><p>In unserem Studio produziert, danach von Hand geprüft.</p></div>
        <div class="step reveal pending"><div class="step-n">04</div><h3>Per E-Mail erhalten</h3><p>Dein fertiges Visual kommt als Download-Link, meist innerhalb von ~24 Stunden.</p></div>
      </div>
    </div>
  </section>

  <!-- INPUT GUIDANCE -->
  <section class="section-tight">
    <div class="container">
      <div class="section-head">
        <h2>Gib uns ein gutes Foto, bekomm ein großartiges Ergebnis</h2>
        <p>Je klarer dein Input, desto besser das Visual, das wir daraus bauen können.</p>
      </div>
      <div class="grid grid-2">
        <div class="card reveal pending">
          <h3 style="color:var(--success)">Empfohlen</h3>
          <ul class="checklist" style="margin-top:1rem">
            <li><svg viewBox="0 0 24 24" class="i" style="stroke:var(--success)"><path d="M20 6L9 17l-5-5" /></svg><span>Klar, scharf und im Fokus</span></li>
            <li><svg viewBox="0 0 24 24" class="i" style="stroke:var(--success)"><path d="M20 6L9 17l-5-5" /></svg><span>Neutraler, aufgeräumter Hintergrund</span></li>
            <li><svg viewBox="0 0 24 24" class="i" style="stroke:var(--success)"><path d="M20 6L9 17l-5-5" /></svg><span>Gute, gleichmäßige Beleuchtung</span></li>
            <li><svg viewBox="0 0 24 24" class="i" style="stroke:var(--success)"><path d="M20 6L9 17l-5-5" /></svg><span>Das ganze Produkt im Bild</span></li>
          </ul>
        </div>
        <div class="card reveal pending">
          <h3 style="color:var(--ink-3)">Vermeiden</h3>
          <ul class="checklist" style="margin-top:1rem">
            <li><svg viewBox="0 0 24 24" class="i" style="stroke:var(--ink-3)"><path d="M18 6L6 18M6 6l12 12" /></svg><span>Unscharfe oder niedrig aufgelöste Aufnahmen</span></li>
            <li><svg viewBox="0 0 24 24" class="i" style="stroke:var(--ink-3)"><path d="M18 6L6 18M6 6l12 12" /></svg><span>Dunkle oder stark verschattete Fotos</span></li>
            <li><svg viewBox="0 0 24 24" class="i" style="stroke:var(--ink-3)"><path d="M18 6L6 18M6 6l12 12" /></svg><span>Unruhige oder ablenkende Hintergründe</span></li>
            <li><svg viewBox="0 0 24 24" class="i" style="stroke:var(--ink-3)"><path d="M18 6L6 18M6 6l12 12" /></svg><span>Starke Filter oder Wasserzeichen</span></li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- REQUEST WIZARD -->
  <section>
    <div class="container narrow">
      <div class="section-head">
        <h2>Fordere dein Test-Visual an</h2>
        <p>Zwei schnelle Schritte. Sag uns den gewünschten Look, dann wohin wir es senden sollen.</p>
      </div>
      <div class="card" style="padding:clamp(1.4rem,3vw,2.4rem)">
        <!-- Static site, no backend: this form needs a real submit handler (e.g. a Cloudflare Pages Function, Formspree, or similar) wired up before launch. -->
        <form action="/de/thank-you" method="get" data-wizard novalidate>
          <div class="progress" aria-hidden="true"><i data-wizard-progress style="width:50%"></i></div>

          <!-- STEP 1 -->
          <div data-wizard-step="1">
            <h3 style="margin-bottom:.4rem">Schritt 1 &middot; Stil, Modell &amp; Produkt</h3>
            <p class="hint" style="margin-bottom:1.4rem">Wähle den gewünschten Look und lade dein Produktfoto hoch.</p>

            <div class="field">
              <label>Wähle einen Stil <span class="req">*</span></label>
              <div class="choice-grid">
                {styles.map((s, i) => (
                  <label class="choice">
                    <input type="radio" name="style" value={s.value} required={i === 0} />
                    <div class="choice-media"><img src={s.photo} alt={`${s.value} Lifestyle-Stil`} loading="lazy" /></div>
                    <div class="choice-label">{s.value}</div>
                  </label>
                ))}
              </div>
            </div>

            <div class="field">
              <label>Wähle ein Modell</label>
              <span class="hint" style="margin-bottom:.3rem">Für die meisten Produkte optional — praktisch für Kleidung und Accessoires.</span>
              <div class="choice-grid">
                {roster.map((m) => (
                  <label class="choice">
                    <input type="radio" name="model" value={m} />
                    <div class="choice-media"><img src={`/img/model-${m.toLowerCase()}.webp`} alt={m} loading="lazy" /></div>
                    <div class="choice-label">{m}</div>
                  </label>
                ))}
                <label class="choice">
                  <input type="radio" name="model" value="VISUAILS choose" />
                  <div class="choice-media mono"><div class="mono-av"><svg viewBox="0 0 24 24" class="i" style="width:26px;height:26px;color:var(--accent-bright)"><path d="M12 2l2.4 7.4H22l-6 4.6 2.3 7.4-6.3-4.6L5.7 21.4 8 14 2 9.4h7.6z" /></svg></div></div>
                  <div class="choice-label">VISUAILS wählen lassen</div>
                </label>
              </div>
            </div>

            <div class="field">
              <label for="ts-upload">Produktfotos hochladen <span class="req">*</span></label>
              <label class="dropzone" for="ts-upload">
                <svg viewBox="0 0 24 24" class="i"><path d="M12 16V4M6 10l6-6 6 6M4 20h16" /></svg>
                <div><strong>Zum Hochladen klicken</strong> oder Fotos hierher ziehen</div>
                <div class="hint" style="margin-top:.4rem">Ein klares Foto reicht — aber Vorderseite, Rückseite, ein Detail und der Stoff liefern das beste Ergebnis.</div>
                <input type="file" id="ts-upload" name="photo" accept="image/*" multiple hidden />
              </label>
              <span class="hint">Mehr Perspektiven helfen uns, dein Produkt genau zu treffen — sieh <a href="/de/upload-guidelines" style="color:var(--accent-bright)">was du senden solltest</a>.</span>
            </div>

            <div class="field">
              <label for="ts-notes">Sollen wir noch etwas wissen?</label>
              <textarea class="textarea" id="ts-notes" name="notes" placeholder="Optional — Farben, die exakt bleiben sollen, eine bevorzugte Perspektive, etwas Spezielles zum Produkt."></textarea>
            </div>

            <div class="flex" style="justify-content:flex-end;margin-top:.4rem">
              <button type="button" class="btn btn-primary" data-wizard-next>Weiter
                <svg viewBox="0 0 24 24" class="i"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
              </button>
            </div>
          </div>

          <!-- STEP 2 -->
          <div data-wizard-step="2" class="hidden-step">
            <h3 style="margin-bottom:.4rem">Schritt 2 &middot; Details &amp; Kontakt</h3>
            <p class="hint" style="margin-bottom:1.4rem">Wohin sollen wir deinen fertigen Test senden?</p>

            <div class="row-2">
              <div class="field">
                <label for="ts-name">Name <span class="req">*</span></label>
                <input class="input" type="text" id="ts-name" name="name" autocomplete="name" required />
              </div>
              <div class="field">
                <label for="ts-brand">Marken- oder Shopname <span class="req">*</span></label>
                <input class="input" type="text" id="ts-brand" name="brand" autocomplete="organization" required />
              </div>
            </div>

            <h4 style="margin:.6rem 0 1rem">Kontakt</h4>
            <div class="row-2">
              <div class="field">
                <label for="ts-email">E-Mail <span class="req">*</span></label>
                <input class="input" type="email" id="ts-email" name="email" autocomplete="email" required />
              </div>
              <div class="field">
                <label for="ts-phone">Telefon <span class="hint" style="font-weight:400">— optional</span></label>
                <input class="input" type="tel" id="ts-phone" name="phone" autocomplete="tel" placeholder="+31 6 &hellip;" />
                <span class="hint">Gib sie an, wenn wir dir auf WhatsApp schreiben sollen — mit Ländervorwahl.</span>
              </div>
            </div>

            <p class="hint" style="margin:.4rem 0 1.4rem">Dein Test wird per Download-Link an deine E-Mail geliefert. Bei Bedarf melden wir uns per WhatsApp oder E-Mail.</p>

            <div class="flex" style="justify-content:space-between;margin-top:.4rem">
              <button type="button" class="btn btn-ghost" data-wizard-back>
                <svg viewBox="0 0 24 24" class="i" style="transform:rotate(180deg)"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
                Zurück
              </button>
              <button type="submit" class="btn btn-primary">Test anfordern</button>
            </div>
          </div>
        </form>
      </div>
      <p class="hint" style="text-align:center;margin-top:1rem">Ein Test pro Unternehmen &middot; eine kleine &euro;0,99-Verifizierung, um Missbrauch zu verhindern &middot; mehr zahlst du für den Test nicht.</p>
    </div>
  </section>

  <!-- CTA BAND -->
  <section class="section-tight">
    <div class="container">
      <div class="cta-band reveal pending">
        <h2 class="display" style="font-size:clamp(2.2rem,5vw,3.6rem)">Lieber erst mal drüber sprechen?</h2>
        <p class="lead" style="margin:1.2rem auto 0;text-align:center">Schick uns dein Produkt auf WhatsApp und wir helfen dir, einen Stil zu wählen.</p>
        <div class="flex" style="justify-content:center;margin-top:2rem">
          <a href="/de/order" class="btn btn-ghost btn-lg">Vollständige Bestellung aufgeben</a>
          <a href="https://wa.me/31625436130?text=Hi%20VISUAILS%2C%20ich%20möchte%20gern%20ein%20Test-Visual%20ausprobieren." class="btn btn-wa btn-lg" target="_blank" rel="noopener">
            <svg class="i" viewBox="0 0 24 24"><path d="M21 11.5a8.38 8.38 0 0 1-8.5 8.5 8.5 8.5 0 0 1-4-1L3 20l1.5-4.5A8.38 8.38 0 0 1 3.5 11 8.5 8.5 0 0 1 12 3a8.38 8.38 0 0 1 8.5 8.5z" /></svg>
            WhatsApp <span class="rec-badge">Am schnellsten</span>
          </a>
        </div>
      </div>
    </div>
  </section>
  <!-- Wizard step navigation is handled globally in src/scripts/interactions.js
       (document-level delegation) so it survives ClientRouter navigations. -->
</Layout>

<style>
  /* Order-form controls — page-scoped, matching the source. */
  .narrow { max-width: 820px; }
  .hidden-step { display: none; }
  .field { display: flex; flex-direction: column; gap: 0.45rem; margin-bottom: 1.1rem; }
  .field label { font-size: 0.88rem; font-weight: 600; color: var(--ink); }
  .req { color: var(--accent-bright); }
  .hint { font-size: 0.8rem; color: var(--ink-3); }
  .input, .textarea { width: 100%; padding: 0.85rem 1rem; background: var(--surface); border: 1px solid var(--line-strong); border-radius: var(--r-sm); color: var(--ink); transition: border-color 0.22s var(--ease), box-shadow 0.22s var(--ease); font-size: 0.98rem; font-family: var(--font-body); }
  .input::placeholder, .textarea::placeholder { color: var(--ink-3); }
  .input:focus, .textarea:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-soft); }
  .textarea { min-height: 110px; resize: vertical; }
  .row-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 1.1rem; }
  @media (max-width: 620px) { .row-2 { grid-template-columns: 1fr; } }
  .choice-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 0.8rem; }
  .choice { position: relative; border-radius: var(--r-sm); overflow: hidden; cursor: pointer; border: 1px solid var(--line-strong); transition: transform 0.24s var(--ease), border-color 0.24s var(--ease); background: var(--surface); display: block; }
  .choice:hover { transform: translateY(-2px); border-color: var(--accent-line); }
  .choice input { position: absolute; opacity: 0; pointer-events: none; }
  .choice .choice-media { aspect-ratio: 1; }
  .choice .choice-media img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .choice .choice-media.mono { display: grid; place-items: center; background: radial-gradient(125% 90% at 50% 6%, #FFFFFF, #F1EBE3 58%, #E2D9CD 100%); }
  .choice .choice-label { padding: 0.6rem 0.7rem; font-size: 0.85rem; color: var(--ink); font-weight: 500; }
  .choice:has(input:checked) { border-color: var(--accent); box-shadow: 0 0 0 1px var(--accent); }
  .choice:has(input:checked)::after { content: "\2713"; position: absolute; top: 8px; right: 8px; width: 24px; height: 24px; border-radius: 50%; background: var(--accent); color: #fff; display: grid; place-items: center; font-size: 0.8rem; font-weight: 700; z-index: 5; }
  .choice .mono-av { position: relative; z-index: 2; display: grid; place-items: center; width: 100%; height: 100%; font-family: var(--font-display); font-weight: 900; font-size: 1.4rem; color: var(--accent-bright); }
  .choice .mono-av small { position: absolute; bottom: 8px; font-size: 0.58rem; font-weight: 500; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink-3); font-family: var(--font-body); font-style: normal; }
  .dropzone { display: block; border-radius: var(--r-sm); padding: 1.8rem; text-align: center; color: var(--ink-3); border: 1.5px dashed var(--line-strong); transition: border-color 0.22s var(--ease), background 0.22s var(--ease); cursor: pointer; background: var(--surface); }
  .dropzone:hover { border-color: var(--accent-line); background: var(--accent-soft); }
  .dropzone svg { width: 30px; height: 30px; margin: 0 auto 0.6rem; color: var(--accent-bright); }
  .progress { height: 3px; background: var(--surface-2); border-radius: var(--r-pill); overflow: hidden; margin-bottom: 1.6rem; }
  .progress > i { display: block; height: 100%; background: var(--accent); transition: width 0.5s var(--ease); }
  .chip-row { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .chip { display: inline-flex; align-items: center; gap: 0.45rem; padding: 0.4rem 0.9rem; border-radius: var(--r-pill); border: 1px solid var(--line); font-size: 0.8rem; color: var(--ink-2); }
  .chip .dot { width: 5px; height: 5px; border-radius: 50%; background: var(--accent); }
</style>
