---
// VISUAILS — Upload-Richtlinien (Deutsch). Übersetzung von src/pages/upload-guidelines.astro.
import Layout from '../../layouts/Layout.astro';
import ProductScene from '../../components/ProductScene.astro';
---

<Layout
  title="Upload-Richtlinien — VISUAILS"
  description="Einfache Tipps für die Produktfotos, die du uns schickst, damit deine Visuals scharf, präzise und schnell werden."
>
  <section class="page-hero"><div class="container">
    <span class="eyebrow-page">Die besten Ergebnisse erzielen</span>
    <h1 class="display">So machst du Fotos, mit denen wir zaubern können</h1>
    <p class="lead" style="margin-top:1.1rem">Du brauchst kein Studio — nur ein klares Foto und ein paar einfache Gewohnheiten.</p>
    <div class="flex" style="margin-top:1.8rem">
      <a href="/de/test-sample" class="btn btn-primary btn-lg">Test-Visual ausprobieren</a>
      <a href="/de/order" class="btn btn-ghost btn-lg">Bestellung starten</a>
    </div>
  </div></section>

  <section><div class="container">
    <div class="grid grid-2 reveal-group">
      <div class="card reveal pending">
        <h3 style="color:var(--success)">Empfohlen</h3>
        <ul class="checklist" style="margin-top:1rem">
          <li><svg viewBox="0 0 24 24" class="i" style="stroke:var(--success)"><path d="M20 6L9 17l-5-5" /></svg><span>Halte es klar &amp; scharf — im Fokus, keine Bewegungsunschärfe.</span></li>
          <li><svg viewBox="0 0 24 24" class="i" style="stroke:var(--success)"><path d="M20 6L9 17l-5-5" /></svg><span>Verwende einen neutralen, aufgeräumten Hintergrund.</span></li>
          <li><svg viewBox="0 0 24 24" class="i" style="stroke:var(--success)"><path d="M20 6L9 17l-5-5" /></svg><span>Beleuchte es gut und gleichmäßig — Tageslicht funktioniert super.</span></li>
          <li><svg viewBox="0 0 24 24" class="i" style="stroke:var(--success)"><path d="M20 6L9 17l-5-5" /></svg><span>Zeige das ganze Produkt, plus ein paar Nahaufnahmen wichtiger Details.</span></li>
          <li><svg viewBox="0 0 24 24" class="i" style="stroke:var(--success)"><path d="M20 6L9 17l-5-5" /></svg><span>Schicke die höchste Auflösung, die du hast.</span></li>
        </ul>
      </div>
      <div class="card reveal pending" style="border-color:oklch(0.7 0.14 25 / 0.35)">
        <h3 style="color:oklch(0.78 0.15 25)">Vermeiden</h3>
        <ul class="checklist" style="margin-top:1rem">
          <li><svg viewBox="0 0 24 24" class="i" style="stroke:oklch(0.78 0.15 25)"><path d="M18 6L6 18M6 6l12 12" /></svg><span>Unscharfe, dunkle oder lichtarme Aufnahmen.</span></li>
          <li><svg viewBox="0 0 24 24" class="i" style="stroke:oklch(0.78 0.15 25)"><path d="M18 6L6 18M6 6l12 12" /></svg><span>Unruhige oder ablenkende Hintergründe.</span></li>
          <li><svg viewBox="0 0 24 24" class="i" style="stroke:oklch(0.78 0.15 25)"><path d="M18 6L6 18M6 6l12 12" /></svg><span>Starke Filter oder kräftige Farbstiche.</span></li>
          <li><svg viewBox="0 0 24 24" class="i" style="stroke:oklch(0.78 0.15 25)"><path d="M18 6L6 18M6 6l12 12" /></svg><span>Winzige Screenshots mit niedriger Auflösung.</span></li>
          <li><svg viewBox="0 0 24 24" class="i" style="stroke:oklch(0.78 0.15 25)"><path d="M18 6L6 18M6 6l12 12" /></svg><span>Einen Teil des Produkts aus dem Bild schneiden.</span></li>
        </ul>
      </div>
    </div>
    <div class="two-col" style="margin-top:2.5rem">
      <div class="reveal pending not-ideal">
        <ProductScene icon="bottle" width="44%" badge="Nicht ideal — matt &amp; flach" wide />
      </div>
      <div class="reveal pending">
        <ProductScene icon="bottle" width="44%" badge="Super — klar &amp; gut beleuchtet" wide />
      </div>
    </div>
  </div></section>

  <section class="section-tight">
    <div class="container">
      <div class="section-head">
        <h2>Das Set, das wir empfehlen — <em>und warum.</em></h2>
        <p>Wir halten dein Produkt in der Regel nie in den Händen, also je mehr Blickwinkel du schickst, desto exakter können wir es nachbauen. So garantieren wir das Ergebnis, statt es nur anzunähern.</p>
      </div>
      <div class="req-grid reveal-group">
        <div class="req-card reveal pending"><span class="rc-num">01</span><h4>Vorder- &amp; Rückseite</h4><p>Das ganze Produkt von beiden Seiten, damit nichts an seiner Form geraten wird.</p></div>
        <div class="req-card reveal pending"><span class="rc-num">02</span><h4>Eine Detail-Nahaufnahme</h4><p>Logos, Nähte, Prints, Beschläge — die Dinge, die exakt bleiben müssen.</p></div>
        <div class="req-card reveal pending"><span class="rc-num">03</span><h4>Der Stoff</h4><p>Eine Nahaufnahme des Materials, damit Textur, Gewebe und Glanz echt wirken.</p></div>
        <div class="req-card reveal pending"><span class="rc-num">04</span><h4>Getragen für die Passform</h4><p>Jemand, der es tatsächlich trägt, damit wir Passform und Fall aus der Praxis reproduzieren können.</p></div>
      </div>
      <p class="req-note reveal pending"><strong>Nicht erforderlich — nur empfohlen.</strong> Ein klares Foto des gesamten Produkts genügt, damit wir starten und liefern können. Schick das komplette Set und wir können garantieren, dass Passform, Farbe und Details beim ersten Mal richtig herauskommen, mit weniger Revisionsrunden.</p>
    </div>
  </section>

  <section class="section-tight"><div class="container"><div class="cta-band reveal pending">
    <h2 class="display" style="font-size:clamp(2rem,4.5vw,3rem)">Hast du ein Foto bereit? Lass es uns verwandeln.</h2>
    <p class="lead" style="margin:1rem auto 0;text-align:center">Beginne mit einem Test-Visual — nur eine Verifizierung für €0,99.</p>
    <div class="flex" style="justify-content:center;margin-top:1.8rem">
      <a href="/de/test-sample" class="btn btn-primary btn-lg">Test-Visual</a>
      <a href="/de/order" class="btn btn-ghost btn-lg">Jetzt bestellen</a>
    </div>
  </div></div></section>
</Layout>

<style>
  /* Desaturated treatment for the "not ideal" example — mirrors the static
     site's .ba-before-scene filter, scoped here since it's only used once. */
  :global(.not-ideal) { filter: saturate(.4) brightness(.92) contrast(.92); }
</style>
