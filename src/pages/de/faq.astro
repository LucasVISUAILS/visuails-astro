---
// VISUAILS — FAQ page. Ported from
// /tmp/visuails-rebuild/src/routes/faq/+page.svelte. Header/footer/nav live
// in Layout.astro; this file is page content only.
//
// The accordion is built with native <details>/<summary> + page-scoped CSS
// (matches the source, which deliberately avoided a hand-faked shadcn
// component) — fully keyboard/screen-reader accessible out of the box.
import Layout from '../../layouts/Layout.astro';

const groups = [
  {
    title: 'Erste Schritte',
    items: [
      { q: 'Was ist VISUAILS?', a: 'VISUAILS verwandelt ein einzelnes Produktfoto in Katalog-, Lifestyle- und Video-Visuals in Studioqualität. Wir nutzen KI für Geschwindigkeit und Skalierung, und ein echter Mensch prüft jedes Bild, bevor es dich erreicht.' },
      { q: 'Was brauche ich, um loszulegen?', a: "Nur ein klares Produktfoto oder einen Screenshot. Eine kurze Notiz zum gewünschten Look hilft, ist aber nicht erforderlich — wir können auf Wunsch eine Richtung vorschlagen." },
      { q: 'Kann ich es zuerst ausprobieren?', a: "Ja. Wir bieten ein Test-Visual an — ein Visual für eine kleine Verifizierung von €0,99 — damit du die Qualität an deinem eigenen Produkt beurteilen kannst, bevor du bestellst. Begrenzt auf eines pro Unternehmen." },
    ],
  },
  {
    title: 'Bestellen & Stile',
    items: [
      { q: "Was ist der Unterschied zwischen Katalog und Lifestyle?", a: 'Katalog-Visuals sind saubere, konsistente Produktaufnahmen — gleiche Beleuchtung, Winkel und Hintergrund — gebaut für Webshops und Marktplätze. Lifestyle-Visuals platzieren dein Produkt in gestylten, realen Szenen, mit optionalen Modellen.' },
      { q: 'Kann ich denselben Stil oder dasselbe Modell über Bestellungen hinweg beibehalten?', a: 'Ja. Konsistenz ist ein Kernbestandteil dessen, was wir tun — wir können denselben Look, dieselbe Beleuchtung und dasselbe Modell über ein ganzes Sortiment halten, damit dein Katalog Bestellung für Bestellung stimmig bleibt.' },
      { q: 'Bietet ihr eigene Stile oder Modelle an?', a: 'Ja. Eigene Stile und Modelle werden direkt über WhatsApp arrangiert, damit wir die Details richtig hinbekommen, bevor wir starten.' },
      { q: 'Kann ich über WhatsApp bestellen?', a: "Jederzeit. Du kannst jede Bestellung über WhatsApp aufgeben — schick dein Foto und ein kurzes Briefing, und wir übernehmen den Rest. Oft ist das der schnellste Weg." },
    ],
  },
  {
    title: 'Lieferung & Qualität',
    items: [
      { q: 'Wie schnell ist die Lieferung?', a: "Die meisten Bestellungen werden in etwa 24 Stunden vom Briefing bis zum Download geliefert. Der Zeitpunkt kann je nach Volumen und Individualität der Anfrage variieren — wir sagen dir immer Bescheid, wenn es anders ist." },
      { q: 'Wird wirklich jedes Bild von einem Menschen geprüft?', a: "Ja — 100% von Menschen geprüft. Ein Mensch wählt jedes Visual aus und prüft es auf Genauigkeit, Konsistenz und Artefakte, bevor es geliefert wird. Nichts geht ungeprüft raus." },
      { q: 'Wie viele Revisionen sind inbegriffen?', a: 'Drei Revisionsrunden sind standardmäßig inbegriffen. Dein Feedback formt das Endergebnis, sodass wir feinjustieren können, bis es passt.' },
      { q: 'Welche Dateiformate und Auflösung erhalte ich?', a: 'Hochauflösende Dateien, bereit für E-Commerce. 2K-Auflösung ist standardmäßig inbegriffen, 4K ist als Option verfügbar.' },
    ],
  },
  {
    title: 'Preise & Zahlung',
    items: [
      { q: 'Wie viel kostet es?', html: 'Katalog kostet €39,99 pro Produkt — ein kompletter Satz von vier Fotos (Vorderseite, Rückseite, Detail und eine On-Model-Aufnahme), etwa €10 pro Foto. Lifestyle ist ab €35 pro Visual und Standard-Video ab €49 (größere Kampagnenvideos werden pro Projekt angeboten). Sieh dir die <a href="/de/pricing">Preisseite</a> für die vollständige Aufschlüsselung an.' },
      { q: 'Gibt es Abos?', a: "Nein. Es gibt kein Abo und keine versteckten Gebühren — du zahlst einfach für die Visuals, die du bestellst." },
      { q: 'Handhabt ihr die Umsatzsteuer / kann ich meine USt-IdNr. angeben?', a: "Ja. Du kannst deine USt-IdNr. beim Checkout angeben — das ist optional und hilft bei der EU-B2B-Rechnungsstellung." },
      { q: 'Wie sieht es mit Mengenrabatten aus?', a: "Mengenrabatte sind für größere Bestellungen verfügbar. Schick uns eine kurze Nachricht mit deinem Bedarf und wir stellen ein Angebot zusammen." },
    ],
  },
  {
    title: 'Rechte & Nutzung',
    items: [
      { q: 'Darf ich die Visuals kommerziell nutzen?', a: 'Ja. Die Visuals sind für die kommerzielle Nutzung gemacht — deinen Webshop, Marktplätze, Anzeigen und Social-Media-Feeds.' },
      { q: 'Wem gehören die Ergebnisse?', a: 'Die fertigen Visuals gehören dir zur Nutzung für dein Unternehmen. Hast du eine bestimmte Lizenzfrage, frag einfach und wir bestätigen die Details für deinen Fall.' },
      { q: 'Nutzt ihr meine Produktfotos für etwas anderes?', a: 'Nein. Die Fotos, die du schickst, werden nur zur Produktion deiner Bestellung verwendet — für nichts anderes.' },
    ],
  },
];
---

<Layout
  title="VISUAILS — Häufig gestellte Fragen"
  description="Antworten zu Erste Schritte, Bestellen, Lieferung, Preisen und Nutzungsrechten für die KI-Produkt-Visuals von VISUAILS — ehrlich, klar und ohne Kleingedrucktes."
>
  <!-- HERO — real photo beside a short line, not a text wall. -->
  <section class="page-hero">
    <div class="container">
      <div class="photo-split reverse">
        <div class="photo-split-media">
          <img src="/img/lifestyle-flash-05.webp" alt="Ein VISUAILS-Lifestyle-Visual" loading="lazy" />
        </div>
        <div>
          <h1 class="display" style="font-size:clamp(2.4rem,5vw,4rem)">Fragen, <em>beantwortet</em>.</h1>
          <p class="lead" style="margin-top:1rem">Wie es funktioniert, was es kostet, wie schnell es ankommt. Immer noch unsicher? Schreib uns auf WhatsApp.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section-tight">
    <div class="container faq-narrow">
      {groups.map((g) => (
        <>
          <h2 style="margin-bottom:1.2rem">{g.title}</h2>
          <div class="faq-stack" style="margin-bottom:2.6rem">
            {g.items.map((item) => (
              <details class="acc-item reveal pending">
                <summary class="acc-q">
                  <span>{item.q}</span>
                  <span class="acc-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" class="i" style="width:14px;height:14px"><path d="M12 5v14M5 12h14"/></svg>
                  </span>
                </summary>
                <div class="acc-body-inner">
                  {item.html ? <p set:html={item.html} /> : <p>{item.a}</p>}
                </div>
              </details>
            ))}
          </div>
        </>
      ))}
    </div>
  </section>

  <!-- CTA -->
  <section class="section-tight">
    <div class="container">
      <div class="cta-band reveal pending">
        <h2 class="display" style="font-size:clamp(2.2rem,5vw,3.6rem)">Noch eine <em>Frage</em>?</h2>
        <p class="lead" style="margin:1.2rem auto 0;text-align:center">Schreib uns auf WhatsApp — wir antworten meist innerhalb einer Stunde.</p>
        <div class="flex" style="justify-content:center;margin-top:2rem">
          <a href="/de/test-sample" class="btn btn-primary btn-lg">Test-Visual</a>
          <a href="/de/contact" class="btn btn-ghost btn-lg">Kontakt aufnehmen</a>
          <a href="https://wa.me/31625436130?text=Hallo%20VISUAILS%2C%20ich%20habe%20eine%20Frage%20zu%20eurem%20Service." class="btn btn-wa" target="_blank" rel="noopener">
            <svg class="i" viewBox="0 0 24 24"><path d="M21 11.5a8.38 8.38 0 0 1-8.5 8.5 8.5 8.5 0 0 1-4-1L3 20l1.5-4.5A8.38 8.38 0 0 1 3.5 11 8.5 8.5 0 0 1 12 3a8.38 8.38 0 0 1 8.5 8.5z"/></svg>
            WhatsApp
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* FAQ-only: narrower reading column + the accordion look (near-black
     surface, hairline dividers, coral plus/chevron indicator). Native
     <details>/<summary>. */
  .faq-narrow { max-width: 820px; }
  .faq-stack { display: flex; flex-direction: column; }

  .acc-item { box-shadow: inset 0 -1px 0 var(--line); }
  .acc-item summary { list-style: none; cursor: pointer; }
  .acc-item summary::-webkit-details-marker { display: none; }
  .acc-item summary::marker { content: ''; }
  .acc-q { width: 100%; display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding: 1.35rem 0; font-family: var(--font-body); font-size: 1.05rem; font-weight: 600; color: var(--ink); }
  .acc-q:hover { color: var(--ink); }
  .acc-icon { flex: 0 0 auto; width: 28px; height: 28px; border-radius: 50%; border: 1px solid var(--line-strong); color: var(--ink-3); display: grid; place-items: center; transition: transform .4s var(--ease), background .4s var(--ease), color .4s var(--ease), border-color .4s var(--ease); }
  .acc-item[open] .acc-icon { transform: rotate(45deg); background: var(--accent); border-color: var(--accent); color: #fff; }
  .acc-body-inner { padding-bottom: 1.35rem; color: var(--ink-2); max-width: 70ch; }
  .acc-body-inner a { color: var(--accent-bright); text-decoration: underline; text-underline-offset: 2px; }
</style>
