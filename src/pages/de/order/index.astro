---
// VISUAILS — Bestell-Hub (Deutsch). Übersetzung von src/pages/order/index.astro.
import Layout from '../../../layouts/Layout.astro';
import ProductScene from '../../../components/ProductScene.astro';

const tiles = [
  { href: '/de/order-catalog', icon: 'bottle', photo: null, name: 'Catalog', body: 'Ein komplettes 4-Foto-Set pro Produkt — vorne, hinten, Detail und On-Model. €39,99 pro Produkt.', cta: 'Catalog anfragen' },
  { href: '/de/order-lifestyle', icon: 'jar', photo: '/img/lifestyle-glow-05.webp', name: 'Lifestyle', body: 'Gestylte Szenen und optionale Modelle. Ab €35 / Visual.', cta: 'Lifestyle bestellen' },
  { href: '/de/order-video', icon: 'sneaker', photo: null, name: 'Video', body: 'Standard-Produktvideos ab €49. Größere Kampagnen auf Anfrage.', cta: 'Video bestellen' },
  { href: '/de/order-custom', icon: 'bag', photo: '/img/custom-models-02.webp', name: 'Custom Styling', body: 'Dein eigener Look, dein Modell oder Konzept — gemeinsam per WhatsApp abgestimmt.', cta: 'Custom besprechen' },
];
---

<Layout
  title="Bestellung aufgeben — VISUAILS"
  description="Bestelle Catalog-, Lifestyle- oder Videovisuals bei VISUAILS — oder vereinbare Custom Styling. Catalog kostet €39,99 pro Produkt (4 Fotos), Lifestyle ab €35, geliefert in etwa 24 Stunden, jedes Ergebnis von Hand geprüft. Lieber sprechen? Bestelle per WhatsApp."
>
  <!-- HERO -->
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow-page">Bestellen</span>
      <h1 class="display" style="font-size:clamp(2.4rem,5vw,4rem)">Bestellung aufgeben</h1>
      <p class="lead" style="margin-top:1.2rem">Sag uns, was wir machen — wir übernehmen es von der Idee bis zur fertigen Datei. Lieber durchsprechen? WhatsApp geht immer.</p>
      <div class="flex" style="margin-top:1.8rem">
        <a href="https://wa.me/31625436130?text=Hi%20VISUAILS%2C%20ich%20m%C3%B6chte%20eine%20Bestellung%20aufgeben." class="btn btn-wa btn-lg" target="_blank" rel="noopener">
          <svg class="i" viewBox="0 0 24 24"><path d="M21 11.5a8.38 8.38 0 0 1-8.5 8.5 8.5 8.5 0 0 1-4-1L3 20l1.5-4.5A8.38 8.38 0 0 1 3.5 11 8.5 8.5 0 0 1 12 3a8.38 8.38 0 0 1 8.5 8.5z"/></svg>
          Per WhatsApp bestellen <span class="rec-badge">Am schnellsten</span>
        </a>
      </div>
      <ul class="hero-benefits">
        <li>Du gibst vor der finalen Lieferung dein OK</li>
        <li>Revisionsrunden inklusive, bis es stimmt</li>
        <li>Lieferung in ~24 Stunden</li>
      </ul>
    </div>
  </section>

  <!-- HUB -->
  <section class="section-tight">
    <div class="container">
      <div class="section-head">
        <h2>Was sollen wir für dich <em>machen?</em></h2>
        <p>Wähle eine Leistung und gib sie ab — Konzept, Produktion und Finishing übernehmen wir. Pro Bestellung, kein Abo.</p>
      </div>
      <div class="hub-grid reveal-group">
        {tiles.map((t) => (
          <a href={t.href} class="card card-hover reveal pending" style="display:block">
            <div class="hub-media">
              {t.photo ? (
                <div class="hub-photo"><img src={t.photo} alt={`${t.name} Beispiel`} loading="lazy" /></div>
              ) : (
                <ProductScene icon={t.icon} width="44%" wide />
              )}
            </div>
            <h3>{t.name}</h3>
            <p style="margin-top:.4rem;font-size:.95rem;color:var(--ink-3)">{t.body}</p>
            <span class="link-arrow" style="margin-top:.8rem">{t.cta} <svg viewBox="0 0 24 24" class="i"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA BAND -->
  <section class="section-tight">
    <div class="container">
      <div class="cta-band reveal pending">
        <h2 class="display" style="font-size:clamp(2.2rem,5vw,3.6rem)">Nicht sicher, was passt?</h2>
        <p class="lead" style="margin:1.2rem auto 0;text-align:center">Sende uns dein Produkt und was du suchst — wir zeigen dir die richtige Option.</p>
        <div class="flex" style="justify-content:center;margin-top:2rem">
          <a href="/de/test-sample" class="btn btn-ghost btn-lg">Erst ein Test-Visual testen</a>
          <a href="https://wa.me/31625436130?text=Hi%20VISUAILS%2C%20ich%20bin%20nicht%20sicher%2C%20welche%20Option%20passt%20%E2%80%94%20k%C3%B6nnt%20ihr%20helfen%3F" class="btn btn-wa btn-lg" target="_blank" rel="noopener">
            <svg class="i" viewBox="0 0 24 24"><path d="M21 11.5a8.38 8.38 0 0 1-8.5 8.5 8.5 8.5 0 0 1-4-1L3 20l1.5-4.5A8.38 8.38 0 0 1 3.5 11 8.5 8.5 0 0 1 12 3a8.38 8.38 0 0 1 8.5 8.5z"/></svg>
            Auf WhatsApp fragen <span class="rec-badge">Am schnellsten</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .hub-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: clamp(1rem, 2vw, 1.5rem); }
  .hub-media { margin-bottom: 1rem; }
  .hub-photo { border-radius: var(--r-media); overflow: hidden; aspect-ratio: 4/3; }
  .hub-photo img { width: 100%; height: 100%; object-fit: cover; display: block; }
</style>
