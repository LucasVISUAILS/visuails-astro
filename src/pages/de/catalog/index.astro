---
// VISUAILS — Catalog hub. Ported from the SvelteKit v2 site's /catalog
// +page.svelte. `catalogStyles` data ported verbatim into
// src/data/catalogStyles.js (shared with catalog/[slug].astro) — see that
// file for the full field set; this page only reads name/slug/cardIcon/
// cardWidth/cardPrice/cardDesc off each entry.
import Layout from '../../../layouts/Layout.astro';
import ProductScene from '../../../components/ProductScene.astro';
import Compare from '../../../components/Compare.astro';
import { catalogStyles } from '../../../data/catalogStyles.de.js';

const faqs = [
  { q: 'Was bekomme ich für €39,99?', a: 'Ein komplettes Set für ein Produkt: vier Fotos — Vorderseite, Rückseite, eine Nahaufnahme des Logos oder Stoffs und eine on-model Aufnahme. Das sind etwa €10 pro Foto.' },
  { q: 'Ist die on-model Aufnahme wirklich inbegriffen?', a: 'Ja — ein on-model Foto gehört zu jedem Produktset, ohne Aufpreis. Wähle im Bestellformular ein Model aus oder lass uns eines wählen, das zu deiner Marke passt.' },
  { q: 'Wie schnell ist die Lieferung?', a: '~24 Std., egal ob du fünf Produkte oder fünfhundert bestellst.' },
  { q: 'Kann ich die Hintergrundfarbe wählen?', a: 'Standard ist reines Weiß (#FFFFFF). Du kannst auch jeden Hex-Code eingeben — eine helle, neutrale Farbe funktioniert am besten — angewendet hinter jedem Produkt, das du schickst.' },
  { q: 'Entsprechen die Visuals den Anforderungen der Marktplätze?', a: 'Ja — zugeschnitten und exportiert für die gängigen Anforderungen der Marktplätze. Sag uns deine Plattform und wir passen die Spezifikationen an.' },
  { q: 'Was, wenn ich Änderungen brauche?', a: 'Drei Revisionsrunden sind inbegriffen, ohne Aufpreis.' },
];
---

<Layout
  title="Catalog Images — saubere, konsistente Produktvisuals | VISUAILS"
  description="Ein Preis pro Produkt: €39,99 für ein komplettes 4-Foto-Set — Vorderseite, Rückseite, eine Logo-/Stoff-Nahaufnahme und eine on-model Aufnahme. Marktplatzfertig, hochauflösend, von Hand geprüft und geliefert in ~24 Std."
>
  <section class="page-hero">
    <div class="container two-col" style="align-items:center">
      <div class="reveal pending">
        <h1 class="display" style="font-size:clamp(2.4rem,5vw,4rem)">Saubere, konsistente Produktvisuals — gebaut, um zu skalieren.</h1>
        <p class="lead" style="margin-top:1.2rem">Ein Produkt, ein Preis: <strong>€39,99</strong> für ein komplettes 4-Foto-Set — Vorderseite, Rückseite, Detail und eine on-model Aufnahme.</p>
        <div class="flex" style="margin-top:1.8rem">
          <span class="magnet-wrap"><span class="magnet-inner"><a href="/de/order-catalog" class="btn btn-primary btn-lg">Catalog-Visuals bestellen</a></span></span>
          <a href="/de/pricing" class="btn btn-ghost btn-lg">Preise ansehen</a>
          <a href="https://wa.me/31625436130?text=Hallo%20VISUAILS%2C%20ich%20m%C3%B6chte%20gerne%20Catalog-Visuals%20f%C3%BCr%20meine%20Produkte%20bestellen." class="btn btn-wa" target="_blank" rel="noopener">
            <svg class="i" viewBox="0 0 24 24"><path d="M21 11.5a8.38 8.38 0 0 1-8.5 8.5 8.5 8.5 0 0 1-4-1L3 20l1.5-4.5A8.38 8.38 0 0 1 3.5 11 8.5 8.5 0 0 1 12 3a8.38 8.38 0 0 1 8.5 8.5z"/></svg>WhatsApp <span class="rec-badge">Am schnellsten</span>
          </a>
        </div>
        <div class="trust-row" style="margin-top:2.4rem">
          <span class="trust-item"><strong>€39,99</strong> pro Produkt</span>
          <span class="trust-item"><strong>4 Fotos</strong> pro Produkt</span>
          <span class="trust-item"><strong>~24 Std.</strong> Lieferung</span>
        </div>
      </div>
      <div class="reveal pending">
        <ProductScene icon="bottle" width="42%" badge="Catalog-Visual, konsistent gemacht" wide />
      </div>
    </div>
  </section>

  <!-- One product = a full 4-photo set. Spelled out so the €39.99 price and
       the included on-model shot are never a surprise. -->
  <section class="section-tight">
    <div class="container">
      <div class="section-head" style="text-align:center;margin-inline:auto">
        <h2>Ein Produkt. Vier Fotos. €39,99.</h2>
        <p style="margin-inline:auto">Jedes Produkt kommt als komplettes Set zurück — inklusive einer echten on-model Aufnahme, nicht nur Flat-Lays. Etwa €10 pro Foto.</p>
      </div>
      <div class="pack-row reveal-group" style="margin-top:2rem">
        <div class="pack-card reveal pending">
          <div class="photo-band"><img src="/img/catalog-after.webp" alt="Vorderseiten-Aufnahme des Produkts für den Katalog" loading="lazy" /><span class="pack-badge">1 · Vorderseite</span></div>
        </div>
        <div class="pack-card reveal pending">
          <div class="photo-band"><img src="/img/catalog-after.webp" alt="Rückseiten-Aufnahme des Produkts für den Katalog" loading="lazy" /><span class="pack-badge">2 · Rückseite</span></div>
        </div>
        <div class="pack-card reveal pending">
          <div class="photo-band"><img src="/img/catalog-before.webp" alt="Detail-Nahaufnahme des Logos oder Stoffs" loading="lazy" /><span class="pack-badge">3 · Detail</span></div>
        </div>
        <div class="pack-card reveal pending">
          <div class="photo-band"><img src="/img/custom-models-02.webp" alt="On-model Aufnahme des Produkts, getragen für Passform und Größe" loading="lazy" /><span class="pack-badge">4 · Auf einem Model</span></div>
        </div>
      </div>
      <div class="flex" style="justify-content:center;margin-top:1.8rem">
        <a href="/de/order-catalog" class="btn btn-primary">Catalog-Visuals bestellen · €39,99 / Produkt</a>
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <h2 style="margin-bottom:2rem">Wähle deinen Catalog-Stil.</h2>
      <div class="grid grid-2">
        {catalogStyles.map((s) => (
          <div class="card card-hover reveal pending">
            <div class="svc-media">
              <ProductScene icon={s.cardIcon} width={s.cardWidth} badge={`Catalog · ${s.name}`} wide />
            </div>
            <div class="svc-body">
              <h3>{s.name}</h3>
              <span class="svc-price">{s.cardPrice}</span>
              <p>{s.cardDesc}</p>
              <div class="flex" style="margin-top:1.2rem">
                <a href={`/de/catalog/${s.slug}`} class="btn btn-primary">{s.name} entdecken</a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <div class="photo-split reveal pending">
        <div class="photo-split-media"><ProductScene icon="jar" width="40%" badge="Ein Foto rein, ein sauberes Set raus" /></div>
        <div>
          <h2>Drei Schritte zu einem sauberen Grid.</h2>
          <div class="steps" style="grid-template-columns:1fr;margin-top:1.6rem;gap:1.1rem">
            <div class="step"><span class="step-n">01</span><h3>Lade ein Foto hoch</h3><p>Wir übernehmen ab hier.</p></div>
            <div class="step"><span class="step-n">02</span><h3>Wir machen es konsistent</h3><p>Gleiches Licht, gleicher Winkel, gleicher Hintergrund — jedes Mal.</p></div>
            <div class="step"><span class="step-n">03</span><h3>Geliefert in ~24 Std.</h3><p>Bereit für deine Website, Anzeigen und Social.</p></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container two-col">
      <div class="reveal pending">
        <h2>Alles, was ein Listing braucht.</h2>
        <ul class="checklist" style="margin-top:1.4rem">
          <li><svg viewBox="0 0 24 24" class="i" style="stroke:var(--success)"><path d="M20 6L9 17l-5-5"/></svg><span>Konsistentes Licht &amp; Winkel</span></li>
          <li><svg viewBox="0 0 24 24" class="i" style="stroke:var(--success)"><path d="M20 6L9 17l-5-5"/></svg><span>Neutraler oder dein gewählter Hintergrund</span></li>
          <li><svg viewBox="0 0 24 24" class="i" style="stroke:var(--success)"><path d="M20 6L9 17l-5-5"/></svg><span>Marktplatzfertiger Zuschnitt</span></li>
          <li><svg viewBox="0 0 24 24" class="i" style="stroke:var(--success)"><path d="M20 6L9 17l-5-5"/></svg><span>Hochauflösender Export</span></li>
          <li><svg viewBox="0 0 24 24" class="i" style="stroke:var(--success)"><path d="M20 6L9 17l-5-5"/></svg><span>~24 Std. Lieferung, von Hand geprüft</span></li>
        </ul>
      </div>
      <div class="reveal pending">
        <ProductScene icon="bag" width="40%" badge="Eine Farbe, jedes Produkt" wide />
        <div class="chip-row" style="margin-top:1.2rem">
          <span class="chip"><span class="dot"></span>Weiß — Standard</span>
          <span class="chip"><span class="dot"></span>Eigene Farbe — jeder Hex-Code</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <div class="section-head" style="text-align:center;margin-inline:auto"><h2>Ein Foto rein. Ein sauberes Visual raus.</h2><p style="margin-inline:auto">Genau das rohe Handyfoto, das ein Kunde geschickt hat — und was zurückkam.</p></div>
      <div style="max-width:520px;margin:2rem auto 0">
        <Compare
          before="/img/catalog-before.webp"
          after="/img/catalog-after.webp"
          ratio="1/1"
          beforeAlt="Ein rohes Handyfoto eines T-Shirts auf einem Tisch vor VISUAILS"
          afterAlt="Dasselbe T-Shirt als sauberes Catalog-Visual nach VISUAILS"
        />
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container two-col">
      <div class="reveal pending">
        <div class="photo-split-media"><img src="/img/catalog-after.webp" alt="Ein sauberes, marktplatzfertiges Catalog-Visual von VISUAILS" loading="lazy" /></div>
      </div>
      <div class="reveal pending">
        <h2>Schnell bedeutet nichts, wenn es nicht stimmt.</h2>
        <p class="lead" style="margin-top:1.2rem">Jedes Visual wird generiert und dann von einem Menschen geprüft, bevor es dich erreicht — Farbe und Detail bleiben korrekt, nichts dem Zufall überlassen.</p>
        <div class="chip-row" style="margin-top:1.6rem">
          <span class="chip"><span class="dot"></span>Konsistentes Licht &amp; Zuschnitt</span>
          <span class="chip"><span class="dot"></span>Marktplatzfertig</span>
          <span class="chip"><span class="dot"></span>Revisionen inbegriffen</span>
        </div>
      </div>
    </div>
  </section>

  <section>
    <div class="container" style="max-width:760px">
      <h2 style="margin-bottom:1.8rem">Catalog-Fragen, beantwortet</h2>
      <div class="faq-stack">
        {faqs.map((f) => (
          <details class="faq-item">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <div class="cta-band reveal pending">
        <h2 class="display" style="font-size:clamp(2.2rem,5vw,3.6rem)">Bau einen Katalog, der<br>wie eine Marke aussieht.</h2>
        <p class="lead" style="margin:1.2rem auto 0;text-align:center">€39,99 pro Produkt — vier Fotos, geliefert in etwa einem Tag.</p>
        <div class="flex" style="justify-content:center;margin-top:2rem">
          <span class="magnet-wrap"><span class="magnet-inner"><a href="/de/order-catalog" class="btn btn-primary btn-lg">Catalog-Visuals bestellen</a></span></span>
          <a href="/de/pricing" class="btn btn-ghost btn-lg">Preise ansehen</a>
          <a href="https://wa.me/31625436130?text=Hallo%20VISUAILS%2C%20ich%20m%C3%B6chte%20gerne%20Catalog-Visuals%20f%C3%BCr%20meine%20Produkte%20bestellen." class="btn btn-wa" target="_blank" rel="noopener">
            <svg class="i" viewBox="0 0 24 24"><path d="M21 11.5a8.38 8.38 0 0 1-8.5 8.5 8.5 8.5 0 0 1-4-1L3 20l1.5-4.5A8.38 8.38 0 0 1 3.5 11 8.5 8.5 0 0 1 12 3a8.38 8.38 0 0 1 8.5 8.5z"/></svg>WhatsApp
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .chip-row { display: flex; flex-wrap: wrap; gap: .6rem; }
  .chip { display: inline-flex; align-items: center; gap: .5rem; font-size: .84rem; color: var(--ink-2); background: var(--surface-2); border: 1px solid var(--line); border-radius: var(--r-pill); padding: .45rem .9rem; }
  .chip .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--accent); flex: 0 0 auto; }
  .faq-stack { display: flex; flex-direction: column; gap: .7rem; }
  .faq-item { background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-lg); padding: 1.1rem 1.3rem; }
  .faq-item summary { cursor: pointer; list-style: none; font-weight: 600; color: var(--ink); font-size: .98rem; }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary::after { content: '+'; float: right; color: var(--accent-bright); font-family: var(--font-display); font-size: 1.2rem; }
  .faq-item[open] summary::after { content: '\2212'; }
  .faq-item p { margin-top: .8rem; color: var(--ink-3); font-size: .92rem; line-height: 1.6; }
  .step { position: relative; border-top: 1px solid var(--line-strong); padding-top: 1.1rem; }
  .step .step-n { font-family: var(--font-display); font-weight: 900; font-size: 1rem; color: var(--accent-bright); }
  .step h3 { font-size: 1.05rem; margin: .5rem 0 .3rem; }
  .step p { font-size: .9rem; color: var(--ink-3); }

  /* The 4-photo product set. Four tiles on desktop, 2×2 on phones. */
  .pack-row { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; }
  @media (max-width: 720px) { .pack-row { grid-template-columns: 1fr 1fr; } }
  .pack-card .photo-band { position: relative; aspect-ratio: 3 / 4; border-radius: var(--r-lg); overflow: hidden; border: 1px solid var(--line); }
  .pack-card .photo-band img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .pack-badge { position: absolute; left: 10px; bottom: 10px; padding: .35rem .7rem; border-radius: var(--r-pill); background: rgba(13,13,20,.72); backdrop-filter: blur(8px); color: #fff; font-size: .78rem; font-weight: 600; }
</style>
