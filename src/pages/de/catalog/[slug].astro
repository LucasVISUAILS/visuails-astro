---
// VISUAILS — shared template for the catalog style detail pages (German / DE).
// Localized copy of src/pages/catalog/[slug].astro — imports the DE data file
// and prefixes every internal link with /de.
import Layout from '../../../layouts/Layout.astro';
import ProductScene from '../../../components/ProductScene.astro';
import Compare from '../../../components/Compare.astro';
import { catalogStyles } from '../../../data/catalogStyles.de.js';

export function getStaticPaths() {
  return catalogStyles.map((s) => ({ params: { slug: s.slug }, props: { style: s } }));
}

const { style } = Astro.props;
const waName = style.name.replaceAll(' ', '%20');
---

<Layout
  title={`${style.name} — Catalog-Stil | VISUAILS`}
  description={`${style.name}: ein charakteristischer VISUAILS Catalog-Stil. ${style.metaPrice}. Produziert in etwa 24 Stunden, jedes Bild von Hand geprüft.`}
>
  <section class="page-hero">
    <div class="container two-col" style="align-items:center">
      <div class="reveal pending">
        <span class="eyebrow-page"><a href="/de/catalog" style="color:inherit">Catalog-Stile</a></span>
        <h1 class="display" style="margin-top:1rem">{style.name}.</h1>
        <p style="margin-top:1rem;font-family:var(--font-display);font-size:clamp(1.35rem,2.3vw,1.9rem);color:var(--ink);max-width:34ch;line-height:1.25">{style.tagline}</p>
        <div class="flex" style="margin-top:1.8rem">
          <span class="magnet-wrap"><span class="magnet-inner"><a href={style.orderHref} class="btn btn-primary btn-lg">{style.name} bestellen</a></span></span>
          <a href={`https://wa.me/31625436130?text=Hallo%20VISUAILS%2C%20ich%20m%C3%B6chte%20gerne%20%C3%BCber%20den%20${waName}-Stil%20sprechen.`} class="btn btn-wa" target="_blank" rel="noopener">
            <svg class="i" viewBox="0 0 24 24"><path d="M21 11.5a8.38 8.38 0 0 1-8.5 8.5 8.5 8.5 0 0 1-4-1L3 20l1.5-4.5A8.38 8.38 0 0 1 3.5 11 8.5 8.5 0 0 1 12 3a8.38 8.38 0 0 1 8.5 8.5z"/></svg>
            WhatsApp
          </a>
        </div>
        <div class="trust-row" style="margin-top:2rem">
          <span class="trust-item"><strong>{style.priceTrust}</strong>{style.priceUnit ?? ' / Visual'}</span>
          <span class="trust-item"><strong>~24 Std.</strong> Lieferung</span>
          <span class="trust-item"><strong>100%</strong> von Hand geprüft</span>
        </div>
      </div>
      <div class="reveal pending">
        <ProductScene icon={style.heroIcon} width={style.heroWidth} badge={`Catalog · ${style.name}`} wide />
      </div>
    </div>
  </section>

  <!-- Mood + how it's made, one photo-split section -->
  <section class="section-tight">
    <div class="container">
      <div class="photo-split reveal pending">
        <div class="photo-split-media"><ProductScene icon={style.cardIcon} width={style.cardWidth} badge={`Catalog · ${style.name}`} /></div>
        <div>
          <h2>Wie sich {style.name} <em>anfühlt</em>.</h2>
          {style.moodParagraphs.map((p) => (
            <p class="lead" style="margin-top:1rem">{p}</p>
          ))}
          <div class="steps" style="grid-template-columns:1fr;margin-top:1.8rem;gap:1.1rem">
            {style.steps.map((s, i) => (
              <div class="step"><span class="step-n">{String(i + 1).padStart(2, '0')}</span><h3>{s.title}</h3><p>{s.body}</p></div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3x3 product-scene grid — the look, in one glance -->
  <section class="section-tight">
    <div class="container">
      <div class="grid grid-3">
        {style.grid.map((g) => (
          <div class="reveal pending">
            <ProductScene icon={g.icon} width={g.width} badge={`Catalog · ${style.name}`} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Real proof, not just illustration — the one genuine raw-to-catalog
       pair in the asset library, framed for this style's own funnel step. -->
  <section class="section-tight">
    <div class="container">
      <div class="section-head" style="text-align:center;margin-inline:auto">
        <h2>Was {style.name} mit einem echten Foto macht.</h2>
        <p style="margin-inline:auto">Eines deiner eigenen Produktfotos, genau so behandelt.</p>
      </div>
      <div style="max-width:520px;margin:2rem auto 0">
        <Compare
          before="/img/catalog-before.webp"
          after="/img/catalog-after.webp"
          ratio="1/1"
          beforeAlt="Ein rohes Handyfoto eines T-Shirts auf einem Tisch vor VISUAILS"
          afterAlt={`Dasselbe T-Shirt als sauberes ${style.name} Catalog-Visual nach VISUAILS`}
        />
      </div>
    </div>
  </section>

  <!-- Craft + why choose it, condensed into one section -->
  <section>
    <div class="container">
      <h2 style="margin-bottom:2rem">Was in jedes Bild einfließt.</h2>
      <div class="arrow-rows" style="grid-template-columns:repeat(2,1fr)">
        {style.craft.map((c) => (
          <div class="reveal pending"><h3>{c.title}</h3><p>{c.body}</p></div>
        ))}
      </div>
      <div class="grid grid-3" style="margin-top:clamp(2.5rem,5vw,4rem)">
        {style.why.map((w) => (
          <div class="card reveal pending"><h3 style="font-size:1.1rem">{w.title}</h3><p style="margin-top:.6rem;font-size:.92rem;color:var(--ink-3)">{w.body}</p></div>
        ))}
      </div>
    </div>
  </section>

  <!-- Best for / what you get -->
  <section class="section-tight">
    <div class="container two-col" style="align-items:start">
      <div class="reveal pending">
        <h2 style="font-size:1.7rem">Ideal <em>für</em></h2>
        <ul class="checklist" style="margin-top:1.2rem">
          {style.bestFor.map((item) => (
            <li><svg viewBox="0 0 24 24" class="i" style="stroke:var(--success)"><path d="M20 6L9 17l-5-5"/></svg><span>{item}</span></li>
          ))}
        </ul>
      </div>
      <div class="reveal pending">
        <h2 style="font-size:1.7rem">Was du <em>bekommst</em></h2>
        <ul class="checklist" style="margin-top:1.2rem">
          {style.whatYouGet.map((item) => (
            <li><svg viewBox="0 0 24 24" class="i" style="stroke:var(--success)"><path d="M20 6L9 17l-5-5"/></svg><span>{item}</span></li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Closing CTA -->
  <section class="section-tight">
    <div class="container">
      <div class="cta-band reveal pending">
        <h2 class="display" style="font-size:clamp(2rem,4.5vw,3.2rem)">Mach {style.name} zu <em>deinem.</em></h2>
        <p class="lead" style="margin:1rem auto 0;text-align:center">Fordere ein Test-Visual an oder bestelle noch heute.</p>
        <div class="flex" style="justify-content:center;margin-top:1.8rem">
          <span class="magnet-wrap"><span class="magnet-inner"><a href={style.orderHref} class="btn btn-primary btn-lg">{style.name} bestellen</a></span></span>
          <a href="/de/test-sample" class="btn btn-ghost btn-lg">Test-Visual</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .step { position: relative; border-top: 1px solid var(--line-strong); padding-top: 1.1rem; }
  .step .step-n { font-family: var(--font-display); font-weight: 900; font-size: 1rem; color: var(--accent-bright); }
  .step h3 { font-size: 1.05rem; margin: .5rem 0 .3rem; }
  .step p { font-size: .9rem; color: var(--ink-3); }
</style>
