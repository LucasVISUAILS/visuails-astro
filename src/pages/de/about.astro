---
// VISUAILS — About. Editorial page: who we are, what we hold to, a fast
// strip of real photography, closing CTA. Ported from the SvelteKit about
// page — see IMAGES.md for the photo strip and hero.
import Layout from '../../layouts/Layout.astro';

const strip = [
  '/img/lifestyle-glow-05.webp',
  '/img/lifestyle-flash-06.webp',
  '/img/lifestyle-dunes-02.webp',
  '/img/lifestyle-phone-made-09.webp',
  '/img/banners-08.webp',
];
---

<Layout
  title="VISUAILS — Über uns"
  description="VISUAILS ist ein Studio für Produkt-Visuals, das moderne Produktionsgeschwindigkeit mit menschlichem Urteil verbindet, damit jede Marke in etwa einem Tag Produkt-Visuals in Studioqualität erhält. Ansässig in Enschede, Niederlande."
>
  <section class="hero-editorial compact">
    <div class="bg" style="background-image:url('/img/banners-13.webp')"></div>
    <div class="fade"></div>
    <div class="hero-editorial-content container">
      <h1 class="display" data-split-lines>Großartige Visuals,<br />ohne das <em>Studio</em>.</h1>
      <p class="lead" style="margin-top:1.2rem">Produkt-Visuals in Studioqualität in etwa einem Tag — moderne Geschwindigkeit, von echten Menschen geprüft.</p>
      <div class="flex" style="margin-top:1.8rem">
        <a href="/de/test-sample" class="btn btn-primary btn-lg">Test-Visual</a>
        <a href="https://wa.me/31625436130?text=Hallo%20VISUAILS%2C%20ich%20möchte%20gerne%20mehr%20über%20euch%20erfahren." class="btn btn-wa" target="_blank" rel="noopener"><svg class="i" viewBox="0 0 24 24"><path d="M21 11.5a8.38 8.38 0 0 1-8.5 8.5 8.5 8.5 0 0 1-4-1L3 20l1.5-4.5A8.38 8.38 0 0 1 3.5 11 8.5 8.5 0 0 1 12 3a8.38 8.38 0 0 1 8.5 8.5z"/></svg>WhatsApp</a>
      </div>
    </div>
  </section>

  <section class="section-tight"><div class="container">
    <div class="photo-split reveal pending">
      <div class="photo-split-media"><img src="/img/custom-models-01.webp" alt="Eine VISUAILS-Kampagnenszene, gestylt und fotografiert für eine Kundenmarke" loading="lazy" /></div>
      <div>
        <h2>Geschwindigkeit und Urteil, <em>zusammen</em>.</h2>
        <p class="lead" style="margin-top:1rem">Ein kleines Team in Enschede, Niederlande. Aus einem Foto wird in etwa einem Tag ein kompletter Satz — und ein echter Mensch prüft jedes Bild, bevor es dich erreicht.</p>
        <div class="chip-row" style="margin-top:1.4rem">
          <span class="chip"><span class="dot"></span>Enschede, NL</span>
          <span class="chip"><span class="dot"></span>100% von Menschen geprüft</span>
          <span class="chip"><span class="dot"></span>~24 Std. Lieferung</span>
        </div>
      </div>
    </div>
  </div></section>

  <section class="section-tight"><div class="container">
    <h2 style="margin-bottom:2rem">Drei Dinge, an denen wir festhalten.</h2>
    <div class="grid grid-3 reveal-group">
      <div class="card card-hover reveal pending"><h3>Geschwindigkeit, ohne die Abkürzung</h3><p style="margin-top:.6rem;color:var(--ink-3)">Schnelle Lieferung, und trotzdem veröffentlichungswürdig.</p></div>
      <div class="card card-hover reveal pending"><h3>Konsistenz gewinnt</h3><p style="margin-top:.6rem;color:var(--ink-3)">Ein einheitlicher Look, über dein gesamtes Sortiment.</p></div>
      <div class="card card-hover reveal pending"><h3>Offen für alle</h3><p style="margin-top:.6rem;color:var(--ink-3)">Katalog ab &euro;39,99 pro Produkt. Kein Abo.</p></div>
    </div>
  </div></section>

  <section class="section-tight"><div class="container">
    <div class="photo-grid reveal pending">
      <img src={strip[0]} alt="Lifestyle-Visual im Glow-Stil" loading="lazy" class="wide" />
      <img src={strip[1]} alt="Lifestyle-Visual im Flash-Stil" loading="lazy" />
      <img src={strip[2]} alt="Lifestyle-Visual im Dunes-Stil" loading="lazy" />
      <img src={strip[3]} alt="Lifestyle-Visual im Phone-made-Stil" loading="lazy" />
      <img src={strip[4]} alt="Kampagnenfotografie" loading="lazy" class="wide" />
    </div>
  </div></section>

  <section class="section-tight"><div class="container">
    <div class="cta-band reveal pending">
      <h2 class="display" style="font-size:clamp(2.2rem,5vw,3.6rem)">Lass uns <em>zusammen</em> wachsen.</h2>
      <p class="lead" style="margin:1.2rem auto 0;text-align:center">Test-Visual, oder schreib uns auf WhatsApp.</p>
      <div class="flex" style="justify-content:center;margin-top:2rem">
        <a href="/de/test-sample" class="btn btn-primary btn-lg">Test-Visual</a>
        <a href="https://wa.me/31625436130?text=Hallo%20VISUAILS%2C%20ich%20möchte%20über%20Visuals%20für%20meine%20Marke%20sprechen." class="btn btn-wa" target="_blank" rel="noopener"><svg class="i" viewBox="0 0 24 24"><path d="M21 11.5a8.38 8.38 0 0 1-8.5 8.5 8.5 8.5 0 0 1-4-1L3 20l1.5-4.5A8.38 8.38 0 0 1 3.5 11 8.5 8.5 0 0 1 12 3a8.38 8.38 0 0 1 8.5 8.5z"/></svg>WhatsApp</a>
      </div>
    </div>
  </div></section>
</Layout>

<style>
  .chip-row { display: flex; flex-wrap: wrap; gap: .5rem; }
  .chip { display: inline-flex; align-items: center; gap: .45rem; padding: .4rem .9rem; border-radius: var(--r-pill); border: 1px solid var(--line); font-size: .8rem; color: var(--ink-2); }
  .chip .dot { width: 5px; height: 5px; border-radius: 50%; background: var(--accent); }
</style>
