---
// VISUAILS — Preise (Deutsch). Übersetzung von src/pages/pricing.astro.
import Layout from '../../layouts/Layout.astro';
import ProductScene from '../../components/ProductScene.astro';
import ThreeWay from '../../components/ThreeWay.astro';

const plans = [
  { name: 'Catalog', price: '€39,99', unit: '/ Produkt', accent: false, desc: 'Ein komplettes 4-Foto-Set pro Produkt — etwa €10 pro Foto.', features: ['4 Fotos: Vorne, hinten, Detail & On-Model', 'On-Model-Shot inklusive, ohne Aufpreis', '3 Revisionsrunden'], cta: 'Catalog bestellen' },
  { name: 'Lifestyle', price: '€35', unit: 'ab / Visual', accent: true, desc: 'Dein Produkt in gestylten, realistischen Szenen.', features: ['Natürliches Licht, gestylte Szenen', 'Standardmodelle inklusive', '3 Revisionsrunden'], cta: 'Lifestyle bestellen' },
  { name: 'Video', price: '€49', unit: '/ Video', accent: false, desc: 'Produktvideos mit subtiler Bewegung für Feeds und Ads.', features: ['Motion ab €49, Lifestyle ab €59', 'Kampagnenvideos pro Projekt angeboten', 'Menschliche Prüfung vor Lieferung'], cta: 'Video bestellen' },
];

const addons = [
  { name: 'Multi-Format-Export', desc: 'Geliefert in 1:1, 4:5, 9:16 und 16:9.', price: '+€19,99' },
  { name: '4K-Export', desc: 'Höhere Auflösung statt der Standard-2K.', price: '+€9,99' },
  { name: 'Priority-Lieferung', desc: 'Vorrang an die Spitze der Warteschlange.', price: '+€29,99' },
];

const tiers = [
  { n: '1–24', desc: 'Standardpreis' },
  { n: '25–99', desc: 'Mengenrabatt möglich' },
  { n: '100+', desc: 'Bester Preis — Angebot anfragen' },
];

const included = ['Menschliche Prüfung bei jedem Visual', '2K-Export', 'Lieferung in ~24 Std.', '3 Revisionsrunden'];

const faqs = [
  { q: 'Wie und wann bezahle ich?', a: "Du bezahlst deine Bestellung erst, nachdem du das Ergebnis freigegeben hast — nie im Voraus. Die einzige Ausnahme ist das optionale €0,99-Test-Visual, das im Voraus bezahlt wird, um es fair zu halten (eines pro Unternehmen). Wir stellen direkt in Rechnung; iDEAL und weitere Sofortoptionen kommen bald, gib bei der Bestellung einfach deine Präferenz an." },
  { q: 'Wie funktioniert die Umsatzsteuer / Reverse-Charge?', a: "Wir sitzen in den Niederlanden (USt NL005407575B96). EU-Unternehmen mit gültiger USt-IdNr. können sie bei der Bestellung angeben — für Reverse-Charge und schnellere Rechnungsstellung." },
  { q: 'Was zählt als ein "Visual"?', a: 'Ein fertiges Bild. Der Multi-Format-Export liefert es in mehreren Seitenverhältnissen — trotzdem ein Visual, nicht vier. Catalog ist die Ausnahme: es kostet €39,99 pro Produkt und enthält immer vier Fotos (vorne, hinten, Detail und On-Model).' },
  { q: 'Wie funktioniert Custom-Pricing?', a: 'Ein eigener Stil oder ein eigenes Modell ist eine einmalige Design-Gebühr, danach der normale Preis pro Visual bei jeder weiteren Bestellung. Standardvideos haben feste Preise (Motion ab €49, Lifestyle ab €59); größere Kampagnenvideos werden pro Projekt über eine kurze WhatsApp-Abstimmung angeboten.' },
];
---

<Layout
  title="VISUAILS — Einfache, transparente Preise"
  description="Einfache Preise bei VISUAILS — Catalog €39,99 pro Produkt (ein 4-Foto-Set), Lifestyle ab €35 pro Visual und Custom-Video. Keine Abos, keine versteckten Kosten. Menschliche Prüfung, 2K-Export, Lieferung in ~24 Std. und 3 Revisionsrunden immer inklusive."
>
  <section class="page-hero"><div class="container">
    <p class="eyebrow-page">Preise</p>
    <h1 class="display" style="font-size:clamp(2.4rem,5vw,4rem)">Einfache, transparente Preise</h1>
    <p class="lead" style="margin-top:1.2rem">Zahle nach Bedarf — pro Produkt oder pro Visual. Keine Abos, keine versteckten Kosten.</p>
    <div class="flex" style="margin-top:1.8rem"><a href="/de/order" class="btn btn-primary btn-lg">Jetzt bestellen</a><a href="/de/test-sample" class="btn btn-ghost btn-lg">Test-Visual</a></div>
  </div></section>

  <section><div class="container">
    <div class="section-head"><h2>Zahle nach Bedarf</h2><p>Keine Abos. Bestelle fünf oder fünfhundert — bei derselben kurzen Wartezeit.</p></div>
    <div class="grid grid-3 reveal-group">
      {plans.map((p) => (
        <div class="card plan-card reveal pending" style={p.accent ? 'border-color:var(--accent-line)' : undefined}>
          <h3>{p.name}</h3>
          <div class="price-big">{p.price} <small>{p.unit}</small></div>
          <p style="color:var(--ink-3)">{p.desc}</p>
          <ul class="checklist" style="margin-top:1.2rem;margin-bottom:1.6rem">
            {p.features.map((f) => (
              <li><svg class="i" viewBox="0 0 24 24" style="stroke:var(--success)"><path d="M20 6L9 17l-5-5"/></svg>{f}</li>
            ))}
          </ul>
          <a href="/de/order" class="btn btn-primary btn-block" style="margin-top:auto">{p.cta}</a>
        </div>
      ))}
    </div>
    <p class="pill-note" style="margin-top:1.8rem">Ein eigener Stil oder ein eigenes Modell ist eine einmalige Design-Gebühr, danach der normale Visual-Preis.</p>
  </div></section>

  <section class="section-tight"><div class="container narrow">
    <div class="section-head"><h2>Add-ons</h2></div>
    <div class="addon-list reveal pending">
      {addons.map((a) => (
        <div class="addon">
          <div>
            <div style="font-weight:600">{a.name}</div>
            <div style="font-size:.92rem;color:var(--ink-3)">{a.desc}</div>
          </div>
          <div class="addon-price">{a.price}</div>
        </div>
      ))}
    </div>
  </div></section>

  <section class="section-tight"><div class="container narrow">
    <div class="section-head"><h2>Menge</h2></div>
    <div class="tier-row reveal pending">
      {tiers.map((t) => (
        <div class="tier">
          <div class="tn">{t.n}</div>
          <div style="font-size:.92rem;color:var(--ink-3)">{t.desc}</div>
        </div>
      ))}
    </div>
    <p class="pill-note" style="margin-top:1.4rem"><a href="https://wa.me/31625436130?text=Hi%20VISUAILS%2C%20ich%20h%C3%A4tte%20gerne%20ein%20Mengenangebot." class="link-arrow" style="font-size:1rem" target="_blank" rel="noopener">Für ein Mengenangebot kontaktieren <svg viewBox="0 0 24 24" class="i"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a></p>
  </div></section>

  <section><div class="container">
    <div class="card reveal pending" style="padding:clamp(1.6rem,3vw,2.6rem)">
      <div class="section-head" style="margin-bottom:1.4rem"><h2>Immer inklusive</h2></div>
      <div class="grid included-grid">
        {included.map((item) => (
          <div class="chip"><span class="dot"></span>{item}</div>
        ))}
      </div>
    </div>
  </div></section>

  <section class="section-tight"><div class="container">
    <ThreeWay
      heading="Warum nicht einfach shooten — oder einfach eine KI prompten?"
      sub="Hier ist die ehrliche Abwägung. VISUAILS ist gebaut, um dir die schnelle, günstige Seite der KI und die präzise, menschlich geprüfte Seite eines echten Shootings zu geben."
      cta={false}
    />
  </div></section>

  <section class="section-tight"><div class="container">
    <div class="card reveal pending" style="border-color:var(--accent-line)">
      <div class="two-col" style="align-items:center">
        <div>
          <h2>Test-Visual</h2>
          <p class="measure" style="margin-top:1rem">Sieh dein eigenes Produkt verwandelt, bevor du dich festlegst — für nur €0,99 zur Verifizierung. Ein Test pro Unternehmen.</p>
          <div class="flex" style="margin-top:1.6rem"><a href="/de/test-sample" class="btn btn-primary">Test-Visual anfragen</a></div>
        </div>
        <div><ProductScene icon="bottle" width="42%" badge="1 Test-Visual pro Unternehmen" wide /></div>
      </div>
    </div>
    <p class="pill-note" style="margin-top:1.4rem">Hast du eine USt-IdNr.? Du kannst sie bei der Bestellung angeben, um die Rechnungsstellung zu beschleunigen — optional.</p>
  </div></section>

  <section><div class="container narrow">
    <div class="section-head"><h2>Preis-FAQ</h2></div>
    <div class="acc reveal pending">
      {faqs.map((f) => (
        <details class="acc-item">
          <summary class="acc-q"><span>{f.q}</span><span class="acc-icon" aria-hidden="true"><svg viewBox="0 0 24 24" class="i" style="width:14px;height:14px"><path d="M12 5v14M5 12h14"/></svg></span></summary>
          <div class="acc-body-inner"><p>{f.a}</p></div>
        </details>
      ))}
    </div>
  </div></section>

  <section class="section-tight"><div class="container">
    <div class="cta-band reveal pending">
      <h2 class="display" style="font-size:clamp(2.2rem,5vw,3.6rem)">Transparente Preise.<br />Keine <em>Überraschungen.</em></h2>
      <div class="flex" style="justify-content:center;margin-top:2rem">
        <a href="/de/test-sample" class="btn btn-primary btn-lg">€0,99-Test-Visual testen</a>
        <a href="/de/order" class="btn btn-ghost btn-lg">Jetzt bestellen</a>
        <a href="https://wa.me/31625436130?text=Hi%20VISUAILS%2C%20ich%20habe%20eine%20Frage%20zu%20den%20Preisen." class="btn btn-wa" target="_blank" rel="noopener"><svg class="i" viewBox="0 0 24 24"><path d="M21 11.5a8.38 8.38 0 0 1-8.5 8.5 8.5 8.5 0 0 1-4-1L3 20l1.5-4.5A8.38 8.38 0 0 1 3.5 11 8.5 8.5 0 0 1 12 3a8.38 8.38 0 0 1 8.5 8.5z"/></svg>WhatsApp</a>
      </div>
    </div>
  </div></section>
</Layout>

<style>
  .container.narrow { max-width: 760px; }
  .plan-card { display: flex; flex-direction: column; }
  .price-big { font-family: var(--font-display); font-weight: 400; font-size: 2.6rem; line-height: 1; color: var(--ink); margin: .3rem 0 .2rem; }
  .price-big small { font-family: var(--font-body); font-size: .85rem; font-weight: 500; color: var(--ink-3); }
  .pill-note { display: inline-flex; align-items: center; gap: .5rem; padding: .45rem 1rem; border-radius: var(--r-pill); border: 1px solid var(--line); color: var(--ink-3); font-size: .82rem; font-weight: 500; }
  .measure { max-width: 60ch; }
  .addon-list { display: flex; flex-direction: column; gap: .9rem; margin-top: 1.3rem; }
  .addon { display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; padding: 1rem 1.2rem; border: 1px solid var(--line); border-radius: var(--r-lg); }
  .addon-price { font-family: var(--font-display); font-size: 1.1rem; color: var(--ink); white-space: nowrap; }
  .tier-row { display: flex; gap: .8rem; flex-wrap: wrap; margin-top: 1.2rem; }
  .tier { flex: 1 1 160px; border: 1px solid var(--line); border-radius: var(--r-lg); padding: 1rem 1.2rem; }
  .tier .tn { font-family: var(--font-display); font-size: 1.3rem; color: var(--ink); }
  .included-grid { grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); }
  .chip { display: inline-flex; align-items: center; gap: .45rem; padding: .4rem .85rem; border-radius: var(--r-pill); border: 1px solid var(--line); font-size: .85rem; color: var(--ink-2); }
  .chip .dot { width: 5px; height: 5px; border-radius: 50%; background: var(--accent); }
  .acc-item { box-shadow: inset 0 -1px 0 var(--line); }
  .acc-q { width: 100%; display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding: 1.35rem 0; text-align: left; font-family: var(--font-body); font-size: 1.05rem; font-weight: 600; color: var(--ink); cursor: pointer; list-style: none; }
  .acc-q::-webkit-details-marker { display: none; }
  .acc-icon { flex: 0 0 auto; width: 28px; height: 28px; border-radius: 50%; border: 1px solid var(--line-strong); display: grid; place-items: center; transition: transform .4s var(--ease), background .4s var(--ease), color .4s var(--ease), border-color .4s var(--ease); }
  .acc-item[open] .acc-icon { transform: rotate(45deg); background: var(--accent); border-color: var(--accent); color: #fff; }
  .acc-body-inner { padding-bottom: 1.35rem; color: var(--ink-2); max-width: 70ch; }
</style>
