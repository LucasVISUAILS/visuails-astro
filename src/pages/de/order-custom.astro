---
// VISUAILS — custom styling. Ported from the SvelteKit /order-custom route:
// this page never posts to a backend in the source either — it builds a
// pre-filled WhatsApp deep link from the form fields and hands off there,
// which works fully client-side with no server involved. Preserved as-is
// (same field set feeding the same message template, including the
// source's own quirk of collecting a WhatsApp number field that isn't
// actually included in the generated message text).
//
// The Svelte source used $state/$derived to keep the "Continue on WhatsApp"
// link's href live as the visitor types — that's load-bearing (it's the
// entire mechanism this page uses to "submit"), so it's reproduced below
// with a small page-scoped vanilla-JS block instead of Astro frontmatter.
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Custom styling — VISUAILS"
  description="Vereinbare einen Custom-Katalogstil, Lifestyle-Stil oder ein Custom-Modell komplett über WhatsApp — danach schauen wir uns Stil und Budget gemeinsam an."
>
  <section class="page-hero" style="padding-bottom:0">
    <div class="container">
      <p class="eyebrow-page"><a href="/de/order" style="color:inherit">&larr; Alle Bestelloptionen</a></p>
    </div>
  </section>

  <section id="custom" class="ord-anchor section-tight">
    <div class="container narrow">
      <div class="section-head">
        <h1 style="font-size:var(--t-h2)">Etwas individueller?</h1>
        <p>Komplett über WhatsApp geregelt — wir schauen uns Stil und Budget gemeinsam an.</p>
      </div>
      <div class="card" style="padding:clamp(1.4rem,3vw,2.4rem)">
        <div class="custom-photo">
          <img src="/img/custom-models-01.webp" alt="Ein individuell gestyltes VISUAILS-Modell" loading="lazy" />
        </div>
        <form id="custom-form">
          <div class="row-2">
            <div class="field">
              <label for="cu-name">Name <span class="req">*</span></label>
              <input class="input" type="text" id="cu-name" name="name" autocomplete="name" required />
            </div>
            <div class="field">
              <label for="cu-brand">Marken- oder Firmenname <span class="req">*</span></label>
              <input class="input" type="text" id="cu-brand" name="brand" autocomplete="organization" required />
            </div>
          </div>
          <div class="field">
            <label for="cu-type">Wonach suchst du? <span class="req">*</span></label>
            <select class="select" id="cu-type" name="type" required>
              <option value="" disabled selected>Wähle eine Option&hellip;</option>
              <option value="Custom catalog style">Custom-Katalogstil</option>
              <option value="Custom lifestyle style">Custom-Lifestyle-Stil</option>
              <option value="Custom model">Custom-Modell</option>
              <option value="Something else">Etwas anderes</option>
            </select>
          </div>
          <div class="field">
            <label for="cu-idea">Erzähl uns, was du dir vorstellst <span class="req">*</span></label>
            <textarea class="textarea" id="cu-idea" name="idea" style="min-height:90px" placeholder="Ein paar Zeilen zum Look, zu Referenzen oder zum Ziel." required></textarea>
          </div>
          <div class="field">
            <label for="cu-wa">WhatsApp-Nummer <span class="req">*</span></label>
            <input class="input" type="tel" id="cu-wa" name="whatsapp" autocomplete="tel" placeholder="+31 6 &hellip;" required />
          </div>
          <a href="https://wa.me/31625436130" id="custom-wa-link" class="btn btn-wa btn-lg btn-block" style="margin-top:1.2rem" target="_blank" rel="noopener">
            <svg class="i" viewBox="0 0 24 24"><path d="M21 11.5a8.38 8.38 0 0 1-8.5 8.5 8.5 8.5 0 0 1-4-1L3 20l1.5-4.5A8.38 8.38 0 0 1 3.5 11 8.5 8.5 0 0 1 12 3a8.38 8.38 0 0 1 8.5 8.5z" /></svg>
            Weiter auf WhatsApp
          </a>
        </form>
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <div class="section-head">
        <h2 style="font-size:1.4rem">Suchst du etwas anderes?</h2>
      </div>
      <div class="chip-row">
        <a href="/de/order-catalog" class="chip">Katalog</a>
        <a href="/de/order-lifestyle" class="chip">Lifestyle</a>
        <a href="/de/order-video" class="chip">Video</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Order-form controls — page-scoped (see order-catalog.astro for the same
     block; duplicated per-page rather than added to global.css). */
  .narrow { max-width: 820px; }
  .custom-photo { border-radius: var(--r-media); overflow: hidden; max-height: 220px; margin-bottom: 1.4rem; }
  .custom-photo img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .field { display: flex; flex-direction: column; gap: 0.45rem; margin-bottom: 1.1rem; }
  .field label { font-size: 0.88rem; font-weight: 600; color: var(--ink); }
  .req { color: var(--accent-bright); }
  .hint { font-size: 0.8rem; color: var(--ink-3); }
  .input, .textarea, .select { width: 100%; padding: 0.85rem 1rem; background: var(--surface); border: 1px solid var(--line-strong); border-radius: var(--r-sm); color: var(--ink); transition: border-color 0.22s var(--ease), box-shadow 0.22s var(--ease); font-size: 0.98rem; font-family: var(--font-body); }
  .input::placeholder, .textarea::placeholder { color: var(--ink-3); }
  .input:focus, .textarea:focus, .select:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-soft); }
  .select option { background: var(--surface); color: var(--ink); }
  .textarea { resize: vertical; font-family: var(--font-body); }
  .row-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 1.1rem; }
  @media (max-width: 620px) { .row-2 { grid-template-columns: 1fr; } }
  .chip-row { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .chip { display: inline-flex; align-items: center; gap: 0.45rem; padding: 0.4rem 0.9rem; border-radius: var(--r-pill); border: 1px solid var(--line); font-size: 0.8rem; color: var(--ink-2); }
  a.chip { transition: border-color var(--dur) var(--ease), color var(--dur) var(--ease); }
  a.chip:hover { border-color: var(--accent-line); color: var(--ink); }
  .ord-anchor { scroll-margin-top: 100px; }
</style>

<script>
  // Rebuilds the "Continue on WhatsApp" link's href live as the visitor
  // types, mirroring the Svelte source's $derived(waText)/$derived(waHref).
  // Page-scoped only (not added to src/scripts/interactions.js) and guarded
  // against double-binding so it survives a ClientRouter view transition
  // back onto this page.
  function initCustomOrderForm() {
    const form = document.querySelector<HTMLFormElement>('#custom-form');
    if (!form || form.dataset.waBound) return;
    form.dataset.waBound = '1';

    const nameEl = document.querySelector<HTMLInputElement>('#cu-name');
    const brandEl = document.querySelector<HTMLInputElement>('#cu-brand');
    const typeEl = document.querySelector<HTMLSelectElement>('#cu-type');
    const ideaEl = document.querySelector<HTMLTextAreaElement>('#cu-idea');
    const waLink = document.querySelector<HTMLAnchorElement>('#custom-wa-link');
    if (!nameEl || !brandEl || !typeEl || !ideaEl || !waLink) return;

    const update = () => {
      const waText =
        `Hi VISUAILS, ich interessiere mich für Custom Styling.\n\n` +
        `Name: ${nameEl.value}\nUnternehmen: ${brandEl.value}\nSuche nach: ${typeEl.value}\nVorstellung: ${ideaEl.value}`;
      waLink.href = `https://wa.me/31625436130?text=${encodeURIComponent(waText)}`;
    };

    [nameEl, brandEl, typeEl, ideaEl].forEach((el) => el.addEventListener('input', update));
    typeEl.addEventListener('change', update);
    update();
  }

  initCustomOrderForm();
  document.addEventListener('astro:page-load', initCustomOrderForm);
</script>
