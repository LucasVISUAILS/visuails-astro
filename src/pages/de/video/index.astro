---
// VISUAILS — Video hub. Ported from the SvelteKit v2 site's /video
// +page.svelte. `videoStyles` data ported verbatim from
// $lib/data/videoStyles.js (only the fields this page uses: slug, name,
// cardPrice).
import Layout from '../../../layouts/Layout.astro';

const videoStyles = [
  { slug: 'motion', name: 'Motion', cardPrice: 'Ab €49 / Video' },
  { slug: 'lifestyle', name: 'Lifestyle Video', cardPrice: 'Ab €59 / Video' },
  { slug: 'campaign', name: 'Campaign', cardPrice: 'Individuelles Angebot' },
  { slug: 'custom', name: 'Custom', cardPrice: 'Individuelles Angebot' },
];

const posters: Record<string, string> = {
  motion: '/img/banners-04.webp',
  lifestyle: '/img/lifestyle-glow-03.webp',
  campaign: '/img/banners-08.webp',
  custom: '/img/banners-13.webp',
};

const strip = [
  '/img/banners-01.webp',
  '/img/lifestyle-flash-02.webp',
  '/img/lifestyle-phone-made-09.webp',
  '/img/lifestyle-dunes-02.webp',
  '/img/banners-06.webp',
];
---

<Layout
  title="Produkt- & Kampagnenvideos — kurze Produktvideos, die sich bewegen | VISUAILS"
  description="Saubere Produktvideos von 8 Sekunden mit subtiler Bewegung — gemacht für Produktseiten, Social und einfache Anzeigen. Von Hand geprüft und geliefert in ~24 Std. Standard-Produktvideos ab €49; größere Kampagnen auf Anfrage."
>
  <section class="hero-editorial compact">
    <div class="bg" style="background-image:url('/img/banners-03.webp')"></div>
    <div class="fade"></div>
    <div class="hero-editorial-content container">
      <h1 class="display" style="font-size:clamp(2.8rem,6.5vw,5.4rem)">Kurze Produktvideos,<br />die sich <em>bewegen</em>.</h1>
      <p class="lead" style="margin-top:1.2rem;color:rgba(228,231,242,.86)">8 Sekunden, subtile Bewegung. Ab €49.</p>
      <div class="flex" style="margin-top:1.8rem">
        <span class="magnet-wrap"><span class="magnet-inner"><a href="/de/order-video" class="btn btn-primary btn-lg">Visuals holen</a></span></span>
        <a href="https://wa.me/31625436130?text=Hallo%20VISUAILS%2C%20ich%20m%C3%B6chte%20gerne%20%C3%BCber%20ein%20Produktvideo%20sprechen." class="btn btn-wa" target="_blank" rel="noopener">
          <svg class="i" viewBox="0 0 24 24"><path d="M21 11.5a8.38 8.38 0 0 1-8.5 8.5 8.5 8.5 0 0 1-4-1L3 20l1.5-4.5A8.38 8.38 0 0 1 3.5 11 8.5 8.5 0 0 1 12 3a8.38 8.38 0 0 1 8.5 8.5z"/></svg>WhatsApp <span class="rec-badge">Am schnellsten</span>
        </a>
      </div>
      <div class="trust-row" style="margin-top:2.2rem">
        <span class="trust-item"><strong>8s</strong> saubere Produktvideos</span>
        <span class="trust-item"><strong>~24 Std.</strong> Lieferung</span>
        <span class="trust-item"><strong>100%</strong> von Hand geprüft</span>
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <h2 style="margin-bottom:2rem">Wege, um Bewegung hinzuzufügen.</h2>
      <div class="grid grid-3 reveal-group">
        {videoStyles.map((s) => (
          <a href={`/de/video/${s.slug}`} class="reveal pending" style="display:block">
            <div class="photo-band tall">
              <img src={posters[s.slug]} alt={`${s.name} Beispiel`} loading="lazy" />
              <div class="scrim"></div>
              <div class="caption">
                <h3 style="color:#fff">{s.name} &rarr;</h3>
                <p style="color:rgba(255,255,255,.82);font-size:.9rem;margin-top:.35rem">{s.cardPrice}</p>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container two-col">
      <div class="reveal pending">
        <h2>Saubere Bewegung, bereit zum Veröffentlichen.</h2>
        <ul class="checklist" style="margin-top:1.4rem">
          <li><svg viewBox="0 0 24 24" class="i" style="stroke:var(--success)"><path d="M20 6L9 17l-5-5"/></svg><span>8-Sekunden-Video mit subtiler Bewegung</span></li>
          <li><svg viewBox="0 0 24 24" class="i" style="stroke:var(--success)"><path d="M20 6L9 17l-5-5"/></svg><span>Passend für Seiten, Social und Anzeigen</span></li>
          <li><svg viewBox="0 0 24 24" class="i" style="stroke:var(--success)"><path d="M20 6L9 17l-5-5"/></svg><span>Konsistenter Stil über deine gesamte Bandbreite</span></li>
          <li><svg viewBox="0 0 24 24" class="i" style="stroke:var(--success)"><path d="M20 6L9 17l-5-5"/></svg><span>~24 Std. Lieferung, von Hand geprüft</span></li>
        </ul>
      </div>
      <div class="reveal pending card" style="border-color:var(--accent-line)">
        <h3>Zwei Wege, Video zu kaufen</h3>
        <p style="margin-top:.8rem;color:var(--ink-2)"><strong>Motion &amp; Lifestyle</strong> — Festpreis, bestell wie Bilder, ab €49.</p>
        <p style="margin-top:.6rem;color:var(--ink-2)"><strong>Campaign</strong> — größer, mehrere Aufnahmen, Angebot pro Projekt.</p>
        <div class="flex" style="margin-top:1.4rem">
          <a href="/de/order-video" class="btn btn-primary">Ein Produktvideo bestellen</a>
          <a href="https://wa.me/31625436130?text=Hallo%20VISUAILS%2C%20ich%20m%C3%B6chte%20gerne%20ein%20Angebot%20f%C3%BCr%20ein%20Kampagnenvideo." class="btn btn-wa" target="_blank" rel="noopener">
            <svg class="i" viewBox="0 0 24 24"><path d="M21 11.5a8.38 8.38 0 0 1-8.5 8.5 8.5 8.5 0 0 1-4-1L3 20l1.5-4.5A8.38 8.38 0 0 1 3.5 11 8.5 8.5 0 0 1 12 3a8.38 8.38 0 0 1 8.5 8.5z"/></svg>Kampagne anfragen
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <div class="photo-grid reveal pending">
        <img src={strip[0]} alt="Kampagnenfotografie" loading="lazy" class="wide" />
        <img src={strip[1]} alt="Lifestyle-Visual im Flash-Stil" loading="lazy" />
        <img src={strip[2]} alt="Lifestyle-Visual im Phone-made-Stil" loading="lazy" />
        <img src={strip[3]} alt="Lifestyle-Visual im Dunes-Stil" loading="lazy" />
        <img src={strip[4]} alt="Kampagnenfotografie" loading="lazy" class="wide" />
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <div class="cta-band reveal pending">
        <h2 class="display" style="font-size:clamp(2.2rem,5vw,3.6rem)">Gib deinem Produkt<br>ein bisschen Bewegung.</h2>
        <p class="lead" style="margin:1.2rem auto 0;text-align:center">Ab €49, geliefert in etwa einem Tag.</p>
        <div class="flex" style="justify-content:center;margin-top:2rem">
          <span class="magnet-wrap"><span class="magnet-inner"><a href="/de/order-video" class="btn btn-primary btn-lg">Visuals holen</a></span></span>
          <a href="/de/contact" class="btn btn-ghost btn-lg">Kontaktiere uns</a>
          <a href="https://wa.me/31625436130?text=Hallo%20VISUAILS%2C%20ich%20m%C3%B6chte%20gerne%20%C3%BCber%20ein%20Produktvideo%20sprechen." class="btn btn-wa" target="_blank" rel="noopener">
            <svg class="i" viewBox="0 0 24 24"><path d="M21 11.5a8.38 8.38 0 0 1-8.5 8.5 8.5 8.5 0 0 1-4-1L3 20l1.5-4.5A8.38 8.38 0 0 1 3.5 11 8.5 8.5 0 0 1 12 3a8.38 8.38 0 0 1 8.5 8.5z"/></svg>WhatsApp
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
