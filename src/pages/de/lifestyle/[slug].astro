---
// VISUAILS — shared template for the lifestyle style detail pages (German /
// DE). Localized copy of src/pages/lifestyle/[slug].astro — imports the DE
// data file and prefixes every internal link with /de.
import Layout from '../../../layouts/Layout.astro';
import ProductScene from '../../../components/ProductScene.astro';
import Compare from '../../../components/Compare.astro';
import { styles } from '../../../data/styles.de.js';

export function getStaticPaths() {
  return styles.map((s) => ({ params: { slug: s.slug }, props: { style: s } }));
}

const { style } = Astro.props;
// Preset styles are a fixed per-visual price; Custom is quoted, so fall back
// to a per-style price when one is set.
const priceLine = style.priceTrust ? `${style.priceTrust}${style.priceUnit ?? ''}` : 'Ab €35 / Visual';
---

<Layout
  title={`${style.name} — Lifestyle-Stil | VISUAILS`}
  description={`${style.name}: ein charakteristischer VISUAILS Lifestyle-Stil. ${priceLine}. Produziert in etwa 24 Stunden, jedes Bild von Hand geprüft.`}
>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow-page"><a href="/de/lifestyle" style="color:inherit">&larr; Lifestyle-Stile</a></p>
      <h1 class="display">{style.name}.</h1>
      <p style="margin-top:1rem;font-family:var(--font-display);font-size:clamp(1.35rem,2.3vw,1.9rem);color:var(--ink);max-width:34ch;line-height:1.25">{style.tagline}</p>
      <div class="flex" style="margin-top:1.8rem">
        <span class="magnet-wrap"><span class="magnet-inner"><a href={style.orderHref ?? '/de/order-lifestyle'} class="btn btn-primary btn-lg">{style.orderLabel ?? `${style.name} bestellen`}</a></span></span>
        <a href={`https://wa.me/31625436130?text=Hallo%20VISUAILS%2C%20ich%20m%C3%B6chte%20gerne%20%C3%BCber%20den%20${style.name}-Stil%20sprechen.`} class="btn btn-wa" target="_blank" rel="noopener">
          <svg class="i" viewBox="0 0 24 24"><path d="M21 11.5a8.38 8.38 0 0 1-8.5 8.5 8.5 8.5 0 0 1-4-1L3 20l1.5-4.5A8.38 8.38 0 0 1 3.5 11 8.5 8.5 0 0 1 12 3a8.38 8.38 0 0 1 8.5 8.5z"/></svg>
          WhatsApp
        </a>
      </div>
      <div class="trust-row" style="margin-top:2rem">
        <span class="trust-item"><strong>{style.priceTrust ?? '€35'}</strong>{style.priceUnit ?? ' / Visual'}</span>
        <span class="trust-item"><strong>~24 Std.</strong> Lieferung</span>
        <span class="trust-item"><strong>100%</strong> von Hand geprüft</span>
      </div>
    </div>
  </section>

  <!-- Media band — mask reveal on the signature photo -->
  <section class="section-tight">
    <div class="container">
      <div class="reveal-mask" style="aspect-ratio:21/10;border-radius:var(--r-media);overflow:hidden">
        <div class="rm-inner" style={`background-image:url('${style.heroPhoto}')`}></div>
      </div>
    </div>
  </section>

  <!-- Mood — photo + one line, not a wall of text -->
  <section class="section-tight">
    <div class="container">
      <div class="photo-split reveal pending">
        <div class="photo-split-media">
          <img src={style.grid[0].photo} alt={`${style.name}-Stilbeispiel`} loading="lazy" />
        </div>
        <div>
          <h2>Wie sich {style.name} <em>anfühlt</em>.</h2>
          <p class="lead" style="margin-top:1rem">{style.moodParagraphs[0]}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Before/after — real proof for this specific style. -->
  <section class="section-tight">
    <div class="container">
      <div class="section-head" style="text-align:center;margin-inline:auto">
        <h2>Flach vs. {style.name}.</h2>
        <p style="margin-inline:auto">Was die Bearbeitung tatsächlich verändert.</p>
      </div>
      <div style="max-width:520px;margin:2rem auto 0">
        <Compare
          grade
          before={style.heroPhoto}
          after={style.heroPhoto}
          beforeAlt={`Eine flache, ungegradete ${style.name}-Szene`}
          afterAlt={`Dieselbe Szene finalisiert im ${style.name} Lifestyle-Look`}
          beforeLabel="Flach"
          afterLabel={style.name}
        />
      </div>
    </div>
  </section>

  <!-- Steps -->
  <section class="section-tight">
    <div class="container">
      <h2 style="margin-bottom:2rem">Wie {style.name} entsteht.</h2>
      <div class="steps">
        {style.steps.map((s, i) => (
          <div class="reveal pending">
            <span class="step-n">Nr. {i + 1}</span><h3>{s.title}</h3><p>{s.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Photo grid — the range, in frames -->
  <section class="section-tight">
    <div class="container">
      <div class="grid grid-3">
        {style.grid.map((g) => (
          <div class="reveal pending">
            {g.photo ? (
              <div class="vis" style={`background-image:url('${g.photo}')`}>
                <div class="vis-floor"></div>
                <span class="vis-badge">{style.name}</span>
              </div>
            ) : (
              <ProductScene icon={g.icon} width={g.width} badge={style.name} />
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Best for / what you get -->
  <section>
    <div class="container two-col" style="align-items:start">
      <div class="reveal pending">
        <h2 style="font-size:1.7rem">Ideal <em>für</em></h2>
        <ul class="checklist" style="margin-top:1.2rem">
          {style.bestFor.map((item) => (
            <li><svg viewBox="0 0 24 24" class="i" style="stroke:var(--success)"><path d="M20 6L9 17l-5-5"/></svg><span>{item}</span></li>
          ))}
        </ul>
      </div>
      <div class="reveal pending">
        <h2 style="font-size:1.7rem">Was du <em>bekommst</em></h2>
        <ul class="checklist" style="margin-top:1.2rem">
          {style.whatYouGet.map((item) => (
            <li><svg viewBox="0 0 24 24" class="i" style="stroke:var(--success)"><path d="M20 6L9 17l-5-5"/></svg><span>{item}</span></li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Closing CTA -->
  <section class="section-tight">
    <div class="container">
      <div class="cta-band reveal pending">
        <h2 class="display" style="font-size:clamp(2rem,4.5vw,3.2rem)">Mach {style.name} zu <em>deinem.</em></h2>
        <div class="flex" style="justify-content:center;margin-top:1.8rem">
          <span class="magnet-wrap"><span class="magnet-inner"><a href={style.orderHref ?? '/de/order-lifestyle'} class="btn btn-primary btn-lg">{style.orderLabel ?? `${style.name} bestellen`}</a></span></span>
          <a href="/de/test-sample" class="btn btn-ghost btn-lg">Test-Visual</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* app.css's shared .step-n carries an italic mark from the v1 serif system
     — v2 has no italics anywhere, so it's overridden locally rather than
     touched globally. */
  .step-n { font-style: normal; }
</style>
