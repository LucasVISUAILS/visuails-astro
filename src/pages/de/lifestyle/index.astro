---
// VISUAILS — Lifestyle hub. Ported from the SvelteKit v2 site's
// /lifestyle +page.svelte. `styles` data ported verbatim from
// $lib/data/styles.js (only the fields this page uses: slug, name,
// cardPhoto, tagline).
import Layout from '../../../layouts/Layout.astro';
import Compare from '../../../components/Compare.astro';

const styles = [
  { slug: 'dunes', name: 'Dunes', cardPhoto: '/img/lifestyle-dunes-01.webp', tagline: 'Sonne, Sand und leise Eleganz.', price: '€35 / Visual' },
  { slug: 'flash', name: 'Flash', cardPhoto: '/img/lifestyle-flash-02.webp', tagline: 'Direkter Blitz. Ohne Entschuldigung.', price: '€35 / Visual' },
  { slug: 'glow', name: 'Glow', cardPhoto: '/img/lifestyle-glow-01.webp', tagline: 'Golden Hour, auf Abruf.', price: '€35 / Visual' },
  { slug: 'phone-made', name: 'Phone-made', cardPhoto: '/img/lifestyle-phone-made-11.webp', tagline: 'Sieht mühelos aus. Ist es nicht.', price: '€35 / Visual' },
  { slug: 'custom', name: 'Custom', cardPhoto: '/img/banners-13.webp', tagline: 'Deine eigene Welt.', price: 'Auf Anfrage' },
];

const marqueeItems = [
  { src: '/img/lifestyle-phone-made-06.webp', label: 'Phone-made' },
  { src: '/img/lifestyle-glow-03.webp', label: 'Glow' },
  { src: '/img/lifestyle-flash-05.webp', label: 'Flash' },
  { src: '/img/lifestyle-dunes-02.webp', label: 'Dunes' },
  { src: '/img/banners-02.webp', label: 'Campaign' },
];
---

<Layout
  title="Lifestyle Images — dein Produkt in Szenen, die verkaufen | VISUAILS"
  description="Echte, gestylte Lifestyle-Szenen mit natürlichem Licht — und optional konsistente Models. Hochauflösend, E-Commerce-fertig und von Hand geprüft, geliefert in ~24 Std. Ab €35 pro Visual."
>
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow-page">Lifestyle Images</span>
      <h1 class="display" style="font-size:clamp(2.4rem,5vw,4rem);margin-top:1rem">Dein Produkt, in Szenen, die verkaufen</h1>
      <p class="lead" style="margin-top:1.2rem">Vier Signature-Stile. Ab €35 pro Visual.</p>
      <div class="flex" style="margin-top:1.8rem">
        <span class="magnet-wrap"><span class="magnet-inner"><a href="/de/order-lifestyle" class="btn btn-primary btn-lg">Lifestyle-Visuals bestellen</a></span></span>
        <a href="/de/pricing" class="btn btn-ghost btn-lg">Preise ansehen</a>
        <a href="https://wa.me/31625436130?text=Hallo%20VISUAILS%2C%20ich%20m%C3%B6chte%20gerne%20Lifestyle-Visuals%20f%C3%BCr%20meine%20Produkte%20bestellen." class="btn btn-wa" target="_blank" rel="noopener">
          <svg class="i" viewBox="0 0 24 24"><path d="M21 11.5a8.38 8.38 0 0 1-8.5 8.5 8.5 8.5 0 0 1-4-1L3 20l1.5-4.5A8.38 8.38 0 0 1 3.5 11 8.5 8.5 0 0 1 12 3a8.38 8.38 0 0 1 8.5 8.5z"/></svg>WhatsApp <span class="rec-badge">Am schnellsten</span>
        </a>
      </div>
      <div class="trust-row" style="margin-top:2.4rem">
        <span class="trust-item"><strong>Ab €35</strong> pro Visual</span>
        <span class="trust-item"><strong>~24 Std.</strong> Lieferung</span>
        <span class="trust-item"><strong>100%</strong> von Hand geprüft</span>
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <h2 style="margin-bottom:2rem">Vier Stimmungen — oder <em>deine eigene.</em></h2>
      <div class="grid grid-2 reveal-group">
        {styles.map((s) => (
          <a href={`/de/lifestyle/${s.slug}`} class="reveal pending" style="display:block">
            <div class="photo-band tall">
              <img src={s.cardPhoto} alt={`${s.name} Lifestyle-Beispiel`} loading="lazy" />
              <div class="scrim"></div>
              <div class="caption">
                <h3 style="color:#fff;font-size:1.6rem"><em>{s.name}</em> &rarr;</h3>
                <p style="font-size:.92rem">{s.tagline} &middot; {s.price}</p>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <div class="photo-split reveal pending">
        <div class="photo-split-media">
          <img src="/img/model-02.webp" alt="Ein VISUAILS-Model, konsistent gestylt über eine ganze Kampagne" loading="lazy" />
        </div>
        <div>
          <h2>Füge ein konsistentes <em>Model</em> hinzu.</h2>
          <p class="lead" style="margin-top:1rem">Dasselbe Gesicht, über deine gesamte Kollektion — oder lass uns eines wählen, das passt.</p>
          <div class="flex" style="margin-top:1.4rem"><a href="/de/models" class="btn btn-primary">Models entdecken</a></div>
        </div>
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <div class="section-head" style="text-align:center;margin-inline:auto">
        <h2>Vier Stimmungen. Vier Transformationen.</h2>
        <p style="margin-inline:auto">Dieselbe Aufnahme, flach vs. finalisiert in jedem VISUAILS-Stil.</p>
      </div>
      <div class="compare-grid reveal-group" style="margin-top:2.2rem">
        {[
          { name: 'Dunes', photo: '/img/lifestyle-dunes-01.webp' },
          { name: 'Flash', photo: '/img/lifestyle-flash-01.webp' },
          { name: 'Glow', photo: '/img/lifestyle-glow-01.webp' },
          { name: 'Phone-made', photo: '/img/lifestyle-phone-made-01.webp' },
        ].map((c) => (
          <div class="reveal pending">
            <Compare grade before={c.photo} after={c.photo} beforeAlt={`Eine flache, ungegradete ${c.name}-Szene`} afterAlt={`Dieselbe Szene finalisiert im ${c.name} Lifestyle-Look`} beforeLabel="Flach" afterLabel={c.name} />
            <p class="cc-label"><strong>{c.name}</strong> &middot; €35 / Visual</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <div class="section-head" style="margin-bottom:1.8rem">
        <h2>Die Bandbreite, in Bewegung</h2>
        <p><a href="/de/gallery" class="link-arrow" style="font-size:1rem">Sieh dir die ganze Galerie an <svg viewBox="0 0 24 24" class="i"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a></p>
      </div>
    </div>
    <div class="marquee"><div class="marquee-track">
      {marqueeItems.map((m) => (
        <div class="marquee-item">
          <img src={m.src} alt={`${m.label} Lifestyle-Beispiel`} loading="lazy" style="width:100%;height:100%;object-fit:cover" />
        </div>
      ))}
    </div></div>
  </section>

  <section class="section-tight">
    <div class="container">
      <div class="cta-band reveal pending">
        <h2 class="display" style="font-size:clamp(2.2rem,5vw,3.6rem)">Setz dein Produkt<br>in eine Szene, die verkauft.</h2>
        <div class="flex" style="justify-content:center;margin-top:2rem">
          <span class="magnet-wrap"><span class="magnet-inner"><a href="/de/order-lifestyle" class="btn btn-primary btn-lg">Lifestyle-Visuals bestellen</a></span></span>
          <a href="/de/models" class="btn btn-ghost btn-lg">Models entdecken</a>
          <a href="https://wa.me/31625436130?text=Hallo%20VISUAILS%2C%20ich%20m%C3%B6chte%20gerne%20%C3%BCber%20Lifestyle-Visuals%20f%C3%BCr%20meine%20Marke%20sprechen." class="btn btn-wa" target="_blank" rel="noopener">
            <svg class="i" viewBox="0 0 24 24"><path d="M21 11.5a8.38 8.38 0 0 1-8.5 8.5 8.5 8.5 0 0 1-4-1L3 20l1.5-4.5A8.38 8.38 0 0 1 3.5 11 8.5 8.5 0 0 1 12 3a8.38 8.38 0 0 1 8.5 8.5z"/></svg>WhatsApp
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
