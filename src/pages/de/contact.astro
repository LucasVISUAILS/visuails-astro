---
// VISUAILS — Kontakt (Deutsch). Übersetzung von src/pages/contact.astro.
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="VISUAILS — Kontakt"
  description="Fragen zu einer Bestellung, Support oder eine Custom-Anfrage? Schreib VISUAILS auf WhatsApp oder per E-Mail an hello@visuails.com — wir antworten meist innerhalb einer Stunde."
>
  <!-- HERO -->
  <section class="page-hero">
    <div class="container">
      <div class="photo-split reverse">
        <div class="photo-split-media">
          <img src="/img/lifestyle-glow-03.webp" alt="Ein VISUAILS Lifestyle-Visual" loading="lazy" />
        </div>
        <div>
          <h1 class="display" style="font-size:clamp(2.4rem,5vw,4rem)">Lass uns <em>gemeinsam</em> wachsen.</h1>
          <p class="lead" style="margin-top:1rem">Eine Frage oder eine Custom-Anfrage? Schreib uns — ein echter Mensch liest jede Nachricht.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CONTACT -->
  <section class="section-tight">
    <div class="container two-col" style="align-items:start">

      <!-- Links: Kanäle -->
      <div class="reveal pending contact-stack">
        <h2>Der schnellste Weg zu uns</h2>

        <div class="card">
          <h3>WhatsApp</h3>
          <p style="margin-top:.5rem;color:var(--ink-3)">Antwort meist innerhalb einer Stunde.</p>
          <p style="margin-top:.6rem"><strong>+31 6 25436130</strong></p>
          <a href="https://wa.me/31625436130?text=Hi%20VISUAILS%2C%20ich%20habe%20eine%20Frage." class="btn btn-wa" style="margin-top:1rem" target="_blank" rel="noopener">
            <svg class="i" viewBox="0 0 24 24"><path d="M21 11.5a8.38 8.38 0 0 1-8.5 8.5 8.5 8.5 0 0 1-4-1L3 20l1.5-4.5A8.38 8.38 0 0 1 3.5 11 8.5 8.5 0 0 1 12 3a8.38 8.38 0 0 1 8.5 8.5z"/></svg>
            Per WhatsApp chatten <span class="rec-badge">Am schnellsten</span>
          </a>
        </div>

        <div class="card">
          <h3>E-Mail</h3>
          <p style="margin-top:.5rem;color:var(--ink-3)">Für ausführliche Briefings, Rechnungen oder Anhänge.</p>
          <p style="margin-top:.6rem">
            <a href="mailto:hello@visuails.com" class="link-arrow" style="font-size:1rem">hello@visuails.com <svg viewBox="0 0 24 24" class="i"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
          </p>
        </div>

        <div class="grid grid-2">
          <div class="card">
            <h3 style="font-size:.95rem">Öffnungszeiten</h3>
            <p style="margin-top:.5rem;font-size:.95rem;color:var(--ink-3)">Mo–Fr 08:00–20:00 MEZ<br>Sa–So 09:00–20:00 MEZ</p>
          </div>
          <div class="card">
            <h3 style="font-size:.95rem">Standort</h3>
            <p style="margin-top:.5rem;font-size:.95rem;color:var(--ink-3)">Enschede, Niederlande<br>KVK 99742993</p>
          </div>
        </div>
      </div>

      <!-- Rechts: Formular -->
      <div class="reveal pending">
        <div class="card">
          <h2 style="font-size:1.5rem">Nachricht senden</h2>
          <p style="margin-top:.5rem;color:var(--ink-3);font-size:.95rem">Wir antworten meist innerhalb einer Stunde, über deinen bevorzugten Kanal.</p>
          <p style="margin-top:.5rem;color:var(--ink-3);font-size:.82rem">Hinweis: Unser Kundenservice ist auf Englisch oder Niederländisch verfügbar.</p>

          <form action="/de/thank-you" method="get" style="margin-top:1.6rem">
            <div class="field">
              <label for="c-name">Name <span class="req">*</span></label>
              <input class="input" type="text" id="c-name" name="name" required autocomplete="name" placeholder="Dein Name" />
            </div>
            <div class="field">
              <label for="c-email">E-Mail <span class="req">*</span></label>
              <input class="input" type="email" id="c-email" name="email" required autocomplete="email" placeholder="du@unternehmen.de" />
            </div>
            <div class="field">
              <label for="c-topic">Thema</label>
              <select class="select" id="c-topic" name="topic">
                <option value="order-support">Support zur Bestellung</option>
                <option value="new-order">Neue Bestellung</option>
                <option value="custom-request">Custom-Anfrage</option>
                <option value="other">Sonstiges</option>
              </select>
            </div>
            <div class="field">
              <label for="c-message">Nachricht <span class="req">*</span></label>
              <textarea class="textarea" id="c-message" name="message" rows="5" required placeholder="Wie können wir helfen?"></textarea>
            </div>
            <div class="field">
              <span id="preferred-label">Bevorzugter Kanal</span>
              <div class="opt-stack" style="margin-top:.4rem" role="radiogroup" aria-labelledby="preferred-label">
                <label class="opt">
                  <input type="radio" name="preferred" value="email" checked />
                  <span class="opt-main"><span class="opt-title">E-Mail</span><span class="opt-desc">Wir antworten auf deinen hello@visuails.com-Thread</span></span>
                </label>
                <label class="opt">
                  <input type="radio" name="preferred" value="whatsapp" />
                  <span class="opt-main"><span class="opt-title">WhatsApp</span><span class="opt-desc">Am schnellsten — meist innerhalb einer Stunde</span></span>
                </label>
              </div>
            </div>
            <button type="submit" class="btn btn-primary btn-block btn-lg" style="margin-top:1.2rem">Nachricht senden</button>
            <p style="margin-top:.8rem;font-size:.8rem;color:var(--ink-3)">Schnelle Antworten gesucht? Sieh zuerst in die <a href="/de/faq" style="color:var(--accent-bright);text-decoration:underline">FAQ</a>.</p>
          </form>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section-tight">
    <div class="container">
      <div class="cta-band reveal pending">
        <h2 class="display" style="font-size:clamp(2rem,4.5vw,3.2rem)">Lieber <em>zuerst</em> sehen?</h2>
        <p class="lead" style="margin:1.2rem auto 0;text-align:center">Ein Foto rein, ein fertiges Visual raus. Sieh es zuerst auf deinem Produkt für €0,99.</p>
        <div class="flex" style="justify-content:center;margin-top:2rem">
          <a href="/de/test-sample" class="btn btn-primary btn-lg">Test-Visual</a>
          <a href="/de/pricing" class="btn btn-ghost btn-lg">Preise ansehen</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .contact-stack > * + * { margin-top: 1.2rem; }
  .field { display: flex; flex-direction: column; gap: .45rem; margin-bottom: 1.1rem; }
  .field label, .field span#preferred-label { font-size: .88rem; font-weight: 600; color: var(--ink); }
  .field .req { color: var(--accent-bright); }
  .input, .textarea, .select {
    width: 100%; padding: .85rem 1rem; background: var(--surface);
    border: 1px solid var(--line-strong); border-radius: var(--r-sm); color: var(--ink);
    font-family: var(--font-body); font-size: .98rem;
    transition: border-color .22s var(--ease), box-shadow .22s var(--ease);
  }
  .input::placeholder, .textarea::placeholder { color: var(--ink-3); }
  .input:focus, .textarea:focus, .select:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-soft); }
  .select option { background: var(--surface); color: var(--ink); }
  .textarea { min-height: 120px; resize: vertical; }
  .opt-stack { display: flex; flex-direction: column; gap: .6rem; }
  .opt { display: flex; align-items: center; gap: .8rem; padding: .9rem 1.1rem; border-radius: var(--r-sm); border: 1px solid var(--line-strong); background: var(--surface); cursor: pointer; transition: border-color .2s var(--ease), background .2s var(--ease); }
  .opt:has(input:checked) { border-color: var(--accent); background: var(--accent-soft); }
  .opt input { accent-color: var(--accent); width: 18px; height: 18px; }
  .opt .opt-main { flex: 1; display: flex; flex-direction: column; gap: .15rem; }
  .opt .opt-title { color: var(--ink); font-weight: 500; }
  .opt .opt-desc { font-size: .82rem; color: var(--ink-3); }
</style>
