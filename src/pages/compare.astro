---
// VISUAILS — /compare (English). The page body lives in ComparePage.astro so
// that /compare and /nl/compare cannot drift apart; only the meta differs here.
//
// AUDIT-TASK-0.md §F: "REWRITE, URL kept. Becomes 'Shoot day vs VISUAILS'."
// The AI-tools argument is not dropped from the site — it survives as the
// #ai-tools section inside ComparePage, which /custom-models links into, and
// the title still carries the "AI" search intent alongside the new one.
//
// The meta description is built from pricing.js: a price typed into a <meta>
// tag is the one place a stale figure survives a page rewrite. The old
// description was 207 characters — well past the ~160 Google renders.
import Layout from '../layouts/Layout.astro';
import ComparePage from '../components/ComparePage.astro';
import { AMOUNT, SHOOT_DAY, euro, FULL_DROP_MIN, FULL_DROP_MAX } from '../data/pricing.js';

const description =
  `A production day runs ${SHOOT_DAY.en.range}. A drop is ${euro(AMOUNT.fullDrop, 'en')} ` +
  `for ${FULL_DROP_MIN}–${FULL_DROP_MAX} products. The honest comparison, ` +
  `including where a shoot day still wins.`;
---

<Layout title="Shoot day vs VISUAILS — the honest comparison" description={description}>
  <ComparePage lang="en" />
</Layout>
