---
/**
 * CONCEPT C · ADEM — beeld, wit, beeld, wit. 6 september 2026.
 *
 * Wat het is: de pagina ademt. Elk beeld vult het hele scherm en blijft staan
 * terwijl het volgende witte vel eroverheen schuift — een gordijn — en op dat
 * witte vel staat maar één ding: één kop, één regel, één knop. Links een vaste
 * rail die meetelt (01 / 08) en de naam van de sectie draagt. Gemeten aan
 * floema.com (Awwwards Site of the Month, mei 2026, Bürocratik): een stapel
 * schermvullende foto’s met een vaste rail en een teller, elk beeld één
 * boodschap. Het "alien" zit hier in de schaal: het beeld is nooit een tegel,
 * het is de ruimte waar je in staat, en het wit ertussen is de stilte.
 *
 * Alle tekst en getallen: src/data/conceptInhoud.js.
 */
import ConceptLayout from '../../layouts/ConceptLayout.astro';
import { inhoud } from '../../data/conceptInhoud.js';
import { localizedPath } from '../../i18n/ui.js';

const lang = 'nl' as const;
const lp = (p: string) => localizedPath(lang, p);
const { c, sample, e, KINDS, KIND_PAGE, RUNGS, PLANS, PLAN_CLIPS, ladderRate, CATALOG_IMAGES, ROSTER, modelId, SFEER } = inhoud(lang);
const nn = (i: number) => String(i).padStart(2, '0');
const S = (n: number) => SFEER[n - 1];

/* De rail telt de beeldpanelen: acht, in deze volgorde. */
const RAIL = [c.heroChip, c.secties[0], c.secties[1], c.secties[2], c.secties[3], c.secties[4], c.secties[5], c.secties[7]];
---
<ConceptLayout title="Concept C · Adem — VISUAILS" description="Concept C voor de nieuwe voorpagina van VISUAILS: beeld, wit, beeld, wit — schermvullende foto’s als gordijn, met een rail die meetelt." lang={lang} grond="wit">
  <a class="visueel-verborgen" href="#inhoud">Naar de inhoud</a>

  {/* De rail: vast, links, telt mee. Het merkteken erboven, de sectie eronder. */}
  <aside class="rail" aria-hidden="true">
    <svg class="merkteken" viewBox="0 0 702 813.25"><use href="#markglyph" /></svg>
    <span class="rail-lijn"></span>
    <span class="rail-tel mono"><b data-tel>01</b> / {nn(RAIL.length)}</span>
    <span class="rail-naam mono" data-naam>{RAIL[0]}</span>
  </aside>
  <nav class="top mono" aria-label="Hoofdnavigatie">
    {c.nav.map(([t, h]) => <a href={h}>{t}</a>)}
    <a class="knop top-knop" href={lp('/start')}>{c.ctaStart}</a>
  </nav>

  <main id="inhoud">
    {/* 01 · HERO */}
    <section class="beeld" data-rail="1" aria-labelledby="h1">
      <img src={S(1).src} width={S(1).w} height={S(1).h} alt={S(1).alt} fetchpriority="high" decoding="async">
      <div class="beeld-tekst">
        <h1 id="h1" class="kop kop-smal h1">{c.h1.map((line) => <span class="regel" set:html={line} />)}</h1>
      </div>
    </section>
    <section class="vel" aria-label={c.lede}>
      <p class="kop kop-smal h2 lopend-breed">{c.lede}</p>
      <ul class="feiten mono">{c.facts.map((f, i) => <li><b>{nn(i + 1)}</b>{f}</li>)}</ul>
      <p class="acties"><a class="knop" href={lp('/test-sample')}>{sample.cta}</a><a class="knop" href={lp('/start')}>{c.ctaStart}</a></p>
    </section>

    {/* 02 · WAT WE MAKEN — de vier diensten als regels óp het beeld */}
    <section id="maken" class="beeld" data-rail="2" aria-labelledby="h-maken">
      <img src={S(2).src} width={S(2).w} height={S(2).h} alt={S(2).alt} loading="lazy" decoding="async">
      <div class="beeld-tekst beeld-tekst-boven">
        <h2 id="h-maken" class="kop kop-smal h2">{c.svcH}</h2>
      </div>
      <ul class="diensten">
        {c.svc.map(([naam, wat, prijs, href], i) => (
          <li><a href={lp(href)}><span class="mono"><b>{nn(i + 1)}</b></span><span class="kop h3">{naam}</span><span class="wat">{wat}</span><span class="mono">{prijs}</span></a></li>
        ))}
      </ul>
    </section>
    <section class="vel vel-klein">
      <p class="mono"><span>{c.svcSoon[0]}</span> <a class="pijl" href={lp('/plans#binnenkort')}>{c.svcSoon[1]}</a></p>
    </section>

    {/* 03 · TELEFOONFOTO → STUDIOPRODUCTIE */}
    <section class="beeld" data-rail="3" aria-labelledby="h-vn">
      <img src={S(7).src} width={S(7).w} height={S(7).h} alt={S(7).alt} loading="lazy" decoding="async">
      <div class="beeld-tekst">
        <h2 id="h-vn" class="kop kop-smal h2">{c.vnH}</h2>
        <p class="lede lopend">{c.vnLede}</p>
      </div>
      <figure class="inzet">
        <img src="/img/catalog-before.webp" width="1350" height="1800" alt={c.vnIn[1]} loading="lazy" decoding="async">
        <figcaption class="mono">{c.vnIn[0]} · {c.vnIn[1]}</figcaption>
      </figure>
      <ol class="noten mono">{c.vnNoten.map((k, i) => <li><b>{nn(i + 1)}</b>{k}</li>)}</ol>
    </section>
    <section class="vel vel-klein">
      <p><a class="pijl" href={lp('/gallery')}>{c.vnLink}</a></p>
    </section>

    {/* 04 · DE SET — zeven beelden als meetlat onder het beeld */}
    <section class="beeld" data-rail="4" aria-labelledby="h-set">
      <img src={S(4).src} width={S(4).w} height={S(4).h} alt={S(4).alt} loading="lazy" decoding="async">
      <div class="beeld-tekst beeld-tekst-boven">
        <h2 id="h-set" class="kop kop-smal h2">{c.setH}</h2>
        <p class="lede lopend">{c.setLede}</p>
      </div>
      <div class="meet-blok">
        <p class="groepen mono"><a href={lp(c.setGroups[0][1])}>{c.setGroups[0][0]}</a><a href={lp(c.setGroups[1][1])}>{c.setGroups[1][0]}</a></p>
        <ol class="meetlat mono" aria-label={c.setH}>
          {c.frames.map((naam, i) => <li class={i < CATALOG_IMAGES ? 'is-catalog' : 'is-lifestyle'}><b>{nn(i + 1)}</b>{naam}</li>)}
        </ol>
      </div>
    </section>
    <section class="vel">
      <ul class="extras">{c.extras.map(([k, v, href]) => <li><a href={lp(href)}><span class="mono">+ {k}</span><span>{v}</span></a></li>)}</ul>
    </section>

    {/* 05 · VAN MAP TOT LANCERING */}
    <section class="beeld" data-rail="5" aria-labelledby="h-st">
      <img src={S(8).src} width={S(8).w} height={S(8).h} alt={S(8).alt} loading="lazy" decoding="async">
      <div class="beeld-tekst beeld-tekst-boven">
        <h2 id="h-st" class="kop kop-smal h2">{c.stepsH}</h2>
        <p class="lede lopend">{c.stepsLede}</p>
      </div>
      <ol class="stappen">
        {c.steps.map(([k, v], i) => <li><span class="mono"><b>{nn(i + 1)}</b></span><h3 class="kop h3">{k}</h3><p>{v}</p></li>)}
      </ol>
    </section>

    {/* 06 · TARIEVEN — op wit, het enige lange vel */}
    <section id="tarieven" class="beeld beeld-wit" data-rail="6" aria-labelledby="h-pr">
      <div class="prijs">
        <h2 id="h-pr" class="kop kop-smal h2">{c.priceH}</h2>
        <table class="tabel">
          <thead><tr><th scope="col" class="mono">{c.priceCount}</th>{KINDS.map((id, i) => <th scope="col" class="mono">{KIND_PAGE[id] ? <a href={lp(KIND_PAGE[id])}>{c.priceKinds[i]}</a> : c.priceKinds[i]}</th>)}</tr></thead>
          <tbody>{RUNGS.map((r) => <tr><th scope="row" class="mono">{r.label}</th>{KINDS.map((id) => <td class="bedrag kop">{e(ladderRate(id, r.at))}</td>)}</tr>)}</tbody>
        </table>
        <p class="mono stil">{c.priceVat}</p>
        <p class="acties"><a class="knop knop-geel" href={lp('/start')}>{c.priceCta}</a><a class="pijl" href={lp('/pricing')}>{c.priceCta2}</a></p>
        <h3 class="kop kop-smal h2 abo-kop">{c.planH}</h3>
        <p class="lede lopend">{c.planLede}</p>
        <table class="tabel tabel-abo">
          <thead><tr>{c.planCols.map((k) => <th scope="col" class="mono">{k}</th>)}</tr></thead>
          <tbody>{PLANS.map((pl) => <tr><th scope="row"><a href={`${lp('/plans')}#${pl.id}`} class="kop h3">{pl.name}</a><span class="abo-regel">{pl.line}</span></th><td class="bedrag kop">{pl.products}</td><td class="bedrag kop">{PLAN_CLIPS[pl.id] || '—'}</td><td class="bedrag kop">{pl.price}</td></tr>)}</tbody>
        </table>
        <p class="mono stil">{c.planVat}</p>
        <p class="acties"><a class="knop knop-geel" href={lp('/start/plan')}>{c.planCta}</a><a class="pijl" href={lp('/plans')}>{c.planLink}</a></p>
      </div>
    </section>

    {/* 07 · STUDIO */}
    <section id="studio" class="beeld" data-rail="7" aria-labelledby="h-sd">
      <img src={S(3).src} width={S(3).w} height={S(3).h} alt={S(3).alt} loading="lazy" decoding="async">
      <div class="beeld-tekst">
        <h2 id="h-sd" class="kop kop-smal h2">{c.studioH}</h2>
        <p class="lede lopend">{c.studioLede}</p>
      </div>
    </section>
    <section class="vel">
      <ul class="beloften">{c.beloften.map(([k, v]) => <li><strong class="kop h3">{k}</strong><span>{v}</span></li>)}</ul>
      <p class="acties"><a class="pijl" href={lp('/portal')}>{c.studioLink}</a><a class="pijl" href={lp('/studio')}>{c.studioLink2}</a></p>
      <div class="gezichten" id="gezichten">
        <h2 class="kop kop-smal h2">{c.facesH}</h2>
        <p class="lede lopend">{c.facesLede}</p>
        <ul class="rooster">{ROSTER.map((m) => <li><a href={`${lp('/models')}#${modelId(m.name)}`}><img src={m.thumb} width={m.tw} height={m.th} alt={m.name} loading="lazy" decoding="async"><span class="mono">{m.name}</span></a></li>)}</ul>
        <p class="acties"><a class="pijl" href={lp('/custom-models')}>{c.facesLink}</a><a class="pijl" href={lp('/models')}>{c.facesLink2}</a></p>
      </div>
      <div class="vragen-blok">
        <h2 class="kop kop-smal h2">{c.qH}</h2>
        <ul class="vragen">
          {c.qs.map(([q, l, href]) => <li><span>{q}</span><a class="pijl" href={lp(href)}>{l}</a></li>)}
          <li><span></span><a class="pijl" href={lp('/faq')}>{c.qAll}</a></li>
        </ul>
      </div>
    </section>

    {/* 08 · DE PROEF */}
    <section class="beeld beeld-slot" data-rail="8" aria-labelledby="h-sl">
      <img src={S(9).src} width={S(9).w} height={S(9).h} alt={S(9).alt} loading="lazy" decoding="async">
      <div class="beeld-tekst">
        <h2 id="h-sl" class="kop kop-smal h1">{c.closeH}</h2>
        <p class="lede lopend">{c.closeLede}</p>
        <p class="acties"><a class="knop knop-geel" href={lp('/test-sample')}>{sample.cta}</a><a class="knop" href={lp('/start')}>{c.closeAlt}</a></p>
      </div>
      <footer class="voet">
        <ul class="trust mono">{c.trust.map((t) => <li>{t}</li>)}</ul>
        <span class="mono">{c.posterLine[0]} · {c.posterLine[1]}</span>
      </footer>
    </section>
  </main>

  <script>
    /* De rail telt mee: het beeldpaneel dat het midden van het scherm kruist
       bepaalt het nummer en de naam. */
    const NAMEN = JSON.parse(document.getElementById('rail-namen')!.textContent!);
    const tel = document.querySelector<HTMLElement>('[data-tel]')!;
    const naam = document.querySelector<HTMLElement>('[data-naam]')!;
    const io = new IntersectionObserver((entries) => {
      for (const en of entries) if (en.isIntersecting) {
        const n = Number((en.target as HTMLElement).dataset.rail);
        tel.textContent = String(n).padStart(2, '0');
        naam.textContent = NAMEN[n - 1];
      }
    }, { rootMargin: '-50% 0px -50% 0px', threshold: 0 });
    document.querySelectorAll('[data-rail]').forEach((p) => io.observe(p));
  </script>
  <script id="rail-namen" type="application/json" set:html={JSON.stringify(RAIL)} />
</ConceptLayout>

<style>
  .h1 { font-size: clamp(2.8rem, 7vw, 6rem); }
  .h2 { font-size: clamp(2rem, 4.4vw, 3.8rem); }
  .h3 { font-size: 1.15rem; letter-spacing: -.01em; line-height: 1.2; }
  .regel { display: block; }
  .lede { font-size: clamp(1rem, 1.25vw, 1.2rem); }
  .lopend-breed { max-width: 22ch; }
  .acties { display: flex; flex-wrap: wrap; align-items: center; gap: 1.25rem 2rem; }
  .mono b { font-weight: 500; margin-right: .6em; }
  .stil { color: var(--inkt-3); }

  /* ── De rail en de top ─────────────────────────────────────────────────── */
  .rail { position: fixed; left: var(--x); top: 1.5rem; bottom: 1.5rem; z-index: 5; display: grid; grid-template-rows: auto 1fr auto auto; gap: 1rem; justify-items: start; width: 2rem; mix-blend-mode: difference; color: var(--wit); }
  .rail-lijn { width: 1px; justify-self: center; background: currentColor; opacity: .5; }
  .rail-tel, .rail-naam { writing-mode: vertical-rl; transform: rotate(180deg); white-space: nowrap; }
  .rail-tel b { margin: 0 0 .5em; }
  .top { position: fixed; top: 1.5rem; right: var(--x); z-index: 5; display: flex; align-items: center; gap: 1.75rem; mix-blend-mode: difference; color: var(--wit); }
  .top .knop { border-color: currentColor; }
  @media (max-width: 720px) { .rail { display: none; } .top a:not(.knop) { display: none; } }

  /* ── Het gordijn: een beeld blijft staan, het vel schuift eroverheen ────── */
  .beeld { position: sticky; top: 0; min-height: 100svh; display: grid; align-content: end; padding: clamp(5rem, 10vw, 8rem) var(--x) clamp(3rem, 6vw, 5rem) calc(var(--x) + 4rem); color: var(--vel); overflow: hidden; background: var(--inkt); }
  .beeld > img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .beeld::after { content: ""; position: absolute; inset: 0; background: linear-gradient(to top, rgb(17 17 17 / .72), rgb(17 17 17 / .25) 45%, rgb(17 17 17 / 0) 70%); pointer-events: none; }
  @media (max-width: 720px) { .beeld::after { background: linear-gradient(to top, rgb(17 17 17 / .82), rgb(17 17 17 / .45) 50%, rgb(17 17 17 / .1)); } }
  .beeld > *:not(img) { position: relative; z-index: 1; }
  .beeld-tekst { display: grid; gap: 1.5rem; max-width: 60rem; }
  .beeld-tekst-boven { align-self: start; }
  .beeld-tekst .lede { color: var(--vel); opacity: .9; }
  .vel { position: relative; z-index: 2; background: var(--wit); min-height: 70svh; display: grid; align-content: center; gap: clamp(2rem, 4vw, 3.5rem); padding: clamp(6rem, 12vw, 12rem) var(--x) clamp(6rem, 12vw, 12rem) calc(var(--x) + 4rem); }
  .vel-klein { min-height: 0; padding-block: clamp(3rem, 6vw, 5rem); }
  @media (max-width: 720px) { .beeld, .vel { padding-left: var(--x); } }
  @media (prefers-reduced-motion: reduce) { .beeld { position: relative; } }

  .feiten { display: grid; gap: .6rem; color: var(--inkt-3); }
  .feiten b { color: var(--inkt); }

  /* 02 · de diensten als regels op het beeld: kop boven, regels onder */
  .beeld:has(.beeld-tekst-boven) { align-content: space-between; }
  .diensten { display: grid; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); gap: 2rem clamp(1.5rem, 3vw, 3rem); align-self: end; border-top: 1px solid rgb(245 245 245 / .45); padding-top: 1.5rem; }
  .diensten a { display: grid; gap: .5rem; }
  .diensten .wat { opacity: .85; max-width: 24em; }
  .diensten a:hover .h3 { color: var(--geel-letter); }

  /* 03 · de inzet: de telefoonfoto klein in de hoek van het grote beeld */
  .beeld > .inzet { position: absolute; right: var(--x); top: clamp(5rem, 10vw, 8rem); width: clamp(7rem, 16vw, 14rem); display: grid; gap: .6rem; z-index: 1; }
  .inzet img { width: 100%; height: auto; outline: 1px solid rgb(245 245 245 / .6); outline-offset: 4px; }
  .inzet figcaption { opacity: .8; }
  .noten { display: grid; grid-template-columns: repeat(4, max-content); gap: 2.5rem; padding-top: 1.25rem; border-top: 1px solid rgb(245 245 245 / .45); opacity: .9; }
  @media (max-width: 720px) { .beeld > .inzet { position: static; width: 8rem; } .noten { grid-template-columns: 1fr 1fr; gap: .75rem; } }

  /* 04 · de meetlat */
  .meetlat { display: grid; grid-template-columns: repeat(7, 1fr); align-self: end; border-top: 1px solid var(--vel); }
  .meetlat li { padding: .9rem 0 0 .6rem; border-left: 1px solid var(--vel); opacity: .9; }
  .meetlat li::before { content: ""; display: block; width: 1px; height: 1.4rem; margin: -1.4rem 0 .6rem -.6rem; background: var(--vel); }
  .meet-blok { display: grid; gap: 1.5rem; align-self: end; }
  .groepen { display: flex; justify-content: space-between; gap: 2rem; opacity: .8; }
  @media (max-width: 720px) { .meetlat { grid-template-columns: repeat(4, 1fr); } .meetlat li::before { display: none; } }

  /* 05 · de stappen op het beeld */
  .stappen { display: grid; grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr)); gap: 2rem clamp(1.5rem, 3vw, 3rem); align-self: end; border-top: 1px solid rgb(245 245 245 / .45); padding-top: 1.5rem; }
  .stappen li { display: grid; gap: .6rem; align-content: start; }
  .stappen p { opacity: .85; max-width: 24em; }

  /* 06 · tarieven, op wit — een beeldpaneel zonder beeld, zodat de rail meetelt */
  .beeld-wit { background: var(--wit); color: var(--inkt); align-content: start; }
  .beeld-wit::after { display: none; }
  .prijs { display: grid; gap: clamp(2rem, 4vw, 3.5rem); max-width: 70rem; }
  .abo-kop { margin-top: clamp(3rem, 6vw, 6rem); }
  .tabel th, .tabel td { text-align: left; padding: 1.3rem 1rem 1.3rem 0; border-bottom: 1px solid var(--lijn); vertical-align: baseline; }
  .tabel thead th { color: var(--inkt-3); border-bottom-color: var(--inkt); padding-top: 0; }
  .tabel tbody th { color: var(--inkt-3); font-weight: 400; width: 14%; }
  .bedrag { font-size: clamp(1.4rem, 2.6vw, 2.2rem); font-variant-numeric: tabular-nums; }
  .tabel-abo tbody th { color: var(--inkt); width: 34%; }
  .abo-regel { display: block; color: var(--inkt-3); font-size: .9rem; margin-top: .25rem; }
  @media (max-width: 600px) { .tabel th, .tabel td { padding: 1rem .5rem 1rem 0; } .bedrag { font-size: 1.25rem; } .abo-regel { display: none; } }

  /* 07 · het witte vel na Studio: beloften, gezichten, vragen */
  .beloften { display: grid; gap: 1rem; padding-top: 1.25rem; border-top: 1px solid var(--inkt); max-width: 60rem; }
  .beloften li { display: grid; gap: .25rem; color: var(--inkt-2); }
  .gezichten, .vragen-blok { display: grid; gap: 2rem; margin-top: clamp(4rem, 8vw, 8rem); }
  .rooster { display: grid; grid-template-columns: repeat(auto-fill, minmax(6.5rem, 1fr)); gap: 1.5rem 1rem; }
  .rooster a { display: grid; gap: .6rem; color: var(--inkt-3); }
  .rooster img { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; filter: grayscale(1); transition: filter .4s var(--uit); }
  .rooster a:hover img { filter: none; }
  .vragen li { display: grid; grid-template-columns: 1fr auto; gap: 1rem; padding: 1.25rem 0; border-top: 1px solid var(--lijn); }
  .vragen li:last-child { border-bottom: 1px solid var(--lijn); }
  .extras { display: grid; grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr)); gap: 0 3rem; border-top: 1px solid var(--inkt); }
  .extras a { display: grid; gap: .3rem; padding: 1.25rem 0; border-bottom: 1px solid var(--lijn); color: var(--inkt-2); }
  @media (max-width: 600px) { .vragen li { grid-template-columns: 1fr; } }

  /* 08 · het slot met de voet erin */
  .beeld-slot { gap: clamp(3rem, 8vw, 8rem); }
  .voet { display: grid; gap: 1rem; opacity: .85; }
  .trust { display: flex; flex-wrap: wrap; gap: .5rem 2.5rem; }
</style>
