---
/**
 * VOORSTEL C · CONSOLE — de voorpagina als bedieningspaneel. 13 september 2026.
 *
 * ── WAT DIT VOORSTEL DOET ─────────────────────────────────────────────────
 * De pagina krijgt een vaste aflezing links: een smalle kolom die van boven tot
 * onder in beeld blijft en zegt waar je bent, hoeveel modules er zijn en wat
 * elke module doet. De inhoud schuift erlangs. Elke sectie is een MODULE met
 * een nummer, een naam en een statusregel — en die drie staan overal op precies
 * dezelfde plek.
 *
 * Het limoen doet hier maar één ding: het markeert de stand van zaken. Geen
 * gele vlakken, geen gele koppen; alleen de module waar je in staat en de
 * dingen die "aan" zijn. Dat is de strengste toepassing van de kleur van de
 * drie voorstellen, en meteen de reden dat hij opvalt als hij wél verschijnt.
 *
 * ── WAAROM DIT HET MEEST 'FUTURISTISCH' IS ────────────────────────────────
 * Niet door gloed of gradiënten — die hebben we niet nodig en ze verouderen
 * het snelst. Het futuristische zit in de HOUDING: de site gedraagt zich als
 * een apparaat met een uitleesvenster in plaats van als een brochure. Dat is
 * ook precies wat PRODUCT.md vraagt: *"a visitor should feel they are looking
 * at an instrument, not a service page."*
 *
 * ── HET RISICO, EERLIJK ───────────────────────────────────────────────────
 * Dit is het meest uitgesproken voorstel en dus het meest verdelend. Een
 * bezoeker die haast heeft, ziet een interface waar hij een winkel verwacht.
 * Onder 64rem valt de kolom weg en wordt het een gewone pagina; dat is geen
 * nood-oplossing maar een keuze, want een aflezing van 12 rem op een telefoon
 * is een aflezing die de helft van het scherm opeet.
 */
import ConceptLayout from '../../layouts/ConceptLayout.astro';
import { inhoud } from '../../data/conceptInhoud.js';
import { localizedPath } from '../../i18n/ui.js';
import '../../styles/stelsel.css';

const lang = 'nl' as const;
const lp = (p: string) => localizedPath(lang, p);
const { c, sample, RUNGS, SFEER, ladderRate } = inhoud(lang);

/* De modules, één bron. De aflezing links en de koppen in de inhoud lezen
   allebei uit deze lijst — twee lijsten die hetzelfde moeten zeggen, is hoe je
   een navigatie krijgt die niet meer klopt met de pagina. */
const MODULES = [
  ['01', c.secties[0], 'maken'],
  ['02', c.secties[1], 'studio'],
  ['03', c.secties[3], 'proces'],
  ['04', c.secties[4], 'tarieven'],
  ['05', c.secties[7], 'proef'],
] as const;

const INGESTUURD = [
  ['/img/ba2-voor-front.webp', 'Telefoonfoto: een roze jeans plat op een betonnen magazijnvloer, voorkant'],
  ['/img/ba2-voor-achter.webp', 'Telefoonfoto: dezelfde jeans omgedraaid, achterkant'],
  ['/img/ba2-voor-detail.webp', 'Telefoonfoto: een hand houdt de tailleband met de knoop omhoog'],
  ['/img/ba2-voor-textuur.webp', 'Telefoonfoto: het weefsel van dichtbij'],
  ['/img/ba2-voor-pasvorm.webp', 'Spiegelselfie waarop de jeans gedragen wordt'],
];
const GELEVERD = [
  ['/img/ba2-na-front.webp', 'Afgewerkt catalogbeeld: de jeans recht van voren op wit'],
  ['/img/ba2-na-achter.webp', 'Afgewerkt catalogbeeld: de achterkant op wit'],
  ['/img/ba2-na-detail.webp', 'Afgewerkt detailbeeld: de knoop en de tailleband'],
  ['/img/ba2-na-model.webp', 'Afgewerkt beeld: de jeans gedragen door een model'],
];
---
<ConceptLayout
  title="Voorstel C · Console — VISUAILS"
  description="Voorstel C voor de nieuwe voorpagina: een vaste aflezing links, de inhoud als genummerde modules ernaast."
  lang={lang}
  grond="wit"
>
  <a class="visueel-verborgen" href="#inhoud">Naar de inhoud</a>

  <div class="console">
    <!-- ═══ DE AFLEZING ═══════════════════════════════════════════════════ -->
    <aside class="rail" aria-label="Inhoud van deze pagina">
      <a class="rail-merk" href={lp('/')} aria-label="VISUAILS">
        <svg class="merkteken" aria-hidden="true"><use href="#markglyph" /></svg>
      </a>
      <p class="rail-kop etiket">{c.labels[0]}</p>
      <ol class="rail-lijst">
        {MODULES.map(([nr, naam, id]) => (
          <li><a class="rail-item" href={`#${id}`}><span class="rail-nr">{nr}</span><span class="rail-naam">{naam}</span></a></li>
        ))}
      </ol>
      <p class="rail-stand etiket">
        <span class="stip" aria-hidden="true"></span>
        <span>Capaciteit open</span>
      </p>
      <a class="knop knop-geel rail-knop" href={lp('/start')}>{c.ctaStart}</a>
    </aside>

    <main class="inhoud" id="inhoud">
      <!-- ═══ 00 · DE UITSPRAAK ═════════════════════════════════════════ -->
      <section class="mod mod-hero">
        <p class="mod-regel etiket"><span class="etiket-nr">00</span><span>Start</span><span class="mod-rest">{c.labels[2]}</span></p>
        <h1 class="kop hero-h" set:html={c.h1.join(' ')} />
        <p class="hero-lede">{c.lede}</p>
        <ul class="meters">
          {c.facts.map((f, i) => (
            <li class="meter">
              <span class="meter-nr">{String(i + 1).padStart(2, '0')}</span>
              <span class="meter-t">{f}</span>
            </li>
          ))}
        </ul>
        <div class="beeld-vak hero-beeld">
          <img class="beeld" src={SFEER[0].src} width={SFEER[0].w} height={SFEER[0].h} alt={SFEER[0].alt} fetchpriority="high" decoding="async" />
        </div>
      </section>

      <!-- ═══ 01 · WAT WE MAKEN ═════════════════════════════════════════ -->
      <section class="mod" id="maken">
        <p class="mod-regel etiket"><span class="etiket-nr">{MODULES[0][0]}</span><span>{MODULES[0][1]}</span><span class="mod-rest">{c.svc.length} diensten</span></p>
        <h2 class="kop mod-h">{c.svcH}</h2>
        <ul class="diensten">
          {c.svc.map(([naam, wat, prijs, pad], i) => (
            <li>
              <a class="dienst" href={lp(pad)}>
                <span class="dienst-nr">{String(i + 1).padStart(2, '0')}</span>
                <span class="dienst-woord">
                  <span class="kop dienst-h">{naam}</span>
                  <span class="dienst-wat">{wat}</span>
                </span>
                <span class="getal dienst-prijs">{prijs}</span>
                <span class="pijl" aria-hidden="true"></span>
              </a>
            </li>
          ))}
        </ul>
      </section>

      <!-- ═══ 02 · ERIN, ERUIT ══════════════════════════════════════════
           Als module leest deze sectie niet meer als een vreemde eend: hij
           heeft dezelfde regel bovenaan als elke andere, en de twee rijen
           zijn twee AFLEZINGEN — 5 in, 4 uit — in plaats van een collage. -->
      <section class="mod" id="studio">
        <p class="mod-regel etiket"><span class="etiket-nr">{MODULES[1][0]}</span><span>{MODULES[1][1]}</span><span class="mod-rest">5 in · 4 uit</span></p>
        <h2 class="kop mod-h">{c.vnH}</h2>
        <div class="vn">
          <div class="vn-kant">
            <p class="vn-etiket etiket"><span class="stip stip-uit" aria-hidden="true"></span><span>{c.vnIn[0]}</span><span class="mod-rest">telefoon</span></p>
            <ul class="strook strook-in">
              {INGESTUURD.map(([src, alt]) => (
                <li class="beeld-vak"><img class="beeld" src={src} width="760" height="1013" alt={alt} loading="lazy" decoding="async" /></li>
              ))}
            </ul>
          </div>
          <div class="vn-kant">
            <p class="vn-etiket etiket"><span class="stip" aria-hidden="true"></span><span>{c.vnOut[0]}</span><span class="mod-rest">2048 &times; 2048</span></p>
            <ul class="strook strook-uit">
              {GELEVERD.map(([src, alt]) => (
                <li class="beeld-vak"><img class="beeld" src={src} width="760" height="760" alt={alt} loading="lazy" decoding="async" /></li>
              ))}
            </ul>
          </div>
        </div>
      </section>

      <!-- ═══ 03 · HET PROCES ═══════════════════════════════════════════ -->
      <section class="mod" id="proces">
        <p class="mod-regel etiket"><span class="etiket-nr">{MODULES[2][0]}</span><span>{MODULES[2][1]}</span><span class="mod-rest">{c.steps.length} stappen</span></p>
        <h2 class="kop mod-h">{c.stepsH}</h2>
        <ol class="stappen">
          {c.steps.map(([kop, zin], i) => (
            <li class="stap">
              <span class="stap-spoor" aria-hidden="true"><span class="stip"></span></span>
              <span class="stap-woord">
                <span class="mono stap-nr">{String(i + 1).padStart(2, '0')}</span>
                <span class="kop stap-h">{kop}</span>
                <span class="stap-p">{zin}</span>
              </span>
            </li>
          ))}
        </ol>
      </section>

      <!-- ═══ 04 · TARIEVEN ═════════════════════════════════════════════ -->
      <section class="mod" id="tarieven">
        <p class="mod-regel etiket"><span class="etiket-nr">{MODULES[3][0]}</span><span>{MODULES[3][1]}</span><span class="mod-rest">{c.priceVat}</span></p>
        <h2 class="kop mod-h">{c.priceH}</h2>
        <div class="ladder">
          {RUNGS.map((r) => (
            <div class="trede">
              <span class="etiket trede-bereik">{r.label}</span>
              <span class="getal trede-bedrag">&euro;{ladderRate('catalog', r.at)}</span>
              <span class="trede-per etiket">per product</span>
            </div>
          ))}
        </div>
      </section>

      <!-- ═══ 05 · DE PROEF ═════════════════════════════════════════════ -->
      <section class="mod mod-slot op-inkt" id="proef">
        <p class="mod-regel etiket"><span class="etiket-nr">{MODULES[4][0]}</span><span>{MODULES[4][1]}</span><span class="mod-rest">{sample.unit}</span></p>
        <h2 class="kop mod-h slot-h">{c.closeH}</h2>
        <p class="slot-p">{sample.deliverable} — {sample.feeNote}.</p>
        <p class="slot-knoppen">
          <a class="knop knop-geel" href={lp('/test-sample')}>{sample.cta}</a>
          <a class="knop slot-knop-2" href={lp('/start')}>{c.ctaStart}</a>
        </p>
      </section>

      <footer class="voet">
        <p class="etiket voet-in"><span>{c.labels[0]} · {c.labels[2]}</span><span>Voorstel C · Console</span></p>
      </footer>
    </main>
  </div>
</ConceptLayout>

<style>
  .console { display: grid; grid-template-columns: 15rem minmax(0, 1fr); }
  @media (max-width: 64rem) { .console { grid-template-columns: minmax(0, 1fr); } }

  /* ── DE AFLEZING ────────────────────────────────────────────────────────
     Vast, volle hoogte, één haarlijn als scheiding. Geen schaduw en geen
     tweede grond: het is geen paneel dat over de pagina heen ligt maar de
     rand van het apparaat. */
  .rail {
    position: sticky; top: 0; align-self: start; height: 100vh;
    display: grid; grid-template-rows: auto auto 1fr auto auto; gap: var(--s-2);
    padding: var(--s-2) var(--s-2) var(--s-2) clamp(1.25rem, 2.5vw, 2rem);
    border-inline-end: 1px solid var(--lijn);
  }
  .rail-merk { display: block; }
  .rail-kop { color: var(--inkt); font-stretch: 100%; }
  .rail-lijst { display: grid; gap: 0; align-content: start; border-top: 1px solid var(--lijn); }
  .rail-item {
    display: grid; grid-template-columns: 2.1rem minmax(0, 1fr); gap: .5rem; align-items: baseline;
    padding-block: .7rem; border-bottom: 1px solid var(--lijn);
    font-family: var(--mono); font-size: var(--t-label); font-stretch: 82%; letter-spacing: .05em; text-transform: uppercase;
  }
  .rail-nr { color: var(--inkt-3); font-variant-numeric: tabular-nums; }
  .rail-naam { color: var(--inkt-2); }
  .rail-item:hover .rail-naam, .rail-item:focus-visible .rail-naam { color: var(--inkt); }
  /* De aflezing markeert de module waar je naartoe sprong. `:target` is de
     enige stand die zonder script klopt — en een stand die alleen klopt als er
     JavaScript draait, is op een pagina die iets verkoopt geen stand. */
  .inhoud :global(.mod:target) { scroll-margin-top: 0; }
  .rail-stand { align-self: end; color: var(--inkt-2); }
  .stip { width: 7px; height: 7px; border-radius: 50%; background: var(--gloed); display: inline-block; flex: none; translate: 0 -1px; }
  .stip-uit { background: var(--lijn-sterk); }
  .rail-knop { justify-content: center; }
  @media (max-width: 64rem) {
    .rail { position: static; height: auto; grid-template-rows: none; grid-template-columns: auto 1fr auto; align-items: center; border-inline-end: 0; border-bottom: 1px solid var(--lijn); }
    .rail-kop, .rail-lijst, .rail-stand { display: none; }
  }

  /* ── DE MODULE ──────────────────────────────────────────────────────────
     Elke sectie: regel, kop, inhoud. De regel staat altijd op dezelfde hoogte
     ten opzichte van de kop en heeft altijd dezelfde drie velden — nummer,
     naam, stand. Dat is de hele afspraak. */
  .inhoud { padding-inline: clamp(1.25rem, 3vw, 3.5rem); }
  .mod { padding-block: var(--s-5); border-bottom: 1px solid var(--lijn); }
  .mod-regel { justify-content: flex-start; padding-bottom: .7rem; border-bottom: 1px solid var(--lijn); margin-bottom: var(--s-3); }
  .mod-rest { margin-inline-start: auto; color: var(--inkt-3); }
  .mod-h { font-size: var(--t-2); margin-bottom: var(--s-3); max-width: 24ch; }

  .mod-hero { padding-top: var(--s-4); }
  .hero-h { font-size: var(--t-1); font-stretch: 112%; max-width: 15ch; }
  .hero-lede { margin-top: var(--s-2); max-width: 42ch; color: var(--inkt-2); font-size: var(--t-tekst); }
  .meters { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--kolomgat); margin-top: var(--s-3); }
  .meter { display: grid; gap: .35rem; padding-top: .7rem; border-top: 2px solid var(--inkt); }
  .meter-nr { font-family: var(--mono); font-size: var(--t-label); font-stretch: 82%; color: var(--gloed); }
  .meter-t { font-size: var(--t-klein); line-height: 1.45; }
  .hero-beeld { margin-top: var(--s-3); aspect-ratio: 2000 / 1125; }
  @media (max-width: 64rem) { .meters { grid-template-columns: repeat(2, minmax(0, 1fr)); } }

  /* ── DIENSTEN ALS REGELS MET EEN AFLEZING ──────────────────────────────── */
  .diensten { border-top: 1px solid var(--lijn); }
  .dienst {
    display: grid; grid-template-columns: 2.6rem minmax(0, 1fr) auto 1.6rem; gap: var(--s-2);
    align-items: center; padding-block: var(--s-2); border-bottom: 1px solid var(--lijn);
  }
  .dienst:hover { background: var(--vel); }
  .dienst-nr { font-family: var(--mono); font-size: var(--t-label); font-stretch: 82%; color: var(--inkt-3); }
  .dienst-woord { display: grid; gap: .2rem; min-width: 0; }
  .dienst-h { font-size: var(--t-3); }
  .dienst-wat { color: var(--inkt-2); font-size: var(--t-klein); }
  .dienst-prijs { font-size: var(--t-3); white-space: nowrap; }
  @media (max-width: 48rem) {
    .dienst { grid-template-columns: 2.2rem minmax(0, 1fr); gap: var(--s-1); }
    .dienst-prijs, .dienst .pijl { grid-column: 2; }
  }

  /* ── ERIN, ERUIT ────────────────────────────────────────────────────────── */
  .vn { display: grid; gap: var(--s-3); }
  .vn-kant { display: grid; gap: var(--s-1); }
  .vn-etiket { padding-bottom: .55rem; border-bottom: 1px solid var(--lijn); }
  .strook { display: grid; gap: var(--kolomgat); }
  .strook-in { grid-template-columns: repeat(5, minmax(0, 1fr)); }
  .strook-uit { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .strook-in li { aspect-ratio: 3 / 4; }
  .strook-uit li { aspect-ratio: 1; }
  @media (max-width: 48rem) {
    .strook-in { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .strook-uit { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  /* ── HET PROCES ALS SPOOR ───────────────────────────────────────────────
     Eén verticale lijn met vier punten erop. Het is de enige plek op de
     pagina waar een versiering staat, en hij is er omdat een proces een
     volgorde is en een rij kaarten dat niet laat zien. */
  .stappen { display: grid; gap: 0; }
  .stap { display: grid; grid-template-columns: 1.6rem minmax(0, 1fr); gap: var(--s-2); }
  .stap-spoor { position: relative; display: grid; justify-items: center; }
  /* Zonder een horizontale plaatsing valt een element van 1px breed op
     `inset-inline: auto` samen tot niets; de lijn was er dus niet. */
  .stap-spoor::before { content: ""; position: absolute; inset-block: 0; inset-inline-start: 50%; width: 1px; background: var(--lijn); }
  .stap:first-child .stap-spoor::before { top: .55rem; }
  .stap:last-child .stap-spoor::before { bottom: calc(100% - .55rem); }
  .stap-spoor .stip { margin-top: .35rem; }
  .stap-woord { display: grid; gap: .25rem; padding-bottom: var(--s-3); }
  .stap-nr { color: var(--inkt-3); }
  .stap-h { font-size: var(--t-3); }
  .stap-p { color: var(--inkt-2); font-size: var(--t-klein); max-width: 52ch; }

  /* ── TARIEVEN ───────────────────────────────────────────────────────────── */
  .ladder { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--kolomgat); }
  .trede { display: grid; gap: .25rem; padding-top: var(--s-1); border-top: 2px solid var(--inkt); }
  .trede-bereik { color: var(--inkt); }
  .trede-bedrag { font-size: clamp(2.25rem, 4vw, 3.5rem); font-stretch: 118%; }
  .trede-per { color: var(--inkt-3); }
  @media (max-width: 48rem) { .ladder { grid-template-columns: repeat(2, minmax(0, 1fr)); } }

  /* ── DE PROEF ───────────────────────────────────────────────────────────── */
  .mod-slot { background: var(--inkt); color: var(--vel); border-radius: var(--rond-groot); padding-inline: var(--s-3); margin-block: var(--s-4); border-bottom: 0; }
  .mod-slot .mod-regel { border-bottom-color: rgb(255 255 255 / .18); }
  .slot-h { max-width: 22ch; }
  .slot-p { color: rgb(255 255 255 / .76); font-size: var(--t-klein); max-width: 48ch; }
  .slot-knoppen { display: flex; flex-wrap: wrap; gap: var(--s-1); margin-top: var(--s-2); }
  .slot-knop-2 { border-color: rgb(255 255 255 / .55); }

  .voet { padding-block: var(--s-2); }
  .voet-in { justify-content: space-between; }
</style>
