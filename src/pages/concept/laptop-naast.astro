---
/**
 * VARIANT B — de titel NAAST de laptop, en de laptop loopt de rand uit.
 * 13 september 2026.
 *
 * Lucas: *"past de tekst en andere onderdelen hier dan nog wel bij. Kijk hoe
 * dit eruit gaat zien wanneer ik dit aan de website ga toevoegen inclusief
 * titel en topbar."*
 *
 * ── DE REKENSOM DIE DE VRAAG BEANTWOORDT ──────────────────────────────────
 * De plaat is liggend (1,77). Zet je de titel eróveheen in de hoogte, dan
 * moeten op een scherm van 1440 × 900 achter elkaar passen: de balk (72), het
 * tekstblok (circa 230) en de laptop. Voor de laptop blijft dan hooguit 598
 * pixels hoogte over, en bij 1,77 is dat 1058 breed — smaller dan de kolom.
 * De laptop wordt dus KLEINER zodra de titel erboven komt. Dat is geen smaak
 * maar meetkunde, en het is precies waar je naar vraagt.
 *
 * Naast elkaar valt die botsing weg: de titel neemt hoogte in een kolom die
 * toch al leeg was, en de laptop mag de rechterrand uit lopen en wordt daar
 * juist groter van.
 *
 * ── WAAROM DE LAPTOP MAG BLOEDEN EN DE DOEK NIET ──────────────────────────
 * De schermuitsnede is een PERCENTAGE van de doek, en de plaat vult die doek
 * met `object-fit: cover`. Wordt de doek breder dan de plaat, dan snijdt cover
 * de bovenkant en de onderkant weg en schuift de uitsnede weg onder het beeld.
 * De doek houdt dus altijd exact de verhouding van de plaat; wat er buiten
 * beeld loopt, is de hele carousel als geheel, afgesneden door de sectie. Zo
 * blijft de uitlijning tussen het gat en het beeld overeind.
 */
import ConceptLayout from '../../layouts/ConceptLayout.astro';
import LaptopCarousel from '../../components/LaptopCarousel.astro';
import { inhoud } from '../../data/conceptInhoud.js';
import { localizedPath } from '../../i18n/ui.js';
import '../../styles/stelsel.css';

const lang = 'nl' as const;
const lp = (p: string) => localizedPath(lang, p);
const { c, sample, RUNGS, ladderRate } = inhoud(lang);

const INGESTUURD = [
  ['/img/ba2-voor-front.webp', 'Telefoonfoto: een roze jeans plat op een betonnen magazijnvloer, voorkant'],
  ['/img/ba2-voor-achter.webp', 'Telefoonfoto: dezelfde jeans omgedraaid, achterkant'],
  ['/img/ba2-voor-detail.webp', 'Telefoonfoto: een hand houdt de tailleband met de knoop omhoog'],
  ['/img/ba2-voor-textuur.webp', 'Telefoonfoto: het weefsel van dichtbij'],
  ['/img/ba2-voor-pasvorm.webp', 'Spiegelselfie waarop de jeans gedragen wordt'],
];
const GELEVERD = [
  ['/img/ba2-na-front.webp', 'Afgewerkt catalogbeeld: de jeans recht van voren op wit'],
  ['/img/ba2-na-achter.webp', 'Afgewerkt catalogbeeld: de achterkant op wit'],
  ['/img/ba2-na-detail.webp', 'Afgewerkt detailbeeld: de knoop en de tailleband'],
  ['/img/ba2-na-model.webp', 'Afgewerkt beeld: de jeans gedragen door een model'],
];
---
<ConceptLayout
  title="VISUAILS — de nieuwe beginpagina"
  description="De nieuwe beginpagina van VISUAILS: de titel links, de laptop rechts, en per slide de ingestuurde foto naast het afgewerkte beeld."
  lang={lang}
  grond="vel"
>
  <a class="visueel-verborgen" href="#inhoud">Naar de inhoud</a>

  <header class="balk">
    <div class="binnen balk-in">
      <a href={lp('/')} aria-label="VISUAILS">
        <svg class="merkteken" aria-hidden="true"><use href="#markglyph" /></svg>
      </a>
      <nav class="balk-nav" aria-label="Hoofd">
        {c.nav.map(([naam, doel]) => <a href={doel}>{naam}</a>)}
      </nav>
      <a class="knop knop-geel" href={lp('/start')}>{c.ctaStart}</a>
    </div>
  </header>

  <main id="inhoud">
    <section class="opening">
      <div class="binnen op-rij">
        <div class="op-woord">
          <h1 class="kop op-h" set:html={c.h1.join(' ')} />
          <p class="op-lede">{c.lede}</p>
          <p class="op-knoppen">
            <a class="knop knop-geel" href={lp('/start')}>{c.ctaStart}</a>
            <a class="knop" href={lp('/test-sample')}>{sample.cta}</a>
          </p>
        </div>
        <div class="op-beeld">
          <LaptopCarousel lang={lang} titel="Werk van VISUAILS, per stijl" />
        </div>
      </div>
    </section>

    <div class="binnen spil">
      <!-- ═══ 01 · DE VIER FEITEN ═══════════════════════════════════════
           Geen gele band over de volle breedte: die staat loodrecht op de
           leesrichting en werkt als een slagboom. Vier regels aan dezelfde
           lijn zeggen hetzelfde en houden de pagina aan de gang. -->
      <section class="stap">
        <span class="nr" aria-hidden="true">01</span>
        <ul class="feiten">{c.facts.map((f) => <li>{f}</li>)}</ul>
      </section>

      <!-- ═══ 02 · WAT WE MAKEN ═════════════════════════════════════════ -->
      <section class="stap" id="maken">
        <span class="nr" aria-hidden="true">02</span>
        <header class="kop-groep">
          <h2 class="kop">{c.svcH}</h2>
          <p class="lopend">{c.svcLede}</p>
        </header>
        <ul class="diensten">
          {c.svc.map(([naam, wat, prijs, pad]) => (
            <li>
              <a class="dienst" href={lp(pad)}>
                <span class="dienst-woord">
                  <span class="kop dienst-h">{naam}</span>
                  <span class="dienst-wat">{wat}</span>
                </span>
                <span class="getal dienst-prijs">{prijs}</span>
                <span class="dienst-knop">{c.svcMore}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>

      <!-- ═══ 03 · ERIN, ERUIT ══════════════════════════════════════════ -->
      <section class="stap">
        <span class="nr" aria-hidden="true">03</span>
        <header class="kop-groep">
          <h2 class="kop">{c.vnH}</h2>
          <p class="lopend">{c.setH}</p>
        </header>
        <p class="rij-etiket etiket"><span>{c.vnIn[0]}</span><span class="rij-noot">5 &middot; telefoon</span></p>
        <ul class="strook strook-in">
          {INGESTUURD.map(([src, alt]) => (
            <li class="beeld-vak"><img class="beeld" src={src} width="760" height="1013" alt={alt} loading="lazy" decoding="async" /></li>
          ))}
        </ul>
        <p class="rij-etiket etiket"><span>{c.vnOut[0]}</span><span class="rij-noot">4 &middot; 2048 &times; 2048</span></p>
        <ul class="strook strook-uit">
          {GELEVERD.map(([src, alt]) => (
            <li class="beeld-vak"><img class="beeld" src={src} width="760" height="760" alt={alt} loading="lazy" decoding="async" /></li>
          ))}
        </ul>
      </section>

      <!-- ═══ 04 · HET PROCES ═══════════════════════════════════════════ -->
      <section class="stap">
        <span class="nr" aria-hidden="true">04</span>
        <header class="kop-groep"><h2 class="kop">{c.stepsH}</h2></header>
        <ol class="stappen">
          {c.steps.map(([kop, zin], i) => (
            <li class="sub">
              <span class="mono sub-nr">{String(i + 1).padStart(2, '0')}</span>
              <span class="kop sub-h">{kop}</span>
              <span class="sub-p">{zin}</span>
            </li>
          ))}
        </ol>
      </section>

      <!-- ═══ 05 · TARIEVEN ═════════════════════════════════════════════ -->
      <section class="stap" id="tarieven">
        <span class="nr" aria-hidden="true">05</span>
        <header class="kop-groep">
          <h2 class="kop">{c.priceH}</h2>
          <p class="lopend">{c.priceVat}</p>
        </header>
        <div class="ladder">
          {RUNGS.map((r, i) => (
            <div class={`trede${i === 0 ? ' is-aan' : ''}`}>
              <span class="etiket">{r.label} producten</span>
              <span class="getal trede-bedrag">&euro;{ladderRate('catalog', r.at)}</span>
            </div>
          ))}
        </div>
        <p class="knoppen"><a class="knop knop-geel" href={lp('/pricing')}>{c.priceCta}</a></p>
      </section>
    </div>

    <!-- ═══ 06 · HET EINDPUNT ═══════════════════════════════════════════ -->
    <section class="slot">
      <div class="binnen slot-in">
        <div>
          <h2 class="kop slot-h">{c.closeH}</h2>
          <p class="slot-p">{c.closeLede}</p>
        </div>
        <p class="knoppen">
          <a class="knop knop-geel" href={lp('/test-sample')}>{sample.cta}</a>
          <a class="knop slot-knop" href={lp('/start')}>{c.ctaStart}</a>
        </p>
      </div>
      <div class="binnen voet-in">
        <p class="etiket">{c.labels[0]} &middot; {c.labels[2]}</p>
        <ul class="voet-trust">{c.trust.map((t) => <li>{t}</li>)}</ul>
      </div>
    </section>
  </main>
</ConceptLayout>

<style>
  .balk { border-bottom: 1px solid var(--lijn); }
  .balk-in { display: flex; align-items: center; gap: var(--s-2); min-height: 72px; }
  .balk-nav { display: flex; gap: var(--s-2); margin-inline: auto; }
  .balk-nav a { font-family: var(--mono); font-size: var(--t-label); font-stretch: 82%; letter-spacing: .06em; text-transform: uppercase; color: var(--inkt-2); }
  .balk-nav a:hover { color: var(--inkt); }
  @media (max-width: 64rem) { .balk-nav { display: none; } }

  /* De sectie snijdt af aan de rechterkant; de laptop loopt daar doorheen. */
  .opening { overflow: hidden; padding-block: var(--s-4); }
  .op-rij { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(1.5rem, 4vw, 3.5rem); align-items: center; }
  .op-woord { display: grid; gap: var(--s-1); max-width: 34rem; }
  .op-h { font-size: clamp(2.1rem, 3.4vw, 3.4rem); font-stretch: 112%; }
  .op-lede { max-width: 40ch; font-size: var(--t-tekst); color: var(--inkt-2); }
  .op-knoppen { display: flex; flex-wrap: wrap; gap: var(--s-1); margin-top: var(--s-1); }

  /* 128% van de kolom: de laptop begint links netjes in de kolom en loopt er
     rechts uit. De doek zelf houdt zijn verhouding, dus de uitsnede blijft
     kloppen — alleen het blok als geheel is breder dan wat je ziet. */
  .op-beeld :global(.lc) { width: 128%; }
  .op-beeld :global(.lc-voet) { width: 78%; }

  @media (max-width: 64rem) {
    .op-rij { grid-template-columns: minmax(0, 1fr); }
    .op-beeld :global(.lc) { width: 100%; }
    .op-beeld :global(.lc-voet) { width: 100%; }
  }

  /* ── DE DOORLOPENDE LIJN ────────────────────────────────────────────────
     Eén haarlijn van de eerste sectie tot de laatste, met de nummers erop.
     Verticaal meelopen in plaats van horizontaal afsnijden; zie de noot in
     /concept/doorloop voor de meting waar dit uit voortkomt. */
  .spil { position: relative; }
  @media (min-width: 64rem) {
    .spil { padding-left: 7.5rem; }
    .spil::before { content: ""; position: absolute; left: 3.25rem; top: 1.2rem; bottom: 0; width: 1px; background: var(--lijn); }
  }
  .stap { position: relative; padding-block: var(--s-5); }
  .nr { display: none; font-family: var(--mono); font-size: var(--t-label); font-stretch: 82%; letter-spacing: .06em; color: var(--inkt-3); }
  @media (min-width: 64rem) {
    .nr { display: block; position: absolute; left: -5.5rem; top: calc(var(--s-5) + .2rem); background: var(--vel); padding-block: .35rem; width: 3.5rem; text-align: center; }
  }
  .kop-groep { max-width: 44rem; margin-bottom: var(--s-3); display: grid; gap: var(--s-1); }
  .kop-groep h2 { font-size: var(--t-2); }

  .feiten { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--kolomgat); }
  .feiten li { padding-top: var(--s-1); border-top: 2px solid var(--inkt); font-family: var(--mono); font-size: var(--t-label); font-stretch: 82%; letter-spacing: .04em; text-transform: uppercase; line-height: 1.5; }
  @media (max-width: 64rem) { .feiten { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 34rem) { .feiten { grid-template-columns: minmax(0, 1fr); } }

  .diensten { border-top: 1px solid var(--lijn); }
  .dienst { display: grid; grid-template-columns: minmax(0, 1fr) auto auto; gap: var(--s-2); align-items: center; padding: var(--s-2) var(--s-1); border-bottom: 1px solid var(--lijn); border-radius: var(--rond-m); transition: background-color .25s var(--uit); }
  .dienst:hover { background: var(--wit); }
  .dienst-woord { display: grid; gap: .25rem; min-width: 0; }
  .dienst-h { font-size: var(--t-3); }
  .dienst-wat { color: var(--inkt-2); font-size: var(--t-klein); }
  .dienst-prijs { font-size: var(--t-3); white-space: nowrap; }
  .dienst-knop { border: 1px solid var(--lijn-sterk); border-radius: var(--rond-knop); padding: .5rem .95rem; font-family: var(--mono); font-size: var(--t-label); font-stretch: 82%; letter-spacing: .06em; text-transform: uppercase; white-space: nowrap; }
  .dienst:hover .dienst-knop { background: var(--inkt); border-color: var(--inkt); color: var(--vel); }
  @media (max-width: 48rem) { .dienst { grid-template-columns: minmax(0, 1fr); gap: var(--s-1); justify-items: start; } }

  .rij-etiket { justify-content: space-between; padding-bottom: .6rem; border-bottom: 1px solid var(--lijn); margin-bottom: var(--s-1); }
  .rij-etiket + .strook { margin-bottom: var(--s-3); }
  .rij-noot { color: var(--inkt-3); }
  .strook { display: grid; gap: var(--kolomgat); }
  .strook-in { grid-template-columns: repeat(5, minmax(0, 1fr)); }
  .strook-uit { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .strook-in li { aspect-ratio: 3 / 4; }
  .strook-uit li { aspect-ratio: 1; }
  @media (max-width: 48rem) {
    .strook-in { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .strook-uit { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  .stappen { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--kolomgat); }
  .sub { display: grid; gap: .35rem; align-content: start; padding-top: var(--s-1); border-top: 1px solid var(--lijn); }
  .sub-nr { color: var(--inkt-3); }
  .sub-h { font-size: var(--t-3); }
  .sub-p { color: var(--inkt-2); font-size: var(--t-klein); line-height: 1.5; }
  @media (max-width: 64rem) { .stappen { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 34rem) { .stappen { grid-template-columns: minmax(0, 1fr); } }

  .ladder { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--kolomgat); }
  .trede { display: grid; gap: var(--s-0); padding-top: var(--s-1); border-top: 1px solid var(--lijn); }
  .trede.is-aan { border-top: 2px solid var(--gloed); }
  .trede-bedrag { font-size: clamp(2rem, 3.4vw, 3rem); font-stretch: 118%; }
  @media (max-width: 64rem) { .ladder { grid-template-columns: repeat(2, minmax(0, 1fr)); } }

  .slot { background: var(--inkt); color: var(--vel); margin-top: var(--s-5); padding-block: var(--s-5) var(--s-3); border-radius: var(--rond-l) var(--rond-l) 0 0; }
  .slot-in { display: flex; flex-wrap: wrap; gap: var(--s-3); align-items: end; justify-content: space-between; }
  .slot-h { font-size: var(--t-2); max-width: 20ch; }
  .slot-p { color: rgb(255 255 255 / .8); font-size: var(--t-klein); max-width: 46ch; margin-top: var(--s-1); }
  .slot-knop { border-color: rgb(255 255 255 / .55); color: var(--vel); }
  .slot-knop:hover { background: var(--vel); color: var(--inkt); border-color: var(--vel); }
  .voet-in { display: grid; gap: var(--s-1); margin-top: var(--s-5); padding-top: var(--s-2); border-top: 1px solid rgb(255 255 255 / .16); }
  .voet-in .etiket { color: rgb(255 255 255 / .6); }
  .voet-trust { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--s-1); font-size: var(--t-klein); color: rgb(255 255 255 / .78); }
  @media (max-width: 64rem) { .voet-trust { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
</style>
