---
/**
 * VOORSTEL B · BAAN — de voorpagina als aaneengesloten baan. 13 september 2026.
 *
 * ── WAT DIT VOORSTEL DOET ─────────────────────────────────────────────────
 * Geen zichtbaar raster, geen kaartjes, geen randen. Eén ononderbroken baan van
 * volvlakken die van rand tot rand lopen, en het werk zelf is de vormgeving:
 * elk blok is óf een uitspraak óf een beeld, nooit allebei half.
 *
 * De consistentie zit hier in het RITME en niet in een lijn: elke baan heeft
 * dezelfde kop (etiket links, uitspraak rechts — .blok-kop uit stelsel.css),
 * dezelfde binnenruimte en dezelfde ronding. Wat wisselt is alleen de grond:
 * vel, wit, inkt, vel. Dat is één afspraak in plaats van negen losse maten, en
 * daarom kan er niets meer "niet bij horen".
 *
 * ── WAAROM DIT KAN WINNEN VAN VOORSTEL A ──────────────────────────────────
 * PRODUCT.md: *"Show the work before the claim — finished output has to arrive
 * before any price, promise or explanation does."* Hier is dat letterlijk: het
 * eerste wat je ziet is een beeld over de volle breedte, en de belofte staat
 * erin en niet erboven. Een zichtbaar meetraster (voorstel A) is technischer;
 * dit is duurder en laat de fotografie het zwaarste werk doen.
 *
 * ── HET RISICO, EERLIJK ───────────────────────────────────────────────────
 * Zonder zichtbaar raster is er geen visuele straf op een blok dat zijn eigen
 * maat verzint. De discipline zit dan volledig in stelsel.css en in wie eraan
 * werkt. Voorstel A dwingt, voorstel B vertrouwt.
 */
import ConceptLayout from '../../layouts/ConceptLayout.astro';
import { inhoud } from '../../data/conceptInhoud.js';
import { localizedPath } from '../../i18n/ui.js';
import '../../styles/stelsel.css';

const lang = 'nl' as const;
const lp = (p: string) => localizedPath(lang, p);
const { c, sample, RUNGS, SFEER, ladderRate } = inhoud(lang);

const INGESTUURD = [
  ['/img/ba2-voor-front.webp', 'Telefoonfoto: een roze jeans plat op een betonnen magazijnvloer, voorkant'],
  ['/img/ba2-voor-achter.webp', 'Telefoonfoto: dezelfde jeans omgedraaid, achterkant'],
  ['/img/ba2-voor-detail.webp', 'Telefoonfoto: een hand houdt de tailleband met de knoop omhoog'],
  ['/img/ba2-voor-textuur.webp', 'Telefoonfoto: het weefsel van dichtbij'],
  ['/img/ba2-voor-pasvorm.webp', 'Spiegelselfie waarop de jeans gedragen wordt'],
];
const GELEVERD = [
  ['/img/ba2-na-front.webp', 'Afgewerkt catalogbeeld: de jeans recht van voren op wit'],
  ['/img/ba2-na-achter.webp', 'Afgewerkt catalogbeeld: de achterkant op wit'],
  ['/img/ba2-na-detail.webp', 'Afgewerkt detailbeeld: de knoop en de tailleband'],
  ['/img/ba2-na-model.webp', 'Afgewerkt beeld: de jeans gedragen door een model'],
];
---
<ConceptLayout
  title="Voorstel B · Baan — VISUAILS"
  description="Voorstel B voor de nieuwe voorpagina: één ononderbroken baan van volvlakken, waarin het werk zelf de vormgeving is."
  lang={lang}
  grond="vel"
>
  <a class="visueel-verborgen" href="#inhoud">Naar de inhoud</a>

  <header class="balk">
    <div class="binnen balk-in">
      <a class="balk-merk" href={lp('/')} aria-label="VISUAILS">
        <svg class="merkteken" aria-hidden="true"><use href="#markglyph" /></svg>
      </a>
      <nav class="balk-nav" aria-label="Hoofd">
        {c.nav.map(([naam, doel]) => <a href={doel}>{naam}</a>)}
      </nav>
      <a class="knop knop-geel" href={lp('/start')}>{c.ctaStart}</a>
    </div>
  </header>

  <main id="inhoud">
    <!-- ═══ HET WERK EERST ════════════════════════════════════════════════
         Een beeld over de volle breedte met de uitspraak erin. Geen etiket,
         geen feitenrij, geen tweede knop: dit scherm heeft één taak. -->
    <section class="baan hero">
      <img class="hero-beeld" src={SFEER[0].src} width={SFEER[0].w} height={SFEER[0].h} alt={SFEER[0].alt} fetchpriority="high" decoding="async" />
      <div class="hero-op binnen">
        <h1 class="kop hero-h" set:html={c.h1.join(' ')} />
        <p class="hero-lede">{c.lede}</p>
        <p class="hero-knoppen">
          <a class="knop knop-geel" href={lp('/start')}>{c.ctaStart}</a>
          <a class="knop hero-knop-2" href={lp('/test-sample')}>{sample.cta}</a>
        </p>
      </div>
    </section>

    <!-- ═══ DE FEITEN ALS BAND ════════════════════════════════════════════ -->
    <section class="baan feiten-baan">
      <ul class="binnen feiten">
        {c.facts.map((f) => <li>{f}</li>)}
      </ul>
    </section>

    <!-- ═══ WAT WE MAKEN ══════════════════════════════════════════════════ -->
    <section class="baan baan-wit" id="maken">
      <div class="binnen">
        <div class="blok-kop">
          <p class="etiket"><span class="etiket-nr">01</span><span>{c.secties[0]}</span></p>
          <div>
            <h2 class="kop">{c.svcH}</h2>
            <p class="lopend">{c.svcLede}</p>
          </div>
        </div>
        <ul class="diensten">
          {c.svc.map(([naam, wat, prijs, pad]) => (
            <li class="dienst">
              <a class="dienst-a" href={lp(pad)}>
                <h3 class="kop dienst-h">{naam}</h3>
                <p class="dienst-wat">{wat}</p>
                <p class="getal dienst-prijs">{prijs}</p>
                <span class="pijl dienst-pijl">Bekijken</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ═══ ERIN, ERUIT ═══════════════════════════════════════════════════
         De sectie die niet bij de site leek te horen. Hier hoort hij erbij
         doordat hij precies doet wat elke andere baan doet: één kop volgens
         .blok-kop, daaronder één ding over de volle breedte. De foto's lopen
         van rand tot rand — dat is de vorm van deze baan en niet een
         uitzondering voor deze sectie. -->
    <section class="baan vn-baan">
      <div class="binnen">
        <div class="blok-kop">
          <p class="etiket"><span class="etiket-nr">02</span><span>{c.secties[1]}</span></p>
          <div><h2 class="kop">{c.vnH}</h2></div>
        </div>
      </div>
      <p class="binnen etiket vn-etiket"><span>{c.vnIn[0]}</span><span class="vn-noot">5 · telefoon</span></p>
      <ul class="strook strook-in">
        {INGESTUURD.map(([src, alt]) => (
          <li><img src={src} width="760" height="1013" alt={alt} loading="lazy" decoding="async" /></li>
        ))}
      </ul>
      <p class="binnen etiket vn-etiket vn-etiket-2"><span>{c.vnOut[0]}</span><span class="vn-noot">4 · 2048 × 2048</span></p>
      <ul class="strook strook-uit">
        {GELEVERD.map(([src, alt]) => (
          <li><img src={src} width="760" height="760" alt={alt} loading="lazy" decoding="async" /></li>
        ))}
      </ul>
    </section>

    <!-- ═══ HET PROCES — op inkt ══════════════════════════════════════════ -->
    <section class="baan baan-inkt op-inkt">
      <div class="binnen">
        <div class="blok-kop">
          <p class="etiket"><span class="etiket-nr">03</span><span>{c.secties[3]}</span></p>
          <div><h2 class="kop">{c.stepsH}</h2></div>
        </div>
        <ol class="stappen">
          {c.steps.map(([kop, zin], i) => (
            <li class="stap">
              <span class="getal stap-nr">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h3 class="kop stap-h">{kop}</h3>
                <p class="stap-p">{zin}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- ═══ TARIEVEN ══════════════════════════════════════════════════════ -->
    <section class="baan baan-wit" id="tarieven">
      <div class="binnen">
        <div class="blok-kop">
          <p class="etiket"><span class="etiket-nr">04</span><span>{c.secties[4]}</span></p>
          <div>
            <h2 class="kop">{c.priceH}</h2>
            <p class="lopend">{c.priceVat}</p>
          </div>
        </div>
        <div class="ladder">
          {RUNGS.map((r) => (
            <div class="trede">
              <span class="etiket">{r.label} producten</span>
              <span class="getal trede-bedrag">&euro;{ladderRate('catalog', r.at)}</span>
            </div>
          ))}
        </div>
        <p class="ladder-actie"><a class="knop knop-geel" href={lp('/pricing')}>{c.priceCta}</a></p>
      </div>
    </section>

    <!-- ═══ DE PROEF ══════════════════════════════════════════════════════ -->
    <section class="baan slot">
      <img class="slot-beeld" src={SFEER[4].src} width={SFEER[4].w} height={SFEER[4].h} alt={SFEER[4].alt} loading="lazy" decoding="async" />
      <div class="slot-op binnen">
        <h2 class="kop slot-h">{c.closeH}</h2>
        <p class="slot-p">{sample.deliverable} — {sample.feeNote}.</p>
        <p class="hero-knoppen">
          <a class="knop knop-geel" href={lp('/test-sample')}>{sample.cta}</a>
          <a class="knop hero-knop-2" href={lp('/start')}>{c.ctaStart}</a>
        </p>
      </div>
    </section>
  </main>

  <footer class="voet op-inkt">
    <div class="binnen voet-in etiket">
      <span>{c.labels[0]} · {c.labels[2]}</span>
      <span>Voorstel B · Baan</span>
    </div>
  </footer>
</ConceptLayout>

<style>
  /* ── DE BALK: zweeft over het beeld, want het beeld begint bovenaan ────── */
  /* De balk zweeft over de foto, en een foto is niet overal even donker: op de
     gele lichtvlek in het herobeeld viel de navigatie weg. Een sluier van 120
     pixels bovenaan lost dat op zonder een balk te tekenen die er niet is. */
  .balk { position: absolute; inset-inline: 0; top: 0; z-index: 5; color: var(--vel); }
  .balk::before { content: ""; position: absolute; inset-inline: 0; top: 0; height: 120px; z-index: -1; background: linear-gradient(to bottom, rgb(17 17 17 / .55), rgb(17 17 17 / 0)); pointer-events: none; }
  .balk-in { display: flex; align-items: center; gap: var(--s-2); min-height: 76px; }
  .balk-nav { display: flex; gap: var(--s-2); margin-inline: auto; }
  .balk-nav a { font-family: var(--mono); font-size: var(--t-label); font-stretch: 82%; letter-spacing: .06em; text-transform: uppercase; opacity: .9; }
  .balk-nav a:hover { opacity: 1; }
  @media (max-width: 64rem) { .balk-nav { display: none; } }

  .baan { position: relative; }
  .baan-wit { background: var(--wit); padding-block: var(--s-5); }
  .baan-inkt { background: var(--inkt); color: var(--vel); padding-block: var(--s-5); }

  /* ── HET WERK EERST ─────────────────────────────────────────────────────
     Geen 100vh: een scherm dat precies de hoogte van de kijker heeft, duwt de
     rest van de pagina uit beeld en dan lijkt de site één scherm lang. 78vh
     met een ondergrens laat zien dat er meer is. */
  .hero { min-height: min(78vh, 46rem); display: grid; align-items: end; isolation: isolate; }
  .hero-beeld { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -1; }
  /* De verloopsluier: alleen onderaan, waar de letters staan. Een sluier over
     het hele beeld maakt de foto dof en dat is precies het verkeerde signaal
     op een pagina die beeldkwaliteit verkoopt. */
  .hero::after { content: ""; position: absolute; inset: 0; z-index: -1; background: linear-gradient(to top, rgb(17 17 17 / .82) 0%, rgb(17 17 17 / .45) 34%, rgb(17 17 17 / 0) 68%); }
  .hero-op { padding-block: var(--s-4); color: var(--vel); display: grid; gap: var(--s-1); }
  .hero-h { font-size: var(--t-1); font-stretch: 112%; max-width: 16ch; }
  .hero-h :global(em) { background: none; color: var(--geel-letter); padding: 0; }
  .hero-lede { max-width: 38ch; font-size: var(--t-tekst); color: rgb(255 255 255 / .82); }
  .hero-knoppen { display: flex; flex-wrap: wrap; gap: var(--s-1); margin-top: var(--s-1); }
  .hero-knop-2 { border-color: rgb(255 255 255 / .55); color: var(--vel); }
  .hero-knop-2:hover { background: var(--vel); color: var(--inkt); border-color: var(--vel); }

  /* ── DE FEITENBAND ──────────────────────────────────────────────────────
     Vier feiten op één regel over de volle breedte. Dit is de enige band op de
     pagina zonder kop — hij hoort bij het scherm erboven en niet bij zichzelf. */
  .feiten-baan { background: var(--geel); color: var(--inkt); padding-block: var(--s-2); }
  .feiten { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--s-2); }
  .feiten li { font-family: var(--mono); font-size: var(--t-label); font-stretch: 82%; letter-spacing: .04em; text-transform: uppercase; line-height: 1.5; }
  @media (max-width: 64rem) { .feiten { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 34rem) { .feiten { grid-template-columns: minmax(0, 1fr); } }

  /* ── DIENSTEN: rijen, geen kaarten ──────────────────────────────────────
     Vier kaarten naast elkaar is de standaardoplossing en precies wat
     PRODUCT.md als anti-referentie noemt ("three feature cards"). Als rijen
     met een haarlijn ertussen leest het als een prijslijst van een studio, en
     dat is wat het is. */
  .diensten { border-top: 1px solid var(--lijn); }
  .dienst { border-bottom: 1px solid var(--lijn); }
  .dienst-a { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 9fr) minmax(0, 5fr) auto; gap: var(--s-2); align-items: baseline; padding-block: var(--s-2); transition: padding-inline .3s var(--uit); }
  .dienst-a:hover { padding-inline: var(--s-1); background: var(--vel); }
  .dienst-h { font-size: var(--t-3); }
  .dienst-wat { color: var(--inkt-2); font-size: var(--t-klein); }
  .dienst-prijs { font-size: var(--t-3); }
  @media (max-width: 64rem) {
    .dienst-a { grid-template-columns: minmax(0, 1fr); gap: var(--s-0); }
    .dienst-a:hover { padding-inline: 0; }
  }

  /* ── ERIN, ERUIT: stroken van rand tot rand ─────────────────────────────
     Geen goot en geen ronding: deze twee rijen zijn de enige plek op de pagina
     waar het beeld de rand raakt, en dat markeert ze als het bewijs. */
  .vn-baan { padding-block: var(--s-5); }
  .vn-etiket { justify-content: space-between; padding-bottom: .6rem; border-bottom: 1px solid var(--lijn); margin-bottom: var(--s-1); }
  .vn-etiket-2 { margin-top: var(--s-3); }
  .vn-noot { color: var(--inkt-3); }
  .strook { display: grid; gap: 2px; }
  .strook-in { grid-template-columns: repeat(5, minmax(0, 1fr)); }
  .strook-uit { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .strook img { width: 100%; height: 100%; object-fit: cover; display: block; background: var(--lijn); }
  .strook-in img { aspect-ratio: 3 / 4; }
  .strook-uit img { aspect-ratio: 1; }
  @media (max-width: 48rem) {
    .strook-in { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .strook-uit { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  /* ── HET PROCES ─────────────────────────────────────────────────────────── */
  .stappen { display: grid; gap: 0; }
  .stap { display: grid; grid-template-columns: 5.5rem minmax(0, 1fr); gap: var(--s-2); align-items: baseline; padding-block: var(--s-2); border-top: 1px solid rgb(255 255 255 / .16); }
  .stap:last-child { border-bottom: 1px solid rgb(255 255 255 / .16); }
  .stap-nr { font-size: clamp(1.5rem, 2.4vw, 2.25rem); color: var(--geel-letter); }
  .stap-h { font-size: var(--t-3); }
  .stap-p { color: rgb(255 255 255 / .72); font-size: var(--t-klein); max-width: 48ch; margin-top: .3rem; }
  @media (max-width: 48rem) { .stap { grid-template-columns: minmax(0, 1fr); gap: var(--s-0); } }

  /* ── DE LADDER: vier treden die van links naar rechts dalen ─────────────── */
  .ladder { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--kolomgat); }
  .trede { display: grid; gap: var(--s-0); padding-top: var(--s-1); border-top: 1px solid var(--lijn); }
  .trede:first-child { border-top: 2px solid var(--inkt); }
  .trede-bedrag { font-size: clamp(2.5rem, 4.6vw, 4rem); font-stretch: 118%; }
  .ladder-actie { margin-top: var(--s-3); }
  @media (max-width: 64rem) { .ladder { grid-template-columns: repeat(2, minmax(0, 1fr)); } }

  /* ── DE PROEF ───────────────────────────────────────────────────────────── */
  .slot { min-height: min(62vh, 36rem); display: grid; align-items: end; isolation: isolate; }
  .slot-beeld { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -1; }
  .slot::after { content: ""; position: absolute; inset: 0; z-index: -1; background: linear-gradient(to top, rgb(17 17 17 / .85) 0%, rgb(17 17 17 / .4) 45%, rgb(17 17 17 / 0) 80%); }
  .slot-op { padding-block: var(--s-4); color: var(--vel); display: grid; gap: var(--s-1); }
  .slot-h { font-size: var(--t-2); max-width: 20ch; }
  .slot-p { color: rgb(255 255 255 / .8); font-size: var(--t-klein); max-width: 46ch; }

  .voet { background: var(--inkt); color: var(--vel); padding-block: var(--s-2); }
  .voet-in { display: flex; flex-wrap: wrap; gap: var(--s-1); justify-content: space-between; color: rgb(255 255 255 / .6); }
</style>
