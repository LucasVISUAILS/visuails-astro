---
// VISUAILS — /models. Standard-model library plus a custom-model teaser.
import Layout from '../../layouts/Layout.astro';

const standardModels = [
  { photo: '/img/model-aaron.webp', name: 'Aaron', traits: ['Warm', 'Toegankelijk'] },
  { photo: '/img/model-ava.webp', name: 'Ava', traits: ['Editorial', 'Elegant'] },
  { photo: '/img/model-elias.webp', name: 'Elias', traits: ['Verfijnd', 'Klassiek'] },
  { photo: '/img/model-ryan.webp', name: 'Ryan', traits: ['Sportief', 'Energiek'] },
  { photo: '/img/model-dana.webp', name: 'Dana', traits: ['Zelfverzekerd', 'Modern'] },
  { photo: '/img/model-lisa.webp', name: 'Lisa', traits: ['Natuurlijk', 'Toegankelijk'] },
  { photo: '/img/model-maegan.webp', name: 'Maegan', traits: ['Gedurfd', 'Statement'] },
  { photo: '/img/model-rae.webp', name: 'Rae', traits: ['Zacht', 'Ingetogen'] },
  { photo: '/img/model-fabi.webp', name: 'Fabi', traits: ['Strak', 'Eigentijds'] },
  { photo: '/img/model-seme.webp', name: 'Seme', traits: ['Scherp', 'Editorial'] },
];

const steps = [
  { n: '01', title: 'Intake', body: "Je deelt referenties en een briefing over de look die je wilt." },
  { n: '02', title: '2–3 richtingen', body: 'We ontwerpen een paar richtingen waarop je kunt reageren.' },
  { n: '03', title: 'Jij kiest', body: 'Kies het gezicht dat past, met één ronde verfijning.' },
  { n: '04', title: 'Vastgezet', body: 'We zetten het model vast zodat het perfect consistent blijft.' },
  { n: '05', title: 'Gebruikt in elke bestelling', body: 'Jouw model verschijnt vanaf dan in elke visual.' },
];

const modelPhotos = ['/img/model-01.webp', '/img/model-02.webp', '/img/model-03.webp'];
---

<Layout
  title="VISUAILS — Consistente modellen in elke visual"
  description="Kies een standaardmodel uit onze bibliotheek of vraag een eigen model aan dat exclusief van jou is — hetzelfde gezicht en dezelfde sfeer in elke catalogus-, lifestyle- en videovisual die je bestelt."
>
  <section class="page-hero">
    <div class="container two-col" style="align-items:center">
      <div>
        <p class="eyebrow-page">Modellen</p>
        <h1 class="display" style="max-width:18ch">Eén gezicht.<br />Elke visual.</h1>
        <p class="lead" style="margin-top:1.2rem">Kies een model uit onze bibliotheek, of ontwerp er een die exclusief van jou is.</p>
        <div class="flex" style="margin-top:1.8rem">
          <a href="#standard" class="btn btn-primary btn-lg">Bekijk modellen</a>
          <a href="/nl/order-custom" class="btn btn-ghost btn-lg">Vraag een eigen model aan</a>
        </div>
      </div>
      <div class="photo-split-media"><img src="/img/model-01.webp" alt="Een VISUAILS-modelportret" loading="lazy" /></div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <div class="photo-grid reveal pending">
        {modelPhotos.map((p, i) => (
          <img src={p} alt={`VISUAILS-modelportret ${i + 1}`} loading="lazy" class={i === 0 ? 'wide' : ''} />
        ))}
      </div>
    </div>
  </section>

  <section id="standard">
    <div class="container">
      <h2 style="margin-bottom:2rem">Standaardmodellen</h2>
      <div class="grid models-grid reveal-group">
        {standardModels.map((m) => (
          <div class="card card-hover model-card reveal pending">
            <img src={m.photo} alt={`${m.name}, een VISUAILS-standaardmodel`} loading="lazy" class="model-avatar" />
            <h3>{m.name}</h3>
            <div class="chip-row">
              {m.traits.map((t) => (
                <span class="chip"><span class="dot"></span>{t}</span>
              ))}
            </div>
            <a href={`/nl/order?model=${encodeURIComponent(m.name)}`} class="link-arrow">Gebruik dit model <svg viewBox="0 0 24 24" class="i"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
          </div>
        ))}
        <div class="card card-hover model-card model-choose reveal pending">
          <div class="monogram monogram-accent" aria-hidden="true"><svg viewBox="0 0 24 24" class="i"><path d="M12 2l2.4 7.4H22l-6 4.6 2.3 7.4-6.3-4.6L5.7 21.4 8 14 2 9.4h7.6z"/></svg></div>
          <h3>Laat ons kiezen</h3>
          <p style="font-size:.95rem;color:var(--ink-3)">Vertel ons je product en sfeer — wij matchen een model voor je.</p>
          <a href="/nl/order?model=VISUAILS%20choose" class="link-arrow" style="color:var(--accent-bright)">Laat ons kiezen <svg viewBox="0 0 24 24" class="i"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
        </div>
      </div>
      <p class="pill-note" style="margin-top:1.8rem">Standaardmodellen zijn inbegrepen in je visualprijs — geen extra kosten.</p>
    </div>
  </section>

  <section id="custom" class="section-tight">
    <div class="container two-col">
      <div class="reveal pending">
        <h2>Je eigen <em>model.</em></h2>
        <p class="lead" style="margin-top:1rem">Een exclusief model gebouwd voor jouw merk, hergebruikt in elke visual die je bestelt.</p>
        <div class="chip-row" style="margin-top:1.6rem">
          <span class="chip"><span class="dot"></span>Exclusief voor jouw merk</span>
          <span class="chip"><span class="dot"></span>Vastgezet voor consistentie</span>
        </div>
        <div class="flex" style="margin-top:1.8rem">
          <span class="magnet-wrap"><span class="magnet-inner"><a href="/nl/order-custom" class="btn btn-primary">Start je eigen model</a></span></span>
          <a href="https://wa.me/31625436130?text=Hoi%20VISUAILS%2C%20ik%20wil%20graag%20een%20eigen%20model%20voor%20mijn%20merk%20bespreken." class="btn btn-wa" target="_blank" rel="noopener"><svg class="i" viewBox="0 0 24 24"><path d="M21 11.5a8.38 8.38 0 0 1-8.5 8.5 8.5 8.5 0 0 1-4-1L3 20l1.5-4.5A8.38 8.38 0 0 1 3.5 11 8.5 8.5 0 0 1 12 3a8.38 8.38 0 0 1 8.5 8.5z"/></svg>Bespreek op WhatsApp</a>
        </div>
        <div style="margin-top:1.2rem"><a class="link-arrow" href="/nl/custom-models">Bekijk richtingen &amp; alle details <svg viewBox="0 0 24 24" class="i"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a></div>
      </div>
      <div class="photo-split-media reveal pending"><img src="/img/custom-models-01.webp" alt="Een portret van een VISUAILS eigen model" loading="lazy" /></div>
    </div>
  </section>

  <section>
    <div class="container">
      <h2 style="margin-bottom:2rem">Hoe een eigen model tot stand komt</h2>
      <div class="steps reveal-group">
        {steps.map((s) => (
          <div class="step reveal pending">
            <span class="step-n">{s.n}</span>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container two-col" style="align-items:start">
      <div class="card reveal pending">
        <h3>Wat jij aanlevert</h3>
        <ul class="checklist" style="margin-top:1.2rem">
          <li><svg viewBox="0 0 24 24" class="i" style="stroke:var(--success)"><path d="M20 6L9 17l-5-5"/></svg><span>Een paar <strong>referenties</strong> voor de look.</span></li>
          <li><svg viewBox="0 0 24 24" class="i" style="stroke:var(--success)"><path d="M20 6L9 17l-5-5"/></svg><span>De <strong>leeftijd, sfeer en look</strong> die je wilt.</span></li>
          <li><svg viewBox="0 0 24 24" class="i" style="stroke:var(--success)"><path d="M20 6L9 17l-5-5"/></svg><span>Eventuele <strong>styling</strong>-richting.</span></li>
          <li><svg viewBox="0 0 24 24" class="i" style="stroke:var(--success)"><path d="M20 6L9 17l-5-5"/></svg><span>Jouw <strong>do’s en don’ts.</strong></span></li>
        </ul>
      </div>
      <div class="card reveal pending" style="border-color:var(--accent-line)">
        <h3>Prijzen &amp; timing</h3>
        <p class="measure" style="margin-top:1rem">Een <strong>eenmalige ontwerpkost</strong>, daarna voor altijd de normale visualprijs. De eerste bestelling duurt iets langer; elke daaropvolgende verloopt op de gebruikelijke snelheid.</p>
        <div class="flex" style="margin-top:1.6rem">
          <a href="/nl/order-custom" class="btn btn-primary">Start je eigen model</a>
          <a href="/nl/pricing" class="link-arrow">Bekijk prijzen <svg viewBox="0 0 24 24" class="i"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
        </div>
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <div class="cta-band reveal pending">
        <h2 class="display" style="font-size:clamp(2.2rem,5vw,3.6rem)">Eén gezicht. Elke visual.<br />Perfect <em>consistent.</em></h2>
        <div class="flex" style="justify-content:center;margin-top:2rem">
          <a href="/nl/order-custom" class="btn btn-primary btn-lg">Vraag een eigen model aan</a>
          <a href="#standard" class="btn btn-ghost btn-lg">Bekijk standaardmodellen</a>
          <a href="https://wa.me/31625436130?text=Hoi%20VISUAILS%2C%20ik%20wil%20graag%20praten%20over%20modellen%20voor%20mijn%20merk." class="btn btn-wa" target="_blank" rel="noopener"><svg class="i" viewBox="0 0 24 24"><path d="M21 11.5a8.38 8.38 0 0 1-8.5 8.5 8.5 8.5 0 0 1-4-1L3 20l1.5-4.5A8.38 8.38 0 0 1 3.5 11 8.5 8.5 0 0 1 12 3a8.38 8.38 0 0 1 8.5 8.5z"/></svg>WhatsApp</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .models-grid { grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); }
  .model-card { display: flex; flex-direction: column; gap: .9rem; }
  .model-choose { border-color: var(--accent-line); }
  .model-avatar { width: 60px; height: 60px; border-radius: 50%; object-fit: cover; border: 1px solid var(--line-strong); }
  .monogram { width: 60px; height: 60px; border-radius: 50%; display: grid; place-items: center; font-family: var(--font-display); font-weight: 900; font-size: 1.3rem; color: var(--ink); background: var(--surface-2); border: 1px solid var(--line-strong); }
  .monogram-accent { background: var(--accent-soft); border: 1px solid var(--accent-line); color: var(--accent-bright); }
  .monogram-accent svg { width: 26px; height: 26px; }
  .chip-row { display: flex; flex-wrap: wrap; gap: .5rem; }
  .chip { display: inline-flex; align-items: center; gap: .45rem; padding: .4rem .85rem; border-radius: var(--r-pill); border: 1px solid var(--line); font-size: .8rem; color: var(--ink-2); }
  .chip .dot { width: 5px; height: 5px; border-radius: 50%; background: var(--accent); }
  .pill-note { display: inline-flex; align-items: center; gap: .5rem; padding: .45rem 1rem; border-radius: var(--r-pill); border: 1px solid var(--line); color: var(--ink-3); font-size: .82rem; font-weight: 500; }
  .measure { max-width: 66ch; }
</style>
