---
// VISUAILS — /nl/models, "De standaardbibliotheek". De pagina-inhoud staat in
// ModelsPage.astro, zodat /models en /nl/models niet uit elkaar kunnen lopen;
// alleen de meta verschilt hier.
//
// Deze URL verwees vroeger via een 301 naar /custom-models (AUDIT-TASK-0.md
// §H·8). Sinds taak #270 is dit weer een echte route — zie de addendum van
// 2026-07-29 bij §H·8, en public/_redirects voor de verwijderde 301.
//
// Geen prijs in de description: het hele punt van deze pagina is dat de
// bibliotheek geen aparte kost heeft, en sectie 13 houdt prijzen per product
// buiten pagina’s anders dan /pricing, /catalog, /lifestyle en /video.
import Layout from '../../layouts/Layout.astro';
import ModelsPage from '../../components/ModelsPage.astro';
// Zie de Engelse tegenhanger: het telwoord komt uit de roster. "Tien" is even
// lang als het woord dat hier stond, dus de meting hieronder blijft kloppen.
import { rosterWoord } from '../../data/models.js';

// 152 tekens is de grens (META_LIMIT). "Bestelling" is vijf tekens langer dan
// "drop", waardoor deze er met 154 net overheen ging; de laatste zin geeft
// daarom een woord op, in plaats van dat het woord wordt teruggedraaid.
const description =
  `${rosterWoord('nl', true)} standaardmodellen, gedeeld over elk merk en inbegrepen in elke bestelling ` +
  'zonder extra kosten. Kies er een, of laat ons er een kiezen.';
---

<Layout
  title={`${rosterWoord('nl', true)} standaardmodellen, in elke bestelling | VISUAILS`}
  description={description}
  ogImage="/img/model-01.webp"
>
  <ModelsPage lang="nl" />
</Layout>
