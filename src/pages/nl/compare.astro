---
// VISUAILS — /nl/compare (Nederlands). De pagina-inhoud staat in
// ComparePage.astro, zodat /compare en /nl/compare niet uit elkaar kunnen
// lopen; alleen de meta verschilt hier.
import Layout from '../../layouts/Layout.astro';
import ComparePage from '../../components/ComparePage.astro';
import { AMOUNT, SHOOT_DAY, euro, FULL_DROP_MIN, FULL_DROP_MAX } from '../../data/pricing.js';

const description =
  `Een productiedag kost ${SHOOT_DAY.nl.range}. Een drop is ${euro(AMOUNT.fullDrop, 'nl')} ` +
  `voor ${FULL_DROP_MIN}–${FULL_DROP_MAX} producten. De eerlijke vergelijking, ` +
  `inclusief waar een shootdag nog steeds wint.`;
---

<Layout title="Shootdag vs VISUAILS — de eerlijke vergelijking" description={description}>
  <ComparePage lang="nl" />
</Layout>
