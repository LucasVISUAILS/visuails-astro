---
// VISUAILS — /nl/compare: in de hal sinds 13 oktober 2026 (afvinklijst 13, alles doen). De pagina
// staat in CompareHal.astro; de vorige (ComparePage.astro) staat op de opruimlijst.
// VISUAILS — /nl/compare (Nederlands). De pagina-inhoud staat in
// ComparePage.astro, zodat /compare en /nl/compare niet uit elkaar kunnen
// lopen; alleen de meta verschilt hier.
//
// De oude tekst zette een pakket tegenover een dag — "een drop is €1.850 voor
// 25–30 producten" — en dat pakket bestaat niet meer. Een dalend tarief kun je
// niet tegenover een dagprijs zetten zonder een aantal te noemen, dus hier
// staat hetzelfde uitgewerkte voorbeeld als in de rechterkolom van de pagina.
// Beide bedragen zijn netto, en dat staat er één keer bij.
import Layout from '../../layouts/Layout.astro';
import CompareHal from '../../components/CompareHal.astro';
import { SHOOT_DAY, euro, quote, vatLabel, FORM_MAX_PRODUCTS } from '../../data/pricing.js';

// levering 117 (17 november 2026, proefronde P3-01): was 30, maar het formulier
// stopt bij FORM_MAX_PRODUCTS (20). Zelfde getal als CompareHal en PricingHal.
const ANCHOR_PRODUCTS = FORM_MAX_PRODUCTS;

const description =
  `Een productiedag kost ${SHOOT_DAY.nl.range}. ${ANCHOR_PRODUCTS} producten ` +
  `als catalogset hier is ${euro(quote('catalog', ANCHOR_PRODUCTS).net, 'nl')}, beide ` +
  `${vatLabel('excl', 'nl')}. Inclusief waar een shootdag nog steeds wint.`;
---

<Layout huid="hal" title="Shootdag vs VISUAILS, de eerlijke vergelijking | VISUAILS" description={description}>
  <CompareHal lang="nl" />
</Layout>
