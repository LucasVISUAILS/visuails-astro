---
// VISUAILS — /nl/start (Nederlands). De pagina-inhoud staat in
// StartPage.astro, zodat /start en /nl/start niet uit elkaar kunnen lopen.
//
// De description bood twee deuren aan — "een hele drop met een gereserveerd
// venster, of losse producten uit de standaard wachtrij" — en dat is precies
// de keuze die het model van augustus 2026 heeft weggehaald. De omvang bepaalt
// het serviceniveau nu, dus er staat één deur beschreven.
import Layout from '../../layouts/Layout.astro';
import StartPage from '../../components/StartPage.astro';
import { WINDOW_THRESHOLD } from '../../data/pricing.js';

const description =
  `Eén ingang, bij elke omvang: vertel ons wat je hebt, en het tarief en de ` +
  `service volgen het aantal. Vanaf ${WINDOW_THRESHOLD} producten is het ` +
  `venster gereserveerd.`;
---

<Layout
  title="Start een bestelling — VISUAILS"
  description={description}
>
  <StartPage lang="nl" />
</Layout>
