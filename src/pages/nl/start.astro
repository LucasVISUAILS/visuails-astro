---
// VISUAILS — /nl/start (Nederlands). De pagina-inhoud staat in
// StartPage.astro, zodat /start en /nl/start niet uit elkaar kunnen lopen.
//
// Dit wás het bestelformulier zelf, en de description zei dat ook: één ingang.
// Er zijn zes ingangen — drie waar je direct kunt bestellen en drie nog niet —
// en doen alsof dat niet zo is, is precies waarom video ontbrak op de enige
// pagina die bestellingen aanneemt. /start is nu de keuze; elke dienst heeft
// een eigen route onder /start/.
import Layout from '../../layouts/Layout.astro';
import StartPage from '../../components/StartPage.astro';
import { WINDOW_THRESHOLD } from '../../data/pricing.js';

/* Onder de 160 tekens — zie de noot in src/pages/start.astro. */
const description =
  `Catalogsets, lifestyle-carousels of allebei. Het tarief per product daalt als ` +
  `het aantal stijgt, en vanaf ${WINDOW_THRESHOLD} producten ligt je leverdatum vast.`;
---

<Layout
  title="Start een bestelling — VISUAILS"
  description={description}
>
  <StartPage lang="nl" />
</Layout>
