---
// VISUAILS — /nl/start (Nederlands). De pagina-inhoud staat in
// StartPage.astro, zodat /start en /nl/start niet uit elkaar kunnen lopen.
//
// Dit wás het bestelformulier zelf, en de description zei dat ook: één ingang.
// /start is nu de KEUZE; elke dienst heeft een eigen route onder /start/. Zie
// de kop van StartPage.astro voor de herbouw van 7 september — waarop de pagina
// groepeert, en waarom de oude groepering (naar of er al een kassa achter zit)
// video liet lijken op iets wat we niet doen.
import Layout from '../../layouts/Layout.astro';
import StartPage from '../../components/StartPage.astro';

/* Onder de 160 tekens — zie de noot in src/pages/start.astro, en daar staat ook
   waarom deze regel op 7 september is herschreven: hij noemde drie van de vier
   deuren. */
const description =
  `Beelden voor je productpagina, je feed, allebei tegelijk, of een clip. ` +
  `Kies waar ze heen moeten \u2014 in het formulier wordt nog niets afgeschreven.`;
---

<Layout
  title="Start een bestelling — VISUAILS"
  description={description}
>
  <StartPage lang="nl" />
</Layout>
