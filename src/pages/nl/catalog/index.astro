---
// VISUAILS — /nl/catalog (Nederlands). De pagina-inhoud staat in
// CatalogPage.astro, zodat /catalog en /nl/catalog niet uit elkaar kunnen
// lopen; alleen de meta verschilt hier.
//
// De description noemde één tarief, en dat klopt sinds augustus 2026 niet
// meer: een catalogset zit op een staffel en één bedrag is wat ÉÉN product
// kost. Beide uiteinden staan er nu, en geen van beide mag weg voor de lengte.
// De levertijd is wat wijkt: dat is een tier-feit dat een paar regels verderop
// in de trust-rij herhaald wordt.
import Layout from '../../../layouts/Layout.astro';
import CatalogPage from '../../../components/CatalogPage.astro';
import { euro, ladderRate, ladderFloor, LADDER, vatLabel } from '../../../data/pricing.js';

const FLOOR_FROM = LADDER.catalog[LADDER.catalog.length - 1][0];

const description =
  `Vier foto’s per product — voorkant, achterkant, een stof- of logo-close-up ` +
  `en één on-model shot. ${euro(ladderRate('catalog', 1), 'nl')} per product, ` +
  `${euro(ladderFloor('catalog'), 'nl')} vanaf ${FLOOR_FROM}, ` +
  `${vatLabel('excl', 'nl')}.`;
---

<Layout
  title="Catalogfoto's zonder fotoshoot | VISUAILS"
  description={description}
  ogImage="/img/catalog-after.webp"
>
  <CatalogPage lang="nl" />
</Layout>
