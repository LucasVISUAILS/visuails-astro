---
// VISUAILS — Catalog hub. Ported from the SvelteKit v2 site's /catalog
// +page.svelte. `catalogStyles` data ported verbatim into
// src/data/catalogStyles.js (shared with catalog/[slug].astro) — see that
// file for the full field set; this page only reads name/slug/cardIcon/
// cardWidth/cardPrice/cardDesc off each entry.
import Layout from '../../../layouts/Layout.astro';
import ProductScene from '../../../components/ProductScene.astro';
import Compare from '../../../components/Compare.astro';
import { catalogStyles } from '../../../data/catalogStyles.nl.js';

const faqs = [
  { q: 'Wat krijg ik voor €39,99?', a: 'Een complete set voor één product: vier foto’s — voorkant, achterkant, een close-up van het logo of de stof, en één on-model shot. Dat komt neer op ongeveer €10 per foto.' },
  { q: 'Zit de on-model shot echt inbegrepen?', a: 'Ja — één on-model foto hoort bij elke productset, zonder extra kosten. Kies een model in het bestelformulier, of laat ons er een kiezen die bij je merk past.' },
  { q: 'Hoe snel is de levering?', a: '~24 uur, of je nu vijf producten bestelt of vijfhonderd.' },
  { q: 'Kan ik de achtergrondkleur kiezen?', a: 'Standaard is puur wit (#FFFFFF). Je kunt ook elke hexcode invoeren — een lichte, neutrale kleur werkt het best — toegepast achter elk product dat je opstuurt.' },
  { q: 'Voldoen de visuals aan de eisen van marktplaatsen?', a: 'Ja — uitgesneden en geëxporteerd volgens de gangbare eisen van marktplaatsen. Vertel ons je platform en we passen de specificaties daarop aan.' },
  { q: 'Wat als ik wijzigingen nodig heb?', a: 'Drie revisierondes zijn inbegrepen, zonder extra kosten.' },
];
---

<Layout
  title="Catalog Images — strakke, consistente productvisuals | VISUAILS"
  description="Eén prijs per product: €39,99 voor een complete set van 4 foto's — voorkant, achterkant, een logo-/stof-close-up en één on-model shot. Klaar voor marktplaatsen, high-res, met de hand gecontroleerd en geleverd in ~24 uur."
  ogImage="/img/catalog-after.webp"
>
  <section class="page-hero">
    <div class="container two-col" style="align-items:center">
      <div class="reveal pending">
        <h1 class="display" style="font-size:clamp(2.4rem,5vw,4rem)">Strakke, consistente productvisuals — gebouwd om te schalen.</h1>
        <p class="lead" style="margin-top:1.2rem">Eén product, één prijs: <strong>€39,99</strong> voor een complete set van 4 foto's — voorkant, achterkant, detail en één on-model shot.</p>
        <div class="flex" style="margin-top:1.8rem">
          <span class="magnet-wrap"><span class="magnet-inner"><a href="/nl/order-catalog" class="btn btn-primary btn-lg">Bestel Catalog-visuals</a></span></span>
          <a href="/nl/pricing" class="btn btn-ghost btn-lg">Bekijk prijzen</a>
          <a href="https://wa.me/31625436130?text=Hoi%20VISUAILS%2C%20ik%20wil%20graag%20Catalog-visuals%20bestellen%20voor%20mijn%20producten." class="btn btn-wa" target="_blank" rel="noopener">
            <svg class="i" viewBox="0 0 24 24"><path d="M21 11.5a8.38 8.38 0 0 1-8.5 8.5 8.5 8.5 0 0 1-4-1L3 20l1.5-4.5A8.38 8.38 0 0 1 3.5 11 8.5 8.5 0 0 1 12 3a8.38 8.38 0 0 1 8.5 8.5z"/></svg>WhatsApp <span class="rec-badge">Snelst</span>
          </a>
        </div>
        <div class="trust-row" style="margin-top:2.4rem">
          <span class="trust-item"><strong>€39,99</strong> per product</span>
          <span class="trust-item"><strong>4 foto's</strong> per product</span>
          <span class="trust-item"><strong>~24 uur</strong> levering</span>
        </div>
      </div>
      <div class="reveal pending">
        <ProductScene icon="bottle" width="42%" badge="Catalog-visual, consistent gemaakt" wide />
      </div>
    </div>
  </section>

  <!-- One product = a full 4-photo set. Spelled out so the €39.99 price and
       the included on-model shot are never a surprise. -->
  <section class="section-tight">
    <div class="container">
      <div class="section-head" style="text-align:center;margin-inline:auto">
        <h2>Eén product. Vier foto's. €39,99.</h2>
        <p style="margin-inline:auto">Elk product komt terug als een complete set — inclusief een echte on-model shot, niet alleen flat-lays. Ongeveer €10 per foto.</p>
      </div>
      <div class="pack-row reveal-group" style="margin-top:2rem">
        <div class="pack-card reveal pending">
          <div class="photo-band"><img src="/img/catalog-after.webp" alt="Voorkant-shot van het product voor de catalogus" loading="lazy" /><span class="pack-badge">1 · Voorkant</span></div>
        </div>
        <div class="pack-card reveal pending">
          <div class="photo-band"><img src="/img/catalog-after.webp" alt="Achterkant-shot van het product voor de catalogus" loading="lazy" /><span class="pack-badge">2 · Achterkant</span></div>
        </div>
        <div class="pack-card reveal pending">
          <div class="photo-band"><img src="/img/catalog-before.webp" alt="Detailclose-up van het logo of de stof" loading="lazy" /><span class="pack-badge">3 · Detail</span></div>
        </div>
        <div class="pack-card reveal pending">
          <div class="photo-band"><img src="/img/custom-models-02.webp" alt="On-model shot van het product, gedragen voor pasvorm en schaal" loading="lazy" /><span class="pack-badge">4 · Op een model</span></div>
        </div>
      </div>
      <div class="flex" style="justify-content:center;margin-top:1.8rem">
        <a href="/nl/order-catalog" class="btn btn-primary">Bestel Catalog-visuals · €39,99 / product</a>
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <div class="ed-head">
        <span class="ed-meta">( Waar het past )</span>
        <div>
          <h2>Catalogfotografie: helderheid die de verkoop sluit.</h2>
          <p class="ed-sub">De strakke productpagina’s waar je shop en marktplaatsen op draaien.</p>
        </div>
      </div>
      <div class="svc-explain">
        <div class="svc-explain-main">
          <h3>Wat het is</h3>
          <p>Catalogfotografie is het rechte, strakke productbeeld waar een klant het product op beoordeelt — voorkant, achterkant, een detail-close-up en één on-model shot, allemaal op een consistente achtergrond. Het is er niet om sfeer te maken; het laat precies zien wat iemand koopt, zonder dat er iets geraden wordt.</p>
          <p>Het is ook waar een klein merk stilletjes gevestigd begint te ogen. Als elk product in je assortiment op dezelfde manier is geschoten — zelfde kader, zelfde licht, zelfde kleur — leest de collectie als één doordachte lijn in plaats van een mix van telefoonfoto’s. Die consistentie bouwt vertrouwen, en vertrouwen verhoogt de conversie.</p>
        </div>
        <aside class="svc-explain-side">
          <h3>Waar het leeft</h3>
          <ul class="svc-where-list">
            <li><strong>Je webshop</strong> — de productpagina’s waar mensen beslissen.</li>
            <li><strong>Marktplaatsen</strong> — Bol, Amazon en listings die strakke, consistente shots eisen.</li>
            <li><strong>Shopping-feeds</strong> — Google Shopping en vergelijkingssites.</li>
            <li><strong>Wholesale &amp; linesheets</strong> — waar inkopers het product helder moeten zien.</li>
          </ul>
        </aside>
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <h2 style="margin-bottom:2rem">Kies je Catalog-stijl.</h2>
      <div class="grid grid-2">
        {catalogStyles.map((s) => (
          <div class="card card-hover reveal pending">
            <div class="svc-media">
              <ProductScene icon={s.cardIcon} width={s.cardWidth} badge={`Catalog · ${s.name}`} wide />
            </div>
            <div class="svc-body">
              <h3>{s.name}</h3>
              <span class="svc-price">{s.cardPrice}</span>
              <p>{s.cardDesc}</p>
              <div class="flex" style="margin-top:1.2rem">
                <a href={`/nl/catalog/${s.slug}`} class="btn btn-primary">Ontdek {s.name}</a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <div class="photo-split reveal pending">
        <div class="photo-split-media"><ProductScene icon="jar" width="40%" badge="Eén foto erin, een strakke set eruit" /></div>
        <div>
          <h2>Drie stappen naar een strakke grid.</h2>
          <div class="steps" style="grid-template-columns:1fr;margin-top:1.6rem;gap:1.1rem">
            <div class="step"><span class="step-n">01</span><h3>Upload een foto</h3><p>Wij nemen het daarna over.</p></div>
            <div class="step"><span class="step-n">02</span><h3>Wij maken het consistent</h3><p>Zelfde belichting, hoek, achtergrond — elke keer.</p></div>
            <div class="step"><span class="step-n">03</span><h3>Geleverd in ~24 uur</h3><p>Klaar voor je site, advertenties en social.</p></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container two-col">
      <div class="reveal pending">
        <h2>Alles wat een listing nodig heeft.</h2>
        <ul class="checklist" style="margin-top:1.4rem">
          <li><svg viewBox="0 0 24 24" class="i" style="stroke:var(--success)"><path d="M20 6L9 17l-5-5"/></svg><span>Consistente belichting &amp; hoeken</span></li>
          <li><svg viewBox="0 0 24 24" class="i" style="stroke:var(--success)"><path d="M20 6L9 17l-5-5"/></svg><span>Neutrale of je gekozen achtergrond</span></li>
          <li><svg viewBox="0 0 24 24" class="i" style="stroke:var(--success)"><path d="M20 6L9 17l-5-5"/></svg><span>Uitsnede klaar voor marktplaatsen</span></li>
          <li><svg viewBox="0 0 24 24" class="i" style="stroke:var(--success)"><path d="M20 6L9 17l-5-5"/></svg><span>High-res export</span></li>
          <li><svg viewBox="0 0 24 24" class="i" style="stroke:var(--success)"><path d="M20 6L9 17l-5-5"/></svg><span>~24 uur levering, met de hand gecontroleerd</span></li>
        </ul>
      </div>
      <div class="reveal pending">
        <ProductScene icon="bag" width="40%" badge="Eén kleur, elk product" wide />
        <div class="chip-row" style="margin-top:1.2rem">
          <span class="chip"><span class="dot"></span>Wit — standaard</span>
          <span class="chip"><span class="dot"></span>Aangepaste kleur — elke hexcode</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <div class="section-head" style="text-align:center;margin-inline:auto"><h2>Eén foto erin. Een strakke visual eruit.</h2><p style="margin-inline:auto">Precies de ruwe telefoonfoto die een klant stuurde — en wat er terugkwam.</p></div>
      <div style="max-width:520px;margin:2rem auto 0">
        <Compare
          before="/img/catalog-before.webp"
          after="/img/catalog-after.webp"
          ratio="1/1"
          objectPosition="50% 62%"
          beforeLabel="Jouw foto"
          afterLabel="VISUAILS"
          beforeAlt="Een ruwe telefoonfoto van een t-shirt op een tafel vóór VISUAILS"
          afterAlt="Hetzelfde t-shirt als een strakke Catalog-visual na VISUAILS"
        />
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container two-col">
      <div class="reveal pending">
        <div class="photo-split-media"><img src="/img/catalog-after.webp" alt="Een strakke, voor marktplaatsen klare Catalog-visual van VISUAILS" loading="lazy" /></div>
      </div>
      <div class="reveal pending">
        <h2>Snel betekent niets als het niet klopt.</h2>
        <p class="lead" style="margin-top:1.2rem">Elke visual wordt gegenereerd en daarna door een mens gecontroleerd voordat je hem krijgt — kleur en detail blijven kloppen, niets aan het toeval overgelaten.</p>
        <div class="chip-row" style="margin-top:1.6rem">
          <span class="chip"><span class="dot"></span>Consistente belichting &amp; uitsnede</span>
          <span class="chip"><span class="dot"></span>Klaar voor marktplaatsen</span>
          <span class="chip"><span class="dot"></span>Revisies inbegrepen</span>
        </div>
      </div>
    </div>
  </section>

  <section>
    <div class="container" style="max-width:760px">
      <h2 style="margin-bottom:1.8rem">Catalog-vragen, beantwoord</h2>
      <div class="faq-stack">
        {faqs.map((f) => (
          <details class="faq-item">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <div class="cta-band reveal pending">
        <h2 class="display" style="font-size:clamp(2.2rem,5vw,3.6rem)">Bouw een catalogus die<br>eruitziet als één merk.</h2>
        <p class="lead" style="margin:1.2rem auto 0;text-align:center">€39,99 per product — vier foto's, geleverd in ongeveer een dag.</p>
        <div class="flex" style="justify-content:center;margin-top:2rem">
          <span class="magnet-wrap"><span class="magnet-inner"><a href="/nl/order-catalog" class="btn btn-primary btn-lg">Bestel Catalog-visuals</a></span></span>
          <a href="/nl/pricing" class="btn btn-ghost btn-lg">Bekijk prijzen</a>
          <a href="https://wa.me/31625436130?text=Hoi%20VISUAILS%2C%20ik%20wil%20graag%20Catalog-visuals%20bestellen%20voor%20mijn%20producten." class="btn btn-wa" target="_blank" rel="noopener">
            <svg class="i" viewBox="0 0 24 24"><path d="M21 11.5a8.38 8.38 0 0 1-8.5 8.5 8.5 8.5 0 0 1-4-1L3 20l1.5-4.5A8.38 8.38 0 0 1 3.5 11 8.5 8.5 0 0 1 12 3a8.38 8.38 0 0 1 8.5 8.5z"/></svg>WhatsApp
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .chip-row { display: flex; flex-wrap: wrap; gap: .6rem; }
  .chip { display: inline-flex; align-items: center; gap: .5rem; font-size: .84rem; color: var(--ink-2); background: var(--surface-2); border: 1px solid var(--line); border-radius: var(--r-pill); padding: .45rem .9rem; }
  .chip .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--accent); flex: 0 0 auto; }
  .faq-stack { display: flex; flex-direction: column; gap: .7rem; }
  .faq-item { background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-lg); padding: 1.1rem 1.3rem; }
  .faq-item summary { cursor: pointer; list-style: none; font-weight: 600; color: var(--ink); font-size: .98rem; }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary::after { content: '+'; float: right; color: var(--accent-bright); font-family: var(--font-display); font-size: 1.2rem; }
  .faq-item[open] summary::after { content: '\2212'; }
  .faq-item p { margin-top: .8rem; color: var(--ink-3); font-size: .92rem; line-height: 1.6; }
  .step { position: relative; border-top: 1px solid var(--line-strong); padding-top: 1.1rem; }
  .step .step-n { font-family: var(--font-display); font-weight: 900; font-size: 1rem; color: var(--accent-bright); }
  .step h3 { font-size: 1.05rem; margin: .5rem 0 .3rem; }
  .step p { font-size: .9rem; color: var(--ink-3); }

  /* The 4-photo product set. Four tiles on desktop, 2×2 on phones. */
  .pack-row { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; }
  @media (max-width: 720px) { .pack-row { grid-template-columns: 1fr 1fr; } }
  .pack-card .photo-band { position: relative; aspect-ratio: 3 / 4; border-radius: var(--r-lg); overflow: hidden; border: 1px solid var(--line); }
  .pack-card .photo-band img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .pack-badge { position: absolute; left: 10px; bottom: 10px; padding: .35rem .7rem; border-radius: var(--r-pill); background: rgba(13,13,20,.72); backdrop-filter: blur(8px); color: #fff; font-size: .78rem; font-weight: 600; }
</style>
