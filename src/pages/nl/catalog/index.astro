---
// VISUAILS — /nl/catalog (Nederlands). De pagina-inhoud staat in
// CatalogPage.astro, zodat /catalog en /nl/catalog niet uit elkaar kunnen
// lopen; alleen de meta verschilt hier.
import Layout from '../../../layouts/Layout.astro';
import CatalogPage from '../../../components/CatalogPage.astro';
import { perProduct, turnaround } from '../../../data/pricing.js';

const item = perProduct('catalog', 'nl');

const description =
  `${item.price} per product: vier foto’s — voorkant, achterkant, een stof- of ` +
  `logo-close-up en één on-model shot. ${turnaround('unattended', 'nl')}.`;
---

<Layout
  title="Catalogfoto's zonder fotoshoot | VISUAILS"
  description={description}
  ogImage="/img/catalog-after.webp"
>
  <CatalogPage lang="nl" />
</Layout>
