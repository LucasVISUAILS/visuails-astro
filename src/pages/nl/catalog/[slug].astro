---
// VISUAILS — /nl/catalog/[slug]. Zie de Engelse variant en de kop van
// CatalogStyleDetail.astro; hier verschillen alleen de meta en de databron.
import Layout from '../../../layouts/Layout.astro';
import CatalogStyleDetail from '../../../components/CatalogStyleDetail.astro';
import { catalogStyles } from '../../../data/catalogStyles.nl.js';
import { reviewClaim, turnaround } from '../../../data/pricing.js';
import { metaDescription } from '../../../data/meta.js';

export function getStaticPaths() {
  return catalogStyles.map((s) => ({ params: { slug: s.slug }, props: { style: s } }));
}

const { style } = Astro.props;

const zusters = catalogStyles
  .filter((s) => s.slug !== style.slug)
  .map((s) => ({ href: `/catalog/${s.slug}`, naam: s.name }));

const TIMING = style.priceTrust ? 'Eerst het ontwerp, daarna de gewone doorlooptijd per bestelling.' : turnaround('unattended', 'nl');
const REVIEW = reviewClaim('unattended', 'nl');
---

<Layout
  title={`${style.name} — Catalog-stijl | VISUAILS`}
  description={metaDescription([
    `${style.name}: een kenmerkende catalogstijl van VISUAILS`,
    style.metaPrice,
    TIMING,
    REVIEW,
  ])}
>
  <CatalogStyleDetail lang="nl" style={style} zusters={zusters} />
</Layout>
