---
// VISUAILS — bestel-hub (Nederlands). Vertaling van src/pages/order/index.astro.
import Layout from '../../../layouts/Layout.astro';
import ProductScene from '../../../components/ProductScene.astro';

const tiles = [
  { href: '/nl/order-catalog', icon: 'bottle', photo: null, name: 'Catalog', body: 'Een volledige set van 4 foto’s per product — voorkant, achterkant, detail en on-model. €39,99 per product.', cta: 'Vraag catalog aan' },
  { href: '/nl/order-lifestyle', icon: 'jar', photo: '/img/lifestyle-glow-05.webp', name: 'Lifestyle', body: 'Drie foto’s in één gestylde look — een kant-en-klare carousel. €59,99 / product.', cta: 'Bestel lifestyle' },
  { href: '/nl/order-video', icon: 'sneaker', photo: null, name: 'Video', body: 'Standaard productvideo’s vanaf €49. Grotere campagnes op offerte.', cta: 'Bestel een video' },
  { href: '/nl/order-custom', icon: 'bag', photo: '/img/custom-models-02.webp', name: 'Custom styling', body: 'Je eigen look, model of concept — samen geregeld via WhatsApp.', cta: 'Bespreek custom' },
];
---

<Layout
  title="Plaats je bestelling — VISUAILS"
  description="Bestel catalog-, lifestyle- of videovisuals bij VISUAILS — of regel custom styling. Catalog is €39,99 per product (4 foto’s), lifestyle €59,99, geleverd in ongeveer 24 uur, elk resultaat met de hand gecontroleerd. Liever overleggen? Bestel via WhatsApp."
>
  <!-- HERO -->
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow-page">Bestellen</span>
      <h1 class="display" style="font-size:clamp(2.4rem,5vw,4rem)">Plaats je bestelling</h1>
      <p class="lead" style="margin-top:1.2rem">Vertel ons wat we maken — wij regelen het van idee tot afgewerkt bestand. Liever even overleggen? WhatsApp kan altijd.</p>
      <div class="flex" style="margin-top:1.8rem">
        <a href="https://wa.me/31625436130?text=Hi%20VISUAILS%2C%20ik%20wil%20graag%20een%20bestelling%20plaatsen." class="btn btn-wa btn-lg" target="_blank" rel="noopener">
          <svg class="i" viewBox="0 0 24 24"><path d="M21 11.5a8.38 8.38 0 0 1-8.5 8.5 8.5 8.5 0 0 1-4-1L3 20l1.5-4.5A8.38 8.38 0 0 1 3.5 11 8.5 8.5 0 0 1 12 3a8.38 8.38 0 0 1 8.5 8.5z"/></svg>
          Bestel via WhatsApp <span class="rec-badge">Snelst</span>
        </a>
      </div>
      <ul class="hero-benefits">
        <li>Jij keurt goed vóór de definitieve levering</li>
        <li>Revisierondes inbegrepen tot het klopt</li>
        <li>Levering in ~24 uur</li>
      </ul>
    </div>
  </section>

  <!-- HUB -->
  <section class="section-tight">
    <div class="container">
      <div class="section-head">
        <h2>Wat zullen we voor je <em>maken?</em></h2>
        <p>Kies een dienst en geef het uit handen — concept, productie en afwerking zijn aan ons. Per bestelling, geen abonnement.</p>
      </div>
      <div class="hub-grid reveal-group">
        {tiles.map((t) => (
          <a href={t.href} class="card card-hover reveal pending" style="display:block">
            <div class="hub-media">
              {t.photo ? (
                <div class="hub-photo"><img src={t.photo} alt={`${t.name} voorbeeld`} loading="lazy" /></div>
              ) : (
                <ProductScene icon={t.icon} width="44%" wide />
              )}
            </div>
            <h3>{t.name}</h3>
            <p style="margin-top:.4rem;font-size:.95rem;color:var(--ink-3)">{t.body}</p>
            <span class="link-arrow" style="margin-top:.8rem">{t.cta} <svg viewBox="0 0 24 24" class="i"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA BAND -->
  <section class="section-tight">
    <div class="container">
      <div class="cta-band reveal pending">
        <h2 class="display" style="font-size:clamp(2.2rem,5vw,3.6rem)">Weet je niet welke past?</h2>
        <p class="lead" style="margin:1.2rem auto 0;text-align:center">Stuur ons je product en wat je zoekt — we wijzen je de juiste optie.</p>
        <div class="flex" style="justify-content:center;margin-top:2rem">
          <a href="/nl/test-sample" class="btn btn-ghost btn-lg">Probeer eerst een proefvisual</a>
          <a href="https://wa.me/31625436130?text=Hi%20VISUAILS%2C%20ik%20weet%20niet%20welke%20optie%20past%20%E2%80%94%20kunnen%20jullie%20helpen%3F" class="btn btn-wa btn-lg" target="_blank" rel="noopener">
            <svg class="i" viewBox="0 0 24 24"><path d="M21 11.5a8.38 8.38 0 0 1-8.5 8.5 8.5 8.5 0 0 1-4-1L3 20l1.5-4.5A8.38 8.38 0 0 1 3.5 11 8.5 8.5 0 0 1 12 3a8.38 8.38 0 0 1 8.5 8.5z"/></svg>
            Vraag het op WhatsApp <span class="rec-badge">Snelst</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .hub-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: clamp(1rem, 2vw, 1.5rem); }
  .hub-media { margin-bottom: 1rem; }
  .hub-photo { border-radius: var(--r-media); overflow: hidden; aspect-ratio: 4/3; }
  .hub-photo img { width: 100%; height: 100%; object-fit: cover; display: block; }
</style>
