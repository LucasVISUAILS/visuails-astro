---
// VISUAILS — /nl/demo. Zie de Engelse variant: alleen de meta verschilt.
import Layout from '../../layouts/Layout.astro';
import FigWalk from '../../components/FigWalk.astro';
import { WALK_COPY } from '../../data/demo.js';
const c = WALK_COPY.nl;
---
<Layout
  title="Zo werkt een bestelling — VISUAILS"
  description="Kies een dienst en scroll. Eén bestelling, van de telefoonfoto die je stuurt tot de bestanden die terugkomen — catalog, lifestyle of video, ieder apart."
  lang="nl"
>
  <section class="section-tight"><div class="container">
    <div class="walk-head">
      <h1 class="display">{c.title}</h1>
      <p class="lead">{c.lede}</p>
    </div>
    <FigWalk lang="nl" />
  </div></section>
</Layout>

<style>
  .walk-head { max-width: 52rem; margin: 0 auto clamp(2.4rem, 5vw, 4rem); text-align: center; }
  /* Was een eigen clamp en daarmee de vierde paginatitelmaat op de site
     (54px op 1440, naast 96 · 64 · 51). Deze kop staat boven een figuur en
     is er het bijschrift van, dus hij hoort in het kleinere register — dat
     is precies wat --t-page-h1-sm is. Zie de noot bij dat token. */
  .walk-head .display { font-size: var(--t-page-h1-sm); }
  .walk-head .lead { margin: 1.2rem auto 0; max-width: 60ch; }
</style>
