import JuridischHal from '../../components/JuridischHal.astro';
// VISUAILS — Cookiebeleid (Nederlands). Vertaling van src/pages/cookie-policy.astro.
// De levensduren komen uit src/data/cookies.js — zie de noot in dat bestand en in
// de Engelse versie van deze pagina.
import { SESSION_COOKIE_DAYS, PREFERENCE_COOKIE_DAYS, cookieDuur, CONCEPT_SLEUTEL, CONCEPT_DAGEN, MELDING_SLEUTEL, PROEF_WEG_DAGEN, TIPS_SLEUTEL, TIPS_COOKIE, INGELOGD_COOKIE } from '../../data/cookies.js';
// 8 oktober 2026 (o12): zie de noot "WAT ER BIJ KWAM" in de Engelse versie.
// ── WAT HIER NIET MEER STAAT — 24 augustus 2026 ─────────────────────────────
// De regel over `vis_admin` is eruit. Zie de noot in de Engelse versie van deze
