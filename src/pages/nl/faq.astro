---
// VISUAILS — /nl/faq (Nederlands). De pagina-inhoud staat in FaqPage.astro,
// zodat /faq en /nl/faq niet uit elkaar kunnen lopen; alleen de meta verschilt
// hier.
import Layout from '../../layouts/Layout.astro';
import FaqPage from '../../components/FaqPage.astro';
import { AMOUNT, euro, FULL_DROP_MIN, FULL_DROP_MAX } from '../../data/pricing.js';

const description =
  `Wat een drop is, wat die kost (${euro(AMOUNT.fullDrop, 'nl')} voor ` +
  `${FULL_DROP_MIN}–${FULL_DROP_MAX} producten), hoe de agenda werkt, ` +
  `wat als iets niet klopt, rechten en betaling — helder beantwoord.`;
---

<Layout title="Veelgestelde vragen — VISUAILS" description={description}>
  <FaqPage lang="nl" />
</Layout>
