---
// VISUAILS — /nl/faq (Nederlands). De pagina-inhoud staat in FaqPage.astro,
// zodat /faq en /nl/faq niet uit elkaar kunnen lopen; alleen de meta verschilt
// hier.
import Layout from '../../layouts/Layout.astro';
import FaqPage from '../../components/FaqPage.astro';
import { euro, ladderRate, ladderFloor, LADDER, vatLabel } from '../../data/pricing.js';

// De band en de pakketprijs zijn samen met het pakket verdwenen. Wat ervoor in
// de plaats komt zijn de twee uiteinden van de staffel — elk aantal ertussen
// heeft nu een prijs.
const FLOOR_FROM = LADDER.complete[LADDER.complete.length - 1][0];

const description =
  `Wat een bestelling kost (${euro(ladderRate('complete', 1), 'nl')} per product, ` +
  `${euro(ladderFloor('complete'), 'nl')} vanaf ${FLOOR_FROM}, ` +
  `${vatLabel('excl', 'nl')}), hoe de agenda werkt, rechten en betaling — ` +
  `helder beantwoord.`;
---

<Layout title="Veelgestelde vragen — VISUAILS" description={description}>
  <FaqPage lang="nl" />
</Layout>
