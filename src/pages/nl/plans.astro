---
// VISUAILS — /nl/plans (Nederlands). De pagina-inhoud staat in PlansPage.astro,
// zodat /plans en /nl/plans niet uit elkaar kunnen lopen; alleen de meta
// verschilt hier.
import Layout from '../../layouts/Layout.astro';
import PlansPage from '../../components/PlansPage.astro';
import { euro, PLAN_AMOUNT, PLAN_CREDITS, vatLabel } from '../../data/pricing.js';

const CHEAPEST = Object.keys(PLAN_AMOUNT).reduce((a, b) => (PLAN_AMOUNT[b] < PLAN_AMOUNT[a] ? b : a));

const description =
  `Elke maand credits voor catalog, lifestyle en video. Vanaf ` +
  `${euro(PLAN_AMOUNT[CHEAPEST], 'nl')} per maand voor ${PLAN_CREDITS[CHEAPEST]} credits, ` +
  `of stel je eigen abonnement samen. ${vatLabel('excl', 'nl')}.`;
---

<Layout title="Abonnementen — elke maand credits | VISUAILS" description={description}>
  <PlansPage lang="nl" />
</Layout>
