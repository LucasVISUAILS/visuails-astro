---
import { waHref } from '../../data/whatsapp.js';
// VISUAILS — thank-you / confirmation page. Ported from the SvelteKit
// thank-you page (itself ported from static /thank-you.html).
//
// Every form on the site POSTs to /api/order, and /api/order redirects the
// no-JS path here on success. The forms that land here today are /start's
// pipeline, /test-sample, /contact and the homepage lead form. Three of the
// four named in the original version of this comment — order-catalog,
// order-lifestyle, order-video — were deleted in section 10 and now 301 to
// /start (see public/_redirects).
//
// This page reads no query string of its own. The one parameter /api/order
// ever appends is `ref`, and interactions.js reads that client-side to fill
// #ty-summary. Nothing here needs Astro.url.searchParams.
import Layout from '../../layouts/Layout.astro';
import { TIERS, turnaround } from '../../data/pricing.js';
import { mailNote } from '../../data/mailNote.js';

// Elk formulier op de site komt hier uit en het zijn allemaal losse-product-
// bestellingen, dus de doorlooptijd op deze pagina is die van Tier 0. Er stond
// op drie plekken "ongeveer 24 uur" — meta-omschrijving, hero-lead en de
// doorlooptijdkaart — geen daarvan goedgekeurd door de capaciteitspoort. De
// hero noemt nu helemaal geen duur meer; één kaart noemt hem één keer, afgeleid.
// De wachtrijregel staat er bewust bij: stap 13 wil dat verschil zichtbaar.
const T0 = TIERS.unattended;
const TIMING = turnaround('unattended', 'nl');

const description =
  `Je aanvraag is ontvangen. We bevestigen per e-mail of WhatsApp, en je ` +
  `visuals volgen uit de normale doorlooptijd — ${TIMING.toLowerCase()}.`;
---

<Layout
  title="Bedankt — VISUAILS"
  description={description}
  noindex
>
  <section class="page-hero"><div class="container" style="max-width:720px;text-align:center;margin-inline:auto">
    <span class="eyebrow-page">Aanvraag ontvangen</span>
    <h1 class="display" style="font-size:clamp(2.4rem,5vw,4rem)">Bedankt — we hebben je aanvraag ontvangen.</h1>
    <p class="lead" style="margin:1.2rem auto 0">We bevestigen de details per e-mail — meestal sneller via WhatsApp.</p>
    {/* DE BETALING, EN WAAROM DIE HIER STAAT — 7 augustus 2026.
        Lucas: *"in de thank you page staat nergens dat je de betaling dient te
        voltooien in de bevestigingsmail. Daarna kan het orderproces pas gestart
        worden."* Klopte: deze pagina zei "aanvraag ontvangen" en de kaart
        eronder beloofde dat we je visuals gingen klaarmaken — terwijl er bij
        een betaalde bestelling nog niets begint.

        VOORWAARDELIJK GEFORMULEERD, want op deze pagina komt ook de
        contactvraag, de gratis checklist en de video-aanvraag uit, en die
        hebben geen betaallink. De zin is daarom waar in alle gevallen: staat er
        een link in je mail, dan is dát de volgende stap; staat hij er niet, dan
        lees je hem als niet van toepassing. Dit is een statische pagina zonder
        toegang tot de bestelling, dus dit is de eerlijkste vorm die geen
        JavaScript nodig heeft om te kloppen. */}
    <p class="ty-pay"><strong>Staat er een betaallink in je bevestigingsmail?</strong> Rond die betaling af — je bestelling is genoteerd, maar we beginnen pas met produceren zodra de betaling binnen is.</p>
    {/* Zie de EN-pagina: één zin, uit src/data/mailNote.js. */}
    <p class="mail-note">{mailNote('nl')}</p>
    <!-- Filled client-side with the order reference /api/order redirected here
         with (initThankYou in interactions.js). Ships hidden and stays hidden
         unless there is a valid reference to show — a visitor who reaches this
         page any other way simply doesn't get a summary box. -->
    <div class="card ty-summary" id="ty-summary" style="display:none;text-align:left;margin:2rem auto 0;max-width:520px"></div>
    <div class="source-ask" data-source-ask>
      <span class="source-q">Nog één ding — hoe kwam je bij ons terecht?</span>
      <div class="source-btns">
        <button type="button" class="source-btn" data-source="Instagram">Instagram</button>
        <button type="button" class="source-btn" data-source="Google">Google</button>
        <button type="button" class="source-btn" data-source="Referral">Via iemand</button>
        <button type="button" class="source-btn" data-source="Other">Ergens anders</button>
      </div>
    </div>
    {/* De weg naar binnen, op de pagina waar ze toch al zijn — zie de EN-pagina
        voor de volledige noot. Kort: na een bestelling is de eerstvolgende
        vraag "waar is hij", niet "wat had ik moeten uploaden", dus dit is nu de
        eerste knop. De regel eronder staat er omdat niemand op dit moment is
        ingelogd, en een knop die stilzwijgend een tweede stap nodig heeft leest
        als een kapotte knop. */}
    <div class="flex" style="justify-content:center;margin-top:2rem">
      <a href="/account" class="btn btn-primary btn-lg">Bekijk je bestelling</a>
      <a href="/nl/upload-guidelines" class="btn btn-ghost btn-lg">Lees de uploadrichtlijnen</a>
      <a href={waHref("Hoi VISUAILS, ik heb zojuist een aanvraag via de site verstuurd.")} class="btn btn-wa" target="_blank" rel="noopener">
        Stuur ons een bericht op WhatsApp
      </a>
    </div>
    <p class="ty-signin">Je logt in met het e-mailadres van deze bestelling — we sturen je een link, een wachtwoord heb je niet nodig.</p>
  </div></section>

  <section class="section-tight"><div class="container">
    <div class="grid grid-3 reveal-group">
      <div class="card reveal pending"><h2 class="as-card-h">Wat er nu gebeurt</h2><p style="margin-top:.5rem;font-size:.95rem;color:var(--ink-3)">Zodra de betaling binnen is, lezen we wat je hebt gestuurd, maken we je beelden klaar, en controleert een persoon elk resultaat met de hand voordat het bij jou aankomt.</p></div>
      <div class="card reveal pending"><h2 class="as-card-h">Gebruikelijke doorlooptijd</h2><p style="margin-top:.5rem;font-size:.95rem;color:var(--ink-3)">{TIMING} vanaf het moment dat we je foto’s en je notitie hebben tot je downloadlink. {T0.queue.nl}; een gloednieuwe custom stijl kan iets langer duren.</p></div>
      <div class="card reveal pending"><h2 class="as-card-h">Wil je nog iets toevoegen?</h2><p style="margin-top:.5rem;font-size:.95rem;color:var(--ink-3)">Reageer op ons bericht op WhatsApp of mail <a href="mailto:hello@visuails.com" style="color:var(--accent-bright)">hello@visuails.com</a> met eventuele extra details of referenties.</p></div>
    </div>
    <div class="card reveal pending ty-upsell">
      <div>
        <h2 class="as-card-h">Wil je de details garanderen?</h2>
        <p style="margin-top:.4rem;font-size:.95rem;color:var(--ink-3)">Hoe meer hoeken we hebben, hoe nauwkeuriger we pasvorm, kleur en detail meteen goed krijgen. Stuur een close-up van een detail, een foto van de stof en een foto op het lichaam. Toevoegen kost niets en het hele resultaat wordt er beter van.</p>
      </div>
      <a href={waHref("Hoi VISUAILS, ik wil graag extra foto’s voor mijn bestelling sturen.")} class="btn btn-wa" target="_blank" rel="noopener" data-track="ty-extra-photos">
        Stuur extra foto’s
      </a>
    </div>
  </div></section>
</Layout>

<style>
  /* De betaalregel. Groene rand links en linksuitgelijnd binnen een verder
     gecentreerde kop: gecentreerde tekst leest als sfeer, en dit is de enige
     zin op deze pagina waar iets van de lezer gevraagd wordt. */
  .ty-pay {
    max-width: 520px; margin: 1.4rem auto 0; padding: .85rem 1rem;
    text-align: left; font-size: .95rem; line-height: 1.6; color: var(--ink-2);
    background: var(--paper-lift, rgb(255 255 255 / .03));
    border-left: 3px solid var(--accent);
  }
  .ty-pay strong { color: var(--ink); }
  .ty-signin { margin: .9rem auto 0; max-width: 520px; font-size: .85rem; color: var(--ink-3); }
  /* De spamregel staat direct onder de betaalregel; twee blokken onder elkaar
     met verschillende breedtes lezen als twee losse dingen. Eén kolom. */
  .mail-note { max-width: 520px; margin-inline: auto; }

  /* Was `.ty-summary h4`. Die kop is een h2 geworden (het kopniveau sprong van h1
   naar h4); de selector moest mee, anders viel deze verkleining stil weg en werd
   de kop 17px in plaats van 16px. Eén pixel, en precies het soort restje dat een
   tagwijziging achterlaat. */
  .ty-summary .as-card-h { font-size: 1rem; color: var(--ink); }
  /* .ty-dl / .ty-row / .ty-swatch / .ty-hex were removed in section 10. They
     styled a definition list of the submitted answers that initThankYou() built
     by reading the form fields back out of the query string — which only worked
     while the order forms were GET forms. Every form on the site POSTs to
     /api/order now, and the one parameter it puts on this URL is `ref`, so the
     box holds a reference and two lines of prose. Nothing here emits a <dl>. */
  .source-ask { margin: 1.8rem auto 0; max-width: 520px; }
  .source-q { display: block; font-size: .9rem; color: var(--ink-3); margin-bottom: .7rem; }
  .source-btns { display: flex; flex-wrap: wrap; gap: .5rem; justify-content: center; }
  .source-btn { padding: .5rem 1rem; border: 1px solid var(--line-strong); background: none; color: var(--ink-2); font-size: .88rem; font-weight: 500; cursor: pointer; font-family: var(--font-body); transition: border-color var(--dur-1) var(--ease), background var(--dur-1) var(--ease), color var(--dur-1) var(--ease); }
  .source-btn:hover { border-color: var(--accent); background: var(--accent-soft); color: var(--ink); }
  /* This confirmed a "how did you hear about us?" answer in a green that came
     from the deleted --success token. There is no success green in the system,
     and a one-line acknowledgement does not need one: the state change from a
     row of buttons to a single settled line is already the feedback. */
  .source-done { font-size: .95rem; color: var(--ink); font-weight: 600; margin: 0; }
  .ty-upsell { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; flex-wrap: wrap; margin-top: 1.2rem; border-color: var(--accent-line); }
  .ty-upsell .btn { flex: 0 0 auto; }
  @media (max-width: 560px) { .ty-upsell .btn { width: 100%; } }
</style>
