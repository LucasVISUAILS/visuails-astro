---
// VISUAILS — thank-you / confirmation page. Ported from the SvelteKit
// thank-you page (itself ported from static /thank-you.html). Every
// order and sample-request form on the site lands here (order-catalog,
// order-lifestyle, order-video, test-sample) — this page itself doesn't
// read the query string, matching the static source, which also just
// showed a fixed confirmation regardless of what was submitted. No
// Astro.url.searchParams logic is needed as a result.
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Bedankt — VISUAILS"
  description="Je aanvraag is ontvangen. We nemen binnen ongeveer 24 uur contact met je op, sneller via WhatsApp."
>
  <section class="page-hero"><div class="container" style="max-width:720px;text-align:center;margin-inline:auto">
    <span class="eyebrow-page">Aanvraag ontvangen</span>
    <h1 class="display" style="font-size:clamp(2.4rem,5vw,4rem)">Bedankt — we hebben je aanvraag ontvangen.</h1>
    <p class="lead" style="margin:1.2rem auto 0">We nemen binnen ongeveer 24 uur contact met je op — meestal sneller via WhatsApp.</p>
    <!-- Filled client-side from the submitted query string (initThankYou in
         interactions.js). Hidden automatically when there's nothing to show. -->
    <div class="card ty-summary" id="ty-summary" style="display:none;text-align:left;margin:2rem auto 0;max-width:520px"></div>
    <div class="source-ask" data-source-ask>
      <span class="source-q">Nog één ding — hoe kwam je bij ons terecht?</span>
      <div class="source-btns">
        <button type="button" class="source-btn" data-source="Instagram">Instagram</button>
        <button type="button" class="source-btn" data-source="Google">Google</button>
        <button type="button" class="source-btn" data-source="Referral">Via iemand</button>
        <button type="button" class="source-btn" data-source="Other">Ergens anders</button>
      </div>
    </div>
    <div class="flex" style="justify-content:center;margin-top:2rem">
      <a href="/nl/upload-guidelines" class="btn btn-primary btn-lg">Lees de uploadrichtlijnen</a>
      <a href="/nl" class="btn btn-ghost btn-lg">Terug naar home</a>
      <a href="https://wa.me/31625436130?text=Hi%20VISUAILS%2C%20ik%20heb%20zojuist%20een%20aanvraag%20via%20de%20site%20verstuurd." class="btn btn-wa" target="_blank" rel="noopener">
        <svg class="i" viewBox="0 0 24 24"><path d="M21 11.5a8.38 8.38 0 0 1-8.5 8.5 8.5 8.5 0 0 1-4-1L3 20l1.5-4.5A8.38 8.38 0 0 1 3.5 11 8.5 8.5 0 0 1 12 3a8.38 8.38 0 0 1 8.5 8.5z" /></svg>
        Stuur ons een bericht op WhatsApp
      </a>
    </div>
  </div></section>

  <section class="section-tight"><div class="container">
    <div class="grid grid-3 reveal-group">
      <div class="card reveal pending"><h4>Wat er nu gebeurt</h4><p style="margin-top:.5rem;font-size:.95rem;color:var(--ink-3)">We bekijken je briefing, maken je visuals klaar, en een persoon controleert elk resultaat met de hand voordat het je bereikt.</p></div>
      <div class="card reveal pending"><h4>Gebruikelijke doorlooptijd</h4><p style="margin-top:.5rem;font-size:.95rem;color:var(--ink-3)">Ongeveer 24 uur van briefing tot downloadlink — iets langer voor een gloednieuwe custom stijl.</p></div>
      <div class="card reveal pending"><h4>Wil je nog iets toevoegen?</h4><p style="margin-top:.5rem;font-size:.95rem;color:var(--ink-3)">Reageer op ons bericht op WhatsApp of mail <a href="mailto:hello@visuails.com" style="color:var(--accent-bright)">hello@visuails.com</a> met eventuele extra details of referenties.</p></div>
    </div>
    <div class="card reveal pending ty-upsell">
      <div>
        <h4>Wil je de details garanderen?</h4>
        <p style="margin-top:.4rem;font-size:.95rem;color:var(--ink-3)">Hoe meer hoeken we hebben, hoe meer we garanderen dat pasvorm, kleur en detail meteen goed uitkomen. Stuur een detail-close-up, de stof en een on-body shot — gratis toe te voegen en het tilt het hele resultaat op.</p>
      </div>
      <a href="https://wa.me/31625436130?text=Hi%20VISUAILS%2C%20ik%20wil%20graag%20extra%20foto%27s%20voor%20mijn%20bestelling%20sturen." class="btn btn-wa" target="_blank" rel="noopener" data-track="ty-extra-photos">
        <svg class="i" viewBox="0 0 24 24"><path d="M21 11.5a8.38 8.38 0 0 1-8.5 8.5 8.5 8.5 0 0 1-4-1L3 20l1.5-4.5A8.38 8.38 0 0 1 3.5 11 8.5 8.5 0 0 1 12 3a8.38 8.38 0 0 1 8.5 8.5z" /></svg>
        Stuur extra foto’s
      </a>
    </div>
  </div></section>
</Layout>

<style>
  .ty-summary h4 { font-size: 1rem; color: var(--ink); }
  .ty-dl { display: flex; flex-direction: column; gap: 0; margin: 0; }
  .ty-row { display: flex; justify-content: space-between; gap: 1.2rem; padding: .7rem 0; box-shadow: inset 0 -1px 0 var(--line); }
  .ty-row:last-child { box-shadow: none; }
  .ty-row dt { color: var(--ink-3); font-size: .88rem; flex: 0 0 auto; }
  .ty-row dd { color: var(--ink); font-size: .92rem; font-weight: 500; margin: 0; text-align: right; word-break: break-word; }
  .ty-swatch { display: inline-block; width: 12px; height: 12px; border-radius: 3px; border: 1px solid var(--line-strong); vertical-align: middle; margin: 0 .35rem 0 .1rem; }
  .ty-hex { color: var(--ink-3); font-size: .82rem; font-weight: 400; letter-spacing: .02em; }
  .source-ask { margin: 1.8rem auto 0; max-width: 520px; }
  .source-q { display: block; font-size: .9rem; color: var(--ink-3); margin-bottom: .7rem; }
  .source-btns { display: flex; flex-wrap: wrap; gap: .5rem; justify-content: center; }
  .source-btn { padding: .5rem 1rem; border-radius: var(--r-pill); border: 1px solid var(--line-strong); background: none; color: var(--ink-2); font-size: .88rem; font-weight: 500; cursor: pointer; font-family: var(--font-body); transition: border-color .2s var(--ease), background .2s var(--ease), color .2s var(--ease); }
  .source-btn:hover { border-color: var(--accent); background: var(--accent-soft); color: var(--ink); }
  .source-done { font-size: .95rem; color: var(--success, #4AD07F); font-weight: 500; margin: 0; }
  .ty-upsell { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; flex-wrap: wrap; margin-top: 1.2rem; border-color: var(--accent-line); }
  .ty-upsell .btn { flex: 0 0 auto; }
  @media (max-width: 560px) { .ty-upsell .btn { width: 100%; } }
</style>
