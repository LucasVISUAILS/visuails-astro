---
// VISUAILS — Gidsen-hub (Nederlands). Vertaling van src/pages/guides.astro.
import Layout from '../../layouts/Layout.astro';
import {
  euro, AMOUNT, ladderRate, ladderFloor, LADDER, vatLabel, TEST_SAMPLE,
} from '../../data/pricing.js';

// De prijzenkaart typte alle drie de per-productbedragen met de hand — inclusief
// een "video vanaf €49" die de herprijzing al had ingetrokken — en de proceskaart
// beloofde een afgewerkte visual terug "in ongeveer 24 uur". Beide zijn feiten
// uit pricing.js; hier uitgetypt overleeft een kaart elke prijswijziging.
//
// Twee van de drie bedragen zijn sinds augustus 2026 geen enkel bedrag meer:
// foto’s zitten op een staffel die daalt met het aantal. Een clip staat daar
// niet op — dat is één vast tarief, los of binnen een bestelling — dus die
// houdt zijn ene bedrag, en de kaart zegt welk van de twee soorten het is.
const CAT_ENTRY = euro(ladderRate('catalog', 1), 'nl');
const CAT_FLOOR = euro(ladderFloor('catalog'), 'nl');
const LIFE_ENTRY = euro(ladderRate('lifestyle', 1), 'nl');
// De vloer van lifestyle is NIET dezelfde als die van catalog. Hier stond
// CAT_FLOOR voor beide, met "en lager" erachter — dus las de pagina dat
// lifestyle tot €33 zou dalen terwijl hij op €41 eindigt, en dat er nog iets
// onder zat. Twee onwaarheden in één zin over prijzen. 8 augustus 2026.
const LIFE_FLOOR = euro(ladderFloor('lifestyle'), 'nl');
const VID = euro(AMOUNT.video, 'nl');
const FLOOR_FROM = LADDER.catalog[LADDER.catalog.length - 1][0];
const SAMPLE = TEST_SAMPLE.nl;

const guides = [
  { title: 'Zo fotografeer je je product met je telefoon', desc: 'De vier hoeken, het licht, de achtergrond — alles wat een telefoonfoto omzet in een campagneklaar resultaat. Het nuttigste om te lezen voordat je bestelt.', href: '/nl/upload-guidelines', tag: 'Checklist' },
  { title: 'Van foto naar publicatie — hoe het werkt', desc: 'Wat er precies gebeurt tussen het sturen van één foto en het terugkrijgen van een afgewerkte, met de hand gecontroleerde visual.', href: '/nl/how-it-works', tag: 'Proces' },
  { title: 'AI-tools vs een done-for-you studio', desc: 'Wanneer een AI-tool die je zelf bedient echt genoeg is — en waar hij je stilletjes uren kost aan overdoen en kleur die niet bij je merk past.', href: '/nl/compare', tag: 'Vergelijk' },
  { title: 'Wat productvisuals echt kosten', desc: `Catalog vanaf ${CAT_ENTRY} per set van vier foto’s en lifestyle vanaf ${LIFE_ENTRY}, dalend tot ${CAT_FLOOR} en ${LIFE_FLOOR} vanaf ${FLOOR_FROM} producten; video een vaste ${VID} per clip. Alles ${vatLabel('excl', 'nl')}.`, href: '/nl/pricing', tag: 'Prijzen' },
  { title: 'Vragen, beantwoord', desc: 'Betaling, btw, modellen, levering, wat als iets niet klopt — de praktische dingen die merken vragen vóór hun eerste bestelling.', href: '/nl/faq', tag: 'FAQ' },
];
---

<Layout
  title="Gidsen — productfotografie voor kledingmerken | VISUAILS"
  description="Praktische gidsen voor kleding- en e-commercemerken: fotograferen met een telefoon, AI-visuals tegenover een shoot, en wat productvisuals kosten."
>
  <section class="page-hero"><div class="container">
    <p class="eyebrow-page">Gidsen</p>
    <h1 class="display" style="font-size:clamp(2.4rem,5vw,4rem)">Alles wat de moeite waard is <em>vóór je shoot.</em></h1>
    <p class="lead" style="margin-top:1.2rem;max-width:60ch">Korte, praktische reads voor ondernemers die hun productvisuals goed willen hebben — of je nu bij ons bestelt of niet.</p>
  </div></section>

  <section class="section-tight"><div class="container">
    <div class="guide-grid reveal-group">
      {guides.map((g) => (
        <a class="guide-card reveal pending" href={g.href}>
          <span class="guide-tag">{g.tag}</span>
          <h2 class="guide-title">{g.title}</h2>
          <p class="guide-desc">{g.desc}</p>
          <span class="guide-more">Lees <svg viewBox="0 0 24 24" class="i"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
        </a>
      ))}
    </div>
  </div></section>

  <section class="section-tight"><div class="container">
    <div class="cta-band reveal pending">
      <h2 class="display" style="font-size:clamp(2.2rem,5vw,3.6rem)">Klaar wanneer jij dat bent.</h2>
      <div class="flex" style="justify-content:center;margin-top:2rem">
        <a href="/nl/test-sample" class="btn btn-primary btn-lg">Probeer een proefvisual van {SAMPLE.price}</a>
        <a href="/nl/start" class="btn btn-ghost btn-lg">Start een bestelling</a>
      </div>
    </div>
  </div></section>
</Layout>

<style>
  .guide-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1.2rem; }
    /* A card, so it takes the card treatment: the site radius and .lift from
     global.css (a lit top edge, a contact shadow, a 1.2% rise on hover)
     instead of a 1px grey rectangle. The local transition is gone with it —
     .lift declares its own, and two rules animating `transform` from two
     places is how a hover ends up with two different durations. */
.guide-card { display: flex; flex-direction: column; padding: clamp(1.5rem, 2.8vw, 2.1rem); border: 0; border-radius: var(--r-lg); background: var(--surface); }
    /* Only the ground changes here. The rise and the shadow come from .lift in
     global.css; repeating translateY locally would win on specificity and
     silently drop the 1.2% scale that makes the two consistent. */
  .guide-card:hover { background: var(--surface-2); }
  .guide-tag { align-self: flex-start; font-size: .68rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--accent-bright); padding: .3rem .7rem; border-radius: var(--r-pill); box-shadow: inset 0 0 0 1px var(--accent-line); margin-bottom: 1rem; }
  .guide-title { font-family: var(--font-display); font-weight: 900; font-size: clamp(1.2rem, 2vw, 1.5rem); line-height: 1.12; color: var(--ink); letter-spacing: -0.02em; }
  .guide-desc { margin-top: .7rem; font-size: .95rem; color: var(--ink-3); line-height: 1.55; }
  .guide-more { margin-top: 1.4rem; display: inline-flex; align-items: center; gap: .4rem; font-size: .9rem; font-weight: 600; color: var(--ink); }
  .guide-more .i { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 2; }
  .guide-card:hover .guide-more { color: var(--accent-bright); }
</style>
