---
import { waHref } from '../../data/whatsapp.js';
// VISUAILS — Contact (Nederlands). Vertaling van src/pages/contact.astro.
import Layout from '../../layouts/Layout.astro';
import { TEST_SAMPLE } from '../../data/pricing.js';

// De proefvisualkosten stonden hier ook ingetypt. Het is een tier-feit en komt
// dus uit pricing.js — zie src/pages/nl/test-sample.astro voor dezelfde fix.
const SAMPLE = TEST_SAMPLE.nl;
---

<Layout
  title="VISUAILS — Neem contact op"
  description="Vragen over een bestelling, support of een custom verzoek? App VISUAILS of mail naar hello@visuails.com — we reageren meestal binnen het uur."
>
  <!-- HERO -->
  <section class="page-hero">
    <div class="container">
      <div class="photo-split reverse">
        <div class="photo-split-media">
          <img src="/img/lifestyle-glow-03.webp" alt="Een VISUAILS lifestyle-visual" loading="lazy" decoding="async" width="768" height="1376" />
        </div>
        <div>
          <h1 class="display" style="font-size:clamp(2.4rem,5vw,4rem)">Laten we <em>samen</em> groeien.</h1>
          <p class="lead" style="margin-top:1rem">Een vraag of een custom verzoek? Stuur een bericht — een echte mens leest ze allemaal.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CONTACT -->
  <section class="section-tight">
    <div class="container two-col" style="align-items:start">

      <!-- Links: kanalen -->
      <div class="reveal pending contact-stack">
        <h2>De snelste manier om ons te bereiken</h2>

        <div class="card">
          <h3>WhatsApp</h3>
          <p style="margin-top:.5rem;color:var(--ink-3)">Meestal antwoord binnen het uur.</p>
          <p style="margin-top:.6rem"><strong>+31 6 25436130</strong></p>
          <a href={waHref("Hoi VISUAILS, ik heb een vraag.")} class="btn btn-wa" style="margin-top:1rem" target="_blank" rel="noopener">
            Chat via WhatsApp
          </a>
        </div>

        <div class="card">
          <h3>E-mail</h3>
          <p style="margin-top:.5rem;color:var(--ink-3)">Voor uitgebreide briefings, facturen of bijlagen.</p>
          <p style="margin-top:.6rem">
            <a href="mailto:hello@visuails.com" class="link-arrow" style="font-size:1rem">hello@visuails.com <svg viewBox="0 0 24 24" class="i" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
          </p>
        </div>

        <div class="grid grid-2">
          <div class="card">
            <h3 style="font-size:.95rem">Openingstijden</h3>
            <p style="margin-top:.5rem;font-size:.95rem;color:var(--ink-3)">Ma–vr 08:00–20:00 CET<br>Za–zo 09:00–20:00 CET</p>
          </div>
          <div class="card">
            <h3 style="font-size:.95rem">Locatie</h3>
            <p style="margin-top:.5rem;font-size:.95rem;color:var(--ink-3)">Enschede, Nederland<br>KVK 99742993<br><a href="/nl/terms/#bedrijfsgegevens" style="color:inherit;text-decoration:underline">Volledige bedrijfsgegevens</a></p>
          </div>
        </div>
      </div>

      <!-- Rechts: formulier -->
      <div class="reveal pending">
        <div class="card">
          <h2 style="font-size:1.5rem">Stuur een bericht</h2>
          <p style="margin-top:.5rem;color:var(--ink-3);font-size:.95rem">We reageren meestal binnen het uur, via je voorkeurskanaal.</p>

          <!-- Post naar /api/order: dat endpoint verwerkt bestellingen,
               aanmeldingen én contactberichten — het verborgen service-veld
               kiest de tak. service=contact schrijft een `messages`-rij en
               mailt NOTIFY_EMAIL; er ontstaat geen order en de capaciteit
               blijft ongemoeid. -->
          <form action="/api/order" method="post" style="margin-top:1.6rem">
            <input type="hidden" name="service" value="contact" />
            <input type="hidden" name="redirect" value="/nl/thank-you" />
            <input type="hidden" name="lang" value="nl" />
            <input type="text" name="company_hp" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0" />
            <div class="field">
              <label for="c-name">Naam <span class="req">*</span></label>
              <input class="input" type="text" id="c-name" name="name" required autocomplete="name" placeholder="Je naam" />
            </div>
            <div class="field">
              <label for="c-email">E-mail <span class="req">*</span></label>
              <input class="input" type="email" id="c-email" name="email" required autocomplete="email" placeholder="jij@jouwmerk.nl" />
            </div>
            <div class="field">
              <label for="c-topic">Onderwerp</label>
              <select class="select" id="c-topic" name="topic">
                <option value="order-support">Support bij bestelling</option>
                <option value="new-order">Nieuwe bestelling</option>
                <option value="custom-request">Custom verzoek</option>
                <option value="other">Anders</option>
              </select>
            </div>
            <div class="field">
              <label for="c-message">Bericht <span class="req">*</span></label>
              <textarea class="textarea" id="c-message" name="message" rows="5" required placeholder="Hoe kunnen we helpen?"></textarea>
            </div>
            <div class="field">
              <span id="preferred-label">Voorkeurskanaal</span>
              <div class="opt-stack" style="margin-top:.4rem" role="radiogroup" aria-labelledby="preferred-label">
                <label class="opt">
                  <input type="radio" name="preferred" value="email" checked />
                  <span class="opt-main"><span class="opt-title">E-mail</span><span class="opt-desc">We reageren op je hello@visuails.com-thread</span></span>
                </label>
                <label class="opt">
                  <input type="radio" name="preferred" value="whatsapp" />
                  <span class="opt-main"><span class="opt-title">WhatsApp</span><span class="opt-desc">Snelst — meestal binnen het uur</span></span>
                </label>
              </div>
            </div>
            <button type="submit" class="btn btn-primary btn-block btn-lg" style="margin-top:1.2rem">Verstuur bericht</button>
            <p style="margin-top:.8rem;font-size:.8rem;color:var(--ink-3)">Snel een antwoord nodig? Bekijk eerst de <a href="/nl/faq" style="color:var(--accent-bright);text-decoration:underline">FAQ</a>.</p>
          </form>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section-tight">
    <div class="container">
      <div class="cta-band reveal pending">
        <h2 class="display" style="font-size:clamp(2rem,4.5vw,3.2rem)">Liever eerst <em>één product</em> van jezelf als catalogset?</h2>
        <p class="lead" style="margin:1.2rem auto 0;text-align:center">Je levert aan zoals bij een gewone bestelling en krijgt {SAMPLE.deliverable} terug. Voor {SAMPLE.price}, één per bedrijf.</p>
        <div class="flex" style="justify-content:center;margin-top:2rem">
          <a href="/nl/test-sample" class="btn btn-primary btn-lg">Proefvisual</a>
          <a href="/nl/pricing" class="btn btn-ghost btn-lg">Bekijk prijzen</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Contactpagina-specifiek. De formulier-primitives (.field, .req, .input,
     .textarea, .select, .opt*) staan in global.css. */
  .contact-stack > * + * { margin-top: 1.2rem; }

  /* De radiogroep wordt aangekondigd door een <span>, niet door een <label> —
     een <label> zou naar één control wijzen in plaats van naar de groep. Die
     span moet er wel uitzien als een veldlabel. */
  .field span#preferred-label { font-size: .88rem; font-weight: 600; color: var(--ink); }
</style>
