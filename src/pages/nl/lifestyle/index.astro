---
// VISUAILS — Lifestyle hub. Ported from the SvelteKit v2 site's
// /lifestyle +page.svelte. `styles` data ported verbatim from
// $lib/data/styles.js (only the fields this page uses: slug, name,
// cardPhoto, tagline).
import Layout from '../../../layouts/Layout.astro';
import Compare from '../../../components/Compare.astro';

const styles = [
  { slug: 'dunes', name: 'Dunes', cardPhoto: '/img/lifestyle-dunes-01.webp', tagline: 'Zon, zand en ingetogen luxe.', price: '€35 / visual' },
  { slug: 'flash', name: 'Flash', cardPhoto: '/img/lifestyle-flash-02.webp', tagline: 'Directe flits. Zonder excuses.', price: '€35 / visual' },
  { slug: 'glow', name: 'Glow', cardPhoto: '/img/lifestyle-glow-01.webp', tagline: 'Golden hour, op aanvraag.', price: '€35 / visual' },
  { slug: 'phone-made', name: 'Phone-made', cardPhoto: '/img/lifestyle-phone-made-11.webp', tagline: 'Ziet er moeiteloos uit. Is het niet.', price: '€35 / visual' },
  { slug: 'custom', name: 'Custom', cardPhoto: '/img/banners-13.webp', tagline: 'Je eigen wereld.', price: 'Op aanvraag' },
];

const marqueeItems = [
  { src: '/img/lifestyle-phone-made-06.webp', label: 'Phone-made' },
  { src: '/img/lifestyle-glow-03.webp', label: 'Glow' },
  { src: '/img/lifestyle-flash-05.webp', label: 'Flash' },
  { src: '/img/lifestyle-dunes-02.webp', label: 'Dunes' },
  { src: '/img/banners-02.webp', label: 'Campaign' },
];
---

<Layout
  title="Lifestyle Images — jouw product in scènes die verkopen | VISUAILS"
  description="Echte, gestylede lifestyle-scènes met natuurlijk licht — en optioneel consistente modellen. High-res, klaar voor e-commerce en met de hand gecontroleerd, geleverd in ~24 uur. Vanaf €35 per visual."
  ogImage="/img/lifestyle-glow-01.webp"
>
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow-page">Lifestyle Images</span>
      <h1 class="display" style="font-size:clamp(2.4rem,5vw,4rem);margin-top:1rem">Jouw product, in scènes die verkopen</h1>
      <p class="lead" style="margin-top:1.2rem">Vier signatuurstijlen. Vanaf €35 per visual.</p>
      <div class="flex" style="margin-top:1.8rem">
        <span class="magnet-wrap"><span class="magnet-inner"><a href="/nl/order-lifestyle" class="btn btn-primary btn-lg">Bestel Lifestyle-visuals</a></span></span>
        <a href="/nl/pricing" class="btn btn-ghost btn-lg">Bekijk prijzen</a>
        <a href="https://wa.me/31625436130?text=Hoi%20VISUAILS%2C%20ik%20wil%20graag%20Lifestyle-visuals%20bestellen%20voor%20mijn%20producten." class="btn btn-wa" target="_blank" rel="noopener">
          <svg class="i" viewBox="0 0 24 24"><path d="M21 11.5a8.38 8.38 0 0 1-8.5 8.5 8.5 8.5 0 0 1-4-1L3 20l1.5-4.5A8.38 8.38 0 0 1 3.5 11 8.5 8.5 0 0 1 12 3a8.38 8.38 0 0 1 8.5 8.5z"/></svg>WhatsApp <span class="rec-badge">Snelst</span>
        </a>
      </div>
      <div class="trust-row" style="margin-top:2.4rem">
        <span class="trust-item"><strong>Vanaf €35</strong> per visual</span>
        <span class="trust-item"><strong>~24 uur</strong> levering</span>
        <span class="trust-item"><strong>100%</strong> met de hand gecontroleerd</span>
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <h2 style="margin-bottom:2rem">Vier sferen — of <em>je eigen.</em></h2>
      <div class="grid grid-2 reveal-group">
        {styles.map((s) => (
          <a href={`/nl/lifestyle/${s.slug}`} class="reveal pending" style="display:block">
            <div class="photo-band tall">
              <img src={s.cardPhoto} alt={`${s.name} lifestyle-voorbeeld`} loading="lazy" />
              <div class="scrim"></div>
              <div class="caption">
                <h3 style="color:#fff;font-size:1.6rem"><em>{s.name}</em> &rarr;</h3>
                <p style="font-size:.92rem">{s.tagline} &middot; {s.price}</p>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <div class="photo-split reveal pending">
        <div class="photo-split-media">
          <img src="/img/model-02.webp" alt="Een VISUAILS-model, consistent gestyled door een hele campagne" loading="lazy" />
        </div>
        <div>
          <h2>Voeg een consistent <em>model</em> toe.</h2>
          <p class="lead" style="margin-top:1rem">Hetzelfde gezicht, door je hele collectie — of laat ons er een kiezen die past.</p>
          <div class="flex" style="margin-top:1.4rem"><a href="/nl/models" class="btn btn-primary">Ontdek modellen</a></div>
        </div>
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <div class="section-head" style="text-align:center;margin-inline:auto">
        <h2>Vier sferen. Vier transformaties.</h2>
        <p style="margin-inline:auto">Dezelfde shot, plat versus afgewerkt in elke VISUAILS-stijl.</p>
      </div>
      <div class="compare-grid reveal-group" style="margin-top:2.2rem">
        {[
          { name: 'Dunes', photo: '/img/lifestyle-dunes-01.webp' },
          { name: 'Flash', photo: '/img/lifestyle-flash-01.webp' },
          { name: 'Glow', photo: '/img/lifestyle-glow-01.webp' },
          { name: 'Phone-made', photo: '/img/lifestyle-phone-made-01.webp' },
        ].map((c) => (
          <div class="reveal pending">
            <Compare grade before={c.photo} after={c.photo} beforeAlt={`Een platte, ongecorrigeerde ${c.name}-scène`} afterAlt={`Dezelfde scène afgewerkt in de ${c.name} lifestyle-look`} beforeLabel="Plat" afterLabel={c.name} />
            <p class="cc-label"><strong>{c.name}</strong> &middot; €35 / visual</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <div class="section-head" style="margin-bottom:1.8rem">
        <h2>Het assortiment, in beweging</h2>
        <p><a href="/nl/gallery" class="link-arrow" style="font-size:1rem">Bekijk de volledige galerij <svg viewBox="0 0 24 24" class="i"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a></p>
      </div>
    </div>
    <div class="marquee"><div class="marquee-track">
      {marqueeItems.map((m) => (
        <div class="marquee-item">
          <img src={m.src} alt={`${m.label} lifestyle-voorbeeld`} loading="lazy" style="width:100%;height:100%;object-fit:cover" />
        </div>
      ))}
    </div></div>
  </section>

  <section class="section-tight">
    <div class="container">
      <div class="cta-band reveal pending">
        <h2 class="display" style="font-size:clamp(2.2rem,5vw,3.6rem)">Zet je product<br>in een scène die verkoopt.</h2>
        <div class="flex" style="justify-content:center;margin-top:2rem">
          <span class="magnet-wrap"><span class="magnet-inner"><a href="/nl/order-lifestyle" class="btn btn-primary btn-lg">Bestel Lifestyle-visuals</a></span></span>
          <a href="/nl/models" class="btn btn-ghost btn-lg">Ontdek modellen</a>
          <a href="https://wa.me/31625436130?text=Hoi%20VISUAILS%2C%20ik%20wil%20graag%20praten%20over%20Lifestyle-visuals%20voor%20mijn%20merk." class="btn btn-wa" target="_blank" rel="noopener">
            <svg class="i" viewBox="0 0 24 24"><path d="M21 11.5a8.38 8.38 0 0 1-8.5 8.5 8.5 8.5 0 0 1-4-1L3 20l1.5-4.5A8.38 8.38 0 0 1 3.5 11 8.5 8.5 0 0 1 12 3a8.38 8.38 0 0 1 8.5 8.5z"/></svg>WhatsApp
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
