---
// VISUAILS — shared template for the lifestyle style detail pages (Dutch /
// NL). Localized copy of src/pages/lifestyle/[slug].astro — imports the NL
// data file and prefixes every internal link with /nl.
import Layout from '../../../layouts/Layout.astro';
import ProductScene from '../../../components/ProductScene.astro';
import Compare from '../../../components/Compare.astro';
import { styles } from '../../../data/styles.nl.js';
import { perProduct, reviewClaim, turnaround, TIERS } from '../../../data/pricing.js';
import { metaDescription } from '../../../data/meta.js';

export function getStaticPaths() {
  return styles.map((s) => ({ params: { slug: s.slug }, props: { style: s } }));
}

const { style } = Astro.props;

// Intrinsic pixel size of the one photo this template renders as an <img>
// (style.grid[0].photo). The .photo-split-media box pins aspect-ratio 4/5 and
// the image covers it, so these attributes change nothing visually — they let
// the browser reserve the box before the file lands (§12). Unlisted throws.
const INTRINSIC: Record<string, [number, number]> = {
  '/img/banners-14.webp': [2400, 1792],
  '/img/lifestyle-dunes-02.webp': [928, 1152],
  '/img/lifestyle-flash-01.webp': [928, 1152],
  '/img/lifestyle-glow-01.webp': [1340, 2400],
  '/img/lifestyle-phone-made-02.webp': [2400, 1792],
};
const moodPhoto = style.grid[0].photo;
const moodSize = INTRINSIC[moodPhoto];
if (!moodSize) throw new Error(`lifestyle/[slug]: no intrinsic size on record for ${moodPhoto} — add it to INTRINSIC.`);

// Timing, review level and queue behaviour are tier facts, not per-style
// copy. They come from pricing.js so a capacity change cannot leave a
// promise stranded on a detail page — which is exactly what "~24h delivery"
// and "Produced in about 24 hours" were doing here.
const TIMING = turnaround('unattended', 'nl');
const REVIEW = reviewClaim('unattended', 'nl');
const QUEUE = TIERS.unattended.queue.nl;

// Vier van de vijf lifestyle-stijlen hebben zelf geen priceTrust, dus de
// fallback hieronder is wat op de meeste pagina's daadwerkelijk rendert — dat
// was de string '€59,99', twee keer ingetypt. Custom houdt zijn eigen tekst.
const item = perProduct('lifestyle', 'nl');
const priceLine = style.priceTrust ? `${style.priceTrust}${style.priceUnit ?? ''}` : `${item.price} / product`;

// De description was één template literal, dus de lengte was wat de data er
// toevallig van maakte. metaDescription laat de tier-clausules vallen in
// plaats van over de 160 heen te gaan — zie src/data/meta.js.
---

<Layout
  title={`${style.name} — Lifestyle-stijl | VISUAILS`}
  description={metaDescription([
    `${style.name}: een kenmerkende VISUAILS lifestyle-stijl`,
    priceLine,
    TIMING,
    REVIEW,
  ])}
>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow-page"><a href="/nl/lifestyle" style="color:inherit">&larr; Lifestyle-stijlen</a></p>
      <h1 class="display">{style.name}.</h1>
      <p style="margin-top:1rem;font-family:var(--font-display);font-size:clamp(1.35rem,2.3vw,1.9rem);color:var(--ink);max-width:34ch;line-height:1.25">{style.tagline}</p>
      <div class="flex" style="margin-top:1.8rem">
        <span class="magnet-wrap"><span class="magnet-inner"><a href={style.orderHref ?? '/nl/start'} class="btn btn-primary btn-lg">{style.orderLabel ?? `Bestel ${style.name}`}</a></span></span>
        <a href={`https://wa.me/31625436130?text=Hoi%20VISUAILS%2C%20ik%20wil%20graag%20praten%20over%20de%20${style.name}-stijl.`} class="btn btn-wa" target="_blank" rel="noopener">
          <svg class="i" viewBox="0 0 24 24"><path d="M21 11.5a8.38 8.38 0 0 1-8.5 8.5 8.5 8.5 0 0 1-4-1L3 20l1.5-4.5A8.38 8.38 0 0 1 3.5 11 8.5 8.5 0 0 1 12 3a8.38 8.38 0 0 1 8.5 8.5z"/></svg>
          WhatsApp
        </a>
      </div>
      <div class="trust-row" style="margin-top:2rem">
        <span class="trust-item"><strong>{style.priceTrust ?? item.price}</strong>{style.priceUnit ?? ' / product'}</span>
        <span class="trust-item"><strong>{TIMING}</strong></span>
        <span class="trust-item"><strong>{REVIEW}</strong></span>
      </div>
      <p class="queue-note">{QUEUE}</p>
    </div>
  </section>

  <!-- Media band — mask reveal on the signature photo -->
  <section class="section-tight">
    <div class="container">
      <div class="reveal-mask" style="aspect-ratio:21/10;overflow:hidden">
        <div class="rm-inner" style={`background-image:url('${style.heroPhoto}')`}></div>
      </div>
    </div>
  </section>

  <!-- Mood — photo + one line, not a wall of text -->
  <section class="section-tight">
    <div class="container">
      <div class="photo-split reveal pending">
        <div class="photo-split-media">
          <img src={moodPhoto} alt={`${style.name}-stijlvoorbeeld`} loading="lazy" decoding="async" width={moodSize[0]} height={moodSize[1]} />
        </div>
        <div>
          <h2>Hoe {style.name} <em>voelt</em>.</h2>
          <p class="lead" style="margin-top:1rem">{style.moodParagraphs[0]}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Before/after — real proof for this specific style. -->
  <section class="section-tight">
    <div class="container">
      <div class="section-head" style="text-align:center;margin-inline:auto">
        <h2>Vlak vs. {style.name}.</h2>
        <p style="margin-inline:auto">Wat de behandeling daadwerkelijk verandert.</p>
      </div>
      <div style="max-width:520px;margin:2rem auto 0">
        <Compare
          grade
          before={style.heroPhoto}
          after={style.heroPhoto}
          beforeAlt={`Een vlakke, ongegradede ${style.name}-scène`}
          afterAlt={`Dezelfde scène afgewerkt in de ${style.name} lifestyle-look`}
          beforeLabel="Vlak"
          afterLabel={style.name}
        />
      </div>
    </div>
  </section>

  <!-- Steps -->
  <section class="section-tight">
    <div class="container">
      <h2 style="margin-bottom:2rem">Hoe {style.name} tot stand komt.</h2>
      <div class="steps">
        {style.steps.map((s, i) => (
          <div class="reveal pending">
            <span class="step-n">Nr. {i + 1}</span><h3>{s.title}</h3><p>{s.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Photo grid — the range, in frames -->
  <section class="section-tight">
    <div class="container">
      <div class="grid grid-3">
        {style.grid.map((g) => (
          <div class="reveal pending">
            {g.photo ? (
              <div class="vis" style={`background-image:url('${g.photo}')`}>
                <div class="vis-floor"></div>
                <span class="vis-badge">{style.name}</span>
              </div>
            ) : (
              <ProductScene icon={g.icon} width={g.width} badge={style.name} />
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Best for / what you get -->
  <section>
    <div class="container two-col" style="align-items:start">
      <div class="reveal pending">
        <h2 style="font-size:1.7rem">Ideaal <em>voor</em></h2>
        <ul class="checklist" style="margin-top:1.2rem">
          {style.bestFor.map((item) => (
            <li><svg viewBox="0 0 24 24" class="i"><path d="M20 6L9 17l-5-5"/></svg><span>{item}</span></li>
          ))}
        </ul>
      </div>
      <div class="reveal pending">
        <h2 style="font-size:1.7rem">Wat je <em>krijgt</em></h2>
        <ul class="checklist" style="margin-top:1.2rem">
          {style.whatYouGet.map((item) => (
            <li><svg viewBox="0 0 24 24" class="i"><path d="M20 6L9 17l-5-5"/></svg><span>{item}</span></li>
          ))}
        </ul>
        {/* Brief §1 — elke drop-contentpagina linkt naar /custom-models. Eén
            regel in de template bedient alle vijf lifestyle-stijlen. */}
        <p class="model-note">Wordt een {style.name}-scène gedragen in plaats van geplaatst, dan kan het model uit de standaardroster komen — of <a href="/nl/custom-models">een merkmodel dat alleen voor jou gemaakt is</a>, zodat hetzelfde gezicht elke drop draagt.</p>
      </div>
    </div>
  </section>

  <!-- Closing CTA -->
  <section class="section-tight">
    <div class="container">
      <div class="cta-band reveal pending">
        <h2 class="display" style="font-size:clamp(2rem,4.5vw,3.2rem)">Maak {style.name} <em>van jou.</em></h2>
        <div class="flex" style="justify-content:center;margin-top:1.8rem">
          <span class="magnet-wrap"><span class="magnet-inner"><a href={style.orderHref ?? '/nl/start'} class="btn btn-primary btn-lg">{style.orderLabel ?? `Bestel ${style.name}`}</a></span></span>
          <a href="/nl/test-sample" class="btn btn-ghost btn-lg">Proefvisual</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* app.css's shared .step-n carries an italic mark from the v1 serif system
     — v2 has no italics anywhere, so it's overridden locally rather than
     touched globally. */
  .step-n { font-style: normal; }
  /* Mirrors .queue-note on the hub components. Astro scopes <style> to a
     component's own template, so a shared visual pattern has to be repeated
     per file; consolidating these into global.css is logged as a follow-up. */
  .queue-note { margin-top: .9rem; font-size: .88rem; color: var(--ink-3); }

  /* De merkmodel-regel onder "Wat je krijgt" — bodytekst, geen callout. */
  .model-note { margin-top: 1.2rem; font-size: .92rem; color: var(--ink-3); line-height: 1.55; }
  .model-note a { color: var(--accent-bright); text-decoration: underline; text-underline-offset: 3px; }
</style>
