---
// VISUAILS — /nl/lifestyle/[slug]. Zie de Engelse variant en de kop van
// LifestyleStyleDetail.astro; hier verschillen alleen de meta en de databron.
import Layout from '../../../layouts/Layout.astro';
import LifestyleStyleDetail from '../../../components/LifestyleStyleDetail.astro';
import { styles } from '../../../data/styles.nl.js';
import {
  euro, ladderRate, ladderFloor, LADDER, vatLabel,
  reviewClaim, turnaround,
} from '../../../data/pricing.js';
import { metaDescription } from '../../../data/meta.js';

export function getStaticPaths() {
  return styles.map((s) => ({ params: { slug: s.slug }, props: { style: s } }));
}

const { style } = Astro.props;

const LIFE_FLOOR_FROM = LADDER.lifestyle[LADDER.lifestyle.length - 1][0];
const priceLine = style.priceTrust
  ? `${style.priceTrust}${style.priceUnit ?? ''}`
  : `${euro(ladderRate('lifestyle', 1), 'nl')} / product, ${euro(ladderFloor('lifestyle'), 'nl')} vanaf ${LIFE_FLOOR_FROM} (${vatLabel('excl', 'nl')})`;

const zusters = styles
  .filter((s) => s.slug !== style.slug)
  .map((s) => ({ href: `/lifestyle/${s.slug}`, naam: s.name }));

const TIMING = style.priceTrust ? 'Eerst het ontwerp, daarna de gewone doorlooptijd per bestelling.' : turnaround('unattended', 'nl');
const REVIEW = reviewClaim('unattended', 'nl');
---

<Layout
  title={`${style.name} — Lifestyle-stijl | VISUAILS`}
  description={metaDescription([
    `${style.name}: een kenmerkende lifestylestijl van VISUAILS`,
    priceLine,
    TIMING,
    REVIEW,
  ])}
>
  <LifestyleStyleDetail lang="nl" style={style} zusters={zusters} priceLine={priceLine} />
</Layout>
