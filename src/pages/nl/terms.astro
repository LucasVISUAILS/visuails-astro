---
import { WHATSAPP_DISPLAY, waHref } from '../../data/whatsapp.js';
// VISUAILS — Algemene voorwaarden (Nederlands). Vertaling van src/pages/terms.astro.
// De redenering achter §2 ("gereserveerde bestelling"), het nieuwe §7, de
// 50/50-alinea in §9 en de herschreven §4, §6 en §10 staat in dat bestand. Kort samengevat: §6 beloofde
// iedereen levering "binnen ongeveer 24 uur" en "maximaal 3 revisierondes",
// terwijl een losse bestelling in de standaard wachtrij loopt en geen enkele
// bestelling nog een rondetelling kent. §6 gaat nu alleen over levering en
// leest zijn twee termijnen uit turnaround(); §10 neemt over wat §6 beloofde,
// in de nieuwe vorm — we vragen of je tevreden bent en spreken samen af hoe we
// het oplossen. §4 typt zijn prijzen niet meer. §7 noemt drie termijnen, geen
// twee: bronmateriaal 90 dagen, geleverde visuals 12 maanden, en de privé-
// bestellink 90 dagen na afsluiting. Die laatste zat eerst verstopt in de
// 12-maandenzin, terwijl het portaal die link nooit zo lang heeft opengehouden.
//
// Augustus 2026: §2 definieerde "Drop" — "één bestelling voor een hele
// collectie of lancering" — en die definitie is met de pakketten verdwenen. In
// een contract woog vooral het tweede bezwaar: "in plaats van losse producten"
// trok een grens die de prijslijst niet meer trekt, want elk aantal heeft nu
// een prijs. De grens die er wél is, is WINDOW_THRESHOLD, en dat is precies de
// term die §6 en §9 nodig hebben. §4 noemt geen vast tarief meer, maar de twee
// uiteinden van de staffel.
import Layout from '../../layouts/Layout.astro';
import {
  euro, turnaround, ladderRate, ladderFloor, LADDER, WINDOW_THRESHOLD,
  /* §10 leest het revisiebeleid uit; zie de noot daar. */
  revisiebeleid,
  /* De twee opties bij een bestelling (29 september 2026): stonden alleen in de
     Engelse voorwaarden. */
  RESOLUTIE, HOOG_PER_PRODUCT, VOORRANG, LIFESTYLE_IMAGES,
} from '../../data/pricing.js';
// §7 leest de bewaartermijnen uit retention.js in plaats van ze in te typen. Zie de
// noot in de Engelse pagina: een ingetypt getal in een contract is de duurste
// variant van die drift.
import { UPLOAD_DAYS, DELIVERY_DAYS } from '../../lib/retention.js';
/* De privélink heeft zijn eigen klok (30 september 2026); zie terms.astro. */
import { PORTAL_TTL_DAYS } from '../../lib/token.js';

/* ── §4 TYPT GEEN PRIJZEN MEER DIE WEL BESTAAN — 23 AUGUSTUS 2026 ───────────
 *
 * De regel hieronder zei "Video, custom work and monthly plans — quoted
 * individually before you commit". Voor maatwerk klopt dat. Voor de andere twee
 * niet, en dat is een tegenspraak met de site zelf: /pricing, /video en de
 * JSON-LD publiceren een vaste prijs per clip, en /plans publiceert drie vaste
 * maandbedragen. Een klant die op de voorwaarden afgaat, leest dat hij eerst een
 * offerte krijgt voor iets waar een prijskaart bij staat.
 *
 * Nu leest §4 diezelfde bronnen: AMOUNT.video en monthlyCents(). Zoals de
 * catalog- en lifestyleregels de ladder al lazen, en om dezelfde reden — een
 * prijs die op twee plekken staat, staat er over een half jaar verschillend.
 */
import { AMOUNT, clause, VIDEO_OP_AANVRAAG, CUSTOM_CREDITS_MIN, customCreditsTotal } from '../../data/pricing.js';
import { PLAN_IDS, monthlyCents } from '../../data/plans.js';
import { planName } from '../../data/planNames.js';
// De datum stond hier uitgetypt, en nog negen keer elders. Zie de kop van
// src/data/juridischeDatums.js: één bron, en een toets die hem tegen git houdt.
import { bijgewerktOp } from '../../data/juridischeDatums.js';
import '../../styles/stijl22.css';

/* Van–tot over de drie plannen, op de maandtermijn: dat is het bedrag dat op
   /plans het grootst wordt afgedrukt. Het VOORUITBETAALDE jaar is goedkoper en
   zou hier een lagere ondergrens geven dan wat iemand op de plannenpagina ziet
   staan. (Tot 10 september gold dat ook voor de gewone jaartermijn; die geeft
   sinds vandaag geen korting meer — zie discountMonths in plans.js.) */
const planLo = Math.min(...PLAN_IDS.map((p) => monthlyCents(p, 'monthly')));
const planHi = Math.max(...PLAN_IDS.map((p) => monthlyCents(p, 'monthly')));
const planLoNaam = planName(PLAN_IDS.find((p) => monthlyCents(p, 'monthly') === planLo), 'nl');
const planHiNaam = planName(PLAN_IDS.find((p) => monthlyCents(p, 'monthly') === planHi), 'nl');
/* Zie de Engelse tegenhanger: het plan op maat, uit customCreditsTotal(). */
const maatVanaf = customCreditsTotal(CUSTOM_CREDITS_MIN).total;
/* clause() eromheen: turnaround() geeft een AFGERONDE ZIN terug, met een punt.
   Hier staat hij middenin een zin — "loopt in {t1}, en houdt die plek" — en dat
   werd "voordat je betaalt., en houdt". Zie de kop van tests/leestekens.test.mjs;
   dit is dezelfde fout, in het ene bestand waar hij juridisch telt. */
const t0 = clause(turnaround('unattended', 'nl')).toLowerCase();
const t1 = clause(turnaround('attended', 'nl')).toLowerCase();

const FLOOR_FROM = LADDER.catalog[LADDER.catalog.length - 1][0];
---

<Layout
  title="Algemene voorwaarden — VISUAILS"
  description="De voorwaarden voor VISUAILS — productvisuals die wij voor je merk maken. Bestellingen, prijzen, betaling en Nederlands recht."
>
{/* ═══ EEN JURIDISCHE PAGINA IN DE STIJL VAN SECTIE 22 — 7 september 2026 ═══
    De TEKST is woord voor woord onaangeraakt. Wat verandert is de omhulling:
    één `.paneel` in plaats van drie secties, en de letters van sectie 22 op het
    `.legal`-blok — dat blok zelf staat nog steeds in global.css en wordt hier
    niet overgetypt. Zie `.s22.s22 .legal` in src/styles/stijl22.css; die zet de
    letters voor alle zes juridische pagina's tegelijk.

    ALLE VIJF TEGELIJK, en dat is geen keuze maar een eis van de toets.
    tests/juridische-datums.test.mjs bewaakt deze documenten als GROEP: vijf
    pagina's die er hetzelfde uit horen te zien en waar niets afgaat als er
    eentje uit de pas loopt. Toen /ai-act als eerste overging, viel die toets om
    met de naam van dat bestand erin — precies zoals bedoeld. Het antwoord
    daarop is niet de toets versoepelen maar de andere vier meenemen.

    GEEN SLOTPANEEL. De andere pagina's eindigen op een `.paneel-slot`; een
    juridische pagina niet. Het accent wijst een keuze aan, en aan het eind van
    een document valt niets te kiezen — er staat een adres waar je terecht kunt.
    Een slotpaneel met knoppen eronder zou daar een aanbieding van maken. */}
<div class="s22">
  <section class="paneel">
    <header class="paneel-kop jur-kop">
      <p class="etiket">Juridisch</p>
      <h1 class="hoog">Algemene voorwaarden</h1>
      <p class="lopend jur-lead">De voorwaarden die van toepassing zijn wanneer je productvisuals bestelt bij VISUAILS. Lees ze voordat je een bestelling plaatst.</p>
      <p class="legal-meta">{bijgewerktOp('terms', 'nl')}</p>
    </header>

    <div class="legal jur-tekst">

      <h2>1. Inleiding &amp; aanvaarding</h2>
      <p>Deze algemene voorwaarden zijn van toepassing op je gebruik van VISUAILS en op elke bestelling die je bij ons plaatst. VISUAILS wordt geëxploiteerd vanuit Enschede, Nederland (KVK 99742993, btw NL005407575B96). Door een bestelling te plaatsen, een proefvisual aan te vragen of anderszins onze dienst te gebruiken, ga je akkoord met deze voorwaarden. Als je niet akkoord gaat, gebruik de dienst dan niet.</p>
      {/* id="bedrijfsgegevens" — de contactpagina linkt hierheen met de tekst
          "Volledige bedrijfsgegevens". Die link wees naar /nl/terms/#top, en
          #top is geen echt anker: de HTML-standaard laat de browser dan naar
          het begin van het document springen. Dat werkt, maar het begin van
          deze pagina is de kop van de voorwaarden en de bedrijfsgegevens
          staan een derde lager. De lezer klikte op "bedrijfsgegevens" en
          kreeg een lange juridische pagina zonder ze te zien. */}
      <p id="bedrijfsgegevens"><strong>VISUAILS is de handelsnaam van Lucas Snuverink.</strong><br>
      Vaarwerkhorst 17, 7531 HK Enschede, Nederland<br>
      KVK 99742993 &middot; btw NL005407575B96 &middot; <a href="mailto:hello@visuails.com">hello@visuails.com</a></p>
      <p>Dit is ons vestigings- en postadres. Het is <strong>geen bezoekadres</strong>: er is geen ontvangstruimte en wij ontvangen er geen bezoek. Contact loopt via e-mail of WhatsApp; post komt er wel aan.</p>
      <p><strong>Bij deze voorwaarden horen twee documenten, en die maken er deel van uit.</strong> Ons <a href="/nl/privacy/">privacybeleid</a> gaat over de gegevens die wij over jou hebben. Onze <a href="/nl/data-processing-agreement/">verwerkersovereenkomst</a> gaat over de andere richting: materiaal dat jij aanlevert waarop een persoon staat, waarbij jij verantwoordelijke bent en wij jouw verwerker. Ondertekenen hoeft niet — een bestelling plaatsen is aanvaarden — en je kunt altijd een ondertekend exemplaar opvragen.</p>


      <h2>2. Definities</h2>
      <ul>
        <li><strong>"Wij", "ons", "VISUAILS"</strong> — de aanbieder van de dienst.</li>
        <li><strong>"Jij", "klant"</strong> — de persoon of het bedrijf dat visuals bestelt.</li>
        <li><strong>"Visual"</strong> — een foto of video die we voor je maken.</li>
        <li><strong>"Bronmateriaal"</strong> — de productfoto’s, afbeeldingen en informatie die je aanlevert.</li>
        <li><strong>"Bestelling"</strong> — een aanvraag voor een of meer visuals onder deze voorwaarden.</li>
        <li><strong>"Gereserveerde bestelling"</strong> — een bestelling van {WINDOW_THRESHOLD} producten of meer, die in onze agenda wordt ingepland en een vastgezette leverdatum krijgt.</li>
      </ul>

      <h2>3. De dienst</h2>
      {/* Zie de noot bij de Engelse tegenhanger in src/pages/terms.astro. */}
      <p>VISUAILS maakt productvisuals voor je — catalogfoto’s, lifestyle-scènes en video — op basis van het bronmateriaal dat je aanlevert. Wij maken elk beeld en onze beeldredactie controleert het vóór levering; AI is een van de technieken die we in die productie gebruiken. We streven naar consistente, publicatieklare resultaten, maar visuals zijn creatief werk en de exacte uitkomsten kunnen variëren.</p>

      <p><strong>VISUAILS levert uitsluitend zakelijk.</strong> Deze dienst is voor merken, retailers en andere ondernemingen, en niet voor particulieren. Bij het bestellen vragen we je te bevestigen dat je voor je bedrijf of beroep bestelt, en binnen de EU het bewijs dat daarbij hoort: een KVK-nummer in Nederland, en elders in de EU een btw-nummer dat wij bij VIES kunnen controleren. Ontbreekt dat bewijs, dan weigeren we de bestelling niet — we zetten hem stil, laten weten wat we nodig hebben, en beginnen zodra het er is. Er wordt in de tussentijd niets gemaakt en niets gefactureerd. Buiten de EU is je bevestiging genoeg: veel landen, zoals de Verenigde Staten, kennen geen btw-nummer. Een registratienummer mag je dan opgeven, maar het hoeft niet; wel controleren we na de betaling of het land van je betaalmiddel bij je opgegeven land past.</p>
      <p>We vragen alleen in Nederland om een KVK-nummer, omdat dat nummer alleen daar bestaat: een dienst die er overal op staat, sluit geen consumenten uit maar buitenlandse ondernemingen. Wat juridisch telt is of je handelt voor je bedrijf — daarom is jouw bevestiging het dragende deel en het nummer de onderbouwing ervan.</p>
      <p>Bestel je toch als consument, dan zegt paragraaf 10a wat er geldt: dan is het consumentenrecht van toepassing, wat er ook in deze voorwaarden staat, want dat is niet iets wat je met een contract kunt wegschrijven.</p>

      <h2>4. Bestellingen &amp; prijzen</h2>
      <p>Visuals worden geprijsd per product, en het tarief daalt naarmate het aantal producten in de bestelling stijgt. Indicatieve tarieven zijn:</p>
      <ul>
        <li><strong>Catalog</strong> — {euro(ladderRate('catalog', 1), 'nl')} per product, dalend tot {euro(ladderFloor('catalog'), 'nl')} vanaf {FLOOR_FROM} producten. Een set van vier foto’s (voorkant, achterkant, een detail-close-up en één on-model shot).</li>
        <li><strong>Lifestylefoto’s</strong> — {euro(ladderRate('lifestyle', 1), 'nl')} per product, dalend tot {euro(ladderFloor('lifestyle'), 'nl')} vanaf {FLOOR_FROM} producten. Een carrousel van drie foto’s.</li>
        <li><strong>Het tarief daartussen</strong> — volledig uitgeschreven op onze <a href="/nl/pricing/">prijzenpagina</a>. Het tarief dat geldt, is dat van het totale aantal producten in je bestelling, en het geldt voor elk product daarin.</li>
        <li><strong>Video</strong> — {VIDEO_OP_AANVRAAG ? 'op aanvraag: we geven per clip schriftelijk een prijs voordat er iets gemaakt wordt, en er wordt niets afgerekend tot jij akkoord geeft.' : `${euro(AMOUNT.video, 'nl')} per clip, hetzelfde tarief of het er nu één is of twintig.`} Een clip staat niet in de lijst hierboven.</li>
        <li><strong>Maandplannen</strong> — {euro(planLo / 100, 'nl')} tot {euro(planHi / 100, 'nl')} per maand op de maandtermijn ({planLoNaam} tot {planHiNaam}), plus het {planName('maat', 'nl').toLowerCase()} vanaf {euro(maatVanaf, 'nl')} per maand, volledig uitgeschreven op onze <a href="/nl/plans/">abonnementenpagina</a>. De jaartermijn staat daar ook.</li>
        <li><strong>Maatwerk</strong> — individueel geoffreerd voordat je je verbindt.</li>
        <li><strong>Merkmodel</strong> — {euro(AMOUNT.brandModel, 'nl')}, één keer betaald als het model ontworpen wordt. Niet per beeld, niet per bestelling, niet per jaar. Op het ontwerp krijg je één correctieronde, daarna ligt het vast; elk product gaat daarna tegen het gewone tarief. Voor een eigen look geldt hetzelfde: één ontwerpbedrag, één correctieronde, daarna het gewone tarief per product.</li>
      </ul>
      {/* Stond alleen in de Engelse voorwaarden (gevonden 29 september 2026): de
          twee opties en de toezegging bij voorrang horen in beide talen. */}
      <p><strong>Twee opties die je aan een bestelling kunt toevoegen.</strong></p>
      <ul>
        <li><strong>Hogere resolutie</strong> — elk beeld wordt geleverd op {RESOLUTIE.standaard} px aan de lange zijde. Bij lifestylewerk kun je alle {LIFESTYLE_IMAGES} beelden van een product in plaats daarvan op {RESOLUTIE.hoog} px laten leveren, voor {euro(HOOG_PER_PRODUCT, 'nl')} per product. Catalogbeelden zijn altijd {RESOLUTIE.standaard} px; een groter catalogbestand is een verzoek en geen optie, en wordt schriftelijk afgesproken.</li>
        <li><strong>Voorrang bij levering</strong> — {Math.round(VOORRANG.deel * 100)}% van het orderbedrag, met een minimum van {euro(VOORRANG.bodem, 'nl')} en een maximum van {euro(VOORRANG.plafond, 'nl')}. Je bestelling gaat bovenaan de lijst. Betaal je op een werkdag vóór {VOORRANG.bestelVoorUur}:00, dan leveren we uiterlijk de volgende werkdag om {VOORRANG.klaarUur}:00; betaal je later, dan uiterlijk om {VOORRANG.klaarUur}:00 de werkdag daarna (Nederlandse tijd; werkdagen zijn maandag tot en met vrijdag, behalve Nederlandse feestdagen). <strong>Halen we dat niet, dan betalen we de toeslag terug</strong> en loopt de bestelling gewoon door. Voorrang kan tot {VOORRANG.maxProducten} producten of {VOORRANG.maxClips} clips, en alleen op een stijl die al bestaat — een stijl die nog ontworpen wordt, kan niet sneller: dat ontwerpen ís het werk.</li>
      </ul>
      <p>Nieuwe bedrijven kunnen één proefvisual per bedrijf aanvragen, zodat je onze kwaliteit kunt beoordelen voordat je bestelt. Prijzen worden bevestigd op het moment van bestellen. Tenzij anders vermeld, zijn prijzen exclusief btw waar van toepassing.</p>

      <h2>5. Jouw verantwoordelijkheden</h2>
      <p>Je bent verantwoordelijk voor het bronmateriaal dat je uploadt. Door het in te dienen, bevestig je dat:</p>
      <ul>
        <li>Je de rechten hebt op de productfoto’s en afbeeldingen, of toestemming hebt om ze te gebruiken.</li>
        <li>De inhoud geen inbreuk maakt op iemands intellectuele eigendom, privacy of andere rechten.</li>
        <li>De inhoud niet illegaal, schadelijk, misleidend of anderszins verboden is.</li>
      </ul>
      <p>We kunnen elke bestelling weigeren of het werk eraan stopzetten die deze voorwaarden lijkt te schenden.</p>
      {/* 1 oktober 2026 (Lucas: "B"): één contactpunt voor meldingen, zoals de
          Digital Services Act dat vraagt van wie bestanden van klanten bewaart.
          Bewust kort, en zonder een termijn te beloven die we niet kunnen meten. */}
      <p><strong>Meldingen en contactpunt.</strong> Denk je dat iets dat via VISUAILS is aangeleverd of gemaakt onrechtmatig is, bijvoorbeeld omdat het inbreuk maakt op jouw rechten, meld het dan aan <a href="mailto:hello@visuails.com">hello@visuails.com</a>. Zet erbij om welk beeld of welke bestelling het gaat, waarom het volgens jou onrechtmatig is, en hoe we je kunnen bereiken. Hetzelfde adres is ons contactpunt voor gebruikers en autoriteiten onder de Digital Services Act (Verordening (EU) 2022/2065); je kunt ons in het Nederlands of het Engels schrijven. We bevestigen dat we je melding hebben ontvangen, beoordelen haar zorgvuldig en laten je weten wat we ermee doen.</p>

      <h2>6. Levering</h2>
      {/* Zie de noot bij §6 in terms.astro (30 september 2026). */}
      <p>Hoe lang een bestelling duurt, hangt af van hoe je bestelt. Losse producten lopen in de normale doorlooptijd: {t0} vanaf het moment dat we je foto’s en je notitie binnen hebben. We noemen voor een los product geen leverdatum, want een datum waarvoor we geen capaciteit hebben vrijgehouden is geen datum.</p>
      <p>Een gereserveerde bestelling krijgt {t1}. Die datum houden we zeven dagen voor je vast terwijl de betaling openstaat; is de bestelling dan niet betaald, dan komt de datum weer vrij en blijft de bestelling zelf staan. Zodra je hebt betaald, ligt de datum vast en schuift hij niet meer.</p>
      <p><strong>Overmacht.</strong> De enige uitzondering zijn omstandigheden buiten onze macht, zoals een storing bij het platform waarmee we genereren of ziekte. Dan laten we het je meteen weten, stellen we een nieuwe datum voor, en mag je het deel dat nog niet begonnen is kosteloos annuleren.</p>
      <p>Video en ander werk dat met de hand wordt geoffreerd, is op aanvraag: het formaat en de levertijd spreken we af in de schriftelijke offerte.</p>

      <h2>7. Je bestanden &amp; hoe lang we ze bewaren</h2>
      <p>Er liggen drie termijnen vast; ze verschillen in het moment waarop ze beginnen te tellen:</p>
      <ul>
        <li><strong>Bronmateriaal</strong> — de foto’s en bestanden die je uploadt worden {UPLOAD_DAYS} dagen na het afsluiten van je bestelling verwijderd. Wil je dat we ze langer bewaren, vraag dat dan schriftelijk vóór die tijd, dan spreken we het met je af.</li>
        <li><strong>Geleverde visuals</strong> — je afgeronde visuals staan {DELIVERY_DAYS} dagen na levering in VISUAILS Studio om te downloaden; daarna worden ze daar verwijderd. Een kopie kan daarna nog ten hoogste twaalf maanden in ons eigen archief staan, maar dat is geen garantie; wil je dat niet, zeg het, dan verwijderen wij hem meteen.</li>
        <li><strong>Je bestellink</strong> — de privélink waarmee je downloadt werkt tot {PORTAL_TTL_DAYS} dagen nadat je bestelling is afgesloten, daarna stopt hij. Heb je de bestanden daarna nog nodig, mail ons dan — we sturen je een nieuwe link.</li>
      </ul>
      <p>Bewaar zelf een kopie van alles waar je op vertrouwt: na {DELIVERY_DAYS} dagen kunnen we een nieuwe download niet garanderen. Heb je oudere beelden toch nog nodig, neem dan contact op — dan kijken we of ze nog bij ons staan. Hoe we verder met je persoonsgegevens omgaan, en hoe die privélink beveiligd is, staat in ons <a href="/nl/privacy/">Privacybeleid</a>.</p>

      <h2>8. Intellectueel eigendom &amp; gebruiksrechten</h2>
      <p>Je behoudt alle rechten op je eigen product- en merkmateriaal — het bronmateriaal dat je aanlevert. Daar raakt niets hiervan aan.</p>

      <p><strong>Wat je op de geleverde visuals krijgt, opgesomd en niet samengevat.</strong> Bij volledige betaling ontvang je een <strong>exclusieve, eeuwigdurende, wereldwijde en royaltyvrije licentie</strong> op de visuals die wij leveren, en die is na betaling onherroepelijk. Hij staat met opzet punt voor punt uitgeschreven: het Nederlandse recht leest zo’n licentie beperkt, dus een bevoegdheid die er niet staat is een bevoegdheid die je niet hebt gekregen (art. 2 lid 3 Auteurswet). Je mag:</p>
      <ul>
        <li><strong>verveelvoudigen en openbaar maken</strong>, in elk medium, op papier en online, in elk formaat en elke bestandsvorm;</li>
        <li><strong>bewerken en aanpassen</strong> — uitsnijden, retoucheren, hertinten, tekst erover zetten, een frame uit een video halen, een detail los gebruiken;</li>
        <li><strong>commercieel gebruiken</strong> op elke plek waar je verkoopt of adverteert: je eigen shop, marktplaatsen, betaalde campagnes, social media, print, verpakking, een beurs, een etalage;</li>
        <li><strong>sublicentiëren</strong> aan de partijen die voor je werken — je bureau, je fotograaf, je marktplaats, een wederverkoper of distributeur die jouw product verkoopt;</li>
        <li><strong>overdragen</strong> met je bedrijf of merk als dat wordt verkocht, zonder het ons te vragen.</li>
      </ul>
      <p>Niets uit die lijst verloopt, en er is geen limiet op aantallen, geen beperking naar gebied en geen looptijd. Je hoeft ons niet te vermelden.</p>

      <p><strong>En het deel dat de meeste leveranciers je niet vertellen: op een AI-beeld rust misschien helemaal geen auteursrecht.</strong> Naar Nederlands en Europees recht is een werk pas beschermd als het een eigen intellectuele schepping van een mens is. Uitvoer die een machine uit een prompt maakt, zonder creatieve menselijke keuzes erin, haalt die toets niet — een Tsjechische rechter oordeelde zo in 2023 en het Amerikaanse Copyright Office kwam op hetzelfde uit. Onze beelden zijn geen pure machine-uitvoer: ze worden met de hand gecomponeerd, gecorrigeerd en geretoucheerd, en dat menselijke werk levert wél auteursrecht op het resultaat op. Maar wij gaan je niet vertellen dat wij iets houden wat wij misschien niet houden. Deze paragraaf is daarom zo gebouwd dat de uitkomst voor jou hetzelfde is, welke kant het op valt:</p>
      <ul>
        <li><strong>Bestaat er auteursrecht</strong> op een geleverde visual, dan krijg je de licentie hierboven — exclusief, dus ook niemand anders mag dat beeld gebruiken.</li>
        <li><strong>Bestaat het niet</strong>, dan houdt niemand het, en dan kan niemand je iets verbieden. Wij doen geen beroep op een recht dat wij niet hebben, en claimen het later ook niet.</li>
      </ul>
      <p><strong>Heb je het auteursrecht overgedragen nodig in plaats van in licentie</strong> — voor een merkregistratie, een IE-lijst voor een investeerder, een due diligence — zeg het dan, dan ondertekenen wij daarvoor een akte van overdracht, kosteloos. Dat is geen formaliteit die wij kunnen overslaan: op grond van art. 2 lid 2 Auteurswet vereist overdracht een ondertekende akte, en <strong>een overdrachtsbeding in algemene voorwaarden is niet rechtsgeldig</strong>. Voorwaarden die beweren het auteursrecht aan je over te dragen doordat je bestelt, doen een belofte die de wet ze niet laat houden. Deze paragraaf doet dat niet: hij geeft je een licentie waarvoor geen akte nodig is, en een akte op verzoek.</p>
      <p><strong>Wat niemand kan overdragen.</strong> De persoonlijkheidsrechten blijven bij de maker (art. 25 Auteurswet). Wij doen afstand van het recht op naamsvermelding, zodat je ons nooit hoeft te noemen, en van ons bezwaar tegen het wijzigen van het werk — daar is het bewerkingsrecht hierboven voor. Eén recht laat de wet niet wegschrijven en dat doen wij dus ook niet: het recht om zich te verzetten tegen een verminking van het werk die de eer of naam van de maker schaadt. In de praktijk gaat dat over een beeld inzetten om iets te zeggen waarvoor het niet is gemaakt, en niet over jouw normale bewerkingen.</p>
      <p><strong>De licentie die je ons geeft, en waar die stopt.</strong> Het maken van de visuals betekent: jouw foto kopiëren, uitsnijden, bewerken en aanbieden aan de partijen die in onze <a href="/nl/data-processing-agreement/">verwerkersovereenkomst</a> staan. Voor elk van die stappen is jouw toestemming nodig, want het auteursrecht op die foto is van jou en niet van ons. Je geeft VISUAILS daarom een licentie om het aangeleverde bronmateriaal op te slaan, te kopiëren, uit te snijden, te bewerken en aan te passen, en om het aan die partijen aan te bieden, <strong>uitsluitend om jouw bestelling te maken en te leveren</strong>. Die licentie is niet-exclusief, royaltyvrij, en wereldwijd van bereik alleen omdat de infrastructuur dat is; hij duurt niet langer dan wij het materiaal onder §7 bewaren. Er gaat geen eigendom over. Wij gebruiken jouw materiaal niet voor een andere klant, niet om een eigen model of dataset op te bouwen, en niet voor een doel waar je niet om hebt gevraagd. Je kunt de licentie op elk moment schriftelijk intrekken; wij stoppen dan met het werk en verwijderen het materiaal, en wat al geleverd is blijft van jou om te gebruiken onder deze paragraaf.</p>
      <p><strong>Ons portfolio — het enige dat wij achterhouden, en waarom dat opgeschreven moet staan.</strong> De licentie hierboven is exclusief, en exclusief betekent exclusief: zonder deze alinea zouden wij inbreuk maken op jouw rechten door ons eigen werk te laten zien. Wij houden daarom één smal recht voor onszelf, en dat is de enige uitzondering in deze paragraaf. Wij mogen <em>geleverde visuals</em> — nooit jouw bronmateriaal — in ons portfolio, in een casus en op onze eigen kanalen laten zien, tenzij je ons schriftelijk vraagt dat niet te doen. Wij mogen ze niet verkopen, niet aan iemand anders in licentie geven, en niet gebruiken om een ander product aan te prijzen. Staat er op een geleverde visual een herkenbaar persoon uit jouw materiaal, dan tonen wij hem alleen als die persoon daar zelf mee heeft ingestemd.</p>
      <p>Er zitten twee grenzen op, en de eerste is de commercieel belangrijke. <strong>Is het product op het beeld nog niet openbaar te koop, dan publiceren wij niets</strong> voordat jij het hebt gelanceerd of schriftelijk ja hebt gezegd, wat eerder komt — een visual van een product dat nog niet uit is, is eerst jouw bedrijfsgeheim en daarna ons visitekaartje. En je kunt dit op elk moment intrekken, met één regel per e-mail, ook jaren later en ook voor werk dat al op onze site staat; dan halen wij het weg. Wij vragen het liever dan dat wij het aannemen, en een leverancier die een beding nodig heeft om werk te blijven tonen dat een klant hem heeft gevraagd weg te halen, heeft een groter probleem dan een portfolio.</p>

      <!-- Zie de Engelse tegenhanger voor de noot: dit is de uitzondering die
           er tot 2 september 2026 niet stond, terwijl de gedeelde set al op
           /plans beloofd werd. -->
      <p><strong>Eén uitzondering, en dat is de gedeelde maandset.</strong> Alles hierboven gaat over een <em>bestelling</em>, en daar is de licentie exclusief. Voor de merkneutrale set die bij een abonnement hoort kan dat niet, want dezelfde beelden gaan naar elk merk met een abonnement: daar is je licentie <strong>niet-exclusief</strong>. Alles uit de lijst hierboven geldt nog steeds — verveelvoudigen, bewerken, commercieel gebruiken, sublicentiëren, meenemen bij verkoop van het bedrijf, geen limiet op aantallen of gebied, geen looptijd — en de AI-vermelding ook. Wat er niet geldt is exclusiviteit: een beeld dat jij plaatst kan bij een ander merk opduiken, net zoals een gezicht uit onze gedeelde modellenbibliotheek. In het licentiebestand dat met de set meekomt staat welke van de twee je krijgt, en wij noemen een gedeeld beeld nergens exclusief. Beeld dat alleen van jou is, is een gewone bestelling of <a href="/nl/editions/">Editions</a>, en dat valt onder de alinea's hierboven. <strong>Zeg je op, dan blijft de niet-exclusieve licentie staan</strong> op alles wat je tot dat moment hebt opgehaald — er hoeft niets offline; je krijgt alleen geen nieuwe sets meer.</p>

      <h2>9. Betaling &amp; btw</h2>
      <p>Betaling verloopt via onze betaalprovider. Facturen worden uitgereikt voor je administratie. Voor zakelijke klanten in de EU met een geldig btw-nummer kan de btw-verleggingsregeling van toepassing zijn wanneer aan de voorwaarden is voldaan; anders gelden de Nederlandse btw-regels. Je bent verantwoordelijk voor het aanleveren van correcte facturatie- en btw-gegevens.</p>
      <!-- Zie de noot bij dezelfde alinea in terms.astro (19 september 2026). -->
      <p>Een proef kost een vast bedrag van {euro(AMOUNT.testSample, 'nl')} exclusief btw, dat je bij het afrekenen betaalt. Een bestelling met een vermelde prijs betaal je ook bij het afrekenen, direct nadat je hem hebt geplaatst. Moeten wij eerst je btw-gegevens controleren, of wordt de prijs met de hand geoffreerd (video, werk op maat), dan krijg je in plaats daarvan één betaallink per e-mail en in VISUAILS Studio. In alle gevallen betaal je het bedrag in één keer; er zijn geen termijnen. We beginnen pas met de productie, en geven afgeronde bestanden pas vrij, als die betaling binnen is. Een gereserveerde leverdatum houden we zeven dagen vast terwijl de betaling openstaat, zoals in artikel 6 staat.</p>

      <h2>9a. Abonnementen</h2>
      {/* ── VAN SLOTS NAAR CREDITS — 20 september 2026 ────────────────────
          Deze alinea beschreef het oude systeem: een vast aantal slots PER
          SOORT, met “een compleet product” als eenheid. Allebei kloppen ze niet
          meer. Sinds de overstap op credits krijgt een abonnement één saldo dat
          aan elke dienst besteed mag worden, en “Compleet” bestaat als product
          niet meer — het heet nu catalog + lifestyle en is twee diensten op
          hetzelfde product. De rest van dit artikel is ongewijzigd: alleen de
          EENHEID verandert, niet wat er beloofd wordt. */}
      <p>Een abonnement is een doorlopende afspraak waarbij je elke maand een vast aantal <strong>credits</strong> krijgt, in een vaste week die wij voor je vrijhouden, vanaf de dag van de maand die jij kiest. Credits zijn één saldo: elke dienst kost er een aantal, en je bepaalt zelf waaraan je ze uitgeeft. Hoeveel credits een dienst kost en hoeveel je er per maand krijgt, staat in VISUAILS Studio en op de abonnementenpagina; bij het {planName('brand', 'nl')}-abonnement hoort daarnaast je merkmodel, en bij {planName('studio', 'nl')} ook, op allebei de termijnen van twaalf maanden. Wat elk abonnement precies bevat en wat het kost, staat op de <a href="/nl/plans/">abonnementenpagina</a>; die aantallen en bedragen gelden zoals ze daar staan op het moment dat je afsluit.</p>

      <p><strong>Een product invullen en vastzetten.</strong> Je zet in VISUAILS Studio op je lijst wat je gemaakt wilt hebben en doet je foto’s erbij. Dat kost nog niets: een item op de lijst is een concept. Het wordt werk op het moment dat je het vastzet, en dan gaan de credits van die dienst van je saldo af. Vastzetten is wat ons de opdracht geeft, dus een item dat bij het begin van je week nog een concept is, wordt niet gemaakt en blijft op je lijst staan. Je kunt een vastgezet item weer losmaken, en dan komen die credits direct terug, tot het moment dat je week begint. Daarna is het in productie.</p>

      <p><strong>Hoe het begint.</strong> Bij het afsluiten betaal je meteen je eerste maand, en diezelfde betaling is de transactie waarmee je bank de machtiging afgeeft — zonder die betaling kan er later niets worden afgeschreven. Je eerste maand begint dus direct; de tweede termijn valt een maand later. Vanaf dat moment schrijft onze betaaldienst het maandbedrag automatisch af op basis van die machtiging. Op de vooruitbetaalde termijn is er geen machtiging en geen latere afschrijving: zie hieronder.</p>

      <p><strong>Drie termijnen.</strong> De maandelijkse termijn kun je <strong>elke maand opzeggen</strong>; er is geen minimale looptijd. De termijn van twaalf maanden ligt vast: die loopt twaalf termijnen en stopt daarna vanzelf. Daar staat tegenover dat hij drie dingen geeft die de maandelijkse niet geeft — drie maanden doorschuiven in plaats van één, je tarief dat twaalf maanden lang niet meebeweegt met onze prijslijst, en bij {planName('studio', 'nl')} het merkmodel erbij. Een vaste week elke maand heeft elk abonnement, ook het maandelijkse; hij begint op de dag van de maand die jij kiest. De <strong>vooruitbetaalde termijn van twaalf maanden</strong> heeft die drie ook, en wordt in één betaling aan het begin voldaan: je betaalt daarbij minder maanden dan je er krijgt. Hoeveel dat er zijn, hangt van het abonnement af en staat vóór het betalen op de <a href="/nl/plans/">abonnementenpagina</a>.</p>

      <p><strong>Vooruitbetalen, en tussentijds stoppen.</strong> Een vooruitbetaald jaar wordt <strong>niet terugbetaald</strong>. Daar staat de korting tegenover, en dat is precies waarom deze termijn bestaat: het jaar is betaald, dus wij kunnen je week twaalf maanden vasthouden zonder van twaalf afschrijvingen af te hangen. Stop je halverwege, dan raak je niet kwijt waarvoor je hebt betaald: zeg je op, dan <strong>loopt je jaar gewoon door tot het einde</strong>. De maanden waarvoor je al betaald hebt komen normaal binnen, <strong>per maand</strong>, met dezelfde credits en dezelfde week — niet in één keer als één saldo, want een heel jaar dat op één dag wordt opgeëist, is meer dan één studio kan maken. Een vooruitbetaald jaar wordt nooit vanzelf verlengd, of je nu opzegt of niet; na de twaalfde maand stopt het. Het wordt niet omgezet in tegoed en niet in geld uitbetaald.</p>

      <p><strong>Ongebruikte credits.</strong> Wat je in een maand niet hebt vastgezet, schuift door naar de volgende maand — één maand op de maandelijkse termijn, drie maanden op allebei de termijnen van twaalf maanden. In VISUAILS Studio staat tot en met welke datum je doorgeschoven credits kunt gebruiken. Daarna vervallen ze. Ze stapelen niet verder op: op de maandelijkse termijn heb je dus nooit meer dan twee maanden aan credits tegelijk, en de oudste gaan altijd als eerste op. Een abonnement is gereserveerde capaciteit in onze agenda, en een maand die voorbij is, is voorbij.</p>

      <p><strong>Opzeggen.</strong> Je zegt zelf op in VISUAILS Studio; je hoeft ons daarvoor niet te mailen en er is geen opzegtermijn. Zodra je opzegt stoppen wij de incasso, en er wordt daarna niets meer afgeschreven. De maand waarvoor je al betaald hebt, blijft gewoon van jou: de credits van die maand kun je tot het einde ervan nog vastzetten. Credits die uit eerdere maanden zijn doorgeschoven, gaan met de opzegging mee weg — doorschuiven is een belofte over een volgende maand, en na opzeggen is er geen volgende maand. Daarna sluit het abonnement. Wij betalen de lopende maand niet terug — die is geleverd in de vorm van beschikbare capaciteit — en je krijgt er ook niets voor in de plaats. Op een vooruitbetaald jaar werkt opzeggen zoals hierboven staat onder <em>Vooruitbetalen</em>.</p>

      <p><strong>Pauzeren.</strong> Je kunt je abonnement zelf pauzeren. Dat stopt de volgende afschrijving. Je saldo blijft staan en schuift door volgens dezelfde regel als altijd, en zodra je hervat begint de incasso opnieuw vanaf de eerstvolgende termijn. Je hoeft daarvoor geen nieuwe machtiging af te geven.</p>

      <p><strong>Als een afschrijving mislukt.</strong> Dan zetten wij het abonnement op pauze en laten we het je weten. Je credits blijven staan, maar er kan niets worden vastgezet zolang de maand niet betaald is. Komt de betaling alsnog binnen, dan loopt het abonnement door alsof er niets gebeurd is.</p>

      <p><strong>Wat er gebeurt met wat al gemaakt is.</strong> Alles wat je tijdens je abonnement hebt laten maken en geleverd hebt gekregen, blijft van jou onder dezelfde gebruiksrechten als elke andere bestelling — zie paragraaf 8. Opzeggen verandert daar niets aan. Voor hoe lang wij je bestanden bewaren geldt paragraaf 7.</p>

      <p><strong>Er is een grens aan het aantal abonnementen.</strong> Een abonnement is gereserveerde capaciteit bij één studio, en die capaciteit is eindig. Wij kunnen daarom een nieuw abonnement weigeren wanneer de agenda vol zit. Dat merk je vóór je betaalt en niet erna: is er geen plek, dan kun je niet afsluiten.</p>

      <p><strong>Prijswijzigingen.</strong> Wij kunnen de prijs van een abonnement wijzigen. Op allebei de termijnen van twaalf maanden geldt je tarief twaalf maanden ongewijzigd. Op de maandelijkse termijn laten we een wijziging minimaal één volledige maand van tevoren weten, zodat je nog vóór de eerstvolgende afschrijving kunt opzeggen. Wij wijzigen nooit met terugwerkende kracht.</p>

      <p><strong>Wat een abonnement niet is.</strong> Het is geen tegoedbon, en een jaar vooruitbetalen maakt er ook geen tegoedbon van: je koopt elke maand een vast aantal credits en een plek in de agenda, en die plek is er ook in een maand waarin je niets bestelt. Wat je vooruitbetaalt zijn die maanden, en niet een tegoed om aan los werk uit te geven. Wat je abonnement niet dekt — een soort werk dat er niet in zit, of meer dan je credits toekennen — kun je gewoon los bijbestellen tegen de gewone prijs.</p>

      <h2>10. Annuleringen, terugbetalingen en herstel</h2>
      <p>Omdat visuals worden gemaakt volgens je specifieke briefing, kan werk dat al is gestart of geleverd doorgaans niet worden geannuleerd voor een terugbetaling.</p>
      <p>Bij elke bestelling vragen we of je tevreden bent met wat je hebt gekregen. Ben je dat niet, laat dan weten wat er niet klopt, dan nemen we het samen door — per beeld, in VISUAILS Studio. Wat er daarna gebeurt, hangt af van welk van deze vier het is:</p>
      {/* Zie de noot bij §10 in de Engelse voorwaarden: het beleid staat als
          REVISIEBELEID in pricing.js en wordt hier alleen uitgelezen. */}
      <ul>
        {revisiebeleid('nl').map(([kop, regel]) => (
          <li><strong>{kop}.</strong> {regel}</li>
        ))}
      </ul>
      <p>Wat we afspreken heeft betrekking op de briefing waarmee we hebben gewerkt; een substantieel nieuwe richting is een nieuwe bestelling en geen correctie. Terugbetalingen zijn naar onze redelijke beoordeling en worden per geval beoordeeld.</p>
      <p><strong>Tegoed in plaats van geld terug.</strong> Betalen wij een bestelling terug, dan kun je ervoor kiezen het bedrag als tegoed op je account te laten staan; dat is altijd jouw keuze en nooit vanzelf. Het tegoed gaat automatisch af van je volgende bestelling als je die plaatst terwijl je bent ingelogd in VISUAILS Studio. Het wordt verrekend met het totaal inclusief btw, en je factuur toont gewoon het volledige bedrag, met daaronder het verrekende tegoed en wat je nog betaalt. Tegoed vervalt niet en wordt niet in geld uitbetaald: wordt een bestelling die je met tegoed betaalde geannuleerd, dan komt dat deel terug als tegoed.</p>


      <h2>10a. Herroepingsrecht voor consumenten</h2>
      <p>Bestel je als consument — dus niet in het kader van een beroep of bedrijf — dan heb je bij een overeenkomst op afstand in beginsel veertien dagen bedenktijd. Op onze dienst zijn daarop twee wettelijke uitzonderingen van toepassing, en die staan hieronder omdat je ze moet kennen voordat je bestelt.</p>
      <p><strong>Maatwerk.</strong> Elke visual wordt gemaakt uit de productfoto’s die jij aanlevert en volgens de briefing die jij opgeeft. Het is daarmee volgens jouw specificaties vervaardigd en duidelijk gepersonaliseerd, en valt om die reden buiten het herroepingsrecht.</p>
      <p><strong>Volledig uitgevoerde dienst.</strong> Bij het plaatsen van je bestelling bevestig je dat je zakelijk bestelt, en in diezelfde verklaring vraag je ons — voor het geval het consumentenrecht toch op je van toepassing is — uitdrukkelijk om direct te beginnen en verklaar je dat je je herroepingsrecht verliest zodra de bestelling is geleverd. We leggen die bevestiging vast bij je bestelling, samen met de tekst die je op dat moment hebt gezien. Zonder die bevestiging beginnen we niet.</p>
      <p>Zolang er nog niet geleverd is en je die bevestiging niet hebt gegeven, kun je je bestelling binnen de bedenktijd kosteloos herroepen. Heb je al betaald, dan krijg je dat bedrag terug. Neem daarvoor contact op via hello@visuails.com — dat is voldoende, een formulier is niet nodig.</p>
      <p>Dit alles geldt alleen voor consumenten. Bestel je namens een bedrijf, dan is het herroepingsrecht niet van toepassing en gelden paragraaf 10 en de rest van deze voorwaarden.</p>

      <h2>11. Aansprakelijkheidsbeperkingen</h2>
      <p>We leveren de dienst met redelijke vaardigheid en zorg, maar voor zover wettelijk toegestaan zijn we niet aansprakelijk voor indirecte of gevolgschade, gederfde winst of schade die voortvloeit uit je gebruik van de visuals. Onze totale aansprakelijkheid voor een bestelling is beperkt tot het bedrag dat je voor die bestelling hebt betaald. Niets in deze voorwaarden sluit aansprakelijkheid uit die wettelijk niet kan worden uitgesloten.</p>
      <p><strong>Waarvoor jij ons vrijwaart, en waar dat stopt.</strong> Paragraaf 5 is jouw garantie over het materiaal dat je aanlevert; dit is wat er geldt als die garantie onjuist blijkt. Stelt een derde ons aansprakelijk vanwege het bronmateriaal dat jij hebt aangeleverd, of vanwege de manier waarop jij de geleverde visuals hebt gebruikt of gepubliceerd, dan vrijwaar je ons voor die aanspraak en voor de redelijke kosten van verweer. Dat gaat over drie dingen en niets daarbuiten: materiaal waar je de rechten niet op had, een persoon op dat materiaal zonder grondslag om zijn beeltenis te gebruiken, en een publicatieplicht die bij jou ligt en niet bij ons — de AI-vermelding in <a href="/nl/ai-act/">onze AI Act-verklaring</a> is daarvan het duidelijkste voorbeeld.</p>
      <p>Er horen drie grenzen bij, want een vrijwaring zonder die grenzen is een beding waar niemand iets mee kan:</p>
      <ul>
        <li><strong>Wij melden het op tijd.</strong> Komt er een aanspraak, dan laten wij het je zonder onredelijke vertraging weten en geven wij door wat wij hebben ontvangen, zodat je kunt handelen op het moment dat het nog uitmaakt.</li>
        <li><strong>Jij mag het verweer voeren.</strong> Je mag het overnemen met een advocaat van je eigen keuze, en wij werken daaraan mee. Wij schikken niets en erkennen niets zonder jouw schriftelijke instemming, en jij schikt niet op voorwaarden die ons tot iets verplichten zonder onze instemming.</li>
        <li><strong>Het stopt waar ons eigen handelen begint.</strong> Dit dekt geen aanspraak voor zover die het gevolg is van een tekortkoming van ons in deze voorwaarden, van onze eigen nalatigheid, of van iets wat wij op eigen initiatief aan het werk hebben toegevoegd in plaats van uit jouw briefing.</li>
      </ul>
      <p>Deze paragraaf geldt voor zakelijke klanten, en dat is volgens paragraaf 3 iedereen aan wie wij leveren. Heb je toch als consument besteld, dan geldt deze paragraaf voor jou helemaal niet — een vrijwaring van deze soort kun je een consument niet opleggen, en een beding dat het tegendeel suggereert zou nietig zijn en niet slechts ongebruikt.</p>

