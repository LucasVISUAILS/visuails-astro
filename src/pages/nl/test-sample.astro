---
import { waHref } from '../../data/whatsapp.js';
// VISUAILS — test sample. Ported from
// /tmp/visuails-rebuild/src/routes/test-sample/+page.svelte: a 2-step
// request wizard (style/model/product -> contact) inside one <form>.
//
// The Svelte source used $state(step) with class:hidden-step to keep both
// steps mounted so field values survive stepping back and forth. This is a
// static Astro page (no client framework state), so the step-switching is
// reimplemented as vanilla JS below, keeping the exact same markup/fields
// and the same "both steps stay in the DOM" behavior.
import Layout from '../../layouts/Layout.astro';
import { TEST_SAMPLE, turnaround, CATALOG_IMAGES, LIFESTYLE_IMAGES } from '../../data/pricing.js';

// De €1 stond op vier plekken ingetypt en de leverstap beloofde
// "~24 uur" — een cijfer dat de capaciteitspoort nooit heeft goedgekeurd. Het
// zijn tier-feiten, dus ze komen nu uit pricing.js. "Geen abonnement" ging mee:
// dat klopt niet meer sinds de maandplannen live gingen, en /faq en /about
// zijn om precies die reden al gecorrigeerd. De proef loopt via de losse-
// producten-lane en noemt dus die doorlooptijd, niets snellers.
// Sinds 9 augustus 2026 geldt hetzelfde voor de OMSCHRIJVING van dat bedrag. Het
// heette "verificatie", en dat woord beloofde een controle die er niet is — zie de
// noot bij TEST_SAMPLE in pricing.js. De zin staat nu als `feeNote` in dat bestand,
// want hij stond op elf plekken los ingetypt.
const SAMPLE = TEST_SAMPLE.nl;
const TIMING = turnaround('unattended', 'nl');

// w/h are the intrinsic pixel size of each file in public/img — the .choice
// tile crops with object-fit, so these only reserve the aspect-ratio box.
const styles = [
  { value: 'Phone-made', photo: '/img/lifestyle-phone-made-01.webp', w: 2400, h: 1792 },
  { value: 'Glow', photo: '/img/lifestyle-glow-01.webp', w: 1340, h: 2400 },
  { value: 'Flash', photo: '/img/lifestyle-flash-01.webp', w: 928, h: 1152 },
  { value: 'Dunes', photo: '/img/lifestyle-dunes-01.webp', w: 928, h: 1152 },
];
// Nine of the ten roster headshots were produced at 1195x1600; model-rae.webp
// is the exception at 800x1071. Assuming one size for the family would have
// put a wrong box under Rae, so the exception is named.
const ROSTER_ODD: Record<string, [number, number]> = { Rae: [800, 1071] };
const roster = ['Aaron', 'Ava', 'Dana', 'Elias', 'Fabi', 'Lisa', 'Maegan', 'Rae', 'Ryan', 'Seme']
  .map((name) => {
    const [w, h] = ROSTER_ODD[name] ?? [1195, 1600];
    return { name, photo: `/img/model-${name.toLowerCase()}.webp`, w, h };
  });

// Lucas, 2026-07-30: zie de Engelse tak voor de volledige toelichting — deze
// keuze (catalog of lifestyle, één keer gemaakt) heeft geen eigen backend
// nodig. /api/order schrijft elk veld dat geen eigen kolom heeft al naar
// details_json, precies zoals `style` en `model` hieronder al doen.
const sampleTypes = [
  { value: 'catalog', label: 'Catalog', photo: '/img/catalog-after.webp', w: 1800, h: 1800, alt: 'Voorbeeld van een catalog-productfoto, op een egale ondergrond' },
  { value: 'lifestyle', label: 'Lifestyle', photo: '/img/lifestyle-glow-03.webp', w: 768, h: 1376, alt: 'Voorbeeld van een lifestyle-productfoto, gestyled in een scène' },
];
---

<Layout
  title="Test VISUAILS met 1 product — proefvisual"
  description="Stuur dezelfde foto’s als bij een gewone bestelling en krijg vier catalogbeelden of een lifestyle-carousel van drie foto’s terug. Eén proef per bedrijf, door een specialist gecontroleerd."
>
  <!-- HERO -->
  <section class="page-hero"><div class="container">
    <span class="eyebrow-page">Proefvisual</span>
    <h1 class="display" style="font-size:clamp(2.4rem,5vw,4rem)">Test VISUAILS met <span class="accent-word">1 product</span></h1>
    <p class="lead" style="margin-top:1.2rem">Je levert aan zoals bij een gewone bestelling — voorkant en achterkant in elk geval, plus een detail- of draagfoto als je die hebt — en je krijgt {SAMPLE.deliverable} terug. Precies wat je bij een betaalde bestelling per product krijgt. Hoe meer je meestuurt, hoe beter we het kunnen maken.</p>
    <div class="chip-row" style="margin-top:1.8rem">
      <span class="chip"><span class="dot"></span>{CATALOG_IMAGES} beelden, of {LIFESTYLE_IMAGES}</span>
      <span class="chip"><span class="dot"></span>Slechts {SAMPLE.price}</span>
      <span class="chip"><span class="dot"></span>Met de hand gecontroleerd</span>
    </div>
  </div></section>

  <!-- WHAT YOU GET -->
  <section class="section-tight">
    <div class="container two-col">
      <div class="reveal pending">
        <h2>{SAMPLE.deliverable}, van je eigen product.</h2>
        <p style="margin-top:1.1rem;color:var(--ink-3);max-width:52ch">Dezelfde productie en menselijke controle die we bij elke betaalde bestelling gebruiken — de eerlijke manier om de kwaliteit te beoordelen voordat je je vastlegt.</p>
        <ul class="checklist" style="margin-top:1.4rem">
          <li><svg viewBox="0 0 24 24" class="i" aria-hidden="true"><path d="M20 6L9 17l-5-5" /></svg><span>Kies je catalog: {CATALOG_IMAGES} beelden — voorkant, achterkant, een stof- of logodetail, en één op een model.</span></li>
          <li><svg viewBox="0 0 24 24" class="i" aria-hidden="true"><path d="M20 6L9 17l-5-5" /></svg><span>Kies je lifestyle: {LIFESTYLE_IMAGES} foto’s in één gestylede look — een scène, één op een model, en een detailclose-up.</span></li>
          <li><svg viewBox="0 0 24 24" class="i" aria-hidden="true"><path d="M20 6L9 17l-5-5" /></svg><span>In hoge resolutie, als downloadlink per e-mail.</span></li>
          <li><svg viewBox="0 0 24 24" class="i" aria-hidden="true"><path d="M20 6L9 17l-5-5" /></svg><span>Een echte blik op onze belichting, kadrering en afwerking.</span></li>
          <li><svg viewBox="0 0 24 24" class="i" aria-hidden="true"><path d="M20 6L9 17l-5-5" /></svg><span>Door een persoon gecontroleerd voordat het je bereikt.</span></li>
          <li><svg viewBox="0 0 24 24" class="i" aria-hidden="true"><path d="M20 6L9 17l-5-5" /></svg><span>Eenmalig {SAMPLE.feeNote}, één proef per bedrijf.</span></li>
        </ul>
      </div>
      <div class="reveal pending">
        <div class="photo-band">
          <img src="/img/lifestyle-glow-03.webp" alt="Voorbeeld van een VISUAILS-visual, Glow-stijl" loading="lazy" decoding="async" width="768" height="1376" />
          <div class="scrim"></div>
          <div class="caption"><p style="margin:0">Jouw proef, met de hand gecontroleerd</p></div>
        </div>
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section>
    <div class="container">
      <div class="section-head">
        <h2>Hoe de proef werkt</h2>
        <p>Vier korte stappen van jouw foto tot een afgewerkte set in je inbox.</p>
      </div>
      <div class="steps">
        <div class="step reveal pending"><div class="step-n">01</div><h3>Upload je productfoto’s</h3><p>Voorkant en achterkant in elk geval, en een detail- of draagfoto als je die hebt.</p></div>
        <div class="step reveal pending"><div class="step-n">02</div><h3>Kies een stijl</h3><p>Kies de look en, als je wilt, een model — of laat ons kiezen.</p></div>
        <div class="step reveal pending"><div class="step-n">03</div><h3>Wij maken het</h3><p>Geproduceerd in onze studio, daarna met de hand gecontroleerd.</p></div>
        <div class="step reveal pending"><div class="step-n">04</div><h3>Ontvang per e-mail</h3><p>Je afgewerkte beelden komen binnen als downloadlink — {TIMING.toLowerCase()}.</p></div>
      </div>
    </div>
  </section>

  <!-- INPUT GUIDANCE -->
  <section class="section-tight">
    <div class="container">
      <div class="section-head">
        <h2>Scherpe foto erin, publicatieklaar beeld eruit</h2>
        <p>Hoe duidelijker je input, hoe beter de visual die we ervan kunnen bouwen.</p>
      </div>
      <div class="grid grid-2">
        <div class="card reveal pending">
          <h3 style="color:var(--ink)">Doen</h3>
          <ul class="checklist" style="margin-top:1rem">
            <li><svg viewBox="0 0 24 24" class="i" aria-hidden="true"><path d="M20 6L9 17l-5-5" /></svg><span>Helder en haarscherp</span></li>
            <li><svg viewBox="0 0 24 24" class="i" aria-hidden="true"><path d="M20 6L9 17l-5-5" /></svg><span>Neutrale, rustige achtergrond</span></li>
            <li><svg viewBox="0 0 24 24" class="i" aria-hidden="true"><path d="M20 6L9 17l-5-5" /></svg><span>Goede, gelijkmatige belichting</span></li>
            <li><svg viewBox="0 0 24 24" class="i" aria-hidden="true"><path d="M20 6L9 17l-5-5" /></svg><span>Het hele product in beeld</span></li>
          </ul>
        </div>
        <div class="card reveal pending">
          <h3 style="color:var(--ink-3)">Niet doen</h3>
          <ul class="checklist" style="margin-top:1rem">
            <li><svg viewBox="0 0 24 24" class="i" style="stroke:var(--ink-3)" aria-hidden="true"><path d="M18 6L6 18M6 6l12 12" /></svg><span>Wazige foto’s of foto’s met een lage resolutie</span></li>
            <li><svg viewBox="0 0 24 24" class="i" style="stroke:var(--ink-3)" aria-hidden="true"><path d="M18 6L6 18M6 6l12 12" /></svg><span>Donkere of sterk beschaduwde foto’s</span></li>
            <li><svg viewBox="0 0 24 24" class="i" style="stroke:var(--ink-3)" aria-hidden="true"><path d="M18 6L6 18M6 6l12 12" /></svg><span>Drukke of afleidende achtergronden</span></li>
            <li><svg viewBox="0 0 24 24" class="i" style="stroke:var(--ink-3)" aria-hidden="true"><path d="M18 6L6 18M6 6l12 12" /></svg><span>Zware filters of watermerken</span></li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- REQUEST WIZARD -->
  <section>
    <div class="container narrow">
      <div class="section-head">
        <h2>Vraag je proefvisual aan</h2>
        <p>Twee snelle stappen. Vertel ons de look die je wilt, daarna waar we die naartoe sturen.</p>
      </div>
      <div class="card" style="padding:clamp(1.4rem,3vw,2.4rem)">
        <!-- Weigeringen komen van /api/order terug als een redirect met ?error=…,
             omdat dit formulier een gewone POST doet en geen fetch. Deze blokken
             zijn waar dat landt; initFormRefusal() in interactions.js haalt het
             `hidden` van het passende blok en zet de focus erop. In de opmaak en
             niet vanuit JS, zodat de tekst mee vertaald wordt met de rest van de
             pagina en in een diff te zien is.

             role="status" en niet role="alert": de bezoeker is zojuist genavigeerd,
             dus dit is de toestand van de pagina waar hij aankomt — niet iets dat
             hem onderbrak. -->
        <div class="ts-refused" data-form-refusal="sample-used" role="status" tabindex="-1" hidden>
          <strong>Je hebt je proefvisual al gehad.</strong>
          Het is er één per bedrijf, dus er is niets besteld en er is niets afgeschreven —
          je hebt hier niet voor betaald.
          Klaar voor het echte werk? De <a href="/nl/start">gewone diensten</a> beginnen bij één
          product, zonder minimumafname — of <a href="/nl/contact">stuur ons een bericht</a> als die
          eerste proef nooit is aangekomen, of als een collega hem zonder overleg heeft besteld.
        </div>
        <div class="ts-refused" data-form-refusal="email" role="status" tabindex="-1" hidden>
          <strong>Dat e-mailadres kwam er niet doorheen.</strong>
          Kijk het even na op een typefout en verstuur opnieuw — het is het adres waar de
          afgewerkte visual naartoe gaat.
        </div>
        <form action="/api/order" method="post" data-wizard novalidate>
          <input type="hidden" name="service" value="test-sample" />
          <input type="hidden" name="redirect" value="/nl/thank-you" />
          <input type="hidden" name="lang" value="nl" />
          <!-- The photographs do NOT travel in this POST. /api/order refuses to
               read File entries by design, so they are staged into R2 by
               /api/upload first and this field carries the batch id that ties
               them to the order. initTestSampleUpload() in interactions.js
               writes it; empty here is the correct initial state. -->
          <input type="hidden" name="upload_batch" value="" />
          <input type="text" name="company_hp" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0" />
          <div class="progress" aria-hidden="true"><i data-wizard-progress style="transform:scaleX(.5)"></i></div>

          <!-- STEP 1 -->
          <div data-wizard-step="1">
            <h3 style="margin-bottom:.4rem">Stap 1 &middot; Stijl, model &amp; product</h3>
            <p class="hint" style="margin-bottom:1.4rem">Kies de look die je zoekt en upload je productfoto.</p>

            <div class="field">
              <p class="ts-group-h" id="ts-type-h">Wat wil je zien? <span class="req">*</span></p>
              <div class="choice-grid" role="radiogroup" aria-labelledby="ts-type-h">
                {sampleTypes.map((t, i) => (
                  <label class="choice">
                    <input type="radio" name="sample_type" value={t.value} required={i === 0} />
                    <div class="choice-media"><img src={t.photo} alt={t.alt} loading="lazy" decoding="async" width={t.w} height={t.h} /></div>
                    <div class="choice-label">{t.label}</div>
                  </label>
                ))}
              </div>
              <span class="hint" style="margin-top:.3rem">Catalog is een strakke foto van het product op zichzelf. Lifestyle is het product gestyled in een scène, op een model. Wat voor je shop nu het belangrijkst is, is ook wat je zou moeten testen.</span>
            </div>

            <div class="field">
              <p class="ts-group-h" id="ts-style-h">Kies een look</p>
              <span class="hint" style="margin-bottom:.3rem">Voor een lifestyle-proef. Sla dit over als je hierboven catalog koos — een catalogproef loopt op een egale ondergrond, niet op een van deze looks.</span>
              <div class="choice-grid" role="radiogroup" aria-labelledby="ts-style-h">
                {styles.map((s) => (
                  <label class="choice">
                    <input type="radio" name="style" value={s.value} />
                    <div class="choice-media"><img src={s.photo} alt={`${s.value} lifestylestijl`} loading="lazy" decoding="async" width={s.w} height={s.h} /></div>
                    <div class="choice-label">{s.value}</div>
                  </label>
                ))}
              </div>
            </div>

            <div class="field">
              <p class="ts-group-h" id="ts-model-h">Kies een model</p>
              <span class="hint" style="margin-bottom:.3rem">Optioneel voor de meeste producten — handig voor kleding en accessoires.</span>
              <div class="choice-grid" role="radiogroup" aria-labelledby="ts-model-h">
                {roster.map((m) => (
                  <label class="choice">
                    <input type="radio" name="model" value={m.name} />
                    <div class="choice-media"><img src={m.photo} alt={m.name} loading="lazy" decoding="async" width={m.w} height={m.h} /></div>
                    <div class="choice-label">{m.name}</div>
                  </label>
                ))}
                <label class="choice">
                  <input type="radio" name="model" value="VISUAILS choose" />
                  <div class="choice-media mono"><div class="mono-av"><svg viewBox="0 0 24 24" class="i" style="width:26px;height:26px;color:var(--accent-bright)" aria-hidden="true"><path d="M12 2l2.4 7.4H22l-6 4.6 2.3 7.4-6.3-4.6L5.7 21.4 8 14 2 9.4h7.6z" /></svg></div></div>
                  <div class="choice-label">Laat VISUAILS kiezen</div>
                </label>
              </div>
            </div>

            <div class="field">
              <label for="ts-upload">Upload productfoto’s <span class="req">*</span></label>
              <label class="dropzone" for="ts-upload">
                <svg viewBox="0 0 24 24" class="i" aria-hidden="true"><path d="M12 16V4M6 10l6-6 6 6M4 20h16" /></svg>
                <div><strong>Klik om te uploaden</strong> of sleep foto’s hierheen</div>
                <div class="hint" style="margin-top:.4rem">Eén duidelijke foto volstaat — maar voor-, achterkant, een detail en de stof geven het beste resultaat.</div>
                <!-- No `name`, for the same reason /start's file input has none:
                     nothing about this control belongs in the form POST.
                     Visually hidden via .ts-file-input rather than `hidden`:
                     a display:none input cannot be focused or activated, so the
                     picker was unreachable by keyboard entirely. -->
                <input type="file" id="ts-upload" accept="image/*" multiple class="ts-file-input" />
              </label>
              <ul class="ts-list" data-ts-list></ul>
              <p class="ts-count" data-ts-count aria-live="polite"></p>
              <p class="ts-msg" data-ts-msg role="status"></p>
              <span class="hint">Meer hoeken helpen ons je product precies te matchen — zie <a href="/nl/upload-guidelines" style="color:var(--accent-bright)">wat je moet sturen</a>.</span>
            </div>

            <div class="field">
              <label for="ts-notes">Nog iets wat we moeten weten?</label>
              <textarea class="textarea" id="ts-notes" name="notes" placeholder="Optioneel — kleuren die kloppend moeten blijven, een hoek die je verkiest, iets specifieks over het product."></textarea>
            </div>

            <div class="flex" style="justify-content:flex-end;margin-top:.4rem">
              <button type="button" class="btn btn-primary" data-wizard-next>Volgende
                <svg viewBox="0 0 24 24" class="i" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
              </button>
            </div>
          </div>

          <!-- STEP 2 -->
          <div data-wizard-step="2" class="hidden-step">
            <h3 style="margin-bottom:.4rem">Stap 2 &middot; Details &amp; contact</h3>
            <p class="hint" style="margin-bottom:1.4rem">Waar zullen we je afgewerkte proef naartoe sturen?</p>

            <div class="row-2">
              <div class="field">
                <label for="ts-name">Naam <span class="req">*</span></label>
                <input class="input" type="text" id="ts-name" name="name" autocomplete="name" required />
              </div>
              <div class="field">
                <label for="ts-brand">Merk- of winkelnaam <span class="req">*</span></label>
                <input class="input" type="text" id="ts-brand" name="brand" autocomplete="organization" required />
              </div>
            </div>

            <h4 style="margin:.6rem 0 1rem">Contact</h4>
            <div class="row-2">
              <div class="field">
                <label for="ts-email">E-mail <span class="req">*</span></label>
                <input class="input" type="email" id="ts-email" name="email" autocomplete="email" required />
              </div>
              <div class="field">
                <label for="ts-phone">Telefoon <span class="hint" style="font-weight:400">— optioneel</span></label>
                <input class="input" type="tel" id="ts-phone" name="phone" autocomplete="tel" placeholder="+31 6 &hellip;" />
                <span class="hint">Voeg het toe als je wilt dat we je op WhatsApp berichten — vermeld je landcode.</span>
              </div>
            </div>

            <p class="hint" style="margin:.4rem 0 1.4rem">Je proef wordt geleverd via een downloadlink naar je e-mail. Als we iets moeten navragen, doen we dat via WhatsApp of e-mail.</p>

            <div class="flex" style="justify-content:space-between;margin-top:.4rem">
              <button type="button" class="btn btn-ghost" data-wizard-back>
                <svg viewBox="0 0 24 24" class="i" style="transform:rotate(180deg)" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
                Terug
              </button>
              <button type="submit" class="btn btn-primary">Proef aanvragen</button>
            </div>
          </div>
                  <p class="form-help">Vast bij een stap, of ergens niet zeker van? <a href={waHref("Hoi VISUAILS, ik ben een bestelling aan het invullen en heb een vraag.")} target="_blank" rel="noopener">Stuur ons een bericht op WhatsApp</a> — meestal binnen een uur antwoord op werkdagen, en we plaatsen de bestelling met je.</p>
        </form>
      </div>
      <p class="hint" style="text-align:center;margin-top:1rem">Eén proef per bedrijf &middot; {SAMPLE.feeNote} &middot; meer betaal je niet voor de proef.</p>
    </div>
  </section>

  <!-- CTA BAND -->
  <section class="section-tight">
    <div class="container">
      <div class="cta-band reveal pending">
        <h2 class="display" style="font-size:clamp(2.2rem,5vw,3.6rem)">Liever gewoon even overleggen?</h2>
        <p class="lead" style="margin:1.2rem auto 0;text-align:center">Stuur ons je product op WhatsApp en we helpen je een stijl kiezen.</p>
        <div class="flex" style="justify-content:center;margin-top:2rem">
          <a href="/nl/start" class="btn btn-ghost btn-lg">Plaats een volledige bestelling</a>
          <a href={waHref("Hoi VISUAILS, ik wil graag een proefvisual proberen.")} class="btn btn-wa btn-lg" target="_blank" rel="noopener">
            WhatsApp
          </a>
        </div>
      </div>
    </div>
  </section>
  <!-- Wizard step navigation is handled globally in src/scripts/interactions.js
       (document-level delegation) so it survives ClientRouter navigations. -->
</Layout>

<style>
  /* Page-scoped: the sample picker and its progress bar. The form primitives
     that used to sit here (.field, .req, .hint, .input, .textarea, .row-2,
     .dropzone) are in global.css. This copy had drifted — the textarea was
     110px against 120px on the three other forms, and none of the transitions
     below were opted out of prefers-reduced-motion. Both are fixed by the
     move; the textarea is 10px taller here than it was. */
  .narrow { max-width: 820px; }
  .hidden-step { display: none; }
  .choice-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 0.8rem; }
  .choice { position: relative; overflow: hidden; cursor: pointer; border: 1px solid var(--line-strong); transition: transform var(--dur-1) var(--ease), border-color var(--dur-1) var(--ease); background: var(--surface); display: block; }
  .choice:hover { transform: translateY(-2px); border-color: var(--accent-line); }
  .choice input { position: absolute; opacity: 0; pointer-events: none; }
  .choice .choice-media { aspect-ratio: 1; }
  .choice .choice-media img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .choice .choice-media.mono { display: grid; place-items: center; background: radial-gradient(125% 90% at 50% 6%, oklch(1 0 0), oklch(0.95 0.004 255) 58%, oklch(0.88 0.004 255) 100%); }
  .choice .choice-label { padding: 0.6rem 0.7rem; font-size: 0.85rem; color: var(--ink); font-weight: 500; }
  .choice:has(input:checked) { border-color: var(--accent); box-shadow: 0 0 0 1px var(--accent); }
  .choice:has(input:checked)::after { content: "\2713"; position: absolute; top: 8px; right: 8px; width: 24px; height: 24px; background: var(--accent); color: var(--accent-on); display: grid; place-items: center; font-size: 0.8rem; font-weight: 700; z-index: 5; }
  .choice .mono-av { position: relative; z-index: 2; display: grid; place-items: center; width: 100%; height: 100%; font-family: var(--font-display); font-weight: 900; font-size: 1.4rem; color: var(--accent-bright); }
