---
// VISUAILS — order a product video. Ported from the SvelteKit /order-video
// route. No client-side reactivity in the source — a plain form.
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Een productvideo bestellen — VISUAILS"
  description="Bestel een standaard productvideo vanaf €49. Plan je een grotere campagne? Vraag een offerte aan op WhatsApp."
>
  <section class="page-hero" style="padding-bottom:0">
    <div class="container">
      <p class="eyebrow-page"><a href="/nl/order" style="color:inherit">&larr; Alle bestelopties</a></p>
    </div>
  </section>

  <section id="video" class="ord-anchor">
    <div class="container narrow">
      <div class="section-head">
        <h1 style="font-size:var(--t-h2)">Een productvideo bestellen</h1>
        <p>Standaardvideo's hebben een vaste prijs vanaf &euro;49. Grotere campagne? Per project een offerte op WhatsApp.</p>
      </div>
      <div class="card" style="padding:clamp(1.4rem,3vw,2.4rem)">
        <div class="vid-photo">
          <img src="/img/banners-03.webp" alt="Voorbeeld VISUAILS productvideo-still" loading="lazy" />
        </div>
        <!-- TODO: wire this form to a real submit handler (Cloudflare Pages Function, Formspree, etc.) before launch — no backend in this static build yet -->
        <form action="/api/order" method="post" id="video-form">
          <input type="hidden" name="service" value="video" />
          <input type="hidden" name="redirect" value="/nl/thank-you" />
          <input type="hidden" name="lang" value="nl" />
          <input type="text" name="company_hp" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0" />
          <div class="field">
            <label>Videotype <span class="req">*</span></label>
            <label class="opt"><input type="radio" name="vtype" value="Motion Video" checked /><span class="opt-main"><span class="opt-title">Motion Video</span><span class="opt-desc">Clip van 8 seconden, subtiele beweging, strakke presentatie</span></span><span class="opt-price">&euro;49</span></label>
            <label class="opt"><input type="radio" name="vtype" value="Lifestyle Video" /><span class="opt-main"><span class="opt-title">Lifestyle Video</span><span class="opt-desc">Korte gestylde scène voor social &amp; advertenties</span></span><span class="opt-price">&euro;59</span></label>
          </div>
          <div class="row-2">
            <div class="field">
              <label for="v-qty">Aantal video's <span class="req">*</span></label>
              <select class="select" id="v-qty" name="quantity" required>
                <option>1 video</option><option>2 video's</option><option>3 video's</option><option>4&ndash;5 video's</option><option>6+ video's</option>
              </select>
            </div>
            <div class="field">
              <label for="v-fmt">Formaat <span class="req">*</span></label>
              <select class="select" id="v-fmt" name="format" required>
                <option>1:1 — feed / product</option><option>4:5 — advertenties</option><option>9:16 — Stories / TikTok</option><option>16:9 — website / banners</option>
              </select>
            </div>
          </div>
          <div class="field">
            <label for="v-file">Upload je product <span class="req">*</span></label>
            <label class="dropzone" for="v-file">
              <input type="file" id="v-file" name="photo" accept="image/*" hidden />
              <svg viewBox="0 0 24 24" class="i"><path d="M12 16V4M6 10l6-6 6 6M4 20h16" /></svg>
              <div>Klik om te uploaden of sleep een foto hierheen</div>
            </label>
          </div>
          <div class="row-2">
            <div class="field"><label for="v-name">Naam <span class="req">*</span></label><input class="input" id="v-name" name="name" type="text" autocomplete="name" required /></div>
            <div class="field"><label for="v-comp">Merk of winkelnaam</label><input class="input" id="v-comp" name="brand" type="text" autocomplete="organization" /></div>
          </div>
          <div class="row-2">
            <div class="field"><label for="v-mail">E-mail <span class="req">*</span></label><input class="input" id="v-mail" name="email" type="email" autocomplete="email" required /></div>
            <div class="field"><label for="v-phone">Telefoon <span class="hint" style="font-weight:400">— optioneel</span></label><input class="input" id="v-phone" name="phone" type="tel" autocomplete="tel" /></div>
          </div>
          <div class="flex" style="margin-top:.4rem">
            <button type="submit" class="btn btn-primary btn-lg">Verstuur videobestelling · <span id="video-total">€49</span></button>
            <a href="https://wa.me/31625436130?text=Hoi%20VISUAILS%2C%20ik%20wil%20graag%20een%20productvideo%20bestellen." class="btn btn-wa" target="_blank" rel="noopener"><svg class="i" viewBox="0 0 24 24"><path d="M21 11.5a8.38 8.38 0 0 1-8.5 8.5 8.5 8.5 0 0 1-4-1L3 20l1.5-4.5A8.38 8.38 0 0 1 3.5 11 8.5 8.5 0 0 1 12 3a8.38 8.38 0 0 1 8.5 8.5z" /></svg> Bestel via WhatsApp</a>
          </div>
          <p class="hint" style="margin-top:1rem">Plan je een grotere campagnevideo? <a href="https://wa.me/31625436130?text=Hoi%20VISUAILS%2C%20ik%20wil%20graag%20een%20offerte%20voor%20een%20campagnevideo." target="_blank" rel="noopener" style="color:var(--accent);font-weight:600">Vraag een campagne-offerte aan op WhatsApp &rarr;</a></p>
                  <p class="form-help">Vast bij een stap, of ergens niet zeker van? <a href="https://wa.me/31625436130?text=Hi%20VISUAILS%2C%20ik%20ben%20een%20bestelling%20aan%20het%20invullen%20en%20heb%20een%20vraag." target="_blank" rel="noopener">Stuur ons een bericht op WhatsApp</a> — meestal binnen een uur antwoord op werkdagen, en we plaatsen de bestelling met je.</p>
        </form>
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <div class="section-head">
        <h2 style="font-size:1.4rem">Op zoek naar iets anders?</h2>
      </div>
      <div class="chip-row">
        <a href="/nl/order-catalog" class="chip">Catalogus</a>
        <a href="/nl/order-lifestyle" class="chip">Lifestyle</a>
        <a href="/nl/order-custom" class="chip">Custom styling</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Order-form controls — page-scoped (see order-catalog.astro for the same
     block; duplicated per-page rather than added to global.css). */
  .narrow { max-width: 820px; }
  .vid-photo { border-radius: var(--r-media); overflow: hidden; max-height: 200px; margin-bottom: 1.4rem; }
  .vid-photo img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .field { display: flex; flex-direction: column; gap: 0.45rem; margin-bottom: 1.1rem; }
  .field label { font-size: 0.88rem; font-weight: 600; color: var(--ink); }
  .req { color: var(--accent-bright); }
  .hint { font-size: 0.8rem; color: var(--ink-3); }
  .input, .select { width: 100%; padding: 0.85rem 1rem; background: var(--surface); border: 1px solid var(--line-strong); border-radius: var(--r-sm); color: var(--ink); transition: border-color 0.22s var(--ease), box-shadow 0.22s var(--ease); font-size: 0.98rem; font-family: var(--font-body); }
  .input:focus, .select:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-soft); }
  .select option { background: var(--surface); color: var(--ink); }
  .row-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 1.1rem; }
  @media (max-width: 620px) { .row-2 { grid-template-columns: 1fr; } }
  .opt { display: flex; align-items: center; gap: 0.8rem; padding: 0.9rem 1.1rem; border-radius: var(--r-sm); border: 1px solid var(--line-strong); cursor: pointer; transition: border-color 0.2s var(--ease), background 0.2s var(--ease); margin-bottom: 0.6rem; background: var(--surface); }
  .opt:has(input:checked) { border-color: var(--accent); background: var(--accent-soft); }
  .opt input { accent-color: var(--accent); width: 18px; height: 18px; flex: none; }
  .opt .opt-main { flex: 1; display: flex; flex-direction: column; gap: .15rem; }
  .opt .opt-title { color: var(--ink); font-weight: 500; }
  .opt .opt-desc { font-size: 0.82rem; color: var(--ink-3); }
  .opt .opt-price { color: var(--accent-bright); font-weight: 700; font-size: 0.9rem; }
  .dropzone { display: block; border-radius: var(--r-sm); padding: 1.8rem; text-align: center; color: var(--ink-3); border: 1.5px dashed var(--line-strong); transition: border-color 0.22s var(--ease), background 0.22s var(--ease); cursor: pointer; background: var(--surface); }
  .dropzone:hover { border-color: var(--accent-line); background: var(--accent-soft); }
  .dropzone svg { width: 30px; height: 30px; margin: 0 auto 0.6rem; color: var(--accent-bright); }
  .chip-row { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .chip { display: inline-flex; align-items: center; gap: 0.45rem; padding: 0.4rem 0.9rem; border-radius: var(--r-pill); border: 1px solid var(--line); font-size: 0.8rem; color: var(--ink-2); }
  a.chip { transition: border-color var(--dur) var(--ease), color var(--dur) var(--ease); }
  a.chip:hover { border-color: var(--accent-line); color: var(--ink); }
  .ord-anchor { scroll-margin-top: 100px; }
</style>
