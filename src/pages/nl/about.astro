---
import { waHref } from '../../data/whatsapp.js';
// VISUAILS — About. Editorial page: who we are, what we hold to, a fast
// strip of real photography, closing CTA. Ported from the SvelteKit about
// page — see IMAGES.md for the photo strip and hero.
import Layout from '../../layouts/Layout.astro';
import { euro, ladderRate, ladderFloor, LADDER, vatLabel, reviewClaim, turnaround } from '../../data/pricing.js';

// Deze pagina bevatte vier losse leverbeloftes — de meta-beschrijving, de
// hero-lead, de body-lead en een chip — allemaal "in ongeveer een dag" of
// "~24u", en geen enkele daarvan is ooit door de capaciteitspoort gekomen.
// Het zijn tier-feiten, dus ze komen nu uit pricing.js. "Geen abonnement" gaat
// mee: dat klopt niet meer sinds de maandplannen live zijn.
//
// De ene prijs op deze pagina was een vast tarief per product. Dat is nu de
// eerste trede van een staffel, en de kaart eronder heet "Toegankelijk voor
// iedereen" — precies de claim die het instaptarief alleen zou ondergraven.
// Dus staan beide uiteinden er.
const CAT_ENTRY = euro(ladderRate('catalog', 1), 'nl');
const CAT_FLOOR = euro(ladderFloor('catalog'), 'nl');
const CAT_FLOOR_FROM = LADDER.catalog[LADDER.catalog.length - 1][0];
const TIMING = turnaround('unattended', 'nl');
const REVIEW = reviewClaim('unattended', 'nl');

// w/h zijn de INTRINSIEKE pixelmaten van de bestanden in public/img, niet de
// weergavegrootte — die bepaalt .photo-grid zelf met aspect-ratio. Ze staan
// hier zodat de browser de ruimte kan reserveren voordat de bytes er zijn.
const strip = [
  { src: '/img/lifestyle-glow-05.webp', w: 2400, h: 1792 },
  { src: '/img/lifestyle-flash-06.webp', w: 2400, h: 1792 },
  { src: '/img/lifestyle-dunes-02.webp', w: 928, h: 1152 },
  { src: '/img/lifestyle-phone-made-09.webp', w: 2400, h: 1792 },
  { src: '/img/banners-08.webp', w: 928, h: 1152 },
];
---

<Layout
  title="VISUAILS — Over ons"
  description="VISUAILS is een studio voor productvisuals in Enschede, Nederland — moderne productiesnelheid met menselijk oordeel op elke visual die we leveren."
>
  <section class="hero-editorial compact">
    <div class="bg" style="background-image:url('/img/banners-13.webp')"></div>
    <div class="fade"></div>
    <div class="hero-editorial-content container">
      <h1 class="display" data-split-lines>Geweldige visuals,<br />zonder de <em>studio</em>.</h1>
      <p class="lead" style="margin-top:1.2rem">Productvisuals van studiokwaliteit — moderne snelheid, gecontroleerd door echte mensen.</p>
      <div class="flex" style="margin-top:1.8rem">
        <a href="/nl/test-sample" class="btn btn-primary btn-lg">Proefvisual</a>
        <a href={waHref("Hoi VISUAILS, ik wil graag meer over jullie weten.")} class="btn btn-wa" target="_blank" rel="noopener">WhatsApp</a>
      </div>
    </div>
  </section>

  <section class="section-tight"><div class="container">
    <div class="photo-split reveal pending">
      <div class="photo-split-media"><img src="/img/custom-models-01.webp" alt="Een VISUAILS-campagnescène, gestyled en geschoten voor een klantmerk" loading="lazy" decoding="async" width="800" height="1071" /></div>
      <div>
        <h2>Snelheid en oordeel, <em>samen</em>.</h2>
        <p class="lead" style="margin-top:1rem">Een klein team in Enschede, Nederland. Eén foto wordt een volledige set — en een echte persoon beoordeelt elk beeld voordat het bij jou aankomt.</p>
        <div class="chip-row" style="margin-top:1.4rem">
          <span class="chip"><span class="dot"></span>Enschede, NL</span>
          <span class="chip"><span class="dot"></span>{REVIEW}</span>
          <span class="chip"><span class="dot"></span>{TIMING}</span>
        </div>
      </div>
    </div>
  </div></section>

  <section class="section-tight"><div class="container">
    <h2 style="margin-bottom:2rem">Drie dingen waar we aan vasthouden.</h2>
    <div class="grid grid-3 reveal-group">
      <div class="card card-hover reveal pending"><h3>Snelheid, zonder de shortcut</h3><p style="margin-top:.6rem;color:var(--ink-3)">Snelle levering, en toch de moeite waard om te publiceren.</p></div>
      <div class="card card-hover reveal pending"><h3>Consistentie wint</h3><p style="margin-top:.6rem;color:var(--ink-3)">Eén samenhangende look, over je hele assortiment.</p></div>
      <div class="card card-hover reveal pending"><h3>Toegankelijk voor iedereen</h3><p style="margin-top:.6rem;color:var(--ink-3)">Catalog {CAT_ENTRY} per product, {CAT_FLOOR} vanaf {CAT_FLOOR_FROM} ({vatLabel('excl', 'nl')}). Bestel er één, of een hele collectie.</p></div>
    </div>
  </div></section>

  <section class="section-tight"><div class="container">
    <div class="photo-grid reveal pending">
      <img src={strip[0].src} alt="Lifestyle-visual in glow-stijl" loading="lazy" decoding="async" width={strip[0].w} height={strip[0].h} class="wide" />
      <img src={strip[1].src} alt="Lifestyle-visual in flash-stijl" loading="lazy" decoding="async" width={strip[1].w} height={strip[1].h} />
      <img src={strip[2].src} alt="Lifestyle-visual in dunes-stijl" loading="lazy" decoding="async" width={strip[2].w} height={strip[2].h} />
      <img src={strip[3].src} alt="Lifestyle-visual in phone-made-stijl" loading="lazy" decoding="async" width={strip[3].w} height={strip[3].h} />
      <img src={strip[4].src} alt="Campagnefotografie" loading="lazy" decoding="async" width={strip[4].w} height={strip[4].h} class="wide" />
    </div>
  </div></section>

  <section class="section-tight"><div class="container">
    <div class="cta-band reveal pending">
      <h2 class="display" style="font-size:clamp(2.2rem,5vw,3.6rem)">Laten we <em>samen</em> groeien.</h2>
      <p class="lead" style="margin:1.2rem auto 0;text-align:center">Proefvisual, of stuur ons een bericht op WhatsApp.</p>
      <div class="flex" style="justify-content:center;margin-top:2rem">
        <a href="/nl/test-sample" class="btn btn-primary btn-lg">Proefvisual</a>
        <a href={waHref("Hoi VISUAILS, ik wil graag praten over visuals voor mijn merk.")} class="btn btn-wa" target="_blank" rel="noopener">WhatsApp</a>
      </div>
    </div>
  </div></section>
</Layout>

<style>
  .chip-row { display: flex; flex-wrap: wrap; gap: .5rem; }
  .chip { display: inline-flex; align-items: center; gap: .45rem; padding: .4rem .9rem; border: 1px solid var(--line); font-size: .8rem; color: var(--ink-2); }
  .chip .dot { width: 5px; height: 5px; background: var(--accent); }
</style>
