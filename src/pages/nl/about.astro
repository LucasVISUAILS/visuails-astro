---
// VISUAILS — About. Editorial page: who we are, what we hold to, a fast
// strip of real photography, closing CTA. Ported from the SvelteKit about
// page — see IMAGES.md for the photo strip and hero.
import Layout from '../../layouts/Layout.astro';

const strip = [
  '/img/lifestyle-glow-05.webp',
  '/img/lifestyle-flash-06.webp',
  '/img/lifestyle-dunes-02.webp',
  '/img/lifestyle-phone-made-09.webp',
  '/img/banners-08.webp',
];
---

<Layout
  title="VISUAILS — Over ons"
  description="VISUAILS is een studio voor productvisuals die moderne productiesnelheid combineert met menselijk oordeel, zodat elk merk in ongeveer een dag productvisuals van studiokwaliteit krijgt. Gevestigd in Enschede, Nederland."
>
  <section class="hero-editorial compact">
    <div class="bg" style="background-image:url('/img/banners-13.webp')"></div>
    <div class="fade"></div>
    <div class="hero-editorial-content container">
      <h1 class="display" data-split-lines>Geweldige visuals,<br />zonder de <em>studio</em>.</h1>
      <p class="lead" style="margin-top:1.2rem">Productvisuals van studiokwaliteit in ongeveer een dag — moderne snelheid, gecontroleerd door echte mensen.</p>
      <div class="flex" style="margin-top:1.8rem">
        <a href="/nl/test-sample" class="btn btn-primary btn-lg">Proefvisual</a>
        <a href="https://wa.me/31625436130?text=Hoi%20VISUAILS%2C%20ik%20wil%20graag%20meer%20over%20jullie%20weten." class="btn btn-wa" target="_blank" rel="noopener"><svg class="i" viewBox="0 0 24 24"><path d="M21 11.5a8.38 8.38 0 0 1-8.5 8.5 8.5 8.5 0 0 1-4-1L3 20l1.5-4.5A8.38 8.38 0 0 1 3.5 11 8.5 8.5 0 0 1 12 3a8.38 8.38 0 0 1 8.5 8.5z"/></svg>WhatsApp</a>
      </div>
    </div>
  </section>

  <section class="section-tight"><div class="container">
    <div class="photo-split reveal pending">
      <div class="photo-split-media"><img src="/img/custom-models-01.webp" alt="Een VISUAILS-campagnescène, gestyled en geschoten voor een klantmerk" loading="lazy" /></div>
      <div>
        <h2>Snelheid en oordeel, <em>samen</em>.</h2>
        <p class="lead" style="margin-top:1rem">Een klein team in Enschede, Nederland. Eén foto wordt in ongeveer een dag een volledige set — en een echt persoon beoordeelt elke afbeelding voordat die bij jou aankomt.</p>
        <div class="chip-row" style="margin-top:1.4rem">
          <span class="chip"><span class="dot"></span>Enschede, NL</span>
          <span class="chip"><span class="dot"></span>100% menselijk beoordeeld</span>
          <span class="chip"><span class="dot"></span>~24u levering</span>
        </div>
      </div>
    </div>
  </div></section>

  <section class="section-tight"><div class="container">
    <h2 style="margin-bottom:2rem">Drie dingen waar we aan vasthouden.</h2>
    <div class="grid grid-3 reveal-group">
      <div class="card card-hover reveal pending"><h3>Snelheid, zonder de shortcut</h3><p style="margin-top:.6rem;color:var(--ink-3)">Snelle levering, en toch de moeite waard om te publiceren.</p></div>
      <div class="card card-hover reveal pending"><h3>Consistentie wint</h3><p style="margin-top:.6rem;color:var(--ink-3)">Eén samenhangende look, over je hele assortiment.</p></div>
      <div class="card card-hover reveal pending"><h3>Toegankelijk voor iedereen</h3><p style="margin-top:.6rem;color:var(--ink-3)">Catalogus vanaf &euro;39,99 per product. Geen abonnement.</p></div>
    </div>
  </div></section>

  <section class="section-tight"><div class="container">
    <div class="photo-grid reveal pending">
      <img src={strip[0]} alt="Lifestyle-visual in glow-stijl" loading="lazy" class="wide" />
      <img src={strip[1]} alt="Lifestyle-visual in flash-stijl" loading="lazy" />
      <img src={strip[2]} alt="Lifestyle-visual in dunes-stijl" loading="lazy" />
      <img src={strip[3]} alt="Lifestyle-visual in phone-made-stijl" loading="lazy" />
      <img src={strip[4]} alt="Campagnefotografie" loading="lazy" class="wide" />
    </div>
  </div></section>

  <section class="section-tight"><div class="container">
    <div class="cta-band reveal pending">
      <h2 class="display" style="font-size:clamp(2.2rem,5vw,3.6rem)">Laten we <em>samen</em> groeien.</h2>
      <p class="lead" style="margin:1.2rem auto 0;text-align:center">Proefvisual, of stuur ons een bericht op WhatsApp.</p>
      <div class="flex" style="justify-content:center;margin-top:2rem">
        <a href="/nl/test-sample" class="btn btn-primary btn-lg">Proefvisual</a>
        <a href="https://wa.me/31625436130?text=Hoi%20VISUAILS%2C%20ik%20wil%20graag%20praten%20over%20visuals%20voor%20mijn%20merk." class="btn btn-wa" target="_blank" rel="noopener"><svg class="i" viewBox="0 0 24 24"><path d="M21 11.5a8.38 8.38 0 0 1-8.5 8.5 8.5 8.5 0 0 1-4-1L3 20l1.5-4.5A8.38 8.38 0 0 1 3.5 11 8.5 8.5 0 0 1 12 3a8.38 8.38 0 0 1 8.5 8.5z"/></svg>WhatsApp</a>
      </div>
    </div>
  </div></section>
</Layout>

<style>
  .chip-row { display: flex; flex-wrap: wrap; gap: .5rem; }
  .chip { display: inline-flex; align-items: center; gap: .45rem; padding: .4rem .9rem; border-radius: var(--r-pill); border: 1px solid var(--line); font-size: .8rem; color: var(--ink-2); }
  .chip .dot { width: 5px; height: 5px; border-radius: 50%; background: var(--accent); }
</style>
