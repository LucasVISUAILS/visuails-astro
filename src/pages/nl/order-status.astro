---
// VISUAILS — order status / tracking. Ported from the SvelteKit
// order-status page (itself ported from static /order-status.html).
//
// NOTE: this is a static Astro build — there is no backend anywhere in
// this project. The source page's "Check status" button has no handler
// at all: it's an explicit preview, per the page's own copy below ("This
// is a preview of order tracking..."). Preserved as-is here — the lookup
// form doesn't submit anywhere, and the timeline underneath is static
// example data, not a real lookup result. Real self-service order
// tracking needs a backend (and accounts) before this can do more than
// preview the UI. The source never read $page.url.searchParams, so no
// query-string logic is ported either.
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Volg je bestelling — VISUAILS"
  description="Voer je bestel-ID en e-mailadres in om te zien waar je VISUAILS-bestelling zich in het proces bevindt."
>
  <section class="page-hero"><div class="container narrow">
    <span class="eyebrow-page">Bestelstatus</span>
    <h1 class="display" style="font-size:clamp(2.2rem,4.5vw,3.4rem)">Volg je bestelling</h1>
    <p class="lead" style="margin-top:1rem">Voer je bestel-ID en e-mailadres in om te zien waar je visuals zich in het proces bevinden.</p>
  </div></section>

  <section class="section-tight"><div class="container narrow">
    <form class="card" onsubmit="return false;" style="margin-bottom:2rem">
      <div class="row-2">
        <div class="field"><label for="oid">Bestel-ID <span class="req">*</span></label><input class="input" id="oid" name="oid" placeholder="bijv. VIS-10428" required /></div>
        <div class="field"><label for="omail">E-mail <span class="req">*</span></label><input class="input" id="omail" type="email" name="omail" placeholder="jij@voorbeeld.com" required /></div>
      </div>
      <button type="button" class="btn btn-primary">Status controleren</button>
      <p class="hint" style="margin-top:.8rem">Alleen een voorbeeld — volledige self-service tracking komt met accounts. De tijdlijn hieronder laat zien hoe het werkt.</p>
    </form>
    <div class="card">
      <h3>Voorbeeld: bestelling VIS-10428</h3>
      <div class="timeline">
        <div class="tl-step done"><div class="tl-marker"><div class="tl-dot"><svg viewBox="0 0 24 24" class="i" style="width:14px;height:14px"><path d="M20 6L9 17l-5-5" /></svg></div><div class="tl-line"></div></div><div class="tl-body"><h4>Ontvangen</h4><p>Je briefing en foto's zijn binnen. Bedankt!</p></div></div>
        <div class="tl-step active"><div class="tl-marker"><div class="tl-dot">2</div><div class="tl-line"></div></div><div class="tl-body"><h4>In productie</h4><p>We maken nu je visuals aan.</p></div></div>
        <div class="tl-step upcoming"><div class="tl-marker"><div class="tl-dot">3</div><div class="tl-line"></div></div><div class="tl-body"><h4>Kwaliteitscontrole</h4><p>Een persoon controleert elke afbeelding voordat die wordt verstuurd.</p></div></div>
        <div class="tl-step upcoming"><div class="tl-marker"><div class="tl-dot">4</div></div><div class="tl-body"><h4>Geleverd</h4><p>Je ontvangt een downloadlink per e-mail.</p></div></div>
      </div>
    </div>
    <div class="flex" style="margin-top:1.6rem">
      <span style="color:var(--ink-3)">Klopt er iets niet?</span>
      <a href="https://wa.me/31625436130?text=Hi%20VISUAILS%2C%20een%20vraag%20over%20mijn%20bestelling." class="btn btn-wa" target="_blank" rel="noopener"><svg class="i" viewBox="0 0 24 24"><path d="M21 11.5a8.38 8.38 0 0 1-8.5 8.5 8.5 8.5 0 0 1-4-1L3 20l1.5-4.5A8.38 8.38 0 0 1 3.5 11 8.5 8.5 0 0 1 12 3a8.38 8.38 0 0 1 8.5 8.5z" /></svg> Vraag het op WhatsApp</a>
    </div>
  </div></section>
</Layout>

<style>
  /* Order-form controls + timeline — page-scoped. */
  .narrow { max-width: 820px; }
  .field { display: flex; flex-direction: column; gap: 0.45rem; margin-bottom: 1.1rem; }
  .field label { font-size: 0.88rem; font-weight: 600; color: var(--ink); }
  .req { color: var(--accent-bright); }
  .hint { font-size: 0.8rem; color: var(--ink-3); }
  .input { width: 100%; padding: 0.85rem 1rem; background: var(--surface); border: 1px solid var(--line-strong); border-radius: var(--r-sm); color: var(--ink); transition: border-color 0.22s var(--ease), box-shadow 0.22s var(--ease); font-size: 0.98rem; font-family: var(--font-body); }
  .input:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-soft); }
  .row-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 1.1rem; }
  @media (max-width: 620px) { .row-2 { grid-template-columns: 1fr; } }

  .timeline { display: grid; gap: 0; margin-top: 1.5rem; }
  .tl-step { display: grid; grid-template-columns: auto 1fr; gap: 1rem; align-items: start; }
  .tl-marker { display: flex; flex-direction: column; align-items: center; align-self: stretch; }
  .tl-dot { width: 28px; height: 28px; border-radius: 50%; border: 2px solid var(--line-strong); display: grid; place-items: center; background: var(--bg); color: var(--ink-3); flex: 0 0 auto; font-size: .8rem; }
  .tl-line { width: 2px; flex: 1; background: var(--line); min-height: 34px; }
  .tl-step.done .tl-dot, .tl-step.active .tl-dot { border-color: var(--accent); color: var(--accent-bright); }
  .tl-step.done .tl-line, .tl-step.active .tl-line { background: var(--accent-line); }
  .tl-step.active .tl-dot { box-shadow: 0 0 0 4px var(--accent-soft); }
  .tl-body { padding-bottom: 1.4rem; }
  .tl-body h4 { margin-bottom: .2rem; }
  .tl-body p { font-size: .9rem; color: var(--ink-3); }
  .tl-step.upcoming .tl-body h4 { color: var(--ink-3); }
</style>
