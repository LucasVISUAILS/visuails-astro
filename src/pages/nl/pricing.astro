---
// VISUAILS — /nl/pricing (Nederlands). De pagina-inhoud staat in
// PricingPage.astro, zodat /pricing en /nl/pricing niet uit elkaar kunnen
// lopen; alleen de meta verschilt hier.
import Layout from '../../layouts/Layout.astro';
import PricingPage from '../../components/PricingPage.astro';
//
// Hij noemde tot augustus 2026 de twee pakketten. Nu noemt hij de vorm van de
// staffel: het instaptarief, de bodem, en dat het tarief daalt. De korting op
// de eerste bestelling staat achteraan, want dat is de zin die een snippet
// zich kan veroorloven kwijt te raken.
import { euro, ladderRate, ladderFloor, LADDER, vatLabel } from '../../data/pricing.js';

const FLOOR_FROM = LADDER.catalog[LADDER.catalog.length - 1][0];

const description =
  `Geprijsd per product, en de prijs daalt naarmate het aantal stijgt: catalog ` +
  `${euro(ladderRate('catalog', 1), 'nl')} tot ${euro(ladderFloor('catalog'), 'nl')}, lifestyle ` +
  `${euro(ladderRate('lifestyle', 1), 'nl')} tot ${euro(ladderFloor('lifestyle'), 'nl')} vanaf ${FLOOR_FROM} producten, ` +
  `${vatLabel('excl', 'nl')}.`;
---

<Layout title="Prijzen — de prijs per product, volledig | VISUAILS" description={description}>
  <PricingPage lang="nl" />
</Layout>
