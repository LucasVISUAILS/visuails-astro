---
// VISUAILS — /nl/pricing (Nederlands). De pagina-inhoud staat in
// PricingPage.astro, zodat /pricing en /nl/pricing niet uit elkaar kunnen
// lopen; alleen de meta verschilt hier.
import Layout from '../../layouts/Layout.astro';
import PricingPage from '../../components/PricingPage.astro';
import { euro, AMOUNT, FULL_DROP_MIN, FULL_DROP_MAX } from '../../data/pricing.js';

const description =
  `Geprijsd per drop — Drop Pilot ${euro(AMOUNT.dropPilot, 'nl')}, Full Drop ` +
  `${euro(AMOUNT.fullDrop, 'nl')} voor ${FULL_DROP_MIN}–${FULL_DROP_MAX} producten. ` +
  `Losse producten vanaf ${euro(AMOUNT.catalog, 'nl')}.`;
---

<Layout title="Prijzen — VISUAILS" description={description}>
  <PricingPage lang="nl" />
</Layout>
