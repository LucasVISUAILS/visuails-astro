---
// VISUAILS — /nl/custom-models, "Jouw merkmodel". De pagina-inhoud staat in
// BrandModelPage.astro, zodat /custom-models en /nl/custom-models niet uit
// elkaar kunnen lopen; alleen de meta verschilt hier.
//
// De URL blijft /custom-models na het samenvoegen van /models en
// /custom-models (AUDIT-TASK-0.md §H·8): deze pagina droeg het
// exclusiviteitsverhaal al, dus die hield zijn waarde. Sinds taak #270 is
// /nl/models weer een echte pagina in plaats van een 301 hierheen — zie
// de addendum van 2026-07-29 bij §H·8 en src/i18n/ui.js → brandModelHref.
//
// De description komt uit pricing.js en wordt niet ingetypt: een prijs in een
// <meta>-tag is de enige plek waar een verouderd bedrag een herschreven
// pagina overleeft.
import Layout from '../../layouts/Layout.astro';
import BrandModelPage from '../../components/BrandModelPage.astro';
import { euro, AMOUNT, BRAND_MODEL_CREDIT_DROPS } from '../../data/pricing.js';

// Onder de 160 tekens zodat Google hem heel toont. De vorige description was
// 171 tekens en werd afgekapt.
const description =
  `Eén gezicht, alleen voor jouw merk ontworpen — op elk product, elke drop. ` +
  `${euro(AMOUNT.brandModel, 'nl')} eenmalige setup, ` +
  `${euro(AMOUNT.brandModelCredit, 'nl')} terug bij elk van je eerste ` +
  `${BRAND_MODEL_CREDIT_DROPS} drops.`;
---

<Layout
  title="Jouw merkmodel — één gezicht, elke drop | VISUAILS"
  description={description}
  ogImage="/img/custom-models-03.webp"
>
  <BrandModelPage lang="nl" />
</Layout>
