---
// VISUAILS — homepage (Nederlands), "The Studio Issue". Spiegel van
// src/pages/index.astro; zie dat bestand voor de opzet en de volgorde
// (cover → statement → develop → spread → ledger → set → proces → kwaliteit →
// modellen/AI/three-way → belofte → plannen → proefvisual als afsluiter).
// Motion/shader zijn progressive enhancement — elke basisstaat is volledig
// ontworpen zonder JS.
import Layout from '../../layouts/Layout.astro';
import Compare from '../../components/Compare.astro';
import ThreeWay from '../../components/ThreeWay.astro';

const WA = 'https://wa.me/31625436130?text=Hi%20VISUAILS%2C%20ik%20wil%20graag%20zien%20wat%20jullie%20van%20mijn%20productfoto%27s%20kunnen%20maken.';

const ledger = [
  { n: '01', name: 'Catalog', meta: 'Een volledige set van 4 foto’s per product: voorkant, achterkant, detail-close-up en één on-model shot.', price: '€39,99 / product', href: '/nl/catalog', order: '/nl/order-catalog', img: '/img/catalog-after.webp',
    use: 'De strakke, consistente productshots waar je shop en marktplaatsen op draaien — de foto’s die een klein assortiment gevestigd laten lijken.',
    where: ['Je webshop', 'Marktplaatsen', 'Productpagina’s'],
    shots: ['/img/catalog-after.webp', '/img/catalog-before.webp', '/img/custom-models-02.webp'] },
  { n: '02', name: 'Lifestyle', meta: 'Drie foto’s van je product in één gestylde look — sfeer, on-model en een logo-close-up, met dezelfde grade. Een carousel klaar om te posten.', price: '€59,99 / product', href: '/nl/lifestyle', order: '/nl/order-lifestyle', img: '/img/lifestyle-glow-01.webp',
    use: 'De gestylde scènes in context die de scroll stoppen en het gevoel verkopen — je feed en je ads.',
    where: ['Instagram', 'Ads', 'Lookbook'],
    shots: ['/img/lifestyle-glow-01.webp', '/img/lifestyle-dunes-01.webp', '/img/lifestyle-flash-04.webp'] },
  { n: '03', name: 'Video', meta: 'Korte productfilms met subtiele beweging, gebouwd voor feeds en ads.', price: 'vanaf €49 / video', href: '/nl/video', order: '/nl/order-video', img: '/img/banners-16.webp',
    use: 'Subtiele beweging die de doorklik verhoogt waar een stilstaande foto stopt — gemaakt voor feeds en betaalde ads.',
    where: ['Reels / TikTok', 'Ads', 'Productpagina’s'],
    shots: ['/img/banners-16.webp', '/img/banners-09.webp', '/img/banners-12.webp'] },
  { n: '04', name: 'Custom', meta: 'Je eigen stijl of model, één keer ontworpen voor jouw merk — daarna de normale prijs.', price: 'op aanvraag', href: '/nl/custom-models', order: '/nl/order-custom', img: '/img/custom-models-02.webp',
    use: 'Eén exclusieve stijl of model, één keer ontworpen en daarna hergebruikt op elke visual — je hele merk, één consistent gezicht.',
    where: ['Elk kanaal', 'Campagnes', '25+ producten'],
    shots: ['/img/custom-models-02.webp', '/img/custom-models-03.webp', '/img/banners-14.webp'] },
];

const strip = [
  '/img/lifestyle-flash-04.webp',
  '/img/lifestyle-dunes-01.webp',
  '/img/lifestyle-phone-made-05.webp',
  '/img/banners-12.webp',
  '/img/banners-02.webp',
];

const reqs = [
  { n: '01', title: 'Voor- & achterkant', body: 'Het hele product van beide kanten, zodat er niets geraden wordt.' },
  { n: '02', title: 'Een detail-close-up', body: 'Logo’s, stiksels, hardware — de dingen die exact moeten blijven.' },
  { n: '03', title: 'De stof', body: 'Een close-up van het materiaal zodat textuur en glans echt overkomen.' },
  { n: '04', title: 'Gedragen voor pasvorm', body: 'Iemand die het écht draagt, zodat we de pasvorm goed treffen.' },
];
---

<Layout
  title="Productfoto’s voor kledingmerken, zonder fotoshoot | VISUAILS"
  description="Stuur één productfoto en krijg binnen ongeveer 24 uur een complete campagne terug. Catalog-, on-model-, lifestyle- en videovisuals — in jouw merkstijl, met de hand gecontroleerd, zonder fotoshoot."
  ogImage="/img/hero-dunes.webp"
>
  <!-- DE COVER — één campagne-still (nergens geschoten, bij schemering, in de
       duinen), één regel die de droom verkoopt. Het beeld ís het argument:
       shoot-kwaliteit, zonder shoot. -->
  <section class="hero-cover">
    <div class="hc2-bg"><img src="/img/hero-dunes.webp" alt="Een VISUAILS-campagnevisual — een model in de duinen bij schemering" fetchpriority="high" transition:name="hero-photo" /></div>
    <div class="hc2-scrim" aria-hidden="true"></div>
    <div class="container cover-inner">
      <div class="cover-copy">
        <h1 class="cover-title"><span class="ch-l">Het merk dat je</span><span class="ch-l">voor ogen had,</span><span class="ch-l"><em>gevisualiseerd.</em></span></h1>
        <p class="cover-sub">Eén productfoto wordt een publicatieklare campagne — catalog, lifestyle en video, in jouw merkstijl, terug in ongeveer 24 uur.</p>
        <div class="cover-cta">
          <a href="/nl/test-sample" class="btn btn-primary btn-glow btn-lg">Probeer het op je product — €0,99</a>
          <a href="/nl/order" class="btn btn-ghost btn-lg">Bestel nu</a>
        </div>
      </div>
    </div>
    <div class="ticker" aria-label="Diensten">
      <div class="tk-row">
        <a class="tk-item" href="/nl/catalog">Catalog</a><span class="tk-sep">·</span>
        <a class="tk-item fill" href="/nl/catalog">On-model</a><span class="tk-sep">·</span>
        <a class="tk-item" href="/nl/lifestyle">Lifestyle</a><span class="tk-sep">·</span>
        <a class="tk-item fill" href="/nl/video">Video</a><span class="tk-sep">·</span>
        <a class="tk-item" href="/nl/custom-models">Eigen modellen</a><span class="tk-sep">·</span>
        <a class="tk-item fill" href="/nl/catalog" aria-hidden="true" tabindex="-1">Catalog</a><span class="tk-sep" aria-hidden="true">·</span>
        <a class="tk-item" href="/nl/catalog" aria-hidden="true" tabindex="-1">On-model</a><span class="tk-sep" aria-hidden="true">·</span>
        <a class="tk-item fill" href="/nl/lifestyle" aria-hidden="true" tabindex="-1">Lifestyle</a><span class="tk-sep" aria-hidden="true">·</span>
        <a class="tk-item" href="/nl/video" aria-hidden="true" tabindex="-1">Video</a><span class="tk-sep" aria-hidden="true">·</span>
        <a class="tk-item fill" href="/nl/custom-models" aria-hidden="true" tabindex="-1">Eigen modellen</a><span class="tk-sep" aria-hidden="true">·</span>
      </div>
    </div>
  </section>

  <!-- WAT VISUAILS IS -->
  <section class="section-tight">
    <div class="container intro-split">
      <p class="editorial-statement reveal pending">Voor kledingmerken die liever <em>groeien</em> dan nóg een shoot boeken. Je hebt een drop te lanceren — geen week te verliezen aan een studio.</p>
      <div class="mini-benefits reveal pending">
        <div class="mini-benefit">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg>
          <div><strong>Terug in ongeveer een dag</strong><span>Stuur vandaag een foto, publiceer morgen de campagne — niet over drie weken.</span></div>
        </div>
        <div class="mini-benefit">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5" /></svg>
          <div><strong>Meer dan alleen AI</strong><span>We werken elke visual af met professionele editingtools en colour grading, en een mens controleert het met de hand — nooit automatisch verstuurd.</span></div>
        </div>
        <div class="mini-benefit">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7l9-4 9 4-9 4-9-4zM3 7v10l9 4 9-4V7" /></svg>
          <div><strong>Geen studio, niets opsturen</strong><span>Geen fotograaf om te boeken, geen product om op te sturen. Je foto is de hele briefing.</span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- DE ONTWIKKELING — bewijs vóór het menu. -->
  <section class="section-tight" id="develop">
    <div class="container two-col">
      <div class="reveal pending">
        <h2>Eén foto erin. <em>De rest is aan ons.</em></h2>
        <p class="lead" style="margin-top:1rem">Dit is de hele briefing die we van je nodig hebben — een telefoonfoto. Zie hoe het een strakke, publicatieklare visual wordt.</p>
        <div class="dev-steps" aria-hidden="true">
          <p class="dev-step"><span class="dn">01</span>Ruwe telefoonfoto — de hele briefing</p>
          <p class="dev-step"><span class="dn">02</span>Achtergrond weg · kleur vastgezet op je merk</p>
          <p class="dev-step"><span class="dn">03</span>Met de hand gecontroleerd · klaar om te publiceren</p>
        </div>
        <div class="flex" style="margin-top:1.6rem">
          <a href="/nl/test-sample" class="btn btn-primary">Probeer het op je product</a>
          <a href={WA} class="btn btn-wa" target="_blank" rel="noopener">
            <svg class="i" viewBox="0 0 24 24"><path d="M21 11.5a8.38 8.38 0 0 1-8.5 8.5 8.5 8.5 0 0 1-4-1L3 20l1.5-4.5A8.38 8.38 0 0 1 3.5 11 8.5 8.5 0 0 1 12 3a8.38 8.38 0 0 1 8.5 8.5z" /></svg>
            WhatsApp ons
          </a>
        </div>
        <p style="margin-top:.9rem;font-size:.82rem;color:var(--ink-3)">Een echt persoon, in Enschede — meestal binnen een uur antwoord op werkdagen.</p>
      </div>
      <div class="reveal pending">
        <Compare
          before="/img/catalog-before.webp"
          after="/img/catalog-after.webp"
          ratio="1/1"
          objectPosition="50% 62%"
          beforeLabel="Jouw foto"
          afterLabel="VISUAILS"
          beforeAlt="Een ruwe telefoonfoto van een kledingstuk vóór VISUAILS"
          afterAlt="Hetzelfde kledingstuk als strakke catalogvisual ná VISUAILS"
        />
      </div>
    </div>
  </section>

  <!-- DE SPREAD — bewijs op schaal. -->
  <section class="ch">
    <div class="container">
      <div class="ch-head">
        <span class="ch-orb" aria-hidden="true"></span>
        <h2 class="ch-title"><span class="ch-l">Echt werk.</span><span class="ch-l dim">Nul fotoshoots.</span></h2>
      </div>
      <div class="spread" data-spread>
        <a class="sp-item sp-a" href="/nl/catalog">
          <div class="sp-media" data-zoom><img src="/img/custom-models-02.webp" alt="On-model catalogvisual" loading="lazy" /></div>
          <div class="sp-cap"><b>On-model</b><span>In elke catalogset inbegrepen</span></div>
        </a>
        <a class="sp-item sp-b" href="/nl/catalog">
          <div class="sp-media" data-zoom><img src="/img/catalog-after.webp" alt="Strakke catalogvisual" loading="lazy" /></div>
          <div class="sp-cap"><b>Catalog</b><span>€39,99 / product</span></div>
        </a>
        <a class="sp-item sp-c" href="/nl/lifestyle">
          <div class="sp-media" data-zoom><img src="/img/lifestyle-glow-01.webp" alt="Lifestyle-visual in de Glow-stijl" loading="lazy" /></div>
          <div class="sp-cap"><b>Lifestyle</b><span>€59,99 / product</span></div>
        </a>
        <a class="sp-item sp-d" href="/nl/video">
          <div class="sp-media" data-zoom>
            <img src="/img/banners-16.webp" alt="Productvideo-still" loading="lazy" />
            <span class="sp-play" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z" /></svg></span>
          </div>
          <div class="sp-cap"><b>Video</b><span>vanaf €49 / video</span></div>
        </a>
      </div>
    </div>
  </section>

  <!-- DE LEDGER — nu het werk gesproken heeft: het menu. -->
  <section class="ch">
    <div class="container">
      <div class="ed-head">
        <span class="ed-meta">( Diensten )</span>
        <div>
          <h2>Vier manieren om groter te lijken dan je bent.</h2>
          <p class="ed-sub">Betaal per product — geen abonnement. Klap een rij open om te zien waarvoor het is en waar het leeft.</p>
        </div>
      </div>
      <div class="svc-index" data-index>
        <div class="idx-float" aria-hidden="true"><img src="/img/catalog-after.webp" alt="" /></div>
        {ledger.map((s) => (
          <details class="idx-item">
            <summary class="idx-row" data-img={s.img}>
              <span class="idx-num">{s.n}</span>
              <span class="idx-name">{s.name}</span>
              <p class="idx-meta">{s.meta}</p>
              <span class="idx-price">{s.price}</span>
              <span class="idx-toggle" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M6 9l6 6 6-6" /></svg></span>
            </summary>
            <div class="idx-panel">
              <div class="idx-panel-in">
                <div class="idx-panel-text">
                  <p class="idx-use"><span class="idx-use-label">Waarvoor</span>{s.use}</p>
                  <div class="idx-where">{s.where.map((w) => (<span class="idx-tag">{w}</span>))}</div>
                  <div class="idx-actions">
                    <a href={s.order} class="btn btn-primary">Bestel {s.name} &rarr;</a>
                    <a href={s.href} class="link-arrow">Bekijk voorbeelden &rarr;</a>
                  </div>
                </div>
                <div class="idx-shots">
                  {s.shots.map((src) => (<img src={src} alt="" loading="lazy" />))}
                </div>
              </div>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- DE SET — ledger-rij 01, uitgeklapt. -->
  <section class="ch">
    <div class="container">
      <div class="ch-head">
        <span class="ch-orb" aria-hidden="true"></span>
        <h2 class="ch-title"><span class="ch-l">Eén product. Vier foto’s.</span><span class="ch-l dim">€39,99. Dat is de deal.</span></h2>
        <p class="ch-sub">Elke catalogbestelling komt terug als een complete set — inclusief een echte on-model shot. Zo’n €10 per foto, waar een shootdag €1.000–2.000 kost — en jij hoeft de deur niet uit.</p>
      </div>
      <div class="set-strip" data-stagger>
        <figure class="set-frame">
          <div class="sf-media" data-zoom><img src="/img/catalog-after.webp" alt="Voorkant-catalogshot" loading="lazy" /></div>
          <figcaption class="sf-cap"><span class="sfn">01</span><b>Voorkant</b></figcaption>
        </figure>
        <figure class="set-frame">
          <div class="sf-media" data-zoom><img src="/img/catalog-after.webp" alt="Achterkant-catalogshot" loading="lazy" /></div>
          <figcaption class="sf-cap"><span class="sfn">02</span><b>Achterkant</b></figcaption>
        </figure>
        <figure class="set-frame">
          <div class="sf-media" data-zoom><img src="/img/catalog-before.webp" alt="Detail-close-up van logo of stof" loading="lazy" /></div>
          <figcaption class="sf-cap"><span class="sfn">03</span><b>Detail</b></figcaption>
        </figure>
        <figure class="set-frame">
          <div class="sf-media" data-zoom><img src="/img/custom-models-02.webp" alt="On-model shot, gedragen voor pasvorm" loading="lazy" /></div>
          <figcaption class="sf-cap"><span class="sfn">04</span><b>On-model</b></figcaption>
        </figure>
      </div>
      <div class="ch-cta">
        <a href="/nl/order-catalog" class="btn btn-primary btn-glow">Bestel catalog — €39,99 / product</a>
      </div>
    </div>
  </section>

  <!-- HET PROCES -->
  <section class="ch">
    <div class="container">
      <div class="ed-head">
        <span class="ed-meta">( Proces )</span>
        <div>
          <h2>Van foto naar publicatie.</h2>
          <p class="ed-sub">Vier stappen, één werkdag. Jij doet alleen de eerste.</p>
        </div>
      </div>
      <div class="process" data-stagger>
        <div class="pr-step">
          <span class="pr-num">01</span>
          <h3 class="pr-t">Upload</h3>
          <p class="pr-b">Eén duidelijke foto van je product — dat is de hele briefing.</p>
        </div>
        <div class="pr-step">
          <span class="pr-num">02</span>
          <h3 class="pr-t">Wij bouwen</h3>
          <p class="pr-b">AI plus professionele editingtools en colour grading, afgestemd op jouw merk.</p>
        </div>
        <div class="pr-step">
          <span class="pr-num">03</span>
          <h3 class="pr-t">Menselijke check</h3>
          <p class="pr-b">Een mens keurt elke visual goed voordat hij bij je komt — nooit automatisch verstuurd.</p>
        </div>
        <div class="pr-step">
          <span class="pr-num">04</span>
          <h3 class="pr-t">Publiceren</h3>
          <p class="pr-b">~24 uur later: bestanden klaar voor je shop, ads en socials.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FILMSTRIP -->
  <section class="section-tight">
    <div class="visual-marquee">
      <div class="vm-row">
        <img src={strip[0]} alt="Lifestyle-visual in Flash-stijl" loading="lazy" />
        <img src={strip[1]} alt="Lifestyle-visual in Dunes-stijl" loading="lazy" />
        <img src="/img/banners-09.webp" alt="Campagnevisual" loading="lazy" />
        <img src={strip[2]} alt="Lifestyle-visual in Phone-made-stijl" loading="lazy" />
        <img src={strip[0]} alt="" aria-hidden="true" loading="lazy" />
        <img src={strip[1]} alt="" aria-hidden="true" loading="lazy" />
        <img src="/img/banners-09.webp" alt="" aria-hidden="true" loading="lazy" />
        <img src={strip[2]} alt="" aria-hidden="true" loading="lazy" />
      </div>
      <div class="vm-row">
        <img src={strip[3]} alt="Campagnefotografie" loading="lazy" />
        <img src="/img/lifestyle-glow-05.webp" alt="Lifestyle-visual in Glow-stijl" loading="lazy" />
        <img src={strip[4]} alt="Campagnefotografie" loading="lazy" />
        <img src="/img/lifestyle-flash-07.webp" alt="Lifestyle-visual in Flash-stijl" loading="lazy" />
        <img src={strip[3]} alt="" aria-hidden="true" loading="lazy" />
        <img src="/img/lifestyle-glow-05.webp" alt="" aria-hidden="true" loading="lazy" />
        <img src={strip[4]} alt="" aria-hidden="true" loading="lazy" />
        <img src="/img/lifestyle-flash-07.webp" alt="" aria-hidden="true" loading="lazy" />
      </div>
    </div>
  </section>

  <!-- KWALITEITSGARANTIE -->
  <section class="section-tight">
    <div class="container">
      <div class="ed-head" style="margin-bottom:clamp(2.4rem,4.5vw,3.6rem)">
        <span class="ed-meta">( Kwaliteit )</span>
        <div>
          <h2>Hoe meer je ons laat zien, <em>hoe meer we garanderen.</em></h2>
          <p class="ed-sub">Eén duidelijke foto is genoeg om te starten. Maar omdat we je product meestal nooit in handen hebben, laten een paar extra hoeken ons het exact matchen — hier wordt kwaliteit gewonnen.</p>
        </div>
      </div>
      <div class="req-grid reveal-group">
        {reqs.map((r) => (
          <div class="req-card reveal pending">
            <span class="rc-num">{r.n}</span>
            <h4>{r.title}</h4>
            <p>{r.body}</p>
          </div>
        ))}
      </div>
      <p class="req-note reveal pending"><strong>Niet verplicht — alleen aanbevolen.</strong> We kunnen al leveren met één foto van het hele product. Stuur de volledige set en we garanderen dat pasvorm, kleur en detail meteen goed uitkomen.</p>
    </div>
  </section>

  <!-- LEAD MAGNET — de gratis briefing-foto checklist. -->
  <section class="section-tight">
    <div class="container">
      <div class="lead-magnet reveal pending">
        <div class="lm-copy">
          <span class="lm-kicker">Gratis · de briefing-foto checklist</span>
          <h2>De één-pagina checklist voor een foto die wij tot campagne maken.</h2>
          <ul class="lm-list">
            <li>De vier hoeken die het resultaat garanderen</li>
            <li>Licht en achtergrond in 30 seconden, met een telefoon</li>
            <li>De fouten die je een revisieronde kosten</li>
          </ul>
        </div>
        <form class="lm-form" action="/api/order" method="post">
          <input type="hidden" name="service" value="subscribe" />
          <input type="hidden" name="redirect" value="/nl/thank-you" />
          <input type="hidden" name="lang" value="nl" />
          <input type="text" name="company_hp" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0" />
          <input type="hidden" name="subscribe" value="briefing-checklist" />
          <label class="lm-label" for="lm-email">Waar mogen we hem heen sturen?</label>
          <div class="lm-row">
            <input id="lm-email" type="email" name="email" required placeholder="jij@jouwmerk.nl" autocomplete="email" />
            <button type="submit" class="btn btn-primary" data-track="lead-magnet">Stuur mij de checklist</button>
          </div>
          <p class="lm-fine">Eén e-mail met de checklist en onze beste voor/na’s. Geen spam, altijd uitschrijfbaar.</p>
        </form>
      </div>
    </div>
  </section>

  <!-- MODELLEN -->
  <section class="section-tight">
    <div class="container">
      <div class="photo-split reverse reveal pending">
        <div class="photo-split-media">
          <img src="/img/custom-models-02.webp" alt="Een VISUAILS-model, consistent gestyled door een hele campagne" loading="lazy" />
        </div>
        <div>
          <h2>Eén gezicht.<br /><em>Elke campagne.</em></h2>
          <p class="lead" style="margin-top:1rem">Hetzelfde model, vastgezet op jouw merk, door je hele collectie — of een eigen gezicht dat alleen voor jou gemaakt is. Eenmaal vastgezet is elke volgende drop nog maar één foto ver weg.</p>
          <div style="margin-top:1.2rem"><a class="link-arrow" href="/nl/models">Bekijk de modellen &rarr;</a></div>
        </div>
      </div>
    </div>
  </section>

  <!-- NIET ALLE AI IS GELIJK -->
  <section class="section-tight">
    <div class="container">
      <div class="section-head" style="text-align:center;margin-inline:auto">
        <h2>Niet alle AI is <em>gelijk.</em></h2>
        <p style="margin-inline:auto">Generieke AI-generators gokken. VISUAILS is gebouwd op jouw product, afgewerkt met professionele editingtools en colour grading, en gecontroleerd door een mens voordat het bij je komt.</p>
      </div>
      <div class="ai-compare reveal pending">
        <div class="ai-compare-panel generic">
          <img src="/img/lifestyle-flash-07.webp" alt="Illustratieve simulatie van een typisch generiek AI-resultaat — geen echte concurrentfoto" loading="lazy" />
