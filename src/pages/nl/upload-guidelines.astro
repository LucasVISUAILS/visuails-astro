---
// VISUAILS — Uploadrichtlijnen (Nederlands). Vertaling van src/pages/upload-guidelines.astro.
import Layout from '../../layouts/Layout.astro';
import { TEST_SAMPLE } from '../../data/pricing.js';

// De proefvisualkosten stonden hier ook ingetypt. Het is een tier-feit en komt
// dus uit pricing.js — zie src/pages/nl/test-sample.astro voor dezelfde fix.
const SAMPLE = TEST_SAMPLE.nl;
import ProductScene from '../../components/ProductScene.astro';
---

<Layout
  title="Uploadrichtlijnen — VISUAILS"
  description="Eenvoudige tips voor de productfoto's die je ons stuurt, zodat je visuals scherp, accuraat en snel worden."
>
  <section class="page-hero"><div class="container">
    <span class="eyebrow-page">De beste resultaten halen</span>
    <h1 class="display">Zo maak je foto's waar wij magie mee kunnen doen</h1>
    <p class="lead" style="margin-top:1.1rem">Je hebt geen studio nodig — alleen een scherpe foto en een paar eenvoudige gewoontes.</p>
    <div class="flex" style="margin-top:1.8rem">
      <a href="/nl/test-sample" class="btn btn-primary btn-lg">Probeer een proefvisual</a>
      <a href="/nl/start" class="btn btn-ghost btn-lg">Start een bestelling</a>
    </div>
  </div></section>

  <section><div class="container">
    <div class="grid grid-2 reveal-group">
      <div class="card reveal pending">
        <h3 style="color:var(--ink)">Wel doen</h3>
        <ul class="checklist" style="margin-top:1rem">
          <li><svg viewBox="0 0 24 24" class="i"><path d="M20 6L9 17l-5-5" /></svg><span>Houd het scherp &amp; duidelijk — in focus, geen bewegingsonscherpte.</span></li>
          <li><svg viewBox="0 0 24 24" class="i"><path d="M20 6L9 17l-5-5" /></svg><span>Gebruik een neutrale, rustige achtergrond.</span></li>
          <li><svg viewBox="0 0 24 24" class="i"><path d="M20 6L9 17l-5-5" /></svg><span>Belicht het goed en gelijkmatig — daglicht werkt uitstekend.</span></li>
          <li><svg viewBox="0 0 24 24" class="i"><path d="M20 6L9 17l-5-5" /></svg><span>Toon het volledige product, plus een paar close-ups van belangrijke details.</span></li>
          <li><svg viewBox="0 0 24 24" class="i"><path d="M20 6L9 17l-5-5" /></svg><span>Stuur de hoogste resolutie die je hebt.</span></li>
        </ul>
      </div>
      {/* Zie de Engelse pagina voor de volledige toelichting. Kort: de rode
          oklch(0.78 0.15 25) viel buiten sRGB, haalde met 2.02:1 op papier de
          WCAG-drempel voor een h3 niet, en was de enige verzadigde kleur op een
          marketingpagina — tegen de afspraak in global.css in. Deze kaart zegt
          "minder" nu zoals .not-ideal dat verderop op deze pagina al doet: door
          de ondergrond te laten zakken. De ✕ tegenover de ✓ draagt de betekenis. */}
      <div class="card reveal pending" style="background:var(--surface-2)">
        <h3 style="color:var(--ink)">Vermijden</h3>
        <ul class="checklist" style="margin-top:1rem">
          <li><svg viewBox="0 0 24 24" class="i"><path d="M18 6L6 18M6 6l12 12" /></svg><span>Wazige, donkere of slecht belichte foto's.</span></li>
          <li><svg viewBox="0 0 24 24" class="i"><path d="M18 6L6 18M6 6l12 12" /></svg><span>Drukke of afleidende achtergronden.</span></li>
          <li><svg viewBox="0 0 24 24" class="i"><path d="M18 6L6 18M6 6l12 12" /></svg><span>Zware filters of sterke kleurzweem.</span></li>
          <li><svg viewBox="0 0 24 24" class="i"><path d="M18 6L6 18M6 6l12 12" /></svg><span>Kleine schermafbeeldingen met lage resolutie.</span></li>
          <li><svg viewBox="0 0 24 24" class="i"><path d="M18 6L6 18M6 6l12 12" /></svg><span>Een deel van het product buiten beeld snijden.</span></li>
        </ul>
      </div>
    </div>
    <div class="two-col" style="margin-top:2.5rem">
      <div class="reveal pending not-ideal">
        <ProductScene icon="bottle" width="44%" badge="Niet ideaal — dof &amp; vlak" wide />
      </div>
      <div class="reveal pending">
        <ProductScene icon="bottle" width="44%" badge="Goed — scherp &amp; goed belicht" wide />
      </div>
    </div>
  </div></section>

  <section class="section-tight">
    <div class="container">
      <div class="section-head">
        <h2>De set die we aanraden — <em>en waarom.</em></h2>
        <p>We houden jouw product meestal nooit in handen, dus hoe meer hoeken je stuurt, hoe nauwkeuriger we het kunnen nabouwen. Zo garanderen we het resultaat in plaats van het te benaderen.</p>
      </div>
      <div class="req-grid reveal-group">
        <div class="req-card reveal pending"><span class="rc-num">01</span><h4>Voor- &amp; achterkant</h4><p>Het hele product van beide kanten, zodat er niets aan de vorm wordt gegokt.</p></div>
        <div class="req-card reveal pending"><span class="rc-num">02</span><h4>Een detail-close-up</h4><p>Logo's, stiksels, prints, hardware — de dingen die exact moeten blijven.</p></div>
        <div class="req-card reveal pending"><span class="rc-num">03</span><h4>De stof</h4><p>Een close-up van het materiaal zodat textuur, weving en glans natuurgetrouw overkomen.</p></div>
        <div class="req-card reveal pending"><span class="rc-num">04</span><h4>Gedragen voor de pasvorm</h4><p>Iemand die het daadwerkelijk draagt, zodat we de pasvorm en val uit de praktijk kunnen reproduceren.</p></div>
      </div>
      <p class="req-note reveal pending"><strong>Niet verplicht — alleen aanbevolen.</strong> Eén scherpe foto van het hele product is genoeg om te starten en te leveren. Stuur de volledige set en we kunnen garanderen dat de pasvorm, kleur en details de eerste keer goed uitkomen.</p>
    </div>
  </section>

  <section class="section-tight"><div class="container"><div class="cta-band reveal pending">
    <h2 class="display" style="font-size:clamp(2rem,4.5vw,3rem)">Heb je een foto klaar? Laten we het transformeren.</h2>
    <p class="lead" style="margin:1rem auto 0;text-align:center">Begin met één proefvisual — slechts een verificatie van {SAMPLE.price}.</p>
    <div class="flex" style="justify-content:center;margin-top:1.8rem">
      <a href="/nl/test-sample" class="btn btn-primary btn-lg">Proefvisual</a>
      <a href="/nl/start" class="btn btn-ghost btn-lg">Start een bestelling</a>
    </div>
  </div></div></section>
</Layout>

<style>
  /* Desaturated treatment for the "not ideal" example — mirrors the static
     site's .ba-before-scene filter, scoped here since it's only used once. */
  :global(.not-ideal) { filter: saturate(.4) brightness(.92) contrast(.92); }
</style>
