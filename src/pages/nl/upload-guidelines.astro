---
// VISUAILS — Uploadrichtlijnen (Nederlands). Vertaling van src/pages/upload-guidelines.astro.
import Layout from '../../layouts/Layout.astro';
import { TEST_SAMPLE } from '../../data/pricing.js';

// De proefvisualkosten stonden hier ook ingetypt. Het is een tier-feit en komt
// dus uit pricing.js — zie src/pages/nl/test-sample.astro voor dezelfde fix.
const SAMPLE = TEST_SAMPLE.nl;
/* ── DE ONDERGRENS STAAT NU OP DE PAGINA DIE HEM VRAAGT — 23 augustus 2026 ──
 *
 * Hier stond "Send the highest resolution you have" en verder niets over
 * formaat. Sinds vandaag WEIGERT het bestelformulier een foto onder een
 * ondergrens (zie keurBeeld() in src/data/shots.js), en een weigering die
 * nergens is aangekondigd, is een weigering die iemand op stap 2 tegenkomt
 * zonder te weten wat hij dan moet.
 *
 * Uit de constante en niet ingetypt, om dezelfde reden als de bewaartermijnen in
 * terms.astro: dit is een getal dat de code afdwingt, en een pagina die er zijn
 * eigen versie van bijhoudt, belooft op een dag iets anders dan er gebeurt. */
import { MIN_LANGE_ZIJDE } from '../../data/shots.js';
import Placeholder from '../../components/Placeholder.astro';
import ProductScene from '../../components/ProductScene.astro';
---

<Layout
  title="Uploadrichtlijnen — VISUAILS"
  description="Eenvoudige tips voor de productfoto’s die je ons stuurt, zodat je visuals scherp, accuraat en snel worden."
>
  <section class="page-hero"><div class="container">
    <span class="eyebrow-page">De beste resultaten halen</span>
    <h1 class="display">Zo maak je de foto die wij nodig hebben</h1>
    <p class="lead" style="margin-top:1.1rem">Je hebt geen studio nodig. Een scherpe foto en een paar dingen waar je even op let, dat is het.</p>
    {/* /guides kreeg nergens in de body van de site een inkomende link (brief
        §1 hangt hem in de keten), en dit is de pagina waar de hub als eerste
        naar wijst. */}
    <p class="hub-note">Van alles in de <a href="/nl/guides/">gidsen</a> is dit het stuk om te lezen vóór je bestelt — elke stap daarna werkt beter als de foto die erin gaat klopt.</p>
    <div class="flex" style="margin-top:1.8rem">
      <a href="/nl/test-sample/" class="btn btn-primary btn-lg">Probeer een proefvisual</a>
      <a href="/nl/start/" class="btn btn-ghost btn-lg">Start een bestelling</a>
    </div>
  </div></section>

  <section><div class="container">
    <div class="grid grid-2 reveal-group">
      <div class="card reveal pending">
        <h2 class="as-h3" style="color:var(--ink)">Wel doen</h2>
        <ul class="checklist" style="margin-top:1rem">
          <li><svg viewBox="0 0 24 24" class="i" aria-hidden="true"><path d="M20 6L9 17l-5-5" /></svg><span>Houd het scherp &amp; duidelijk — in focus, geen bewegingsonscherpte.</span></li>
          <li><svg viewBox="0 0 24 24" class="i" aria-hidden="true"><path d="M20 6L9 17l-5-5" /></svg><span>Gebruik een neutrale, rustige achtergrond.</span></li>
          <li><svg viewBox="0 0 24 24" class="i" aria-hidden="true"><path d="M20 6L9 17l-5-5" /></svg><span>Belicht het goed en gelijkmatig — daglicht werkt uitstekend.</span></li>
          <li><svg viewBox="0 0 24 24" class="i" aria-hidden="true"><path d="M20 6L9 17l-5-5" /></svg><span>Toon het volledige product, plus een paar close-ups van belangrijke details.</span></li>
          <li><svg viewBox="0 0 24 24" class="i" aria-hidden="true"><path d="M20 6L9 17l-5-5" /></svg><span>Stuur de hoogste resolutie die je hebt — minstens {MIN_LANGE_ZIJDE} pixels op de lange zijde, en dat haalt elke telefoon van de afgelopen tien jaar. Daaronder wordt de upload meteen geweigerd met de reden erbij, zodat je het weet terwijl je er nog achter zit en niet pas een dag later.</span></li>
        </ul>
      </div>
      {/* Zie de Engelse pagina voor de volledige toelichting. Kort: de rode
          oklch(0.78 0.15 25) viel buiten sRGB, haalde met 2.02:1 op papier de
          WCAG-drempel voor een h3 niet, en was de enige verzadigde kleur op een
          marketingpagina — tegen de afspraak in global.css in. Deze kaart zegt
          "minder" nu zoals .not-ideal dat verderop op deze pagina al doet: door
          de ondergrond te laten zakken. De ✕ tegenover de ✓ draagt de betekenis. */}
      <div class="card reveal pending" style="background:var(--surface-2)">
        <h2 class="as-h3" style="color:var(--ink)">Vermijden</h2>
        <ul class="checklist" style="margin-top:1rem">
          <li><svg viewBox="0 0 24 24" class="i" aria-hidden="true"><path d="M18 6L6 18M6 6l12 12" /></svg><span>Wazige, donkere of slecht belichte foto’s.</span></li>
          <li><svg viewBox="0 0 24 24" class="i" aria-hidden="true"><path d="M18 6L6 18M6 6l12 12" /></svg><span>Drukke of afleidende achtergronden.</span></li>
          <li><svg viewBox="0 0 24 24" class="i" aria-hidden="true"><path d="M18 6L6 18M6 6l12 12" /></svg><span>Zware filters of sterke kleurzweem.</span></li>
          <li><svg viewBox="0 0 24 24" class="i" aria-hidden="true"><path d="M18 6L6 18M6 6l12 12" /></svg><span>Kleine schermafbeeldingen met lage resolutie.</span></li>
          <li><svg viewBox="0 0 24 24" class="i" aria-hidden="true"><path d="M18 6L6 18M6 6l12 12" /></svg><span>Een deel van het product buiten beeld snijden.</span></li>
        </ul>
      </div>
    </div>
    {/* ── TWEE ECHTE FOTO'S, GEEN TEKENING — 20 augustus 2026 ─────────────────
        Hier stonden twee `<ProductScene>`-illustraties: dezelfde getekende fles,
        één met het label "niet ideaal" en één met "goed". Dat is een tekening die
        beweert iets over fotografie te laten zien, en dat kan een tekening niet.
        Deze pagina is de enige op de site die de bezoeker vraagt zélf een foto te
        maken; hij moet het verschil kunnen ZIEN, niet lezen dat er verschil is.

        Placeholders in plaats van niets, zodat `npm run placeholders` deze twee
        blijft tellen tot ze er zijn — zie de noot in Placeholder.astro. De
        opdracht staat eronder: het moet hetzelfde product zijn in allebei de
        kaders, want anders vergelijk je twee producten in plaats van twee foto's. */}
    <div class="two-col" style="margin-top:2.5rem">
      <div class="reveal pending not-ideal">
        <Placeholder
          lang="nl"
          ratio="4 / 3"
          subject={`Hetzelfde product slecht gefotografeerd: een telefoonfoto in een schemerige kamer, op een rommelig oppervlak, net niet scherp`}
          message={`Moet eruitzien als een foto die iemand ons echt zou sturen — geen karikatuur. Weinig licht, vlak, een drukke achtergrond, en net zo onscherp dat de rand van het product niet klopt. Hetzelfde product en dezelfde hoek als in het kader ernaast; alleen de omstandigheden verschillen.`}
        />
      </div>
      <div class="reveal pending">
        <Placeholder
          lang="nl"
          ratio="4 / 3"
          subject={`Hetzelfde product goed gefotografeerd: daglicht van een raam, een egaal oppervlak, scherp tot aan de rand`}
          message={`Moet haalbaar zijn met een telefoon en zonder spullen — dat is de hele belofte van deze pagina. Daglicht, een egale muur of tafel, het product vult het kader, scherp. Niets gestyled en niets nabewerkt; ziet het eruit als studiowerk, dan concludeert de lezer dat hij het zelf niet kan.`}
        />
      </div>
    </div>
  </div></section>

  <section class="section-tight">
    <div class="container">
      <div class="section-head">
        <h2>De set die we aanraden — <em>en waarom.</em></h2>
        <p>We hebben je product bijna nooit in handen, dus hoe meer hoeken je stuurt, hoe nauwkeuriger we het kunnen nabouwen. Dat is het verschil tussen je product nábouwen en het benaderen.</p>
      </div>
      <div class="req-grid reveal-group">
        <div class="req-card reveal pending"><span class="rc-num">01</span><h3>Voor- &amp; achterkant</h3><p>Het hele product van beide kanten, zodat er niets aan de vorm wordt gegokt.</p></div>
        <div class="req-card reveal pending"><span class="rc-num">02</span><h3>Een detail-close-up</h3><p>Logo’s, stiksels, prints, hardware — de dingen die exact moeten blijven.</p></div>
        <div class="req-card reveal pending"><span class="rc-num">03</span><h3>De stof</h3><p>Een close-up van het materiaal zodat textuur, weefselstructuur en glans natuurgetrouw overkomen.</p></div>
        <div class="req-card reveal pending"><span class="rc-num">04</span><h3>Iemand die het aanheeft</h3><p>Iemand die het daadwerkelijk draagt, zodat we de pasvorm en val uit de praktijk kunnen reproduceren.</p></div>
      </div>
      <p class="req-note reveal pending"><strong>De eerste is verplicht. De rest is aanbevolen.</strong> Voorkant en achterkant krijg je allebei terug als geleverd beeld, dus vragen we ze allebei in plaats van de kant te verzinnen die we niet zien. De close-up en de draagfoto zijn optioneel — elk maakt één ding nauwkeuriger, en heeft een product geen logo of fournituren om op in te zoomen, dan wordt de close-up die je terugkrijgt een stoffoto.</p>
    </div>
  </section>

  <section class="section-tight"><div class="container"><div class="cta-band reveal pending">
    <h2 class="display" style="font-size:var(--t-page-h1-sm)">Foto klaar? Stuur hem in.</h2>
    <p class="lead" style="margin:1rem auto 0;text-align:center">Begin met één proefvisual — je betaalt {SAMPLE.feeNote}.</p>
    <div class="flex" style="justify-content:center;margin-top:1.8rem">
      <a href="/nl/test-sample/" class="btn btn-primary btn-lg">Proefvisual</a>
      <a href="/nl/start/" class="btn btn-ghost btn-lg">Start een bestelling</a>
    </div>
  </div></div></section>
</Layout>

<style>
  /* Desaturated treatment for the "not ideal" example — mirrors the static
     site’s .ba-before-scene filter, scoped here since it’s only used once. */
  /* HET FILTER OP HET ZWAKKE KADER IS WEG — 20 augustus 2026.
     `.not-ideal` stond op `saturate(.4) brightness(.92) contrast(.92)`, en dat
     klopte zolang er een TEKENING in stond: een illustratie die niemand voor een
     foto aanziet, mag je dempen om te laten zien welke kant je op moet kijken.
     Er komt nu een echte foto in van hoe een slechte inzending eruitziet, en die
     mag je niet nabewerken — dan zegt het beeld niet meer "zo ziet een slechte
     foto eruit" maar "wij hebben deze foto slechter gemaakt". Het kruisje, de
     kop en de opdracht eronder dragen de betekenis; die deden dat altijd al. */

  /* De regel terug naar de gidsen-hub. Bodytekst onder de lead, geen badge. */
  .hub-note { margin-top: .9rem; max-width: 62ch; font-size: .92rem; color: var(--ink-3); line-height: 1.6; }
  .hub-note a { color: var(--accent-bright); text-decoration: underline; text-underline-offset: 3px; }
</style>
