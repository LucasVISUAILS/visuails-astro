---
// VISUAILS — order catalog visuals. Ported from the SvelteKit /order-catalog
// route. Field set, copy and pricing are preserved verbatim.
//
// The Svelte source used a `customBg` $state boolean, toggled by the two
// background radios, to conditionally render the hex-code field. That's
// cosmetic (a form field visibility toggle) so it's reproduced here with
// pure CSS (:has()) instead of JS — the default-checked "White" radio
// keeps the hex field hidden until "Custom colour" is selected. See <style>
// below for `.bg-field:has(...)`.
import Layout from '../../layouts/Layout.astro';

// Standard-model roster (matches /models). Only shown once "On a model" is
// picked below — kept non-required so the hidden picker can never block submit.
const roster = ['Aaron', 'Ava', 'Dana', 'Elias', 'Fabi', 'Lisa', 'Maegan', 'Rae', 'Ryan', 'Seme'];
---

<Layout
  title="Catalogusvisuals bestellen — VISUAILS"
  description="Eén prijs per product: €39,99 voor een volledige set van 4 foto's — voorkant, achterkant, een logo-/stofdetail en één shot op model. Geleverd in ongeveer 24 uur, elke afbeelding met de hand gecontroleerd."
>
  <section class="page-hero" style="padding-bottom:0">
    <div class="container">
      <p class="eyebrow-page"><a href="/nl/order" style="color:inherit">&larr; Alle bestelopties</a></p>
    </div>
  </section>

  <section id="catalog" class="ord-anchor">
    <div class="container narrow">
      <div class="section-head">
        <h1 style="font-size:var(--t-h2)">Catalogusvisuals aanvragen</h1>
        <p>Eén prijs per product — <strong style="color:var(--accent-bright)">&euro;39,99</strong>, en je krijgt een <strong>volledige set van 4 foto's</strong>. Dat is ongeveer &euro;10 per foto, met een echte shot op model inbegrepen.</p>
      </div>

      <!-- What one product gets you — set clearly before the form. -->
      <ul class="pack-grid">
        <li><span class="pack-n">1</span><div><strong>Voorkant</strong><span>De hero-catalogusshot.</span></div></li>
        <li><span class="pack-n">2</span><div><strong>Achterkant</strong><span>De achterzijde, dezelfde belichting.</span></div></li>
        <li><span class="pack-n">3</span><div><strong>Detailclose-up</strong><span>Logo, print of stoftextuur.</span></div></li>
        <li><span class="pack-n">4</span><div><strong>Op model</strong><span>Gedragen, voor pasvorm &amp; schaal.</span></div></li>
      </ul>

      <div class="card" style="padding:clamp(1.4rem,3vw,2.4rem)">
        <!-- TODO: wire this form to a real submit handler (Cloudflare Pages Function, Formspree, etc.) before launch — no backend in this static build yet -->
        <form action="/api/order" method="post" id="cat-form">
          <input type="hidden" name="service" value="catalog" />
          <input type="hidden" name="redirect" value="/nl/thank-you" />
          <input type="hidden" name="lang" value="nl" />
          <input type="text" name="company_hp" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0" />
          <div class="field">
            <label for="cat-name">Naam <span class="req">*</span></label>
            <input class="input" type="text" id="cat-name" name="name" autocomplete="name" required />
          </div>
          <div class="row-2">
            <div class="field">
              <label for="cat-brand">Merk of winkelnaam <span class="req">*</span></label>
              <input class="input" type="text" id="cat-brand" name="brand" autocomplete="organization" required />
            </div>
            <div class="field">
              <label for="cat-web">Websitelink</label>
              <input class="input" type="url" id="cat-web" name="website" placeholder="https://" autocomplete="url" />
            </div>
          </div>

          <div class="field">
            <label for="cat-qty">Hoeveel producten? <span class="req">*</span></label>
            <select class="select" id="cat-qty" name="products" required>
              <option value="1" selected>1 product</option>
              <option value="2">2 producten</option>
              <option value="3">3 producten</option>
              <option value="4">4 producten</option>
              <option value="5">5 producten</option>
              <option value="6">6 producten</option>
              <option value="7">7 producten</option>
              <option value="8">8 producten</option>
              <option value="9">9 producten</option>
              <option value="10">10 producten</option>
              <option value="More than 10">Meer dan 10 — vraag een volumeprijs aan</option>
            </select>
            <span class="hint">&euro;39,99 per product · elk een set van 4 foto's. Groot assortiment? Kies "Meer dan 10" en we geven je een volumeprijs.</span>
          </div>

          <div class="field">
            <label>Model voor de shot op model <span class="hint" style="font-weight:400">— een van je vier foto's wordt door een model gedragen</span></label>
            <div class="model-picker">
              <div class="choice-grid" style="grid-template-columns:repeat(auto-fit,minmax(116px,1fr))">
                <label class="choice">
                  <input type="radio" name="model" value="VISUAILS choose" checked />
                  <div class="choice-media mono"><div class="mono-av">&#9733;</div></div>
                  <div class="choice-label">Laat VISUAILS kiezen</div>
                </label>
                {roster.map((m) => (
                  <label class="choice">
                    <input type="radio" name="model" value={m} />
                    <div class="choice-media"><img src={`/img/model-${m.toLowerCase()}.webp`} alt={m} loading="lazy" /></div>
                    <div class="choice-label">{m}</div>
                  </label>
                ))}
              </div>
              <span class="hint">Wil je een gezicht dat alleen voor jouw merk is gemaakt? Dat is een <a href="/nl/custom-models" style="color:var(--accent-bright)">custom model</a>.</span>
            </div>
          </div>

          <div class="field bg-field">
            <label>Achtergrondkleur <span class="req">*</span></label>
            <span class="hint" style="margin:-.15rem 0 .35rem">We raden een lichte, neutrale achtergrond aan — wit, gebroken wit, lichtgrijs of beige. Sterke kleuren en donkere achtergronden ogen vaak minder professioneel. De keuze is aan jou.</span>
            <div class="choice-grid" style="grid-template-columns:repeat(auto-fit,minmax(160px,1fr))">
              <label class="choice swatch">
                <input type="radio" name="background" value="White" required checked />
                <div class="choice-media"><span class="sw" style="position:absolute;inset:0;background:#FFFFFF"></span></div>
                <div class="choice-label">Wit <span class="hint" style="font-weight:400">— standaard (#FFFFFF)</span></div>
              </label>
              <label class="choice swatch">
                <input type="radio" name="background" value="Custom colour" />
                <div class="choice-media"><span class="sw sw-custom" style="position:absolute;inset:0"></span></div>
                <div class="choice-label">Aangepaste kleur</div>
              </label>
            </div>
            <div class="field bg-hex-field" style="margin-top:1rem">
              <label for="cat-bg-hex">Hexcode <span class="req">*</span></label>
              <div style="display:flex;align-items:center;gap:.8rem">
                <span class="sw" id="cat-bg-swatch" style="width:44px;height:44px;border-radius:10px;flex:none;background:#ffffff;border:1px solid var(--line-strong)"></span>
                <input class="input" type="text" id="cat-bg-hex" name="background_hex" placeholder="#FFFFFF" pattern="^#?[0-9A-Fa-f]{6}$" maxlength="7" style="max-width:200px" data-hex-preview="#cat-bg-swatch" />
                <span class="hex-preview-label" data-hex-preview-label style="font-size:.82rem;color:var(--ink-3)">Voorbeeld</span>
              </div>
              <span class="hint">Voer de exacte achtergrondkleur van je merk in als hexcode — we tonen een live voorbeeld en matchen deze precies.</span>
              <span class="hint" data-hex-advice style="margin-top:.25rem"></span>
            </div>
          </div>

          <div class="field">
            <label>Heb je productfoto's? <span class="req">*</span></label>
            <label class="opt"><input type="radio" name="have_photos" value="Yes" required /><span class="opt-main"><span class="opt-title">Ja, ik kan ze uploaden</span><span class="opt-desc">Mooi — hoe meer detail, hoe beter het resultaat.</span></span></label>
            <label class="opt"><input type="radio" name="have_photos" value="Not yet" /><span class="opt-main"><span class="opt-title">Nog niet</span><span class="opt-desc">Geen probleem — we nemen contact op over de beste manier om ze te delen.</span></span></label>
          </div>

          <div class="field">
            <label for="cat-upload">Upload productfoto's</label>
            <label class="dropzone" for="cat-upload">
              <svg viewBox="0 0 24 24" class="i"><path d="M12 16V4M6 10l6-6 6 6M4 20h16" /></svg>
              <div><strong>Klik om te uploaden</strong> of sleep bestanden hierheen</div>
              <div class="hint" style="margin-top:.4rem">Heldere, goed belichte foto's geven de nauwkeurigste resultaten.</div>
              <input type="file" id="cat-upload" name="photos" accept="image/*" multiple hidden />
            </label>
          </div>

          <div class="field">
            <label for="cat-msg">Bericht</label>
            <textarea class="textarea" id="cat-msg" name="message" placeholder="Optioneel — alles wat we in gedachten moeten houden over de producten of stijl."></textarea>
          </div>

          <div class="field">
            <label>Voorkeur voor contactmethode <span class="req">*</span></label>
            <label class="opt"><input type="radio" name="contact_method" value="WhatsApp" required checked /><span class="opt-main"><span class="opt-title">Chat via WhatsApp <span class="rec-badge">Aanbevolen</span></span><span class="opt-desc">Snelste antwoorden — meestal binnen het uur.</span></span></label>
            <label class="opt"><input type="radio" name="contact_method" value="Email" /><span class="opt-main"><span class="opt-title">Contact via e-mail</span><span class="opt-desc">We reageren naar je inbox.</span></span></label>
          </div>

          <div class="row-2">
            <div class="field">
              <label for="cat-email">E-mail <span class="req">*</span></label>
              <input class="input" type="email" id="cat-email" name="email" autocomplete="email" required />
            </div>
            <div class="field">
              <label for="cat-phone">Telefoon <span data-phone-indicator><span class="req">*</span></span></label>
              <input class="input" type="tel" id="cat-phone" name="phone" autocomplete="tel" placeholder="+31 6 &hellip;" required />
            </div>
          </div>
          <p class="hint" data-phone-hint style="margin:-.4rem 0 1.2rem">Je koos WhatsApp, dus een telefoonnummer is vereist — vermeld je landcode.</p>

          <label class="opt" style="align-items:flex-start">
            <input type="checkbox" name="newsletter" value="yes" />
            <span class="opt-main"><span class="opt-title">Houd me op de hoogte</span><span class="opt-desc">Af en toe e-mails over nieuwe stijlen en aanbiedingen. Geen spam, altijd uitschrijven mogelijk.</span></span>
          </label>

          <div class="flex" style="margin-top:1.4rem">
            <button type="submit" class="btn btn-primary btn-lg">Verstuur aanvraag · <span id="cat-total">€39,99</span></button>
            <a href="https://wa.me/31625436130?text=Hoi%20VISUAILS%2C%20ik%20wil%20graag%20catalogusvisuals%20bestellen." class="btn btn-wa btn-lg" target="_blank" rel="noopener">
              <svg class="i" viewBox="0 0 24 24"><path d="M21 11.5a8.38 8.38 0 0 1-8.5 8.5 8.5 8.5 0 0 1-4-1L3 20l1.5-4.5A8.38 8.38 0 0 1 3.5 11 8.5 8.5 0 0 1 12 3a8.38 8.38 0 0 1 8.5 8.5z" /></svg>
              Bestel via WhatsApp <span class="rec-badge">Snelst</span>
            </a>
          </div>
                  <p class="form-help">Vast bij een stap, of ergens niet zeker van? <a href="https://wa.me/31625436130?text=Hi%20VISUAILS%2C%20ik%20ben%20een%20bestelling%20aan%20het%20invullen%20en%20heb%20een%20vraag." target="_blank" rel="noopener">Stuur ons een bericht op WhatsApp</a> — meestal binnen een uur antwoord op werkdagen, en we plaatsen de bestelling met je.</p>
        </form>
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <div class="section-head">
        <h2 style="font-size:1.4rem">Op zoek naar iets anders?</h2>
      </div>
      <div class="chip-row">
        <a href="/nl/order-lifestyle" class="chip">Lifestyle</a>
        <a href="/nl/order-video" class="chip">Video</a>
        <a href="/nl/order-custom" class="chip">Custom styling</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Order-form controls — page-scoped (ported from the SvelteKit source;
     only order-* routes use them, so not promoted to global.css). */
  .narrow { max-width: 820px; }
  .field { display: flex; flex-direction: column; gap: 0.45rem; margin-bottom: 1.1rem; }
  .field label { font-size: 0.88rem; font-weight: 600; color: var(--ink); }
  .req { color: var(--accent-bright); }
  .hint { font-size: 0.8rem; color: var(--ink-3); }
  .input, .textarea, .select { width: 100%; padding: 0.85rem 1rem; background: var(--surface); border: 1px solid var(--line-strong); border-radius: var(--r-sm); color: var(--ink); transition: border-color 0.22s var(--ease), box-shadow 0.22s var(--ease); font-size: 0.98rem; font-family: var(--font-body); }
  .input::placeholder, .textarea::placeholder { color: var(--ink-3); }
  .input:focus, .textarea:focus, .select:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-soft); }
  .select option { background: var(--surface); color: var(--ink); }
  .textarea { min-height: 120px; resize: vertical; font-family: var(--font-body); }
  .row-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 1.1rem; }
  @media (max-width: 620px) { .row-2 { grid-template-columns: 1fr; } }
  .choice-grid { display: grid; gap: 0.8rem; }
  .choice { position: relative; border-radius: var(--r-sm); overflow: hidden; cursor: pointer; border: 1px solid var(--line-strong); transition: transform 0.24s var(--ease), border-color 0.24s var(--ease); background: var(--surface); display: block; }
  .choice:hover { transform: translateY(-2px); border-color: var(--accent-line); }
  .choice input { position: absolute; opacity: 0; pointer-events: none; }
  .choice .choice-media { position: relative; aspect-ratio: 2.4; background: var(--bg-deep); overflow: hidden; }
  .choice .choice-label { padding: 0.6rem 0.7rem; font-size: 0.85rem; color: var(--ink); font-weight: 500; }
  .choice:has(input:checked) { border-color: var(--accent); box-shadow: 0 0 0 1px var(--accent); }
  .choice:has(input:checked)::after { content: "\2713"; position: absolute; top: 8px; right: 8px; width: 24px; height: 24px; border-radius: 50%; background: var(--accent); color: #fff; display: grid; place-items: center; font-size: 0.8rem; font-weight: 700; }
  .sw-custom { background: conic-gradient(from 180deg, #FF5B2E, #FFD23F, #63C79A, #4AA8FF, #B85EFF, #FF5B2E); }
  .opt { display: flex; align-items: center; gap: 0.8rem; padding: 0.9rem 1.1rem; border-radius: var(--r-sm); border: 1px solid var(--line-strong); cursor: pointer; transition: border-color 0.2s var(--ease), background 0.2s var(--ease); margin-bottom: 0.6rem; background: var(--surface); }
  .opt:has(input:checked) { border-color: var(--accent); background: var(--accent-soft); }
  .opt input { accent-color: var(--accent); width: 18px; height: 18px; flex: none; }
  .opt .opt-main { flex: 1; display: flex; flex-direction: column; gap: .15rem; }
  .opt .opt-title { color: var(--ink); font-weight: 500; }
  .opt .opt-desc { font-size: 0.82rem; color: var(--ink-3); }
  .dropzone { display: block; border-radius: var(--r-sm); padding: 1.8rem; text-align: center; color: var(--ink-3); border: 1.5px dashed var(--line-strong); transition: border-color 0.22s var(--ease), background 0.22s var(--ease); cursor: pointer; background: var(--surface); }
  .dropzone:hover { border-color: var(--accent-line); background: var(--accent-soft); }
  .dropzone svg { width: 30px; height: 30px; margin: 0 auto 0.6rem; color: var(--accent-bright); }
  .chip-row { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  a.chip { display: inline-flex; align-items: center; gap: 0.45rem; padding: 0.4rem 0.9rem; border-radius: var(--r-pill); border: 1px solid var(--line); font-size: 0.8rem; color: var(--ink-2); transition: border-color var(--dur) var(--ease), color var(--dur) var(--ease); }
  a.chip:hover { border-color: var(--accent-line); color: var(--ink); }
  .ord-anchor { scroll-margin-top: 100px; }

  /* "What one product gets you" — the 4-photo set, shown above the form. */
  .pack-grid { list-style: none; margin: 0 0 1.6rem; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: .7rem; }
  @media (max-width: 640px) { .pack-grid { grid-template-columns: 1fr 1fr; } }
  .pack-grid li { display: flex; gap: .7rem; align-items: flex-start; padding: .9rem 1rem; border: 1px solid var(--line-strong); border-radius: var(--r-sm); background: var(--surface); }
  .pack-grid .pack-n { flex: none; width: 26px; height: 26px; border-radius: 50%; display: grid; place-items: center; background: var(--accent-soft); color: var(--accent-bright); font-family: var(--font-display); font-weight: 900; font-size: .85rem; }
  .pack-grid strong { display: block; color: var(--ink); font-size: .92rem; }
  .pack-grid span { display: block; color: var(--ink-3); font-size: .8rem; margin-top: .15rem; line-height: 1.4; }

  /* Background-colour picker: CSS-only replacement for the Svelte
     `customBg` $state toggle — the hex field only appears once "Custom
     colour" is the checked radio in this field's choice-grid. */
  .bg-hex-field { display: none; }
  .bg-field:has(input[value="Custom colour"]:checked) .bg-hex-field { display: flex; }

  /* Model picker for the always-included on-model shot. Model radios stay
     non-required (default "Let VISUAILS choose" is pre-checked), so the form
     can never be blocked here. */
  .model-picker { display: block; margin-top: .4rem; }
  .choice .choice-media.mono { aspect-ratio: 1; display: grid; place-items: center; background: radial-gradient(125% 90% at 50% 6%, #FFFFFF, #F1EBE3 58%, #E2D9CD 100%); }
  .mono .mono-av { position: relative; display: grid; place-items: center; width: 100%; height: 100%; font-family: var(--font-display); font-weight: 900; font-size: 1.4rem; color: var(--accent-bright); }
  .mono .mono-av small { position: absolute; bottom: 8px; font-size: .58rem; font-weight: 500; letter-spacing: .12em; text-transform: uppercase; color: var(--ink-3); font-family: var(--font-body); }
  /* Model tiles are portrait photos, not wide swatches — override the shared 2.4 ratio. */
  .model-picker .choice .choice-media { aspect-ratio: 3 / 4; }
  .model-picker .choice .choice-media img { width: 100%; height: 100%; object-fit: cover; display: block; }
</style>
