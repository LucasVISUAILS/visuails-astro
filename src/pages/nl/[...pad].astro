---
// VISUAILS — de Nederlandse 404 voor elk onbekend adres onder /nl/.
// 2 oktober 2026 (ronde 9, F1).
//
// sitemap-and-404.mjs zet dist/nl/404.html plat "zodat Pages hem vindt", maar de
// site draait sinds de overstap als Worker met assets, en die zoekt niet naar de
// dichtstbijzijnde 404.html: live gaf /nl/bestaat-niet de ENGELSE 404 ("Page not
// found") aan een Nederlandse bezoeker.
//
// Deze route vangt alles onder /nl/ wat geen pagina, geen andere route en geen
// bestand is. Astro geeft een rest-parameter de laagste voorrang, dus hij komt
// pas aan de beurt als niets anders past; bestanden uit dist/ serveert Cloudflare
// zelf, vóór de Worker. Status 404, noindex, en dezelfde inhoud als /nl/404.
//
// 14 oktober 2026: in de hal, net als /nl/404 sinds 13 oktober. Hier stond nog
// NotFoundPage.astro (de vorige opmaak), terwijl die op de opruimlijst staat:
// na OPRUIMEN.bat zou de build hier breken.
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import NotFoundHal from '../../components/NotFoundHal.astro';

Astro.response.status = 404;
/* Deze pagina maakt de Worker zelf, dus de `_headers` van de statische site gelden er niet
   (5 november 2026): nosniff en frame-ancestors hier, bovenaan, voordat er iets wacht. Geen volledige
   CSP: de opmaak heeft inline scripts waarvan de hashes alleen in `_headers` staan. */
Astro.response.headers.set('x-content-type-options', 'nosniff');
Astro.response.headers.set('content-security-policy', "frame-ancestors 'none'");
const description =
  'Deze pagina bestaat niet. De link is verouderd of het adres verkeerd getypt — ga terug naar de homepage of bekijk Catalog, Lifestyle en Video.';
---

<Layout huid="hal" title="Pagina niet gevonden — VISUAILS" description={description} noindex>
  <NotFoundHal lang="nl" />
</Layout>
