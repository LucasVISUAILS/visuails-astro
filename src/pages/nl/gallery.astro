---
// VISUAILS — de galerij: in de hal sinds 13 oktober 2026 (afvinklijst 17, alles doen). Het lichaam
// staat in GalleryHal.astro; de vorige (GalleryPage.astro, Levering.astro) staat op de opruimlijst.
// VISUAILS — /nl/gallery. Zie src/pages/gallery.astro; het lichaam is gedeeld.
import Layout from '../../layouts/Layout.astro';
import GalleryHal from '../../components/GalleryHal.astro';
/* Zie /nl/test-sample: het bedrag van de proef staat in pricing.js. */
import { TEST_SAMPLE } from '../../data/pricing.js';
import { styles } from '../../data/styles.js';
/* De looks in de galerij volgen de site (levering 70): met de launchset zijn Dunes en
   Glow even weg. Een nieuwe look (`opSite: 'launch'`) heeft hier nog geen foto's. */
const namen = styles.filter((s: any) => s.slug !== 'custom' && s.opSite !== 'launch').map((s: any) => s.name);
const LOOKS = namen.length > 1 ? `${namen.slice(0, -1).join(', ')} en ${namen[namen.length - 1]}` : namen.join('');
---

<Layout huid="hal"
  title="VISUAILS — Een blik op de stijlen die we maken"
  description={`De echte VISUAILS-fotobibliotheek — campagne, ${LOOKS} lifestylevisuals. Bekijk wat we maken en probeer VISUAILS eerst voor ${TEST_SAMPLE.nl.price}.`}
>
  <GalleryHal lang="nl" />
</Layout>
