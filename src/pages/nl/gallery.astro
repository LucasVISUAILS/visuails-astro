---
import { waHref } from '../../data/whatsapp.js';
// VISUAILS — Galerij (Nederlands). Vertaling van src/pages/gallery.astro.
import Layout from '../../layouts/Layout.astro';
import { TEST_SAMPLE } from '../../data/pricing.js';

// De proefvisualkosten stonden hier ook ingetypt. Het is een tier-feit en komt
// dus uit pricing.js — zie src/pages/nl/test-sample.astro voor dezelfde fix.
const SAMPLE = TEST_SAMPLE.nl;
// Compare.astro wordt op deze pagina niet meer gebruikt sinds het voor/na-blok
// eruit is; zie de noot verderop. De import staat er niet meer, zodat er geen
// ongebruikte component in de bundel belandt.

// Intrinsieke pixelmaten van elke foto in het raster, afgelezen van de
// bestanden in public/img — NIET de weergavegrootte (.photo-grid legt zelf
// aspect-ratio 4/5 vast, .wide loopt vrij). Gegroepeerd op formaat, want de
// bibliotheek is in batches gemaakt. Een niet-vermelde src laat de build
// falen; dat is de bedoeling. Houd gelijk met src/pages/gallery.astro.
const INTRINSIC: Record<string, [number, number]> = Object.fromEntries(
  ([
    [[928, 1152], ['banners-01', 'banners-02', 'banners-03', 'banners-04', 'banners-05', 'banners-06', 'banners-07', 'banners-08', 'lifestyle-dunes-01', 'lifestyle-dunes-02', 'lifestyle-flash-01']],
    [[1340, 2400], ['lifestyle-flash-02', 'lifestyle-flash-03', 'lifestyle-glow-01']],
    [[768, 1376], ['lifestyle-glow-03']],
    [[1200, 896], ['lifestyle-glow-04']],
    [[2400, 1792], ['lifestyle-flash-04', 'lifestyle-flash-05', 'lifestyle-flash-06', 'lifestyle-flash-07', 'lifestyle-flash-08', 'lifestyle-glow-02', 'lifestyle-glow-05', 'lifestyle-glow-06', 'lifestyle-phone-made-01', 'lifestyle-phone-made-02', 'lifestyle-phone-made-03', 'lifestyle-phone-made-04', 'lifestyle-phone-made-05', 'lifestyle-phone-made-06', 'lifestyle-phone-made-07', 'lifestyle-phone-made-08', 'lifestyle-phone-made-09', 'lifestyle-phone-made-10', 'lifestyle-phone-made-11', 'lifestyle-phone-made-12', 'lifestyle-phone-made-13', 'lifestyle-phone-made-14']],
    [[760, 1140], ['brand-boots']],
    [[2048, 1152], ['brand-car-lens']],
    [[760, 428], ['brand-knit']],
    [[760, 760], ['brand-rest', 'brand-silhouet']],
    [[1872, 1248], ['brand-stair']],
  ] as Array<[[number, number], string[]]>).flatMap(([wh, names]) => names.map((n) => [`/img/${n}.webp`, wh] as const)),
);

const photos = [
  ...Array.from({ length: 8 }, (_, i) => ({ src: `/img/banners-0${i + 1}.webp`, tag: 'campaign', alt: `Campagnefotografie ${i + 1}` })),
  { src: '/img/lifestyle-dunes-01.webp', tag: 'dunes', alt: 'Lifestyle-visual in Dunes-stijl' },
  { src: '/img/lifestyle-dunes-02.webp', tag: 'dunes', alt: 'Lifestyle-visual in Dunes-stijl' },
  ...Array.from({ length: 8 }, (_, i) => ({ src: `/img/lifestyle-flash-0${i + 1}.webp`, tag: 'flash', alt: `Lifestyle-visual in Flash-stijl ${i + 1}` })),
  ...Array.from({ length: 6 }, (_, i) => ({ src: `/img/lifestyle-glow-0${i + 1}.webp`, tag: 'glow', alt: `Lifestyle-visual in Glow-stijl ${i + 1}` })),
  ...Array.from({ length: 14 }, (_, i) => ({ src: `/img/lifestyle-phone-made-${String(i + 1).padStart(2, '0')}.webp`, tag: 'phone-made', alt: `Lifestyle-visual in Phone-made-stijl ${i + 1}` })),
  /* ── DE BEAM-REEKS — 30 augustus 2026 ──────────────────────────────────────
   *
   * Deze zes stonden al op de site (HomeV2, StudioPage, Layout) en nergens in
   * deze galerij. Dat is precies andersom: dit is de pagina die laat zien wat we
   * maken, en dit is het meest herkenbare wat er staat.
   *
   * ── DRIE KEUZES DIE HIERONDER VASTLIGGEN ──────────────────────────────────
   *
   * 1 · DE NAAM IS 'Beam' EN NIET 'Mood' OF 'Editions'. De andere filters zijn
   *     LOOKS — Dunes, Flash, Glow, Phone-made — en dit is er ook een: één harde
   *     lichtbundel in het donker. 'Mood' zou liegen, want er staan producten op
   *     (laarzen, een gebreide trui, jassen), en de homepage gebruikt dat woord
   *     juist voor beeld ZONDER product. En 'Editions' zou erger liegen: dat is
   *     een dienst die nog niet leverbaar is, en een filter met die naam leest
   *     als iets wat je vandaag kunt bestellen.
   *
   * 2 · ZES EN NIET ELF. Van de elf brand-bestanden zijn er vier abstracte
   *     lichtstudies (beam, desk, glow, pool). Die worden gebruikt als
   *     ACHTERGROND — onder de kop op /studio, achter het lege abonnementsscherm
   *     — en dat is goed werk op die plek. In een galerij die "de stijlen die we
   *     maken" heet, staan het verlopen tussen de foto's, en dan verwatert de
   *     reeks in plaats van dat hij hem draagt.
   *
   * 3 · brand-car.webp STAAT ER NIET BIJ, want hij is byte voor byte hetzelfde
   *     bestand als brand-car-lens.webp (beide 176.552 bytes, gelijke md5). Twee
   *     keer dezelfde foto in één raster valt op; twee keer 172 kB op schijf
   *     niet. Zie de noot hierover in WERKLIJST.md.
   *
   * De namen blijven onvertaald, net als Dunes, Flash, Glow en Phone-made. */
  { src: '/img/brand-silhouet.webp', tag: 'beam', alt: 'Silhouet tegen \u00e9\u00e9n harde lichtbundel' },
  { src: '/img/brand-boots.webp', tag: 'beam', alt: 'Laarzen op nat asfalt, uitgelicht door \u00e9\u00e9n bundel' },
  { src: '/img/brand-car-lens.webp', tag: 'beam', alt: 'Outerwear in een auto-interieur, \u00e9\u00e9n lichtbron' },
  { src: '/img/brand-knit.webp', tag: 'beam', alt: 'Kabelbrei van dichtbij onder strijklicht' },
  { src: '/img/brand-stair.webp', tag: 'beam', alt: 'Een figuur in een trappenhuis, hard licht en schaduw' },
  { src: '/img/brand-rest.webp', tag: 'beam', alt: 'Een rustmoment in een auto, \u00e9\u00e9n lichtbron' },
].map((p, i) => ({ ...p, wide: i % 7 === 0, w: INTRINSIC[p.src][0], h: INTRINSIC[p.src][1] }));

const filters = [
  { key: 'all', label: 'Alle' },
  { key: 'campaign', label: 'Campagne' },
  { key: 'dunes', label: 'Dunes' },
  { key: 'flash', label: 'Flash' },
  { key: 'glow', label: 'Glow' },
  { key: 'phone-made', label: 'Phone-made' },
  { key: 'beam', label: 'Beam' },
];
---

<Layout
  title="VISUAILS — Een blik op de stijlen die we maken"
  description="De echte VISUAILS-fotobibliotheek — campagne, Dunes, Flash, Glow en Phone-made lifestylevisuals. Bekijk wat we maken en probeer VISUAILS eerst voor €1."
>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow-page">Galerij</p>
      <h1 class="display">Een blik op de stijlen die we maken</h1>
      <div class="flex" style="margin-top:1.8rem">
        <a href="/nl/test-sample/" class="btn btn-primary btn-lg">Probeer VISUAILS</a>
        <a href="/nl/start/" class="btn btn-ghost btn-lg">Start een bestelling</a>
      </div>
    </div>
  </section>

  <!-- THE LIBRARY -->
  <section>
    <div class="container">
      <div class="filter-bar" role="group" aria-label="Stijlen filteren">
        {filters.map((f) => (
          <button type="button" data-filter-key={f.key} aria-pressed={f.key === 'all' ? 'true' : 'false'}>{f.label}</button>
        ))}
      </div>

      <div class="photo-grid" data-filterable>
        {photos.map((p) => (
          <img src={p.src} alt={p.alt} loading="lazy" decoding="async" width={p.w} height={p.h} class={p.wide ? 'wide' : ''} data-tag={p.tag} />
        ))}
      </div>
    </div>
  </section>

  {/*
    ═══════════════════════════════════════════════════════════════════════════════
    HET "VOOR & NA"-BLOK IS WEG — 18 augustus 2026
    ═══════════════════════════════════════════════════════════════════════════════

    Hier stonden vier Compare-schuivers onder de kop "Voor & na", met de belofte
    *"Een vlak beeld wordt een afgewerkte VISUAILS-visual"*. Alle vier hadden
    HETZELFDE bestand als `before` en als `after`, met een CSS-filter op de
    linkerhelft.

    OP DE ENGELSE PAGINA IS DIT OP 10 AUGUSTUS 2026 AL WEGGEHAALD, en de
    redenering staat daar voluit: dit is een resultaatclaim met geënsceneerd
    bewijs, op precies de pagina waar een merk komt om te controleren of het echt
    is. Het eerste ontwerpprincipe van dit merk luidt "Never borrow credibility we
    haven't earned", en IMAGES.md:36 zegt zelf dat er ÉÉN echt voor/na-paar
    bestaat op de hele site.

    DAT HET HIER BLEEF STAAN IS DE ERNSTIGE HELFT. Een bewerkt "voor"-beeld naast
    een "na"-beeld van hetzelfde bestand is een misleidende handelspraktijk
    (art. 6:193c BW) — Nederlands recht, op de Nederlandse pagina, acht dagen
    langer dan op de Engelse. Gevonden op 18 augustus bij het gelijktrekken van de
    twee galerijen; de opdracht was "de Engelse mist een blok", en het antwoord
    bleek andersom te liggen.

    Zodra er vier ECHTE paren zijn — een middag werk, en meer waard dan de rest
    van deze pagina bij elkaar — komt dit blok in BEIDE talen terug met de echte
    bestanden en ZONDER `grade`. De <Compare>-component blijft bestaan.
  */}


  <!-- CLOSING CTA -->
  <section class="section-tight">
    <div class="container">
      <div class="cta-band reveal pending">
        <h2 class="display" style="font-size:var(--t-page-h2)">Zie je eigen product<br />in <em>deze reeks.</em></h2>
        <p class="lead" style="margin:1.2rem auto 0;text-align:center">Probeer VISUAILS eerst — één per bedrijf, en je betaalt {SAMPLE.feeNote}.</p>
        <div class="flex" style="justify-content:center;margin-top:2rem">
          <a href="/nl/test-sample/" class="btn btn-primary btn-lg">Probeer VISUAILS</a>
          <a href="/nl/start/" class="btn btn-ghost btn-lg">Start een bestelling</a>
          <a href={waHref("Hoi VISUAILS, ik wil VISUAILS graag eerst proberen met mijn product.")} class="btn btn-wa" target="_blank" rel="noopener">
            WhatsApp
          </a>
        </div>
      </div>
    </div>
  </section>

  {/* De filterbalk staat in src/scripts/galerij-filter.js. Hij stond hier,
      twee keer woord voor woord gelijk (en/nl), en begon met een import van
      GSAP: 68 kB bibliotheek voor één crossfade, waardoor deze pagina op
      128 kB JavaScript stond tegen 58 kB voor de rest van de site. Nu doet
      de Web Animations API hetzelfde. De volledige uitleg, inclusief de
      afwijking van brief §8, staat in dat bestand. */}
  <script>
    import '../../scripts/galerij-filter.js';
  </script>
</Layout>

<style>
  /* Gallery-page-only patterns: filter pills. The tile grid itself is the
     shared .photo-grid pattern from global.css. */
  .filter-bar { display: flex; flex-wrap: wrap; gap: .6rem; margin-bottom: 1.8rem; }
  .filter-bar button { font: inherit; cursor: pointer; color: var(--ink-2); background: transparent; border: 1px solid var(--line); padding: .5rem 1.1rem; font-size: .9rem; font-weight: 500; transition: border-color var(--dur-1) var(--ease), color var(--dur-1) var(--ease), background var(--dur-1) var(--ease); }
  .filter-bar button:hover { color: var(--ink); border-color: var(--accent-line); }
  .filter-bar button[aria-pressed="true"] { color: var(--accent-on); background: var(--accent); border-color: transparent; }
</style>
