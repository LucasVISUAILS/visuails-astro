---
// VISUAILS — /nl/video (Nederlands). De pagina-inhoud staat in
// VideoPage.astro, zodat /video en /nl/video niet uit elkaar kunnen lopen;
// alleen de meta verschilt hier.
import Layout from '../../../layouts/Layout.astro';
import VideoPage from '../../../components/VideoPage.astro';
import { perProduct, turnaround } from '../../../data/pricing.js';

const item = perProduct('video', 'nl');

const description =
  `Acht seconden subtiele beweging, voor productpagina’s, social en eenvoudige ` +
  `advertenties. ${item.price} per clip. ${turnaround('unattended', 'nl')}.`;
---

<Layout
  title="Product- & Campagnevideo's — korte productvideo's die bewegen | VISUAILS"
  description={description}
  ogImage="/img/banners-16.webp"
>
  <VideoPage lang="nl" />
</Layout>
