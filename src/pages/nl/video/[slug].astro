---
// VISUAILS — /nl/video/[slug]. Zie de Engelse variant en de kop van
// VideoStyleDetail.astro; hier verschillen alleen de meta en de databron.
import Layout from '../../../layouts/Layout.astro';
import VideoStyleDetail from '../../../components/VideoStyleDetail.astro';
import { videoStyles } from '../../../data/videoStyles.nl.js';
import { reviewClaim, turnaround } from '../../../data/pricing.js';
import { metaDescription } from '../../../data/meta.js';

export function getStaticPaths() {
  return videoStyles.map((s) => ({ params: { slug: s.slug }, props: { style: s } }));
}

const { style } = Astro.props;
const metaPrice = `${style.priceTrust}${style.priceUnit}`;

const zusters = videoStyles
  .filter((s) => s.slug !== style.slug)
  .map((s) => ({ href: `/video/${s.slug}`, naam: s.name }));

const TIMING = turnaround('unattended', 'nl');
const REVIEW = reviewClaim('unattended', 'nl');
---

<Layout
  title={`${style.name} — Video-stijl | VISUAILS`}
  description={metaDescription([
    `${style.name}: een kenmerkende videostijl van VISUAILS`,
    metaPrice,
    TIMING,
    REVIEW,
  ])}
>
  <VideoStyleDetail lang="nl" style={style} zusters={zusters} />
</Layout>
