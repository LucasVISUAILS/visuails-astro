---
// VISUAILS — /nl/video/<stijl>: in de hal sinds 13 oktober 2026 (afvinklijst 16, alles doen). De pagina
// staat in VideoStyleHal.astro; de vorige (VideoStyleDetail.astro) staat op de opruimlijst.
// VISUAILS — /nl/video/[slug]. Zie de Engelse variant en de kop van
// VideoStyleDetail.astro; hier verschillen alleen de meta en de databron.
import Layout from '../../../layouts/Layout.astro';
import VideoStyleHal from '../../../components/VideoStyleHal.astro';
import { videoStyles } from '../../../data/videoStyles.nl.js';
import { reviewClaim } from '../../../data/pricing.js';
import { metaDescription } from '../../../data/meta.js';

export function getStaticPaths() {
  return videoStyles.map((s) => ({ params: { slug: s.slug }, props: { style: s } }));
}

const { style } = Astro.props;
const metaPrice = `${style.priceTrust}${style.priceUnit}`;

const zusters = videoStyles
  .filter((s) => s.slug !== style.slug)
  .map((s) => ({ href: `/video/${s.slug}`, naam: s.name }));

/* Video is op aanvraag: de levertijd staat in de offerte (30 september 2026). */
const TIMING = 'Formaat en levertijd afgesproken in de offerte';
const REVIEW = reviewClaim('unattended', 'nl');
---

<Layout huid="hal"
  title={`${style.name} — Video-stijl | VISUAILS`}
  description={metaDescription([
    `${style.name}: een kenmerkende videostijl van VISUAILS`,
    metaPrice,
    TIMING,
    REVIEW,
  ])}
>
  <VideoStyleHal lang="nl" style={style} zusters={zusters} />
</Layout>
