---
/**
 * VISUAILS — de bron van de laptopstanden. 15 oktober 2026.
 *
 * GEEN PAGINA VAN DE SITE. Zonder LAPTOP_BRON=1 geeft getStaticPaths niets terug,
 * dus bij een gewone build bestaat /laptop-bron/ niet (tests/laptop-standen.test.mjs
 * kijkt dat na). scripts/laptop-standen.mjs start `astro dev` met LAPTOP_BRON=1,
 * opent /laptop-bron/nl/ en /laptop-bron/en/ op 2304 × 1296 en maakt van elk vak
 * hieronder een foto. Waarom: zie de kop van src/data/halStanden.js.
 */
import Layout from '../../layouts/Layout.astro';
import HalLaptopSchermen from '../../components/HalLaptopSchermen.astro';
import { alleStanden, standNaam, HAL_OPTIES } from '../../data/halStanden.js';
import '../../styles/hal.css';

export function getStaticPaths() {
  if (process.env.LAPTOP_BRON !== '1') return [];
  return [{ params: { lang: 'nl' } }, { params: { lang: 'en' } }];
}
const lang = Astro.params.lang === 'nl' ? 'nl' : 'en';
/* LAPTOP_PRODUCT=nonstd: de catalog met de drie producten van NONSTD (levering 94, alleen voor de schermen van de opening).
   LAPTOP_PRODUCT=hal (levering 98, scripts/laptop-standen.mjs): de laptop op /catalog, /lifestyle en /video, met HAL_OPTIES.
   Zonder: de oude winkel met de roze broek (scripts/opening-reeks.mjs). */
const opties = process.env.LAPTOP_PRODUCT === 'nonstd' ? { product: 'nonstd' as const } : process.env.LAPTOP_PRODUCT === 'hal' ? HAL_OPTIES : { product: 'standaard' as const };
/* levering 96 (lijst 97): geen schermen met beeld 2 – 4 groot meer; de foto's zijn in de opening een galerij die je scrolt */
const standen = alleStanden(lang, undefined, opties);
const vakNaam = (s: any) => standNaam(lang, s) + (s.beeld ? `-b${s.beeld}` : '');
---
<Layout title="Laptopbron | VISUAILS" description="Bron van de laptopstanden; geen pagina van de site." noindex huid="hal">
  <style is:global>
    body.hal .site-header, body.hal footer, body.hal .mobile-nav, body.hal .mobile-cta, body.hal .wa-dock, body.hal .cc, body.hal .convbar, body.hal [data-klantmelding], astro-dev-toolbar { display: none !important; }
    html, body.hal { background: transparent !important; }   /* levering 79: de standen zonder grond */
    .hl-bron *, .hl-bron *::before, .hl-bron *::after { transition: none !important; animation: none !important; }
    .hl-bron { width: 2304px; height: 1296px; position: relative; overflow: hidden; }
    .hl-bron .hl-doos { position: absolute; inset: 0; width: 2304px; height: 1296px; -webkit-mask-image: none; mask-image: none; }
    .hl-bron .hl-laag { opacity: 1; --hl-k: 1; }
  </style>
  {standen.map((s) => (
    <div class="hl hl-leeft hl-bron" data-bron-stand={vakNaam(s)}>
      <div class="hl-doos">
        <img class="hl-foto" src="/img/hal/pov-2304-doorzichtig.webp" width="2304" height="1296" alt="" />
        <HalLaptopSchermen lang={lang} stand={s} opties={opties} />
      </div>
    </div>
  ))}
</Layout>
