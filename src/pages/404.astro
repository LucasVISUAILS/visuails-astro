---
import { waHref } from '../data/whatsapp.js';
// VISUAILS — the site's 404. Added 2026-07-28 (task #263 audit, live-site
// spot-check, finding 7 — the most severe of the lot).
//
// THIS PAGE DID NOT EXIST BEFORE THIS COMMIT, AND THAT WAS THE BUG.
// Cloudflare Pages' documented fallback for a static build with no custom
// 404.html is to serve /index.html for any request that matches no asset, no
// Function and no public/_redirects rule — a 200, not a 404, and the
// homepage's own content, not an error. Confirmed live on visuails.com after
// the DNS migration off Wix: a deliberately-invented path
// (/this-path-definitely-does-not-exist-xyz123) came back as the homepage,
// title tag and all, with no "404" or "not found" anywhere in the response.
//
// That is worse than a plain 404 in three concrete ways, not just untidy:
//   • SEO — every dead link, typo'd URL and retired path search engines still
//     hold in their index reads as a 200 duplicate of the homepage, which is
//     exactly the shape of a "soft 404" Google's own guidance singles out as
//     a ranking problem.
//   • Monitoring — a broken link never LOOKS broken. Nothing (not a status
//     code, not visible content) tells anyone — Lucas, an uptime check, a
//     visitor — that the URL they hit was wrong.
//   • The very nav bug this same audit fixed in Layout.astro. Before that
//     fix, /nl/account 404'd for every Dutch visitor clicking "Inloggen" —
//     except it didn't 404 at all under this fallback, it silently served
//     the homepage. A visitor who'd just been told "opening your account"
//     and landed back on the homepage with zero explanation is a worse
//     experience than an honest error page would have been.
//
// Astro special-cases a page named exactly 404.astro: it always builds to
// /404.html regardless of the project's trailingSlash/build.format settings,
// specifically because that is the exact filename static hosts look for.
// Cloudflare Pages then serves it, with a real 404 status, for the closest
// matching directory — this file for anything outside /nl, and nl/404.astro
// (its own file, mirroring this one exactly, same as every other EN/NL pair
// on the site) for anything under /nl.
import Layout from '../layouts/Layout.astro';

const description =
  "This page doesn’t exist. The link may be old, or the address was mistyped — head back to the homepage or browse Catalog, Lifestyle and Video.";
---

<Layout title="Page not found — VISUAILS" description={description} noindex>
  <section class="page-hero"><div class="container" style="max-width:640px;text-align:center;margin-inline:auto">
    <span class="eyebrow-page">404</span>
    <h1 class="display">This page doesn’t exist.</h1>
    <p class="lead" style="margin:1.2rem auto 0">The link may be old, or the address was mistyped. Here’s where to go instead.</p>
    <div class="flex" style="justify-content:center;margin-top:2rem">
      <a href="/" class="btn btn-primary btn-lg">Back to home</a>
      <a href="/start/" class="btn btn-ghost btn-lg">Start a request</a>
      <a href={waHref("Hi VISUAILS, I followed a link that didn't work.")} class="btn btn-wa" target="_blank" rel="noopener">
        Tell us what’s broken
      </a>
    </div>
  </div></section>
</Layout>
