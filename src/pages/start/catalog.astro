---
// VISUAILS — /start/catalog.
// The page is four imports and a service name. Everything else — the five
// steps, the copy in both languages, the config blob pipeline.js reads — is
// OrderFlow.astro, which is the whole reason the split did not turn into five
// near-identical files. The ONE block that differs is passed in as the slot.
import Layout from '../../layouts/Layout.astro';
import OrderFlow from '../../components/order/OrderFlow.astro';
import Step1Options from '../../components/order/Step1Options.astro';
---

<Layout title="Order catalog sets — VISUAILS" description="Product-page images, four per product. Pick the count and the background; the rate falls as the count rises.">
  <OrderFlow lang="en" service="catalog">
    <Step1Options lang="en" />
  </OrderFlow>
</Layout>
