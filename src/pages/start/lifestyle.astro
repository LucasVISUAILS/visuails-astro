---
// VISUAILS — /start/lifestyle: in de hal sinds 13 oktober 2026 (afvinklijst 10, alles doen). De vorm komt uit
// HalFormulier.astro en het blok DE FORMULIEREN in hal.css; de werking blijft van de onderdelen.
// VISUAILS — /start/lifestyle.
// The page is four imports and a service name. Everything else — the five
// steps, the copy in both languages, the config blob pipeline.js reads — is
// OrderFlow.astro, which is the whole reason the split did not turn into five
// near-identical files. The ONE block that differs is passed in as the slot.
import HalFormulier from '../../components/HalFormulier.astro';
import Layout from '../../layouts/Layout.astro';
import OrderFlow from '../../components/order/OrderFlow.astro';
import StylePicker from '../../components/order/StylePicker.astro';
import ModelKeuze from '../../components/order/ModelKeuze.astro';
---

<Layout huid="hal" werkplaats title="Order lifestyle carousels — VISUAILS" description="Your product in a styled look, four images per product. Pick the look and the count; the rate falls as the count rises.">
  <HalFormulier soort="lifestyle">
  <OrderFlow lang="en" service="lifestyle">
    {/* Stap 2, boven de productkaarten — zie ModelKeuze.astro. De slot
        heet "model" en staat in OrderFlow bij stap 2; waar dit blok in
        deze bron staat maakt dus niet uit voor waar het terechtkomt. */}
    <ModelKeuze slot="model" lang="en" soort="lifestyle" />
    {/* slot="look" — de look staat nu BOVEN het aantal en niet als negende
        blok in stap 1. Zie de noot bij <slot name="look" /> in
        OrderFlow.astro voor de meting die dat besliste. */}
    <StylePicker slot="look" lang="en" />
  </OrderFlow>
  </HalFormulier>
</Layout>
