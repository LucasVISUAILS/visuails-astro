---
// VISUAILS — /plans (English). De pagina-inhoud staat in PlansPage.astro, zodat
// /plans en /nl/plans niet uit elkaar kunnen lopen; alleen de meta verschilt.
//
// Deze pagina bestaat sinds 20 augustus 2026 en haalde het abonnement weg bij
// de prijslijst — zie de lange noot bovenin PlansPage.astro.
import Layout from '../layouts/Layout.astro';
// 12 oktober 2026 (afvinklijst 8, alles "doen"): deze pagina staat in de hal (huid="hal");
// de vorige opmaak staat op _opruimen/LIJST.txt.
import PlansHal from '../components/PlansHal.astro';
import { euro, PLAN_AMOUNT, PLAN_CREDITS, vatLabel } from '../data/pricing.js';

const CHEAPEST = Object.keys(PLAN_AMOUNT).reduce((a, b) => (PLAN_AMOUNT[b] < PLAN_AMOUNT[a] ? b : a));

const description =
  `Credits every month for catalog sets and carousels; you order whenever you like. From ` +
  `${euro(PLAN_AMOUNT[CHEAPEST], 'en')} a month for ${PLAN_CREDITS[CHEAPEST]} credits, ` +
  `or choose your own number. ${vatLabel('excl', 'en')}.`;
---

<Layout huid="hal" title="Plans — credits every month | VISUAILS" description={description}>
  <PlansHal lang="en" />
</Layout>
