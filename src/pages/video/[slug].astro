---
// VISUAILS — /video/[slug] (English). De inhoud staat in VideoStyleDetail.astro
// zodat deze route en /nl/video/[slug] niet uit elkaar kunnen lopen; zie de kop
// daar, ook voor waarom de beeldkaart bij het sjabloon hoort en niet bij de taal.
import Layout from '../../layouts/Layout.astro';
import VideoStyleDetail from '../../components/VideoStyleDetail.astro';
import { videoStyles } from '../../data/videoStyles.js';
import { reviewClaim, turnaround } from '../../data/pricing.js';
import { metaDescription } from '../../data/meta.js';

export function getStaticPaths() {
  return videoStyles.map((s) => ({ params: { slug: s.slug }, props: { style: s } }));
}

const { style } = Astro.props;
const metaPrice = `${style.priceTrust}${style.priceUnit}`;

/* ── DE ZUSTERLOOKS VAN DEZE PAGINA ────────────────────────────────────────
   Elke stijlpagina had precies één inkomende link — van de eigen hub — en
   verwees naar geen enkele andere look. Ongelokaliseerde paden: ServiceSwitch
   doet lp() zelf. */
const zusters = videoStyles
  .filter((s) => s.slug !== style.slug)
  .map((s) => ({ href: `/video/${s.slug}`, naam: s.name }));

const TIMING = turnaround('unattended', 'en');
const REVIEW = reviewClaim('unattended', 'en');
---

<Layout
  title={`${style.name} — Video style | VISUAILS`}
  description={metaDescription([
    `${style.name}: a signature VISUAILS video style`,
    metaPrice,
    TIMING,
    REVIEW,
  ])}
>
  <VideoStyleDetail lang="en" style={style} zusters={zusters} />
</Layout>
