---
// VISUAILS — Video hub. Ported from the SvelteKit v2 site's /video
// +page.svelte. `videoStyles` data ported verbatim from
// $lib/data/videoStyles.js (only the fields this page uses: slug, name,
// cardPrice).
import Layout from '../../layouts/Layout.astro';

const videoStyles = [
  { slug: 'motion', name: 'Motion', cardPrice: 'From €49 / video' },
  { slug: 'lifestyle', name: 'Lifestyle Video', cardPrice: 'From €59 / video' },
  { slug: 'campaign', name: 'Campaign', cardPrice: 'Custom quote' },
  { slug: 'custom', name: 'Custom', cardPrice: 'Custom quote' },
];

const posters: Record<string, string> = {
  motion: '/img/banners-04.webp',
  lifestyle: '/img/lifestyle-glow-03.webp',
  campaign: '/img/banners-08.webp',
  custom: '/img/banners-13.webp',
};

const strip = [
  '/img/banners-01.webp',
  '/img/lifestyle-flash-02.webp',
  '/img/lifestyle-phone-made-09.webp',
  '/img/lifestyle-dunes-02.webp',
  '/img/banners-06.webp',
];
---

<Layout
  title="Product & Campaign Videos — short product videos that move | VISUAILS"
  description="8-second, clean product videos with subtle motion — made for product pages, social and simple ads. Human-reviewed and delivered in ~24 hours. Standard product videos from €49; larger campaigns on quote."
  ogImage="/img/banners-16.webp"
>
  <section class="hero-editorial compact">
    <div class="bg" style="background-image:url('/img/banners-03.webp')"></div>
    <div class="fade"></div>
    <div class="hero-editorial-content container">
      <h1 class="display" style="font-size:clamp(2.8rem,6.5vw,5.4rem)">Short product videos<br />that <em>move</em>.</h1>
      <p class="lead" style="margin-top:1.2rem;color:rgba(228,231,242,.86)">8 seconds, subtle motion. From €49.</p>
      <div class="flex" style="margin-top:1.8rem">
        <span class="magnet-wrap"><span class="magnet-inner"><a href="/order-video" class="btn btn-primary btn-lg">Get visuals</a></span></span>
        <a href="https://wa.me/31625436130?text=Hi%20VISUAILS%2C%20I%27d%20like%20to%20talk%20about%20a%20product%20video." class="btn btn-wa" target="_blank" rel="noopener">
          <svg class="i" viewBox="0 0 24 24"><path d="M21 11.5a8.38 8.38 0 0 1-8.5 8.5 8.5 8.5 0 0 1-4-1L3 20l1.5-4.5A8.38 8.38 0 0 1 3.5 11 8.5 8.5 0 0 1 12 3a8.38 8.38 0 0 1 8.5 8.5z"/></svg>WhatsApp <span class="rec-badge">Fastest</span>
        </a>
      </div>
      <div class="trust-row" style="margin-top:2.2rem">
        <span class="trust-item"><strong>8s</strong> clean product videos</span>
        <span class="trust-item"><strong>~24h</strong> delivery</span>
        <span class="trust-item"><strong>100%</strong> human-reviewed</span>
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <h2 style="margin-bottom:2rem">Ways to add motion.</h2>
      <div class="grid grid-3 reveal-group">
        {videoStyles.map((s) => (
          <a href={`/video/${s.slug}`} class="reveal pending" style="display:block">
            <div class="photo-band tall">
              <img src={posters[s.slug]} alt={`${s.name} example`} loading="lazy" />
              <div class="scrim"></div>
              <div class="caption">
                <h3 style="color:#fff">{s.name} &rarr;</h3>
                <p style="color:rgba(255,255,255,.82);font-size:.9rem;margin-top:.35rem">{s.cardPrice}</p>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <div class="ed-head">
        <span class="ed-meta">( Where it fits )</span>
        <div>
          <h2>Product video: motion where a still photo plateaus.</h2>
          <p class="ed-sub">A few seconds of movement, made for feeds and ads.</p>
        </div>
      </div>
      <div class="svc-explain">
        <div class="svc-explain-main">
          <h3>What it is</h3>
          <p>A product video is a short, clean film with subtle motion — a slow turn, a drape, a catch of light — built to give a product life without a full production. On a feed tuned for movement, a few seconds of motion earns attention a static image can’t, and holds it long enough to land the message.</p>
          <p>It isn't a replacement for your photos; it's the layer on top that lifts them where it counts. The same product that sits still on your shop can move in your ads and socials, where dwell time and click-through decide whether people stop — or keep scrolling.</p>
        </div>
        <aside class="svc-explain-side">
          <h3>Where it lives</h3>
          <ul class="svc-where-list">
            <li><strong>Reels, TikTok &amp; Shorts</strong> — where motion is the native language.</li>
            <li><strong>Paid ads</strong> — higher dwell time and click-through.</li>
            <li><strong>Product pages</strong> — an autoplay clip beside the stills.</li>
            <li><strong>Email &amp; landing pages</strong> — a moment of life above the fold.</li>
          </ul>
        </aside>
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container two-col">
      <div class="reveal pending">
        <h2>Clean motion, ready to publish.</h2>
        <ul class="checklist" style="margin-top:1.4rem">
          <li><svg viewBox="0 0 24 24" class="i" style="stroke:var(--success)"><path d="M20 6L9 17l-5-5"/></svg><span>8-second video with subtle motion</span></li>
          <li><svg viewBox="0 0 24 24" class="i" style="stroke:var(--success)"><path d="M20 6L9 17l-5-5"/></svg><span>Sized for pages, social and ads</span></li>
          <li><svg viewBox="0 0 24 24" class="i" style="stroke:var(--success)"><path d="M20 6L9 17l-5-5"/></svg><span>Consistent style across your range</span></li>
          <li><svg viewBox="0 0 24 24" class="i" style="stroke:var(--success)"><path d="M20 6L9 17l-5-5"/></svg><span>~24h delivery, human-reviewed</span></li>
        </ul>
      </div>
      <div class="reveal pending card" style="border-color:var(--accent-line)">
        <h3>Two ways to buy video</h3>
        <p style="margin-top:.8rem;color:var(--ink-2)"><strong>Motion &amp; Lifestyle</strong> — fixed price, order like images, from €49.</p>
        <p style="margin-top:.6rem;color:var(--ink-2)"><strong>Campaign</strong> — bigger, multi-shot, quoted per project.</p>
        <div class="flex" style="margin-top:1.4rem">
          <a href="/order-video" class="btn btn-primary">Order a product video</a>
          <a href="https://wa.me/31625436130?text=Hi%20VISUAILS%2C%20I%27d%20like%20a%20quote%20for%20a%20campaign%20video." class="btn btn-wa" target="_blank" rel="noopener">
            <svg class="i" viewBox="0 0 24 24"><path d="M21 11.5a8.38 8.38 0 0 1-8.5 8.5 8.5 8.5 0 0 1-4-1L3 20l1.5-4.5A8.38 8.38 0 0 1 3.5 11 8.5 8.5 0 0 1 12 3a8.38 8.38 0 0 1 8.5 8.5z"/></svg>Quote a campaign
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <div class="photo-grid reveal pending">
        <img src={strip[0]} alt="Campaign photography" loading="lazy" class="wide" />
        <img src={strip[1]} alt="Flash-style lifestyle visual" loading="lazy" />
        <img src={strip[2]} alt="Phone-made-style lifestyle visual" loading="lazy" />
        <img src={strip[3]} alt="Dunes-style lifestyle visual" loading="lazy" />
        <img src={strip[4]} alt="Campaign photography" loading="lazy" class="wide" />
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <div class="cta-band reveal pending">
        <h2 class="display" style="font-size:clamp(2.2rem,5vw,3.6rem)">Give your product<br>a little movement.</h2>
        <p class="lead" style="margin:1.2rem auto 0;text-align:center">From €49, delivered in about a day.</p>
        <div class="flex" style="justify-content:center;margin-top:2rem">
          <span class="magnet-wrap"><span class="magnet-inner"><a href="/order-video" class="btn btn-primary btn-lg">Get visuals</a></span></span>
          <a href="/contact" class="btn btn-ghost btn-lg">Contact us</a>
          <a href="https://wa.me/31625436130?text=Hi%20VISUAILS%2C%20I%27d%20like%20to%20talk%20about%20a%20product%20video." class="btn btn-wa" target="_blank" rel="noopener">
            <svg class="i" viewBox="0 0 24 24"><path d="M21 11.5a8.38 8.38 0 0 1-8.5 8.5 8.5 8.5 0 0 1-4-1L3 20l1.5-4.5A8.38 8.38 0 0 1 3.5 11 8.5 8.5 0 0 1 12 3a8.38 8.38 0 0 1 8.5 8.5z"/></svg>WhatsApp
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
