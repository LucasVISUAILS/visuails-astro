---
// VISUAILS — /video (English). The page body lives in VideoPage.astro so that
// /video and /nl/video cannot drift apart; only the meta differs here.
//
// This file used to be a 157-line inline page carrying the worst price defect
// on the site: its local `videoStyles` literal — and src/data/videoStyles.js
// behind it — priced Lifestyle Video at €59, a figure that appears nowhere in
// pricing.js and never has. The sitewide price scan missed it for months
// because "€59" is a string prefix of "€59.99". There is one clip rate now and
// it comes from PER_PRODUCT.
//
// The old description was ~245 characters, named a delivery time, and hedged
// the price with "from".
import Layout from '../../layouts/Layout.astro';
import VideoPage from '../../components/VideoPage.astro';
import { perProduct, turnaround } from '../../data/pricing.js';

const item = perProduct('video', 'en');

const description =
  `Eight seconds of subtle motion, for product pages, social and simple ads. ` +
  `${item.price} per clip. ${turnaround('unattended', 'en')}.`;
---

<Layout
  title="Short product videos, from your photos | VISUAILS"
  description={description}
  ogImage="/img/banners-16.webp"
>
  <VideoPage lang="en" />
</Layout>
