---
// VISUAILS — / (English). The page body lives in HomePage.astro so that / and
// /nl cannot drift apart; only the meta differs here.
//
// The description is built from pricing.js rather than typed, for the same
// reason /pricing's is: a price or a turnaround typed into a <meta> tag is a
// claim the ladder cannot enforce, and it is the one place a stale figure
// survives a page rewrite. The old description here promised delivery "in
// about 24 hours" — a named window the capacity gate never cleared.
import Layout from '../layouts/Layout.astro';
import HomePage from '../components/HomePage.astro';
import { euro, AMOUNT, FULL_DROP_MIN, FULL_DROP_MAX } from '../data/pricing.js';

// Kept under 152 characters — META_LIMIT, and below Google's snippet cut
// rather than level with it. This is the one description that has to survive
// truncation intact, and the €0.99 hook is the last clause, so it is the
// clause a cut would take.
const description =
  `Catalog and lifestyle visuals for clothing brands, from your own product ` +
  `photos. No shoot. ${FULL_DROP_MIN}–${FULL_DROP_MAX} products for ` +
  `${euro(AMOUNT.fullDrop, 'en')}. See it on yours for ` +
  `${euro(AMOUNT.testSample, 'en')}.`;
---

<Layout
  title="Product visuals for clothing brands, no shoot | VISUAILS"
  description={description}
  ogImage="/img/hero-dunes.webp"
>
  <HomePage lang="en" />
</Layout>
