---
// VISUAILS — homepage, "The Studio Issue". Built like a printed studio
// magazine, ordered like a sales conversation — each chapter answers the
// visitor's next question:
//   COVER (the dream, one line) → STATEMENT (what this is) → DEVELOP (watch
//   the mechanism work) → SPREAD (real output) → LEDGER (the menu + prices) →
//   SET (the flagship €39.99 pack, expanded) → PROCESS (how it works) →
//   QUALITY (how we get it right) → MODELS / AI / THREE-WAY (objections) →
//   PROMISE (trust) → PLANS (ways in) → TEST SAMPLE (the €0.99 close).
// One voice: Archivo 900. All motion is progressive enhancement
// (src/scripts/motion.js); every base state is fully designed without JS.
import Layout from '../layouts/Layout.astro';
import Compare from '../components/Compare.astro';
import ThreeWay from '../components/ThreeWay.astro';

const WA = 'https://wa.me/31625436130?text=Hi%20VISUAILS%2C%20I%27d%20like%20to%20see%20what%20you%20can%20make%20from%20my%20product%20photos.';

// The services ledger — number, name, deliverable, price, preview image.
const ledger = [
  { n: '01', name: 'Catalog', meta: 'A full 4-photo set per product: front, back, detail close-up and one on-model shot.', price: '€39.99 / product', href: '/catalog', order: '/order-catalog', img: '/img/catalog-after.webp',
    use: 'The clean, consistent product shots your shop and marketplaces run on — the ones that make a small range look established.',
    where: ['Your webshop', 'Marketplaces', 'Product pages'],
    shots: ['/img/catalog-after.webp', '/img/catalog-before.webp', '/img/custom-models-02.webp'] },
  { n: '02', name: 'Lifestyle', meta: 'Three photos of your product in one styled look — scene, on-model and a logo close-up, matched in grade. A ready-to-post carousel.', price: '€59.99 / product', href: '/lifestyle', order: '/order-lifestyle', img: '/img/lifestyle-glow-01.webp',
    use: 'The styled, in-context scenes that stop the scroll and sell the feeling — your feed and your ads.',
    where: ['Instagram', 'Ads', 'Lookbook'],
    shots: ['/img/lifestyle-glow-01.webp', '/img/lifestyle-dunes-01.webp', '/img/lifestyle-flash-04.webp'] },
  { n: '03', name: 'Video', meta: 'Short product films with subtle motion, built for feeds and ads.', price: 'from €49 / video', href: '/video', order: '/order-video', img: '/img/banners-16.webp',
    use: 'Subtle motion that lifts click-through where a still photo plateaus — made for feeds and paid ads.',
    where: ['Reels / TikTok', 'Ads', 'Product pages'],
    shots: ['/img/banners-16.webp', '/img/banners-09.webp', '/img/banners-12.webp'] },
  { n: '04', name: 'Custom', meta: 'Your own style or model, designed once for your brand — then normal pricing after.', price: 'on request', href: '/custom-models', order: '/order-custom', img: '/img/custom-models-02.webp',
    use: 'One exclusive style or model, designed once and reused across every visual after — your whole brand, one consistent face.',
    where: ['Every channel', 'Campaigns', '25+ ranges'],
    shots: ['/img/custom-models-02.webp', '/img/custom-models-03.webp', '/img/banners-14.webp'] },
];

const strip = [
  '/img/lifestyle-flash-04.webp',
  '/img/lifestyle-dunes-01.webp',
  '/img/lifestyle-phone-made-05.webp',
  '/img/banners-12.webp',
  '/img/banners-02.webp',
];

// The photos we ask for per product — the quality-guarantee story.
const reqs = [
  { n: '01', title: 'Front & back', body: 'The whole product from both sides, so nothing is guessed.' },
  { n: '02', title: 'A detail close-up', body: 'Logos, stitching, hardware — the things that have to stay exact.' },
  { n: '03', title: 'The fabric', body: 'A close shot of the material so texture and sheen read true.' },
  { n: '04', title: 'Worn for fit', body: 'Someone actually wearing it, so we nail the real-world fit.' },
];
---

<Layout
  title="Product photos for clothing brands, without a shoot | VISUAILS"
  description="Send one product photo, get a full campaign back in about 24 hours. Catalog, on-model, lifestyle and video visuals — styled to your brand, human-checked, no photoshoot needed."
  ogImage="/img/hero-dunes.webp"
>
  <!-- THE COVER — one campaign still (shot nowhere, at dusk, in the dunes),
       one line that sells the dream, and the ticker docked at the bottom:
       every service, one glance. The image IS the argument: this is
       shoot-quality work, and no shoot happened. -->
  <section class="hero-cover">
    <div class="hc2-bg"><img src="/img/hero-dunes.webp" alt="A VISUAILS campaign visual — a model in the dunes at dusk" fetchpriority="high" transition:name="hero-photo" /></div>
    <div class="hc2-scrim" aria-hidden="true"></div>
    <div class="container cover-inner">
      <div class="cover-copy">
        <h1 class="cover-title"><span class="ch-l">The brand</span><span class="ch-l">you envisioned,</span><span class="ch-l"><em>visualized.</em></span></h1>
        <p class="cover-sub">One product photo becomes a publish-ready campaign — catalog, lifestyle and video, styled to your brand, back in about 24 hours.</p>
        <div class="cover-cta">
          <a href="/test-sample" class="btn btn-primary btn-glow btn-lg">Try it on your product — €0.99</a>
          <a href="/order" class="btn btn-ghost btn-lg">Order now</a>
        </div>
      </div>
    </div>
    <div class="ticker" aria-label="Services">
      <div class="tk-row">
        <a class="tk-item" href="/catalog">Catalog</a><span class="tk-sep">·</span>
        <a class="tk-item fill" href="/catalog">On-model</a><span class="tk-sep">·</span>
        <a class="tk-item" href="/lifestyle">Lifestyle</a><span class="tk-sep">·</span>
        <a class="tk-item fill" href="/video">Video</a><span class="tk-sep">·</span>
        <a class="tk-item" href="/custom-models">Custom models</a><span class="tk-sep">·</span>
        <a class="tk-item fill" href="/catalog" aria-hidden="true" tabindex="-1">Catalog</a><span class="tk-sep" aria-hidden="true">·</span>
        <a class="tk-item" href="/catalog" aria-hidden="true" tabindex="-1">On-model</a><span class="tk-sep" aria-hidden="true">·</span>
        <a class="tk-item fill" href="/lifestyle" aria-hidden="true" tabindex="-1">Lifestyle</a><span class="tk-sep" aria-hidden="true">·</span>
        <a class="tk-item" href="/video" aria-hidden="true" tabindex="-1">Video</a><span class="tk-sep" aria-hidden="true">·</span>
        <a class="tk-item fill" href="/custom-models" aria-hidden="true" tabindex="-1">Custom models</a><span class="tk-sep" aria-hidden="true">·</span>
      </div>
    </div>
  </section>

  <!-- WHAT VISUAILS IS — the editorial statement + small, concrete benefits. -->
  <section class="section-tight">
    <div class="container intro-split">
      <p class="editorial-statement reveal pending">For clothing brands that would rather <em>grow</em> than book another shoot. You've a drop to launch — not a week to lose on a studio.</p>
      <div class="mini-benefits reveal pending">
        <div class="mini-benefit">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg>
          <div><strong>Back in about a day</strong><span>Send a photo today, publish the campaign tomorrow — not in three weeks.</span></div>
        </div>
        <div class="mini-benefit">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5" /></svg>
          <div><strong>More than just AI</strong><span>We finish every visual with professional editing tools and colour grading, then a person checks it by hand — never auto-shipped.</span></div>
        </div>
        <div class="mini-benefit">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7l9-4 9 4-9 4-9-4zM3 7v10l9 4 9-4V7" /></svg>
          <div><strong>No studio, no samples shipped</strong><span>No photographer to book, no product to mail. Your photo is the whole brief.</span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- THE DEVELOP — proof before the menu: on desktop, motion.js pins this
       section and scroll itself develops the photo (scrubbing the Compare's
       --cmp-pos); the slider stays draggable after. Mobile/no-JS: the auto
       comparison. -->
  <section class="section-tight" id="develop">
    <div class="container two-col">
      <div class="reveal pending">
        <h2>One photo in. <em>The rest is ours.</em></h2>
        <p class="lead" style="margin-top:1rem">This is the entire brief we need from you — a phone photo. Watch it become a clean, publish-ready visual.</p>
        <div class="dev-steps" aria-hidden="true">
          <p class="dev-step"><span class="dn">01</span>Raw phone photo — the entire brief</p>
          <p class="dev-step"><span class="dn">02</span>Background stripped · colour locked to your brand</p>
          <p class="dev-step"><span class="dn">03</span>Human-checked · ready to publish</p>
        </div>
        <div class="flex" style="margin-top:1.6rem">
          <a href="/test-sample" class="btn btn-primary">Try it on your product</a>
          <a href={WA} class="btn btn-wa" target="_blank" rel="noopener">
            <svg class="i" viewBox="0 0 24 24"><path d="M21 11.5a8.38 8.38 0 0 1-8.5 8.5 8.5 8.5 0 0 1-4-1L3 20l1.5-4.5A8.38 8.38 0 0 1 3.5 11 8.5 8.5 0 0 1 12 3a8.38 8.38 0 0 1 8.5 8.5z" /></svg>
            WhatsApp us
          </a>
        </div>
        <p style="margin-top:.9rem;font-size:.82rem;color:var(--ink-3)">A real person, in Enschede — usually a reply within an hour on weekdays.</p>
      </div>
      <div class="reveal pending">
        <Compare
          before="/img/catalog-before.webp"
          after="/img/catalog-after.webp"
          ratio="1/1"
          objectPosition="50% 62%"
          beforeLabel="Your photo"
          afterLabel="VISUAILS"
          beforeAlt="A raw phone photo of a garment before VISUAILS"
          afterAlt="The same garment as a clean catalog visual after VISUAILS"
        />
      </div>
    </div>
  </section>

  <!-- THE SPREAD — proof at scale: a contact-sheet of real output, captions
       ruled like a magazine. Each frame opens its service. -->
  <section class="ch">
    <div class="container">
      <div class="ch-head">
        <span class="ch-orb" aria-hidden="true"></span>
        <h2 class="ch-title"><span class="ch-l">Real output.</span><span class="ch-l dim">Zero photoshoots.</span></h2>
      </div>
      <div class="spread" data-spread>
        <a class="sp-item sp-a" href="/catalog">
          <div class="sp-media" data-zoom><img src="/img/custom-models-02.webp" alt="On-model catalog visual" loading="lazy" /></div>
          <div class="sp-cap"><b>On-model</b><span>Included in every catalog set</span></div>
        </a>
        <a class="sp-item sp-b" href="/catalog">
          <div class="sp-media" data-zoom><img src="/img/catalog-after.webp" alt="Clean catalog visual" loading="lazy" /></div>
          <div class="sp-cap"><b>Catalog</b><span>€39.99 / product</span></div>
        </a>
        <a class="sp-item sp-c" href="/lifestyle">
          <div class="sp-media" data-zoom><img src="/img/lifestyle-glow-01.webp" alt="Lifestyle visual in the Glow style" loading="lazy" /></div>
          <div class="sp-cap"><b>Lifestyle</b><span>€59.99 / product</span></div>
        </a>
        <a class="sp-item sp-d" href="/video">
          <div class="sp-media" data-zoom>
            <img src="/img/banners-16.webp" alt="Product video still" loading="lazy" />
            <span class="sp-play" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z" /></svg></span>
          </div>
          <div class="sp-cap"><b>Video</b><span>from €49 / video</span></div>
        </a>
      </div>
    </div>
  </section>

  <!-- THE LEDGER — now that the work has spoken, the menu: bold names, real
       deliverables, real prices. Hover a row and the work floats up under
       your cursor. -->
  <section class="ch">
    <div class="container">
      <div class="ed-head">
        <span class="ed-meta">( Services )</span>
        <div>
          <h2>Four ways to look bigger than you are.</h2>
          <p class="ed-sub">Pay per product — no subscription. Open a row to see what it's for and where it lives.</p>
        </div>
      </div>
      <div class="svc-index" data-index>
        <div class="idx-float" aria-hidden="true"><img src="/img/catalog-after.webp" alt="" /></div>
        {ledger.map((s) => (
          <details class="idx-item">
            <summary class="idx-row" data-img={s.img}>
              <span class="idx-num">{s.n}</span>
              <span class="idx-name">{s.name}</span>
              <p class="idx-meta">{s.meta}</p>
              <span class="idx-price">{s.price}</span>
              <span class="idx-toggle" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M6 9l6 6 6-6" /></svg></span>
            </summary>
            <div class="idx-panel">
              <div class="idx-panel-in">
                <div class="idx-panel-text">
                  <p class="idx-use"><span class="idx-use-label">Best for</span>{s.use}</p>
                  <div class="idx-where">{s.where.map((w) => (<span class="idx-tag">{w}</span>))}</div>
                  <div class="idx-actions">
                    <a href={s.order} class="btn btn-primary">Order {s.name} &rarr;</a>
                    <a href={s.href} class="link-arrow">See examples &rarr;</a>
                  </div>
                </div>
                <div class="idx-shots">
                  {s.shots.map((src) => (<img src={src} alt="" loading="lazy" />))}
                </div>
              </div>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- BRAND ANATOMY — the ledger cut by channel: which visual lives where, and
       how they add up to a brand. The educational "how it fits together" view. -->
  <section class="section-tight">
    <div class="container">
      <div class="ed-head">
        <span class="ed-meta">( Your brand )</span>
        <div>
          <h2>How it all comes together.</h2>
          <p class="ed-sub">A brand isn't one photo — it's the right visual in each place your customers meet you. Here's what lives where.</p>
        </div>
      </div>
      <div class="anatomy" data-stagger>
        <a class="anat-card" href="/catalog">
          <div class="anat-media" data-zoom><img src="/img/catalog-after.webp" alt="Catalog visual on a product page" loading="lazy" /></div>
          <div class="anat-body"><span class="anat-where">Your shop</span><h3>Catalog</h3><p>Clean, consistent product pages that make your range look established.</p></div>
        </a>
        <a class="anat-card" href="/lifestyle">
          <div class="anat-media" data-zoom><img src="/img/lifestyle-glow-01.webp" alt="Lifestyle visual in a social feed" loading="lazy" /></div>
          <div class="anat-body"><span class="anat-where">Your feed</span><h3>Lifestyle</h3><p>Styled, in-context scenes that stop the scroll and sell the feeling.</p></div>
        </a>
        <a class="anat-card" href="/video">
          <div class="anat-media" data-zoom><img src="/img/banners-16.webp" alt="Product video still in an ad" loading="lazy" /></div>
          <div class="anat-body"><span class="anat-where">Your ads</span><h3>Video</h3><p>Subtle motion that lifts click-through where a still photo plateaus.</p></div>
        </a>
        <a class="anat-card" href="/custom-models">
          <div class="anat-media" data-zoom><img src="/img/custom-models-02.webp" alt="A consistent custom model across the brand" loading="lazy" /></div>
          <div class="anat-body"><span class="anat-where">Across everything</span><h3>Custom</h3><p>One exclusive style or face, keeping every channel unmistakably yours.</p></div>
        </a>
      </div>
      <p class="anat-note reveal pending">Most brands use two or three together — catalog for the shop, lifestyle for the feed, video for the ads. Start with one; add the rest as you grow.</p>
    </div>
  </section>

  <!-- THE SET — ledger row 01, expanded: the €39.99 catalog pack as four
       ruled frames. -->
  <section class="ch">
    <div class="container">
      <div class="ch-head">
        <span class="ch-orb" aria-hidden="true"></span>
        <h2 class="ch-title"><span class="ch-l">One product. Four photos.</span><span class="ch-l dim">€39.99. That's the deal.</span></h2>
        <p class="ch-sub">Every catalog order comes back as a complete set — including a real on-model shot. About €10 a photo, where a shoot day runs €1,000–2,000 — and you never leave your desk.</p>
      </div>
      <div class="set-strip" data-stagger>
        <figure class="set-frame">
          <div class="sf-media" data-zoom><img src="/img/catalog-after.webp" alt="Front catalog shot" loading="lazy" /></div>
          <figcaption class="sf-cap"><span class="sfn">01</span><b>Front</b></figcaption>
        </figure>
        <figure class="set-frame">
          <div class="sf-media" data-zoom><img src="/img/catalog-after.webp" alt="Back catalog shot" loading="lazy" /></div>
          <figcaption class="sf-cap"><span class="sfn">02</span><b>Back</b></figcaption>
        </figure>
        <figure class="set-frame">
          <div class="sf-media" data-zoom><img src="/img/catalog-before.webp" alt="Detail close-up of logo or fabric" loading="lazy" /></div>
          <figcaption class="sf-cap"><span class="sfn">03</span><b>Detail</b></figcaption>
        </figure>
        <figure class="set-frame">
          <div class="sf-media" data-zoom><img src="/img/custom-models-02.webp" alt="On-model shot, worn for fit" loading="lazy" /></div>
          <figcaption class="sf-cap"><span class="sfn">04</span><b>On-model</b></figcaption>
        </figure>
      </div>
      <div class="ch-cta">
        <a href="/order-catalog" class="btn btn-primary btn-glow">Order catalog — €39.99 / product</a>
      </div>
    </div>
  </section>

  <!-- THE PROCESS — a true sequence, from photo to publish. -->
  <section class="ch">
    <div class="container">
      <div class="ed-head">
        <span class="ed-meta">( Process )</span>
        <div>
          <h2>From photo to publish.</h2>
          <p class="ed-sub">Four steps, one working day. You only do the first one.</p>
        </div>
      </div>
      <div class="process" data-stagger>
        <div class="pr-step">
          <span class="pr-num">01</span>
          <h3 class="pr-t">Upload</h3>
          <p class="pr-b">One clear photo of your product — that's the whole brief.</p>
        </div>
        <div class="pr-step">
          <span class="pr-num">02</span>
          <h3 class="pr-t">We build</h3>
          <p class="pr-b">AI plus professional editing tools and colour grading, matched to your brand.</p>
        </div>
        <div class="pr-step">
          <span class="pr-num">03</span>
          <h3 class="pr-t">Human check</h3>
          <p class="pr-b">A person approves every visual before it reaches you — never auto-shipped.</p>
        </div>
        <div class="pr-step">
          <span class="pr-num">04</span>
          <h3 class="pr-t">Publish</h3>
          <p class="pr-b">~24 hours later: files ready for your shop, ads and socials.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FILM STRIP — two counter-drifting rows of real output. -->
  <section class="section-tight">
    <div class="visual-marquee">
      <div class="vm-row">
        <img src={strip[0]} alt="Flash-style lifestyle visual" loading="lazy" />
        <img src={strip[1]} alt="Dunes-style lifestyle visual" loading="lazy" />
        <img src="/img/banners-09.webp" alt="Campaign visual" loading="lazy" />
        <img src={strip[2]} alt="Phone-made-style lifestyle visual" loading="lazy" />
        <img src={strip[0]} alt="" aria-hidden="true" loading="lazy" />
        <img src={strip[1]} alt="" aria-hidden="true" loading="lazy" />
        <img src="/img/banners-09.webp" alt="" aria-hidden="true" loading="lazy" />
        <img src={strip[2]} alt="" aria-hidden="true" loading="lazy" />
      </div>
      <div class="vm-row">
        <img src={strip[3]} alt="Campaign photography" loading="lazy" />
        <img src="/img/lifestyle-glow-05.webp" alt="Glow-style lifestyle visual" loading="lazy" />
        <img src={strip[4]} alt="Campaign photography" loading="lazy" />
        <img src="/img/lifestyle-flash-07.webp" alt="Flash-style lifestyle visual" loading="lazy" />
        <img src={strip[3]} alt="" aria-hidden="true" loading="lazy" />
        <img src="/img/lifestyle-glow-05.webp" alt="" aria-hidden="true" loading="lazy" />
        <img src={strip[4]} alt="" aria-hidden="true" loading="lazy" />
        <img src="/img/lifestyle-flash-07.webp" alt="" aria-hidden="true" loading="lazy" />
      </div>
    </div>
  </section>

  <!-- QUALITY GUARANTEE — the multi-photo story, sold as an upside. -->
  <section class="section-tight">
    <div class="container">
      <div class="ed-head" style="margin-bottom:clamp(2.4rem,4.5vw,3.6rem)">
        <span class="ed-meta">( Quality )</span>
        <div>
          <h2>The more you show us, <em>the more we guarantee.</em></h2>
          <p class="ed-sub">One clear photo is enough to get started. But because we usually never hold your product, a few extra angles let us match it exactly — this is where quality is won.</p>
        </div>
      </div>
      <div class="req-grid reveal-group">
        {reqs.map((r) => (
          <div class="req-card reveal pending">
            <span class="rc-num">{r.n}</span>
            <h4>{r.title}</h4>
            <p>{r.body}</p>
          </div>
        ))}
      </div>
      <p class="req-note reveal pending"><strong>Not required — just recommended.</strong> We can already deliver from a single photo of the whole product. Send the full set and we can guarantee the fit, colour and detail come out right the first time.</p>
    </div>
  </section>

  <!-- LEAD MAGNET — the free briefing-photo checklist. Captures an email while
       giving something genuinely useful before anyone is a customer, and it
       lifts the quality of what we're sent. -->
  <section class="section-tight">
    <div class="container">
      <div class="lead-magnet reveal pending">
        <div class="lm-copy">
          <span class="lm-kicker">Free · the briefing-photo checklist</span>
          <h2>The one-page checklist for a photo we can turn into a campaign.</h2>
          <ul class="lm-list">
            <li>The four angles that guarantee the result</li>
            <li>Lighting and background in 30 seconds, with a phone</li>
            <li>The mistakes that cost you a revision round</li>
          </ul>
        </div>
        <form class="lm-form" action="/api/order" method="post">
          <input type="hidden" name="service" value="subscribe" />
          <input type="hidden" name="redirect" value="/thank-you" />
          <input type="hidden" name="lang" value="en" />
          <input type="text" name="company_hp" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0" />
          <input type="hidden" name="subscribe" value="briefing-checklist" />
          <label class="lm-label" for="lm-email">Where should we send it?</label>
          <div class="lm-row">
            <input id="lm-email" type="email" name="email" required placeholder="you@yourbrand.com" autocomplete="email" />
            <button type="submit" class="btn btn-primary" data-track="lead-magnet">Send me the checklist</button>
          </div>
          <p class="lm-fine">One email with the checklist and our best before/afters. No spam, unsubscribe anytime.</p>
        </form>
      </div>
    </div>
  </section>

  <!-- MODELS — real portrait, one line. -->
  <section class="section-tight">
    <div class="container">
      <div class="photo-split reverse reveal pending">
        <div class="photo-split-media">
          <img src="/img/custom-models-02.webp" alt="A VISUAILS model, styled consistently across a campaign" loading="lazy" />
        </div>
        <div>
          <h2>One face.<br /><em>Every campaign.</em></h2>
          <p class="lead" style="margin-top:1rem">The same model, locked to your brand, across your whole collection — or a custom face made only for you. Once it's set, every next drop is just a photo away.</p>
