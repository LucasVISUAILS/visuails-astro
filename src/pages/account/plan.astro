---
/**
 * /account/plan — de abonnementspagina. Alles komt uit planView() in account.js.
 *
 * PUNT 2.07, 8 oktober 2026: ÉÉN PAGINA ZONDER TABBLADEN, zonder script. Van
 * boven naar beneden: het saldo (creditboek, niet meer subscription_slots), twee
 * bestelknoppen met je vaste look erin, de creditkaart (6.01), de maandset, het
 * creditboek (elke bij- en afschrijving, met de bestelling en haar status), en
 * "Je plan" (plan, termijn, bedrag, volgende afschrijving, facturen, pauzeren en
 * opzeggen). Wie op "Opzeggen" klikt, krijgt eerst pauzeren aangeboden; beide
 * vragen een reden (stopReden.js). De knop "Bespreek met ons wat je met je
 * credits kunt doen" stuurt Lucas een studiomail (handlePlanBespreek()).
 *
 * De formulieren posten naar dezelfde routes als voorheen (accountPost), met
 * dezelfde CSRF-bescherming: /account/plan/pause, /account/plan/cancel, en
 * nieuw /account/plan/bespreek. Een oude link met ?tab=… komt hier gewoon uit.
 *
 * /account/plan/return blijft in accountGet(): dat is de terugkeer van de
 * betaalpagina, geen scherm van deze pagina.
 */
import StudioLayout from '../../layouts/StudioLayout.astro';
import Plaatshouder from '../../components/studio/Plaatshouder.astro';
import VasteLookRij from '../../components/studio/VasteLookRij.astro';
import CreditKaart from '../../components/CreditKaart.astro';
import { pagesContext } from '../../lib/route.js';
import { studioScreen } from '../../lib/account.js';
import { standKlasse } from '../../data/status.js';

export const prerender = false;

const s = await studioScreen(pagesContext(Astro), 'plan');
if (s instanceof Response) return s;

const { st, v, bk } = s;
const { t, lang, customer, thema, navDicht } = st;
const T = v.tekst || {};
---
<StudioLayout
  lang={lang} t={t} thema={thema} navDicht={navDicht} actief="plan" customer={customer}
  title={t.planHeading} kop={t.planHeading} chip={v.chip} actie={v.actie}
>
  {v.melding && <p class="st-melding is-warn" role="alert">{v.melding}</p>}
  {v.bevestiging && <p class="st-melding is-ok" role="status">{v.bevestiging}</p>}

  {v.geen && (
    <Fragment>
      <section class="st-blok" aria-label={v.leeg.h}>
        <div class="st-kaart-vlak st-geenabo">
          <span class="st-eyebrow">{v.leeg.eyebrow}</span>
          <h2>{v.leeg.h}</h2>
          <p>{v.leeg.p}</p>
          <div class="st-knoppen">
            <a class="btn btn-primary" href={v.leeg.ctaHref}>{v.leeg.cta}</a>
            <a class="btn btn-2nd" href={v.leeg.altHref}>{v.leeg.alt}</a>
          </div>
        </div>
      </section>
      {v.tegoed && (
        <section class="st-blok" aria-label={v.tegoed.h}>
          <div class="st-kaart-vlak st-vlak st-saldo-tegel is-tegoed is-los">
            <span class="st-eyebrow">{v.tegoed.h}</span>
            <p class="st-credit-tel"><b>{v.tegoed.bedrag}</b></p>
            <p class="st-meta">{v.tegoed.uitleg}</p>
          </div>
        </section>
      )}
      {/* Twee dingen die een abonnement is, als beeld: de credits en de look. */}
      <section class="st-blok" aria-label={t.planVisSlotsH}>
        <div class="st-uitleg">
          <div class="st-kaart-vlak st-vlak st-uitleg-blok">
            <div class="st-frames is-uitleg">
              {Array.from({ length: 12 }, (_, i) => <span class={`st-frame${i < 4 ? ' is-gemaakt' : i < 7 ? ' is-vast' : ' is-vrij'}`}>{i < 4 ? <Plaatshouder klein ratio="4/5" /> : i < 7 ? <Plaatshouder klein donker ratio="4/5" /> : <span class="st-frame-leeg"></span>}</span>)}
            </div>
            <h2>{t.planVisSlotsH}</h2>
            <p>{t.planVisSlotsP}</p>
          </div>
          <div class="st-kaart-vlak st-vlak st-uitleg-blok">
            {bk && <VasteLookRij t={t} k={bk.kaarten[0]} voorbeeld />}
            <h2>{t.planVisLookH}</h2>
            <p>{t.planVisLookP}</p>
          </div>
        </div>
      </section>
    </Fragment>
  )}

  {!v.geen && (
    <Fragment>
      {/* ── DE STAND: pauze (straks of nu), opgezegd, teruggeboekt, gestopt ── */}
      {v.nooitBetaald && (
        <p class="st-melding is-warn">{t.planFirstUnpaid} <a class="st-link" href={v.opnieuw}>{t.planFirstRetry}</a></p>
      )}
      {v.standZin && (
        <div class={`st-melding st-abo-stand${['teruggeboekt', 'stil', 'mislukt'].includes(v.stand) ? ' is-warn' : ''}${v.standNet ? ' is-ok' : ''}`} data-stand={v.stand} role={v.standNet ? 'status' : undefined}>
          <p>{v.standZin}</p>
          {v.beheer?.magHervatten && (
            <form method="post" action="/account/plan/pause">
              <input type="hidden" name="do" value="resume" />
              <button class="btn btn-primary btn-sm" type="submit">{v.beheer.hervatLabel}</button>
            </form>
          )}
          {v.stand === 'gestopt' && <a class="st-link" href={v.plansHref}>{t.planNoneCta} →</a>}
        </div>
      )}

      {/* ── BESPREEK JE CREDITS — groot in beeld na de reden "weet niet wat ik
          met mijn credits moet doen" (Lucas bij 2.07). ── */}
      {v.bespreek?.nadruk && !v.bespreek.gevraagd && (
        <section class="st-blok" aria-labelledby="bespreek-h">
          <div class="st-kaart-vlak st-vlak st-bespreek is-nadruk" id="bespreek">
            <h2 id="bespreek-h">{T.bespreekH}</h2>
            <p>{T.bespreekP}</p>
            <form method="post" action="/account/plan/bespreek">
              <button class="btn btn-primary" type="submit">{T.bespreekKnop}</button>
            </form>
          </div>
        </section>
      )}

      {/* ── HET SALDO ── */}
      <section class="st-blok" aria-labelledby="saldo-h">
        <div class={`st-kaart-vlak st-vlak st-abo-saldo${v.saldo.leeg ? ' is-leeg' : ''}`} id="saldo">
          {v.plan && <span class="st-eyebrow">{T.planLabel} · {v.plan.naam}</span>}
          {/* Het spaarplafond (12 oktober 2026): "Je hebt 356 credits (je kunt
              er 360 sparen)", en bij een lopend abonnement geen vervaldatum maar
              wat er bij de volgende termijn boven het plafond zou vervallen. */}
          <h2 id="saldo-h" class="st-abo-getal">{v.saldo.kop}{v.saldo.spaar && <Fragment> <span class="st-abo-spaar">{v.saldo.spaar}</span></Fragment>}</h2>
          {v.saldo.vertaling && <p class="st-abo-vertaling">{v.saldo.vertaling}</p>}
          {(v.saldo.eerst || v.saldo.rest) && (
            <p class={`st-abo-verval${v.saldo.bijna && !v.saldo.boven ? ' is-bijna' : ''}`} data-bijna={v.saldo.bijna && !v.saldo.boven ? 'ja' : undefined}>{[v.saldo.eerst, v.saldo.rest].filter(Boolean).join(' ')}</p>
          )}
          {v.saldo.nieuw && <p class={`st-abo-nieuw${v.saldo.boven ? ' is-boven' : ''}`} data-boven={v.saldo.boven || undefined}>{v.saldo.nieuw}</p>}
          {v.saldo.bijgekocht && <p class="st-abo-verval" data-bijgekocht>{v.saldo.bijgekocht}</p>}
          {v.saldo.bevroren && <p class="st-melding is-warn" data-bevroren>{v.saldo.bevroren}</p>}
          <p class="st-meta">{v.saldo.geldig}</p>
        </div>
      </section>

      {/* ── BESTELLEN MET CREDITS: twee knoppen met de vaste look erin ── */}
      <section class="st-blok" aria-labelledby="bestel-h">
        <div class="st-kaart-vlak st-vlak st-abo-bestel">
          <h2 id="bestel-h">{T.bestelH}</h2>
          <p class="st-meta">{v.bestelLede}</p>
          <ul class="st-abo-knoppen" role="list">
            {v.bestel.map((k, i) => (
              <li data-dienst={k.dienst}>
                <a class={`btn ${i === 0 ? 'btn-primary' : 'btn-2nd'}`} href={k.href}>{k.label}</a>
                <span class="st-meta">{k.per}</span>
              </li>
            ))}
          </ul>
          <p class="st-meta st-abo-links"><a class="st-link" href={v.andereLook.href}>{v.andereLook.label}</a> · <a class="st-link" href={v.lookAanpassen.href}>{v.lookAanpassen.label}</a></p>
        </div>
        <CreditKaart lang={lang} plannen={false} kern />
      </section>

      {/* ── EXTRA CREDITS BIJKOPEN — 12 oktober 2026 (ab-v3 = c, ab-v4 = b) ──
          Een gewoon formulier zonder script: drie keuzerondjes en een knop, naar
          /account/plan/bijkopen (dezelfde Origin-controle als elk Studio-
          formulier). Daarvandaan naar Mollie; terug op ?bijkoop=… zegt de
          melding bovenaan wat er gebeurde. */}
      {v.bijkoop && (
        <section class="st-blok" aria-labelledby="bijkopen-h">
          <div class="st-kaart-vlak st-vlak st-bijkoop" id="bijkopen">
            <h2 id="bijkopen-h">{v.bijkoop.h}</h2>
            <p class="st-meta">{v.bijkoop.lede}</p>
            {v.bijkoop.verder && <p class="st-bijkoop-verder"><a class="btn btn-primary btn-sm" href={v.bijkoop.verder.href}>{v.bijkoop.verder.label}</a></p>}
            {v.bijkoop.hint && <p class="st-bijkoop-hint">{v.bijkoop.hint} <a class="st-link" href={v.bijkoop.hintLink.href}>{v.bijkoop.hintLink.label}</a></p>}
            {v.bijkoop.kan
              ? (
                <form method="post" action="/account/plan/bijkopen" class="st-bijkoop-form">
                  {v.bijkoop.verderVeld && <input type="hidden" name="verder" value={v.bijkoop.verderVeld} />}
                  <fieldset class="st-bijkoop-keuze">
                    <legend class="sr-only">{v.bijkoop.h}</legend>
                    {v.bijkoop.pakketten.map((p) => (
                      <label class={`st-bijkoop-pakket${p.kan ? '' : ' is-uit'}`} data-pakket={p.credits}>
                        <input type="radio" name="pakket" value={String(p.credits)} checked={p.gekozen} disabled={!p.kan} required={p.kan} />
                        <span class="st-bijkoop-tekst">
                          <span class="st-bijkoop-n">{p.label}{p.korting && <span class="st-bijkoop-korting">{p.korting}</span>}</span>
                          <span class="st-bijkoop-prijs">{p.prijs}</span>
                          <span class="st-meta">{p.sub}</span>
                        </span>
                      </label>
                    ))}
                  </fieldset>
                  {v.bijkoop.pakketten.filter((p) => p.hint).map((p) => (
                    <p class="st-bijkoop-hint" data-hint={p.credits}>{p.hint} <a class="st-link" href={v.bijkoop.hintLink.href}>{v.bijkoop.hintLink.label}</a></p>
                  ))}
                  <p class="st-meta">{v.bijkoop.ruimte}</p>
                  <p class="st-meta">{v.bijkoop.betaal}</p>
                  <div class="st-knoppen"><button class="btn btn-primary" type="submit">{v.bijkoop.knop}</button></div>
                </form>
              )
              : <p class="st-meta">{v.bijkoop.ruimte}</p>}
            {v.bijkoop.eerder.length > 0 && (
              <details class="st-boek-eerder">
                <summary class="st-link">{v.bijkoop.eerderH} ({v.bijkoop.eerder.length})</summary>
                <ul class="st-bijkoop-eerder" role="list">
                  {v.bijkoop.eerder.map((a) => <li><span class="st-boek-dag">{a.dag}</span> {a.tekst} · <span class={a.betaald ? '' : 'st-meta'}>{a.status}</span></li>)}
                </ul>
              </details>
            )}
          </div>
        </section>
      )}

      {/* ── DE MAANDSET ── */}
      {v.maandset && (
        <section class="st-blok" aria-label={t.msH}>
          <div class="st-kaart-vlak st-vlak">
            <h2>{t.msH}</h2>
            <p class="st-meta">{t.msLede}</p>
            {v.maandset.nu
              ? (
                <Fragment>
                  <div class="st-set is-nu" id={`set-${v.maandset.nu.id}`}>
                    <div class="st-set-kop"><span class="st-set-maand">{v.maandset.nu.label}</span><span class="st-meta">{v.maandset.nu.n}</span></div>
                    {v.maandset.nu.beelden.length > 0 && <div class="st-strook">{v.maandset.nu.beelden.map((b) => <span><img src={b} alt="" loading="lazy" decoding="async" width="240" height="240" /></span>)}</div>}
                    <a class="btn btn-primary btn-sm" href={v.maandset.nu.zip}>{t.msZip}</a>
                  </div>
                  <p class="st-meta">{t.msLicence}</p>
                </Fragment>
              )
              : <p class="st-meta">{t.msNone}</p>}
            {v.maandset.eerder.length > 0 && (
              <Fragment>
                <h3 class="st-h3">{t.msEarlier}</h3>
                {v.maandset.eerder.map((ms) => (
                  <div class="st-set" id={`set-${ms.id}`}>
                    <div class="st-set-kop"><span class="st-set-maand">{ms.label}</span><span class="st-meta">{ms.n}</span></div>
                    {ms.beelden.length > 0 && <div class="st-strook is-klein">{ms.beelden.map((b) => <span><img src={b} alt="" loading="lazy" decoding="async" width="240" height="240" /></span>)}</div>}
                    <a class="btn btn-2nd btn-sm" href={ms.zip}>{t.msZip}</a>
                  </div>
                ))}
              </Fragment>
            )}
          </div>
          <p class="st-meta st-editions-regel">{t.planEditionsRegel} <a class="st-link" href={lang === 'nl' ? '/nl/plans#editions' : '/plans#editions'}>{t.planEditionsMeer} →</a></p>
        </section>
      )}

      {/* ── HET CREDITBOEK ── */}
      <section class="st-blok" aria-labelledby="boek-h">
        <div class="st-kaart-vlak st-vlak st-boek" id="creditboek">
          <h2 id="boek-h">{T.boekH}</h2>
          <p class="st-meta">{T.boekLede}</p>
          {v.boek.leeg
            ? <p class="st-meta">{T.koppen.leeg}</p>
            : (
              <Fragment>
                <table class="st-tabel st-boek-tabel">
                  <thead><tr><th scope="col">{T.koppen.datum}</th><th scope="col">{T.koppen.wat}</th><th scope="col" class="is-bedrag">{T.koppen.credits}</th><th scope="col" class="is-bedrag">{T.koppen.saldo}</th></tr></thead>
                  <tbody>
                    {v.boek.regels.map((r) => (
                      <tr data-reden={r.reden}>
                        <td class="st-boek-dag">{r.dag}</td>
                        <td class="st-boek-wat">
                          <span>{r.wat}</span>
                          {r.ref && (r.href ? <Fragment> · <a class="st-link" href={r.href}>{r.ref}</a></Fragment> : <Fragment> · {r.ref}</Fragment>)}
                          {r.status && <Fragment> <span class={standKlasse(r.status.key)}>{r.status.tekst}</span></Fragment>}
                          {r.toelichting && <span class="st-meta st-boek-noot">{r.toelichting}</span>}
                          {r.geldig && <span class="st-meta st-boek-noot">{r.geldig}</span>}
                        </td>
                        <td class={`is-bedrag st-boek-n${r.plus ? ' is-plus' : ''}`}>{r.aantal}</td>
                        <td class="is-bedrag">{r.saldoNa}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
                {v.boek.eerder.length > 0 && (
                  <details class="st-boek-eerder">
                    <summary class="st-link">{T.koppen.eerder} ({v.boek.eerder.length})</summary>
                    <table class="st-tabel st-boek-tabel">
                      <thead><tr><th scope="col">{T.koppen.datum}</th><th scope="col">{T.koppen.wat}</th><th scope="col" class="is-bedrag">{T.koppen.credits}</th><th scope="col" class="is-bedrag">{T.koppen.saldo}</th></tr></thead>
                      <tbody>
                        {v.boek.eerder.map((r) => (
                          <tr data-reden={r.reden}>
                            <td class="st-boek-dag">{r.dag}</td>
                            <td class="st-boek-wat">
                              <span>{r.wat}</span>
                              {r.ref && (r.href ? <Fragment> · <a class="st-link" href={r.href}>{r.ref}</a></Fragment> : <Fragment> · {r.ref}</Fragment>)}
                              {r.status && <Fragment> <span class={standKlasse(r.status.key)}>{r.status.tekst}</span></Fragment>}
                              {r.toelichting && <span class="st-meta st-boek-noot">{r.toelichting}</span>}
                            </td>
                            <td class={`is-bedrag st-boek-n${r.plus ? ' is-plus' : ''}`}>{r.aantal}</td>
                            <td class="is-bedrag">{r.saldoNa}</td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </details>
                )}
              </Fragment>
            )}
        </div>
      </section>

      {/* ── BESPREEK JE CREDITS (rustig, als er credits zijn) ── */}
      {v.bespreek && !v.bespreek.nadruk && !v.bespreek.gevraagd && (
        <section class="st-blok" aria-labelledby="bespreek-h2">
          <div class="st-kaart-vlak st-vlak st-bespreek" id="bespreek">
            <h2 id="bespreek-h2">{T.bespreekH}</h2>
            <p>{T.bespreekP}</p>
            <form method="post" action="/account/plan/bespreek">
              <button class="btn btn-2nd btn-sm" type="submit">{T.bespreekKnop}</button>
            </form>
          </div>
        </section>
      )}

      {/* ── JE PLAN ── */}
      {v.plan && (
        <section class="st-blok" aria-labelledby="je-plan-h">
          <div class="st-kaart-vlak st-vlak" id="je-plan">
            <h2 id="je-plan-h">{T.planH}</h2>
            <dl class="st-feiten">
              <div class="st-feit"><dt>{T.planLabel}</dt><dd>{v.plan.naam}</dd></div>
              <div class="st-feit"><dt>{T.termijn}</dt><dd>{v.plan.termijn}</dd></div>
              <div class="st-feit"><dt>{v.plan.bedragLabel}</dt><dd>{v.plan.bedrag}</dd></div>
              {v.plan.volgende && <div class="st-feit"><dt>{T.volgende}</dt><dd>{v.plan.volgende}</dd></div>}
              {v.plan.jaarTot && <div class="st-feit"><dt>{T.jaarTot}</dt><dd>{v.plan.jaarTot}</dd></div>}
              {v.plan.status && <div class="st-feit"><dt>{T.status}</dt><dd>{v.plan.status}</dd></div>}
            </dl>
            <p class="st-meta">{T.facturen} <a class="st-link" href="/account/invoices">{T.facturenLink} →</a></p>

            {v.beheer?.magPauzeren && (
              <details class="st-opzeggen st-stop" id="pauzeren">
                <summary class="btn btn-ghost btn-sm">{T.pauzeren}</summary>
                <form method="post" action="/account/plan/pause" class="st-stop-form">
                  <input type="hidden" name="do" value="pause" />
                  <p class="st-meta">{v.beheer.pauzeUitleg}</p>
                  <fieldset class="st-redenen">
                    <legend class="st-label">{T.waarom}</legend>
                    {v.beheer.redenen.map((r, i) => (
                      <label class="st-reden"><input type="radio" name="reden" value={r.id} required={i === 0} data-melding={i === 0 ? T.redenMelding : undefined} /> <span>{r.label}</span></label>
                    ))}
                    <label class="st-label" for="pz-toelichting">{T.andersLabel}</label>
                    <input id="pz-toelichting" class="st-veld" name="toelichting" type="text" maxlength="300" autocomplete="off" />
                  </fieldset>
                  <button class="btn btn-primary btn-sm" type="submit">{T.pauzeren}</button>
                </form>
              </details>
            )}

            {v.beheer?.magOpzeggen && (
              <details class="st-opzeggen st-stop" id="opzeggen">
                {/* Opzeggen achter één klik (29 september 2026), en sinds 2.07 met
                    eerst het aanbod om te pauzeren. */}
                <summary class="st-link">{t.planCancel}</summary>
                {/* Eén formulier, twee knoppen. Opzeggen staat als eerste knop in
                    de code, zodat Enter in het opzegveld opzegt en niet pauzeert;
                    het aanbod om te pauzeren staat bovenaan in tekst en als
                    hoofdknop ernaast (formaction, zonder script). */}
                <form method="post" action="/account/plan/cancel" class="st-stop-form">
                  {v.beheer.magPauzeren && <p class="st-melding st-stop-aanbod">{T.opzegAanbod} {v.beheer.pauzeUitleg}</p>}
                  <fieldset class="st-redenen">
                    <legend class="st-label">{T.waarom}</legend>
                    {v.beheer.redenen.map((r, i) => (
                      <label class="st-reden"><input type="radio" name="reden" value={r.id} required={i === 0} data-melding={i === 0 ? T.redenMelding : undefined} /> <span>{r.label}</span></label>
                    ))}
                    <label class="st-label" for="oz-toelichting">{T.andersLabel}</label>
                    <input id="oz-toelichting" class="st-veld" name="toelichting" type="text" maxlength="300" autocomplete="off" />
                  </fieldset>
                  <p class="st-meta">{v.beheer.opzegUitleg}</p>
                  <div class="st-veldgroep">
                    <label for="opz">{v.beheer.magPauzeren ? T.opzegToch : t.planCancelConfirm}</label>
                    <input id="opz" class="st-veld" name="confirm" type="text" autocomplete="off" placeholder={T.opzegWoord} />
                  </div>
                  <div class="st-knoppen">
                    <button class="btn btn-ghost btn-sm" type="submit">{t.planCancel}</button>
                    {v.beheer.magPauzeren && <button class="btn btn-primary btn-sm" type="submit" name="do" value="pause" formaction="/account/plan/pause">{T.pauzeInPlaats}</button>}
                  </div>
                </form>
              </details>
            )}
          </div>
        </section>
      )}

      {/* Het tegoed staat hier niet meer (2.02): zijn thuis is Facturen, en het
          Overzicht toont het in de strook "Je saldo". Credits zijn van deze pagina. */}
    </Fragment>
  )}

  <p class="st-meta">{v.account.note}</p>
</StudioLayout>
