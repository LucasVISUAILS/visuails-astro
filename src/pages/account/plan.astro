---
/**
 * /account/plan — Abonnement & facturering, als Astro-pagina. Studio fase 2,
 * 5 september 2026. Alles komt uit planView() in account.js: de status, de
 * meldingen, de vijf tabben (links, geen script), en per tab de blokken die
 * planBody() ook tekende — het saldo met slotmeters, je week, de maandset; de
 * lijst en de agenda; de edities; je look; wat je hebt opgebouwd en het beheer.
 * De formulieren posten naar dezelfde routes als voorheen (accountPost).
 *
 * /account/plan/return blijft in accountGet(): dat is de terugkeer van de
 * betaalpagina, geen scherm van deze pagina.
 */
import StudioLayout from '../../layouts/StudioLayout.astro';
import Slotmeter from '../../components/studio/Slotmeter.astro';
import Plaatshouder from '../../components/studio/Plaatshouder.astro';
import VasteLookRij from '../../components/studio/VasteLookRij.astro';
import { pagesContext } from '../../lib/route.js';
import { studioScreen, STUDIO_ICONS } from '../../lib/account.js';

export const prerender = false;

const s = await studioScreen(pagesContext(Astro), 'plan');
if (s instanceof Response) return s;

const { st, v, bk } = s;
const { t, lang, customer, thema, navDicht } = st;
---
<StudioLayout
  lang={lang} t={t} thema={thema} navDicht={navDicht} actief="plan" customer={customer}
  title={t.planHeading} kop={t.planHeading} chip={v.chip} actie={v.actie}
>
  {v.melding && <p class="st-melding is-warn" role="alert">{v.melding}</p>}
  {v.bevestiging && <p class="st-melding is-ok" role="status">{v.bevestiging}</p>}

  {v.geen && (
    <Fragment>
      <section class="st-blok" aria-label={v.leeg.h}>
        <div class="st-kaart-vlak st-geenabo">
          <span class="st-eyebrow">{v.leeg.eyebrow}</span>
          <h2>{v.leeg.h}</h2>
          <p>{v.leeg.p}</p>
          <div class="st-knoppen">
            <a class="btn btn-primary" href={v.leeg.ctaHref}>{v.leeg.cta}</a>
            <a class="btn btn-2nd" href={v.leeg.altHref}>{v.leeg.alt}</a>
          </div>
        </div>
      </section>
      {/* Drie dingen die een abonnement is, als beeld: de slots, de week, de look. */}
      <section class="st-blok" aria-label={t.planVisSlotsH}>
        <div class="st-uitleg">
          <div class="st-kaart-vlak st-vlak st-uitleg-blok">
            <div class="st-frames is-uitleg">
              {Array.from({ length: 12 }, (_, i) => <span class={`st-frame${i < 4 ? ' is-gemaakt' : i < 7 ? ' is-vast' : ' is-vrij'}`}>{i < 4 ? <Plaatshouder klein ratio="4/5" /> : i < 7 ? <Plaatshouder klein donker ratio="4/5" /> : <span class="st-frame-leeg"></span>}</span>)}
            </div>
            <h2>{t.planVisSlotsH}</h2>
            <p>{t.planVisSlotsP}</p>
          </div>
          <div class="st-kaart-vlak st-vlak st-uitleg-blok">
            <div class="st-weekstrip" aria-hidden="true">
              {v.weekstrip.map((d) => <span class={`st-dag${d.week ? ' is-week' : ''}${d.start ? ' is-start' : ''}`}>{d.n}</span>)}
            </div>
            <h2>{t.planVisWeekH}</h2>
            <p>{t.planVisWeekP}</p>
          </div>
          <div class="st-kaart-vlak st-vlak st-uitleg-blok">
            {bk && <VasteLookRij t={t} k={bk.kaarten[0]} voorbeeld />}
            <h2>{t.planVisLookH}</h2>
            <p>{t.planVisLookP}</p>
          </div>
        </div>
      </section>
    </Fragment>
  )}

  {!v.geen && (
    <Fragment>
      {v.nudge && (
        <aside class="st-kaart-vlak st-nudge">
          <div><h2>{v.nudge.h}</h2><p>{v.nudge.p}</p><p class="st-meta">{v.nudge.which}</p></div>
          <a class="btn btn-2nd btn-sm" href="/account/brand-kit">{v.nudge.cta}</a>
        </aside>
      )}
      <nav class="st-tabs" aria-label={t.planTabsLabel}>
        {v.tabs.map((tb) => <a class={`st-tab${tb.nu ? ' is-nu' : ''}`} href={tb.href} aria-current={tb.nu ? 'page' : undefined}>{tb.label}</a>)}
      </nav>

      {v.nu === 'maand' && (
        <Fragment>
          {/* ── HET OVERZICHT ALS ÉÉN VERHAAL — 19 september 2026 ─────────────
              Uit de doorlichting: twaalf plus-tegels die als uploadvakken lazen,
              een strook van 28 dagnummers zonder maandnaam, en de look en
              Editions elk op een eigen tab. Nu, van boven naar beneden: wat je
              abonnement is, wat er deze maand van gebruikt is (de gemaakte en
              vastgezette frames, plus één tegel met wat er vrij is), wanneer je
              week is (als echte datum), je vaste look (één regel), de gedeelde
              set, en één regel over Editions. */}
          <section class="st-blok" aria-label={t.planBalanceH}>
            <div class="st-kaart-vlak st-saldo">
              <div class="st-saldo-kop">
                <div><span class="st-eyebrow">{t.planBalanceH}</span><h2>{v.saldo.naam}</h2></div>
                {v.saldo.volgende && <div class="st-saldo-volgende"><span class="st-eyebrow">{t.planNextCharge}</span><strong>{v.saldo.volgende}</strong></div>}
              </div>
              <div class="st-saldo-rij">
                <div class="st-saldo-uitleg">
                  <span class="st-eyebrow">{t.planSlotsH}</span>
                  <p class="st-meta">{t.planSlotsLede}</p>
                </div>
                <div class="st-knoppen">
                  <a class="btn btn-primary btn-sm" href="/account/plan?tab=bestellen">{t.planSlotFill}</a>
                  <a class="btn btn-ghost btn-sm" href={v.saldo.startComplete}>{t.planRequest}</a>
                </div>
              </div>
              {v.saldo.slots.length > 0 && (
                <div class="st-slots">
                  {v.saldo.slots.map((s) => (
                    <div class={`st-slot${s.vol ? ' is-vol' : ''}`}>
                      <div class="st-slot-kop">
                        <span class="st-slot-naam"><span class="n">{s.naam}</span><span class="u">{s.per}</span>{s.verval && <span class="st-slot-verval">{s.verval}</span>}</span>
                        <span class="st-slot-tel"><b>{s.tel}</b> {s.telLabel}</span>
                      </div>
                      <div class="st-frames">
                        {s.frames.slice(0, 24).map((fr) => (
                          <span class={`st-frame is-${fr.kind}`} aria-label={fr.label}>{fr.img ? <img src={fr.img} alt="" loading="lazy" decoding="async" /> : <Plaatshouder klein donker={fr.kind === 'vast'} ratio="4/5" />}</span>
                        ))}
                        {s.frames.length > 24 && <span class="st-frame is-meer">+{s.frames.length - 24}</span>}
                        {s.vrij > 0 && <a class="st-frame is-vrij is-tel" href="/account/plan?tab=bestellen"><span class="st-frame-leeg">{t.planVrijTegel(s.vrij)}</span></a>}
                      </div>
                      {(s.frames.length > 0 || s.oud) && (
                        <div class="st-frame-legenda">
                          {s.frames.some((fr) => fr.kind === 'gemaakt') && <span><i class="is-gemaakt"></i>{t.planVisFrameMade}</span>}
                          {s.frames.some((fr) => fr.kind === 'vast') && <span><i class="is-vast"></i>{t.planVisFrameLocked}</span>}
                          {s.oud && <span class="st-slot-oud"><Slotmeter g={s.oud} alsBalk={s.alsBalk} /> {s.oud.label}</span>}
                        </div>
                      )}
                    </div>
                  ))}
                </div>
              )}
              <p class="st-meta">{v.saldo.elkProduct && <Fragment>{t.planEachProduct} · </Fragment>}{t.planExtraNote}</p>
              {!v.saldo.betaald && <p class="st-melding is-warn">{t.planUnpaid}</p>}
            </div>
          </section>
          <section class="st-blok" aria-label={t.planWindowH}>
            <div class="st-kaart-vlak st-vlak st-week">
              <div>
                <h2>{t.planWindowH}</h2>
                {v.weekZin ? <p class="st-groot">{v.weekZin}</p> : <p>{t.planWindowNone}</p>}
                <p class="st-meta">{t.planWeekUitleg}</p>
                {/* ── DE WEEK VERZETTEN, ZELF — ronde 4, 19 september 2026 ────────
                    Hier stond "antwoord op een van onze mails". Nu een keuzelijst
                    met de dag van de maand; handlePlanWeek() toetst en mailt de
                    studio. Alleen op een lopend abonnement. */}
                {v.weekVerzetbaar && (
                  <form method="post" action="/account/plan/week" class="st-week-form">
                    <label class="st-meta" for="week-dag">{t.planWeekWijzig}</label>
                    <div class="st-week-kies">
                      <span class="st-meta">{t.planWeekDag}</span>
                      <select id="week-dag" class="st-veld st-veld-kort" name="dag">
                        {v.weekDagen.map((d) => <option value={d} selected={d === v.weekDag}>{d}e</option>)}
                      </select>
                      <button class="btn btn-ghost btn-sm" type="submit">{t.planWeekVerzet}</button>
                    </div>
                  </form>
                )}
              </div>
              {v.week && <p class="st-week-dag"><span class="st-eyebrow">{t.planVisWeekStart}</span><strong>{v.week}</strong></p>}
            </div>
          </section>
          <section class="st-blok" aria-label={t.planLookStrip}>
            <div class="st-kaart-vlak st-vlak st-lookstrip">
              <div class="st-lookstrip-kop">
                <h2>{t.planLookStrip}</h2>
                <a class="st-link" href="/account/brand-kit">{t.planLookWijzig} →</a>
              </div>
              <dl class="st-feiten st-feiten-rij">
                {v.look.map((r) => <div class="st-feit"><dt>{r.label}</dt><dd>{r.waarde || <a class="st-link" href={`/account/brand-kit#bk-${r.stijl}`}>{t.planLookLeeg} →</a>}</dd></div>)}
              </dl>
            </div>
          </section>
          {v.maandset && (
            <section class="st-blok" aria-label={t.msH}>
              <div class="st-kaart-vlak st-vlak">
                <h2>{t.msH}</h2>
                <p class="st-meta">{t.msLede}</p>
                {v.maandset.nu
                  ? (
                    <Fragment>
                      <div class="st-set is-nu" id={`set-${v.maandset.nu.id}`}>
                        <div class="st-set-kop"><span class="st-set-maand">{v.maandset.nu.label}</span><span class="st-meta">{v.maandset.nu.n}</span></div>
                        {v.maandset.nu.beelden.length > 0 && <div class="st-strook">{v.maandset.nu.beelden.map((b) => <span><img src={b} alt="" loading="lazy" decoding="async" width="240" height="240" /></span>)}</div>}
                        <a class="btn btn-primary btn-sm" href={v.maandset.nu.zip}>{t.msZip}</a>
                      </div>
                      <p class="st-meta">{t.msLicence}</p>
                    </Fragment>
                  )
                  : <p class="st-meta">{t.msNone}</p>}
                {v.maandset.eerder.length > 0 && (
                  <Fragment>
                    <h3 class="st-h3">{t.msEarlier}</h3>
                    {v.maandset.eerder.map((ms) => (
                      <div class="st-set" id={`set-${ms.id}`}>
                        <div class="st-set-kop"><span class="st-set-maand">{ms.label}</span><span class="st-meta">{ms.n}</span></div>
                        {ms.beelden.length > 0 && <div class="st-strook is-klein">{ms.beelden.map((b) => <span><img src={b} alt="" loading="lazy" decoding="async" width="240" height="240" /></span>)}</div>}
                        <a class="btn btn-2nd btn-sm" href={ms.zip}>{t.msZip}</a>
                      </div>
                    ))}
                  </Fragment>
                )}
              </div>
            </section>
          )}
          <p class="st-meta st-editions-regel">{t.planEditionsRegel} <a class="st-link" href={lang === 'nl' ? '/nl/plans#editions' : '/plans#editions'}>{t.planEditionsMeer} →</a></p>
        </Fragment>
      )}

      {v.nu === 'bestellen' && !v.kalender && (
        <section class="st-blok" aria-label={t.planQueueH}>
          <div class="st-kaart-vlak st-vlak">
            <h2>{t.planQueueH}</h2>
            <p class="st-meta">{t.planQueueLede}</p>
            <p class="st-meta">{t.planQLockHint}</p>
            {v.wachtrij.length
              ? (
                <Fragment>
                  <ol class="st-lijst">
                    {v.wachtrij.map((q) => (
                      <li class={`st-q${q.vast ? ' is-vast' : ''}`}>
                        {/* De eigen foto als miniatuur, niet een merkteken (19 sep 2026). */}
                        <span class={`st-q-frame${q.fotos ? ' is-fotos' : ''}`} aria-hidden="true">{q.thumb ? <img src={q.thumb} alt="" loading="lazy" decoding="async" /> : <span class="st-frame-leeg"></span>}</span>
                        <div class="st-q-tekst">
                          <strong>{q.name}</strong>
                          {q.note && <span class="st-meta">{q.note}</span>}
                          <span class={`st-q-staat${q.fotos ? ' is-ok' : ''}`}>{q.fotosLabel}{q.soort && ` · ${q.soort}`}{q.gezicht && ` · ${q.gezicht}`}</span>
                          {/* De poort op de look (ronde 4): staat de look voor
                              deze soort nog open, dan zegt de regel het hier,
                              met de link naar precies die kaart. */}
                          {q.lookOpen.length > 0 && (
                            <span class="st-q-look-open">{t.planQLookOpenFor} {q.lookOpen.map((o, i) => <Fragment>{i > 0 && ' · '}<a class="st-link" href={o.href}>{o.label}</a></Fragment>)}</span>
                          )}
                          {!q.vast && (
                            <form method="post" action="/account/plan/queue" enctype="multipart/form-data" class="st-q-fotos">
                              <input type="hidden" name="do" value="fotos" /><input type="hidden" name="id" value={q.id} />
                              <label class="st-link st-q-fotos-label">{t.planQFotosAdd}<input class="st-q-fotos-veld" name="fotos" type="file" accept="image/*" multiple onchange="this.form.requestSubmit()" /></label>
                              <noscript><button class="btn btn-ghost btn-sm" type="submit">{t.planQFotosAdd}</button></noscript>
                            </form>
                          )}
                          {!q.vast && v.gezichten.length > 0 && (
                            <form method="post" action="/account/plan/queue" class="st-q-gezicht">
                              <input type="hidden" name="do" value="model" /><input type="hidden" name="id" value={q.id} />
                              <label class="st-meta" for={`q-gezicht-${q.id}`}>{t.planQFaceChange}</label>
                              <select id={`q-gezicht-${q.id}`} class="st-veld st-veld-kort" name="model" onchange="this.form.requestSubmit()">
                                <option value="" selected={!q.gezichtWaarde}>{t.planQFaceFollow}</option>
                                {v.gezichtGroepen.map((g) => <optgroup label={g}>{v.gezichten.filter((x) => x.groep === g).map((x) => <option value={x.value} selected={x.value === q.gezichtWaarde}>{x.label}</option>)}</optgroup>)}
                              </select>
                              <noscript><button class="btn btn-ghost btn-sm" type="submit">{t.planQFaceSave}</button></noscript>
                            </form>
                          )}
                        </div>
                        <span class={`st-q-merk${q.vast ? ' is-vast' : ''}`}>{q.merk}</span>
                        <a class={`st-q-wanneer${q.wanneerVast ? ' is-vast' : ''}`} href={q.kiesHref}>{q.wanneer}</a>
                        <div class="st-q-knoppen">
                          <form method="post" action="/account/plan/queue">
                            <input type="hidden" name="do" value={q.lockDo} /><input type="hidden" name="id" value={q.id} />
                            <button class={`btn ${q.vast ? 'btn-ghost' : 'btn-primary'} btn-sm`} type="submit" disabled={q.lockUit}>{q.lockLabel}</button>
                          </form>
                          <form method="post" action="/account/plan/queue">
                            <input type="hidden" name="do" value="up" /><input type="hidden" name="id" value={q.id} />
                            <button class="btn btn-ghost btn-sm" type="submit" disabled={q.eerste} aria-label={`${t.planQueueUp}: ${q.name}`}>↑</button>
                          </form>
                          <form method="post" action="/account/plan/queue">
                            <input type="hidden" name="do" value="down" /><input type="hidden" name="id" value={q.id} />
                            <button class="btn btn-ghost btn-sm" type="submit" disabled={q.laatste} aria-label={`${t.planQueueDown}: ${q.name}`}>↓</button>
                          </form>
                          <form method="post" action="/account/plan/queue">
                            <input type="hidden" name="do" value="remove" /><input type="hidden" name="id" value={q.id} />
                            <button class="btn btn-ghost btn-sm" type="submit">{t.planQueueRemove}</button>
                          </form>
                        </div>
                      </li>
                    ))}
                  </ol>
                  <p class="st-meta">{v.wachtrijNoot}</p>
                </Fragment>
              )
              : <p>{t.planQueueEmpty}</p>}
            {/* ── HETZELFDE PRODUCTVAK ALS HET BESTELFORMULIER, IN HET KLEIN — 19 sep 2026
                Eén los bestandsveld zei niets over welke foto wat was; het
                bestelformulier vraagt voorkant, achterkant, detail en (optioneel)
                gedragen. Hier nu dezelfde vier vakken plus "meer foto's", en de
                productsoort — dat is wat de studio nodig heeft om zonder vragen
                te kunnen maken. enctype, want zonder multipart komen de bytes
                niet mee. Geen required op de fotovelden: een product zonder foto's
                mag op de lijst; vastzetten kan pas met foto's. */}
            <form method="post" action="/account/plan/queue" class="st-formulier is-in-vlak" enctype="multipart/form-data">
              <input type="hidden" name="do" value="add" />
              <div class="st-rij">
                <div class="st-veldgroep">
                  <label for="q-name">{t.planQueueName}</label>
                  <input id="q-name" class="st-veld" name="name" type="text" maxlength="120" required data-melding={t.planQueueNameMissing} placeholder={t.planQueueNamePh} />
                </div>
                <div class="st-veldgroep">
                  <label for="q-type">{t.planQType}</label>
                  <select id="q-type" class="st-veld" name="soort">{v.soortProduct.map((o) => <option value={o.value}>{o.label}</option>)}</select>
                </div>
                {v.soortKeuze
                  ? (
                    <div class="st-veldgroep">
                      <label for="q-soort">{t.planQueueKind}</label>
                      <select id="q-soort" class="st-veld" name="kind">{v.soortKeuze.map((o) => <option value={o.value}>{o.label}</option>)}</select>
                    </div>
                  )
                  : <input type="hidden" name="kind" value={v.soortEnkel} />}
              </div>
              <div class="st-rij">
                <div class="st-veldgroep is-breed">
                  <label for="q-note">{t.planQueueNote}</label>
                  <input id="q-note" class="st-veld" name="note" type="text" maxlength="500" />
                </div>
                {v.gezichten.length > 0 && (
                  <div class="st-veldgroep">
                    <label for="q-model">{t.planQFace}</label>
                    <select id="q-model" class="st-veld" name="model">
                      <option value="">{t.planQFaceFollow}</option>
                      {v.gezichtGroepen.map((g) => <optgroup label={g}>{v.gezichten.filter((x) => x.groep === g).map((x) => <option value={x.value}>{x.label}</option>)}</optgroup>)}
                    </select>
                  </div>
                )}
              </div>
              <fieldset class="st-fotovakken">
                <legend>{t.planQueuePhotos}</legend>
                <div class="st-rij is-vakken">
                  {[['fotos_voorkant', t.planQSlotFront], ['fotos_achterkant', t.planQSlotBack], ['fotos_detail', t.planQSlotDetail], ['fotos_gedragen', t.planQSlotWorn]].map(([naam, label]) => (
                    <div class="st-veldgroep st-fotovak">
                      <label for={`q-${naam}`}>{label}</label>
                      <input id={`q-${naam}`} class="st-veld st-veld-bestand" name={naam} type="file" accept="image/*" />
                    </div>
                  ))}
                </div>
                <div class="st-rij">
                  <div class="st-veldgroep is-breed">
                    <label for="q-fotos">{t.planQSlotExtra}</label>
                    <input id="q-fotos" class="st-veld st-veld-bestand" name="fotos" type="file" accept="image/*" multiple />
                    <span class="st-hint">{t.planQSlotsHint} {t.planQueuePhotosHint}</span>
                  </div>
                </div>
              </fieldset>
              <div class="st-rij is-acties">
                <label class="st-vink"><input type="checkbox" name="meteen" value="1" /> <span>{t.planQMeteen}</span></label>
                <button class="btn btn-2nd" type="submit">{t.planQueueAdd}</button>
              </div>
              <p class="st-hint">{t.planQMeteenHint}</p>
            </form>
          </div>
        </section>
      )}

      {v.nu === 'bestellen' && v.kalender && (
        <section class="st-blok" aria-label={t.planWhenH}>
          <div class="st-kaart-vlak st-vlak">
            <p><a class="st-link" href="/account/plan?tab=bestellen">← {t.planWhenBack}</a></p>
            <h2>{t.planWhenH}</h2>
            {v.kalender.geenGewicht
              ? <p class="st-meta">{t.planWhenNoWeight}</p>
              : (
                <Fragment>
                  <p class="st-meta">{v.kalender.item.name}{v.kalender.item.note && ` — ${v.kalender.item.note}`}</p>
                  {/* Twee smaken, niet drie (19 sep 2026): in je week (de standaard,
                      dezelfde route als "asap": het venster gaat eraf), of eerder
                      met een gekozen datum. "Zo snel mogelijk" als derde verhaal
                      naast de vaste week is weg. */}
                  <form method="post" action="/account/plan/queue" class="st-kal-asap">
                    <input type="hidden" name="do" value="asap" /><input type="hidden" name="id" value={v.kalender.item.id} />
                    <button class={`btn ${v.kalender.item.vast ? 'btn-ghost' : 'btn-primary'} btn-sm`} type="submit">{t.planWhenWeek}</button>
                    <span class="st-meta">{t.planWhenWeekSub}</span>
                  </form>
                  {v.kalender.item.vast && <p>{t.planWhenSet} <strong>{v.kalender.item.start}</strong> {v.kalender.of} <strong>{v.kalender.item.end}</strong></p>}
                  <h3 class="st-h3">{t.planWhenEarlier}</h3>
                  <p class="st-meta">{t.planWhenLead} {t.planWhenFirst} <strong>{v.kalender.eerste}</strong>.</p>
                  <form method="post" action="/account/plan/queue">
                    <input type="hidden" name="do" value="plan" /><input type="hidden" name="id" value={v.kalender.item.id} />
                    <div class="st-kal">
                      {v.kalender.kopjes.map((k) => <div class="st-kal-kop">{k}</div>)}
                      {v.kalender.dagen.map((d) => d.staat === 'vrij'
                        ? <button class={`st-kal-dag is-vrij${d.vandaag ? ' is-nu' : ''}${d.mijn ? ' is-mijn' : ''}`} type="submit" name="dag" value={d.iso} aria-label={d.aria}><span class="st-kal-n">{d.nr}</span><span class="st-kal-l">{d.label}</span><span class="st-kal-vul"><i class={`is-${d.vul}`}></i></span></button>
                        : <div class={`st-kal-dag is-${d.staat}${d.vandaag ? ' is-nu' : ''}${d.mijn ? ' is-mijn' : ''}`}><span class="st-kal-n">{d.nr}</span><span class="st-kal-l">{d.label}</span><span class="st-kal-vul"><i class={`is-${d.vul}`}></i></span></div>)}
                    </div>
                  </form>
                  <p class="st-meta">{t.planWhenBefore}</p>
                  <p class="st-meta">{t.planWhenOnlyLocked}</p>
                  {v.kalender.kanNiets && <p class="st-melding is-warn">{t.planWhenNone}</p>}
                </Fragment>
              )}
          </div>
        </section>
      )}

      {v.nu === 'facturering' && (
        <Fragment>
          <section class="st-blok" aria-label={t.planBuiltH}>
            <div class="st-kaart-vlak st-vlak">
              <h2>{t.planBuiltH}</h2>
              <dl class="st-feiten">
                <div class="st-feit"><dt>{t.planBuiltDelivered}</dt><dd>{v.opgebouwd.geleverd}</dd></div>
                <div class="st-feit"><dt>{t.planBuiltImages}</dt><dd>{v.opgebouwd.beelden}</dd></div>
                {v.opgebouwd.sinds && <div class="st-feit"><dt>{t.planBuiltSince}</dt><dd>{v.opgebouwd.sinds}</dd></div>}
              </dl>
              {v.opgebouwd.opgehaald.length
                ? <ul class="st-gedaan">{v.opgebouwd.opgehaald.map((o) => <li><strong>{o.name}</strong>{o.ref && <span class="st-meta"> {o.ref}</span>}</li>)}</ul>
                : <p class="st-meta">{t.planBuiltEmpty}</p>}
            </div>
          </section>
          <section class="st-blok" aria-label={t.planBillingH}>
            <div class="st-kaart-vlak st-vlak">
              <h2>{t.planBillingH}</h2>
              <dl class="st-feiten">
                <div class="st-feit"><dt>{t.planBillingTerm}</dt><dd>{v.beheer.term}</dd></div>
                <div class="st-feit"><dt>{t.planBillingAmount}</dt><dd>{v.beheer.bedrag}</dd></div>
                <div class="st-feit"><dt>{t.planStatusLabel}</dt><dd>{v.beheer.status}</dd></div>
              </dl>
              {v.beheer.beeindigd
                ? <Fragment><p class="st-melding">{v.beheer.beeindigd}</p><p class="st-meta"><a class="st-link" href={v.beheer.plansHref}>{t.planNoneCta}</a></p></Fragment>
                : (
                  <Fragment>
                    <form method="post" action="/account/plan/pause">
                      <input type="hidden" name="do" value={v.beheer.gepauzeerd ? 'resume' : 'pause'} />
                      <button class="btn btn-ghost" type="submit">{v.beheer.gepauzeerd ? t.planResume : t.planPause}</button>
                    </form>
                    <p class="st-meta">{t.planPauseNote}</p>
                    <form method="post" action="/account/plan/cancel" class="st-rij is-mail">
                      <div class="st-veldgroep">
                        <label for="opz">{t.planCancelConfirm}</label>
                        <input id="opz" class="st-veld" name="confirm" type="text" autocomplete="off" required data-melding={t.planCancelConfirm} />
                      </div>
                      <div class="st-veldgroep is-knop"><button class="btn btn-ghost" type="submit">{t.planCancel}</button></div>
                    </form>
                    <p class="st-meta">{t.planCancelNote}</p>
                  </Fragment>
                )}
            </div>
          </section>
        </Fragment>
      )}
    </Fragment>
  )}

  {(v.geen || v.nu === 'facturering') && (
    <section class="st-blok" aria-label={v.account.h}>
      <div class="st-kaart-vlak st-vlak">
        <h2>{v.account.h}</h2>
        <dl class="st-feiten">
          <div class="st-feit"><dt>{v.account.emailLabel}</dt><dd>{v.account.email}</dd></div>
          {v.account.brand && <div class="st-feit"><dt>{v.account.brandLabel}</dt><dd>{v.account.brand}</dd></div>}
        </dl>
        <p class="st-meta">{v.account.note}</p>
      </div>
    </section>
  )}
</StudioLayout>
