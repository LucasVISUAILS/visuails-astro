---
/**
 * /account — het overzicht van Studio, als Astro-pagina. 5 september 2026.
 *
 * De eerste sectie die uit src/lib/account.js verhuist. De gegevens komen nog
 * steeds daarvandaan: studioSection() doet de paginalimiet, de sessie, de
 * cookie-omleidingen en de zes queries; overviewView() bepaalt wat er op het
 * overzicht staat (tellers, uitgelichte bestelling, strook, activiteit). Hier
 * staat alleen de vorm — in de schil van de site, zie StudioLayout.astro.
 *
 * Punt 3.01 (8 oktober 2026): bovenaan staat nu "wat nu" — de bestelling waar
 * de klant het eerst iets moet doen, met de Nu-zin, de datums en hoogstens twee
 * knoppen (watNuView() in account.js, dezelfde orderView() als Bestellingen),
 * en daaronder "En nog 1 bestelling: …". Is dat de uitgelichte bestelling, dan
 * IS de uitgelichte kaart het blok. De tellers staan er alleen nog als hun
 * getal boven 0 is (V23 = b).
 *
 * Vier blokken, in deze volgorde en met deze reden:
 *   1 · de vier tellers — elk een link naar dezelfde statusfilter op Bestellingen;
 *   2 · de nieuwste LOPENDE bestelling met haar tijdlijn, en de andere lopende
 *       eronder als compacte rij (was een <details>-klapje);
 *   3 · de laatst geleverde beelden — kijken, niet downloaden: downloaden hoort
 *       bij de bestelling, waar de context staat;
 *   4 · de vijf recentste bestellingen.
 */
import StudioLayout from '../../layouts/StudioLayout.astro';
import Bestelkaart from '../../components/studio/Bestelkaart.astro';
import Lopend from '../../components/studio/Lopend.astro';
import Pil from '../../components/studio/Pil.astro';
import { pagesContext } from '../../lib/route.js';
import { studioScreen, progressView, STUDIO_ICONS, invoiceDate, weergaveStatus } from '../../lib/account.js';
import { serviceLabel } from '../../data/services.js';

export const prerender = false;

const s = await studioScreen(pagesContext(Astro), 'overview');
if (s instanceof Response) return s;

const { st, v } = s;
const { t, lang, customer, orders, filesByOrder, eventsByOrder, thema, navDicht } = st;
/* Punt 3.01: het "wat nu"-blok. `samen` = de bestelling bovenaan is de uitgelichte. */
const w = v.watNu;
const samen = !!(w && w.boven && v.featured && w.boven.id === v.featured.id);
/* Staat er een andere bestelling bovenaan, dan niet nog eens in de rij eronder. */
const restZonderBoven = v.rest.filter((o) => !(w && w.boven && o.id === w.boven.id));
---
<StudioLayout
  lang={lang} t={t} thema={thema} navDicht={navDicht} actief="overview" customer={customer}
  title={t.navOverview}
  kop={`${orders.length > 1 ? t.ovWelcome : t.ovWelcomeFirst}, ${v.name}`} lede={t.ovLede} chip={v.chip}
  actie={v.actie}
>
  {/* ── "WAT NU" (punt 3.01) ── */}
  {w && w.boven && (
    <section class="st-blok st-watnu-blok" aria-label={samen ? t.ovNowTitle : t.ovNuTeDoen}>
      <div class="st-blok-kop"><h2>{samen ? t.ovNowTitle : t.ovNuTeDoen}</h2></div>
      <Bestelkaart t={t} lang={lang} order={w.boven} events={eventsByOrder.get(w.boven.id) || []} files={filesByOrder.get(w.boven.id) || []} nu={w.nu} />
      {w.nogMeer.length > 0 && (
        <div class="st-kaart-vlak st-nogmeer">
          <p class="st-nogmeer-kop">{w.nogMeerKop}</p>
          <ul class="st-lopend">
            {w.nogMeer.map((n) => (
              <li>
                <span class="st-ref">{n.ref}</span>
                <span class="st-meta">{n.zin}</span>
                <a class="st-link" href={n.href}>{t.ovOpenOrder}</a>
              </li>
            ))}
          </ul>
        </div>
      )}
      {samen && v.rest.length > 0 && <Lopend t={t} lang={lang} orders={v.rest} nuPerOrder={w.nuPerOrder} eventsByOrder={eventsByOrder} filesByOrder={filesByOrder} />}
    </section>
  )}

  {/* ── JE SALDO (punt 2.02, 8 oktober 2026) ─────────────────────────────
      Onder de Nu-zin: tegoed met € en het woord "tegoed", credits als getal
      zonder € met de vertaling in producten. Elk vak alleen als het bestaat.
      Vervangt de losse tegoedtegel van 24 september. */}
  {v.saldoStrook && (
    <section class="st-blok" aria-labelledby="saldo-strook-h">
      <div class="st-blok-kop"><h2 id="saldo-strook-h">{v.saldoStrook.kop}</h2></div>
      <div class={`st-saldostrook${v.saldoStrook.tegoed && v.saldoStrook.credits ? ' is-twee' : ''}`}>
        {v.saldoStrook.tegoed && (
          <div class="st-kaart-vlak st-vlak st-saldovak is-tegoed" data-saldo="tegoed">
            <p class="st-saldovak-getal">{v.saldoStrook.tegoed.getal}</p>
            <p class="st-meta">{v.saldoStrook.tegoed.uitleg}</p>
            <a class="st-link" href={v.saldoStrook.tegoed.link.href}>{v.saldoStrook.tegoed.link.label} →</a>
          </div>
        )}
        {v.saldoStrook.credits && (
          <div class="st-kaart-vlak st-vlak st-saldovak is-credits" data-saldo="credits">
            <p class="st-saldovak-getal">{v.saldoStrook.credits.getal}</p>
            <p class="st-meta">{v.saldoStrook.credits.uitleg}</p>
            <a class="st-link" href={v.saldoStrook.credits.link.href}>{v.saldoStrook.credits.link.label} →</a>
          </div>
        )}
      </div>
    </section>
  )}

  {v.stats.length > 0 && (
  <section class="st-blok" aria-label={t.navOverview}>
    <div class="st-kaart-vlak st-cijfers">
      {v.stats.map(([icon, label, n, status]) => {
        const href = n ? `/account/orders${status ? `?status=${encodeURIComponent(status)}` : ''}` : '';
        const inner = (
          <Fragment>
            <Fragment set:html={icon} />
            <span class="st-cijfer-label">{label}</span>
            <span class={`st-cijfer-n${n ? '' : ' is-nul'}`}>{n}</span>
          </Fragment>
        );
        return href ? <a class="st-cijfer" href={href}>{inner}</a> : <div class="st-cijfer">{inner}</div>;
      })}
    </div>
  </section>
  )}


  {v.featured && !samen && (
    <section class="st-blok">
      <div class="st-blok-kop"><h2>{t.ovNowTitle}</h2></div>
      <Bestelkaart t={t} lang={lang} order={v.featured} events={eventsByOrder.get(v.featured.id) || []} files={filesByOrder.get(v.featured.id) || []} nu={w ? w.nuPerOrder.get(v.featured.id) : null} />
      {restZonderBoven.length > 0 && <Lopend t={t} lang={lang} orders={restZonderBoven} nuPerOrder={w ? w.nuPerOrder : null} eventsByOrder={eventsByOrder} filesByOrder={filesByOrder} />}
    </section>
  )}

  <section class="st-blok">
    <div class="st-blok-kop">
      <h2>{t.ovLatest}</h2>
      {orders.length > 0 && <a class="st-link" href="/account/orders">{t.ovViewAll}</a>}
    </div>
    {v.latest.length > 0 ? (
      <ul class="st-strook">
        {v.latest.map(({ f, o }) => (
          <li>
            <a href={`/account/orders?order=${o.id}#order-${o.id}`} title={o.ref}>
              <img src={`/account/files/${f.id}/f`} alt={o.ref} loading="lazy" decoding="async">
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <p class="st-leeg">{t.ovLatestEmpty}</p>
    )}
  </section>

  {/* Leeg omdat alles al bovenaan staat? Dan geen blok (29 september 2026). */}
  {(v.recent.length > 0 || orders.length === 0) && (
  <section class="st-blok">
    <div class="st-blok-kop">
      <h2>{t.ovRecent}</h2>
      {orders.length > 0 && <a class="st-link" href="/account/orders">{t.ovViewAll}</a>}
    </div>
    {v.recent.length > 0 ? (
      <div class="st-kaart-vlak">
        <ul class="st-activiteit">
          {v.recent.map((o) => (
            <li>
              <a href={`/account/orders?order=${o.id}#order-${o.id}`}>
                <span class="st-ref">{o.ref}</span>
                <span class="st-meta">{serviceLabel(o.service, lang) || o.service}{o.created_at ? ` · ${invoiceDate(String(o.created_at).slice(0, 10), lang)}` : ''}</span>
              </a>
              <Pil status={weergaveStatus(o)} lang={lang} />
            </li>
          ))}
        </ul>
      </div>
    ) : (
      <p class="st-leeg">{t.emptyOrders}</p>
    )}
  </section>
  )}
</StudioLayout>
