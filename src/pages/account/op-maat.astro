            <div class="om-upload">
              <label class="btn btn-2nd om-plus" data-rol="uploaden"><input type="file" accept="image/jpeg,image/png,image/webp,image/heic,video/mp4,video/quicktime" id="om-bestand" class="om-verborgen" data-max-mb={refMb} data-max-n={REF_MAX}>{L('+ Een referentie toevoegen', '+ Add a reference')}</label>
              <div class="om-pillen" role="group" aria-label={L('Waar let je op?', 'What matters?')}>{REF_WAT.map((w) => <label class="om-pil"><input type="checkbox" value={w} name="ref-wat"><span>{w === 'product' ? L('Het product', 'The product') : n(w)}</span></label>)}</div>
            </div>
            <label class="om-veld"><span>{L('Wat wil je nooit zien?', 'What do you never want to see?')}</span><textarea rows="2" maxlength="800" data-pad="nooit" placeholder={L('Glimmende huid, een model dat in de camera lacht', 'Shiny skin, a model smiling into the camera')}>{tekst('nooit')}</textarea></label>
            <details class="om-buiten">
              <summary>{L('Buiten de lijntjes: vier vragen, als je zin hebt', 'Outside the lines: four questions, if you like')}</summary>
              {BUITEN_VRAGEN[nl ? 'nl' : 'en'].map((q) => <label class="om-veld"><span>{q.vraag}</span><input type="text" maxlength="600" data-pad={`buiten.${q.id}`} value={tekst(`buiten.${q.id}`)} placeholder={q.voorbeeld}></label>)}
            </details>
          </section>

          <section class="om-blok" id="om-praktisch">
            <p class="om-label">{L('Praktisch', 'Practical')}</p>
            <h2 class="om-h2">{L('Waar komen de beelden, en hoe bereiken we je?', 'Where will the images go, and how do we reach you?')}</h2>
            <div class="om-pillen" role="group" aria-label={L('Waar komen ze?', 'Where will they go?')}>{KANALEN.map((k) => <label class="om-pil"><input type="checkbox" value={k} data-pad="praktisch.kanalen" data-veel checked={((inh.praktisch && inh.praktisch.kanalen) || []).includes(k)}><span>{n(k)}</span></label>)}</div>
            <div class="om-rij">
              <label class="om-veld"><span>{L('Wanneer heb je ze nodig?', 'When do you need them?')}</span><input type="text" maxlength="120" data-pad="praktisch.wanneer" value={tekst('praktisch.wanneer')} placeholder={L('Voor de lancering op 1 december', 'Before the launch on 1 December')}></label>
              <div class="om-veld"><span>{L('Hoe bereiken we je?', 'How do we reach you?')}</span><div class="om-pillen" role="radiogroup" aria-label={L('Contact', 'Contact')}>{CONTACT.map((c) => <label class="om-pil"><input type="radio" name="contact" value={c} data-pad="praktisch.contact" checked={inh.praktisch && inh.praktisch.contact === c}><span>{n(c)}</span></label>)}</div></div>
            </div>
          </section>
        </fieldset>
      </form>

      {/* levering 119 (18 november 2026, besluit Lucas na P5-16): bij video (op aanvraag) geen bedrag: het paneel heet
          "Je keuzes", toont de keuzes zonder prijs (public/js/op-maat.js) en zegt "Prijs: op aanvraag". */}
      <aside class="om-schat" aria-live="polite" aria-label={videoOpAanvraag ? L('Je keuzes', 'Your choices') : L('Schatting', 'Estimate')}>
        <p class="om-schat-kop"><span>{videoOpAanvraag ? L('Je keuzes', 'Your choices') : L('Schatting', 'Estimate')}</span><span class="om-opgeslagen" id="om-stand"></span></p>
        <div class="om-regels" id="om-regels"><p class="om-leeg">{videoOpAanvraag ? L('Kies iets, dan staat het hier.', 'Choose something and it shows up here.') : L('Kies iets, dan rekent het mee.', 'Choose something and it adds up.')}</p></div>
        <p class="om-tot"><span>{videoOpAanvraag ? L('Prijs', 'Price') : L('Ongeveer', 'About')}</span><b id="om-totaal">{videoOpAanvraag ? videoPrijsLabel(taal) : '€ –'}</b></p>
        <p class="om-klein" id="om-aanbet">{videoOpAanvraag ? L('Je krijgt een offerte op maat, met de prijs erin.', 'You get a quote made for you, with the price in it.') : ''}</p>
        <p class="om-klein">{videoOpAanvraag ? L('Eerst krijg je een gratis voorbeeld, daarna heb je twee gratis rondes om bij te sturen.', 'First you get a free preview, then two free rounds to adjust.') : L('Excl. btw. De definitieve prijs volgt als wij je stijl hebben uitgedacht. Eerst krijg je een gratis voorbeeld, daarna heb je twee gratis rondes om bij te sturen.', 'Excl. VAT. The final price follows once we have worked out your style. First you get a free preview, then two free rounds to adjust.')}</p>
        <ul class="om-mist" id="om-mist" hidden></ul>
        {bewerkbaar && <button type="button" class="btn btn-primary om-verstuur" data-rol="doorgaan" id="om-verstuur">{L('Verstuur mijn aanvraag', 'Send my request')}</button>}
        {bewerkbaar && <p class="om-klein">{L('Versturen kost niets.', 'Sending costs nothing.')}</p>}
      </aside>
    </div>
  )}
</StudioLayout>
