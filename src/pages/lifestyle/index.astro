---
// VISUAILS — Lifestyle hub. Ported from the SvelteKit v2 site's
// /lifestyle +page.svelte. `styles` data ported verbatim from
// $lib/data/styles.js (only the fields this page uses: slug, name,
// cardPhoto, tagline).
import Layout from '../../layouts/Layout.astro';

const styles = [
  { slug: 'dunes', name: 'Dunes', cardPhoto: '/img/lifestyle-dunes-01.webp', tagline: 'Sun, sand and quiet luxury.' },
  { slug: 'flash', name: 'Flash', cardPhoto: '/img/lifestyle-flash-02.webp', tagline: 'Direct flash. No apologies.' },
  { slug: 'glow', name: 'Glow', cardPhoto: '/img/lifestyle-glow-01.webp', tagline: 'Golden hour, on demand.' },
  { slug: 'phone-made', name: 'Phone-made', cardPhoto: '/img/lifestyle-phone-made-11.webp', tagline: "Looks effortless. Isn't." },
];

const marqueeItems = [
  { src: '/img/lifestyle-phone-made-06.webp', label: 'Phone-made' },
  { src: '/img/lifestyle-glow-03.webp', label: 'Glow' },
  { src: '/img/lifestyle-flash-05.webp', label: 'Flash' },
  { src: '/img/lifestyle-dunes-02.webp', label: 'Dunes' },
  { src: '/img/banners-02.webp', label: 'Campaign' },
];
---

<Layout
  title="Lifestyle Images — your product in scenes that sell | VISUAILS"
  description="Real, styled lifestyle scenes with natural lighting — and optional consistent models. High-res, e-commerce ready and human-reviewed, delivered in ~24 hours. From €35 per visual."
>
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow-page">Lifestyle Images</span>
      <h1 class="display" style="font-size:clamp(2.4rem,5vw,4rem);margin-top:1rem">Your product, in scenes that sell</h1>
      <p class="lead" style="margin-top:1.2rem">Four signature styles. From €35 per visual.</p>
      <div class="flex" style="margin-top:1.8rem">
        <span class="magnet-wrap"><span class="magnet-inner"><a href="/order-lifestyle" class="btn btn-primary btn-lg">Order lifestyle visuals</a></span></span>
        <a href="/pricing" class="btn btn-ghost btn-lg">See pricing</a>
        <a href="https://wa.me/31625436130?text=Hi%20VISUAILS%2C%20I%27d%20like%20to%20order%20lifestyle%20visuals%20for%20my%20products." class="btn btn-wa" target="_blank" rel="noopener">
          <svg class="i" viewBox="0 0 24 24"><path d="M21 11.5a8.38 8.38 0 0 1-8.5 8.5 8.5 8.5 0 0 1-4-1L3 20l1.5-4.5A8.38 8.38 0 0 1 3.5 11 8.5 8.5 0 0 1 12 3a8.38 8.38 0 0 1 8.5 8.5z"/></svg>WhatsApp <span class="rec-badge">Fastest</span>
        </a>
      </div>
      <div class="trust-row" style="margin-top:2.4rem">
        <span class="trust-item"><strong>From €35</strong> per visual</span>
        <span class="trust-item"><strong>~24h</strong> delivery</span>
        <span class="trust-item"><strong>100%</strong> human-reviewed</span>
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <h2 style="margin-bottom:2rem">Four moods. Pick yours.</h2>
      <div class="grid grid-2 reveal-group">
        {styles.map((s) => (
          <a href={`/lifestyle/${s.slug}`} class="reveal pending" style="display:block">
            <div class="photo-band tall">
              <img src={s.cardPhoto} alt={`${s.name} lifestyle example`} loading="lazy" />
              <div class="scrim"></div>
              <div class="caption">
                <h3 style="color:#fff;font-size:1.6rem"><em>{s.name}</em> &rarr;</h3>
                <p style="font-size:.92rem">{s.tagline} &middot; €35 / visual</p>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <div class="photo-split reveal pending">
        <div class="photo-split-media">
          <img src="/img/model-02.webp" alt="A VISUAILS model, styled consistently across a campaign" loading="lazy" />
        </div>
        <div>
          <h2>Add a consistent <em>model.</em></h2>
          <p class="lead" style="margin-top:1rem">Same face, across your whole collection — or let us choose one that fits.</p>
          <div class="flex" style="margin-top:1.4rem"><a href="/models" class="btn btn-primary">Explore models</a></div>
        </div>
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <div class="section-head" style="text-align:center;margin-inline:auto">
        <h2>Four moods. Four transformations.</h2>
        <p style="margin-inline:auto">Drag each one to compare — the same product, treated flat vs. treated like a VISUAILS style.</p>
      </div>
      <div class="compare-grid reveal-group" style="margin-top:2.2rem">
        {[
          { name: 'Dunes', before: '/img/lifestyle-dunes-02.webp', after: '/img/lifestyle-dunes-01.webp' },
          { name: 'Flash', before: '/img/lifestyle-flash-03.webp', after: '/img/lifestyle-flash-06.webp' },
          { name: 'Glow', before: '/img/lifestyle-glow-04.webp', after: '/img/lifestyle-glow-01.webp' },
          { name: 'Phone-made', before: '/img/lifestyle-phone-made-08.webp', after: '/img/lifestyle-phone-made-11.webp' },
        ].map((c) => (
          <div class="reveal pending">
            <div class="reveal-clip-wrap"><div class="reveal-clip-inner">
              <div class="ba" aria-label={`Before and after: a flat product photo styled into the ${c.name} lifestyle look`}>
                <div class="ba-layer ba-before-scene" aria-hidden="true"><img src={c.before} alt={`Flat, unstyled version of a ${c.name} scene`} /></div>
                <div class="ba-layer ba-after" aria-hidden="true"><img src={c.after} alt={`The same scene styled in the ${c.name} lifestyle look`} /></div>
                <span class="ba-tag tag-before">Before</span><span class="ba-tag tag-after">After</span>
                <div class="ba-handle" aria-hidden="true"></div>
                <div class="ba-knob" aria-hidden="true"><svg class="i" viewBox="0 0 24 24" style="width:18px;height:18px"><path d="M8 7l-4 5 4 5M16 7l4 5-4 5"/></svg></div>
              </div>
            </div></div>
            <p class="cc-label"><strong>{c.name}</strong> &middot; €35 / visual</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <div class="section-head" style="margin-bottom:1.8rem">
        <h2>The range, in motion</h2>
        <p><a href="/gallery" class="link-arrow" style="font-size:1rem">See the full gallery <svg viewBox="0 0 24 24" class="i"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a></p>
      </div>
    </div>
    <div class="marquee"><div class="marquee-track">
      {marqueeItems.map((m) => (
        <div class="marquee-item">
          <img src={m.src} alt={`${m.label} lifestyle example`} loading="lazy" style="width:100%;height:100%;object-fit:cover" />
        </div>
      ))}
    </div></div>
  </section>

  <section class="section-tight">
    <div class="container">
      <div class="cta-band reveal pending">
        <h2 class="display" style="font-size:clamp(2.2rem,5vw,3.6rem)">Put your product<br>in a scene that sells.</h2>
        <div class="flex" style="justify-content:center;margin-top:2rem">
          <span class="magnet-wrap"><span class="magnet-inner"><a href="/order-lifestyle" class="btn btn-primary btn-lg">Order lifestyle visuals</a></span></span>
          <a href="/models" class="btn btn-ghost btn-lg">Explore models</a>
          <a href="https://wa.me/31625436130?text=Hi%20VISUAILS%2C%20I%27d%20like%20to%20talk%20about%20lifestyle%20visuals%20for%20my%20brand." class="btn btn-wa" target="_blank" rel="noopener">
            <svg class="i" viewBox="0 0 24 24"><path d="M21 11.5a8.38 8.38 0 0 1-8.5 8.5 8.5 8.5 0 0 1-4-1L3 20l1.5-4.5A8.38 8.38 0 0 1 3.5 11 8.5 8.5 0 0 1 12 3a8.38 8.38 0 0 1 8.5 8.5z"/></svg>WhatsApp
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
