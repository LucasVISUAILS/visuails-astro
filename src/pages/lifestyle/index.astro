---
// VISUAILS — Lifestyle hub. Ported from the SvelteKit v2 site's
// /lifestyle +page.svelte. `styles` data ported verbatim from
// $lib/data/styles.js (only the fields this page uses: slug, name,
// cardPhoto, tagline).
import Layout from '../../layouts/Layout.astro';
import Compare from '../../components/Compare.astro';

const styles = [
  { slug: 'dunes', name: 'Dunes', cardPhoto: '/img/lifestyle-dunes-01.webp', tagline: 'Sun, sand and quiet luxury.', price: '€59.99 / product' },
  { slug: 'flash', name: 'Flash', cardPhoto: '/img/lifestyle-flash-02.webp', tagline: 'Direct flash. No apologies.', price: '€59.99 / product' },
  { slug: 'glow', name: 'Glow', cardPhoto: '/img/lifestyle-glow-01.webp', tagline: 'Golden hour, on demand.', price: '€59.99 / product' },
  { slug: 'phone-made', name: 'Phone-made', cardPhoto: '/img/lifestyle-phone-made-11.webp', tagline: "Looks effortless. Isn't.", price: '€59.99 / product' },
  { slug: 'custom', name: 'Custom', cardPhoto: '/img/banners-13.webp', tagline: 'Your own world.', price: 'On request' },
];

const marqueeItems = [
  { src: '/img/lifestyle-phone-made-06.webp', label: 'Phone-made' },
  { src: '/img/lifestyle-glow-03.webp', label: 'Glow' },
  { src: '/img/lifestyle-flash-05.webp', label: 'Flash' },
  { src: '/img/lifestyle-dunes-02.webp', label: 'Dunes' },
  { src: '/img/banners-02.webp', label: 'Campaign' },
];
---

<Layout
  title="Lifestyle Images — your product in scenes that sell | VISUAILS"
  description="Real, styled lifestyle scenes with natural lighting — and optional consistent models. High-res, e-commerce ready and human-reviewed, delivered in ~24 hours. €59.99 per product — a ready-to-post carousel of three photos."
  ogImage="/img/lifestyle-glow-01.webp"
>
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow-page">Lifestyle Images</span>
      <h1 class="display" style="font-size:clamp(2.4rem,5vw,4rem);margin-top:1rem">Your product, in scenes that sell</h1>
      <p class="lead" style="margin-top:1.2rem">Four signature looks. €59.99 per product — a 3-photo carousel.</p>
      <div class="flex" style="margin-top:1.8rem">
        <span class="magnet-wrap"><span class="magnet-inner"><a href="/order-lifestyle" class="btn btn-primary btn-lg">Order lifestyle visuals</a></span></span>
        <a href="/pricing" class="btn btn-ghost btn-lg">See pricing</a>
        <a href="https://wa.me/31625436130?text=Hi%20VISUAILS%2C%20I%27d%20like%20to%20order%20lifestyle%20visuals%20for%20my%20products." class="btn btn-wa" target="_blank" rel="noopener">
          <svg class="i" viewBox="0 0 24 24"><path d="M21 11.5a8.38 8.38 0 0 1-8.5 8.5 8.5 8.5 0 0 1-4-1L3 20l1.5-4.5A8.38 8.38 0 0 1 3.5 11 8.5 8.5 0 0 1 12 3a8.38 8.38 0 0 1 8.5 8.5z"/></svg>WhatsApp <span class="rec-badge">Fastest</span>
        </a>
      </div>
      <div class="trust-row" style="margin-top:2.4rem">
        <span class="trust-item"><strong>€59.99</strong> per product</span>
        <span class="trust-item"><strong>~24h</strong> delivery</span>
        <span class="trust-item"><strong>100%</strong> human-reviewed</span>
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <div class="section-head"><h2>One product. Three photos. <em>A carousel.</em></h2><p>Every Lifestyle order is your product in one styled look, delivered as three shots that belong together — ready to post as a carousel on Instagram, your shop and ads.</p></div>
      <div class="grid grid-3 reveal-group">
        <div class="card reveal pending"><span class="rc-num">01</span><h4>The scene</h4><p>Your product styled in a real-world setting — the atmosphere shot that stops the scroll.</p></div>
        <div class="card reveal pending"><span class="rc-num">02</span><h4>On-model</h4><p>The same product worn or held, so people can picture it in their own life.</p></div>
        <div class="card reveal pending"><span class="rc-num">03</span><h4>Logo close-up</h4><p>A tight detail shot — same vibe, same colour grade — that proves the quality.</p></div>
      </div>
      <p style="margin-top:1.4rem;font-size:.85rem;color:var(--ink-3)">One styled look per order · same colour grading · a different scene is a separate order.</p>
    </div>
  </section>

  <section>
    <div class="container">
      <h2 style="margin-bottom:2rem">Four moods — or <em>your own.</em></h2>
      <div class="grid grid-2 reveal-group">
        {styles.map((s) => (
          <a href={`/lifestyle/${s.slug}`} class="reveal pending" style="display:block">
            <div class="photo-band tall">
              <img src={s.cardPhoto} alt={`${s.name} lifestyle example`} loading="lazy" />
              <div class="scrim"></div>
              <div class="caption">
                <h3 style="color:#fff;font-size:1.6rem"><em>{s.name}</em> &rarr;</h3>
                <p style="font-size:.92rem">{s.tagline} &middot; {s.price}</p>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <div class="ed-head">
        <span class="ed-meta">( Where it fits )</span>
        <div>
          <h2>Lifestyle photography: desire, in context.</h2>
          <p class="ed-sub">The scenes that create want, not just clarity.</p>
        </div>
      </div>
      <div class="svc-explain">
        <div class="svc-explain-main">
          <h3>What it is</h3>
          <p>Where catalog shows the product plainly, lifestyle photography puts it in a world — styled, lit and shot as a scene someone wants to step into. A VISUAILS lifestyle order is three photos of one product in a single look: a scene shot, an on-model shot and a detail close-up, all matched in grade, so they read as one story and post straight to a feed as a carousel.</p>
          <p>This is the imagery that does the emotional work. It doesn't just say what the product is; it shows people who they'd be with it. That's why it belongs where people scroll for inspiration rather than specs — and why it's often the difference between a listing that gets browsed and a brand that gets followed.</p>
        </div>
        <aside class="svc-explain-side">
          <h3>Where it lives</h3>
          <ul class="svc-where-list">
            <li><strong>Instagram &amp; TikTok</strong> — feed posts, carousels and Reels covers.</li>
            <li><strong>Paid ads</strong> — creative built to stop the scroll.</li>
            <li><strong>Your homepage</strong> — hero and lookbook moments.</li>
            <li><strong>Email &amp; campaigns</strong> — seasonal drops and newsletters.</li>
          </ul>
        </aside>
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <div class="photo-split reveal pending">
        <div class="photo-split-media">
          <img src="/img/model-02.webp" alt="A VISUAILS model, styled consistently across a campaign" loading="lazy" />
        </div>
        <div>
          <h2>Add a consistent <em>model.</em></h2>
          <p class="lead" style="margin-top:1rem">Same face, across your whole collection — or let us choose one that fits.</p>
          <div class="flex" style="margin-top:1.4rem"><a href="/models" class="btn btn-primary">Explore models</a></div>
        </div>
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <div class="section-head" style="text-align:center;margin-inline:auto">
        <h2>Four moods. Four transformations.</h2>
        <p style="margin-inline:auto">The same shot, flat vs. finished in each VISUAILS style.</p>
      </div>
      <div class="compare-grid reveal-group" style="margin-top:2.2rem">
        {[
          { name: 'Dunes', photo: '/img/lifestyle-dunes-01.webp' },
          { name: 'Flash', photo: '/img/lifestyle-flash-01.webp' },
          { name: 'Glow', photo: '/img/lifestyle-glow-01.webp' },
          { name: 'Phone-made', photo: '/img/lifestyle-phone-made-01.webp' },
        ].map((c) => (
          <div class="reveal pending">
            <Compare grade before={c.photo} after={c.photo} beforeAlt={`A flat, ungraded ${c.name} scene`} afterAlt={`The same scene finished in the ${c.name} lifestyle look`} beforeLabel="Flat" afterLabel={c.name} />
            <p class="cc-label"><strong>{c.name}</strong> &middot; €59.99 / product</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <div class="section-head" style="margin-bottom:1.8rem">
        <h2>The range, in motion</h2>
        <p><a href="/gallery" class="link-arrow" style="font-size:1rem">See the full gallery <svg viewBox="0 0 24 24" class="i"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a></p>
      </div>
    </div>
    <div class="marquee"><div class="marquee-track">
      {marqueeItems.map((m) => (
        <div class="marquee-item">
          <img src={m.src} alt={`${m.label} lifestyle example`} loading="lazy" style="width:100%;height:100%;object-fit:cover" />
        </div>
      ))}
    </div></div>
  </section>

  <section class="section-tight">
    <div class="container">
      <div class="cta-band reveal pending">
        <h2 class="display" style="font-size:clamp(2.2rem,5vw,3.6rem)">Put your product<br>in a scene that sells.</h2>
        <div class="flex" style="justify-content:center;margin-top:2rem">
          <span class="magnet-wrap"><span class="magnet-inner"><a href="/order-lifestyle" class="btn btn-primary btn-lg">Order lifestyle visuals</a></span></span>
          <a href="/models" class="btn btn-ghost btn-lg">Explore models</a>
          <a href="https://wa.me/31625436130?text=Hi%20VISUAILS%2C%20I%27d%20like%20to%20talk%20about%20lifestyle%20visuals%20for%20my%20brand." class="btn btn-wa" target="_blank" rel="noopener">
            <svg class="i" viewBox="0 0 24 24"><path d="M21 11.5a8.38 8.38 0 0 1-8.5 8.5 8.5 8.5 0 0 1-4-1L3 20l1.5-4.5A8.38 8.38 0 0 1 3.5 11 8.5 8.5 0 0 1 12 3a8.38 8.38 0 0 1 8.5 8.5z"/></svg>WhatsApp
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
