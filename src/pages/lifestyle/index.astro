---
// VISUAILS — /lifestyle (English). The page body lives in LifestylePage.astro
// so that /lifestyle and /nl/lifestyle cannot drift apart; only the meta
// differs here.
//
// This file used to be a 183-line inline page holding its own five-entry copy
// of src/data/styles.js — with the price typed by hand onto four of the five
// entries. The moods now come from the shared module and no euro figure enters
// the style data at all.
//
// The old description was 219 characters (the site's second worst) and named a
// delivery time. It is built from pricing.js now.
import Layout from '../../layouts/Layout.astro';
import LifestylePage from '../../components/LifestylePage.astro';
import { perProduct, turnaround } from '../../data/pricing.js';

const item = perProduct('lifestyle', 'en');

const description =
  `Three photos of one product in one styled look — a carousel ready to post. ` +
  `${item.price} per product. ${turnaround('unattended', 'en')}.`;
---

<Layout
  title="Lifestyle Images — your product in scenes that sell | VISUAILS"
  description={description}
  ogImage="/img/lifestyle-glow-01.webp"
>
  <LifestylePage lang="en" />
</Layout>
