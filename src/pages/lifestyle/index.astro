---
// VISUAILS — /lifestyle (English). The page body lives in LifestylePage.astro
// so that /lifestyle and /nl/lifestyle cannot drift apart; only the meta
// differs here.
//
// This file used to be a 183-line inline page holding its own five-entry copy
// of src/data/styles.js — with the price typed by hand onto four of the five
// entries. The moods now come from the shared module and no euro figure enters
// the style data at all.
//
// The old description was 219 characters (the site's second worst) and named a
// delivery time. It is built from pricing.js now.
//
// It quoted one rate until August 2026. A lifestyle carousel is priced on a
// ladder now (section 0 of src/data/pricing.js), so both ends are named and
// the turnaround gives way instead — it is a tier fact, restated in the trust
// row, and only true under WINDOW_THRESHOLD products.
import Layout from '../../layouts/Layout.astro';
// 12 oktober 2026 (afvinklijst 8, alles "doen"): deze pagina staat in de hal (huid="hal");
// de vorige opmaak staat op _opruimen/LIJST.txt.
import LifestyleHal from '../../components/LifestyleHal.astro';
import { euro, ladderRate, ladderFloor, LADDER, vatLabel } from '../../data/pricing.js';

const FLOOR_FROM = LADDER.lifestyle[LADDER.lifestyle.length - 1][0];

const description =
  `Four photos of one product in one styled look — a carousel ready to post. ` +
  `${euro(ladderRate('lifestyle', 1), 'en')} a product, ` +
  `${euro(ladderFloor('lifestyle'), 'en')} from ${FLOOR_FROM} up, ` +
  `${vatLabel('excl', 'en')}.`;
---

<Layout huid="hal"
  title="Lifestyle photos that sell the product | VISUAILS"
  description={description}
  ogImage="/img/lifestyle-phone-made-06.webp"
>
  <LifestyleHal lang="en" />
</Layout>
