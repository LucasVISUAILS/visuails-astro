---
// VISUAILS — shared template for the lifestyle style detail pages
// (Dunes / Flash / Glow / Phone-made). Ported from the SvelteKit rebuild's
// StylePage.svelte, driven by `style` entries from src/data/styles.js
// (shared with the /lifestyle hub, written separately). `style.heroPhoto` /
// `style.grid[0].photo` / `style.grid[].photo` already point at real,
// style-correct photos per IMAGES.md — used directly; the ProductScene SVG
// placeholder is only the fallback for grid slots with no matching photo
// (same behavior as the original ProductScene.svelte's `photo` escape
// hatch, replicated here with a plain `.vis` div since ProductScene.astro
// only supports the icon-driven placeholder).
import Layout from '../../layouts/Layout.astro';
import ProductScene from '../../components/ProductScene.astro';
import Compare from '../../components/Compare.astro';
import { styles } from '../../data/styles.js';
import { perProduct, reviewClaim, turnaround, TIERS } from '../../data/pricing.js';
import { metaDescription } from '../../data/meta.js';

export function getStaticPaths() {
  return styles.map((s) => ({ params: { slug: s.slug }, props: { style: s } }));
}

const { style } = Astro.props;

// Timing, review level and queue behaviour are tier facts, not per-style
// copy. They come from pricing.js so a capacity change cannot leave a
// promise stranded on a detail page — which is exactly what "~24h delivery"
// and "Produced in about 24 hours" were doing here.
const TIMING = turnaround('unattended', 'en');
const REVIEW = reviewClaim('unattended', 'en');
const QUEUE = TIERS.unattended.queue.en;

// Four of the five lifestyle styles carry no priceTrust of their own, so the
// fallback below is what actually renders on most of these pages — it used to
// be the string '€59.99', typed twice. Custom is quoted, so it keeps its own.
const item = perProduct('lifestyle', 'en');
const priceLine = style.priceTrust ? `${style.priceTrust}${style.priceUnit ?? ''}` : `${item.price} / product`;

// The description used to be one template literal, so its length was whatever
// the data happened to make it. metaDescription drops the trailing tier
// clauses instead of running past 160 — see src/data/meta.js.
---

<Layout
  title={`${style.name} — Lifestyle style | VISUAILS`}
  description={metaDescription([
    `${style.name}: a signature VISUAILS lifestyle style`,
    priceLine,
    TIMING,
    REVIEW,
  ])}
>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow-page"><a href="/lifestyle" style="color:inherit">&larr; Lifestyle styles</a></p>
      <h1 class="display">{style.name}.</h1>
      <p style="margin-top:1rem;font-family:var(--font-display);font-size:clamp(1.35rem,2.3vw,1.9rem);color:var(--ink);max-width:34ch;line-height:1.25">{style.tagline}</p>
      <div class="flex" style="margin-top:1.8rem">
        <span class="magnet-wrap"><span class="magnet-inner"><a href={style.orderHref ?? '/start'} class="btn btn-primary btn-lg">{style.orderLabel ?? `Order ${style.name}`}</a></span></span>
        <a href={`https://wa.me/31625436130?text=Hi%20VISUAILS%2C%20I%27d%20like%20to%20talk%20about%20the%20${style.name}%20style.`} class="btn btn-wa" target="_blank" rel="noopener">
          <svg class="i" viewBox="0 0 24 24"><path d="M21 11.5a8.38 8.38 0 0 1-8.5 8.5 8.5 8.5 0 0 1-4-1L3 20l1.5-4.5A8.38 8.38 0 0 1 3.5 11 8.5 8.5 0 0 1 12 3a8.38 8.38 0 0 1 8.5 8.5z"/></svg>
          WhatsApp
        </a>
      </div>
      <div class="trust-row" style="margin-top:2rem">
        <span class="trust-item"><strong>{style.priceTrust ?? item.price}</strong>{style.priceUnit ?? ' / product'}</span>
        <span class="trust-item"><strong>{TIMING}</strong></span>
        <span class="trust-item"><strong>{REVIEW}</strong></span>
      </div>
      <p class="queue-note">{QUEUE}</p>
    </div>
  </section>

  <!-- Media band — mask reveal on the signature photo -->
  <section class="section-tight">
    <div class="container">
      <div class="reveal-mask" style="aspect-ratio:21/10;overflow:hidden">
        <div class="rm-inner" style={`background-image:url('${style.heroPhoto}')`}></div>
      </div>
    </div>
  </section>

  <!-- Mood — photo + one line, not a wall of text -->
  <section class="section-tight">
    <div class="container">
      <div class="photo-split reveal pending">
        <div class="photo-split-media">
          <img src={style.grid[0].photo} alt={`${style.name}-style example`} loading="lazy" />
        </div>
        <div>
          <h2>What {style.name} <em>feels</em> like.</h2>
          <p class="lead" style="margin-top:1rem">{style.moodParagraphs[0]}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Before/after — real proof for this specific style. -->
  <section class="section-tight">
    <div class="container">
      <div class="section-head" style="text-align:center;margin-inline:auto">
        <h2>Flat vs. {style.name}.</h2>
        <p style="margin-inline:auto">What the treatment actually changes.</p>
      </div>
      <div style="max-width:520px;margin:2rem auto 0">
        <Compare
          grade
          before={style.heroPhoto}
          after={style.heroPhoto}
          beforeAlt={`A flat, ungraded ${style.name} scene`}
          afterAlt={`The same scene finished in the ${style.name} lifestyle look`}
          beforeLabel="Flat"
          afterLabel={style.name}
        />
      </div>
    </div>
  </section>

  <!-- Steps -->
  <section class="section-tight">
    <div class="container">
      <h2 style="margin-bottom:2rem">How {style.name} comes together.</h2>
      <div class="steps">
        {style.steps.map((s, i) => (
          <div class="reveal pending">
            <span class="step-n">No. {i + 1}</span><h3>{s.title}</h3><p>{s.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Photo grid — the range, in frames -->
  <section class="section-tight">
    <div class="container">
      <div class="grid grid-3">
        {style.grid.map((g) => (
          <div class="reveal pending">
            {g.photo ? (
              <div class="vis" style={`background-image:url('${g.photo}')`}>
                <div class="vis-floor"></div>
                <span class="vis-badge">{style.name}</span>
              </div>
            ) : (
              <ProductScene icon={g.icon} width={g.width} badge={style.name} />
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Best for / what you get -->
  <section>
    <div class="container two-col" style="align-items:start">
      <div class="reveal pending">
        <h2 style="font-size:1.7rem">Best <em>for</em></h2>
        <ul class="checklist" style="margin-top:1.2rem">
          {style.bestFor.map((item) => (
            <li><svg viewBox="0 0 24 24" class="i"><path d="M20 6L9 17l-5-5"/></svg><span>{item}</span></li>
          ))}
        </ul>
      </div>
      <div class="reveal pending">
        <h2 style="font-size:1.7rem">What you <em>get</em></h2>
        <ul class="checklist" style="margin-top:1.2rem">
          {style.whatYouGet.map((item) => (
            <li><svg viewBox="0 0 24 24" class="i"><path d="M20 6L9 17l-5-5"/></svg><span>{item}</span></li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Closing CTA -->
  <section class="section-tight">
    <div class="container">
      <div class="cta-band reveal pending">
        <h2 class="display" style="font-size:clamp(2rem,4.5vw,3.2rem)">Make {style.name} <em>yours.</em></h2>
        <div class="flex" style="justify-content:center;margin-top:1.8rem">
          <span class="magnet-wrap"><span class="magnet-inner"><a href={style.orderHref ?? '/start'} class="btn btn-primary btn-lg">{style.orderLabel ?? `Order ${style.name}`}</a></span></span>
          <a href="/test-sample" class="btn btn-ghost btn-lg">Test sample</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* app.css's shared .step-n carries an italic mark from the v1 serif system
     — v2 has no italics anywhere, so it's overridden locally rather than
     touched globally. */
  .step-n { font-style: normal; }
  /* Mirrors .queue-note on the hub components. Astro scopes <style> to a
     component's own template, so a shared visual pattern has to be repeated
     per file; consolidating these into global.css is logged as a follow-up. */
  .queue-note { margin-top: .9rem; font-size: .88rem; color: var(--ink-3); }

</style>
