---
// VISUAILS — /lifestyle/[slug] (English). De inhoud staat in
// LifestyleStyleDetail.astro zodat deze route en /nl/lifestyle/[slug] niet uit
// elkaar kunnen lopen; zie de kop daar.
import Layout from '../../layouts/Layout.astro';
import LifestyleStyleDetail from '../../components/LifestyleStyleDetail.astro';
import { styles } from '../../data/styles.js';
import {
  euro, ladderRate, ladderFloor, LADDER, vatLabel,
  reviewClaim, turnaround,
} from '../../data/pricing.js';
import { metaDescription } from '../../data/meta.js';

export function getStaticPaths() {
  return styles.map((s) => ({ params: { slug: s.slug }, props: { style: s } }));
}

const { style } = Astro.props;

/* Vier van de vijf lifestylestijlen dragen geen eigen priceTrust, dus de
   terugval hieronder is wat er op de meeste van deze pagina's staat. Hij was
   ooit de string '€59.99', twee keer getypt, en daarna één vast tarief. Nu zijn
   het TWEE bedragen: een lifestylecarrousel loopt op een staffel die met het
   aantal daalt, dus één tarief zou hier de prijs van ÉÉN product noemen op een
   pagina die een merk bereikt terwijl het een look kiest voor een hele
   collectie. Custom wordt geoffreerd en houdt zijn eigen regel. */
const LIFE_FLOOR_FROM = LADDER.lifestyle[LADDER.lifestyle.length - 1][0];
const priceLine = style.priceTrust
  ? `${style.priceTrust}${style.priceUnit ?? ''}`
  : `${euro(ladderRate('lifestyle', 1), 'en')} / product, ${euro(ladderFloor('lifestyle'), 'en')} from ${LIFE_FLOOR_FROM} up (${vatLabel('excl', 'en')})`;

/* ── DE ZUSTERLOOKS VAN DEZE PAGINA ────────────────────────────────────────
   Elke stijlpagina had precies één inkomende link — van de eigen hub — en
   verwees naar geen enkele andere look. Ongelokaliseerde paden: ServiceSwitch
   doet lp() zelf. */
const zusters = styles
  .filter((s) => s.slug !== style.slug)
  .map((s) => ({ href: `/lifestyle/${s.slug}`, naam: s.name }));

const TIMING = style.priceTrust ? 'Design first, then the ordinary turnaround per order.' : turnaround('unattended', 'en');
const REVIEW = reviewClaim('unattended', 'en');
---

<Layout
  title={`${style.name} — Lifestyle style | VISUAILS`}
  description={metaDescription([
    `${style.name}: a signature VISUAILS lifestyle style`,
    priceLine,
    TIMING,
    REVIEW,
  ])}
>
  <LifestyleStyleDetail lang="en" style={style} zusters={zusters} priceLine={priceLine} />
</Layout>
