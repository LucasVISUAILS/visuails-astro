---
// VISUAILS — /catalog (English). The page body lives in CatalogPage.astro so
// that /catalog and /nl/catalog cannot drift apart; only the meta differs here.
//
// This file used to be a 256-line inline page, with a byte-identical twin under
// src/pages/nl/. They agreed only because nobody had edited either since the
// port — and both carried the same four defects: a hardcoded €39.99, a "~24
// hours" promise the capacity gate never cleared, a link to /order-catalog, and
// a "three revision rounds are included" line that belongs to a drop, not to a
// single product order.
//
// The description is built from pricing.js: a price typed into a <meta> tag is
// the one place a stale figure survives a page rewrite. The old one was 185
// characters — past the ~160 Google renders — and named a delivery time.
import Layout from '../../layouts/Layout.astro';
import CatalogPage from '../../components/CatalogPage.astro';
import { perProduct, turnaround } from '../../data/pricing.js';

const item = perProduct('catalog', 'en');

const description =
  `${item.price} per product: four photos — front, back, a fabric or logo ` +
  `close-up, and one on-model shot. ${turnaround('unattended', 'en')}.`;
---

<Layout
  title="Catalog photos for clothing brands, no shoot | VISUAILS"
  description={description}
  ogImage="/img/catalog-after.webp"
>
  <CatalogPage lang="en" />
</Layout>
