---
// VISUAILS — /catalog/[slug] (English). De inhoud staat in
// CatalogStyleDetail.astro zodat deze route en /nl/catalog/[slug] niet uit
// elkaar kunnen lopen; zie de kop daar.
//
// De stijlgegevens zelf komen uit catalogStyles.js — dat is de tekst die PER
// STIJL verschilt en die per taal een eigen bestand verdient. Wat de component
// draagt is de omlijsting: de koppen die op elke stijlpagina hetzelfde zijn.
import Layout from '../../layouts/Layout.astro';
import CatalogStyleDetail from '../../components/CatalogStyleDetail.astro';
import { catalogStyles } from '../../data/catalogStyles.js';
import { reviewClaim, turnaround } from '../../data/pricing.js';
import { metaDescription } from '../../data/meta.js';

export function getStaticPaths() {
  return catalogStyles.map((s) => ({ params: { slug: s.slug }, props: { style: s } }));
}

const { style } = Astro.props;

/* ── DE ZUSTERLOOKS VAN DEZE PAGINA ────────────────────────────────────────
   Elke stijlpagina had precies één inkomende link — van de eigen hub — en
   verwees naar geen enkele andere look. Wie op Classic belandde en wilde weten
   hoe Custom eruitziet, moest terug naar boven en opnieuw beginnen.
   Ongelokaliseerde paden: ServiceSwitch doet lp() zelf. */
const zusters = catalogStyles
  .filter((s) => s.slug !== style.slug)
  .map((s) => ({ href: `/catalog/${s.slug}`, naam: s.name }));

/* De beschrijving was één template literal, dus zijn lengte was wat de data er
   toevallig van maakte. metaDescription laat de tier-clausules achterwege in
   plaats van over de 160 te lopen — zie src/data/meta.js. */
const TIMING = style.priceTrust ? 'Design first, then the ordinary turnaround per order.' : turnaround('unattended', 'en');
const REVIEW = reviewClaim('unattended', 'en');
---

<Layout
  title={`${style.name} — Catalog style | VISUAILS`}
  description={metaDescription([
    `${style.name}: a signature VISUAILS catalog style`,
    style.metaPrice,
    TIMING,
    REVIEW,
  ])}
>
  <CatalogStyleDetail lang="en" style={style} zusters={zusters} />
</Layout>
