---
// VISUAILS — /custom-models, "Your Brand Model" (English). The page body lives
// in BrandModelPage.astro so that /custom-models and /nl/custom-models cannot
// drift apart; only the meta differs here.
//
// This URL survived the /models + /custom-models merge (AUDIT-TASK-0.md §H·8):
// it already carried the exclusive-face argument, so it keeps its equity and
// /models 301s here. See src/i18n/ui.js → brandModelHref.
//
// The description is built from pricing.js rather than typed. A price in a
// <meta> tag is the one place a stale figure survives a page rewrite — the
// body gets corrected and the search result keeps quoting the old number.
import Layout from '../layouts/Layout.astro';
import BrandModelPage from '../components/BrandModelPage.astro';
import { euro, AMOUNT, BRAND_MODEL_CREDIT_DROPS } from '../data/pricing.js';

// Under 160 characters so Google shows all of it. The description this
// replaces ran to 167 and lost its last clause.
const description =
  `One face, designed for your brand alone — on every product, every drop. ` +
  `${euro(AMOUNT.brandModel, 'en')} one-time setup, ` +
  `${euro(AMOUNT.brandModelCredit, 'en')} back on each of your first ` +
  `${BRAND_MODEL_CREDIT_DROPS} drops.`;
---

<Layout
  title="Your Brand Model — one face, every drop | VISUAILS"
  description={description}
  ogImage="/img/custom-models-03.webp"
>
  <BrandModelPage lang="en" />
</Layout>
