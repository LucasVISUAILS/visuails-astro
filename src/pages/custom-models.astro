---
// VISUAILS — /custom-models, "Your Brand Model" (English). The page body lives
// in BrandModelPage.astro so that /custom-models and /nl/custom-models cannot
// drift apart; only the meta differs here.
//
// This URL survived the /models + /custom-models merge (AUDIT-TASK-0.md §H·8):
// it already carried the exclusive-face argument, so it kept its equity. As of
// task #270 /models is a real page again rather than a 301 to here — see
// §H·8's own 2026-07-29 addendum and src/i18n/ui.js → brandModelHref.
//
// The description is built from pricing.js rather than typed. A price in a
// <meta> tag is the one place a stale figure survives a page rewrite — the
// body gets corrected and the search result keeps quoting the old number.
import Layout from '../layouts/Layout.astro';
import BrandModelPage from '../components/BrandModelPage.astro';
import { euro, AMOUNT, vatLabel } from '../data/pricing.js';

// Under 152 characters (META_LIMIT) so Google shows all of it. The description
// this replaces ran to 167 and lost its last clause.
//
// The product did not change in August 2026 — the setup fee and the credit are
// the same, and they still cancel each other exactly. The word did: "drop"
// means a collection going live to the brands we sell to, and we were using it
// for a work order. An order is an order.
const description =
  `One face, designed for your brand alone — on every product, every order. ` +
  `${euro(AMOUNT.brandModel, 'en')} ${vatLabel('excl', 'en')}, paid once when the model is designed.`;
---

<Layout
  title="Your Brand Model — one face, every order | VISUAILS"
  description={description}
  ogImage="/img/custom-models-03.webp"
>
  <BrandModelPage lang="en" />
</Layout>
