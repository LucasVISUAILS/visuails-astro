---
// VISUAILS — /faq: in de hal sinds 13 oktober 2026 (afvinklijst 14, alles doen). De pagina
// staat in FaqHal.astro; de vorige (FaqPage.astro) staat op de opruimlijst.
// VISUAILS — /faq (English). The page body lives in FaqPage.astro so that /faq
// and /nl/faq cannot drift apart; only the meta differs here.
//
// AUDIT-TASK-0.md §F: "REWRITE selectively. Contains 'about €10 a photo' and
// 24h claims." Every price in the answers is now interpolated from pricing.js
// and every timing string comes from turnaround(); the meta follows the same
// rule so a repriced ladder cannot leave a stale figure in the <head>.
import Layout from '../layouts/Layout.astro';
import FaqHal from '../components/FaqHal.astro';
import { euro, ladderRate, ladderFloor, LADDER, vatLabel } from '../data/pricing.js';

// The band and the package price are gone with the package. What replaces them
// is the two ends of the ladder — every count between has a price now, so a
// range is the honest shape for this clause rather than a product name.
const description =
  `What an order costs (catalog from ${euro(ladderRate('catalog', 1), 'en')}, lifestyle from ` +
  `${euro(ladderRate('lifestyle', 1), 'en')} a product, ${vatLabel('excl', 'en')}), delivery, ` +
  `corrections, rights and payment — answered plainly.`;
---

<Layout huid="hal" title="Frequently asked questions — VISUAILS" description={description}>
  <FaqHal lang="en" />
</Layout>
