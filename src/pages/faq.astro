---
// VISUAILS — FAQ page. Ported from
// /tmp/visuails-rebuild/src/routes/faq/+page.svelte. Header/footer/nav live
// in Layout.astro; this file is page content only.
//
// The accordion is built with native <details>/<summary> + page-scoped CSS
// (matches the source, which deliberately avoided a hand-faked shadcn
// component) — fully keyboard/screen-reader accessible out of the box.
import Layout from '../layouts/Layout.astro';

const groups = [
  {
    title: 'Getting started',
    items: [
      { q: 'What is VISUAILS?', a: 'VISUAILS turns a single product photo into studio-quality catalog, lifestyle and video visuals. We use AI for speed and scale, and a real person reviews every image before it reaches you.' },
      { q: 'What do I need to get started?', a: "Just one clear product photo or a screenshot. A short note on the look you want helps, but it isn't required — we can suggest a direction if you'd prefer." },
      { q: 'Is there a way to try it first?', a: "Yes. We offer a test sample — one visual for a small €0.99 verification — so you can judge the quality on your own product before ordering. It's limited to one per business." },
    ],
  },
  {
    title: 'Ordering & styles',
    items: [
      { q: "What's the difference between Catalog and Lifestyle?", a: 'Catalog visuals are clean, consistent product shots — the same lighting, angle and background — built for webshops and marketplaces. Lifestyle visuals place your product in styled, real-world scenes, with optional models.' },
      { q: 'Can I keep the same style or model across orders?', a: 'Yes. Consistency is a core part of what we do — we can hold the same look, lighting and model across a whole range so your catalogue stays coherent order after order.' },
      { q: 'Do you offer custom styles or models?', a: 'Yes. Custom styles and models are arranged directly over WhatsApp so we can get the details right before we start.' },
      { q: 'Can I order via WhatsApp?', a: "Always. You can place any order through WhatsApp — send your photo and a short brief, and we'll take it from there. It's often the fastest route." },
    ],
  },
  {
    title: 'Delivery & quality',
    items: [
      { q: 'How fast is delivery?', a: "Most orders are delivered in about 24 hours from brief to download. Timing can vary with volume and how custom the request is — we'll always tell you if it's different." },
      { q: 'Is every image really checked by a person?', a: "Yes — 100% human-reviewed. A person selects and inspects every visual for accuracy, consistency and artefacts before it's delivered. Nothing goes out unchecked." },
      { q: 'How many revisions are included?', a: 'Three revision rounds are included as standard. Your feedback shapes the final result, so we can fine-tune until it fits.' },
      { q: 'What file formats and resolution do I get?', a: 'High-resolution files, ready for e-commerce. 2K resolution is included as standard, with 4K available as an option.' },
    ],
  },
  {
    title: 'Pricing & payment',
    items: [
      { q: 'How much does it cost?', html: 'Catalog is €39.99 per product — a full set of four photos (front, back, detail and one on-model shot), about €10 a photo. Lifestyle is €59.99 per product (a three-photo carousel) and standard Video from €49 (larger campaign videos are quoted per project). See the <a href="/pricing">pricing page</a> for the full breakdown.' },
      { q: 'Are there subscriptions?', a: "No. There's no subscription and no hidden fees — you simply pay for the visuals you order." },
      { q: 'Do you handle VAT / can I add my VAT number?', a: "Yes. You can add your VAT number at checkout — it's optional, and it helps with EU B2B invoicing." },
      { q: 'What about volume discounts?', a: "Volume discounts are available for larger orders. Send us a quick message with what you need and we'll put together a quote." },
    ],
  },
  {
    title: 'Rights & usage',
    items: [
      { q: 'Can I use the visuals commercially?', a: 'Yes. The visuals are made for commercial use — your webshop, marketplaces, ads and social feeds.' },
      { q: 'Who owns the results?', a: 'The finished visuals are yours to use for your business. If you have a specific licensing question, just ask and we’ll confirm the details for your case.' },
      { q: 'Do you use my product photos for anything else?', a: 'No. The photos you send are used only to produce your order — nothing else.' },
    ],
  },
];
---

<Layout
  title="VISUAILS — Frequently asked questions"
  description="Answers about getting started, ordering, delivery, pricing and usage rights for VISUAILS AI product visuals — honest, clear and no fine print."
>
  <!-- HERO — real photo beside a short line, not a text wall. -->
  <section class="page-hero">
    <div class="container">
      <div class="photo-split reverse">
        <div class="photo-split-media">
          <img src="/img/lifestyle-flash-05.webp" alt="A VISUAILS lifestyle visual" loading="lazy" />
        </div>
        <div>
          <h1 class="display" style="font-size:clamp(2.4rem,5vw,4rem)">Questions, <em>answered</em>.</h1>
          <p class="lead" style="margin-top:1rem">How it works, what it costs, how fast it lands. Still unsure? Message us on WhatsApp.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section-tight">
    <div class="container faq-narrow">
      {groups.map((g) => (
        <>
          <h2 style="margin-bottom:1.2rem">{g.title}</h2>
          <div class="faq-stack" style="margin-bottom:2.6rem">
            {g.items.map((item) => (
              <details class="acc-item reveal pending">
                <summary class="acc-q">
                  <span>{item.q}</span>
                  <span class="acc-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" class="i" style="width:14px;height:14px"><path d="M12 5v14M5 12h14"/></svg>
                  </span>
                </summary>
                <div class="acc-body-inner">
                  {item.html ? <p set:html={item.html} /> : <p>{item.a}</p>}
                </div>
              </details>
            ))}
          </div>
        </>
      ))}
    </div>
  </section>

  <!-- CTA -->
  <section class="section-tight">
    <div class="container">
      <div class="cta-band reveal pending">
        <h2 class="display" style="font-size:clamp(2.2rem,5vw,3.6rem)">Still have a <em>question</em>?</h2>
        <p class="lead" style="margin:1.2rem auto 0;text-align:center">Message us on WhatsApp — we usually reply within the hour.</p>
        <div class="flex" style="justify-content:center;margin-top:2rem">
          <a href="/test-sample" class="btn btn-primary btn-lg">Test sample</a>
          <a href="/contact" class="btn btn-ghost btn-lg">Contact us</a>
          <a href="https://wa.me/31625436130?text=Hi%20VISUAILS%2C%20I%20have%20a%20question%20about%20your%20service." class="btn btn-wa" target="_blank" rel="noopener">
            <svg class="i" viewBox="0 0 24 24"><path d="M21 11.5a8.38 8.38 0 0 1-8.5 8.5 8.5 8.5 0 0 1-4-1L3 20l1.5-4.5A8.38 8.38 0 0 1 3.5 11 8.5 8.5 0 0 1 12 3a8.38 8.38 0 0 1 8.5 8.5z"/></svg>
            WhatsApp
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* FAQ-only: narrower reading column + the accordion look (near-black
     surface, hairline dividers, coral plus/chevron indicator). Native
     <details>/<summary>. */
  .faq-narrow { max-width: 820px; }
  .faq-stack { display: flex; flex-direction: column; }

  .acc-item { box-shadow: inset 0 -1px 0 var(--line); }
  .acc-item summary { list-style: none; cursor: pointer; }
  .acc-item summary::-webkit-details-marker { display: none; }
  .acc-item summary::marker { content: ''; }
  .acc-q { width: 100%; display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding: 1.35rem 0; font-family: var(--font-body); font-size: 1.05rem; font-weight: 600; color: var(--ink); }
  .acc-q:hover { color: var(--ink); }
  .acc-icon { flex: 0 0 auto; width: 28px; height: 28px; border-radius: 50%; border: 1px solid var(--line-strong); color: var(--ink-3); display: grid; place-items: center; transition: transform .4s var(--ease), background .4s var(--ease), color .4s var(--ease), border-color .4s var(--ease); }
  .acc-item[open] .acc-icon { transform: rotate(45deg); background: var(--accent); border-color: var(--accent); color: #fff; }
  .acc-body-inner { padding-bottom: 1.35rem; color: var(--ink-2); max-width: 70ch; }
  .acc-body-inner a { color: var(--accent-bright); text-decoration: underline; text-underline-offset: 2px; }
</style>
