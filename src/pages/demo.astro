---
// VISUAILS — /demo (Engels). De walkthrough zelf staat in FigWalk.astro zodat
// /demo, /nl/demo en /how-it-works niet uit elkaar kunnen lopen; hier staat
// alleen de meta en de kop.
//
// WAT HIER STOND: DemoGame — het sleepspel. Zie de kop van src/data/demo.js
// voor waarom dat is opgegaan in de walkthrough in plaats van ernaast te
// blijven staan.
//
// noindex staat er NIET op, en dat is een keuze: dit is precies het soort
// pagina waar iemand op zoekt die "AI productfoto's proberen" intikt, en het is
// een eerlijke landing — je kunt hem doorlopen zonder account, zonder betaling
// en zonder je eigen foto’s af te staan.
import Layout from '../layouts/Layout.astro';
import FigWalk from '../components/FigWalk.astro';
import { WALK_COPY } from '../data/demo.js';
const c = WALK_COPY.en;
---
<Layout
  title="See how an order works — VISUAILS"
  description="Pick a service and scroll. One order, from the phone photo you send to the files that come back — catalog, lifestyle or video, each on its own."
>
  <section class="section-tight"><div class="container">
    <div class="walk-head">
      <h1 class="display">{c.title}</h1>
      <p class="lead">{c.lede}</p>
    </div>
    <FigWalk lang="en" />
  </div></section>
</Layout>

<style>
  .walk-head { max-width: 52rem; margin: 0 auto clamp(2.4rem, 5vw, 4rem); text-align: center; }
  /* Was een eigen clamp en daarmee de vierde paginatitelmaat op de site
     (54px op 1440, naast 96 · 64 · 51). Deze kop staat boven een figuur en
     is er het bijschrift van, dus hij hoort in het kleinere register — dat
     is precies wat --t-page-h1-sm is. Zie de noot bij dat token. */
  .walk-head .display { font-size: var(--t-page-h1-sm); }
  .walk-head .lead { margin: 1.2rem auto 0; max-width: 60ch; }
</style>
