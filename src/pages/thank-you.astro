---
// VISUAILS — /thank-you (English). De inhoud staat in ThankYouPage.astro zodat
// deze pagina en /nl/thank-you niet uit elkaar kunnen lopen; zie de kop daar.
//
// Deze pagina leest geen querystring. De enige parameter die /api/order hier
// aanhangt is `ref`, en interactions.js leest die client-side.
import Layout from '../layouts/Layout.astro';
import ThankYouPage from '../components/ThankYouPage.astro';
import { turnaroundShort } from '../data/pricing.js';

/* De korte vorm (3 sep 2026): de lange paste niet meer in 160 tekens. */
const TIMING = turnaroundShort('unattended', 'en');
const description =
  `Your request has been received. We confirm by email or WhatsApp, and your ` +
  `visuals follow from the normal turnaround — ${TIMING.toLowerCase()}.`;
---

<Layout title="Thank you — VISUAILS" description={description} noindex>
  <ThankYouPage lang="en" />
</Layout>
