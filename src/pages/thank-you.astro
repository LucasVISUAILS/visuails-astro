---
import { waHref } from '../data/whatsapp.js';
// VISUAILS — thank-you / confirmation page. Ported from the SvelteKit
// thank-you page (itself ported from static /thank-you.html).
//
// Every form on the site POSTs to /api/order, and /api/order redirects the
// no-JS path here on success. The forms that land here today are /start's
// pipeline, /test-sample, /contact and the homepage lead form. Three of the
// four named in the original version of this comment — order-catalog,
// order-lifestyle, order-video — were deleted in section 10 and now 301 to
// /start (see public/_redirects).
//
// This page reads no query string of its own. The one parameter /api/order
// ever appends is `ref`, and interactions.js reads that client-side to fill
// #ty-summary. Nothing here needs Astro.url.searchParams.
import Layout from '../layouts/Layout.astro';
import { TIERS, turnaround } from '../data/pricing.js';
import { mailNote } from '../data/mailNote.js';

// Every form on the site lands here and all of them place per-product orders,
// so the timing this page states is Tier 0's. It claimed "around 24 hours" in
// three places — meta description, hero lead and the timing card — none of
// which the capacity gate has cleared. The hero no longer states a duration at
// all; one card states it once, derived. The queue line is deliberate: section
// 13 wants the standard-queue difference visible rather than buried.
const T0 = TIERS.unattended;
const TIMING = turnaround('unattended', 'en');

const description =
  `Your request has been received. We confirm by email or WhatsApp, and your ` +
  `visuals follow from the normal turnaround — ${TIMING.toLowerCase()}.`;
---

<Layout
  title="Thank you — VISUAILS"
  description={description}
  noindex
>
  <section class="page-hero"><div class="container" style="max-width:720px;text-align:center;margin-inline:auto">
    <span class="eyebrow-page">Request received</span>
    <h1 class="display" style="font-size:clamp(2.4rem,5vw,4rem)">Thanks — we've got your request.</h1>
    <p class="lead ty-hide-when-cancelled" style="margin:1.2rem auto 0">We'll confirm the details by email — usually faster on WhatsApp.</p>
    {/* See the Dutch page for the full note: this page said "request received"
        and the card below promised we were preparing the visuals, while on a
        paid order nothing starts until the payment lands. Worded
        conditionally because the contact form, the checklist and the video
        request land here too and have no payment link. */}
    <p class="ty-pay ty-hide-when-cancelled"><strong>Is there a payment link in your confirmation email?</strong> Complete that payment — your order is noted, but production only starts once the payment has come through.</p>
    {/* The spam line. One sentence, from src/data/mailNote.js, printed on every
        screen that tells a customer to expect an email — this page, the
        "check your email" screen after requesting a sign-in link, and the
        portal's no-link screen. Placed directly under the sentence that makes
        the promise, because that is where the doubt starts. */}
    {/* ── GEANNULEERD: EEN TWEEDE PROEFVISUAL — 11 augustus 2026 ──────────────
         Verborgen tot initThankYou() bij /api/order-status hoort dat deze
         bestelling is tegengehouden. Het staat BOVEN de bedanktekst en niet
         eronder: wie hier belandt heeft zojuist betaald en moet niet eerst een
         scherm vol "we gaan aan de slag" doorlezen voordat blijkt dat dat niet
         gebeurt. interactions.js verbergt de rest van de pagina als dit blok
         zichtbaar wordt. */}
    <div class="ty-cancelled" data-ty-cancelled role="status" tabindex="-1" hidden>
      <h2 class="ty-cancelled-h">This one we had to cancel</h2>
      <p>Our records show a test sample already went out to your company. There is one
        per business, so this second request has been cancelled — and the &euro;1 is on
        its way back to the account you paid from. That usually takes a few working days.</p>
      <p>If that does not sound right — a colleague ordered without telling you, or the
        first sample never arrived — reply to the confirmation email and we will sort it
        out by hand.</p>
      <p class="ty-cancelled-next">Ready for the real thing? The full services start at
        the per-product price, with no minimum order.</p>
      <a class="btn btn-primary" href="/start">See the services</a>
    </div>
    <p class="mail-note ty-hide-when-cancelled">{mailNote('en')}</p>
    <!-- Filled client-side with the order reference /api/order redirected here
         with (initThankYou in interactions.js). Ships hidden and stays hidden
         unless there is a valid reference to show — a visitor who reaches this
         page any other way simply doesn't get a summary box. -->
    <div class="card ty-summary" id="ty-summary" style="display:none;text-align:left;margin:2rem auto 0;max-width:520px"></div>
    <div class="source-ask ty-hide-when-cancelled" data-source-ask>
      <span class="source-q">One quick thing — how did you find us?</span>
      <div class="source-btns">
        <button type="button" class="source-btn" data-source="Instagram">Instagram</button>
        <button type="button" class="source-btn" data-source="Google">Google</button>
        <button type="button" class="source-btn" data-source="Referral">Someone told me</button>
        <button type="button" class="source-btn" data-source="Other">Somewhere else</button>
      </div>
    </div>
    {/* THE WAY IN, on the page where they are. Lucas: *"misschien bij thank you
        page ook een link om in te loggen zetten zodat klanten gelijk hun
        bestelling kunnen bekijken."* It is now the first button: an order was
        just placed, and the question that follows an order is "where is it",
        not "what should I have uploaded". The guidelines move to second.

        The line under the row is not decoration. Nobody is signed in at this
        moment — signing in means asking for a link by email — and a button
        that quietly needs a second step is a button that reads as broken. */}
    <div class="flex" style="justify-content:center;margin-top:2rem">
      <a href="/account" class="btn btn-primary btn-lg">See your order</a>
      <a href="/upload-guidelines" class="btn btn-ghost btn-lg">Read upload guidelines</a>
      <a href={waHref("Hi VISUAILS, I just sent a request through the site.")} class="btn btn-wa" target="_blank" rel="noopener">
        Message us on WhatsApp
      </a>
    </div>
    <p class="ty-signin">Sign in with the email address on this order and we&rsquo;ll send you a link — there is no password.</p>
  </div></section>

  <section class="section-tight ty-hide-when-cancelled"><div class="container">
    <div class="grid grid-3 reveal-group">
      <div class="card reveal pending"><h2 class="as-card-h">What happens next</h2><p style="margin-top:.5rem;font-size:.95rem;color:var(--ink-3)">Once the payment has come through we read what you sent, prepare your visuals, and a person checks every result before it reaches you.</p></div>
      <div class="card reveal pending"><h2 class="as-card-h">Typical timing</h2><p style="margin-top:.5rem;font-size:.95rem;color:var(--ink-3)">{TIMING} from the moment we have your photos and your notes to your download link. {T0.queue.en}; a brand-new custom style can take a little longer.</p></div>
      <div class="card reveal pending"><h2 class="as-card-h">Need to add something?</h2><p style="margin-top:.5rem;font-size:.95rem;color:var(--ink-3)">Reply to our message on WhatsApp or email <a href="mailto:hello@visuails.com" style="color:var(--accent-bright)">hello@visuails.com</a> with any extra details or references.</p></div>
    </div>
    <div class="card reveal pending ty-upsell">
      <div>
        <h2 class="as-card-h">Want to guarantee the details?</h2>
        <p style="margin-top:.4rem;font-size:.95rem;color:var(--ink-3)">The more angles we have, the more accurately we can match fit, colour and detail first time. Send a detail close-up, the fabric and an on-body shot — it's free to add and it lifts the whole result.</p>
      </div>
      <a href={waHref("Hi VISUAILS, I'd like to send extra photos for my order.")} class="btn btn-wa" target="_blank" rel="noopener" data-track="ty-extra-photos">
        Send extra photos
      </a>
    </div>
  </div></section>
</Layout>

<style>
  /* The payment line. Left-aligned inside an otherwise centred hero, with a
     green edge: centred text reads as atmosphere, and this is the only
     sentence on the page that asks the reader to do something. */
  .ty-pay {
    max-width: 520px; margin: 1.4rem auto 0; padding: .85rem 1rem;
    text-align: left; font-size: .95rem; line-height: 1.6; color: var(--ink-2);
    background: var(--paper-lift, rgb(255 255 255 / .03));
    border-left: 3px solid var(--accent);
  }
  .ty-pay strong { color: var(--ink); }
  .ty-signin { margin: .9rem auto 0; max-width: 520px; font-size: .85rem; color: var(--ink-3); }
  /* The spam note sits directly under the payment line; two stacked asides of
     different widths read as two unrelated boxes. One column for both. */
  .mail-note { max-width: 520px; margin-inline: auto; }

  /* Was `.ty-summary h4`. Die kop is een h2 geworden (het kopniveau sprong van h1
   naar h4); de selector moest mee, anders viel deze verkleining stil weg en werd
   de kop 17px in plaats van 16px. Eén pixel, en precies het soort restje dat een
   tagwijziging achterlaat. */
  .ty-summary .as-card-h { font-size: 1rem; color: var(--ink); }
  /* .ty-dl / .ty-row / .ty-swatch / .ty-hex were removed in section 10. They
     styled a definition list of the submitted answers that initThankYou() built
     by reading the form fields back out of the query string — which only worked
     while the order forms were GET forms. Every form on the site POSTs to
     /api/order now, and the one parameter it puts on this URL is `ref`, so the
     box holds a reference and two lines of prose. Nothing here emits a <dl>. */
  .source-ask { margin: 1.8rem auto 0; max-width: 520px; }
  .source-q { display: block; font-size: .9rem; color: var(--ink-3); margin-bottom: .7rem; }
  .source-btns { display: flex; flex-wrap: wrap; gap: .5rem; justify-content: center; }
  .source-btn { padding: .5rem 1rem; border: 1px solid var(--line-strong); background: none; color: var(--ink-2); font-size: .88rem; font-weight: 500; cursor: pointer; font-family: var(--font-body); transition: border-color var(--dur-1) var(--ease), background var(--dur-1) var(--ease), color var(--dur-1) var(--ease); }
  .source-btn:hover { border-color: var(--accent); background: var(--accent-soft); color: var(--ink); }
  /* This confirmed a "how did you hear about us?" answer in a green that came
     from the deleted --success token. There is no success green in the system,
     and a one-line acknowledgement does not need one: the state change from a
     row of buttons to a single settled line is already the feedback. */
  .source-done { font-size: .95rem; color: var(--ink); font-weight: 600; margin: 0; }
  .ty-upsell { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; flex-wrap: wrap; margin-top: 1.2rem; border-color: var(--accent-line); }
  .ty-upsell .btn { flex: 0 0 auto; }
  @media (max-width: 560px) { .ty-upsell .btn { width: 100%; } }

  /* ── HET ANNULERINGSBLOK ──────────────────────────────────────────────────
     Zwaarder omrand dan een gewone kaart, want dit is het enige op deze pagina
     dat de bezoeker écht moet lezen. Geen rood: er is niets misgegaan en hij
     heeft niets fout gedaan — er is een regel toegepast, en zijn geld komt terug.
     Rood zou zeggen "fout", en dat leest als "jij deed iets fout". */
  .ty-cancelled {
    max-width: 560px; margin: 0 auto 2.5rem; padding: 1.6rem 1.7rem;
    border: 2px solid var(--ink); background: var(--surface); text-align: left;
  }
  .ty-cancelled:focus { outline: 2px solid var(--accent); outline-offset: 3px; }
  .ty-cancelled-h { font-size: var(--t-h4, 1.25rem); margin: 0 0 .7rem; }
  .ty-cancelled p { margin: 0 0 .8rem; color: var(--ink-2); }
  .ty-cancelled-next { color: var(--ink) !important; font-weight: 600; }
</style>
