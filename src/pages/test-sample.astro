---
import { waHref } from '../data/whatsapp.js';
// VISUAILS — test sample. Ported from
// /tmp/visuails-rebuild/src/routes/test-sample/+page.svelte: a 2-step
// request wizard (style/model/product -> contact) inside one <form>.
//
// The Svelte source used $state(step) with class:hidden-step to keep both
// steps mounted so field values survive stepping back and forth. This is a
// static Astro page (no client framework state), so the step-switching is
// reimplemented as vanilla JS below, keeping the exact same markup/fields
// and the same "both steps stay in the DOM" behavior.
import Layout from '../layouts/Layout.astro';
// De twee juridische verklaringen onder aan het formulier. Uit dezelfde bron als
// src/components/order/OrderFlow.astro, want twee eigen kopieen van een
// juridische tekst is hoe ze uit elkaar gaan lopen.
import { BUSINESS_VERSION, currentBusiness } from '../data/business.js';
import { CONSENT_VERSION, currentConsent } from '../data/consent.js';
import { TEST_SAMPLE, turnaround, CATALOG_IMAGES, LIFESTYLE_IMAGES } from '../data/pricing.js';
/*
 * ── DIT FORMULIER VROEG TWEE DINGEN DIE NIET BIJ ELKAAR HOORDEN — 13 aug 2026 ─
 *
 * Lucas: *"Test sample form is nog steeds oude form. Dit zou meer hetzelfde
 * moeten zijn als catalog form en als bezoekers lifestyle kiezen moet deze
 * aangepast worden daarop, dus achtergrondkleur optie verdwijnt dan."*
 *
 * Wat er stond: eerst "catalog of lifestyle?", en daarna ALTIJD "kies een look"
 * met de vier lifestyle-stijlen — met eronder de zin *"Skip it if you chose
 * catalog above."* Het formulier vroeg de bezoeker dus om zelf een vraag over te
 * slaan die niet op hem van toepassing was. En de tegenhanger ontbrak helemaal:
 * wie catalog koos, kreeg NERGENS de achtergrondvraag, terwijl dat op /start de
 * kernvraag van een catalogbestelling is — en de reden staat in
 * src/data/backgrounds.js: een merk dat al productfoto's heeft, heeft al een
 * achtergrond, en de nieuwe moeten er naast passen. Een proef op de verkeerde
 * ondergrond is geen proef van ons werk maar van een gok.
 *
 * Nu volgt de tweede vraag de eerste: catalog → achtergrond, lifestyle → look.
 *
 * ── ZONDER ÉÉN REGEL JAVASCRIPT ────────────────────────────────────────────
 *
 * Met `:has()` op het formulier, en die pagina gebruikt dat al voor het vinkje op
 * een gekozen kaart. Dat is hier geen puurheid maar noodzaak: pipeline.js — dat
 * op /start syncBackground() doet — staat niet op deze pagina, en de €1-stroom is
 * het laatste formulier waar ik een JavaScript-afhankelijkheid in wil hebben.
 *
 * Wat CSS níet kan, is een veld uit de POST houden. Een verborgen radio post nog
 * steeds. Dat wordt daarom afgehandeld waar het hoort en waar het niet te
 * omzeilen is: in functions/api/order.js, bij de proefvisual-opschoning.
 *
 * ── EN DE NAMEN KOMEN UIT DE BRON ─────────────────────────────────────────
 *
 * De vier looks stonden hier met de hand ingetypt ('Phone-made', 'Glow', …),
 * los van src/data/styles.js waar /lifestyle en StylePicker uit lezen. Een stijl
 * die daar wordt omgedoopt, heette hier daarna nog het oude. Ze komen nu uit
 * dezelfde bron, en ze POSTEN de slug — net als StylePicker — zodat de studio
 * één woordenlijst leest in plaats van twee.
 */
import { styles as styleData } from '../data/styles.js';
import { RECOMMENDED, CUSTOM_ID, DEFAULT_ID, copy as bgCopy } from '../data/backgrounds.js';

// The €1 was typed in four separate places and the delivery step
// promised "~24 hours" — a figure the capacity gate has never cleared. Both are
// tier facts, so they come from pricing.js now. "No subscription" went with
// them: it stopped being true the day the monthly plans shipped, and /faq and
// /about were already corrected for exactly that reason. The sample runs the
// per-product lane, so it states that lane's turnaround and nothing faster.
// Sinds 9 augustus 2026 geldt hetzelfde voor de OMSCHRIJVING van dat bedrag. Het
// heette "a €1 verification", en dat woord beloofde een controle die er niet is —
// zie de noot bij TEST_SAMPLE in pricing.js. De zin staat nu als `feeNote` in dat
// bestand, want hij stond op elf plekken los ingetypt.
const SAMPLE = TEST_SAMPLE.en;
const TIMING = turnaround('unattended', 'en');

// w/h are the intrinsic pixel size of each file in public/img — the .choice
// tile crops with object-fit, so these only reserve the aspect-ratio box.
//
// DE FOTO'S BLIJVEN VAN DEZE PAGINA, de namen niet. Deze vier bestanden zijn de
// uitsneden die hier al stonden, met hun echte pixelmaten; StylePicker gebruikt
// andere derivaten in zijn eigen 400px-tegel. Wat wél uit één bron moet komen is
// welke stijlen er zijn en hoe ze heten — dat is styleData.
const SAMPLE_LOOK_PHOTO: Record<string, { photo: string; w: number; h: number }> = {
  'phone-made': { photo: '/img/lifestyle-phone-made-01.webp', w: 2400, h: 1792 },
  glow: { photo: '/img/lifestyle-glow-01.webp', w: 1340, h: 2400 },
  flash: { photo: '/img/lifestyle-flash-01.webp', w: 928, h: 1152 },
  dunes: { photo: '/img/lifestyle-dunes-01.webp', w: 928, h: 1152 },
};
/*
 * `custom` valt eruit, en dat is een besluit en geen filterfoutje. Die stijl is
 * volgens styles.js *"een wereld die om jouw product heen gebouwd wordt"* — dus
 * ontwerpwerk en een gesprek. Een proef van één euro is een vaste test van wat we
 * al kunnen; een eigen wereld beloven voor die euro is een belofte die de proef
 * niet kan houden. Wie dat wil, komt bij /start/lifestyle uit.
 *
 * Loud, niet stil: verdwijnt een slug uit styles.js, dan valt de build om met de
 * naam erin in plaats van dat er een tegel minder staat die niemand mist. Zelfde
 * afspraak als CARDS in StylePicker.astro.
 */
const looks = styleData
  .filter((s) => s.slug !== 'custom')
  .map((s) => {
    const shot = SAMPLE_LOOK_PHOTO[s.slug];
    if (!shot) throw new Error(`test-sample: geen tegelfoto voor stijl "${s.slug}". Zet hem in SAMPLE_LOOK_PHOTO of haal hem uit styles.js.`);
    return { slug: s.slug, name: s.name, ...shot };
  });

const bgc = bgCopy('en');
// Nine of the ten roster headshots were produced at 1195x1600; model-rae.webp
// is the exception at 800x1071. Assuming one size for the family would have
// put a wrong box under Rae, so the exception is named.
const ROSTER_ODD: Record<string, [number, number]> = { Rae: [800, 1071] };
// LOCALE PARITY, and the reason this block is here at all: /nl/test-sample has
// asked "catalog or lifestyle?" as a required first question since it was
// written, and this page never did. The two locales therefore POSTed different
// payloads to the same /api/order endpoint — every English sample arrived with
// no sample_type at all, so the studio had to guess which of the two products
// the customer was actually testing.
const sampleTypes = [
  { value: 'catalog', label: 'Catalog', photo: '/img/catalog-after.webp', w: 1800, h: 1800, alt: 'An example catalog product photo, on a plain surface' },
  { value: 'lifestyle', label: 'Lifestyle', photo: '/img/lifestyle-glow-03.webp', w: 768, h: 1376, alt: 'An example lifestyle product photo, styled in a scene' },
];
const roster = ['Aaron', 'Ava', 'Dana', 'Elias', 'Fabi', 'Lisa', 'Maegan', 'Rae', 'Ryan', 'Seme']
  .map((name) => {
    const [w, h] = ROSTER_ODD[name] ?? [1195, 1600];
    return { name, photo: `/img/model-${name.toLowerCase()}.webp`, w, h };
  });
---

<Layout
  title="Test VISUAILS with 1 product — test sample"
  description="Send the same photos a normal order needs and get back four catalog photos or a three-photo lifestyle carousel. One sample per business, checked by a specialist before it reaches you."
>
  <!-- HERO -->
  <section class="page-hero"><div class="container">
    <span class="eyebrow-page">Test sample</span>
    <h1 class="display" style="font-size:clamp(2.4rem,5vw,4rem)">Test VISUAILS with <span class="accent-word">1 product</span></h1>
    <p class="lead" style="margin-top:1.2rem">You send what a normal order needs — front and back at least, plus a detail or worn shot if you have them — and back come {SAMPLE.deliverable}. Exactly what a paid order gets you per product. The more you send, the better we can make it.</p>
    <div class="chip-row" style="margin-top:1.8rem">
      <span class="chip"><span class="dot"></span>{CATALOG_IMAGES} photos, or {LIFESTYLE_IMAGES}</span>
      <span class="chip"><span class="dot"></span>Just {SAMPLE.price}</span>
      <span class="chip"><span class="dot"></span>Human quality-checked</span>
    </div>
  </div></section>

  <!-- WHAT YOU GET -->
  <section class="section-tight">
    <div class="container two-col">
      <div class="reveal pending">
        <h2>{SAMPLE.deliverable}, from your own product.</h2>
        <p style="margin-top:1.1rem;color:var(--ink-3);max-width:52ch">The same production and human review used on every paid order — the honest way to judge quality before you commit.</p>
        <ul class="checklist" style="margin-top:1.4rem">
          <li><svg viewBox="0 0 24 24" class="i" aria-hidden="true"><path d="M20 6L9 17l-5-5" /></svg><span>Pick catalog: {CATALOG_IMAGES} images — front, back, a fabric or logo detail, and one on a model.</span></li>
          <li><svg viewBox="0 0 24 24" class="i" aria-hidden="true"><path d="M20 6L9 17l-5-5" /></svg><span>Pick lifestyle: {LIFESTYLE_IMAGES} photos in one styled look — a scene, one on a model, and a detail close-up.</span></li>
          <li><svg viewBox="0 0 24 24" class="i" aria-hidden="true"><path d="M20 6L9 17l-5-5" /></svg><span>High resolution, delivered as an email download link.</span></li>
          <li><svg viewBox="0 0 24 24" class="i" aria-hidden="true"><path d="M20 6L9 17l-5-5" /></svg><span>A real look at our lighting, framing and finish.</span></li>
          <li><svg viewBox="0 0 24 24" class="i" aria-hidden="true"><path d="M20 6L9 17l-5-5" /></svg><span>Reviewed by a person before it reaches you.</span></li>
          <li><svg viewBox="0 0 24 24" class="i" aria-hidden="true"><path d="M20 6L9 17l-5-5" /></svg><span>A one-off {SAMPLE.feeNote}, one sample per business.</span></li>
        </ul>
      </div>
      <div class="reveal pending">
        <div class="photo-band">
          <img src="/img/lifestyle-glow-03.webp" alt="Example VISUAILS visual, Glow style" loading="lazy" decoding="async" width="768" height="1376" />
          <div class="scrim"></div>
          <div class="caption"><p style="margin:0">Your sample, human-checked</p></div>
        </div>
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section>
    <div class="container">
      <div class="section-head">
        <h2>How the sample works</h2>
        <p>Four short steps from your photo to a finished set in your inbox.</p>
      </div>
      <div class="steps">
        <div class="step reveal pending"><div class="step-n">01</div><h3>Upload product photo</h3><p>Share one clear photo of the product you'd like us to work with.</p></div>
        <div class="step reveal pending"><div class="step-n">02</div><h3>Choose a style</h3><p>Pick the look and, if you like, a model — or let us choose for you.</p></div>
        <div class="step reveal pending"><div class="step-n">03</div><h3>We create it</h3><p>Produced in our studio, then quality-checked by hand.</p></div>
        <div class="step reveal pending"><div class="step-n">04</div><h3>Receive by email</h3><p>Your finished visual arrives as a download link — {TIMING.toLowerCase()}.</p></div>
      </div>
    </div>
  </section>

  <!-- INPUT GUIDANCE -->
  <section class="section-tight">
    <div class="container">
      <div class="section-head">
        <h2>Sharp photo in, publish-ready visual out</h2>
        <p>The clearer your input, the better the visual we can build from it.</p>
      </div>
      <div class="grid grid-2">
        <div class="card reveal pending">
          <h3 style="color:var(--ink)">Do</h3>
          <ul class="checklist" style="margin-top:1rem">
            <li><svg viewBox="0 0 24 24" class="i" aria-hidden="true"><path d="M20 6L9 17l-5-5" /></svg><span>Clear, sharp and in focus</span></li>
            <li><svg viewBox="0 0 24 24" class="i" aria-hidden="true"><path d="M20 6L9 17l-5-5" /></svg><span>Neutral, uncluttered background</span></li>
            <li><svg viewBox="0 0 24 24" class="i" aria-hidden="true"><path d="M20 6L9 17l-5-5" /></svg><span>Good, even lighting</span></li>
            <li><svg viewBox="0 0 24 24" class="i" aria-hidden="true"><path d="M20 6L9 17l-5-5" /></svg><span>The whole product in frame</span></li>
          </ul>
        </div>
        <div class="card reveal pending">
          <h3 style="color:var(--ink-3)">Don't</h3>
          <ul class="checklist" style="margin-top:1rem">
            <li><svg viewBox="0 0 24 24" class="i" style="stroke:var(--ink-3)" aria-hidden="true"><path d="M18 6L6 18M6 6l12 12" /></svg><span>Blurry or low-resolution shots</span></li>
            <li><svg viewBox="0 0 24 24" class="i" style="stroke:var(--ink-3)" aria-hidden="true"><path d="M18 6L6 18M6 6l12 12" /></svg><span>Dark or heavily shadowed photos</span></li>
            <li><svg viewBox="0 0 24 24" class="i" style="stroke:var(--ink-3)" aria-hidden="true"><path d="M18 6L6 18M6 6l12 12" /></svg><span>Busy or distracting backgrounds</span></li>
            <li><svg viewBox="0 0 24 24" class="i" style="stroke:var(--ink-3)" aria-hidden="true"><path d="M18 6L6 18M6 6l12 12" /></svg><span>Heavy filters or watermarks</span></li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- REQUEST WIZARD -->
  <section>
    <div class="container narrow">
      <div class="section-head">
        <h2>Request your test sample</h2>
        <p>Two quick steps. Tell us the look you want, then where to send it.</p>
      </div>
      <div class="card" style="padding:clamp(1.4rem,3vw,2.4rem)">
        <!-- Refusals come back from /api/order as a redirect carrying ?error=…,
             because this form does a plain POST rather than a fetch. These blocks
             are the landing place for that; initFormRefusal() in interactions.js
             unhides the one that matches and moves focus to it. Hidden in the
             markup rather than injected from JS, so the wording is translated
             with the rest of the page and shows up in a diff.

             role="status" and not role="alert": the visitor has just navigated,
             so this is the state of the page they arrived at rather than
             something that interrupted them. -->
        <div class="ts-refused" data-form-refusal="sample-used" role="status" tabindex="-1" hidden>
          <strong>You've already had your test sample.</strong>
          It is one per business, so nothing has been ordered and nothing has been charged —
          you have not paid for this.
          Ready for the real thing? The <a href="/start">full services</a> start at a single
          product, with no minimum order — or <a href="/contact">send us a message</a> if the
          first sample never arrived, or a colleague ordered it without telling you.
        </div>
        <div class="ts-refused" data-form-refusal="email" role="status" tabindex="-1" hidden>
          <strong>That email address didn't go through.</strong>
          Check it for a typo and send it again — it is the address the finished visual arrives at.
        </div>
        <!-- data-astro-reload: this is the one form on the site whose POST can
             come back with a redirect to a different origin (Stripe Checkout,
             functions/api/order.js). Layout.astro's <ClientRouter /> intercepts
             POST forms by default and follows redirects itself via fetch() —
             which cannot hand a cross-origin Location off to the browser, so it
             was quietly landing back on this same route instead of ever
             reaching Stripe (seen as a bounce to /start, from order.js's
             onRequestGet fallback). data-astro-reload makes the browser do a
             real, native submit for this form so a 303 to checkout.stripe.com
             is followed the normal way. Every other form on the site only ever
             redirects same-origin, so they don't need this. -->
        <form action="/api/order" method="post" data-wizard data-astro-reload novalidate>
          <input type="hidden" name="service" value="test-sample" />
          <input type="hidden" name="redirect" value="/thank-you" />
          <input type="hidden" name="lang" value="en" />
          <!-- The photographs do NOT travel in this POST. /api/order refuses to
               read File entries by design, so they are staged into R2 by
               /api/upload first and this field carries the batch id that ties
               them to the order. initTestSampleUpload() in interactions.js
               writes it; empty here is the correct initial state. -->
          <input type="hidden" name="upload_batch" value="" />
          <input type="text" name="company_hp" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0" />
          <div class="progress" aria-hidden="true"><i data-wizard-progress style="transform:scaleX(.5)"></i></div>

          <!-- STEP 1 -->
          <div data-wizard-step="1">
            <h3 style="margin-bottom:.4rem">Step 1 &middot; Style, model &amp; product</h3>
            <p class="hint" style="margin-bottom:1.4rem">Choose the look you're after and upload your product photo.</p>

            {/* A <label> with no `for` and no wrapped control labels nothing —
                it is a heading wearing a form element's tag, and a screen
                reader announces the radios below it as unlabelled. /contact
                already does this correctly; these three groups now match it:
                a real heading, and role="radiogroup" + aria-labelledby to tie
                the options to it. */}
            <div class="field">
              <p class="ts-group-h" id="ts-type-h">What do you want to see? <span class="req">*</span></p>
              <div class="choice-grid" role="radiogroup" aria-labelledby="ts-type-h">
                {sampleTypes.map((t, i) => (
                  <label class="choice">
                    {/* De id's zijn niet decoratief: de CSS onderaan hangt met
                        :has() aan precies deze twee, en dat is wat de tweede
                        vraag laat volgen op de eerste. */}
                    <input type="radio" id={`ts-type-${t.value}`} name="sample_type" value={t.value} required={i === 0} />
                    <div class="choice-media"><img src={t.photo} alt={t.alt} loading="lazy" decoding="async" width={t.w} height={t.h} /></div>
                    <div class="choice-label">{t.label}</div>
                  </label>
                ))}
              </div>
              <span class="hint" style="margin-top:.3rem">Catalog is a clean photo of the product on its own. Lifestyle is the product styled in a scene, on a model. Whichever matters most to your shop right now is the one worth testing — the next question follows your choice.</span>
            </div>

            {/* ── CATALOG: DE ACHTERGROND ────────────────────────────────────
                 Alleen zichtbaar als er catalog is gekozen. Dit is op /start de
                 kernvraag van een catalogbestelling en hij ontbrak hier helemaal.
                 De hexwaarden komen uit backgrounds.js, want dat is waar de
                 studio tegen rendert — een swatch die #F7F5F1 laat zien terwijl
                 er #F5F5F5 uitkomt, is een levering die een klant kan meten. */}
            <div class="field ts-when-catalog">
              <p class="ts-group-h" id="ts-bg-h">{bgc.label}</p>
              <span class="hint" style="margin-bottom:.3rem">{bgc.hint}</span>
              <div class="choice-grid" role="radiogroup" aria-labelledby="ts-bg-h">
                {RECOMMENDED.map((b) => (
                  <label class="choice">
                    <input type="radio" name="background" value={b.id} checked={b.id === DEFAULT_ID} />
                    <div class="choice-media ts-swatch" style={`background:${b.hex}`}></div>
                    <div class="choice-label">{b.name.en} <span class="ts-hex">{b.hex}</span></div>
                  </label>
                ))}
                <label class="choice">
                  <input type="radio" name="background" value={CUSTOM_ID} />
                  <div class="choice-media ts-swatch ts-swatch-own"></div>
                  <div class="choice-label">{bgc.customH}</div>
                </label>
              </div>
              <div class="ts-own-hex">
                <label for="ts-bg-custom">Your hex value</label>
                <input class="input" type="text" id="ts-bg-custom" name="background_custom" placeholder="#F7F5F1" autocomplete="off" spellcheck="false" />
                {/* Op /start waarschuwt pipeline.js live als een eigen kleur donker
                    is. Die waarschuwing kan hier niet live, dus staat hij er als
                    vaste tekst — weglaten zou betekenen dat de proef stil op een
                    ondergrond loopt waarmee Amazon hem niet accepteert. */}
                <span class="hint">{bgc.customHint} {bgc.warn}</span>
                <span class="hint">{bgc.matchNote}</span>
              </div>
            </div>

            {/* ── LIFESTYLE: DE LOOK ─────────────────────────────────────────
                 Hier stond "Skip it if you chose catalog above". Een formulier dat
                 de bezoeker vraagt een vraag over te slaan, stelt die vraag te
                 vaak. Nu staat hij er alleen als hij van toepassing is. */}
            <div class="field ts-when-lifestyle">
              <p class="ts-group-h" id="ts-style-h">Choose a look</p>
              <span class="hint" style="margin-bottom:.3rem">The world your product goes into. Four house styles — the same four the lifestyle work runs on. Nothing here is final.</span>
              <div class="choice-grid" role="radiogroup" aria-labelledby="ts-style-h">
                {looks.map((s) => (
                  <label class="choice">
                    <input type="radio" name="style" value={s.slug} />
                    <div class="choice-media"><img src={s.photo} alt={`${s.name} lifestyle style`} loading="lazy" decoding="async" width={s.w} height={s.h} /></div>
                    <div class="choice-label">{s.name}</div>
                  </label>
                ))}
              </div>
            </div>

            <div class="field">
              <p class="ts-group-h" id="ts-model-h">Choose a model</p>
              <span class="hint" style="margin-bottom:.3rem">Optional for most products — handy for apparel and accessories.</span>
              <div class="choice-grid" role="radiogroup" aria-labelledby="ts-model-h">
                {roster.map((m) => (
                  <label class="choice">
                    <input type="radio" name="model" value={m.name} />
                    <div class="choice-media"><img src={m.photo} alt={m.name} loading="lazy" decoding="async" width={m.w} height={m.h} /></div>
                    <div class="choice-label">{m.name}</div>
                  </label>
                ))}
                <label class="choice">
                  <input type="radio" name="model" value="VISUAILS choose" />
                  <div class="choice-media mono"><div class="mono-av"><svg viewBox="0 0 24 24" class="i" style="width:26px;height:26px;color:var(--accent-bright)" aria-hidden="true"><path d="M12 2l2.4 7.4H22l-6 4.6 2.3 7.4-6.3-4.6L5.7 21.4 8 14 2 9.4h7.6z" /></svg></div></div>
                  <div class="choice-label">Let VISUAILS choose</div>
                </label>
              </div>
            </div>

            <div class="field">
              <label for="ts-upload">Upload product photos <span class="req">*</span></label>
              <label class="dropzone" for="ts-upload">
                <svg viewBox="0 0 24 24" class="i" aria-hidden="true"><path d="M12 16V4M6 10l6-6 6 6M4 20h16" /></svg>
                <div><strong>Click to upload</strong> or drag photos here</div>
                <div class="hint" style="margin-top:.4rem">One clear photo works — but front, back, a detail and the fabric give the best result.</div>
                <!-- No `name`, for the same reason /start's file input has none:
                     nothing about this control belongs in the form POST.
                     Visually hidden via .ts-file-input rather than `hidden`:
                     a display:none input cannot be focused or activated, so the
                     picker was unreachable by keyboard entirely. -->
                <input type="file" id="ts-upload" accept="image/*" multiple class="ts-file-input" />
              </label>
              <ul class="ts-list" data-ts-list></ul>
              <p class="ts-count" data-ts-count aria-live="polite"></p>
              <p class="ts-msg" data-ts-msg role="status"></p>
              <span class="hint">More angles help us match your product exactly — see <a href="/upload-guidelines" style="color:var(--accent-bright)">what to send</a>.</span>
            </div>

            <div class="field">
              <label for="ts-notes">Anything we should know?</label>
              <textarea class="textarea" id="ts-notes" name="notes" placeholder="Optional — colours to keep true, angle you prefer, anything specific about the product."></textarea>
            </div>

            <div class="flex" style="justify-content:flex-end;margin-top:.4rem">
              <button type="button" class="btn btn-primary" data-wizard-next>Next
