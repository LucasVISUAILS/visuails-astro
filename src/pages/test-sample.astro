---
/*
 * VISUAILS — /test-sample.
 *
 * ── 13 AUGUSTUS 2026: DE PAGINA WIJST NU NAAR DE STROOM DIE ER AL LAG ───────
 *
 * Deze pagina had een eigen bestelformulier: twee stappen, een eigen uploader,
 * een eigen wizard in interactions.js, een eigen stijlkiezer en een eigen
 * modelkiezer — allemaal naast de stroom die /start al gebruikt. OrderFlow.astro
 * kreeg op 11 augustus een `mode="sample"` die dat allemaal overbodig maakte, en
 * die stand werd door geen enkele pagina meegegeven. Het formulier hieronder is
 * daarom weg en de component staat ervoor in de plaats.
 *
 * WAT ER BLIJFT is de verkooppagina eromheen: de kop, wat je krijgt, hoe het
 * werkt, en het do-en-don'tblok over de foto die je stuurt. Die tekst hoort bij
 * deze pagina en bij geen andere. Vandaar `hero={false}` op de component: de kop
 * staat hier al, en twee koppen is er een te veel.
 *
 * WAT ER WEG IS, en dat is met opzet geen verhuizing: de handgeschreven
 * stijltegels, de modelrij, de achtergrondkeuze en de tweestapswizard. Die
 * vragen staan alle vier in de stroom, in dezelfde woorden als bij een betaalde
 * bestelling, en dat is precies wat een proef hoort te bewijzen.
 */
import Layout from '../layouts/Layout.astro';
import OrderFlow from '../components/order/OrderFlow.astro';
/* Allebei de kiezers, en niet één. Op /start ligt de dienst vast voordat de
   pagina laadt; hier is hij de eerste vraag van het formulier, dus moeten ze er
   allebei staan en laat pipeline.js er één zien. Zie syncStyle() daar. */
import StylePicker from '../components/order/StylePicker.astro';
import Step1Options from '../components/order/Step1Options.astro';
import { waHref } from '../data/whatsapp.js';
import { TEST_SAMPLE, turnaround, CATALOG_IMAGES, LIFESTYLE_IMAGES } from '../data/pricing.js';

const SAMPLE = TEST_SAMPLE.en;
const TIMING = turnaround('unattended', 'en');
---

<Layout
  title="Test VISUAILS with 1 product — test sample"
  description="Send the photos a normal order needs and get back four catalog images or a three-photo lifestyle carousel. One sample per business, checked by a person."
>
  <!-- HERO -->
  <section class="page-hero"><div class="container">
    <span class="eyebrow-page">Test sample</span>
    <h1 class="display">Test VISUAILS with <span class="accent-word">1 product</span></h1>
    <p class="lead" style="margin-top:1.2rem">You send what a normal order needs — front and back at least, plus a detail or worn shot if you have them — and back come {SAMPLE.deliverable}. Exactly what a paid order gets you per product. The more you send, the better we can make it.</p>
    <div class="chip-row" style="margin-top:1.8rem">
      <span class="chip"><span class="dot"></span>{CATALOG_IMAGES} photos, or {LIFESTYLE_IMAGES}</span>
      <span class="chip"><span class="dot"></span>Just {SAMPLE.price}</span>
      <span class="chip"><span class="dot"></span>Human quality-checked</span>
    </div>
  </div></section>

  <!-- WHAT YOU GET -->
  <section class="section-tight">
    <div class="container two-col">
      <div class="reveal pending">
        <h2>{SAMPLE.deliverable}, from your own product.</h2>
        <p style="margin-top:1.1rem;color:var(--ink-3);max-width:52ch">The same production and human review used on every paid order — the honest way to judge quality before you commit.</p>
        <ul class="checklist" style="margin-top:1.4rem">
          <li><svg viewBox="0 0 24 24" class="i" aria-hidden="true"><path d="M20 6L9 17l-5-5" /></svg><span>Pick catalog: {CATALOG_IMAGES} images — front, back, a fabric or logo detail, and one on a model.</span></li>
          <li><svg viewBox="0 0 24 24" class="i" aria-hidden="true"><path d="M20 6L9 17l-5-5" /></svg><span>Pick lifestyle: {LIFESTYLE_IMAGES} photos in one styled look — a scene, one on a model, and a detail close-up.</span></li>
          <li><svg viewBox="0 0 24 24" class="i" aria-hidden="true"><path d="M20 6L9 17l-5-5" /></svg><span>High resolution, in VISUAILS Studio — with the direct link in your email.</span></li>
          <li><svg viewBox="0 0 24 24" class="i" aria-hidden="true"><path d="M20 6L9 17l-5-5" /></svg><span>A real look at our lighting, framing and finish.</span></li>
          <li><svg viewBox="0 0 24 24" class="i" aria-hidden="true"><path d="M20 6L9 17l-5-5" /></svg><span>Reviewed by a person before it reaches you.</span></li>
          <li><svg viewBox="0 0 24 24" class="i" aria-hidden="true"><path d="M20 6L9 17l-5-5" /></svg><span>A one-off {SAMPLE.feeNote}, one sample per business.</span></li>
        </ul>
      </div>
      <div class="reveal pending">
        <div class="photo-band">
          <img src="/img/lifestyle-glow-03.webp" alt="Example VISUAILS lifestyle image, Glow style" loading="lazy" decoding="async" width="768" height="1376" />
          <div class="scrim"></div>
          <div class="caption"><p style="margin:0">Your sample, human-checked</p></div>
        </div>
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section>
    <div class="container">
      <div class="section-head">
        <h2>How the sample works</h2>
        <p>Four short steps from your photo to a finished set in your inbox.</p>
      </div>
      <div class="steps">
        <div class="step reveal pending"><div class="step-n">01</div><h3>Upload product photo</h3><p>Share one clear photo of the product you’d like us to work with.</p></div>
        <div class="step reveal pending"><div class="step-n">02</div><h3>Choose a style</h3><p>Pick the look and, if you like, a model — or let us choose for you.</p></div>
        <div class="step reveal pending"><div class="step-n">03</div><h3>We create it</h3><p>Produced in our studio, then quality-checked by hand.</p></div>
        <div class="step reveal pending"><div class="step-n">04</div><h3>Approve and download</h3><p>Your finished images land in VISUAILS Studio, with the link in your email — {TIMING.toLowerCase()}.</p></div>
      </div>
    </div>
  </section>

  <!-- INPUT GUIDANCE -->
  <section class="section-tight">
    <div class="container">
      <div class="section-head">
        <h2>Sharp photo in, publish-ready image out</h2>
        <p>The clearer your input, the better the image we can build from it.</p>
      </div>
      <div class="grid grid-2">
        <div class="card reveal pending">
          <h3 style="color:var(--ink)">Do</h3>
          <ul class="checklist" style="margin-top:1rem">
            <li><svg viewBox="0 0 24 24" class="i" aria-hidden="true"><path d="M20 6L9 17l-5-5" /></svg><span>Clear, sharp and in focus</span></li>
            <li><svg viewBox="0 0 24 24" class="i" aria-hidden="true"><path d="M20 6L9 17l-5-5" /></svg><span>Neutral, uncluttered background</span></li>
            <li><svg viewBox="0 0 24 24" class="i" aria-hidden="true"><path d="M20 6L9 17l-5-5" /></svg><span>Good, even lighting</span></li>
            <li><svg viewBox="0 0 24 24" class="i" aria-hidden="true"><path d="M20 6L9 17l-5-5" /></svg><span>The whole product in frame</span></li>
          </ul>
        </div>
        <div class="card reveal pending">
          <h3 style="color:var(--ink-3)">Don’t</h3>
          <ul class="checklist" style="margin-top:1rem">
            <li><svg viewBox="0 0 24 24" class="i" style="stroke:var(--ink-3)" aria-hidden="true"><path d="M18 6L6 18M6 6l12 12" /></svg><span>Blurry or low-resolution shots</span></li>
            <li><svg viewBox="0 0 24 24" class="i" style="stroke:var(--ink-3)" aria-hidden="true"><path d="M18 6L6 18M6 6l12 12" /></svg><span>Dark or heavily shadowed photos</span></li>
            <li><svg viewBox="0 0 24 24" class="i" style="stroke:var(--ink-3)" aria-hidden="true"><path d="M18 6L6 18M6 6l12 12" /></svg><span>Busy or distracting backgrounds</span></li>
            <li><svg viewBox="0 0 24 24" class="i" style="stroke:var(--ink-3)" aria-hidden="true"><path d="M18 6L6 18M6 6l12 12" /></svg><span>Heavy filters or watermarks</span></li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- DE AANVRAAG — SINDS 13 AUGUSTUS 2026 DEZELFDE STROOM ALS /start ────────
       Lucas: *"Ook de test sample is nog steeds het oude formulier, deze zou al
       2 keer aangepast moeten zijn. Zelfde als lifestyle orderflow maar dan
       simpel en 1 product automatisch maar niet zichtbaar geselecteerd."*

       Hij had gelijk, en de oorzaak was niet dat het niet gebouwd was.
       OrderFlow.astro heeft sinds 11 augustus een complete `mode="sample"` — de
       soortkeuze, het vaste aantal van één, geen levertijdstap, het vaste bedrag
       — maar GEEN ENKELE PAGINA GAF DIE MEE. Hier stond nog het oude
       tweestapsformulier ernaast, met een eigen uploader en een eigen wizard in
       interactions.js, en dus werd twee keer het verkeerde bestand aangepast.

       Wat de bezoeker hiermee krijgt en op het oude formulier miste: uploads per
       product met opnieuw-proberen, de modelkiezer, de vier vaste opnamen, de
       gratis extra referentiefoto's, de beeldverhouding, de foutafhandeling per
       veld, en de bevestiging voor het versturen.

       BEIDE KIEZERS IN DE SLOT. Op /start staat de dienst vast en slot de pagina
       er één in; hier kiest de bezoeker in het formulier zelf, dus staan ze er
       allebei en laten syncBackground() en syncStyle() in pipeline.js er één
       zien. `service="lifestyle"` is alleen de BEGINSTAND van die keuze — wat er
       gepost wordt is 'test-sample', en de soort reist in `sample_type` mee. -->
  <section>
    <div class="container narrow">
      <div class="section-head">
        <h2>Request your test sample</h2>
        <p>The same form a paid order uses, with the count fixed at one product.</p>
      </div>

      <!-- Refusals come back from /api/order as a redirect carrying ?error=…,
           because the submit ends in a real navigation. initFormRefusal() in
           interactions.js unhides the one that matches and moves focus to it.
           Hidden in the markup rather than injected from JS, so the wording is
           translated with the rest of the page and shows up in a diff.

           role="status" and not role="alert": the visitor has just navigated, so
           this is the state of the page they arrived at rather than something
           that interrupted them. -->
      <div class="ts-refused" data-form-refusal="sample-used" role="status" tabindex="-1" hidden>
        <strong>You’ve already had your test sample.</strong>
        It is one per business, so nothing has been ordered and nothing has been charged —
        you have not paid for this.
        Ready for the real thing? The <a href="/start/">full services</a> start at a single
        product, with no minimum order — or <a href="/contact/">send us a message</a> if the
        first sample never arrived, or a colleague ordered it without telling you.
      </div>
      <div class="ts-refused" data-form-refusal="email" role="status" tabindex="-1" hidden>
        <strong>That email address didn’t go through.</strong>
        Check it for a typo and send it again — it is the address the finished images arrive at.
      </div>
    </div>
  </section>

  <OrderFlow lang="en" service="lifestyle" mode="sample" hero={false}>
    <StylePicker lang="en" />
    <Step1Options lang="en" />
  </OrderFlow>

  <section class="section-tight">
    <div class="container narrow">
      <p class="hint" style="text-align:center">{`One sample per business · a ${SAMPLE.feeNote} · that’s all you pay for the sample.`}</p>
      <p class="form-help" style="text-align:center;margin-top:.6rem">Stuck on a step, or unsure about something? <a href={waHref("Hi VISUAILS, I'm filling in an order and have a question.")} target="_blank" rel="noopener">Message us on WhatsApp</a> — we usually reply within an hour on weekdays and can place the order with you.</p>
    </div>
  </section>


  <!-- CTA BAND -->
  <section class="section-tight">
    <div class="container">
      <div class="cta-band reveal pending">
        <h2 class="display" style="font-size:var(--t-page-h2)">Rather just talk it through?</h2>
        <p class="lead" style="margin:1.2rem auto 0;text-align:center">Send us your product on WhatsApp and we’ll help you pick a style.</p>
        <div class="flex" style="justify-content:center;margin-top:2rem">
          <a href="/start/" class="btn btn-ghost btn-lg">Place a full order</a>
          <a href={waHref("Hi VISUAILS, I'd like to try a test sample.")} class="btn btn-wa btn-lg" target="_blank" rel="noopener">
            WhatsApp
          </a>
        </div>
      </div>
    </div>
  </section>
  <!-- Wizard step navigation is handled globally in src/scripts/interactions.js
       (document-level delegation) so it survives ClientRouter navigations. -->
</Layout>

<style>
  /* Page-scoped: the sample picker and its progress bar. The form primitives
     that used to sit here (.field, .req, .hint, .input, .textarea, .row-2,
     .dropzone) are in global.css. This copy had drifted — the textarea was
     110px against 120px on the three other forms, and none of the transitions
     below were opted out of prefers-reduced-motion. Both are fixed by the
     move; the textarea is 10px taller here than it was. */
  .narrow { max-width: 820px; }
  .hidden-step { display: none; }
  .choice-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(140px, 100%), 1fr)); gap: 0.8rem; }
  .choice { position: relative; overflow: hidden; cursor: pointer; border: 1px solid var(--line-strong); transition: transform var(--dur-1) var(--ease), border-color var(--dur-1) var(--ease); background: var(--surface); display: block; }
  .choice:hover { transform: translateY(-2px); border-color: var(--accent-line); }
  .choice input { position: absolute; opacity: 0; pointer-events: none; }
  .choice .choice-media { aspect-ratio: 1; }
  .choice .choice-media img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .choice .choice-media.mono { display: grid; place-items: center; background: radial-gradient(125% 90% at 50% 6%, oklch(1 0 0), oklch(0.95 0.004 255) 58%, oklch(0.88 0.004 255) 100%); }
  .choice .choice-label { padding: 0.6rem 0.7rem; font-size: 0.85rem; color: var(--ink); font-weight: 500; }
  .choice:has(input:checked) { border-color: var(--accent); box-shadow: 0 0 0 1px var(--accent); }
  .choice:has(input:checked)::after { content: "\2713"; position: absolute; top: 8px; right: 8px; width: 24px; height: 24px; background: var(--accent); color: var(--accent-on); display: grid; place-items: center; font-size: 0.8rem; font-weight: 700; z-index: 5; }
  .choice .mono-av { position: relative; z-index: 2; display: grid; place-items: center; width: 100%; height: 100%; font-family: var(--font-display); font-weight: 900; font-size: 1.4rem; color: var(--accent-bright); }
  .choice .mono-av small { position: absolute; bottom: 8px; font-size: 0.58rem; font-weight: 500; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink-3); font-family: var(--font-body); font-style: normal; }
  /* .dropzone / :hover are global; the icon inside it is only on this page. */
  .dropzone svg { width: 30px; height: 30px; margin: 0 auto 0.6rem; color: var(--accent-bright); }
  /* ── DE TWEEDE VRAAG VOLGT DE EERSTE ─────────────────────────────────────
     Geen JavaScript: pipeline.js staat niet op deze pagina, en de €1-stroom is
     het laatste formulier waar een JS-afhankelijkheid in hoort. `:has()` doet dit
     native, en deze pagina gebruikt het al voor het vinkje op een gekozen kaart.

     BEIDE STAAN UIT TOT ER GEKOZEN IS, en dat is met opzet. De eerste vraag is
     verplicht; een achtergrondvraag die er al staat voordat iemand "catalog" heeft
     gezegd, is dezelfde fout als de lookvraag bij een catalogproef — een vraag die
     misschien niet over jou gaat. */
  .ts-when-catalog,
  .ts-when-lifestyle { display: none; }
  form:has(#ts-type-catalog:checked) .ts-when-catalog { display: block; }
  form:has(#ts-type-lifestyle:checked) .ts-when-lifestyle { display: block; }

  /* De eigen-kleurvelden volgen op hun beurt de swatch. Zelfde middel, één laag
     dieper — en ook hier post een verborgen tekstveld nog steeds, dus de
     opschoning in /api/order is wat het record kloppend houdt. */
  .ts-own-hex { display: none; margin-top: .9rem; }
  .ts-own-hex label { display: block; margin-bottom: .35rem; }
  .ts-own-hex .input { max-width: 12rem; font-variant-numeric: tabular-nums; }
  .ts-own-hex .hint { display: block; margin-top: .45rem; }
  .field:has(input[name="background"][value="custom"]:checked) .ts-own-hex { display: block; }

  /* Een vlak van de kleur zelf, in dezelfde tegel als de fotokaarten ernaast. Met
     een rand, want zuiver wit op een lichte kaart heeft anders geen omtrek. */
  .ts-swatch { border: 1px solid var(--line-strong); }
  .ts-swatch-own {
    background:
      linear-gradient(135deg, #FFFFFF 0 33%, #EDE4D8 33% 66%, #2A2A2A 66% 100%);
  }
  .ts-hex { color: var(--ink-3); font-variant-numeric: tabular-nums; font-weight: 400; }

  .progress { height: 3px; background: var(--surface-2); overflow: hidden; margin-bottom: 1.6rem; }
  .progress > i { display: block; height: 100%; width: 100%; transform-origin: left; background: var(--accent); transition: transform var(--dur-1) var(--ease); }
  .chip-row { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .chip { display: inline-flex; align-items: center; gap: 0.45rem; padding: 0.4rem 0.9rem; border: 1px solid var(--line); font-size: 0.8rem; color: var(--ink-2); }
  .chip .dot { width: 5px; height: 5px; background: var(--accent); }
</style>
