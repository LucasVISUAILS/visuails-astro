---
// VISUAILS — Pricing. Plans, add-ons, volume tiers, always-included list,
// test sample callout (using the ProductScene placeholder for the
// plain-product-on-white moment), and a pricing FAQ accordion. Ported from
// the SvelteKit pricing page.
import Layout from '../layouts/Layout.astro';
import ProductScene from '../components/ProductScene.astro';
import ThreeWay from '../components/ThreeWay.astro';

const plans = [
  { name: 'Catalog', price: '€39.99', unit: '/ product', accent: false, desc: 'A full 4-photo set per product — about €10 a photo.', features: ['4 photos: front, back, detail & on-model', 'On-model shot included, no extra fee', '3 revision rounds'], cta: 'Order catalog' },
  { name: 'Lifestyle', price: '€59.99', unit: '/ product', accent: true, desc: 'Three photos of your product in one styled look — a ready-to-post carousel.', features: ['3 photos: scene, on-model & logo close-up', 'One styled look, matched colour grading', 'Models & 3 revisions included'], cta: 'Order lifestyle' },
  { name: 'Video', price: '€49', unit: '/ video', accent: false, desc: 'Product videos with subtle motion for feeds and ads.', features: ['Motion from €49, Lifestyle from €59', 'Campaign videos quoted per project', 'Human review before delivery'], cta: 'Order a video' },
];

const addons = [
  { name: 'Multi Format Export', desc: 'Delivered in 1:1, 4:5, 9:16 and 16:9.', price: '+€19.99' },
  { name: '4K Export', desc: 'Higher resolution instead of the standard 2K.', price: '+€9.99' },
  { name: 'Priority delivery', desc: 'Jump to the top of the queue.', price: '+€29.99' },
];

const tiers = [
  { n: '1–24', desc: 'Standard price' },
  { n: '25–99', desc: 'Volume discount available' },
  { n: '100+', desc: 'Best rate — contact for a quote' },
];

const included = ['Human review on every visual', '2K export', '~24h delivery', '3 revision rounds'];

const faqs = [
  { q: 'How and when do I pay?', a: "You only pay for your order once you've approved the result — never upfront. The one exception is the optional €0.99 test sample, charged upfront to keep it fair (one per business). We invoice you directly; iDEAL and other instant options are coming soon, so just let us know your preference when you order." },
  { q: 'How does VAT and reverse-charge work?', a: "We're based in the Netherlands (VAT NL005407575B96). EU businesses with a valid VAT number can add it at checkout for reverse-charge and faster invoicing." },
  { q: 'What counts as one "visual"?', a: 'One finished image. Multi Format Export delivers it in several aspect ratios — still one visual. Catalog and Lifestyle are priced per product: Catalog is €39.99 for four photos (front, back, detail and on-model), Lifestyle is €59.99 for a three-photo carousel (scene, on-model and a logo close-up).' },
  { q: 'How does custom pricing work?', a: 'A custom style or model is a one-time design fee, then the normal per-visual price on every order after. Standard videos are fixed (Motion from €49, Lifestyle from €59); larger campaign videos are quoted per project over a short WhatsApp intake.' },
];
---

<Layout
  title="VISUAILS — Simple, transparent pricing"
  description="Simple pricing with VISUAILS — catalog €39.99 per product (a 4-photo set), lifestyle €59.99 per product (a 3-photo carousel), and custom video. No subscriptions, no hidden fees. Human review, 2K export, ~24h delivery and 3 revision rounds always included."
>
  <section class="page-hero"><div class="container">
    <p class="eyebrow-page">Pricing</p>
    <h1 class="display" style="font-size:clamp(2.4rem,5vw,4rem)">Simple, transparent pricing</h1>
    <p class="lead" style="margin-top:1.2rem">Pay as you go — per product. No subscriptions, no hidden fees.</p>
    <div class="flex" style="margin-top:1.8rem"><a href="/order" class="btn btn-primary btn-lg">Order now</a><a href="/test-sample" class="btn btn-ghost btn-lg">Test sample</a></div>
  </div></section>

  <section class="section-tight"><div class="container">
    <div class="anchor-band reveal pending">
      <div class="anchor-col was">
        <span class="anchor-tag">A traditional shoot day</span>
        <span class="anchor-price">€1,000–2,000<small>+ / day</small></span>
        <ul class="anchor-list">
          <li>Book a studio, photographer and model weeks ahead</li>
          <li>Ship your samples, travel there, spend the day on set</li>
          <li>Then wait ~3 weeks for edited photos</li>
        </ul>
      </div>
      <div class="anchor-vs" aria-hidden="true">vs</div>
      <div class="anchor-col now">
        <span class="anchor-tag">VISUAILS</span>
        <span class="anchor-price">€39.99<small> / product</small></span>
        <ul class="anchor-list">
          <li>Send one phone photo from wherever you are</li>
          <li>Never leave your desk — no shoot to attend, nothing to ship</li>
          <li>A full campaign back in about 24 hours</li>
        </ul>
      </div>
    </div>
    <p class="anchor-note reveal pending">You don't just save money. You save the day you'd have spent on set — time you put straight back into growing your brand while we make the visuals.</p>
  </div></section>

  <section><div class="container">
    <div class="section-head"><h2>Pay as you go</h2><p>No subscriptions. Order five or five hundred at the same short wait.</p></div>
    <div class="grid grid-3 reveal-group">
      {plans.map((p) => (
        <div class="card plan-card reveal pending" style={p.accent ? 'border-color:var(--accent-line)' : undefined}>
          <h3>{p.name}</h3>
          <div class="price-big">{p.price} <small>{p.unit}</small></div>
          <p style="color:var(--ink-3)">{p.desc}</p>
          <ul class="checklist" style="margin-top:1.2rem;margin-bottom:1.6rem">
            {p.features.map((f) => (
              <li><svg class="i" viewBox="0 0 24 24" style="stroke:var(--success)"><path d="M20 6L9 17l-5-5"/></svg>{f}</li>
            ))}
          </ul>
          <a href="/order" class="btn btn-primary btn-block" style="margin-top:auto">{p.cta}</a>
        </div>
      ))}
    </div>
    <p class="pill-note" style="margin-top:1.8rem">A custom style or model is a one-time design fee, then the normal visual price.</p>
  </div></section>

  <section class="section-tight"><div class="container narrow">
    <div class="section-head"><h2>Add-ons</h2></div>
    <div class="addon-list reveal pending">
      {addons.map((a) => (
        <div class="addon">
          <div>
            <div style="font-weight:600">{a.name}</div>
            <div style="font-size:.92rem;color:var(--ink-3)">{a.desc}</div>
          </div>
          <div class="addon-price">{a.price}</div>
        </div>
      ))}
    </div>
  </div></section>

  <section class="section-tight"><div class="container narrow">
    <div class="section-head"><h2>Volume</h2></div>
    <div class="tier-row reveal pending">
      {tiers.map((t) => (
        <div class="tier">
          <div class="tn">{t.n}</div>
          <div style="font-size:.92rem;color:var(--ink-3)">{t.desc}</div>
        </div>
      ))}
    </div>
    <p class="pill-note" style="margin-top:1.4rem"><a href="https://wa.me/31625436130?text=Hi%20VISUAILS%2C%20I%27d%20like%20a%20volume%20quote." class="link-arrow" style="font-size:1rem" target="_blank" rel="noopener">Contact us for a volume quote <svg viewBox="0 0 24 24" class="i"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a></p>
  </div></section>

  <section><div class="container">
    <div class="card reveal pending" style="padding:clamp(1.6rem,3vw,2.6rem)">
      <div class="section-head" style="margin-bottom:1.4rem"><h2>Always included</h2></div>
      <div class="grid included-grid">
        {included.map((item) => (
          <div class="chip"><span class="dot"></span>{item}</div>
        ))}
      </div>
    </div>
  </div></section>

  <section class="section-tight"><div class="container">
    <ThreeWay
      heading="Why not just shoot it — or just prompt an AI?"
      sub="Here's the honest trade-off. VISUAILS is built to give you the fast, cheap side of AI and the accurate, human-checked side of a real shoot."
      cta={false}
    />
  </div></section>

  <section class="section-tight"><div class="container">
    <div class="card reveal pending" style="border-color:var(--accent-line)">
      <div class="two-col" style="align-items:center">
        <div>
          <h2>Test sample</h2>
          <p class="measure" style="margin-top:1rem">See your own product transformed before you commit — for just a €0.99 verification. One sample per business.</p>
          <div class="flex" style="margin-top:1.6rem"><a href="/test-sample" class="btn btn-primary">Request your test sample</a></div>
        </div>
        <div><ProductScene icon="bottle" width="42%" badge="1 test sample per business" wide /></div>
      </div>
    </div>
    <p class="pill-note" style="margin-top:1.4rem">Have a VAT number? You can provide it at checkout to speed up invoicing — it's optional.</p>
  </div></section>

  <section><div class="container narrow">
    <div class="section-head"><h2>Pricing FAQ</h2></div>
    <div class="acc reveal pending">
      {faqs.map((f) => (
        <details class="acc-item">
          <summary class="acc-q"><span>{f.q}</span><span class="acc-icon" aria-hidden="true"><svg viewBox="0 0 24 24" class="i" style="width:14px;height:14px"><path d="M12 5v14M5 12h14"/></svg></span></summary>
          <div class="acc-body-inner"><p>{f.a}</p></div>
        </details>
      ))}
    </div>
  </div></section>

  <section class="section-tight"><div class="container">
    <div class="cta-band reveal pending">
      <h2 class="display" style="font-size:clamp(2.2rem,5vw,3.6rem)">Transparent pricing.<br />No <em>surprises.</em></h2>
      <div class="flex" style="justify-content:center;margin-top:2rem">
        <a href="/test-sample" class="btn btn-primary btn-lg">Try a €0.99 test sample</a>
        <a href="/order" class="btn btn-ghost btn-lg">Order now</a>
        <a href="https://wa.me/31625436130?text=Hi%20VISUAILS%2C%20I%27ve%20got%20a%20question%20about%20pricing." class="btn btn-wa" target="_blank" rel="noopener"><svg class="i" viewBox="0 0 24 24"><path d="M21 11.5a8.38 8.38 0 0 1-8.5 8.5 8.5 8.5 0 0 1-4-1L3 20l1.5-4.5A8.38 8.38 0 0 1 3.5 11 8.5 8.5 0 0 1 12 3a8.38 8.38 0 0 1 8.5 8.5z"/></svg>WhatsApp</a>
      </div>
    </div>
  </div></section>
</Layout>

<style>
  .container.narrow { max-width: 760px; }
  .anchor-band { display: grid; grid-template-columns: 1fr auto 1fr; align-items: stretch; gap: 0; border: 1px solid var(--line); border-radius: var(--r-lg); overflow: hidden; }
  .anchor-col { padding: clamp(1.4rem, 3vw, 2.2rem); }
  .anchor-col.was { background: var(--bg-deep); }
  .anchor-col.now { background: var(--accent-soft); box-shadow: inset 0 0 0 1px var(--accent-line); }
  .anchor-tag { display: block; font-size: .72rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--ink-3); }
  .anchor-col.now .anchor-tag { color: var(--accent-bright); }
  .anchor-price { display: block; font-family: var(--font-display); font-weight: 900; font-size: clamp(1.7rem, 3.4vw, 2.4rem); line-height: 1; color: var(--ink); margin: .5rem 0 1.1rem; }
  .anchor-col.was .anchor-price { color: var(--ink-3); text-decoration: line-through; text-decoration-thickness: 2px; }
  .anchor-price small { font-family: var(--font-body); font-size: .82rem; font-weight: 500; -webkit-text-decoration: none; text-decoration: none; }
  .anchor-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: .55rem; }
  .anchor-list li { position: relative; padding-left: 1.3rem; font-size: .92rem; color: var(--ink-2); line-height: 1.45; }
  .anchor-list li::before { content: ""; position: absolute; left: 0; top: .5em; width: 6px; height: 6px; border-radius: 50%; background: var(--ink-faint); }
  .anchor-col.now .anchor-list li::before { background: var(--accent); }
  .anchor-vs { display: grid; place-items: center; padding: 0 1rem; font-family: var(--font-display); font-weight: 900; font-size: 1rem; color: var(--ink-faint); background: var(--surface); }
  .anchor-note { max-width: 60ch; margin: 1.4rem auto 0; text-align: center; color: var(--ink-2); font-size: 1rem; }
  @media (max-width: 680px) { .anchor-band { grid-template-columns: 1fr; } .anchor-vs { padding: .6rem; } }
  .plan-card { display: flex; flex-direction: column; }
  .price-big { font-family: var(--font-display); font-weight: 400; font-size: 2.6rem; line-height: 1; color: var(--ink); margin: .3rem 0 .2rem; }
  .price-big small { font-family: var(--font-body); font-size: .85rem; font-weight: 500; color: var(--ink-3); }
  .pill-note { display: inline-flex; align-items: center; gap: .5rem; padding: .45rem 1rem; border-radius: var(--r-pill); border: 1px solid var(--line); color: var(--ink-3); font-size: .82rem; font-weight: 500; }
  .measure { max-width: 60ch; }
  .addon-list { display: flex; flex-direction: column; gap: .9rem; margin-top: 1.3rem; }
  .addon { display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; padding: 1rem 1.2rem; border: 1px solid var(--line); border-radius: var(--r-lg); }
  .addon-price { font-family: var(--font-display); font-size: 1.1rem; color: var(--ink); white-space: nowrap; }
  .tier-row { display: flex; gap: .8rem; flex-wrap: wrap; margin-top: 1.2rem; }
  .tier { flex: 1 1 160px; border: 1px solid var(--line); border-radius: var(--r-lg); padding: 1rem 1.2rem; }
  .tier .tn { font-family: var(--font-display); font-size: 1.3rem; color: var(--ink); }
  .included-grid { grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); }
  .chip { display: inline-flex; align-items: center; gap: .45rem; padding: .4rem .85rem; border-radius: var(--r-pill); border: 1px solid var(--line); font-size: .85rem; color: var(--ink-2); }
  .chip .dot { width: 5px; height: 5px; border-radius: 50%; background: var(--accent); }
  .acc-item { box-shadow: inset 0 -1px 0 var(--line); }
  .acc-q { width: 100%; display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding: 1.35rem 0; text-align: left; font-family: var(--font-body); font-size: 1.05rem; font-weight: 600; color: var(--ink); cursor: pointer; list-style: none; }
  .acc-q::-webkit-details-marker { display: none; }
  .acc-icon { flex: 0 0 auto; width: 28px; height: 28px; border-radius: 50%; border: 1px solid var(--line-strong); display: grid; place-items: center; transition: transform .4s var(--ease), background .4s var(--ease), color .4s var(--ease), border-color .4s var(--ease); }
  .acc-item[open] .acc-icon { transform: rotate(45deg); background: var(--accent); border-color: var(--accent); color: #fff; }
  .acc-body-inner { padding-bottom: 1.35rem; color: var(--ink-2); max-width: 70ch; }
</style>
