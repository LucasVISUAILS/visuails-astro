---
// VISUAILS — /pricing (English). The page body lives in PricingPage.astro so
// that /pricing and /nl/pricing cannot drift apart; only the meta differs here.
//
// The meta description is built from pricing.js for the same reason the page
// body is: a price typed into a <meta> tag is still a price the ladder cannot
// enforce, and it is the one place a stale figure survives a page rewrite.
import Layout from '../layouts/Layout.astro';
// 12 oktober 2026 (afvinklijst 8, alles "doen"): deze pagina staat in de hal (huid="hal");
// de vorige opmaak staat op _opruimen/LIJST.txt.
import PricingHal from '../components/PricingHal.astro';
//
// It named the two packages until August 2026. It names the shape of the
// ladder now (section 0 of src/data/pricing.js): the entry rate, the floor,
// and the fact that the fall is what the page is about. The first-order
// discount is the last clause because it is the one a snippet can afford to
// lose — the two rates cannot be.
import { euro, ladderRate, ladderFloor, LADDER, vatLabel } from '../data/pricing.js';

const FLOOR_FROM = LADDER.catalog[LADDER.catalog.length - 1][0];

const description =
  `Priced per product, and the rate falls as the count rises: catalog ` +
  `${euro(ladderRate('catalog', 1), 'en')} to ${euro(ladderFloor('catalog'), 'en')}, lifestyle ` +
  `${euro(ladderRate('lifestyle', 1), 'en')} to ${euro(ladderFloor('lifestyle'), 'en')} from ${FLOOR_FROM} products, ` +
  `${vatLabel('excl', 'en')}.`;
---

<Layout huid="hal" title="Pricing — the rate per product, in full | VISUAILS" description={description}>
  <PricingHal lang="en" />
</Layout>
