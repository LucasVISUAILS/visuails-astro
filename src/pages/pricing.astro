---
// VISUAILS — /pricing (English). The page body lives in PricingPage.astro so
// that /pricing and /nl/pricing cannot drift apart; only the meta differs here.
//
// The meta description is built from pricing.js for the same reason the page
// body is: a price typed into a <meta> tag is still a price the ladder cannot
// enforce, and it is the one place a stale figure survives a page rewrite.
import Layout from '../layouts/Layout.astro';
import PricingPage from '../components/PricingPage.astro';
import { euro, AMOUNT, FULL_DROP_MIN, FULL_DROP_MAX } from '../data/pricing.js';

const description =
  `Priced by the drop — Drop Pilot ${euro(AMOUNT.dropPilot, 'en')}, Full Drop ` +
  `${euro(AMOUNT.fullDrop, 'en')} for ${FULL_DROP_MIN}–${FULL_DROP_MAX} products. ` +
  `Individual products from ${euro(AMOUNT.catalog, 'en')}.`;
---

<Layout title="Pricing — VISUAILS" description={description}>
  <PricingPage lang="en" />
</Layout>
