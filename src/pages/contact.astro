---
import { waHref } from '../data/whatsapp.js';
// VISUAILS — Contact page. Ported from
// /tmp/visuails-rebuild/src/routes/contact/+page.svelte. Header/footer/nav
// live in Layout.astro; this file is page content only.
import Layout from '../layouts/Layout.astro';
import { TEST_SAMPLE } from '../data/pricing.js';

// The test-sample fee was typed here too. It is a tier fact, so it comes from
// pricing.js — see src/pages/test-sample.astro for the same correction.
const SAMPLE = TEST_SAMPLE.en;
---

<Layout
  title="VISUAILS — Contact us"
  description="Questions about an order, support, or a custom request? Message VISUAILS on WhatsApp or email hello@visuails.com — we usually reply within the hour."
>
  <!-- HERO — real photo beside a short line, not a text wall. -->
  <section class="page-hero">
    <div class="container">
      <div class="photo-split reverse">
        <div class="photo-split-media">
          <img src="/img/lifestyle-glow-03.webp" alt="A VISUAILS lifestyle visual" loading="lazy" decoding="async" width="768" height="1376" />
        </div>
        <div>
          <h1 class="display" style="font-size:clamp(2.4rem,5vw,4rem)">Let's grow <em>together</em>.</h1>
          <p class="lead" style="margin-top:1rem">A question, or a custom request? Send a message — a real person reads every one.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CONTACT -->
  <section class="section-tight">
    <div class="container two-col" style="align-items:start">

      <!-- Left: channels -->
      <div class="reveal pending contact-stack">
        <h2>The fastest way to reach us</h2>

        <div class="card">
          <h3>WhatsApp</h3>
          <p style="margin-top:.5rem;color:var(--ink-3)">Usually replies within the hour.</p>
          <p style="margin-top:.6rem"><strong>+31 6 25436130</strong></p>
          <a href={waHref("Hi VISUAILS, I have a question.")} class="btn btn-wa" style="margin-top:1rem" target="_blank" rel="noopener">
            Chat on WhatsApp
          </a>
        </div>

        <div class="card">
          <h3>Email</h3>
          <p style="margin-top:.5rem;color:var(--ink-3)">For a long request, an invoice question or files you want to attach.</p>
          <p style="margin-top:.6rem">
            <a href="mailto:hello@visuails.com" class="link-arrow" style="font-size:1rem">hello@visuails.com <svg viewBox="0 0 24 24" class="i"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
          </p>
        </div>

        <div class="grid grid-2">
          <div class="card">
            <h3 style="font-size:.95rem">Opening hours</h3>
            <p style="margin-top:.5rem;font-size:.95rem;color:var(--ink-3)">Mon–Fri 08:00–20:00 CET<br>Sat–Sun 09:00–20:00 CET</p>
          </div>
          <div class="card">
            <h3 style="font-size:.95rem">Location</h3>
            <p style="margin-top:.5rem;font-size:.95rem;color:var(--ink-3)">Enschede, Netherlands<br>KVK 99742993</p>
          </div>
        </div>
      </div>

      <!-- Right: form -->
      <div class="reveal pending">
        <div class="card">
          <h2 style="font-size:1.5rem">Send a message</h2>
          <p style="margin-top:.5rem;color:var(--ink-3);font-size:.95rem">We usually reply within the hour, by your preferred channel.</p>

          <!-- Posts to /api/order, which is intake for orders, signups AND
               contact messages — the hidden service field is what selects the
               branch. service=contact writes a `messages` row and mails
               NOTIFY_EMAIL; it creates no order and touches no capacity. -->
          <form action="/api/order" method="post" style="margin-top:1.6rem">
            <input type="hidden" name="service" value="contact" />
            <input type="hidden" name="redirect" value="/thank-you" />
            <input type="hidden" name="lang" value="en" />
            <input type="text" name="company_hp" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0" />
            <div class="field">
              <label for="c-name">Name <span class="req">*</span></label>
              <input class="input" type="text" id="c-name" name="name" required autocomplete="name" placeholder="Your name" />
            </div>
            <div class="field">
              <label for="c-email">Email <span class="req">*</span></label>
              <input class="input" type="email" id="c-email" name="email" required autocomplete="email" placeholder="you@yourbrand.com" />
            </div>
            <div class="field">
              <label for="c-topic">Topic</label>
              <select class="select" id="c-topic" name="topic">
                <option value="order-support">Order support</option>
                <option value="new-order">New order</option>
                <option value="custom-request">Custom request</option>
                <option value="other">Other</option>
              </select>
            </div>
            <div class="field">
              <label for="c-message">Message <span class="req">*</span></label>
              <textarea class="textarea" id="c-message" name="message" rows="5" required placeholder="How can we help?"></textarea>
            </div>
            <div class="field">
              <span id="preferred-label">Preferred contact method</span>
              <div class="opt-stack" style="margin-top:.4rem" role="radiogroup" aria-labelledby="preferred-label">
                <label class="opt">
                  <input type="radio" name="preferred" value="email" checked />
                  <span class="opt-main"><span class="opt-title">Email</span><span class="opt-desc">We reply to hello@visuails.com threads</span></span>
                </label>
                <label class="opt">
                  <input type="radio" name="preferred" value="whatsapp" />
                  <span class="opt-main"><span class="opt-title">WhatsApp</span><span class="opt-desc">Fastest — usually within the hour</span></span>
                </label>
              </div>
            </div>
            <button type="submit" class="btn btn-primary btn-block btn-lg" style="margin-top:1.2rem">Send message</button>
            <p style="margin-top:.8rem;font-size:.8rem;color:var(--ink-3)">Looking for quick answers? Check the <a href="/faq" style="color:var(--accent-bright);text-decoration:underline">FAQ</a> first.</p>
          </form>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section-tight">
    <div class="container">
      <div class="cta-band reveal pending">
        <h2 class="display" style="font-size:clamp(2rem,4.5vw,3.2rem)">Rather have <em>one of your own products</em> delivered in full first?</h2>
        <p class="lead" style="margin:1.2rem auto 0;text-align:center">One photo in, a finished visual out. See it on your product for {SAMPLE.price} first.</p>
        <div class="flex" style="justify-content:center;margin-top:2rem">
          <a href="/test-sample" class="btn btn-primary btn-lg">Test sample</a>
          <a href="/pricing" class="btn btn-ghost btn-lg">See pricing</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Contact-page-only: vertical stack spacing for the left column. The
     form-field system (.field, .req, .input, .select, .textarea, .opt*) is in
     global.css — this page was one of five carrying its own copy. */
  .contact-stack > * + * { margin-top: 1.2rem; }

  /* The radio group is announced by a <span>, not a <label>: a <label> would
     point at one control instead of at the group. It still has to look like a
     field label, which is the one thing global.css cannot say for it. */
  .field span#preferred-label { font-size: .88rem; font-weight: 600; color: var(--ink); }
</style>
