---
// VISUAILS — /how-it-works (English). The page body lives in
// HowItWorksPage.astro so that /how-it-works and /nl/how-it-works cannot drift
// apart; only the meta differs here.
//
// AUDIT-TASK-0.md §F: "REWRITE. 'One photo in. A campaign out.' → drop-shaped.
// All ~24h claims corrected." §B·3: "'One photo in' is the per-product story;
// the drop story is 'one folder in'." The old description promised delivery
// "in about 24 hours" — task #190 retires that claim, so the timing here comes
// from turnaround() like every other timing string on the site.
import Layout from '../layouts/Layout.astro';
import HowItWorksPage from '../components/HowItWorksPage.astro';
//
// The old last clause named a package band — "for 25–30 products" — which is
// the offer section 0 of src/data/pricing.js retired. The count that matters
// on a page about PROCESS is not a package size, it is the one where the
// process changes: from WINDOW_THRESHOLD products an order is booked into the
// capacity calendar and gets the reserved window.
import { WINDOW_THRESHOLD } from '../data/pricing.js';

const description =
  `You send the products. We check capacity, confirm a delivery date, then produce ` +
  `and hand-check every visual. From ${WINDOW_THRESHOLD} products, the delivery date ` +
  `is reserved.`;
---

<Layout title="How it works — VISUAILS" description={description}>
  <HowItWorksPage lang="en" />
</Layout>
