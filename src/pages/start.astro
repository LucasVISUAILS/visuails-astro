---
// VISUAILS — /start (English). The page body lives in StartPage.astro so that
// /start and /nl/start cannot drift apart; only the meta differs here.
//
// This used to be the order form itself, and the description said so: "one way
// in, whatever the size." There are six ways in — three that check out and
// three that do not yet — and pretending otherwise is what left video off the
// only page whose job is to take an order. /start is the chooser now; each
// service owns its own route under /start/.
import Layout from '../layouts/Layout.astro';
import StartPage from '../components/StartPage.astro';
import { WINDOW_THRESHOLD } from '../data/pricing.js';

/* ONDER DE 160 TEKENS, en dat is geteld en niet geschat: tests/nav.test.mjs meet
   elke gebouwde pagina. Google kapt daarboven af met een beletselteken, en dan is
   het de LAATSTE zin die wegvalt — hier de zin over de gereserveerde leverdatum,
   precies het argument dat iemand over de streep trekt. Het interpolatiegetal
   telt mee, dus de marge is niet nul: WINDOW_THRESHOLD kan tweecijferig worden. */
const description =
  `Catalog sets, lifestyle carousels, or both. The rate per product falls as the ` +
  `count rises, and from ${WINDOW_THRESHOLD} products your delivery date is reserved.`;
---

<Layout
  title="Start an order — VISUAILS"
  description={description}
>
  <StartPage lang="en" />
</Layout>
