---
import { waHref } from '../data/whatsapp.js';
// VISUAILS — Gallery. v2 redesign: almost entirely the real photo library
// in a grid (see IMAGES.md) instead of ProductScene placeholders. Filter
// categories map to the real photo categories that exist (banners + the 4
// lifestyle styles) rather than an old catalog/lifestyle/video split, since
// there's no real catalog photography in the library (see IMAGES.md).
// Ported from /tmp/visuails-rebuild/src/routes/gallery/+page.svelte.
import { readdirSync } from 'node:fs';
import path from 'node:path';
import Layout from '../layouts/Layout.astro';
import { TEST_SAMPLE } from '../data/pricing.js';

// The test-sample fee was typed here too. It is a tier fact, so it comes from
// pricing.js — see src/pages/test-sample.astro for the same correction.
const SAMPLE = TEST_SAMPLE.en;
/* De Compare-import is weg met het before/after-blok; zie de noot verderop.
   CatalogPage.astro gebruikt de component nog wel. */

// Intrinsic pixel size of every photo in the grid, read off the files in
// public/img — NOT the size it renders at (.photo-grid pins aspect-ratio 4/5,
// .wide runs free). The library was produced in batches, so a family mostly
// shares one size; grouping by size keeps the odd ones out visible instead of
// buried in 38 near-identical lines. An unlisted src throws at build time,
// which is the point: a new photo cannot ship without its box.
const INTRINSIC: Record<string, [number, number]> = Object.fromEntries(
  ([
    [[928, 1152], ['banners-01', 'banners-02', 'banners-03', 'banners-04', 'banners-05', 'banners-06', 'banners-07', 'banners-08', 'lifestyle-dunes-01', 'lifestyle-dunes-02', 'lifestyle-flash-01']],
    [[1340, 2400], ['lifestyle-flash-02', 'lifestyle-flash-03', 'lifestyle-glow-01']],
    [[768, 1376], ['lifestyle-glow-03']],
    [[1200, 896], ['lifestyle-glow-04']],
    [[2400, 1792], ['lifestyle-flash-04', 'lifestyle-flash-05', 'lifestyle-flash-06', 'lifestyle-flash-07', 'lifestyle-flash-08', 'lifestyle-glow-02', 'lifestyle-glow-05', 'lifestyle-glow-06', 'lifestyle-phone-made-01', 'lifestyle-phone-made-02', 'lifestyle-phone-made-03', 'lifestyle-phone-made-04', 'lifestyle-phone-made-05', 'lifestyle-phone-made-06', 'lifestyle-phone-made-07', 'lifestyle-phone-made-08', 'lifestyle-phone-made-09', 'lifestyle-phone-made-10', 'lifestyle-phone-made-11', 'lifestyle-phone-made-12', 'lifestyle-phone-made-13', 'lifestyle-phone-made-14']],
  ] as Array<[[number, number], string[]]>).flatMap(([wh, names]) => names.map((n) => [`/img/${n}.webp`, wh] as const)),
);

const photos = [
  ...Array.from({ length: 8 }, (_, i) => ({ src: `/img/banners-0${i + 1}.webp`, tag: 'campaign', alt: `Campaign photography ${i + 1}` })),
  { src: '/img/lifestyle-dunes-01.webp', tag: 'dunes', alt: 'Dunes-style lifestyle visual' },
  { src: '/img/lifestyle-dunes-02.webp', tag: 'dunes', alt: 'Dunes-style lifestyle visual' },
  ...Array.from({ length: 8 }, (_, i) => ({ src: `/img/lifestyle-flash-0${i + 1}.webp`, tag: 'flash', alt: `Flash-style lifestyle visual ${i + 1}` })),
  ...Array.from({ length: 6 }, (_, i) => ({ src: `/img/lifestyle-glow-0${i + 1}.webp`, tag: 'glow', alt: `Glow-style lifestyle visual ${i + 1}` })),
  ...Array.from({ length: 14 }, (_, i) => ({ src: `/img/lifestyle-phone-made-${String(i + 1).padStart(2, '0')}.webp`, tag: 'phone-made', alt: `Phone-made-style lifestyle visual ${i + 1}` })),
].map((p, i) => ({ ...p, wide: i % 7 === 0, w: INTRINSIC[p.src][0], h: INTRINSIC[p.src][1] }));

/*
 * ── SRCSET, EN WAAROM DE MAAT GEMETEN IS ───────────────────────────────────
 *
 * Deze galerij leverde elke foto op zijn volle grootte uit: 2400px in een vakje
 * van 375. Gemeten met de netwerklaag en niet met een optelsom — Chromium,
 * /gallery, telefoon van 390px: 3,12 MB aan beeld VOORDAT er gescrold is. Op een
 * desktop van 1440 was dat 0,79 MB, en dat verschil is precies verkeerd om: de
 * trager verbonden bezoeker betaalde het meest. Doorgescrold was de pagina 9,03 MB.
 *
 * DE MATEN KOMEN UIT DE BROWSER en niet uit de CSS. Elf vensterbreedtes van 360
 * tot 2560: een gewone cel wordt nooit breder dan 375 CSS px, een `.wide` nooit
 * breder dan 766. Boven 1280 groeit er niets meer, want het raster zit dan tegen
 * de max-width van de container. Maal twee voor retina: 760 en 1560. Dezelfde
 * rekenregel als in scripts/make-thumbs.mjs, dat de bestanden maakt.
 *
 * `sizes` STAAT ERBIJ EN IS GEEN DECORATIE. Zonder die regel gaat de browser uit
 * van de volle vensterbreedte en kiest hij alsnog de grootste kandidaat — dan is
 * een srcset een langere regel html zonder effect.
 *
 * EEN DERIVAAT DAT ER NIET IS, WORDT NIET GENOEMD. Er wordt op schijf gekeken en
 * niet aangenomen; staat een maat er niet, dan blijft de srcset korter en valt de
 * browser terug op het origineel. Dat is met opzet geen fout: de 928px-familie
 * hoort geen 760px-derivaat te hebben (zie de noot in make-thumbs.mjs), en een
 * srcset die naar een 404 wijst, is erger dan geen srcset.
 */
/* Via process.cwd() en niet via import.meta.url: dit bestand wordt tijdens de
   build vanuit dist/ uitgevoerd, en dan wijst een relatief pad naar
   dist/public/img — dat bestaat niet en de build viel erop om. De werkmap is de
   projectmap, bij `astro build` en bij `astro dev` allebei. */
const OP_SCHIJF = new Set(readdirSync(path.join(process.cwd(), 'public', 'img')));

/** De srcset voor deze foto, of '' als er geen enkele kleinere maat bestaat. */
function srcset(src: string, breed: boolean, echteBreedte: number) {
  const basis = src.replace(/^\/img\//, '').replace(/\.webp$/, '');
  const maten = (breed ? [380, 760, 1560] : [380, 760]).filter((w) => OP_SCHIJF.has(`${basis}-w${w}.webp`));
  if (!maten.length) return '';
  return maten
    .map((w) => `/img/${basis}-w${w}.webp ${w}w`)
    .concat(`${src} ${echteBreedte}w`)
    .join(', ');
}

/* Gemeten CSS-breedtes, als `sizes`. Onder 640px is het raster één kolom en is
   de cel dus zo breed als het venster min de marge van de container; daarboven
   staat hij vast op wat hierboven gemeten is. */
/* Drie stops en niet twee, omdat het raster dat ook heeft. Gemeten in Chromium:
   een gewone cel is 171 CSS px op een telefoon van 390, 244 op een tablet van 768,
   en nooit breder dan 375 daarboven. Een brede cel is het dubbele plus de tussen-
   ruimte. Deze regel is wat de browser laat kiezen; zonder klopt de srcset wel en
   werkt hij niet. */
const SIZES_GEWOON = '(max-width: 480px) 45vw, (max-width: 900px) 32vw, 375px';
const SIZES_BREED = '(max-width: 480px) 92vw, (max-width: 900px) 66vw, 766px';

const filters = [
  { key: 'all', label: 'All' },
  { key: 'campaign', label: 'Campaign' },
  { key: 'dunes', label: 'Dunes' },
  { key: 'flash', label: 'Flash' },
  { key: 'glow', label: 'Glow' },
  { key: 'phone-made', label: 'Phone-made' },
];
---

<Layout
  title="VISUAILS — A look at the styles we produce"
  description="The real VISUAILS photo library — campaign, Dunes, Flash, Glow and Phone-made lifestyle visuals. See the range, then start with a test sample."
>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow-page">Gallery</p>
      <h1 class="display" style="font-size:clamp(2.4rem,5vw,4rem)">A look at the styles we produce</h1>
      <div class="flex" style="margin-top:1.8rem">
        <a href="/test-sample" class="btn btn-primary btn-lg">Test sample</a>
        <a href="/start" class="btn btn-ghost btn-lg">Start an order</a>
      </div>
    </div>
  </section>

  <!-- THE LIBRARY -->
  <section>
    {/* WIJDER DAN DE REST, en dat is het hele punt van deze pagina: hier gaat het
        over de foto's en niet over de tekst ernaast. In 1240px is dit raster vier
        kolommen van 280; in 1600 zijn het er vijf van 300. Zie de ladder bij
        --container in src/styles/global.css voor waarom er drie maten zijn en
        niet één. */}
    <div class="container wide">
      <div class="filter-bar" role="group" aria-label="Filter styles">
        {filters.map((f) => (
          <button type="button" data-filter-key={f.key} aria-pressed={f.key === 'all' ? 'true' : 'false'}>{f.label}</button>
        ))}
      </div>

      <div class="photo-grid" data-filterable>
        {photos.map((p) => (
          <img
            src={p.src}
            srcset={srcset(p.src, p.wide, p.w) || undefined}
            sizes={srcset(p.src, p.wide, p.w) ? (p.wide ? SIZES_BREED : SIZES_GEWOON) : undefined}
            alt={p.alt}
            loading="lazy"
            decoding="async"
            width={p.w}
            height={p.h}
            class={p.wide ? 'wide' : ''}
            data-tag={p.tag}
          />
        ))}
      </div>
    </div>
  </section>

  {/*
    ═══════════════════════════════════════════════════════════════════════════════
    HET "BEFORE & AFTER"-BLOK IS WEG — 10 augustus 2026
    ═══════════════════════════════════════════════════════════════════════════════

    Hier stonden vier Compare-schuivers onder de kop "Before & after", met de belofte
    *"A flat input becomes a finished VISUAILS visual"*. Alle vier hadden HETZELFDE
    bestand als `before` en als `after`, met een CSS-filter op de linkerhelft. Het
    commentaar erboven gaf dat zelf toe: plaatshouders tot er echte paren geschoten zijn.

    WAAROM DAT NIET KAN BLIJVEN STAAN. Dit is een resultaatclaim met geënsceneerd bewijs,
    op precies de pagina waar een merk komt om te controleren of het echt is. Het eerste
    ontwerpprincipe van dit merk luidt "Never borrow credibility we haven't earned", en
    IMAGES.md:36 zegt zelf dat er "one real before/after pair" bestaat — één, op de hele
    site. Juridisch is een bewerkt "voor"-beeld naast een "na"-beeld van hetzelfde bestand
    een misleidende handelspraktijk (art. 6:193c BW). Commercieel is het erger: als iemand
    het doorheeft, is alles wat er verder staat ook verdacht.

    Een lege plek is eerlijker dan geënsceneerd bewijs. Zodra er vier echte paren zijn —
    een middag werk, en meer waard dan de rest van deze pagina bij elkaar — komt dit blok
    terug met de echte bestanden en ZONDER `grade`.

    De <Compare>-component blijft bestaan en wordt elders gebruikt; er is niets gesloopt
    dat straks opnieuw gebouwd moet worden.
  */}

  <!-- CLOSING CTA -->
  <section class="section-tight">
    <div class="container">
      <div class="cta-band reveal pending">
        <h2 class="display" style="font-size:clamp(2.2rem,5vw,3.6rem)">See your own product<br />in <em>this range.</em></h2>
        <p class="lead" style="margin:1.2rem auto 0;text-align:center">Start with a test sample — one per business, just a {SAMPLE.feeNote}.</p>
        <div class="flex" style="justify-content:center;margin-top:2rem">
          <a href="/test-sample" class="btn btn-primary btn-lg">Test sample</a>
          <a href="/start" class="btn btn-ghost btn-lg">Start an order</a>
          <a href={waHref("Hi VISUAILS, I'd like to see a sample for my product.")} class="btn btn-wa" target="_blank" rel="noopener">
            WhatsApp
          </a>
        </div>
      </div>
    </div>
  </section>

  <script>
    import gsap from 'gsap';
    // Client-side filter — the Svelte source used $state/$derived; this is
    // the vanilla equivalent. Re-inits on astro:page-load so it survives
    // ClientRouter view-transition navigations (see Layout.astro).
    //
    // The filter change is a crossfade rather than the synchronous
    // `display: none` flip it used to be: leavers fade and settle back a
    // fraction, the grid re-lays-out at the moment they are invisible, then the
    // arrivals fade up. Opacity and transform only — no layout property is
    // animated, so the whole thing composites on the GPU and never triggers a
    // reflow mid-tween. The display swap that DOES reflow happens once, at the
    // seam, when nothing is mid-motion.
    //
    // DEVIATION FROM BRIEF §8, flagged deliberately: §8 asks for a "WebGL
    // crossfade on filter change". This is not WebGL. Doing it in WebGL means
    // uploading up to 38 grid photos as textures and running a second GL
    // context alongside the hero chrome shader, on the one page whose LCP is
    // already a wall of images — against a budget of "LCP under 2.5s on mobile
    // 4G WITH the shader running". The visible result of a texture crossfade
    // and a composited opacity crossfade is the same 300ms dissolve. Raised
    // with the client rather than silently substituted.
    const FADE_OUT = 0.26;
    const FADE_IN = 0.42;

    function initGalleryFilter() {
      const grid = document.querySelector<HTMLElement>('.photo-grid[data-filterable]');
      const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-bar button[data-filter-key]');
      if (!grid || !buttons.length) return;
      // Bound per grid element, not per module: this file runs once at parse
      // AND again on the astro:page-load that follows it, which would
      // otherwise stack two click handlers on every pill.
      if (grid.dataset.filterBound) return;
      grid.dataset.filterBound = '1';

      const photos = Array.from(grid.querySelectorAll<HTMLImageElement>('img'));
      const shown = (img: HTMLImageElement) => img.style.display !== 'none';
      const wanted = (img: HTMLImageElement, key: string) => key === 'all' || img.dataset.tag === key;
      // The timeline in flight, if any. Impatient clicking is the normal way to
      // use a filter bar, so an interrupted transition is a first-class case,
      // not an edge case: killing only the tweens (gsap.killTweensOf) is NOT
      // enough, because the display swap is a timeline CALLBACK, not a tween.
      // It would survive the kill, fire late against a filter set that no
      // longer applies, and hide photos the current filter wants — five fast
      // clicks emptied the grid completely. The whole timeline is killed.
      let flight: gsap.core.Timeline | null = null;

      const apply = (key: string) => {
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (flight) { flight.kill(); flight = null; }
        gsap.killTweensOf(photos);

        const keep = photos.filter((img) => wanted(img, key));
        const leaving = photos.filter((img) => shown(img) && !wanted(img, key));
        const entering = keep.filter((img) => !shown(img));
        // Already-visible keepers are force-reset rather than left alone: an
        // interrupted fade could have parked one at opacity .3, and a photo
        // that is staying on screen must be at full strength, always. This is
        // the invariant that keeps a filter click from ever dimming the grid.
        gsap.set(keep.filter(shown), { clearProps: 'opacity,transform' });
        if (!leaving.length && !entering.length) return;

        const swap = () => {
          leaving.forEach((img) => { img.style.display = 'none'; });
          entering.forEach((img) => { img.style.display = ''; });
          gsap.set(leaving, { clearProps: 'opacity,transform' });
        };

        if (reduce) {
          swap();
          gsap.set(entering, { clearProps: 'opacity,transform' });
          return;
        }

        const tl = gsap.timeline({ onComplete: () => { flight = null; } });
        flight = tl;
        if (leaving.length) {
          tl.to(leaving, {
            opacity: 0, scale: 0.96, duration: FADE_OUT, ease: 'power2.out',
            stagger: { each: 0.018, from: 'start' },
          }, 0);
        }
        tl.add(swap);
        if (entering.length) {
          tl.set(entering, { opacity: 0, scale: 0.96 })
            .to(entering, {
              opacity: 1, scale: 1, duration: FADE_IN, ease: 'power3.out',
              stagger: { each: 0.022, from: 'start' },
              clearProps: 'opacity,transform',
            });
        }
      };

      buttons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const key = btn.dataset.filterKey || 'all';
          buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
          apply(key);
        });
      });
    }
    initGalleryFilter();
    document.addEventListener('astro:page-load', initGalleryFilter);
  </script>
</Layout>

<style>
  /* Gallery-page-only patterns: filter pills. The tile grid itself is the
     shared .photo-grid pattern from global.css. */
  .filter-bar { display: flex; flex-wrap: wrap; gap: .6rem; margin-bottom: 1.8rem; }
  /* Filter chips are pressed, so they take the button shape. */
  .filter-bar button { border-radius: var(--r-pill); font: inherit; cursor: pointer; color: var(--ink-2); background: transparent; border: 1px solid var(--line); padding: .5rem 1.1rem; font-size: .9rem; font-weight: 500; transition: border-color var(--dur-1) var(--ease), color var(--dur-1) var(--ease), background var(--dur-1) var(--ease); }
  .filter-bar button:hover { color: var(--ink); border-color: var(--accent-line); }
  .filter-bar button[aria-pressed="true"] { color: var(--accent-on); background: var(--accent); border-color: transparent; }
</style>
