---
// VISUAILS — Gallery. v2 redesign: almost entirely the real photo library
// in a grid (see IMAGES.md) instead of ProductScene placeholders. Filter
// categories map to the real photo categories that exist (banners + the 4
// lifestyle styles) rather than an old catalog/lifestyle/video split, since
// there's no real catalog photography in the library (see IMAGES.md).
// Ported from /tmp/visuails-rebuild/src/routes/gallery/+page.svelte.
import Layout from '../layouts/Layout.astro';
import { TEST_SAMPLE } from '../data/pricing.js';

// The test-sample fee was typed here too. It is a tier fact, so it comes from
// pricing.js — see src/pages/test-sample.astro for the same correction.
const SAMPLE = TEST_SAMPLE.en;
import Compare from '../components/Compare.astro';

const photos = [
  ...Array.from({ length: 8 }, (_, i) => ({ src: `/img/banners-0${i + 1}.webp`, tag: 'campaign', alt: `Campaign photography ${i + 1}` })),
  { src: '/img/lifestyle-dunes-01.webp', tag: 'dunes', alt: 'Dunes-style lifestyle visual' },
  { src: '/img/lifestyle-dunes-02.webp', tag: 'dunes', alt: 'Dunes-style lifestyle visual' },
  ...Array.from({ length: 8 }, (_, i) => ({ src: `/img/lifestyle-flash-0${i + 1}.webp`, tag: 'flash', alt: `Flash-style lifestyle visual ${i + 1}` })),
  ...Array.from({ length: 6 }, (_, i) => ({ src: `/img/lifestyle-glow-0${i + 1}.webp`, tag: 'glow', alt: `Glow-style lifestyle visual ${i + 1}` })),
  ...Array.from({ length: 14 }, (_, i) => ({ src: `/img/lifestyle-phone-made-${String(i + 1).padStart(2, '0')}.webp`, tag: 'phone-made', alt: `Phone-made-style lifestyle visual ${i + 1}` })),
].map((p, i) => ({ ...p, wide: i % 7 === 0 }));

const filters = [
  { key: 'all', label: 'All' },
  { key: 'campaign', label: 'Campaign' },
  { key: 'dunes', label: 'Dunes' },
  { key: 'flash', label: 'Flash' },
  { key: 'glow', label: 'Glow' },
  { key: 'phone-made', label: 'Phone-made' },
];
---

<Layout
  title="VISUAILS — A look at the styles we produce"
  description="The real VISUAILS photo library — campaign, Dunes, Flash, Glow and Phone-made lifestyle visuals. Get a feel for the range, then start with a test sample."
>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow-page">Gallery</p>
      <h1 class="display" style="font-size:clamp(2.4rem,5vw,4rem)">A look at the styles we produce</h1>
      <div class="flex" style="margin-top:1.8rem">
        <a href="/test-sample" class="btn btn-primary btn-lg">Test sample</a>
        <a href="/start" class="btn btn-ghost btn-lg">Start an order</a>
      </div>
    </div>
  </section>

  <!-- THE LIBRARY -->
  <section>
    <div class="container">
      <div class="filter-bar" role="group" aria-label="Filter styles">
        {filters.map((f) => (
          <button type="button" data-filter-key={f.key} aria-pressed={f.key === 'all' ? 'true' : 'false'}>{f.label}</button>
        ))}
      </div>

      <div class="photo-grid" data-filterable>
        {photos.map((p) => (
          <img src={p.src} alt={p.alt} loading="lazy" class={p.wide ? 'wide' : ''} data-tag={p.tag} />
        ))}
      </div>
    </div>
  </section>

  <!-- BEFORE / AFTER — PLACEHOLDERS. Grade-mode Compare shows the same photo
       flattened vs. finished until real raw-photo → final pairs are shot.
       When they land, replace each item's before/after with the real pair
       (and drop `grade`). -->
  <section class="section-tight">
    <div class="container">
      <div class="section-head" style="text-align:center;margin-inline:auto">
        <h2>Before &amp; after.</h2>
        <p style="margin-inline:auto">A flat input becomes a finished VISUAILS visual — it plays itself, no dragging.</p>
      </div>
      <div class="compare-grid reveal-group" style="margin-top:2rem">
        <div class="reveal pending"><Compare grade before="/img/lifestyle-glow-01.webp" after="/img/lifestyle-glow-01.webp" beforeAlt="A flat, ungraded product scene" afterAlt="The finished Glow visual" beforeLabel="Flat" afterLabel="Glow" /></div>
        <div class="reveal pending"><Compare grade before="/img/lifestyle-flash-02.webp" after="/img/lifestyle-flash-02.webp" beforeAlt="A flat, ungraded product scene" afterAlt="The finished Flash visual" beforeLabel="Flat" afterLabel="Flash" /></div>
        <div class="reveal pending"><Compare grade before="/img/lifestyle-phone-made-11.webp" after="/img/lifestyle-phone-made-11.webp" beforeAlt="A flat, ungraded product scene" afterAlt="The finished Phone-made visual" beforeLabel="Flat" afterLabel="Phone-made" /></div>
        <div class="reveal pending"><Compare grade before="/img/lifestyle-dunes-01.webp" after="/img/lifestyle-dunes-01.webp" beforeAlt="A flat, ungraded product scene" afterAlt="The finished Dunes visual" beforeLabel="Flat" afterLabel="Dunes" /></div>
      </div>
    </div>
  </section>

  <!-- CLOSING CTA -->
  <section class="section-tight">
    <div class="container">
      <div class="cta-band reveal pending">
        <h2 class="display" style="font-size:clamp(2.2rem,5vw,3.6rem)">See your own product<br />in <em>this range.</em></h2>
        <p class="lead" style="margin:1.2rem auto 0;text-align:center">Start with a test sample — one per business, just a {SAMPLE.price} verification.</p>
        <div class="flex" style="justify-content:center;margin-top:2rem">
          <a href="/test-sample" class="btn btn-primary btn-lg">Test sample</a>
          <a href="/start" class="btn btn-ghost btn-lg">Start an order</a>
          <a href="https://wa.me/31625436130?text=Hi%20VISUAILS%2C%20I%27d%20like%20to%20see%20a%20sample%20for%20my%20product." class="btn btn-wa" target="_blank" rel="noopener">
            <svg class="i" viewBox="0 0 24 24"><path d="M21 11.5a8.38 8.38 0 0 1-8.5 8.5 8.5 8.5 0 0 1-4-1L3 20l1.5-4.5A8.38 8.38 0 0 1 3.5 11 8.5 8.5 0 0 1 12 3a8.38 8.38 0 0 1 8.5 8.5z"/></svg>
            WhatsApp
          </a>
        </div>
      </div>
    </div>
  </section>

  <script>
    // Client-side filter — the Svelte source used $state/$derived; this is
    // the vanilla equivalent. Re-inits on astro:page-load so it survives
    // ClientRouter view-transition navigations (see Layout.astro).
    function initGalleryFilter() {
      const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-bar button[data-filter-key]');
      const photos = document.querySelectorAll<HTMLImageElement>('.photo-grid[data-filterable] img');
      if (!buttons.length) return;
      buttons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const key = btn.dataset.filterKey;
          buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
          photos.forEach((img) => {
            const show = key === 'all' || img.dataset.tag === key;
            img.style.display = show ? '' : 'none';
          });
        });
      });
    }
    initGalleryFilter();
    document.addEventListener('astro:page-load', initGalleryFilter);
  </script>
</Layout>

<style>
  /* Gallery-page-only patterns: filter pills. The tile grid itself is the
     shared .photo-grid pattern from global.css. */
  .filter-bar { display: flex; flex-wrap: wrap; gap: .6rem; margin-bottom: 1.8rem; }
  .filter-bar button { font: inherit; cursor: pointer; color: var(--ink-2); background: transparent; border: 1px solid var(--line); padding: .5rem 1.1rem; font-size: .9rem; font-weight: 500; transition: border-color var(--dur-1) var(--ease), color var(--dur-1) var(--ease), background var(--dur-1) var(--ease); }
  .filter-bar button:hover { color: var(--ink); border-color: var(--accent-line); }
  .filter-bar button[aria-pressed="true"] { color: var(--accent-on); background: var(--accent); border-color: transparent; }
</style>
