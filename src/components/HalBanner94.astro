---
/**
 * VISUAILS — de bannervideo bovenaan de voorpagina (levering 94, 12 november 2026, lijst 92; opnieuw opgezet in levering
 * 95, 13 november, lijst 94). Het waarom staat in src/data/banner94.js; de opmaak in src/styles/banner-94.css.
 *
 * LEVERING 95 (lijst 94: A1 b, A2 a, A3 a, A4, A5 a). Lucas: "sommige teksten zijn nog niet goed leesbaar", "je hebt soms
 * niet genoeg tijd om de uitleg te lezen", "de knop hoeft niet te wisselen van kleur", en op zijn telefoon schoof de zin
 * onder de knop. Daarom:
 *   - Alleen de kop is nog een venster op de video (het negatief in blauw uur). Negatief werkt voor de grote, dikke kop;
 *     voor 15 px niet.
 *   - Alles wat je moet lezen (de vijf stappen, de zin, de knoppen) staat op één wit vlak rechtsonder, in inkt. Op de
 *     telefoon staat het onder de video op de grond: eerst het beeld, dan de uitleg, dan de knop. Niets ligt over elkaar.
 *   - De vijf stappen staan er altijd; de stap die nu speelt is inkt, met zijn zin en een balkje (stap 2 en 3 duren in de
 *     video maar 2,5 s, te kort om een zin te lezen).
 *   - Bestellen is altijd zwart. De lichtkaart (licht.bin) is weg.
 *
 * DE KOP IS EEN VENSTER OP DE VIDEO. Twee lagen, elk met een kopie van de kop:
 *   het gat     (mix-blend-mode: multiply): witte grond, zwarte letters      → de video, met de letters eruit gesneden (zwart)
 *   de vulling  (mix-blend-mode: screen):   het effect × [witte letters op zwart] → het effect, alleen in de letters
 * Zwart × iets = zwart en zwart + iets = iets: in de letters staat dus precies het effect, ernaast precies de video. Het effect
 * rekent de videokaart (WebGL: het negatief, de kaart uit banner94.js), alleen bij een nieuw beeld (24 keer per seconde).
 * Zonder WebGL doet een canvas met een svg-filter hetzelfde; zonder script staat de kop gewoon in inkt.
 *
 * LEVERING 114 (Lucas, 17 november 00:46, met kive.ai als voorbeeld "voor hoe de indeling dan wordt", niet het ontwerp):
 *   - de kop staat gecentreerd op de video, met de knoppen eronder; de nieuwe kop: "Your fashion brand deserves to be seen";
 *   - in de eerste scène gaat de telefoon over de kop heen: waar de telefoon (of de hand) staat, zie je de letters niet. Vanaf
 *     het product dat valt (4,25 s) staat de kop weer helemaal op de video. Hoe: zie "de telefoon over de kop" hieronder;
 *   - de stappen zijn een compacte balk onderaan in het midden: de vijf namen naast elkaar, elk met een balkje, en daaronder
 *     de zin van de stap die speelt. De zin over VISUAILS (T.zin) staat niet meer in de banner; het blok onder de video zegt
 *     wat VISUAILS doet.
 *
 * WAT ER NIET HAPERT. Er speelt één video: 1920 breed op een scherm dat meer dan 1400 (sinds levering 120: 1280) beeldpunten
 * breed tekent, anders 1280.
 * Hij pauzeert zodra de banner uit beeld is en speelt niet bij "minder beweging".
 *
 * LEVERING 120 (19 november 2026, lijst 130 en 132) · DE KOP IS GEWONE TEKST. Wat hierboven over het venster, het negatief,
 * de twee lagen, de telefoon over de kop en WebGL staat, geldt niet meer:
 *   - één titel in één maat (VISUAILS Display 2 Light, 300) met een korte beschrijving eronder (DM Sans), in html;
 *   - geen waas: de kleur van de tekst volgt de video. Ronde 2 (lijst 133, kleur a): de kop kiest zelf zwart of wit uit het
 *     licht achter de tekst, en wisselt zo weinig mogelijk (kopPlan in banner94.js). Per videobeeld uit de tijd van de
 *     video, dus na een sprong (een stap kiezen, laden, de lus) meteen goed;
 *   - de video staat zelf op het scherm (geen basisvlak meer) en zijn midden ligt in het midden van het vrije stuk onder de
 *     bovenbalk (banner-94.css);
 *   - de kop staat op een breed scherm links naast de telefoon (hij raakt hem niet), daaronder op de grond onder de video.
 */
import '../styles/banner-94.css';
import { BANNER, HOOFDSTUKKEN, DUUR } from '../data/banner94.js';
import { IKOON, rolIkoon } from '../data/iconen.js';
import { createHash } from 'node:crypto';
import { existsSync, readFileSync } from 'node:fs';
import path from 'node:path';

interface Props {
  lang: 'en' | 'nl';
  knop: { label: string; href: string; attrs?: Record<string, string> };
  /* de €1-proef naast Bestellen (alleen voor wie niet is ingelogd) en, voor een klant, de link naar Studio (tests/klant-stand) */
  link?: { label: string; href: string };
  klantLink?: { label: string; href: string };
}
const { lang, knop, link, klantLink } = Astro.props as Props;
const T = BANNER[lang];
/* het teken achter de bestanden: verandert de video, dan haalt elke browser hem opnieuw (/img/* staat zeven dagen) */
const h = createHash('sha1');
/* levering 118: ook de telefoonversie (banner-540.mp4) en het stille eindbeeld (eind-*.webp) */
for (const f of ['banner-540.mp4', 'banner-1280.mp4', 'banner-1920.mp4', 'poster-1280.webp', 'poster-1920.webp', 'eind-1280.webp', 'eind-1920.webp', 'telefoon-masker.webp']) {
  const p = path.join(process.cwd(), 'public', 'img', 'hal', 'banner', f);
  if (existsSync(p)) h.update(readFileSync(p));
}
const V = h.digest('hex').slice(0, 10);
const pad = (f: string) => `/img/hal/banner/${f}?v=${V}`;

const STAPPEN = T.stappen;
---
<section class="b94" data-b94 data-v={V} aria-labelledby="b94-h1">
  <div class="b94-beeld" data-b94-beeld>
    <video class="b94-video" data-b94-video muted playsinline loop preload="metadata" poster={pad('poster-1280.webp')}
           data-telefoon={pad('banner-540.mp4')} data-klein={pad('banner-1280.mp4')} data-groot={pad('banner-1920.mp4')}
           data-stil-klein={pad('eind-1280.webp')} data-stil-groot={pad('eind-1920.webp')} aria-label={T.video}></video>
  </div>

  {/* levering 120 (19 november 2026, lijst 130 en 132): de kop is gewone tekst, één titel in één maat en een korte
      beschrijving, in één kleur die met de video meeloopt (--b94-kleur, zie het script). Op een breed scherm staat hij links
      naast de telefoon op de video, op een smaller scherm op de grond onder de video (banner-94.css). */}
  <div class="b94-kopvak" data-b94-kop>
    <h1 id="b94-h1" class="b94-kop">{T.titel}</h1>
    <p class="b94-zin">{T.beschrijving}</p>
  </div>

  {/* het witte vlak (lijst 94, A2 a), sinds levering 114 een compacte balk onderaan in het midden: de vijf stappen naast
      elkaar, en daaronder de zin van de stap die speelt (alles in inkt, op wit: leesbaar op elke scène van de video) */}
  <div class="b94-paneel">
    <p class="b94-hoek" id="b94-hoek">{T.hoek}</p>
    <div class="b94-rij">
      <ol class="b94-stappen" aria-labelledby="b94-hoek">
        {STAPPEN.map(([naam, zin], i) => (
          <li class={`b94-st${i === 0 ? ' b94-nu' : ''}`} data-b94-st>
            <button type="button" class="b94-ga" data-b94-ga={i} aria-label={T.naar(i + 1, naam)} aria-current={i === 0 ? 'step' : undefined}>
              <span class="b94-nr">0{i + 1}</span><span class="b94-naam">{naam}</span>
            </button>
            <p class="b94-tx">{zin}</p>
            <span class="b94-bj" aria-hidden="true"><b data-b94-vul></b></span>
          </li>
        ))}
      </ol>
      <button type="button" class="b94-pauze" data-b94-pauze aria-pressed="false" aria-label={T.pauze} data-uit={T.pauze} data-aan={T.speel}>
        <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true"><path class="b94-p-uit" fill-rule="evenodd" d={IKOON.pauze} /><path class="b94-p-aan" fill-rule="evenodd" d={IKOON.afspelen} /></svg>
      </button>
    </div>
    {/* de zin van de stap die speelt, zichtbaar; de zinnen zelf (.b94-tx) staan in de lijst voor een schermlezer */}
    <p class="b94-uitleg" data-b94-uitleg aria-hidden="true"><span class="b94-uitleg-naam" data-b94-uitleg-naam>{STAPPEN[0][0]}</span><span data-b94-uitleg-zin>{STAPPEN[0][1]}</span></p>
    {/* de knoppen (levering 114). Lucas, 00:59: "de €1 sample is amper zichtbaar": de €1-proef is een lijnknop (wit, even hoog
        als Bestellen), los ernaast (zonder snede, zonder-snede-99.css). 01:01: "Moeten
        die knoppen ook onder de telefoon komen, want dit ziet er wat apart uit": ze stonden onder de kop, midden in de weg van
        de telefoon. Nu staan ze rechts in de balk: de telefoon gaat alleen over de kop, de knoppen zijn altijd te zien. */}
    <div class="b94-actie">
      <p class="b94-knop h-acties">
        <a class="h-knop k k-vol" data-rol="doorgaan" href={knop.href} {...(knop.attrs || {})}><span data-vis-label>{knop.label}</span><Fragment set:html={rolIkoon('doorgaan')} /></a>
        {link && <a class="h-knop k k-lijn" data-rol="doorgaan" href={link.href} data-vis-uit>{link.label}<Fragment set:html={rolIkoon('doorgaan')} /></a>}
        {klantLink && <a class="h-knop k k-lijn" data-rol="doorgaan" href={klantLink.href} data-vis-klant-in hidden>{klantLink.label}<Fragment set:html={rolIkoon('doorgaan')} /></a>}
      </p>
    </div>
  </div>

  <script type="application/json" data-b94-data set:html={JSON.stringify({
    hoofdstukken: HOOFDSTUKKEN, duur: DUUR,
  })} />
</section>

<script>
  /* levering 120, ronde 2: het plan voor de kleur van de kop (het licht achter de kop is gemeten, zie banner94.js) */
  import { kopPlan } from '../data/banner94.js';
  type Data = { hoofdstukken: number[]; duur: number };
  let plan: ReturnType<typeof kopPlan> | null = null;
  let ruim: (() => void) | null = null, loopt: HTMLElement | null = null;
  function start() {
    const sec = document.querySelector<HTMLElement>('[data-b94]');
    /* astro:page-load komt ook bij het eerste laden: dezelfde banner niet twee keer starten (twee programma's op één videokaart) */
    if (sec && sec === loopt) return;
    ruim?.(); ruim = null; loopt = sec;
    if (!sec) { document.documentElement.classList.remove('b94-boven'); return; }
    const data = JSON.parse(sec.querySelector('[data-b94-data]')!.textContent || '{}') as Data;
    const beeld = sec.querySelector<HTMLElement>('[data-b94-beeld]')!;
    const vid = sec.querySelector<HTMLVideoElement>('[data-b94-video]')!;
    const pauze = sec.querySelector<HTMLButtonElement>('[data-b94-pauze]')!;
    const html = document.documentElement;
    const minder = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const weg: (() => void)[] = [];
    const opV = (t: string, f: () => void) => { vid.addEventListener(t, f); weg.push(() => vid.removeEventListener(t, f)); };
    const op = <K extends keyof WindowEventMap>(t: K, f: (e: WindowEventMap[K]) => void, o?: AddEventListenerOptions) => { window.addEventListener(t, f as EventListener, o); weg.push(() => window.removeEventListener(t, f as EventListener, o)); };

    /* ── levering 97: de cookiebalk (rechtsonder, alleen bij het eerste bezoek) viel op een breed scherm over Bestellen in het
       vlak. Zolang hij er staat, staan het vlak en de kop hoger: zijn hoogte plus 16 (zijn rand) plus 20 lucht. Weg = terug. ── */
    const cc = document.getElementById('cc-bar');
    if (cc) {
      const ccZet = () => { const h = !cc.hidden && cc.getBoundingClientRect().height; sec.style.setProperty('--b94-cc', h ? `${Math.ceil(h + 36)}px` : '0px'); };
      const ccRo = new ResizeObserver(ccZet); ccRo.observe(cc);
      const ccMo = new MutationObserver(ccZet); ccMo.observe(cc, { attributes: true, attributeFilter: ['hidden'] });
      ccZet(); weg.push(() => { ccRo.disconnect(); ccMo.disconnect(); });
    }

    /* ── de bovenbalk: helemaal bovenaan zonder wit en zonder rand, alleen de vervaging (lijst 94, A1 b) ── */
    const balk = () => html.classList.toggle('b94-boven', window.scrollY < 4);
    balk(); op('scroll', balk, { passive: true });

    /* ── de video: 1920 als het scherm meer dan 1280 beeldpunten breed tekent (tot levering 120: 1400), anders 1280 ── */
    /* LEVERING 118 (17 november 2026, proefronde T1-02): "Telefoon haalt 16 MB video op bij binnenkomst". Drie dingen:
       - op een staand scherm (de telefoon, het beeld smaller dan 0,9 × zijn hoogte) de telefoonversie banner-540.mp4: het
         midden van de video (810 × 1080 uit de 1920, verkleind naar 540 × 720), precies het stuk dat de telefoon toch laat
         zien (object-fit: cover), even scherp als de 1280 daar was. 2,1 MB in plaats van 9,8 MB;
       - preload "metadata" in plaats van "auto": de browser haalt op wat hij nodig heeft om te spelen, niet alles vooraf;
       - de bron pas zetten als hij gaat spelen (speel()), of als je een stap kiest. Wie minder beweging of databesparing
         aan heeft, haalt dus geen video op tot hij zelf op afspelen drukt.
       LEVERING 118 (proefronde P11-06): met minder beweging stond de banner op het eerste beeld van de video, en dat is wit.
       Nu staat er het stille eindbeeld (eind-*.webp: de jas bij de waterval, 18 s in de video, hoofdstuk 5) en tekent de kop
       daarop, net als op de video.
       LEVERING 120 (19 november 2026, lijst 132): "de video blijft van hoge kwaliteit". De video staat iets groter dan de banner
       als dat nodig is om zijn midden onder de bovenbalk te krijgen (banner-94.css); de keus telt daarom de maat waarop de
       video echt getekend wordt (cover: de grootste van de breedte en 16/9 × de hoogte van de video-tag), niet de banner. En
       de grens is 1280 (de breedte van de kleine video) in plaats van 1400: op 1366 breed werd de 1280 met 7 % vergroot. Nu
       is de video nooit groter getekend dan hij is (behalve de telefoonversie; zie notities-K.md, levering 120). */
    const dpr = Math.min(2, window.devicePixelRatio || 1);
    const staand = beeld.clientWidth < beeld.clientHeight * 0.9;
    const vr = vid.getBoundingClientRect();
    const getekend = Math.max(beeld.clientWidth, vr.width, vr.height * 16 / 9);
    const bron = (staand && beeld.clientWidth * dpr <= 1100 && vid.dataset.telefoon) ? vid.dataset.telefoon
      : (getekend * dpr > 1280 ? vid.dataset.groot : vid.dataset.klein) || '';
    const zuinig = !!(navigator as any).connection?.saveData;
    const STIL_T = 18;   /* het eindbeeld is de video op 18 s */
    const zetBron = () => { if (!vid.getAttribute('src') && bron) { vid.preload = 'metadata'; vid.src = bron; } };
    /* zolang het stille beeld er staat (als poster van de video), hoort de kop bij 18 s, ook als de video al een (wit) eerste
       beeld heeft */
    let stilVast = minder || zuinig;
    opV('error', () => { sec.classList.add('b94-geen'); });
    let handPauze = minder || zuinig;
    if (stilVast) {
      const s = (getekend * dpr > 1280 ? vid.dataset.stilGroot : vid.dataset.stilKlein) || '';
      vid.poster = s;
    }
    const losVanStil = () => { if (stilVast && !vid.paused) { stilVast = false; } };
    opV('playing', losVanStil); opV('seeked', () => { stilVast = false; });
    /* weigert de browser het afspelen (geen autoplay, stroombesparing), dan staat de knop op afspelen: de bezoeker start hem zelf */
    const speel = () => { if (!handPauze && zicht) { zetBron(); vid.play().catch(() => { handPauze = true; zetPauze(); }); } };
    let zicht = false;
    const io = new IntersectionObserver(([e]) => { zicht = e.isIntersecting; if (zicht) speel(); else vid.pause(); }, { threshold: 0.1 });
    io.observe(beeld); weg.push(() => io.disconnect());
    const zetPauze = () => {
      pauze.setAttribute('aria-pressed', String(handPauze));
      pauze.setAttribute('aria-label', handPauze ? pauze.dataset.aan || '' : pauze.dataset.uit || '');
      sec.classList.toggle('b94-stil', handPauze);
    };
    zetPauze();
    pauze.addEventListener('click', () => { handPauze = !handPauze; zetPauze(); if (handPauze) vid.pause(); else speel(); });

    /* ── de vijf stappen: de huidige in inkt, met zijn zin en zijn balkje ── */
    const sts = [...sec.querySelectorAll<HTMLElement>('[data-b94-st]')];
    const gas = [...sec.querySelectorAll<HTMLButtonElement>('[data-b94-ga]')];
    const vullen = [...sec.querySelectorAll<HTMLElement>('[data-b94-vul]')];
    /* levering 114: de zin van de stap die speelt staat onder de balk (de zinnen zelf staan in de lijst, voor een schermlezer) */
    const uitNaam = sec.querySelector<HTMLElement>('[data-b94-uitleg-naam]'), uitZin = sec.querySelector<HTMLElement>('[data-b94-uitleg-zin]');
    const zetUitleg = (i: number) => {
      const st = sts[i]; if (!st) return;
      if (uitNaam) uitNaam.textContent = st.querySelector('.b94-naam')?.textContent || '';
      if (uitZin) uitZin.textContent = st.querySelector('.b94-tx')?.textContent || '';
    };
    const H = data.hoofdstukken, N = H.length;
    let hs = 0;
    /* LEVERING 113 (Lucas, 16 november 20:45: "Bij de uitleg lijst kan je soms niet op elke stap klikken en gaat hij telkens
       naar stap 1"). De stap die speelt klapt open (zin en balkje) en de vorige klapt dicht; liep de video door terwijl je
       naar een stap wees, dan schoof de lijst onder je muis en klikte je op een andere stap. Nu staat de lijst stil zolang de
       muis erop staat (of de focus erin): de video loopt door, maar wat open is verandert pas als je de lijst verlaat, of
       als je zelf op een stap klikt. */
    const lijst = sec.querySelector<HTMLElement>('.b94-stappen');
    let vast = false;
    if (lijst) {
      const zet = (v: boolean) => { vast = v; if (!v) stapBij(); };
      const aan = () => zet(true), uit = () => zet(lijst.matches(':focus-within'));
      lijst.addEventListener('pointerenter', aan); lijst.addEventListener('pointerleave', uit);
      lijst.addEventListener('focusin', aan); lijst.addEventListener('focusout', () => setTimeout(() => zet(lijst.matches(':hover')), 0));
      weg.push(() => { lijst.removeEventListener('pointerenter', aan); lijst.removeEventListener('pointerleave', uit); });
    }
    /* LEVERING 113, de tweede oorzaak: de bestanden komen van Cloudflare zonder "Range" (gemeten op 16 november: een vraag om
       bytes 1000 – 1999 gaf 200 met het hele bestand). Dan kan de browser alleen springen naar een stuk dat al binnen is; vraag
       je om stap 5 terwijl de video pas tot stap 2 geladen is, dan begint hij weer bij 0, dus bij stap 1. Nu springt hij pas
       als dat stuk binnen is: tot dan staat de gekozen stap al open en wacht de video (meestal een fractie van een seconde). */
    let wacht = -1, wachtStap = -1;
    const binnen = (t: number) => { const b = vid.buffered; for (let k = 0; k < b.length; k++) if (t >= b.start(k) && t <= b.end(k) - 0.25) return true; return false; };
    function gaNaar(i: number) {
      /* levering 118: zonder bron (minder beweging, nog niet gespeeld) laadt de video pas nu, en dan wel helemaal */
      if (!vid.getAttribute('src')) { zetBron(); vid.preload = 'auto'; }
      const t = H[i] + 0.02;
      if (binnen(t) || (vid.seekable.length && vid.buffered.length === 0 && t < 0.5)) { wacht = -1; wachtStap = -1; vid.currentTime = t; bij(); stapBij(true); return; }
      wacht = t; wachtStap = i; zetStap(i); haalHeel();
    }
    opV('progress', () => { if (wacht >= 0 && binnen(wacht)) gaNaar(wachtStap); });
    /* Zodra de video speelt, halen we hem in zijn geheel op (meestal uit de cache van de browser, die hem toch al laadt) en
       spelen we verder vanuit het geheugen, op hetzelfde moment. Daarna is elke stap direct: alles is binnen.
       levering 120 (19 november 2026, lijst 132): het basisvlak (dat het laatste beeld vasthield) is weg. Daarom is het
       beeld van dat moment even de poster van de video (cover, dus op precies dezelfde plek), tot de video weer een beeld
       heeft; daarna weer de gewone poster. Zo is de wissel nog steeds niet te zien. */
    let heel = false;
    const vastBeeld = () => new Promise<string>((klaar) => {
      if (vid.readyState < 2 || !vid.videoWidth) return klaar('');
      try {
        const c = document.createElement('canvas'); c.width = vid.videoWidth; c.height = vid.videoHeight;
        c.getContext('2d')!.drawImage(vid, 0, 0);
        c.toBlob((b) => klaar(b ? URL.createObjectURL(b) : ''), 'image/jpeg', 0.92);
      } catch { klaar(''); }
    });
    const haalHeel = async () => {
      if (heel || !vid.currentSrc || vid.currentSrc.startsWith('blob:')) return; heel = true;
      try {
        const r = await fetch(vid.currentSrc); if (!r.ok) return;
        const url = URL.createObjectURL(await r.blob());
        if (!loopt || loopt !== sec) { URL.revokeObjectURL(url); return; }
        const oud = vid.getAttribute('poster') || '', vast = await vastBeeld();
        const t = vid.currentTime, liep = !vid.paused;
        if (vast) vid.poster = vast;
        vid.src = url; weg.push(() => URL.revokeObjectURL(url));
        await new Promise((klaar) => vid.addEventListener('loadedmetadata', klaar, { once: true }));
        if (vast) vid.addEventListener('seeked', () => setTimeout(() => { vid.poster = oud; URL.revokeObjectURL(vast); }, 250), { once: true });
        vid.currentTime = wacht >= 0 ? wacht : t;
        if (wacht >= 0) { wacht = -1; wachtStap = -1; }
        if (liep) speel();
      } catch { /* dan blijft het bij het wachten op het laden */ }
    };
    /* Alleen wie naar de stappen gaat (muis, toets of vinger) haalt de video heel op; de rest laadt hem niet dubbel. */
    const stappenVak = sec.querySelector<HTMLElement>('.b94-stappen');
    ['pointerenter', 'focusin', 'touchstart'].forEach((e) => stappenVak?.addEventListener(e, () => haalHeel(), { once: true, passive: true }));
    opV('timeupdate', () => { if (wacht >= 0 && binnen(wacht)) gaNaar(wachtStap); });
    function zetStap(i: number) {
      hs = i; zetUitleg(i);
      sts.forEach((s, k) => s.classList.toggle('b94-nu', k === i));
      gas.forEach((g, k) => { if (k === i) g.setAttribute('aria-current', 'step'); else g.removeAttribute('aria-current'); });
      vullen.forEach((b, k) => { b.style.transform = `scaleX(${k === i && wacht < 0 ? '1' : '0'})`; });
    }
