const c = COPY[lang];

// Stable, language-independent anchors for the group index. They live out here
// rather than inside COPY on purpose: an anchor is a URL, not copy, and a pair
// of them in two language branches is a pair that can drift. /faq#pricing has to
// land in the same place whichever language sent the visitor. The index link and
// the group it points at both read this one array, so the two cannot disagree
// about a name — which matters, because a fragment built at runtime is the one
// kind of href the link checkers can only report as unchecked, never verify.
//
// What they cannot cover is a group being added to COPY and not here: the extra
// group would render id={undefined} and its index entry would point at a
// "#undefined" that silently does nothing, on the page whose entire job is
// answering questions. So that case is a build error rather than a live bug.
// pricing.js throws on its own unknown-tier lookups for the same reason.
const GROUP_ANCHORS = ['getting-started', 'ordering', 'delivery', 'pricing', 'rights'];
if (GROUP_ANCHORS.length !== c.groups.length) {
  throw new Error(
    `FaqPage: ${c.groups.length} groups in the ${lang} COPY table but ` +
    `${GROUP_ANCHORS.length} anchors in GROUP_ANCHORS. Add the anchor.`
  );
}
---

<!-- HERO — a real photo beside a short line, not a text wall. -->
<section class="page-hero">
  <div class="container">
    <div class="photo-split reverse">
      <div class="photo-split-media">
        <img src="/img/lifestyle-flash-05.webp" alt={c.heroAlt} loading="lazy" />
      </div>
      <div>
        <h1 class="display" style="font-size:clamp(2.4rem,5vw,4rem)">{c.h1a}<em>{c.h1em}</em>{c.h1b}</h1>
        <p class="lead" style="margin-top:1rem">{c.lead}</p>
      </div>
    </div>
  </div>
</section>

<!-- THE ACCORDION -->
<section class="section-tight">
  <div class="container faq-narrow">

    {/* Twenty-one questions in five groups arrived as one uninterrupted grey
        column, and the way in was scrolling. This is the way in. It is real
        navigation rather than a device: the labels are the group headings that
        already exist below, so nothing here needs writing or translating, and
        the numbers are counted off g.items.length rather than typed, so a
        question added to a group cannot leave a stale figure standing above it.
        It also does what task #246 asked of this page at its head — the column
        no longer starts as a column. */}
    <nav class="faq-index" aria-label={c.indexLabel}>
      <ul class="faq-index-list">
        {c.groups.map((g, gi) => (
          <li>
            <a class="faq-index-link" href={`#${GROUP_ANCHORS[gi]}`}>
              <span class="faq-index-t">{g.title}</span>
              <span class="faq-index-n">{g.items.length}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>

    {c.groups.map((g, gi) => (
      <div class="faq-group" id={GROUP_ANCHORS[gi]}>
        <h2>{g.title}</h2>
        <div class="acc">
          {g.items.map((item) => (
            <details class="acc-item reveal pending">
              <summary class="acc-q">
                <span>{item.q}</span>
                <span class="acc-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" class="i" style="width:14px;height:14px"><path d="M12 5v14M5 12h14"/></svg>
                </span>
              </summary>
              <div class="acc-body-inner">
                {item.html ? <p set:html={item.html} /> : <p>{item.a}</p>}
                {item.photos ? (
                  <div class="acc-figs">
                    {item.photos.map((ph) => (
                      <figure class="acc-fig">
                        <img src={ph.src} alt={ph.alt} loading="lazy" />
                        <figcaption>{ph.cap}</figcaption>
                      </figure>
                    ))}
                  </div>
                ) : null}
                {item.linkText ? <p class="acc-more"><a href={lp(item.linkHref)} class="link-arrow">{item.linkText} <svg viewBox="0 0 24 24" class="i"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a></p> : null}
              </div>
            </details>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>

<!-- CTA -->
<section class="section-tight">
  <div class="container">
    <div class="cta-band reveal pending">
      <h2 class="display" style="font-size:clamp(2.2rem,5vw,3.6rem)">{c.ctaH}<em>{c.ctaEm}</em>{c.ctaH2}</h2>
      <p class="lead" style="margin:1.2rem auto 0;text-align:center">{c.ctaBody}</p>
      <div class="flex" style="justify-content:center;margin-top:2rem">
        <a href={lp('/test-sample')} class="btn btn-primary btn-lg" data-track="faq-sample">{c.ctaSample}</a>
        <a href={lp('/contact')} class="btn btn-ghost btn-lg">{c.ctaContact}</a>
        <a href={c.wa} class="btn btn-wa" target="_blank" rel="noopener">
          <svg class="i" viewBox="0 0 24 24"><path d="M21 11.5a8.38 8.38 0 0 1-8.5 8.5 8.5 8.5 0 0 1-4-1L3 20l1.5-4.5A8.38 8.38 0 0 1 3.5 11 8.5 8.5 0 0 1 12 3a8.38 8.38 0 0 1 8.5 8.5z"/></svg>
          WhatsApp
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  /* Narrower reading column + the accordion. Native <details>/<summary>, so
     keyboard and screen-reader behaviour is free. */
  .faq-narrow { max-width: 820px; }
  .faq-group + .faq-group { margin-top: clamp(2.4rem, 5vw, 3.4rem); }

  /* Scroll-margin, not a scroll-padding on the root: the sticky header is the
     Layout's problem and this page should not be reaching up to configure it.
     Without this the jump lands the group heading under the header and the
     reader arrives looking at the second question. */
  .faq-group { scroll-margin-top: clamp(5rem, 10vw, 7rem); }

  /* The index reads as a contents rule, which is what it is: two hairlines and
     a row of names, no cards, no chips, no pills. The count sits at the end of
     each row in --ink-3 so it is available without competing with the name. */
  .faq-index {
    border-top: 1px solid var(--line-strong);
    border-bottom: 1px solid var(--line-strong);
    margin-bottom: clamp(2.2rem, 5vw, 3.2rem);
  }
  .faq-index-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    column-gap: clamp(1.4rem, 4vw, 2.6rem);
  }
  .faq-index-link {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    padding: 0.85rem 0;
    font-size: 0.95rem;
    color: var(--ink-2);
    transition: color var(--dur-2) var(--ease);
  }
  .faq-index-link:hover { color: var(--ink); }
  .faq-index-t { border-bottom: 1px solid transparent; transition: border-color var(--dur-2) var(--ease); }
  .faq-index-link:hover .faq-index-t { border-bottom-color: var(--line-strong); }
  .faq-index-n { font-size: 0.8rem; color: var(--ink-3); font-variant-numeric: tabular-nums; }

  /* One answer's subject is "these two things look different". It is answered
     with the two things. Kept side by side at every width on purpose — stacked,
     they stop being a comparison and become two more pictures. */
  .acc-figs {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(0.6rem, 2vw, 1rem);
    margin-top: 1.2rem;
  }
  .acc-fig { margin: 0; }
  .acc-fig img {
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    background: var(--surface);
  }
  .acc-fig figcaption { margin-top: 0.5rem; font-size: 0.8rem; color: var(--ink-3); }

  /* .acc-item carries only a bottom rule, so without a rule here the first
     question of each group has no line above it and the list reads as
     unclosed at the top. This is the wrapper the old page was missing. */
  .acc { border-top: 1px solid var(--line); margin-top: clamp(1rem, 2vw, 1.4rem); }
  .acc-item { box-shadow: inset 0 -1px 0 var(--line); }
  .acc-item summary { list-style: none; cursor: pointer; }
  .acc-item summary::-webkit-details-marker { display: none; }
  .acc-item summary::marker { content: ''; }
  .acc-q { width: 100%; display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding: 1.35rem 0; text-align: left; font-family: var(--font-body); font-size: 1.05rem; font-weight: 600; color: var(--ink); }
  .acc-icon { flex: 0 0 auto; width: 28px; height: 28px; border: 1px solid var(--line-strong); color: var(--ink-3); display: grid; place-items: center; transition: transform var(--dur-2) var(--ease), background var(--dur-2) var(--ease), color var(--dur-2) var(--ease), border-color var(--dur-2) var(--ease); }
  .acc-item[open] .acc-icon { transform: rotate(45deg); background: var(--accent); border-color: var(--accent); color: var(--accent-on); }
  .acc-body-inner { padding-bottom: 1.35rem; color: var(--ink-2); max-width: 70ch; }
  .acc-body-inner a { color: var(--ink); text-decoration: underline; text-underline-offset: 2px; }
  .acc-more { margin-top: .8rem; }
  .acc-more a { text-decoration: none; }
</style>
