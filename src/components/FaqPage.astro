---
import { waHref } from '../data/whatsapp.js';
// VISUAILS — /faq, rewritten. AUDIT-TASK-0.md §F: "REWRITE selectively.
// Contains 'about €10 a photo' and 24h claims."
//
// What changed and why:
//   • Every price is interpolated from pricing.js. The old page typed them,
//     including a derived "about €10 a photo" that no longer holds and that
//     nothing would have caught if it drifted again.
//   • Every timing answer comes from turnaround(), one string per tier
//     (task #190). No answer on this page states a number of hours.
//   • The revision answer is gone, question and all. It said "three rounds
//     included as standard" with no qualifier — a promise the individual
//     -product route never made — and then, briefly, a count per tier. There
//     is no count on either tier now, so the question became "what if the
//     visuals are not right" and the answer is the check-in from pricing.js.
//   • The volume-discount answer described an offer that no longer exists.
//     Replaced with the true answer: the ladder IS the volume answer.
//   • The subscription answer said "no subscription" — the studio retainer
//     now exists, so that answer was factually wrong.
//   • A capacity-gate question was added. It is the site's most load-bearing
//     promise and the FAQ is where a sceptical buyer goes looking for it.
//   • The 4K claim is gone: the 4K export add-on was removed from /pricing,
//     so offering it here would sell something that cannot be bought.
//
// Markup note: the accordion is native <details>/<summary>, and the list now
// sits inside an .acc wrapper. Without it the first question has no rule above
// it (.acc-item carries only a bottom rule) and the group reads as unclosed at
// the top — the same fix PricingPage.astro documents.
//
// The last item under "Rights and usage" links to /ai-act. The question there
// is a fact question — are the visuals AI-generated — which we answer. It is
// deliberately not "do I have to disclose this", because that is the question
// /ai-act refuses to answer for a client, and asking it here would put the
// fear pitch back in through the door the brief closed.
//
// The twenty-one questions themselves are NOT in this file any more. They live
// in src/data/faq.js, because src/data/schema.js emits them a second time as
// this page's FAQPage JSON-LD and two copies of an answer is two answers that
// will eventually disagree. This component still owns everything around them
// — the hero, the index band, the accordion markup, the CTA.
import { faqPageGroups } from '../data/faq.js';
// De prijs van de proefvisual komt uit pricing.js en niet uit een getal dat
// hier ooit is ingetypt — zie de knop hieronder.
import { TEST_SAMPLE } from '../data/pricing.js';
import Disclose from './Disclose.astro';
import '../styles/stijl22.css';
import { localizedPath } from '../i18n/ui.js';

interface Props { lang: 'en' | 'nl'; }
const { lang } = Astro.props;
const lp = (p: string) => localizedPath(lang, p);

// The answer photos come from src/data/faq.js, which carries src/alt/cap and
// no size. Their intrinsic pixel size is recorded here — read off the files in
// public/img, not the box they render in — so the browser can reserve the
// aspect ratio before the bytes land (§12). An answer photo that is not on
// this list stops the build rather than shipping a width-less <img>.
const INTRINSIC: Record<string, [number, number]> = {
  '/img/catalog-after.webp': [1800, 1800],
  '/img/lifestyle-glow-06.webp': [2400, 1792],
};
const size = (src: string): [number, number] => {
  const d = INTRINSIC[src];
  if (!d) throw new Error(`FaqPage.astro: no intrinsic size on record for ${src} — add it to INTRINSIC.`);
  return d;
};

const COPY = {
  en: {
    h1a: 'Questions, ',
    h1em: 'answered',
    h1b: '.',
    // "How a drop works" — the word the pricing rewrite retired everywhere
    // else, still standing on the page whose whole job is to explain the
    // service in the customer's own words. A drop is a collection going live,
    // which is what the CLIENT does; what we sell is an order of products.
    lead: 'How an order works, what it costs, when it lands, and what happens if the week you need cannot be held. Still unsure? Message us on WhatsApp.',
    heroAlt: 'A VISUAILS lifestyle image',

    // The <nav> around the group index needs a name, and it is the only string
    // that index adds. Its labels are the group titles already below it and its
    // numbers are counted, so the whole band costs two words per language.
    indexLabel: 'Jump to a section',

    ctaH: 'Still have a ',
    ctaEm: 'question',
    ctaH2: '?',
    ctaBody: 'Message us on WhatsApp — usually a reply within an hour on weekdays.',
    ctaSample: TEST_SAMPLE.en.cta,
    ctaContact: 'Get in touch',
    wa: waHref("Hi VISUAILS, I have a question about your service."),
  },

  nl: {
    h1a: 'Vragen, ',
    h1em: 'beantwoord',
    h1b: '.',
    lead: 'Hoe een bestelling werkt, wat het kost, wanneer het er is, en wat er gebeurt als de week die je nodig hebt niet kan. Nog steeds onzeker? Stuur ons een bericht op WhatsApp.',
    heroAlt: 'Een VISUAILS lifestylefoto',

    indexLabel: 'Ga naar een onderdeel',

    ctaH: 'Nog een ',
    ctaEm: 'vraag',
    ctaH2: '?',
    ctaBody: 'Stuur ons een bericht op WhatsApp — meestal binnen een uur antwoord op werkdagen.',
    ctaSample: TEST_SAMPLE.nl.cta,
    ctaContact: 'Neem contact op',
    wa: waHref("Hoi VISUAILS, ik heb een vraag over jullie dienst."),
  },
};

const c = { ...COPY[lang], groups: faqPageGroups(lang) };

// Stable, language-independent anchors for the group index. They live out here
// rather than inside COPY on purpose: an anchor is a URL, not copy, and a pair
// of them in two language branches is a pair that can drift. /faq#pricing has to
// land in the same place whichever language sent the visitor. The index link and
// the group it points at both read this one array, so the two cannot disagree
// about a name — which matters, because a fragment built at runtime is the one
// kind of href the link checkers can only report as unchecked, never verify.
//
// What they cannot cover is a group being added to COPY and not here: the extra
// group would render id={undefined} and its index entry would point at a
// "#undefined" that silently does nothing, on the page whose entire job is
// answering questions. So that case is a build error rather than a live bug.
// pricing.js throws on its own unknown-tier lookups for the same reason.
const GROUP_ANCHORS = ['getting-started', 'ordering', 'delivery', 'pricing', 'rights'];
if (GROUP_ANCHORS.length !== c.groups.length) {
  throw new Error(
    `FaqPage: ${c.groups.length} groups in the ${lang} COPY table but ` +
    `${GROUP_ANCHORS.length} anchors in GROUP_ANCHORS. Add the anchor.`
  );
}
---

{/* ═══ /faq IN DE STIJL VAN SECTIE 22 — 7 september 2026 ═════════════════════
    Vierde pagina in de stijl. De inhoud is niet aangeraakt: dezelfde COPY,
    dezelfde groepen uit faq.js, dezelfde <Disclose> met zijn toetsenbord- en
    schermlezergedrag, dezelfde ankers. Alleen de vorm is nieuw. */}
<div class="s22">

  <section class="paneel" aria-labelledby="faq-h1">
    <div class="faq-open">
      <div class="paneel-kop">
        <p class="etiket">{c.indexLabel}</p>
        <h1 id="faq-h1" class="hoog">{c.h1a}<em>{c.h1em}</em>{c.h1b}</h1>
        <p class="lopend">{c.lead}</p>
      </div>
      <figure class="kaart kaart-stil faq-beeld">
        <img src="/img/lifestyle-flash-05.webp" alt={c.heroAlt} loading="lazy" decoding="async" width="2400" height="1792" />
      </figure>
    </div>
  </section>

  {/* De index blijft: de labels zijn de groepskoppen die er toch al staan en de
      aantallen worden geteld, niet getypt. */}
  <section class="paneel">
    <nav class="faq-index" aria-label={c.indexLabel}>
      <ul class="faq-index-lijst" role="list">
        {c.groups.map((g, gi) => (
          <li>
            <a class="faq-index-link" href={`#${GROUP_ANCHORS[gi]}`}>
              <span class="faq-index-t">{g.title}</span>
              <span class="mono faq-index-n">{g.items.length}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="faq-groepen">
    {c.groups.map((g, gi) => (
      <div class="faq-groep" id={GROUP_ANCHORS[gi]}>
        <h2 class="hoog hoog-3">{g.title}</h2>
        <div class="acc">
          {/* Migrated to the shared Disclose, August 2026. The body is untouched
              — this page's answers carry photo figures and set:html, which the
              component passes straight through. `reveal pending` stays on the
              wrapper: /faq animates its list and Disclose has no opinion about
              that. The comment sits OUTSIDE the map on purpose: a JSX comment as
              the first child of an arrow body is a second expression, which is
              what "Expected ) but found $$render" was complaining about. */}
          {g.items.map((item) => (
            <Disclose summary={item.q} tone="panel" class="reveal pending">
              <div class="acc-body-inner">
                {item.html ? <p set:html={item.html} /> : <p>{item.a}</p>}
                {item.photos ? (
                  <div class="acc-figs">
                    {item.photos.map((ph) => (
                      <figure class="acc-fig">
                        <img src={ph.src} alt={ph.alt} loading="lazy" decoding="async" width={size(ph.src)[0]} height={size(ph.src)[1]} />
                        <figcaption>{ph.cap}</figcaption>
                      </figure>
                    ))}
                  </div>
                ) : null}
                {item.linkText ? <p class="acc-more"><a href={lp(item.linkHref)} class="link-arrow">{item.linkText} <svg viewBox="0 0 24 24" class="i" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a></p> : null}
              </div>
            </Disclose>
          ))}
        </div>
      </div>
      </div>
    ))}
    </div>
  </section>

  <section class="paneel paneel-slot" aria-labelledby="faq-slot">
    <h2 id="faq-slot" class="hoog">{c.ctaH}<em>{c.ctaEm}</em>{c.ctaH2}</h2>
    <p class="lopend">{c.ctaBody}</p>
    <p class="acties">
      <a class="knop knop-inkt" href={lp('/test-sample')} data-track="faq-sample">{c.ctaSample}</a>
      <a class="knop knop-lijn" href={lp('/contact')}>{c.ctaContact}</a>
      <a class="knop knop-lijn" href={c.wa} target="_blank" rel="noopener">WhatsApp</a>
    </p>
  </section>
</div>

<style>
  /* ── DE TWEE FIGUREN IN EEN ANTWOORD RAAKTEN ELKAAR — 8 september 2026 ─────
     Gemeten met kladblok/te-dicht.mjs: 0px tussen "Catalogset" en
     "Lifestyle-carousel" in het opengeklapte antwoord. `.acc-figs` had nooit
     een eigen regel — het was een <div> zonder opmaak, dus twee <figure>'s
     eronder stapelden zonder tussenruimte en lazen als één beeld met twee
     onderschriften.

     Een rooster en geen marge: op een breed scherm staan ze naast elkaar (dat
     is wat een vergelijking van twee sets hoort te doen) en op een telefoon
     onder elkaar met dezelfde tussenruimte. */
  .acc-figs {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(16rem, 100%), 1fr));
    gap: 1.2rem;
    margin: 1.2rem 0 0;
  }
  .acc-fig { margin: 0; display: grid; gap: .5rem; }
  /* ── DE KOP BEGINT BOVENAAN, HET BEELD MAG ZWEVEN — 8 september 2026 ──────
     Lucas over /portal: *"bij deze pagina ook niet eerste sectie volledig
     gevuld."* Gemeten: de tekstkolom is daar 418 hoog naast een figuur van 954,
     en met `align-items: center` zweeft die tekst in het midden — 268 pixels
     wit bóven de kop. Een kop die op een derde van het paneel begint, leest als
     een fout en niet als lucht.
     Alle tien de openingsrasters op de site zijn nagemeten (kladblok/_open):
     vier stonden op 145 tot 268 pixels scheef. De regel is nu overal dezelfde:
     alles begint BOVEN. Daar begin je met lezen, daar staat de kop, en daar
     hoort het beeld ernaast te beginnen. Een uitzondering voor het beeld is
     geprobeerd en weer weggehaald: de plaatshouderfiguren komen uit een ander
     component en krijgen in Astro een eigen scope-attribuut, dus die regel
     raakte de helft van de gevallen niet — en een consistentieregel die op de
     helft van de pagina's iets anders doet, is geen regel. Eén uitlijning,
     tien pagina's, geen uitzonderingen. */
  .faq-open { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, .9fr); gap: clamp(1.5rem, 5vw, 4rem); align-items: start; }
  .faq-open .paneel-kop { margin-bottom: 0; }
  .faq-beeld { aspect-ratio: 4 / 3; }

  .faq-index { margin-bottom: clamp(2.5rem, 5vw, 4rem); }
  .faq-index-lijst { display: flex; flex-wrap: wrap; gap: .5rem; }
  .faq-index-link { display: inline-flex; align-items: center; gap: .6rem; padding: .55rem 1.1rem; border: 1px solid var(--lijn-sterk); border-radius: 999px; font-size: .92rem; transition: border-color .25s var(--uit), background-color .25s var(--uit), color .25s var(--uit); }
  .faq-index-link:hover { background: var(--inkt); color: var(--vel); border-color: var(--inkt); }
  .faq-index-n { color: var(--inkt-2); }
  .faq-index-link:hover .faq-index-n { color: var(--vel); }

  .faq-groepen { display: grid; gap: clamp(2.5rem, 5vw, 4rem); }
  /* De sprong vanuit de index landt onder de balk van de site, niet erachter. */
  .faq-groep { scroll-margin-top: clamp(5rem, 10vw, 7rem); display: grid; gap: 1rem; }

  @media (max-width: 900px) { .faq-open { grid-template-columns: 1fr; } }
</style>
