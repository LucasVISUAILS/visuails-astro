---
/*
 * VISUAILS — DE LOPENDE BAND
 * 12 september 2026
 * ═══════════════════════════════════════════════════════════════════════════
 *
 * Lucas: *"Uiteindelijk moet het gewoon heel duidelijk worden voor de klant dat
 * hij of zij productfoto's opstuurt naar mij, ik de foto's/videos maak die ze
 * willen en ze het allemaal kunnen downloaden in hun dashboard. Dat is het
 * concept, en het voelt op de website wat rommelig waardoor je dat niet snel
 * eruit kan halen."*
 *
 * Hij had gelijk, en het was te meten: de voorpagina telde 720 woorden over elf
 * secties die allemaal iets UITLEGDEN en bijna niets TOONDEN. Het concept stond
 * er als zin en nergens als beeld.
 *
 * Uit vier gebouwde richtingen koos hij deze: de pagina als één beweging in
 * vier stations. Jij — wij — je dashboard — je shop. Elk station één woord van
 * schermhoogte, één zin, één beeld. Verder niets.
 *
 * ── WAAROM PAPIER EN ZWART ELKAAR AFWISSELEN ────────────────────────────────
 *
 * Niet als opmaak. De kleur zegt aan welke kant van de tafel je staat: station
 * 01 en 04 zijn van de KLANT (papier, zoals de rest van de site), 02 en 03 zijn
 * van ONS (zwart, zoals elk scherm op deze site sinds `.op-nacht`). Wie
 * doorscrollt ziet dus letterlijk het werk van hem naar ons en weer terug gaan.
 *
 * Diezelfde afwisseling is het antwoord op wat Lucas' bezoeker vroeg: *"wat meer
 * contrast in secties van de pagina."* De regel staat bij `.op-nacht` in
 * src/styles/global.css en geldt hier net zo.
 *
 * ── EN STATION 03 IS GEEN FOTO MAAR EEN SCHERM ──────────────────────────────
 *
 * Dezelfde bezoeker: *"wanneer hij foto's binnen kreeg [kon hij] alleen duidelijk
 * een approven maar niet goed [zien] of hij een revisie aanvroeg."* Dus staan
 * die twee hier als knoppen van GELIJK GEWICHT naast elkaar — zelfde hoogte,
 * zelfde letters, zelfde binnenruimte — en niet als een gele knop met een
 * tekstlinkje ernaast. Wat je op de voorpagina belooft, is wat je in het
 * portaal hoort te vinden.
 *
 * Het is een tekening en geen schermafdruk, om dezelfde reden als bij FigDash:
 * een afdruk veroudert stil zodra het echte scherm verandert. Er staat met
 * zoveel woorden bij dat het een voorbeeld is.
 *
 * ── DE BEELDEN ZIJN ÉÉN ECHTE KLUS ──────────────────────────────────────────
 *
 * BA2, de roze jeans. Vijf telefoonfoto's van een magazijnvloer erin, vier
 * afgewerkte beelden eruit. Niet vier losse mooie plaatjes: hetzelfde product,
 * dezelfde dag, en dat is precies waarom het overtuigt.
 *
 * De VERHOUDINGEN zijn met opzet verschillend gelaten. Wat erin gaat staat 9:16
 * (een telefoon houd je rechtop), wat eruit komt staat 1:1 (een catalogbeeld is
 * vierkant). Die vormwissel vertelt het verhaal nog een keer, zonder woorden.
 */
import { localizedPath } from '../i18n/ui';

interface Props { lang: 'en' | 'nl' }
const { lang } = Astro.props;
const nl = lang === 'nl';
const lp = (pad: string) => localizedPath(lang, pad);

/* De beelden — de roze jeans, BA2 — staan in src/data/voorbeeldset.js en
   de tekening zelf in Stations.astro, sinds /how-it-works dezelfde band
   toont (22 september 2026). Hier alleen de woorden van de voorpagina. */
import Stations from './Stations.astro';
const c = nl ? {
  h2: 'Van jouw foto naar je shop.',
  stations: [
    ['01', 'Jij', 'Je telefoon is genoeg. Geen statief, geen studio.'],
    ['02', 'Wij', 'Wij maken de beelden. Een specialist controleert ze allemaal.'],
    /* ── "DASHBOARD" WAS HET MEEST TOOL-ACHTIGE WOORD OP DE VOORPAGINA ──────
       17 september 2026. Deze band is de plek waar een bezoeker in vier stappen
       leest wat er gebeurt, en stap 3 heette naar een SCHERM in plaats van naar
       wat je krijgt. Samen met stap 1 en 4 ("Jij", "Je shop") stonden er dan
       drie stappen van de klant tegenover één van ons. De inhoud verandert niet
       — het is nog steeds één link zonder account — alleen heet de stap nu naar
       de beelden en niet naar de bediening. */
    ['03', 'Jouw beelden', 'Goedkeuren of een revisie vragen, en alles in één keer downloaden.'],
    ['04', 'Je shop', 'Vierkant, staand en verticaal: voor je shop, advertenties en reels.'],
  ],
  inLabel: 'Ingestuurd', inNoot: '3 van 5 · telefoon',
  uitLabel: 'Geleverd', uitNoot: '4 beelden · 2048 px',
  vormLabel: 'Shop · advertentie · reel',
  /* De twee links die meeverhuizen uit de secties die deze band vervangt: de
     galerij hing onder "studioproductie" en het portaal onder "Daarna:
     VISUAILS Studio". Beide secties zijn weg; de links horen bij het station
     dat hun onderwerp draagt en niet bij de voettekst. */
  linkWerk: 'Meer werk zien',
  linkPortaal: 'Het portaal van binnen',
} : {
  h2: 'From your photo to your shop.',
  stations: [
    ['01', 'You', 'Your phone is enough. No tripod, no studio.'],
    ['02', 'Us', 'We make the images. A specialist checks every one.'],
    /* Zie de Nederlandse tegenhanger. */
    ['03', 'Your images', 'Approve or ask for a revision, and download it all at once.'],
    ['04', 'Your shop', 'Square, upright and vertical: for your shop, ads and reels.'],
  ],
  inLabel: 'Sent in', inNoot: '3 of 5 · phone',
  uitLabel: 'Delivered', uitNoot: '4 images · 2048 px',
  vormLabel: 'Shop · ad · reel',
  linkWerk: 'See more work',
  linkPortaal: 'Look inside the portal',
};
---

<section class="lb paneel" aria-labelledby="lb-h">
  {/* ── VIER STATIONS OP ÉÉN RIJ — 19 september 2026 ──────────────────────
      Lucas: *"de sectie op de homepage gelijk onder de start sectie voelt
      niet alsof hij er tussen moet staan en kan veel compacter en
      overzichtelijker."* Gemeten op 1440: 2.293 px hoog, vier stations om en
      om licht en donker, elk een half scherm. Dat las als vier losse pagina's
      tussen de opening en "Wat we maken".

      Nu één licht paneel in het paneelritme van de rest van de pagina: de kop,
      en de vier stappen naast elkaar als kolommen — nummer, woord, één beeld
      dat de stap ís, één zin. Op een telefoon twee naast elkaar, dan onder
      elkaar. De tekening staat in Stations.astro; /how-it-works toont dezelfde
      band met drie stations en de regels eronder. */}
  <header class="paneel-kop lb-kop">
    <h2 id="lb-h" class="hoog hoog-2">{c.h2}</h2>
  </header>
  <Stations lang={lang} stations={[
    { nr: c.stations[0][0], woord: c.stations[0][1], zin: c.stations[0][2], beeld: 'in', etiket: c.inLabel, etiketNoot: c.inNoot },
    { nr: c.stations[1][0], woord: c.stations[1][1], zin: c.stations[1][2], beeld: 'uit', etiket: c.uitLabel, etiketNoot: c.uitNoot, link: { href: lp('/gallery'), tekst: c.linkWerk } },
    { nr: c.stations[2][0], woord: c.stations[2][1], zin: c.stations[2][2], beeld: 'dash', etiket: '', link: { href: lp('/portal'), tekst: c.linkPortaal } },
    { nr: c.stations[3][0], woord: c.stations[3][1], zin: c.stations[3][2], beeld: 'vormen', etiket: c.vormLabel },
  ]} />
</section>

<style>
  /* De klasse `paneel` uit stijl22 geeft dit blok dezelfde marge, vulling en
     achtergrond als de andere panelen op de pagina; de indeling van de rij
     staat in Stations.astro. */
  .lb-kop { max-width: 46rem; }
</style>
