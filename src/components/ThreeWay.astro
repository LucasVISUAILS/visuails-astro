---
// VISUAILS — three-way positioning table: Generic AI tool vs Traditional
// photo shoot vs VISUAILS. The core "why us" argument: the speed and cost of
// AI, the accuracy and human sign-off of a real shoot, without the downside
// of either. VISUAILS column is highlighted; every row is framed so VISUAILS
// is the resolved answer. Horizontally scrollable on small screens so the
// matrix never squashes. Locale-aware: copy + CTA links follow the URL language.
import { getLangFromPath, localizedPath } from '../i18n/ui.js';
interface Props {
  heading?: string;
  sub?: string;
  cta?: boolean;
}
const lang = getLangFromPath(Astro.url.pathname);
const lp = (p: string) => localizedPath(lang, p);

const T = {
  en: {
    heading: 'AI tool, photo shoot, or VISUAILS?',
    sub: 'The speed and price of AI. The accuracy and human sign-off of a real shoot. Neither compromise.',
    cols: ['Generic AI tool', 'Traditional shoot', 'VISUAILS'],
    rows: [
      ['Turnaround', 'Minutes — but hit-or-miss', '2–4 weeks', '~24 hours'],
      ['Cost per photo', 'Cheap — you pay in redos', 'Hundreds per shoot', '~€10 (catalog set)'],
      ['What you do', 'Prompt, retry, repeat', 'Ship samples, book a studio', 'Send one photo'],
      ['Consistency', 'Drifts every generation', 'High, but per shoot', 'Locked across your set'],
      ['Human quality check', 'None', 'Yes', 'Yes — every image'],
      ['Models', 'Random every time', 'Hired & paid per shoot', 'Consistent included; custom on request'],
      ['Brand accuracy', 'Off-brand, warped logos', 'Accurate', 'Locked to your brand'],
      ['Scales with your catalog', 'Yes — quality drops', 'No — each is a project', 'Yes — consistently'],
    ],
    cta1: 'See it on your product — €0.99', cta2: 'See pricing',
  },
  nl: {
    heading: 'AI-tool, fotoshoot of VISUAILS?',
    sub: 'De snelheid en prijs van AI. De precisie en menselijke controle van een echte shoot. Zonder de nadelen van beide.',
    cols: ['Standaard AI-tool', 'Traditionele shoot', 'VISUAILS'],
    rows: [
      ['Doorlooptijd', 'Minuten — maar wisselvallig', '2–4 weken', '~24 uur'],
      ['Kosten per foto', 'Goedkoop — je betaalt in overdoen', 'Honderden per shoot', '~€10 (catalogset)'],
      ['Wat jij doet', 'Prompten, opnieuw, herhalen', 'Samples opsturen, studio boeken', 'Eén foto sturen'],
      ['Consistentie', 'Wisselt bij elke generatie', 'Hoog, maar per shoot', 'Vastgezet over je hele set'],
      ['Menselijke kwaliteitscontrole', 'Geen', 'Ja', 'Ja — elk beeld'],
      ['Modellen', 'Elke keer anders', 'Ingehuurd & betaald per shoot', 'Consistent inbegrepen; eigen model op aanvraag'],
      ['Merkgetrouwheid', 'Off-brand, vervormde logo’s', 'Nauwkeurig', 'Vastgezet op jouw merk'],
      ['Schaalt met je catalogus', 'Ja — kwaliteit daalt', 'Nee — elk is een project', 'Ja — consistent'],
    ],
    cta1: 'Zie het op je product — €0,99', cta2: 'Bekijk prijzen',
  },
  de: {
    heading: 'KI-Tool, Fotoshooting oder VISUAILS?',
    sub: 'Das Tempo und der Preis von KI. Die Präzision und die menschliche Kontrolle eines echten Shootings. Ohne die Nachteile von beidem.',
    cols: ['Übliches KI-Tool', 'Klassisches Shooting', 'VISUAILS'],
    rows: [
      ['Bearbeitungszeit', 'Minuten — aber unzuverlässig', '2–4 Wochen', '~24 Stunden'],
      ['Kosten pro Foto', 'Günstig — du zahlst mit Wiederholungen', 'Hunderte pro Shooting', '~€10 (Katalog-Set)'],
      ['Was du tust', 'Prompten, neu versuchen, wiederholen', 'Muster verschicken, Studio buchen', 'Ein Foto senden'],
      ['Konsistenz', 'Schwankt bei jeder Generierung', 'Hoch, aber pro Shooting', 'Fest über dein ganzes Set'],
      ['Menschliche Qualitätskontrolle', 'Keine', 'Ja', 'Ja — jedes Bild'],
      ['Modelle', 'Jedes Mal anders', 'Gebucht & bezahlt pro Shooting', 'Konsistent inklusive; eigenes Modell auf Anfrage'],
      ['Markentreue', 'Off-Brand, verzerrte Logos', 'Genau', 'Fest auf deine Marke'],
      ['Skaliert mit deinem Katalog', 'Ja — Qualität sinkt', 'Nein — jedes ist ein Projekt', 'Ja — konsistent'],
    ],
    cta1: 'Auf deinem Produkt sehen — €0,99', cta2: 'Preise ansehen',
  },
};
const d = T[lang] || T.en;
const {
  heading = d.heading,
  sub = d.sub,
  cta = true,
} = Astro.props;
const rows = d.rows;
---

<div class="tri-block">
  <div class="section-head" style="text-align:center;margin-inline:auto">
    <h2 class="serif-display">{heading}</h2>
    <p style="margin-inline:auto">{sub}</p>
  </div>

  <div class="tri-wrap reveal pending">
    <div class="tri" role="table" aria-label="Comparison: generic AI tool vs traditional photo shoot vs VISUAILS">
      <div class="tri-cell tri-head" role="columnheader"></div>
      <div class="tri-cell tri-head" role="columnheader">{d.cols[0]}</div>
      <div class="tri-cell tri-head" role="columnheader">{d.cols[1]}</div>
      <div class="tri-cell tri-head tri-col-vis" role="columnheader">{d.cols[2]}</div>

      {rows.map((r) => (
        <Fragment>
          <div class="tri-cell tri-row-label" role="rowheader">{r[0]}</div>
          <div class="tri-cell tri-muted" role="cell">{r[1]}</div>
          <div class="tri-cell tri-muted" role="cell">{r[2]}</div>
          <div class="tri-cell tri-col-vis" role="cell">
            <svg class="tri-check" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 6L9 17l-5-5" /></svg>
            <span>{r[3]}</span>
          </div>
        </Fragment>
      ))}
    </div>
  </div>

  {cta && (
    <div class="flex" style="justify-content:center;margin-top:1.8rem">
      <a href={lp('/test-sample')} class="btn btn-primary">{d.cta1}</a>
      <a href={lp('/pricing')} class="btn btn-ghost">{d.cta2}</a>
    </div>
  )}
</div>
