---
/**
 * VISUAILS — de controle: jouw foto naast ons beeld (14 oktober 2026).
 *
 * Stond tot vandaag in OverHal.astro (afvinklijst 22, notitie: "een hoopgevende
 * mockup van hoe wij omgaan met bestellingen en de kwaliteit"). Een eigen
 * onderdeel sinds de uitleg in beweging. De opmaak staat in hal.css (.h-ov-ctrl).
 *
 * ── AFVINKLIJST 24 ─────────────────────────────────────────────────────────
 * Lucas: *"Hier mag echt meer het proces te zien zijn. Ook meerdere foto's van de
 * broek om echt te laten zien wat de klant krijgt en hoe precies we te werk gaan.
 * Animatie mag iets sneller."* Dus nu een rondgang langs de vier beelden van één
 * bestelling (de roze jeans, voorbeeldset.js), en bij elk beeld een eigen controle
 * die je ziet gebeuren:
 *   voorkant   · de kleur van de stof — een pipet op dezelfde plek in beide foto's
 *   achterkant · zakken en naden      — de twee achterzakken omlijnd
 *   detail     · knoop en logo        — een loep op de knoop
 *   op model   · pasvorm en lengte    — een maatlijn van taille tot zoom
 * Onder het paar de vier beelden met hun vinkje, en tot slot "Nagekeken" en de zin
 * over twijfel.
 *
 * Afvinklijst 25: "Animatie mag iets langzamer" — 2,2 s per beeld (was 1,8), 11,4 s in totaal.
 *
 * DE PLEKKEN ZIJN GEMETEN, niet op het oog gezet (14 oktober): de knoop met de
 * grijze pixels in het midden van beide detailfoto's (49,8 · 49,5 en 49,6 · 49,4 %),
 * het kleurpunt op dezelfde plek van de broek (het linkerbovenbeen) en met een cirkel
 * van 6 % die helemaal op de stof valt, de zakken en de maatlijn afgelezen op
 * een raster van 5 %. Daarna omgerekend naar het 4:5-vak: een staande telefoonfoto
 * (3:4) verliest 4,2 % boven en onder, een vierkant beeld 12,5 % links en rechts.
 * Vervang je een foto, meet deze plekken dan opnieuw (PLEK hieronder).
 *
 * Zonder `uitleg`, zonder JavaScript en na afloop: het paar van de voorkant met de
 * pipet, alle vier de vinkjes, "Nagekeken".
 */
import { ingestuurd, geleverd } from '../data/voorbeeldset.js';
import UitlegBalk from './UitlegBalk.astro';

interface Props { lang: 'en' | 'nl'; uitleg?: boolean; d?: number }
const { lang, uitleg = false, d = 2 } = Astro.props as Props;
const nl = lang === 'nl';
const IN = ingestuurd(lang);
const UIT = geleverd(lang);
/* Welke foto bij welk beeld hoort: voorkant, achterkant, detail, en de draagfoto (pasvorm). */
const VOOR = { v: IN[0], a: IN[1], d: IN[2], m: IN.find((b) => /pasvorm/.test(b.src)) || IN[IN.length - 1] };
const NA = { v: UIT[0], a: UIT[1], d: UIT[2], m: UIT[3] };
/* De plekken, in % van het 4:5-vak (zie de kop). x en y zijn het midden; b en h de maat. */
const PLEK = {
  v: { jouw: { x: 39.6, y: 45.7 }, ons: { x: 35.5, y: 40 } }, // het linkerbovenbeen, 37 % van taille naar zoom, cirkel 100 % op de stof
  a: { jouw: [{ x: 42, y: 26.5, b: 16, h: 12.8 }, { x: 65, y: 29.7, b: 15, h: 13.9 }], ons: [{ x: 28.8, y: 16, b: 16.3, h: 15 }, { x: 53.8, y: 16, b: 17.5, h: 15 }] },
  d: { jouw: { x: 49.8, y: 49.5, r: 26 }, ons: { x: 49.5, y: 49.4, r: 30 } },
  m: { jouw: { x: 36, y1: 21.2, y2: 94.8 }, ons: { x: 65, y1: 13, y2: 86 } },
};
const c = nl
  ? {
      balk: 'Bestelling · catalog',
      stand: 'Nagekeken',
      jouw: 'Jouw foto', ons: 'Ons beeld',
      items: [
        { k: 'v', naam: 'Voorkant', check: 'Kleur van de stof' },
        { k: 'a', naam: 'Achterkant', check: 'Zakken en naden' },
        { k: 'd', naam: 'Detail', check: 'Knoop en logo' },
        { k: 'm', naam: 'Op model', check: 'Pasvorm en lengte' },
      ],
      rijLabel: 'De vier beelden van deze bestelling',
      voet: 'Twijfel? Dan vragen we het je eerst.',
      zinnen: [
        'De voorkant: jouw foto naast ons beeld. Klopt de kleur van de stof?',
        'De achterkant: zitten de zakken en naden op dezelfde plek?',
        'Het detail: de knoop en het logo, van dichtbij.',
        'Op het model: valt de pasvorm, klopt de lengte?',
        'Klopt alles, dan gaat het naar jou. Twijfelen we, dan vragen we het eerst.',
      ],
    }
  : {
      balk: 'Order · catalog',
      stand: 'Checked',
      jouw: 'Your photo', ons: 'Our image',
      items: [
        { k: 'v', naam: 'Front', check: 'Colour of the fabric' },
        { k: 'a', naam: 'Back', check: 'Pockets and seams' },
        { k: 'd', naam: 'Detail', check: 'Button and logo' },
        { k: 'm', naam: 'On model', check: 'Fit and length' },
      ],
      rijLabel: 'The four images of this order',
      voet: 'In doubt? Then we ask you first.',
      zinnen: [
        'The front: your photo next to our image. Is the colour of the fabric right?',
        'The back: are the pockets and seams in the same place?',
        'The detail: the button and the logo, up close.',
        'On the model: does the fit hold, is the length right?',
        'If it all matches, it goes to you. If we are unsure, we ask first.',
      ],
    };
const RECHTS = '<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2.5 8h11M9 3.5L13.5 8 9 12.5"/></svg>';
const VINK = '<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8.5l3.2 3L13 4.5"/></svg>';
const CHAT = '<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 3.5h10v7H7.5L4.5 13v-2.5H3z"/></svg>';
const PIPET = '<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M10.5 2.5l3 3-1.6 1.6-3-3zM9.4 4.6L3.5 10.5 3 13l2.5-.5 5.9-5.9"/></svg>';
const pos = (p: { x: number; y: number }) => `left:${p.x}%;top:${p.y}%`;
/* De markeringen van één beeld, voor één kant (jouw foto of ons beeld). */
const merk = (k: string, kant: 'jouw' | 'ons') => {
  const p: any = (PLEK as any)[k][kant];
  if (k === 'v') return [{ cls: 'h-ctrl-pipet', style: pos(p) }];
  if (k === 'a') return p.map((z: any) => ({ cls: 'h-ctrl-zak', style: `left:${z.x}%;top:${z.y}%;width:${z.b}%;height:${z.h}%` }));
  if (k === 'd') return [{ cls: 'h-ctrl-loep', style: `${pos(p)};width:${p.r}%` }];
  return [{ cls: 'h-ctrl-maat', style: `left:${p.x}%;top:${p.y1}%;height:${p.y2 - p.y1}%` }];
};
---
<div class="h-ov-ctrl h-op" style={`--d:${d}`} data-uitleg={uitleg ? '' : undefined} data-uitleg-maat="2400 2200 2200 2200 2400" data-uitleg-start="500">
  <span class="h-korrel" aria-hidden="true"></span>
  <div class="h-ov-ctrl-balk">
    <span class="h-pil h-pil-wit"><span>{c.balk}</span></span>
    <span class="h-ov-ctrl-stand"><i set:html={VINK} />{c.stand}</span>
  </div>
  <div class="h-ov-ctrl-paar">
    {(['jouw', 'ons'] as const).map((kant) => (
      <figure data-kant={kant}>
        {c.items.map((it, i) => {
          const b = (kant === 'jouw' ? VOOR : NA)[it.k as 'v'];
          return <img data-it={it.k} src={b.src} width={b.w} height={b.h} alt={i === 0 ? b.alt : ''} aria-hidden={i === 0 ? undefined : 'true'} decoding="async" fetchpriority={i === 0 ? 'high' : undefined} loading={i === 0 ? undefined : 'lazy'} />;
        })}
        {c.items.flatMap((it) => merk(it.k, kant).map((m: any) => (
          <span class={`h-ctrl-merk ${m.cls}`} data-it={it.k} style={m.style} aria-hidden="true">{m.cls === 'h-ctrl-pipet' && <i set:html={PIPET} />}</span>
        )))}
        <figcaption class="h-pil h-pil-glas"><span>{kant === 'jouw' ? c.jouw : c.ons}</span></figcaption>
      </figure>
    ))}
    <span class="h-cirkel h-cirkel-wit h-ov-ctrl-pijl" aria-hidden="true" set:html={RECHTS} />
  </div>
  <ul class="h-ov-ctrl-rij" role="list" aria-label={c.rijLabel}>
    {c.items.map((it) => {
      const b = NA[it.k as 'v'];
      return (
        <li data-it={it.k}>
          <img src={b.src} width={b.w} height={b.h} alt="" loading="lazy" decoding="async" />
          <span class="h-ov-ctrl-rij-tekst"><b>{it.naam}</b><span>{it.check}</span></span>
          <i class="h-ov-ctrl-vink" set:html={VINK} />
        </li>
      );
    })}
  </ul>
  <div class="h-ov-ctrl-voet"><i set:html={CHAT} /><span>{c.voet}</span></div>
  {uitleg && <UitlegBalk zinnen={c.zinnen} lang={lang} />}
</div>
