---
// VISUAILS — /lifestyle and /nl/lifestyle share this body.
//
// Same reasoning as CatalogPage.astro: the two locales were separate 181-line
// inline pages holding their own copies of the price. They agreed only
// because nobody had edited either since the port. A `lang` prop makes EN/NL
// parity a property of the file layout instead of anyone's diligence.
//
// Two data sources were also inlined here and are now imported: the four
// moods came from a five-entry literal that duplicated src/data/styles.js,
// and the price on every one of those entries was typed by hand. The moods
// now come from the shared module and the euro comes from pricing.js.
//
// THE PRICE IS A LADDER NOW, not a flat rate (August 2026 — section 0 of
// src/data/pricing.js is the governing document). A lifestyle carousel used to
// be one figure per product, printed in the hero, the trust row, every mood
// card and the closing band. The rate starts at the entry rung and falls as
// the count rises, so one figure would be quoting what a SINGLE product costs
// as though it were the price of a season. Every mention now names the entry
// rate and the floor together, and the rung list under the set block prints
// the whole thing.
//
// EVERY PRINTED PRICE CARRIES A VAT LABEL, from vatLabel() — BRIEF-14's
// hardest rule, and never a typed "excl. VAT", because that string has to
// translate and it has to move if the rule moves.
//
// "DROP" IS NOT WHAT WE SELL. It means a collection going live, which is what
// it means to the brands we sell to; a work order is an order, or a batch —
// in Dutch, een bestelling. The word survives on this page only where the
// CLIENT's own launch is meant (the `where` list's "seasonal drops").
//
// SERVICE LEVEL FOLLOWS SIZE: from WINDOW_THRESHOLD products an order gets the
// reserved window, below it the standard queue. The timing strings still come
// from turnaround(); what changed is that this page names the count.
import {
  TIERS, LADDER, ladderRate, ladderFloor, euro, vatLabel,
  WINDOW_THRESHOLD, FIRST_ORDER_DISCOUNT, reviewClaim, turnaround,
} from '../data/pricing.js';
import { localizedPath } from '../i18n/ui.js';
import Compare from './Compare.astro';
import TierCompare from './TierCompare.astro';
import { styles as stylesEn } from '../data/styles.js';
import { styles as stylesNl } from '../data/styles.nl.js';

interface Props { lang: 'en' | 'nl'; }
const { lang } = Astro.props;
const lp = (p: string) => localizedPath(lang, p);

const moods = lang === 'nl' ? stylesNl : stylesEn;

// The ladder for this page's one kind, read rather than typed. Both ends are
// needed wherever a rate is quoted: the entry rate alone makes a fifty-product
// order look three times more expensive than it is, and the floor alone quotes
// a price almost nobody's first order pays.
const KIND = 'lifestyle';
const entry = ladderRate(KIND, 1);
const floor = ladderFloor(KIND);
const rungs = LADDER[KIND];
const floorFrom = rungs[rungs.length - 1][0];
const rungRows = rungs.map(([lo, hi, rate]) => ({
  label: hi === null ? `${lo}+` : `${lo}–${hi}`,
  rate: euro(rate, lang),
}));
const t0 = TIERS.unattended;

// Computed, never typed — a "20%" written beside a constant of 0.20 is two
// sources of truth for one number, and the typed one is the one that rots.
const firstPct = `${Math.round(FIRST_ORDER_DISCOUNT * 100)}%`;

// The before/after row. Photo paths only — the labels come out of `moods` so
// a renamed style can never drift between the grid and the comparison row.
const GRADES = [
  { slug: 'dunes', photo: '/img/lifestyle-dunes-01.webp' },
  { slug: 'flash', photo: '/img/lifestyle-flash-01.webp' },
  { slug: 'glow', photo: '/img/lifestyle-glow-01.webp' },
  { slug: 'phone-made', photo: '/img/lifestyle-phone-made-01.webp' },
];
const moodBySlug = Object.fromEntries(moods.map((s) => [s.slug, s]));
const grades = GRADES.map((g) => ({ ...g, name: moodBySlug[g.slug].name }));

// w/h are the intrinsic pixel size of each file in public/img. .marquee-item
// is a fixed 4/5 box and the image covers it, so these change nothing you can
// see — they stop the row reflowing as each photo arrives (§12).
const marqueeItems = [
  { src: '/img/lifestyle-phone-made-06.webp', label: 'Phone-made', w: 2400, h: 1792 },
  { src: '/img/lifestyle-glow-03.webp', label: 'Glow', w: 768, h: 1376 },
  { src: '/img/lifestyle-flash-05.webp', label: 'Flash', w: 2400, h: 1792 },
  { src: '/img/lifestyle-dunes-02.webp', label: 'Dunes', w: 928, h: 1152 },
  { src: '/img/banners-02.webp', label: 'Campaign', w: 928, h: 1152 },
];

// The mood cards render `cardPhoto` straight off src/data/styles.js, which
// carries paths and no sizes. Their intrinsic size is recorded here — read off
// the files, not off the .photo-band box they crop into. Unlisted throws, so a
// restyled card cannot quietly ship without its aspect-ratio box.
const CARD_INTRINSIC: Record<string, [number, number]> = {
  '/img/banners-13.webp': [2400, 1792],
  '/img/lifestyle-dunes-01.webp': [928, 1152],
  '/img/lifestyle-flash-02.webp': [1340, 2400],
  '/img/lifestyle-glow-01.webp': [1340, 2400],
  '/img/lifestyle-phone-made-11.webp': [2400, 1792],
};
const cardSize = (src: string): [number, number] => {
  const d = CARD_INTRINSIC[src];
  if (!d) throw new Error(`LifestylePage.astro: no intrinsic size on record for ${src} — add it to CARD_INTRINSIC.`);
  return d;
};

// No `as const` — COPY[lang] on a const-asserted object gives a union of
// readonly tuples and .map() on that union is a TS error.
const COPY = {
  en: {
    eyebrow: 'Lifestyle',
    // <em> added task #271b (Lucas's own request, editorial accent) — same
    // closing-phrase-emphasis convention as the other hero H1s.
    h1: 'Your product, in scenes <em>that sell.</em>',
    lead: `Four signature looks. A 3-photo carousel per product — ${euro(entry, 'en')} ${vatLabel('excl', 'en')}, falling to ${euro(floor, 'en')} from ${floorFrom} products up.`,
    // SECTION 13: Tier 0 "must NOT appear ... in any hero." See CatalogPage for
    // the full note — this button carried the tier label verbatim, in the hero,
    // on a link that lands on /start's two-way fork.
    ctaPrimary: 'Start an order',
    ctaSecondary: 'See pricing',
    wa: 'https://wa.me/31625436130?text=Hi%20VISUAILS%2C%20I%27d%20like%20to%20order%20lifestyle%20visuals%20for%20my%20products.',
    waTalk: 'https://wa.me/31625436130?text=Hi%20VISUAILS%2C%20I%27d%20like%20to%20talk%20about%20lifestyle%20visuals%20for%20my%20brand.',
    waLabel: 'WhatsApp',
    // Two figures, not one. A single rate here is the exact claim the ladder
    // retired — see the note at the top of this file.
    trust: [
      [`${euro(entry, 'en')} – ${euro(floor, 'en')}`, `per product · ${vatLabel('excl', 'en')}`],
      ['3 photos', 'per product'],
    ],
    // Visible, not buried. Section 13: a visitor must not be able to leave
    // this page believing a delivery date was promised — and now that size
    // decides the service level, the line names the count as well.
    queueNote: `Under ${WINDOW_THRESHOLD} products: ${t0.queue.en.toLowerCase()}. From ${WINDOW_THRESHOLD}, the order goes into the capacity calendar and gets the reserved window.`,
    setH: 'One product. Three photos. <em>A carousel.</em>',
    setP: 'Every lifestyle order is your product in one styled look, delivered as three shots that belong together — ready to post as a carousel on Instagram, your shop and ads.',
    // Numbered because a carousel genuinely is an ordered sequence: this is
    // the order the three photos are meant to be posted in.
    set: [
      ['The scene', 'Your product styled in a real-world setting — the atmosphere shot that stops the scroll.'],
      ['On-model', 'The same product worn or held, so people can picture it in their own life.'],
      ['Logo close-up', 'A tight detail shot — same vibe, same colour grade — that proves the quality.'],
    ],
    setNote: 'One styled look per order · same colour grading · a different scene is a separate order.',
    ladderH: 'What a carousel costs',
    ladderProductsCol: 'Products',
    ladderRateCol: `Per product · ${vatLabel('excl', 'en')}`,
    ladderNote: `The rate applies to every product in the order, not only the ones past the rung — so ${floorFrom} products are ${euro(floor, 'en')} each, all of them. Your first order with us is ${firstPct} off on top of it.`,
    moodsH: 'Four moods — or <em>your own.</em>',
    onRequest: 'On request',
    // The mood cards are small, so they carry the two ends of the ladder and
    // nothing else — the full rung list is one section above them.
    unitLabel: `${euro(entry, 'en')} – ${euro(floor, 'en')} / product · ${vatLabel('excl', 'en')}`,
    edMeta: '( Where it fits )',
    edH: 'Lifestyle photography: desire, in context.',
    edSub: 'The scenes that create want, not just clarity.',
    whatH: 'What it is',
    whatP: [
      'Where catalog shows the product plainly, lifestyle photography puts it in a world — styled, lit and shot as a scene someone wants to step into. A VISUAILS lifestyle order is three photos of one product in a single look: a scene shot, an on-model shot and a detail close-up, all matched in grade, so they read as one story and post straight to a feed as a carousel.',
      "This is the imagery that does the emotional work. It doesn't just say what the product is; it shows people who they'd be with it. That's why it belongs where people scroll for inspiration rather than specs — and why it's often the difference between a listing that gets browsed and a brand that gets followed.",
    ],
    whereH: 'Where it lives',
    where: [
      ['Instagram & TikTok', 'feed posts, carousels and Reels covers.'],
      ['Paid ads', 'creative built to stop the scroll.'],
      ['Your homepage', 'hero and lookbook moments.'],
      ['Email & campaigns', 'seasonal drops and newsletters.'],
    ],
    modelH: 'Add a consistent <em>model.</em>',
    modelP: 'Same face, across your whole collection — or let us choose one that fits.',
    modelAlt: 'A VISUAILS model, styled consistently across a campaign',
    modelCta: 'Explore models',
    gradeH: 'Four moods. Four transformations.',
    gradeP: 'The same shot, flat vs. finished in each VISUAILS style.',
    gradeFlat: 'Flat',
    gradeBeforeAlt: (n: string) => `A flat, ungraded ${n} scene`,
    gradeAfterAlt: (n: string) => `The same scene finished in the ${n} lifestyle look`,
    rangeH: 'The range, in motion',
    rangeCta: 'See the full gallery',
    exampleAlt: (n: string) => `${n} lifestyle example`,
    reviewNote: reviewClaim('unattended', 'en'),
    ctaH: 'Put your product<br>in a scene that sells.',
    ctaP: `${euro(entry, 'en')} per product, down to ${euro(floor, 'en')} from ${floorFrom} up — ${vatLabel('excl', 'en')}.`,
  },
  nl: {
    eyebrow: 'Lifestyle',
    h1: 'Jouw product, in scènes <em>die verkopen.</em>',
    lead: `Vier signatuurlooks. Een carousel van 3 foto’s per product — ${euro(entry, 'nl')} ${vatLabel('excl', 'nl')}, en dat daalt naar ${euro(floor, 'nl')} vanaf ${floorFrom} producten.`,
    ctaPrimary: 'Start een bestelling',
    ctaSecondary: 'Bekijk prijzen',
    wa: 'https://wa.me/31625436130?text=Hoi%20VISUAILS%2C%20ik%20wil%20graag%20Lifestyle-visuals%20bestellen%20voor%20mijn%20producten.',
    waTalk: 'https://wa.me/31625436130?text=Hoi%20VISUAILS%2C%20ik%20wil%20graag%20praten%20over%20Lifestyle-visuals%20voor%20mijn%20merk.',
    waLabel: 'WhatsApp',
    trust: [
      [`${euro(entry, 'nl')} – ${euro(floor, 'nl')}`, `per product · ${vatLabel('excl', 'nl')}`],
      ['3 foto’s', 'per product'],
    ],
    queueNote: `Onder ${WINDOW_THRESHOLD} producten: ${t0.queue.nl.toLowerCase()}. Vanaf ${WINDOW_THRESHOLD} gaat de bestelling in de capaciteitsagenda en krijgt hij het gereserveerde venster.`,
    setH: 'Eén product. Drie foto’s. <em>Een carousel.</em>',
    setP: 'Elke lifestyle-bestelling is je product in één gestylede look, geleverd als drie shots die bij elkaar horen — klaar om te posten als carousel op Instagram, je shop en ads.',
    set: [
      ['De sfeer', 'Je product gestyled in een realistische setting — het sfeerbeeld dat de scroll stopt.'],
      ['On-model', 'Hetzelfde product gedragen of vastgehouden, zodat mensen het in hun eigen leven zien.'],
      ['Logo-close-up', 'Een strakke detailshot — zelfde vibe, zelfde colour grade — die de kwaliteit bewijst.'],
    ],
    setNote: 'Eén gestylede look per bestelling · zelfde colour grading · een andere scène is een aparte bestelling.',
    ladderH: 'Wat een carousel kost',
    ladderProductsCol: 'Producten',
    ladderRateCol: `Per product · ${vatLabel('excl', 'nl')}`,
    ladderNote: `Het tarief geldt voor elk product in de bestelling, niet alleen voor de producten voorbij de trede — ${floorFrom} producten kosten dus allemaal ${euro(floor, 'nl')}. Je eerste bestelling is daar nog eens ${firstPct} goedkoper op.`,
    moodsH: 'Vier sferen — of <em>je eigen.</em>',
    onRequest: 'Op aanvraag',
    unitLabel: `${euro(entry, 'nl')} – ${euro(floor, 'nl')} / product · ${vatLabel('excl', 'nl')}`,
    edMeta: '( Waar het past )',
    edH: 'Lifestylefotografie: verlangen, in context.',
    edSub: 'De scènes die verlangen wekken, niet alleen helderheid.',
    whatH: 'Wat het is',
    whatP: [
      'Waar catalog het product helder toont, zet lifestylefotografie het in een wereld — gestyled, belicht en geschoten als een scène waar iemand in wil stappen. Een VISUAILS lifestyle-bestelling is drie foto’s van één product in één look: een sfeershot, een on-model shot en een detail-close-up, met dezelfde grade, zodat ze als één verhaal lezen en direct als carousel op een feed te posten zijn.',
      'Dit is het beeld dat het emotionele werk doet. Het zegt niet alleen wat het product is; het laat mensen zien wie ze ermee zouden zijn. Daarom hoort het waar mensen scrollen voor inspiratie in plaats van specificaties — en daarom is het vaak het verschil tussen een listing die bekeken wordt en een merk dat gevolgd wordt.',
    ],
    whereH: 'Waar het leeft',
    where: [
      ['Instagram & TikTok', 'feedposts, carousels en Reels-covers.'],
      ['Betaalde ads', 'creatives die de scroll stoppen.'],
      ['Je homepage', 'hero- en lookbook-momenten.'],
      ['E-mail & campagnes', 'seizoensdrops en nieuwsbrieven.'],
    ],
    modelH: 'Voeg een consistent <em>model</em> toe.',
    modelP: 'Hetzelfde gezicht, door je hele collectie — of laat ons er een kiezen die past.',
    modelAlt: 'Een VISUAILS-model, consistent gestyled door een hele campagne',
    modelCta: 'Ontdek modellen',
    gradeH: 'Vier sferen. Vier transformaties.',
    gradeP: 'Dezelfde shot, plat versus afgewerkt in elke VISUAILS-stijl.',
    gradeFlat: 'Plat',
    gradeBeforeAlt: (n: string) => `Een platte, ongecorrigeerde ${n}-scène`,
    gradeAfterAlt: (n: string) => `Dezelfde scène afgewerkt in de ${n} lifestyle-look`,
    rangeH: 'Het assortiment, in beweging',
    rangeCta: 'Bekijk de volledige galerij',
    exampleAlt: (n: string) => `${n} lifestyle-voorbeeld`,
    reviewNote: reviewClaim('unattended', 'nl'),
    ctaH: 'Zet je product<br>in een scène die verkoopt.',
    ctaP: `${euro(entry, 'nl')} per product, tot ${euro(floor, 'nl')} vanaf ${floorFrom} — ${vatLabel('excl', 'nl')}.`,
  },
};

const c = COPY[lang];
// The custom mood is quoted, not listed — everything else is a Tier 0 line
// item at the per-product price. Keeping this rule here rather than in
// styles.js means no euro figure ever enters the style data.
const moodPrice = (slug: string) => (slug === 'custom' ? c.onRequest : c.unitLabel);
---

<section class="page-hero">
  <div class="container">
    <span class="eyebrow-page">{c.eyebrow}</span>
    <h1 class="display ls-h1" style="font-size:clamp(2.4rem,5vw,4rem);margin-top:1rem" set:html={c.h1} />
    <p class="lead" style="margin-top:1.2rem">{c.lead}</p>
    <div class="flex" style="margin-top:1.8rem">
      <span class="magnet-wrap"><span class="magnet-inner"><a href={lp('/start')} class="btn btn-primary btn-lg">{c.ctaPrimary}</a></span></span>
      <a href={lp('/pricing')} class="btn btn-ghost btn-lg">{c.ctaSecondary}</a>
      <a href={c.wa} class="btn btn-wa" target="_blank" rel="noopener">
        <svg class="i" viewBox="0 0 24 24"><path d="M21 11.5a8.38 8.38 0 0 1-8.5 8.5 8.5 8.5 0 0 1-4-1L3 20l1.5-4.5A8.38 8.38 0 0 1 3.5 11 8.5 8.5 0 0 1 12 3a8.38 8.38 0 0 1 8.5 8.5z"/></svg>{c.waLabel}
      </a>
    </div>
    <div class="trust-row" style="margin-top:2.4rem">
      {c.trust.map(([strong, rest]) => (
        <span class="trust-item"><strong>{strong}</strong> {rest}</span>
      ))}
      <span class="trust-item tf-flag"><strong>{turnaround('unattended', lang)}</strong></span>
      <span class="trust-item tf-verify"><strong>{c.reviewNote}</strong></span>
    </div>
    <p class="queue-note">{c.queueNote}</p>
  </div>
</section>

<section class="section-tight">
  <div class="container">
    <div class="section-head"><h2 set:html={c.setH} /><p>{c.setP}</p></div>
    <div class="grid grid-3 reveal-group">
      {c.set.map(([h, p], i) => (
        <div class="card reveal pending">
          <span class="shot-n">{String(i + 1).padStart(2, '0')}</span>
          <h4>{h}</h4>
          <p>{p}</p>
        </div>
      ))}
    </div>
    <p class="set-note">{c.setNote}</p>

    <!-- THE RUNG LIST. The whole ladder rather than a "from €x": this page
         sells one kind of thing, so it has the room, and a reader who wants
         to know what twelve products cost each can find the row and stop
         reading. The VAT label is a column heading — one column, one kind of
         number, so the label belongs to the column rather than to every
         cell. -->
    <div class="rungs reveal pending">
      <span class="rungs-h">{c.ladderH}</span>
      <table class="rung-table">
        <thead>
          <tr>
            <th scope="col">{c.ladderProductsCol}</th>
            <th scope="col">{c.ladderRateCol}</th>
          </tr>
        </thead>
        <tbody>
          {rungRows.map((r) => (
            <tr><th scope="row">{r.label}</th><td>{r.rate}</td></tr>
          ))}
        </tbody>
      </table>
      <p class="rungs-note">{c.ladderNote}</p>
    </div>
  </div>
</section>

<section>
  <div class="container">
    <h2 style="margin-bottom:2rem" set:html={c.moodsH} />
    <div class="grid grid-2 reveal-group">
      {moods.map((s) => (
        <a href={lp(`/lifestyle/${s.slug}`)} class="reveal pending" style="display:block">
          <div class="photo-band tall">
            <img src={s.cardPhoto} alt={c.exampleAlt(s.name)} loading="lazy" decoding="async" width={cardSize(s.cardPhoto)[0]} height={cardSize(s.cardPhoto)[1]} />
            <div class="scrim"></div>
            <div class="caption">
              <h3 style="font-size:1.6rem"><em>{s.name}</em> &rarr;</h3>
              <p style="font-size:.92rem">{s.tagline} &middot; {moodPrice(s.slug)}</p>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<section class="section-tight">
  <div class="container">
    <div class="ed-head">
      <span class="ed-meta">{c.edMeta}</span>
      <div>
        <h2>{c.edH}</h2>
        <p class="ed-sub">{c.edSub}</p>
      </div>
    </div>
    <div class="svc-explain">
      <div class="svc-explain-main">
        <h3>{c.whatH}</h3>
        {c.whatP.map((p) => <p>{p}</p>)}
      </div>
      <aside class="svc-explain-side">
        <h3>{c.whereH}</h3>
        <ul class="svc-where-list">
          {c.where.map(([strong, rest]) => (
            <li><strong>{strong}</strong> — {rest}</li>
          ))}
        </ul>
      </aside>
    </div>
  </div>
</section>

<section class="section-tight">
  <div class="container">
    <div class="photo-split reveal pending">
      <div class="photo-split-media">
        <img src="/img/model-02.webp" alt={c.modelAlt} loading="lazy" decoding="async" width="800" height="1071" />
      </div>
      <div>
        <h2 set:html={c.modelH} />
        <p class="lead" style="margin-top:1rem">{c.modelP}</p>
        <!-- /models merged into /custom-models (AUDIT-TASK-0.md §H·8). The
             roster kept its #standard anchor precisely so links written for
             "browse the faces" still land on the faces and not on the Brand
             Model pitch above them. -->
        <div class="flex" style="margin-top:1.4rem"><a href={`${lp('/custom-models')}#standard`} class="btn btn-primary">{c.modelCta}</a></div>
      </div>
    </div>
  </div>
</section>

<section class="section-tight">
  <div class="container">
    <div class="section-head" style="text-align:center;margin-inline:auto">
      <h2>{c.gradeH}</h2>
      <p style="margin-inline:auto">{c.gradeP}</p>
    </div>
    <div class="compare-grid reveal-group" style="margin-top:2.2rem">
      {grades.map((g) => (
        <div class="reveal pending">
          <Compare
            grade
            before={g.photo}
            after={g.photo}
            beforeAlt={c.gradeBeforeAlt(g.name)}
            afterAlt={c.gradeAfterAlt(g.name)}
            beforeLabel={c.gradeFlat}
            afterLabel={g.name}
          />
          <p class="cc-label"><strong>{g.name}</strong> &middot; {c.unitLabel}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="section-tight">
  <div class="container">
    <div class="section-head" style="margin-bottom:1.8rem">
      <h2>{c.rangeH}</h2>
      <p><a href={lp('/gallery')} class="link-arrow" style="font-size:1rem">{c.rangeCta} <svg viewBox="0 0 24 24" class="i"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a></p>
    </div>
  </div>
  <div class="marquee"><div class="marquee-track">
    {marqueeItems.map((m) => (
      <div class="marquee-item">
        <img src={m.src} alt={c.exampleAlt(m.label)} loading="lazy" decoding="async" width={m.w} height={m.h} style="width:100%;height:100%;object-fit:cover" />
      </div>
    ))}
  </div></div>
</section>

<!-- WHAT CHANGES AT WINDOW_THRESHOLD PRODUCTS. This block used to be section
     13's two doors — "order individual products" against "run a whole drop" —
     a choice the buyer made. Size makes it now, so the component states a line
     rather than offering a fork; see TierCompare.astro's own header.
     One shared component, not a paragraph pasted into each service page: the
     tier facts it prints all come from pricing.js accessors, so /catalog,
     /lifestyle, /video and /pricing cannot drift apart in either language.
     See TierCompare.astro for why both columns are styled identically. -->
<section class="section-tight">
  <div class="container">
    <TierCompare lang={lang} />
  </div>
</section>

<section class="section-tight">
  <div class="container">
    <div class="cta-band reveal pending">
      <h2 class="display" style="font-size:clamp(2.2rem,5vw,3.6rem)" set:html={c.ctaH} />
      <p class="lead" style="margin:1.2rem auto 0;text-align:center">{c.ctaP}</p>
      <div class="flex" style="justify-content:center;margin-top:2rem">
        <span class="magnet-wrap"><span class="magnet-inner"><a href={lp('/start')} class="btn btn-primary btn-lg">{c.ctaPrimary}</a></span></span>
