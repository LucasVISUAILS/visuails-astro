---
import { waHref } from '../data/whatsapp.js';
// VISUAILS — /lifestyle and /nl/lifestyle share this body.
//
// Same reasoning as CatalogPage.astro: the two locales were separate 181-line
// inline pages holding their own copies of the price. They agreed only
// because nobody had edited either since the port. A `lang` prop makes EN/NL
// parity a property of the file layout instead of anyone’s diligence.
//
// Two data sources were also inlined here and are now imported: the four
// moods came from a five-entry literal that duplicated src/data/styles.js,
// and the price on every one of those entries was typed by hand. The moods
// now come from the shared module and the euro comes from pricing.js.
//
// THE PRICE IS A LADDER NOW, not a flat rate (August 2026 — section 0 of
// src/data/pricing.js is the governing document). A lifestyle carousel used to
// be one figure per product, printed in the hero, the trust row, every mood
// card and the closing band. The rate starts at the entry rung and falls as
// the count rises, so one figure would be quoting what a SINGLE product costs
// as though it were the price of a season. Every mention now names the entry
// rate and the floor together, and the rung list under the set block prints
// the whole thing.
//
// EVERY PRINTED PRICE CARRIES A VAT LABEL, from vatLabel() — BRIEF-14's
// hardest rule, and never a typed "excl. VAT", because that string has to
// translate and it has to move if the rule moves.
//
// "DROP" IS NOT WHAT WE SELL. It means a collection going live, which is what
// it means to the brands we sell to; a work order is an order, or a batch —
// in Dutch, een bestelling. The word survives on this page only where the
// CLIENT's own launch is meant (the `where` list's "seasonal drops").
//
// SERVICE LEVEL FOLLOWS SIZE: from WINDOW_THRESHOLD products an order gets the
// reserved window, below it the standard queue. The timing strings still come
// from turnaround(); what changed is that this page names the count.
import {
  TIERS, LADDER, ladderRate, ladderFloor, euro, vatLabel,
  WINDOW_THRESHOLD, reviewClaim, turnaround, CATALOG_IMAGES, LIFESTYLE_IMAGES,
  clause, FORM_MAX_PRODUCTS,
} from '../data/pricing.js';
/* De vragen onderaan deze pagina staan in faq.js en niet meer hier. Reden:
   schema.js bouwt zijn FAQPage-knoop uit het pad en kan de frontmatter van
   een component niet lezen — zie de kop boven serviceFaqs(). */
import { serviceFaqs } from '../data/faq.js';
import { localizedPath } from '../i18n/ui.js';
import Disclose from './Disclose.astro';
import TierCompare from './TierCompare.astro';
import { styles as stylesEn } from '../data/styles.js';
import { styles as stylesNl } from '../data/styles.nl.js';

import ServiceSwitch from './ServiceSwitch.astro';
import '../styles/stijl22.css';
import HeroFacts from './HeroFacts.astro';
import StyleRows from './StyleRows.astro';
interface Props { lang: 'en' | 'nl'; }
const { lang } = Astro.props;
const lp = (p: string) => localizedPath(lang, p);
const nl = lang === 'nl';

const moods = lang === 'nl' ? stylesNl : stylesEn;

// The ladder for this page's one kind, read rather than typed. Both ends are
// needed wherever a rate is quoted: the entry rate alone makes a fifty-product
// order look three times more expensive than it is, and the floor alone quotes
// a price almost nobody's first order pays.
const KIND = 'lifestyle';
const entry = ladderRate(KIND, 1);
const floor = ladderFloor(KIND);
const rungs = LADDER[KIND];
const floorFrom = rungs[rungs.length - 1][0];
const rungRows = rungs.map(([lo, hi, rate]) => ({
  label: hi === null ? `${lo}+` : `${lo}–${hi}`,
  rate: euro(rate, lang),
}));
const t0 = TIERS.unattended;


// GRADES (de vier schuifvergelijkingen) stond hier tot 4 september 2026; het blok is weg, zie de noot bij de sectie.

// w/h are the intrinsic pixel size of each file in public/img. .marquee-item
// is a fixed 4/5 box and the image covers it, so these change nothing you can
// see — they stop the row reflowing as each photo arrives (§12).
const marqueeItems = [
  { src: '/img/lifestyle-phone-made-06.webp', label: 'Phone-made', w: 2400, h: 1792 },
  { src: '/img/lifestyle-glow-03.webp', label: 'Glow', w: 768, h: 1376 },
  { src: '/img/lifestyle-flash-05.webp', label: 'Flash', w: 2400, h: 1792 },
  { src: '/img/lifestyle-dunes-02.webp', label: 'Dunes', w: 928, h: 1152 },
  { src: '/img/banners-02.webp', label: 'Campaign', w: 928, h: 1152 },
];

// The mood cards render `cardPhoto` straight off src/data/styles.js, which
// carries paths and no sizes. Their intrinsic size is recorded here — read off
// the files, not off the .photo-band box they crop into. Unlisted throws, so a
// restyled card cannot quietly ship without its aspect-ratio box.
const CARD_INTRINSIC: Record<string, [number, number]> = {
  '/img/banners-13.webp': [2400, 1792],
  '/img/lifestyle-dunes-01.webp': [928, 1152],
  '/img/lifestyle-flash-02.webp': [1340, 2400],
  '/img/lifestyle-glow-01.webp': [1340, 2400],
  '/img/lifestyle-phone-made-11.webp': [2400, 1792],
};
const cardSize = (src: string): [number, number] => {
  const d = CARD_INTRINSIC[src];
  if (!d) throw new Error(`LifestylePage.astro: no intrinsic size on record for ${src} — add it to CARD_INTRINSIC.`);
  return d;
};

// No `as const` — COPY[lang] on a const-asserted object gives a union of
// readonly tuples and .map() on that union is a TS error.
const COPY = {
  en: {
    eyebrow: 'Lifestyle',
    // <em> added task #271b (Lucas's own request, editorial accent) — same
    // closing-phrase-emphasis convention as the other hero H1s.
    h1: 'Your product, in scenes <em>that sell.</em>',
    /* De prijszin is eruit, zoals op /catalog: het bedrag staat twee regels
       lager in de specificatiestrook, en een bedrag lees je niet in lopende
       tekst. Wat de lead nog doet is wat de strook niet kan — zeggen wat je
       krijgt. Zie de noot bij `lead` in CatalogPage.astro. */
    lead: `Four signature looks. A 3-photo carousel per product: one scene shot, one on-model shot and a detail close-up, all matched.`,
    // SECTION 13: Tier 0 "must NOT appear ... in any hero." See CatalogPage for
    // the full note — this button carried the tier label verbatim, in the hero,
    // on a link that lands on /start's two-way fork.
    ctaPrimary: 'Order lifestyle images',
    ctaSecondary: 'See the price per product',
    wa: waHref("Hi VISUAILS, I'd like to order lifestyle images for my products."),
    waTalk: waHref("Hi VISUAILS, I'd like to talk about lifestyle images for my brand."),
    waLabel: 'WhatsApp',
    // Two figures, not one. A single rate here is the exact claim the ladder
    // retired — see the note at the top of this file.
    trust: [
      [`${euro(entry, 'en')} – ${euro(floor, 'en')}`, `per product · ${vatLabel('excl', 'en')}`],
      ['3 photos', 'per product'],
    ],
    // Visible, not buried. Section 13: a visitor must not be able to leave
    // this page believing a delivery date was promised — and now that size
    // decides the service level, the line names the count as well.
    queueNote: `Under ${WINDOW_THRESHOLD} products: ${clause(t0.queue.en).toLowerCase()}. From ${WINDOW_THRESHOLD}, we hold a delivery date for the order and confirm it in writing.`,
    kiesCta: 'Pick your look',
    levert: 'three photos per product.',
    setH: 'One product. Three photos. <em>A carousel.</em>',
    setP: 'Every lifestyle order is your product in one styled look, delivered as three shots that belong together — ready to post as a carousel on Instagram, your shop and ads.',
    // Numbered because a carousel genuinely is an ordered sequence: this is
    // the order the three photos are meant to be posted in.
    set: [
      ['The scene', 'Your product styled in a real-world setting — the atmosphere shot that stops the scroll.'],
      ['On-model', 'The same product worn or held, so people can picture it in their own life.'],
      ['Logo close-up', 'A tight detail shot — same vibe, same colour grade — that proves the quality.'],
    ],
    setNote: 'One styled look per order · same colour grading · a different scene is a separate order.',
    ladderH: 'What a carousel costs',
    ladderProductsCol: 'Products',
    ladderRateCol: `Per product · ${vatLabel('excl', 'en')}`,
    ladderNote: `The rate applies to every product in the order, not only the ones above that count — so ${floorFrom} products are ${euro(floor, 'en')} each, all of them. More than ${FORM_MAX_PRODUCTS} at once is fine too: we split those over delivery dates, at the same rate per product.`,
    // The button under the rung table. /catalog has had one since the ladder
    // landed and this page did not, so the one page that shows a full rate card
    // was also the one that made you scroll past it to act on it.
    ladderCta: 'Order lifestyle images',
    stepsH: 'Three steps to a carousel.',
    steps: [
      ['Send your photos', 'Front and back at least — more is always welcome.'],
      ['Pick a mood', 'Dunes, Flash, Glow, Phone-made — or your own.'],
      [turnaround('unattended', 'en'), 'Three matched shots, ready to post.'],
    ],
    stepsAlt: 'A styled lifestyle scene made by VISUAILS',
    heroAlt: 'A product styled in a Dunes lifestyle scene by VISUAILS',
    checkH: 'Everything a feed post needs.',
    check: [
      'Three photos, one styled look',
      'The same colour grade across the set',
      'An on-model shot in every carousel',
      'Sized for feed, carousel and ads',
      reviewClaim('unattended', 'en'),
    ],
    checkAlt: 'A VISUAILS lifestyle carousel shot, styled and graded',
    moodsH: 'Four moods — or <em>your own.</em>',
    onRequest: 'On request',
    // The mood cards are small, so they carry the two ends of the ladder and
    // nothing else — the full rung list is one section above them.
    unitLabel: `${euro(entry, 'en')} – ${euro(floor, 'en')} / product · ${vatLabel('excl', 'en')}`,
    edMeta: '( Where it fits )',
    edH: `Lifestyle photography: your product in a styled scene, ${LIFESTYLE_IMAGES} photos per product.`,
    edSub: 'The scenes that create want, not just clarity.',
    whatH: 'What it is',
    whatP: [
      'Where catalog shows the product plainly, lifestyle photography puts it in a world — styled, lit and shot as a scene someone wants to step into. A VISUAILS lifestyle order is three photos of one product in a single look: a scene shot, an on-model shot and a detail close-up, all matched in grade, so they read as one story and post straight to a feed as a carousel.',
      "This is the imagery that does the emotional work. It doesn’t just say what the product is; it shows people who they’d be with it. That’s why it belongs where people scroll for inspiration rather than specs — and why it’s often the difference between a listing that gets browsed and a brand that gets followed.",
    ],
    whereH: 'Where it lives',
    where: [
      ['Instagram & TikTok', 'feed posts, carousels and Reels covers.'],
      ['Paid ads', 'creative built to stop the scroll.'],
      ['Your homepage', 'hero and lookbook moments.'],
      ['Email & campaigns', 'seasonal drops and newsletters.'],
    ],
    modelH: 'Add a consistent <em>model.</em>',
    modelP: 'Same face, across your whole collection — or let us choose one that fits.',
    modelAlt: 'A VISUAILS model, styled consistently across a campaign',
    modelCta: 'Explore models',
    gradeH: 'Four moods. Four transformations.',
    gradeP: 'The same shot, flat vs. finished in each VISUAILS style.',
    gradeFlat: 'Flat',
    gradeBeforeAlt: (n: string) => `A flat, ungraded ${n} scene`,
    gradeAfterAlt: (n: string) => `The same scene finished in the ${n} lifestyle look`,
    rangeH: 'The range, in motion',
    rangeCta: 'See the full gallery',
    exampleAlt: (n: string) => `${n} lifestyle example`,
    reviewNote: reviewClaim('unattended', 'en'),
    faqH: 'Lifestyle questions, answered',
    faqs: serviceFaqs('lifestyle', 'en'),
    ctaH: 'Put your product <br>in a scene that sells.',
    ctaP: `${euro(entry, 'en')} per product, down to ${euro(floor, 'en')} from ${floorFrom} up — ${vatLabel('excl', 'en')}.`,
  },
  nl: {
    eyebrow: 'Lifestyle',
    h1: 'Jouw product, in scènes <em>die verkopen.</em>',
    /* De prijszin is eruit, zoals op /catalog: het bedrag staat twee regels
       lager in de specificatiestrook, en een bedrag lees je niet in lopende
       tekst. Wat de lead nog doet is wat de strook niet kan — zeggen wat je
       krijgt. Zie de noot bij `lead` in CatalogPage.astro. */
    lead: `Vier vaste looks. Een carousel van 3 foto’s per product: een sfeershot, een foto op model en een detail-close-up, met dezelfde grading.`,
    ctaPrimary: 'Bestel lifestylefoto’s',
    ctaSecondary: 'Bekijk de prijs per product',
    wa: waHref("Hoi VISUAILS, ik wil graag lifestylefoto’s bestellen voor mijn producten."),
    waTalk: waHref("Hoi VISUAILS, ik wil graag praten over lifestylefoto’s voor mijn merk."),
    waLabel: 'WhatsApp',
    trust: [
      [`${euro(entry, 'nl')} – ${euro(floor, 'nl')}`, `per product · ${vatLabel('excl', 'nl')}`],
      ['3 foto’s', 'per product'],
    ],
    queueNote: `Onder ${WINDOW_THRESHOLD} producten: ${clause(t0.queue.nl).toLowerCase()}. Vanaf ${WINDOW_THRESHOLD} producten houden we een leverdatum voor je vrij en zetten we die vast.`,
    kiesCta: 'Kies je look',
    levert: 'drie foto’s per product.',
    setH: 'Eén product. Drie foto’s. <em>Een carousel.</em>',
    setP: 'Elke lifestyle-bestelling is je product in één gestylede look, geleverd als drie foto’s die bij elkaar horen — klaar voor een carousel op Instagram, voor je shop en voor je advertenties.',
    set: [
      ['De sfeer', 'Je product gestyled in een echte omgeving — de foto die de sfeer van je merk laat zien.'],
      ['On-model', 'Hetzelfde product gedragen of vastgehouden, zodat mensen het in hun eigen leven zien.'],
      ['Logo-close-up', 'Een strakke detailfoto — zelfde sfeer, zelfde kleurbewerking — die laat zien hoe het is afgewerkt.'],
    ],
    setNote: 'Eén gestylede look per bestelling · zelfde kleurbewerking · een andere scène is een aparte bestelling.',
    ladderH: 'Wat een carousel kost',
    ladderProductsCol: 'Producten',
    ladderRateCol: `Per product · ${vatLabel('excl', 'nl')}`,
    ladderNote: `Het tarief geldt voor elk product in de bestelling, niet alleen voor de producten boven die grens — ${floorFrom} producten kosten dus allemaal ${euro(floor, 'nl')}. Meer dan ${FORM_MAX_PRODUCTS} in één keer kan ook: die verdelen we over leverdata, tegen hetzelfde tarief per product.`,
    ladderCta: 'Bestel lifestylefoto’s',
    stepsH: 'Drie stappen naar een carousel.',
    steps: [
      ['Stuur je foto’s', 'Voorkant en achterkant in elk geval — meer mag altijd.'],
      ['Kies een sfeer', 'Dunes, Flash, Glow, Phone-made — of je eigen.'],
      [turnaround('unattended', 'nl'), 'Drie shots die matchen, klaar om te posten.'],
    ],
    stepsAlt: 'Een gestylede lifestyle-scène gemaakt door VISUAILS',
    heroAlt: 'Een product gestyled in een Dunes-lifestylescène van VISUAILS',
    checkH: 'Alles wat een feedpost nodig heeft.',
    check: [
      'Drie foto’s, één gestylede look',
      'Dezelfde kleurbewerking door de hele set',
      'Eén foto op een model in elke carousel',
      'Op maat voor feed, carousel en advertenties',
      reviewClaim('unattended', 'nl'),
    ],
    checkAlt: 'Een lifestylefoto van VISUAILS voor een carousel, gestyled en kleurbewerkt',
    moodsH: 'Vier sferen — of <em>je eigen.</em>',
    onRequest: 'Op aanvraag',
    unitLabel: `${euro(entry, 'nl')} – ${euro(floor, 'nl')} / product · ${vatLabel('excl', 'nl')}`,
    edMeta: '( Waar het past )',
    edH: 'Lifestylefotografie: je product gedragen, in een echte omgeving.',
    edSub: 'Lifestylefoto’s voor je feed en je advertenties, niet voor je productpagina.',
    whatH: 'Wat het is',
    whatP: [
      'Catalogfotografie laat het product helder zien; lifestylefotografie zet het in een scène — gestyled, belicht en opgebouwd als een omgeving die bij je merk past. Een VISUAILS lifestyle-bestelling is drie foto’s van één product in één look: een sfeershot, een on-model shot en een detail-close-up, met dezelfde grade, zodat ze bij elkaar horen en je ze meteen als carousel kunt posten.',
      'Een catalogusfoto laat zien wat het product is. Een lifestylebeeld laat zien hoe het eruitziet als iemand het draagt. Dat is wat je nodig hebt op de plekken waar mensen niet naar specificaties komen kijken.',
    ],
    whereH: 'Waar je het gebruikt',
    where: [
      ['Instagram & TikTok', 'feedposts, carousels en Reels-covers.'],
      ['Advertenties', 'lifestylefoto’s die in een advertentie werken, waar een catalogusfoto te kaal is.'],
      ['Je homepage', 'hero- en lookbook-momenten.'],
      ['E-mail & campagnes', 'seizoensdrops en nieuwsbrieven.'],
    ],
    modelH: 'Voeg een consistent <em>model</em> toe.',
    modelP: 'Hetzelfde gezicht, door je hele collectie — of laat ons er een uitkiezen dat bij je past.',
    modelAlt: 'Een VISUAILS-model, consistent gestyled door een hele campagne',
    modelCta: 'Ontdek modellen',
    gradeH: 'Vier sferen. Dezelfde foto, vier keer anders afgewerkt.',
    gradeP: 'Dezelfde foto, plat en afgewerkt, in elke VISUAILS-stijl.',
    gradeFlat: 'Plat',
    gradeBeforeAlt: (n: string) => `Een platte, ongecorrigeerde ${n}-scène`,
    gradeAfterAlt: (n: string) => `Dezelfde scène afgewerkt in de ${n} lifestyle-look`,
    rangeH: 'Het assortiment, in beweging',
    rangeCta: 'Bekijk de volledige galerij',
    exampleAlt: (n: string) => `${n} lifestyle-voorbeeld`,
    reviewNote: reviewClaim('unattended', 'nl'),
    faqH: 'Lifestyle-vragen, beantwoord',
    faqs: serviceFaqs('lifestyle', 'nl'),
    ctaH: 'Zet je product <br>in een scène die verkoopt.',
    ctaP: `${euro(entry, 'nl')} per product, tot ${euro(floor, 'nl')} vanaf ${floorFrom} — ${vatLabel('excl', 'nl')}.`,
  },
};

const c = COPY[lang];
// The custom mood is quoted, not listed — everything else is a Tier 0 line
// item at the per-product price. Keeping this rule here rather than in
// styles.js means no euro figure ever enters the style data.
const moodPrice = (slug: string) => (slug === 'custom' ? c.onRequest : c.unitLabel);

/* ── ELKE SFEER ZIJN EIGEN REGEL, DE EIGEN LOOK BOVENAAN — 4 september 2026 ──
   Zie de kop van StyleRows.astro. De data blijft styles.js; hier wordt hij
   alleen in de vorm gezet die die component tekent. */
/* De kleur van elke look: zand, koud flitslicht, het paars van Glow, het blauw
   van een telefoonhemel. Sinds de opmaakronde van 4 september is dat geen gloed
   meer achter de foto's maar een zwakke weerkaatsing eronder plus het streepje
   onder de naam — zie StyleRows.astro. */
const TINT: Record<string, string> = { dunes: '#c9a06a', flash: '#9fb3c8', glow: '#a86bd6', 'phone-made': '#5f7fa8', custom: '#D2E04A' };
const naarRij = (s: (typeof moods)[number]) => ({
  slug: s.slug,
  name: s.name,
  tagline: s.tagline,
  desc: s.cardDesc,
  price: moodPrice(s.slug),
  bestFor: s.bestFor || [],
  media: { src: s.cardPhoto, w: cardSize(s.cardPhoto)[0], h: cardSize(s.cardPhoto)[1], alt: c.exampleAlt(s.name) },
  /* De waaier: DRIE beelden, want een lifestyle-bestelling levert er drie per
     product. Lucas, 4 september: *"Bij lifestyle moeten dus 3 + before foto."*
     Ze komen uit wat de stijl al meebrengt (kaart, hero, before/after, het
     raster), ontdubbeld. Geen maten — de kaarten hebben een vast kader en het
     beeld vult het. */
  photos: [...new Set([s.cardPhoto, s.heroPhoto, s.beforeAfter?.before, s.beforeAfter?.after, ...(s.grid || []).map((g: any) => g.photo),
      /* De eigen look heeft geen eigen reeks — dat is het punt. Twee campagnebeelden erbij, zodat de waaier laat zien hoe verschillend het kan. */
      ...(s.slug === 'custom' ? ['/img/banners-09.webp', '/img/banners-10.webp'] : [])].filter(Boolean))]
    .slice(0, 3).map((src, i) => ({ src, alt: i === 0 ? c.exampleAlt(s.name) : '' }))
    /* Altijd drie kaarten, ook als een look nog maar twee beelden heeft: het
       aantal is de belofte van de dienst en niet de stand van de fotomap. Wat
       er nog niet is, is een kaart met "Foto volgt" — dezelfde afspraak als
       elders op de site zolang de foto's gemaakt worden. */
    .concat([{}, {}]).slice(0, 3),
  before: { src: '/img/catalog-before-1x1.webp', alt: '' },
  tint: TINT[s.slug] || undefined,
  detailHref: lp(`/lifestyle/${s.slug}`),
  detailLabel: nl ? `Ontdek ${s.name}` : `Explore ${s.name}`,
  orderHref: s.orderHref,
  /* Geen eigen knoptekst meer voor een vaste look: die heten allemaal "Kies
     deze look", want de knop is sinds vandaag de KEUZE en niet de bestelling.
     Alleen de look op maat houdt zijn eigen tekst (een aanvraag, geen keuze). */
  orderLabel: s.orderLabel || undefined,
});
const eigenLook = naarRij(moods.find((s) => s.slug === 'custom')!);
const vasteLooks = moods.filter((s) => s.slug !== 'custom').map(naarRij);
---

{/* ═══ /lifestyle IN DE STIJL VAN SECTIE 22 — 7 september 2026 ══════════════
    Achtste pagina in de stijl, en de laatste van de drie dienstpagina's. Alles
    boven deze regel is onaangeraakt: dezelfde COPY in beide talen, dezelfde
    vier sferen uit styles.js, dezelfde ladder uit pricing.js. Alleen de opmaak
    verandert, en de gedeelde componenten — ServiceSwitch, HeroFacts, StyleRows,
    TierCompare en Disclose — staan er ongewijzigd in met hun eigen toetsen- en
    aria-gedrag.

    DE MARQUEE IS EEN RIJ GEWORDEN. Het lopende beeldlint dat hier stond komt
    uit de oude opmaak (`.marquee` in global.css) en zou binnen deze stijl het
    enige zijn dat vanzelf beweegt. Het is nu een donkere kamer met vijf kaarten
    op een rij, die op een telefoon zijwaarts schuift — hetzelfde patroon als de
    set op de voorpagina. De link naar de galerij staat er nog. */}
<div class="s22">

  {/* ── 1 · DE OPENING ───────────────────────────────────────────────────── */}
  <section class="paneel" aria-labelledby="ls-h1">
    <div class="ls-open">
      {/* Dezelfde opbouw als /catalog — zie de noot daar voor waarom deze
          volgorde en waarom de WhatsApp-knop weg is. De volgorde volgt de
          vragen: wat is het, wat kost het, wat is de haak, wat doe ik nu, en
          anders. Alle dienstpagina's dragen deze vorm; dat was het punt van
          Lucas' *"maak dit consistent bij alle pagina's"*. */}
      <div class="paneel-kop">
        <p class="etiket">{c.eyebrow}</p>
        <h1 id="ls-h1" class="hoog" set:html={c.h1} />
        <p class="lopend">{c.lead}</p>
        <HeroFacts eigen={c.trust} lang={lang} />
        <p class="ls-wacht">{c.queueNote}</p>
        <p class="acties">
          <a class="knop knop-inkt" href="#looks">{c.kiesCta}</a>
          <a class="knop knop-lijn" href={lp('/pricing')}>{c.ctaSecondary}</a>
        </p>
        <ServiceSwitch current="lifestyle" lang={lang} />
      </div>
      <figure class="kaart kaart-stil kaart-breed ls-beeld">
        <img src="/img/lifestyle-dunes-01.webp" alt={c.heroAlt} loading="eager" fetchpriority="high" decoding="async" width="928" height="1152" />
        <figcaption class="mono foto-pil">{c.eyebrow} &middot; Dunes</figcaption>
      </figure>
    </div>
  </section>

  {/* ── 2 · DE LOOKS ─────────────────────────────────────────────────────── */}
  <section class="paneel" id="looks">
    <StyleRows
      lang={lang}
      dienst="lifestyle"
      h={c.moodsH}
      lead={eigenLook}
      items={vasteLooks}
      levert={c.levert}
      bestelBasis={lp('/start/lifestyle/')}
    />
  </section>

  {/* ── 3 · DE CAROUSEL, EN WAT HIJ KOST ────────────────────────────────────
      De drie foto's zijn genummerd omdat een carousel echt een volgorde is:
      dit is de volgorde waarin ze bedoeld zijn om geplaatst te worden. */}
  <section class="paneel" aria-labelledby="ls-set">
    <header class="paneel-kop">
      <h2 id="ls-set" class="hoog hoog-2" set:html={c.setH} />
      <p class="lopend">{c.setP}</p>
    </header>
    <ol class="ls-set">
      {c.set.map(([h, p], i) => (
        <li><span class="mono nr">{String(i + 1).padStart(2, '0')}</span><b>{h}</b><span class="lopend">{p}</span></li>
      ))}
    </ol>
    <p class="ls-set-noot mono">{c.setNote}</p>

    <div class="ls-ladder">
      <p class="etiket">{c.ladderH}</p>
      <div class="tabel-schuif">
        <table class="lijst">
          <thead>
            <tr>
              <th scope="col">{c.ladderProductsCol}</th>
              <th scope="col">{c.ladderRateCol}</th>
            </tr>
          </thead>
          <tbody>
            {rungRows.map((r) => (
              <tr><th scope="row">{r.label}</th><td><span class="tarief">{r.rate}</span></td></tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="lopend ls-ladder-noot">{c.ladderNote}</p>
      <p class="acties">
        <a class="knop knop-inkt" href={lp('/start/lifestyle')}>{c.ladderCta}</a>
      </p>
    </div>
  </section>

  {/* ── 4 · WAT HET IS, EN WAAR HET STAAT ─────────────────────────────────── */}
  <section class="kamer ls-kamer" aria-labelledby="ls-wat">
    <header class="kamer-kop">
      <p class="etiket">{c.edMeta}</p>
      <h2 id="ls-wat" class="hoog hoog-2">{c.edH}</h2>
      <p class="lopend">{c.edSub}</p>
    </header>
    <div class="ls-twee">
      <div class="ls-uitleg">
        <h3 class="hoog hoog-3">{c.whatH}</h3>
        {c.whatP.map((p) => <p class="lopend">{p}</p>)}
      </div>
      <aside class="ls-waar">
        <h3 class="hoog hoog-3">{c.whereH}</h3>
        <ul class="ls-waar-lijst" role="list">
          {c.where.map(([strong, rest]) => <li><b>{strong}</b><span class="lopend">{rest}</span></li>)}
        </ul>
      </aside>
    </div>
  </section>

  {/* ── 5 · DE DRIE STAPPEN ──────────────────────────────────────────────── */}
  <section class="paneel" aria-labelledby="ls-stappen">
    <header class="paneel-kop">
      <h2 id="ls-stappen" class="hoog hoog-2">{c.stepsH}</h2>
    </header>
    <ol class="ls-stappen">
      {c.steps.map(([h, p], i) => (
        <li><span class="mono nr">{String(i + 1).padStart(2, '0')}</span><b>{h}</b><span class="lopend">{p}</span></li>
      ))}
    </ol>
  </section>

  {/* ── 6 · WAT EEN FEEDPOST NODIG HEEFT, EN HET VASTE GEZICHT ───────────────
      De modelregel stond in een eigen sectie van bijna een schermhoogte voor
      één zin met een link. Hij staat nu onder de checklist in dezelfde sectie:
      het is dezelfde belofte — dit krijg je — met één regel eronder over wie
      het draagt. */}
  <section class="paneel" aria-labelledby="ls-check">
    <div class="ls-twee-licht">
      <div>
        <h2 id="ls-check" class="hoog hoog-2">{c.checkH}</h2>
        <ul class="ls-check" role="list">
          {c.check.map((li) => <li>{li}</li>)}
        </ul>
      </div>
      <figure class="kaart kaart-stil ls-checkbeeld">
        <img src="/img/lifestyle-flash-02.webp" alt={c.checkAlt} loading="lazy" decoding="async" width="1340" height="2400" />
      </figure>
    </div>

    <a class="ls-model" href={`${lp('/custom-models')}#standard`}>
      <img src="/img/model-02.webp" alt={c.modelAlt} loading="lazy" decoding="async" width="800" height="1071" />
      <span class="ls-model-t">
        <b set:html={c.modelH} />
        <span class="lopend">{c.modelP}</span>
      </span>
      <span class="pijl">{c.modelCta}</span>
    </a>
  </section>

  {/* ── 7 · HET ASSORTIMENT ────────────────────────────────────────────────
      Vijf beelden uit de vier sferen, plus een campagnebeeld. Op een telefoon
      schuift de rij zijwaarts in plaats van te stapelen: vijf staande beelden
      onder elkaar is een halve kilometer scrollen voor één argument. */}
  <section class="kamer ls-galerij" aria-labelledby="ls-range">
    <header class="kamer-kop">
      <h2 id="ls-range" class="hoog hoog-2">{c.rangeH}</h2>
    </header>
    <ul class="ls-rij" role="list">
      {marqueeItems.map((m) => (
        <li>
          <span class="kaart kaart-stil">
            <img src={m.src} alt={c.exampleAlt(m.label)} loading="lazy" decoding="async" width={m.w} height={m.h} />
          </span>
          <span class="mono">{m.label}</span>
        </li>
      ))}
    </ul>
    <p class="ls-galerij-voet">
      <a class="pijl" href={lp('/gallery')}>{c.rangeCta}</a>
    </p>
  </section>

  {/* ── 8 · WAT ER VERANDERT BIJ EEN GROTERE BESTELLING ──────────────────── */}
  <section class="paneel">
    <TierCompare lang={lang} href0="/start/lifestyle/" label0={c.ctaPrimary} />
  </section>

  {/* ── 9 · VRAGEN ───────────────────────────────────────────────────────── */}
  <section class="paneel" aria-labelledby="ls-faq">
    <header class="paneel-kop">
      <h2 id="ls-faq" class="hoog hoog-2">{c.faqH}</h2>
    </header>
    <div class="ls-vragen">
      {c.faqs.map((f) => <Disclose summary={f.q} tone="panel"><p>{f.a}</p></Disclose>)}
    </div>
  </section>

  {/* ── 10 · HET SLOT ────────────────────────────────────────────────────── */}
  <section class="paneel paneel-slot" aria-labelledby="ls-slot">
    <h2 id="ls-slot" class="hoog" set:html={c.ctaH} />
    <p class="lopend">{c.ctaP}</p>
    <p class="acties">
      <a class="knop knop-inkt" href={lp('/start/lifestyle')}>{c.ctaPrimary}</a>
      <a class="knop knop-lijn" href={`${lp('/custom-models')}#standard`}>{c.modelCta}</a>
      <a class="knop knop-lijn" href={c.waTalk} target="_blank" rel="noopener">{c.waLabel}</a>
    </p>
  </section>
</div>

<style>
  /* ── DE KOP BEGINT BOVENAAN, HET BEELD MAG ZWEVEN — 8 september 2026 ──────
     Lucas over /portal: *"bij deze pagina ook niet eerste sectie volledig
     gevuld."* Gemeten: de tekstkolom is daar 418 hoog naast een figuur van 954,
     en met `align-items: center` zweeft die tekst in het midden — 268 pixels
     wit bóven de kop. Een kop die op een derde van het paneel begint, leest als
     een fout en niet als lucht.
     Alle tien de openingsrasters op de site zijn nagemeten (kladblok/_open):
     vier stonden op 145 tot 268 pixels scheef. De regel is nu overal dezelfde:
     alles begint BOVEN. Daar begin je met lezen, daar staat de kop, en daar
     hoort het beeld ernaast te beginnen. Een uitzondering voor het beeld is
     geprobeerd en weer weggehaald: de plaatshouderfiguren komen uit een ander
     component en krijgen in Astro een eigen scope-attribuut, dus die regel
     raakte de helft van de gevallen niet — en een consistentieregel die op de
     helft van de pagina's iets anders doet, is geen regel. Eén uitlijning,
     tien pagina's, geen uitzonderingen. */
  .ls-open { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, .95fr); gap: clamp(1.5rem, 5vw, 4rem); align-items: start; }
  .ls-open .paneel-kop { margin-bottom: 0; gap: 1.1rem; }
  .ls-beeld { position: relative; }
  .ls-wacht { font-size: .92rem; color: var(--inkt-2); max-width: 40em; }

  /* De drie foto's van de carousel, als genummerde regels. Zelfde raster als
     de stappen verderop: het nummer, de naam, en wat het beeld doet. */
  .ls-set { display: grid; }
  .ls-set li { display: grid; grid-template-columns: auto minmax(0, 15rem) minmax(0, 34rem); align-items: baseline; gap: clamp(1rem, 3vw, 2.5rem); padding: clamp(1.1rem, 2.4vw, 1.8rem) 0; border-top: 1px solid var(--lijn); }
  .ls-set li:last-child { border-bottom: 1px solid var(--lijn); }
  .ls-set .nr, .ls-stappen .nr { color: var(--inkt-2); }
  .ls-set b, .ls-stappen b { font-family: var(--kop2); font-weight: 500; font-stretch: 125%; font-size: clamp(1.05rem, 1.8vw, 1.45rem); text-transform: uppercase; letter-spacing: -.01em; }
  .ls-set-noot { margin-top: 1.2rem; color: var(--inkt-2); }

  .ls-ladder { display: grid; gap: .9rem; justify-items: start; max-width: 34rem; margin-top: clamp(2.5rem, 5vw, 4rem); }
  .ls-ladder .tabel-schuif { width: 100%; }
  .ls-ladder-noot { font-size: .92rem; }

  .ls-twee { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: clamp(1.5rem, 4vw, 3.5rem); align-items: start; }
  .ls-uitleg { display: grid; gap: .9rem; }
  .ls-waar { padding-top: 1.2rem; border-top: 1px solid rgb(245 245 245 / .22); display: grid; gap: .9rem; }
  .ls-waar-lijst { display: grid; gap: .7rem; }
  .ls-waar-lijst li { display: grid; gap: .2rem; }
  .ls-waar-lijst b { font-weight: 500; }

  .ls-stappen { display: grid; }
  .ls-stappen li { display: grid; grid-template-columns: auto minmax(0, 22rem) minmax(0, 30rem); align-items: baseline; gap: clamp(1rem, 3vw, 2.5rem); padding: clamp(1.1rem, 2.4vw, 1.8rem) 0; border-top: 1px solid var(--lijn); }
  .ls-stappen li:last-child { border-bottom: 1px solid var(--lijn); }

  .ls-twee-licht { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, .8fr); gap: clamp(1.5rem, 4vw, 3.5rem); align-items: start; }
  .ls-check { display: grid; gap: .6rem; margin-top: 1.4rem; }
  .ls-check li { position: relative; padding-left: 1.4rem; color: var(--inkt-2); }
  .ls-check li::before { content: "✓"; position: absolute; left: 0; color: var(--gloed, #9EB42F); }
  /* ── HORIZONTAAL, NIET VERTICAAL — 9 september 2026 ───────────────────────
     Lucas: *"Ik wou ook dat de afbeeldingen in 1 scherm paste maar dat is nog
     steeds niet zo. Dit soort afbeeldingen werken niet zo fijn op een website.
     Maak al dit soort afbeeldingen horizontaal lang en niet verticaal."*

     Gemeten op 1440 breed: dit beeld stond op 543×723. Een staand beeld naast een
     kolom tekst duwt de sectie hoger dan het scherm, en dan lees je de tekst
     ernaast nooit in één blik. 3/2 is liggend zonder een filmstrook te worden;
     `object-position` houdt het onderwerp in beeld nu er van boven en onder
     wordt bijgesneden.

     DE KLEINE TEGELS BLIJVEN STAAND. Een producttegel in een raster (de
     galerij, de modellen, de voorbeelden) is een FOTO die je bekijkt, geen
     sectiebeeld dat naast tekst moet passen — en staand is de vorm waarin die
     beelden gemaakt zijn. */
  .ls-checkbeeld { aspect-ratio: 3 / 2; }
  .ls-checkbeeld img { object-position: 50% 34%; }
  .ls-checkbeeld img { width: 100%; height: 100%; object-fit: cover; }

  /* De modelregel: een portret, één zin, en de pijl. Geen kaart met een
     schaduw — een rand en een ronding is genoeg om te zeggen dat het één
     aanklikbaar ding is. */
  .ls-model {
    display: grid; grid-template-columns: 4.5rem minmax(0, 1fr) auto; gap: clamp(1rem, 3vw, 1.6rem); align-items: center;
    margin-top: clamp(2.5rem, 5vw, 4rem); padding: 1rem 1.3rem;
    border: 1px solid var(--lijn); border-radius: 999px; transition: border-color .3s var(--uit), background .3s var(--uit);
  }
  .ls-model:hover { border-color: var(--inkt); background: var(--tint); }
  .ls-model img { width: 4.5rem; height: 4.5rem; border-radius: 50%; object-fit: cover; object-position: center top; }
  .ls-model-t { display: grid; gap: .15rem; min-width: 0; }
  .ls-model-t b { font-family: var(--kop2); font-weight: 500; font-stretch: 125%; font-size: clamp(1.05rem, 1.8vw, 1.35rem); text-transform: uppercase; letter-spacing: -.01em; }
  .ls-model-t .lopend { font-size: .92rem; }

  .ls-rij { display: grid; grid-template-columns: repeat(5, 1fr); gap: clamp(.5rem, 1.2vw, .9rem); }
  .ls-rij li { display: grid; gap: .55rem; }
  .ls-rij .kaart { aspect-ratio: 4 / 5; }
  .ls-rij img { width: 100%; height: 100%; object-fit: cover; }
  .ls-rij .mono { font-size: .72rem; color: rgb(245 245 245 / .66); }
  .ls-galerij-voet { margin-top: clamp(1.6rem, 3vw, 2.4rem); }
  .ls-galerij-voet .pijl { color: var(--geel-letter); }

  .ls-vragen { display: grid; gap: .7rem; }

  @media (max-width: 900px) {
    .ls-open, .ls-twee, .ls-twee-licht { grid-template-columns: 1fr; }
    .ls-set li, .ls-stappen li { grid-template-columns: auto 1fr; }
    .ls-set li .lopend, .ls-stappen li .lopend { grid-column: 2; }
    .ls-model { grid-template-columns: 3.5rem minmax(0, 1fr); border-radius: var(--ronding); }
    .ls-model .pijl { grid-column: 2; }
    .ls-rij { display: flex; overflow-x: auto; scroll-snap-type: x proximity; padding-bottom: .6rem; }
    .ls-rij li { flex: 0 0 62%; scroll-snap-align: start; }
  }
</style>
