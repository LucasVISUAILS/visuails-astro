---
/*
 * VISUAILS — de detailpagina van een catalogstijl, gedeeld door
 * /catalog/[slug] en /nl/catalog/[slug].
 *
 * ── KORT EN BEELDVULLEND SINDS 11 OKTOBER 2026 (k101 = a) ─────────────────
 *
 * De pagina zelf is LookDetailHal.astro (zie daar de opbouw). Hier staat wat bij
 * catalog hoort: de beelden uit `fotos` in de lookdata (alleen echte), het
 * bewijs "jouw foto → VISUAILS" (het enige echte ruw-naar-catalogpaar in de
 * beeldbibliotheek), de feiten, en de lange uitleg die ingeklapt onder
 * "Meer over …" staat: de sfeer, de stappen, het vakwerk, waarom, wat je
 * krijgt en het model.
 *
 * Het raster van negen getekende vakken is al sinds 23 september weg; er wordt
 * nooit een vak zonder foto getekend.
 *
 * ── DE DOORLOOPTIJD IS EEN TIER-FEIT ─────────────────────────────────────
 *
 * Levertijd, controleniveau en wachtrijgedrag komen uit pricing.js en niet uit
 * de stijl. En een look OP AANVRAAG (custom) heeft eerst een ONTWERP; de
 * doorlooptijd van een gewone bestelling geldt daar pas ná.
 */
/* Sinds 12 oktober 2026 (afvinklijst 8) in het sjabloon van de hal; het vorige
   sjabloon (LookDetail.astro) staat op _opruimen/LIJST.txt. hub = waar de pil terug
   naartoe wijst (standaard de eigen dienst). */
import LookDetailHal from './LookDetailHal.astro';
import { ikoon, IKOON } from '../data/iconen.js';
import { reviewClaim, turnaround, TIERS, TEST_SAMPLE } from '../data/pricing.js';
import { localizedPath } from '../i18n/ui.js';
import { isEcht } from '../lib/beeldAanwezig.js';

interface Props { lang: 'en' | 'nl'; style: any; zusters: { href: string; naam: string }[]; hub?: string; }
const { lang, style, zusters, hub } = Astro.props;
const nl = lang === 'nl';
const lp = (p: string) => localizedPath(lang, p);
/* ── DE PROEF BEGINT BIJ DEZE LOOK — 8 oktober 2026 (1.06) ───────────────── */
const proefHref = style.slug === 'custom' ? lp('/test-sample') : `${lp('/test-sample')}?style=${encodeURIComponent(style.slug)}`;

const TIMING = style.slug === 'custom'
  ? (nl ? 'Eerst het ontwerp, daarna de gewone doorlooptijd per bestelling.' : 'Design first, then the ordinary turnaround per order.')
  : turnaround('unattended', lang);
const REVIEW = reviewClaim('unattended', lang);
const QUEUE = style.slug === 'custom' ? '' : TIERS.unattended.queue[lang];
const prijs = `${style.priceTrust}${style.priceUnit ?? (nl ? ' / visual' : ' / visual')}`;

const alt = nl ? `Voorbeeld in de ${style.name}-stijl` : `${style.name}-style example`;
const beelden = [...new Set(style.fotos || [])].filter((src: any) => isEcht(src)).map((src: any) => ({ src, alt }));

/* Het bewijs alleen bij een vaste look en alleen als beide beelden echt zijn. */
const VOOR = '/img/catalog-before-1x1.webp';
const NA = '/img/catalog-after.webp';
const bewijs = style.slug !== 'custom' && isEcht(VOOR) && isEcht(NA) ? {
  before: VOOR,
  after: NA,
  ratio: '1/1',
  kop: nl ? `Wat ${style.name} met een echte foto doet.` : `What ${style.name} does to a real photo.`,
  regel: nl ? 'Een van je eigen productfoto’s, precies zo behandeld.' : 'One of your own product photos, treated exactly like this.',
  beforeLabel: nl ? 'Jouw foto' : 'Your photo',
  afterLabel: 'VISUAILS',
  beforeAlt: nl ? 'Een ruwe telefoonfoto van een t-shirt op een tafel vóór VISUAILS' : 'A raw phone photo of a t-shirt on a table before VISUAILS',
  afterAlt: nl ? `Hetzelfde t-shirt als een strakke ${style.name}-catalogvisual na VISUAILS` : `The same t-shirt as a clean ${style.name} catalog visual after VISUAILS`,
} : null;

const c = nl ? {
  kies: style.orderLabel ?? 'Kies deze look',
  voeltH: `Hoe ${style.name} voelt`,
  stapH: 'In drie stappen',
  kaderH: 'Wat er in elk kader gaat',
  waaromH: 'Waarom het werkt',
  idealH: 'Ideaal voor',
  krijgH: 'Wat je krijgt',
  modelNoot: ['De foto op model in elke ', '-set: een standaardgezicht, of ', 'je eigen merkmodel', '.'],
} : {
  kies: style.orderLabel ?? 'Choose this look',
  voeltH: `How ${style.name} feels`,
  stapH: 'In three steps',
  kaderH: 'What goes into every frame',
  waaromH: 'Why it works',
  idealH: 'Best for',
  krijgH: 'What you get',
  modelNoot: ['The on-model shot in every ', ' set: a standard face, or ', 'your own Brand Model', '.'],
};
/* het vinkje uit het kit (levering 54) */
---

<LookDetailHal
  hub={hub}
  lang={lang}
  dienst="catalog"
  style={style}
  zusters={zusters}
  feiten={[prijs, TIMING, REVIEW]}
  queue={QUEUE}
  beelden={beelden}
  bewijs={bewijs}
  kies={{ href: style.orderHref, label: c.kies }}
  proef={{ href: proefHref, label: TEST_SAMPLE[lang].cta }}
>
  <Fragment slot="meer">
    <div class="lm">
      <h3 class="hoog hoog-3">{c.voeltH}</h3>
      {style.moodParagraphs.map((p: string) => <p class="lopend">{p}</p>)}
      <h3 class="hoog hoog-3">{c.idealH}</h3>
      <ul class="lm-vinkjes" role="list">
        {style.bestFor.map((item: string) => (
          <li><svg viewBox="0 0 24 24" class="ik lm-i" aria-hidden="true" focusable="false"><path fill-rule="evenodd" d={IKOON.vink} /></svg><span>{item}</span></li>
        ))}
      </ul>
      <h3 class="hoog hoog-3">{c.stapH}</h3>
      <ol class="lm-stappen" role="list">
        {style.steps.map((s: any, i: number) => (
          <li><span class="mono lm-nr">{String(i + 1).padStart(2, '0')}</span> <b>{s.title}</b> <span>{s.body}</span></li>
        ))}
      </ol>
      <h3 class="hoog hoog-3">{c.kaderH}</h3>
      <ul class="lm-stappen" role="list">
        {style.craft.map((k: any) => <li><b>{k.title}</b> <span>{k.body}</span></li>)}
      </ul>
      <h3 class="hoog hoog-3">{c.waaromH}</h3>
      <ul class="lm-stappen" role="list">
        {style.why.map((w: any) => <li><b>{w.title}</b> <span>{w.body}</span></li>)}
      </ul>
      <h3 class="hoog hoog-3">{c.krijgH}</h3>
      <ul class="lm-vinkjes" role="list">
        {style.whatYouGet.map((item: string) => (
          <li><svg viewBox="0 0 24 24" class="ik lm-i" aria-hidden="true" focusable="false"><path fill-rule="evenodd" d={IKOON.vink} /></svg><span>{item}</span></li>
        ))}
      </ul>
      <p class="lm-noot">
        {c.modelNoot[0]}{style.name}{c.modelNoot[1]}<a href={lp('/custom-models')}>{c.modelNoot[2]}</a>{c.modelNoot[3]}
      </p>
    </div>
  </Fragment>
</LookDetailHal>
