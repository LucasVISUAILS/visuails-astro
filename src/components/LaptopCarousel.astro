  }
  .lc-slide.is-aan {
    opacity: 1; visibility: visible; pointer-events: auto;
    transition: opacity .55s cubic-bezier(.33, 1, .68, 1), visibility 0s;
  }
  /* ── LET OP: DE BOUW WIKKELT ELKE <img> IN EEN <picture> ───────────────────
     De beeldstap van de build zet er een <source type="image/avif"> voor en
     stopt het geheel in een <picture>. Dat heeft twee gevolgen die allebei een
     keer stuk zijn gegaan:

     1. In een flexrij is die <picture> het item en niet de <img>. Zonder de
        regel hieronder kreeg de avatar naast het bijschrift `flex-shrink: 1`
        van de picture mee en werd hij van 19 naar 12 pixels geknepen: een
        ovaal in plaats van een rondje. `display: contents` laat de picture uit
        de opmaak verdwijnen zodat de <img> zelf weer het item is.
     2. Een kindselector met `>` slaat de <img> over, want in de DOM zit de
        picture ertussen. Vandaar het tweede pad in de regel daaronder.

     Waarom niet gewoon `.lc-slide img`? Omdat die regel het dan ook wint van
     elke foto diep in een nagebouwd scherm — een avatar van 44 pixels werd zo
     een schijf van 125.

     3. De <picture> komt er ná het scopen van Astro in en draagt dus GEEN
        `data-astro-cid-…`. Een gewone regel wordt gescopet tot
        `picture[data-astro-cid-…]` en raakt hem daarom nooit. Vandaar
        `:global(picture)` — de enige plek in dit bestand waar dat nodig is. */
  .lc-slide :global(picture) { display: contents; }
  .lc-slide > img, .lc-slide > video,
  .lc-slide > :global(picture) > img { width: 100%; height: 100%; object-fit: cover; display: block; }


  /* ── DE STAPEL: VIER FOTO'S ONDER ELKAAR ──────────────────────────────────
     Geen samengestelde plaat meer maar echte losse beelden in het scherm, met
     de winkelonderdelen ernaast op 30%. Alle maten in `cq`-eenheden, want de
     doos schaalt met het venster en een vaste pixelmaat zou op een telefoon
     twee keer zo groot ogen als op een groot scherm.

     `container-type: size` mag hier omdat de slide `inset: 0` in een doos met
     een vaste procentuele maat staat: zijn hoogte hangt niet van zijn inhoud
     af, dus er ontstaat geen kringverwijzing. */
  /* ── DE SPELER ─────────────────────────────────────────────────────────────
     Een verticale clip in een liggend scherm. De grond is dezelfde clip,
     uitvergroot tot hij het scherm vult, onscherp en donkerder; de clip zelf
     staat er scherp voor op volle hoogte. Zo is er geen dood zwart meer naast
     het beeld en blijft de clip heel. */
  /* `grid-template: 100% / 100%` en niet alleen `place-items`: een automatische
     rij groeit mee met de EIGEN hoogte van het beeld (1456 px), en dan rekent
     `height: 100%` op de clip hieronder tegen die 1456 in plaats van tegen het
     scherm. Gemeten toen dat misging: een clip van 1009 px hoog in een scherm
     van 412. Een vaste baan van 100% houdt hem binnen het scherm. */
  .lc-speler { position: absolute; inset: 0; overflow: hidden; background: #000000; display: grid; grid-template: 100% / 100%; place-items: center; }
  .lc-speler-grond {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;
    filter: blur(28px) saturate(1.15) brightness(.55); scale: 1.18;
  }
  /* De clip: volle hoogte, breedte volgt de verhouding. `position: relative`
     zodat hij boven de grond staat zonder een z-index te hoeven verzinnen. */
  /* `position: relative` is hier geen opmaak maar stapelvolgorde: de grond
     hierboven staat absoluut en zou anders ÓVER de clip vallen, want een
     gepositioneerd element wint van een gewoon element in de stroom. Twee
     gepositioneerde lagen laten de DOM-volgorde beslissen, en de clip staat
     later. Gemeten toen dat misging: een scherm met alleen waas erop. */
  .lc-speler-clip {
    position: relative;
    grid-area: 1 / 1; justify-self: center; align-self: center;
    height: 100%; width: auto; max-width: 100%; max-height: 100%;
    object-fit: contain; display: block;
  }
  @media (prefers-reduced-motion: reduce) {
    .lc-speler-grond { filter: blur(18px) brightness(.6); scale: 1.1; }
  }

  .lc-slide { container-type: size; }
  .lc-blad { position: absolute; inset: 0; overflow: hidden; background: #FFF; }

  /* ── DE ROL IS EEN ECHTE SCHUIFBAK ────────────────────────────────────────
     Lucas: *"Bij catalog wil ik echt een beetje een editorial vibe dat je de
     volgende foto groot eronder ziet. Als de klant met zijn muis op de laptop
     staat moet hij ook naar beneden kunnen scrollen op die pagina omdat de
     diaslides dan pauzeren."*

     Dat kan niet met `translate`: dan bepaalt het script waar je bent en kun je
     er zelf niet in. Dit is daarom een gewone schuifbak met snappunten. Het
     afspelen schuift hem programmatisch op, de muis kan hetzelfde doen, en
     omdat hoveren het afspelen al pauzeerde vechten die twee elkaar niet.

     Een vak is 80% van de schermhoogte en niet 100%: daardoor staat de vólgende
     foto er altijd al voor een vijfde onder. Dat is de hele editorial-truc — je
     ziet dat er meer is zonder dat er een balk of een bolletje voor nodig is.
     De balk zelf is verborgen; de foto eronder is de aanwijzing.

     De ::after is geen versiering maar rekenwerk: zonder die 20% extra ruimte
     onderaan kan het láátste vak nooit bovenaan komen (4 × 80% inhoud in een
     bak van 100% geeft 220% schuifruimte, en het laatste vak wil naar 240%). */
  .lc-rol { display: flex; flex-direction: column; height: 100%; translate: 0 0;
            /* Uit-expo: hard weg, zacht aan. Dat leest als "dit stopt precies
               waar het hoort" in plaats van als een schuif die uitbolt. */
            transition: translate .72s cubic-bezier(.16, 1, .3, 1);
            scroll-behavior: smooth;
            overflow-y: auto; scroll-snap-type: y mandatory; scrollbar-width: none; }
  .lc-rol::-webkit-scrollbar { display: none; }
  /* 14 en niet 20: het vak is op 17 september van 80 naar 86cqh gegaan, en deze
     staart is precies de ruimte die het láátste vak nodig heeft om bovenaan te
     kunnen komen. Blijft hij op 20 staan, dan schuift de rol een stuk te ver
     door en eindigt hij op leegte. */
  .lc-rol::after { content: ""; flex: 0 0 14cqh; }
  .lc-slide:not(.is-aan) .lc-rol { transition: none; }

  /* Een vak is een editorial opmaak: het etiket in de buitenmarge, de foto
     ernaast. Samen staan ze gecentreerd in de ZICHTBARE 74,4% — de telefoon
     begint daar, (67,7827 − 14,9182) ÷ 71,0193. */
  /* Stil is er geen volgende foto om onder te laten doorkijken, dus dan vult
     het vak het hele scherm en staat het beeld gewoon gecentreerd. */
  .lc.is-stil .lc-vak { flex-basis: 100cqh; padding-bottom: 5cqh; }
  .lc.is-stil .lc-rol::after { content: none; }
  /* ── DE FOTO MAG GROTER — 17 september 2026 ───────────────────────────────
     Lucas: *"De productfoto's in de laptop mogen wel wat groter."*

     Gemeten voor de ingreep: het scherm is 575 × 349 en de foto 248 × 248 —
     71% van de hoogte en 43% van de breedte. Die 43% klinkt als ruimte over,
     maar de foto is VIERKANT en wordt door de HOOGTE begrensd; de overgebleven
     breedte kan hij niet gebruiken. Breder maken doet dus niets; hoger maken is
     het enige dat werkt.

     Twee stappen, en de tweede is de goedkoopste:

       het vak      80cqh → 86cqh
       de lucht     5 + 4 → 3 + 3 cqh

     Samen gaat de foto van 71 naar 80cqh. Wat het kost is de doorkijk naar de
     volgende foto: die zakt van 20% naar 14% van het scherm. Nog steeds genoeg
     om te zien dat er meer is — en dat is precies waar die doorkijk voor is,
     zie de noot bij .lc-rol hierboven. Onder de 10% zou hij een streep worden
     in plaats van een aanwijzing, dus daar ligt de grens. */
  .lc-vak {
    flex: 0 0 86cqh; min-height: 0; margin: 0; scroll-snap-align: start;
    display: flex; align-items: flex-start; justify-content: center;
    gap: 2.6cqw; padding: 3cqh 25.6cqw 3cqh 0;
  }
  .lc-beeld { flex: none; height: 100%; aspect-ratio: 1; display: block; }
  .lc-beeld img { width: 100%; height: 100%; object-fit: cover; display: block; }

  /* Het etiket zegt welke plek dit beeld inneemt. In de marge, klein, want de
     foto is de hoofdzaak; limoen, want het is het enige op dit scherm dat van
     ons is. */
  .lc-merkje {
    /* In de DOM staat het bijschrift ná de foto — zo hoort een <figure> te
       lezen. Op het scherm hoort het in de LINKERmarge: rechts botst het tegen
       de verbleekte winkelkolom aan. `order` verplaatst alleen het beeld. */
    order: -1;
    flex: none; width: 12cqw; margin-top: .4cqh;
    display: flex; flex-direction: column; align-items: flex-start; gap: .55em;
    font-family: var(--mono, var(--font-mono)); font-size: 1.95cqh; font-stretch: 82%;
    letter-spacing: .1em; text-transform: uppercase; color: #141414;
  }
  .lc-merkje b { background: var(--lc-accent); color: var(--lc-op-accent); font-weight: 700; padding: .25em .5em; }


  /* ── SCROLLGESTUURDE BEWEGING ─────────────────────────────────────────────
     Lucas: *"Voeg wat fijne satisfying scrollanimaties toe."*

     Dit loopt op de scrolpositie zelf, niet op een klok: `animation-timeline:
     view()` koppelt de animatie aan hoe ver een vak in de schuifbak zichtbaar
     is. Daardoor volgt de beweging je vinger of je wiel precies, ook als je
     halverwege stopt of terugscrollt — dát is wat het prettig maakt, niet de
     animatie zelf.

     De foto die onderaan staat te wachten is iets kleiner en lichter; hij komt
     op maat en op kleur zodra hij de hoofdfoto wordt, en zakt weer weg als hij
     er bovenuit schuift. Het etiket loopt een tikje achter, zodat het beeld
     eerst landt en het bijschrift erna. Meer niet: deze sectie is eerder al
     als te druk beoordeeld en beweging die opvalt is beweging die stoort.

     Alles staat achter twee sloten: `@supports` voor browsers die deze
     tijdlijn nog niet kennen (daar gebeurt gewoon niets, de foto's staan er
     dan normaal), en `prefers-reduced-motion` voor wie er niet om vraagt. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .lc-beeld { animation: lc-adem linear both; animation-timeline: view(block); }
      .lc-merkje { animation: lc-etiket linear both; animation-timeline: view(block); }
    }
  }
  @keyframes lc-adem {
    entry 0%   { opacity: .18; scale: .93; }
    entry 100% { opacity: 1;   scale: 1; }
    exit 0%    { opacity: 1;   scale: 1; }
    exit 100%  { opacity: .18; scale: .97; }
  }
  @keyframes lc-etiket {
    entry 0%   { opacity: 0; translate: 0 .9rem; }
    entry 92%  { opacity: 1; translate: 0 0; }
    exit 30%   { opacity: 1; translate: 0 0; }
    exit 100%  { opacity: 0; translate: 0 -.6rem; }
  }

  /* ── DE VERBLEEKTE WINKEL ─────────────────────────────────────────────────
     Dit is geen ontwerp en mag er ook niet als één uitzien. Het staat op 30%
     en grotendeels achter de telefoon: genoeg om te lezen als productpagina,
     te weinig om te lezen als aanbod. */
  .lc-schim {
    position: absolute; right: 3cqw; top: 11cqh; width: 26cqw;
    opacity: .3; color: #141414; font-size: 2.4cqh; line-height: 1.35;
    display: flex; flex-direction: column; align-items: flex-start;
  }
  .lc-schim p { margin: 0; }
  .lc-schim-kruim { font-size: .72em; opacity: .7; }
  .lc-schim-kop { font-size: 1.5em; font-weight: 600; letter-spacing: -.02em; margin-top: .6em !important; }
  .lc-schim-prijs { font-weight: 600; margin-top: .45em !important; }
  .lc-schim-bollen { display: flex; gap: .5em; margin-top: 1.3em; }
  .lc-schim-bollen i { width: 1.5em; height: 1.5em; border-radius: 50%; background: currentColor; opacity: .35; }
  .lc-schim-bollen i:first-child { opacity: .6; }
  .lc-schim-maten { display: flex; gap: .4em; margin-top: 1.2em; }
  .lc-schim-maten i {
    min-width: 2.4em; padding: .45em 0; text-align: center; font-style: normal;
    font-size: .8em; border: 1px solid currentColor; opacity: .8;
  }
  .lc-schim-knop {
    margin-top: 1.2em; width: 100%; padding: .85em 0; text-align: center;
    background: currentColor; color: #FFF; font-weight: 600; font-size: .9em;
  }

  /* ── HET PIJLTJE OMLAAG ───────────────────────────────────────────────────
     Eén haarlijn, gecentreerd onder de foto's en dus óók in de zichtbare 74,4%.
     Het wipt zachtjes: zonder die beweging ziet niemand dat er meer onder zit,
     met een balk eromheen wordt het een knop die aandacht opeist. */
  /* Het pijltje staat in de linkeronderhoek. Niet middenonder, want daar ligt
     inmiddels de vólgende foto en een grijze haarlijn op een foto is geen
     aanwijzing maar een vlek; en niet onder het etiket, want daar staat het
     etiket van de volgende foto al. */
  .lc-omlaag {
    position: absolute; bottom: 3.4cqh; left: 4.6cqw; translate: -50% 0;
    width: 7cqh; height: 7cqh; display: grid; place-items: center;
    border: 0; background: none; color: #141414; opacity: .38; cursor: pointer;
    transition: opacity .25s ease;
    /* ── HET WENKT, HOUDT OP ALS JE ER BENT, EN KOMT LATER TERUG ──────────
       20 september 2026. Lucas: *"Ik zou op de laptop ook een kleine scroll
       icoon animatie willen hebben dat flasht wanneer je niet met je muis
       eroverheen hovert. Nadat je eroverheen hebt gehovert een paar seconde
       pauze waarna hij weer terugkeert om te laten zien dat de klant hiermee
       kan interacten."*

       Het wipje bestond al; de twee andere helften niet. Ze zitten nu in één
       waarde en kosten geen regel JavaScript:

         · DE FLITS. Het pijltje springt niet alleen, het licht ook even op
           (.38 → .92). Een beweging van achttien procent van zijn eigen
           hoogte zie je met je ooghoek niet; een verandering in helderheid
           wel.
         · DE PAUZE. `2.8s` is de vertraging vóór de animatie begint. Bij het
           laden is dat rust — je krijgt eerst het beeld en pas daarna de
           aanwijzing. En omdat hover `animation: none` zet, START de animatie
           opnieuw zodra je muis weg is, mét die vertraging. De "paar seconde
           pauze waarna hij weer terugkeert" is dus niet apart geregeld; het
           is dezelfde vertraging, en daarom kan hij ook niet uit de pas gaan
           lopen met zichzelf. */
    animation: lc-wenk 3.6s cubic-bezier(.16, 1, .3, 1) 2.8s infinite;
  }
  .lc-omlaag { transition: opacity .25s ease, scale .25s cubic-bezier(.16, 1, .3, 1); }
  .lc-omlaag:hover { scale: 1.14; }
  .lc-omlaag svg { width: 100%; height: 100%; fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linecap: square; }
  .lc-omlaag:hover { opacity: 1; animation: none; }
  /* Wie beweging heeft uitgezet, krijgt geen wenkend pijltje maar wel een
     zichtbaar pijltje: de aanwijzing blijft, alleen de beweging gaat eraf. */
  @media (prefers-reduced-motion: reduce) {
    .lc-omlaag { animation: none; opacity: .6; }
  }
  /* Onderaan de galerij is er niets meer om naar te wijzen. */
  .lc-blad.is-eind .lc-omlaag { opacity: 0; pointer-events: none; }
  .lc-omlaag:focus-visible { opacity: 1; outline: 2px solid var(--lc-accent); outline-offset: 2px; }
  @keyframes lc-wenk {
    0%, 70%, 100% { translate: -50% 0; opacity: .38; }
    78%           { translate: -50% 20%; opacity: .92; }
    88%           { translate: -50% 0;  opacity: .55; }
  }


  /* ── HET NAGEBOUWDE BERICHT ───────────────────────────────────────────────
     Beelden links, gepraat rechts. De telefoon begint op 74,4% van de breedte
     en op 34,5% van de hoogte, dus de kop met de naam staat er nog vóór en de
     onderkant van de zijkolom verdwijnt erachter — precies de goede helft. */
  .lc-post { position: absolute; inset: 0; display: flex; background: #000; color: #FAFAFA;
             font-size: 2.35cqh; line-height: 1.45; letter-spacing: -.005em; }
  .lc-post-beeld { position: relative; width: 53.3cqw; flex: none; overflow: hidden; background: #000000; }
  .lc-rol[data-lc-zij] { flex-direction: row; width: 100%; overflow: hidden; scroll-snap-type: none; }
  .lc-rol[data-lc-zij]::after { content: none; }
  .lc-vak-zij { flex: 0 0 100%; height: 100%; margin: 0; }
  .lc-vak-zij img { width: 100%; height: 100%; object-fit: cover; display: block; }

  .lc-post-stip { position: absolute; bottom: 2.4cqh; left: 50%; translate: -50% 0; display: flex; gap: .55em; }
  .lc-post-stip i { width: .62em; height: .62em; border-radius: 50%; background: #FFF; opacity: .35; transition: opacity .3s ease; }
  .lc-post-stip i.aan { opacity: 1; }

  .lc-omlaag-zij {
    left: auto; bottom: auto; right: 1.6cqh; top: 50%; translate: 0 -50%;
    width: 4.6cqh; height: 4.6cqh; border-radius: 50%;
    background: rgb(255 255 255 / .8); color: #141414; opacity: .8; animation: none;
    display: grid; place-items: center;
  }
  .lc-omlaag-zij svg { width: 60%; height: 60%; stroke-width: 2.2; }
  .lc-omlaag-zij:hover { opacity: 1; background: #FFF; }
  /* De pijl terug is de spiegel van de pijl vooruit: zelfde maat, zelfde
     ronding, alleen aan de andere kant. NA de regel hierboven en niet ervoor —
     die zet `left: auto` en zou hem anders gewoon weer naar rechts trekken. */
  .lc-omlaag-terug { right: auto; left: 1.6cqh; }

  /* De zijkolom is opgebouwd zoals een berichtvenster dat echt is: een kop met
     een streep eronder, daaronder de stroom met het bijschrift en de reacties,
     en onderaan vast de knoppenrij, het aantal en het invoerveld. Elke regel
     heeft dezelfde vorm — rondje, tekst, meta-regel eronder — zodat het
     bijschrift en een reactie op elkaar rijmen in plaats van te botsen. */
  .lc-post-kant { flex: 1; min-width: 0; border-left: 1px solid #262626;
                  display: flex; flex-direction: column; overflow: hidden; }
  .lc-post-ei { width: 4.4cqh; height: 4.4cqh; border-radius: 50%; object-fit: cover; flex: none; display: block; }
  .lc-post-bol { width: 4.4cqh; height: 4.4cqh; border-radius: 50%; background: #2A2A2A; flex: none; display: block; }
  .lc-post-grijs { color: #A8A8A8; }

  .lc-post-kop { display: flex; align-items: center; gap: .55em; flex: none;
                 padding: 1.9cqh 2.2cqh; border-bottom: 1px solid #262626; }
  .lc-post-kop b { font-weight: 600; }
  .lc-post-volg { color: #4A9BF7; font-weight: 600; }
  .lc-post-meer { margin-left: auto; color: #FAFAFA; font-size: 1.15em; line-height: 1; }

  .lc-post-stroom { flex: 1; min-height: 0; overflow: hidden;
                    padding: 2.2cqh 2.2cqh 0; display: flex; flex-direction: column; gap: 2.4cqh; }
  .lc-post-regel { display: flex; gap: .85em; align-items: flex-start; }
  .lc-post-body { min-width: 0; }
  .lc-post-regel p { margin: 0; }
  .lc-post-regel b { font-weight: 600; margin-right: .35em; }
  /* De meta-regel is het verschil tussen "lijkt erop" en "klopt": tijd, aantal
     en Reageren, kleiner en grijs, met ruimte ertussen. */
  .lc-post-meta { display: flex; gap: 1.1em; margin-top: .55cqh !important;
                  font-size: .82em; color: #A8A8A8; }
  .lc-post-hartje { width: 2.6cqh; height: 2.6cqh; flex: none; margin-top: .9cqh;
                    fill: none; stroke: #A8A8A8; stroke-width: 1.7; }
  .lc-post-reacties { list-style: none; margin: 0; padding: 0;
                      display: flex; flex-direction: column; gap: 2.2cqh; }

  /* ── DE REACTIES ALS VORM — 20 september 2026 ──────────────────────────
     Zie de noot bij Reactie bovenin: er staan geen verzonnen namen of
     uitspraken meer in dit bericht, alleen de vorm van een gesprek. Vandaar
     balkjes in plaats van tekst. Ze staan in dezelfde grijstint als de bollen
     die de avatars al waren, zodat het één ding blijft en niet leest als tekst
     die niet is ingeladen. */
  .lc-post-balken { display: flex; gap: .8cqh; align-items: center; }
  .lc-streep { display: block; height: 1.15cqh; border-radius: 99px; background: #3A3A3A; flex: none; }
  .lc-streep.is-naam { background: #4E4E4E; }
  .lc-streep.is-klein { height: .9cqh; background: #333; }
  .lc-streep.is-w2 { width: 4cqh; } .lc-streep.is-w3 { width: 6cqh; }
  .lc-streep.is-w4 { width: 8cqh; } .lc-streep.is-w5 { width: 10cqh; }
  .lc-streep.is-w6 { width: 13cqh; } .lc-streep.is-w7 { width: 16cqh; }
  .lc-streep.is-w8 { width: 19cqh; } .lc-streep.is-w9 { width: 22cqh; }
  .lc-post-likes .lc-streep { height: 1.3cqh; }

  .lc-post-voet { flex: none; padding: 1.7cqh 2.2cqh 1.4cqh; border-top: 1px solid #262626; }
  .lc-post-acties { display: flex; gap: 1.6cqh; align-items: center; }
  .lc-post-acties svg { width: 3.6cqh; height: 3.6cqh; fill: none; stroke: #FAFAFA;
                        stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  .lc-post-acties .lc-post-eind { margin-left: auto; }
  .lc-post-likes { margin: 1.4cqh 0 0; font-weight: 600; }
  .lc-post-datum { margin: .5cqh 0 0; font-size: .78em; color: #A8A8A8;
                   text-transform: uppercase; letter-spacing: .02em; }

  .lc-post-invoer { flex: none; display: flex; align-items: center; gap: .9em;
                    padding: 1.6cqh 2.2cqh; border-top: 1px solid #262626; }
  .lc-post-invoer svg { width: 3.2cqh; height: 3.2cqh; flex: none; fill: none;
                        stroke: #FAFAFA; stroke-width: 1.5; }
  .lc-post-plaats { margin-left: auto; color: #4A9BF7; font-weight: 600; }

  /* De plaat ligt erbovenop. `pointer-events: none` zodat de sleepbeweging en
     de knoppen eronder gewoon bereikbaar blijven. */
  .lc-plaat { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; pointer-events: none; }
  /* ── HET WIT OM DE LAPTOP IS UIT DE PLAAT ZELF GEHAALD — 18 sept 2026 ────
     Lucas: *"Zorg wel dat de laptop er mooi in word verwerkt, ook het witte om
     de laptop heen moet het liefst doorzichtig worden."* — en daarna: *"Ik heb
     de laptop placeholder gefixt en de achtergrond weg gehaald."*

     Hier stond een dag lang een blendstand op de plaat. Dat was de oplossing
     zolang de bron een FOTO met een dichte witte studiogrond was: wit
     vermenigvuldigt naar niets, dus het verdween, en de ingebakken slagschaduw
     verdonkerde wat eronder lag.

     Die truc moest weg zodra de bron zelf schoon werd. Vermenigvuldigen raakt
     namelijk niet alleen het wit: het rekent ÁLLES door met wat eronder ligt,
     dus op een sfeerbeeld zouden de zwarte lijst, de hand en de aluminium voet
     meekleuren met de achtergrond in plaats van erop te liggen. Met een
     doorzichtige plaat is dat niet meer nodig en ook niet meer gewenst — hij
     ligt nu gewoon op de pagina, in elke vorm, op elke grond.

     Wat er wél blijft is het masker op `.lc.is-naast .lc-doek` hierboven: dat
     laat de laptop oplossen op de plek waar hij de pagina verlaat. */

  /* ── DE PIJLEN ────────────────────────────────────────────────────────────
     Onder de laptop, naast de voortgangsstreep — zie de noot bij de markup.
     Klein en in inkt: ze staan niet meer op een donkere plaat maar op de
     pagina, en een zwarte pil met waas eromheen zou daar een derde element zijn
     naast de naam en de streep.

     Ze verschijnen bij hover op de hele carousel (de laptop plus deze voet is
     precies "dichtbij de laptop") of zodra er focus in zit. Blijven staan doen
     ze niet: ze zijn de uitzondering, het vanzelf doorlopen is de regel. */
  .lc-pijlen { flex: none; display: flex; gap: .3rem; margin-left: auto; }
  .lc-pijl {
    width: 2rem; height: 2rem; display: grid; place-items: center;
    border: 1px solid currentColor; border-radius: var(--rond-knop, 0);
    background: none; color: inherit;
    opacity: 0; transition: opacity .25s ease, background-color .25s ease, color .25s ease;
    cursor: pointer;
  }
  .lc-pijl svg { width: 1rem; height: 1rem; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: square; }
  .lc-pijl:hover { background: currentColor; }
  .lc-pijl:hover svg { stroke: var(--vel, #FAFAFA); }
  .lc:hover .lc-pijl, .lc:focus-within .lc-pijl { opacity: .7; }
  .lc:hover .lc-pijl:hover { opacity: 1; }
  .lc-pijl:focus-visible { opacity: 1; outline: 2px solid var(--lc-accent); outline-offset: 2px; }
  /* Geen aanwijzer (telefoon, tablet) of een smal scherm: weg ermee. Daar is
     swipen de bediening en een knop alleen maar een ding dat in de weg staat.

     En de schuifbak gaat daar óók uit. Zelf door de galerij scrollen is bedacht
     voor een muis: hoveren pauzeert het afspelen en je scrollt gericht. Op een
     telefoon bestaat hoveren niet en is verticaal vegen hoe je de PAGINA leest
     — dan wordt de laptop een val waar je eerst vier foto's doorheen moet vegen
     voordat de pagina weer meegeeft. Daar blijft het dus bij vanzelf afspelen
     en tikken. */
  @media (hover: none), (max-width: 64rem) {
    .lc-pijl { display: none; }
    .lc-rol { overflow: hidden; }
  }

  /* ── DE VOET: één naam en één streep ──────────────────────────────────────
     Geen bolletjes. Acht bolletjes onder een laptop zijn acht dingen die om
     aandacht vragen voor een keuze die niemand hoeft te maken; een streep die
     opschuift zegt hetzelfde en vraagt niets. */
  /* ── ÉÉN ETIKET, GEEN PIJLENREGEN ─────────────────────────────────────────
     Lucas vroeg of er getekende pijlen bij moesten om laptop en telefoon uit
     elkaar te houden. Dat is hier één etiket geworden, en wel om drie redenen.

     1. De plaat BLOEDT de rechterrand uit. Gemeten loopt de doek op 1440 door
        tot 1561 terwijl het venster op 1440 ophoudt; op 1600 is dat 135 pixels
        en op 1280 nog 107. Alles wat je in die rechtermarge tekent — precies
        waar een pijl naar de telefoon zou moeten staan — is op elke gangbare
        breedte weggesneden. Dit etiket staat daarom ONDER de plaat, waar niets
        wordt afgesneden, uitgelijnd op het midden van het telefoonscherm.
     2. De laptop hoeft geen uitleg: een laptop met een webwinkel erop leest
        zichzelf, zeker onder een kop die "Jij uploadt. Wij leveren de campagne."
        zegt. De enige helft die vragen oproept is de telefoon — is dat nou een
        resultaat of een inzending? Eén regel beantwoordt dat.
     3. Deze sectie is eerder al als te druk beoordeeld. Twee pijlen en twee
        onderschriften erbij zijn vier dingen die om aandacht vragen voor één
        vraag.

     De pijl is een gewoon teken in dezelfde mono als de rest, geen tekening:
     die schaalt mee, is te vertalen en veroudert niet. */
  .lc-voet { position: relative; display: flex; align-items: center; gap: clamp(1rem, 3vw, 2rem);
             padding-right: 38%; }
  .lc-naam { margin: 0; flex: none; }
  .lc-naam a {
    font-family: var(--mono, var(--font-mono)); font-size: .72rem; font-stretch: 82%;
    letter-spacing: .06em; text-transform: uppercase; color: inherit; opacity: .78;
    text-decoration: none; border-bottom: 1px solid currentColor; padding-bottom: .15rem;
  }
  .lc-naam a:hover { opacity: 1; }
  /* De streep stond dubbel: een achtergrond op .lc-balk zélf én een ::before,
     en omdat de opacity er een regel later weer op 1 werd gezet werd die
     achtergrond een volle zwarte lijn. Nu één spoor: het ::before is de
     haarlijn, de span erin is de stand. */
  .lc-balk { position: relative; flex: 1; height: 1px; overflow: hidden; }
  .lc-balk::before { content: ""; position: absolute; inset: 0; background: currentColor; opacity: .2; }
  .lc-balk-in {
    position: absolute; inset-block: 0; left: 0; width: calc(100% / var(--lc-n));
    background: var(--lc-accent); transition: transform .6s cubic-bezier(.16, 1, .3, 1);
  }

  /* Het midden van het telefoonscherm, uitgerekend uit dezelfde twee getallen
     die het gat in de plaat bepalen — geen tweede waarheid die kan gaan
     afwijken als de plaat ooit vervangen wordt. De voet is even breed als de
     doek. Dat laatste is niet vanzelfsprekend: een pagina mag de voet smaller
     maken dan de plaat, zodat de laptop de rand uit loopt maar het bijschrift
     netjes in de kolom blijft. Zet die pagina dan ook `--lc-voet-deel` op het
     aandeel dat ze kiest (0,78 bij een voet van 78%), anders wijst dit etiket
     naast de telefoon. Gemeten zonder die correctie: 150 pixels ernaast. */
  /* Onder de voet en niet erin: de voet is een bedieningsbalk (naam, streep,
     pijlen) en dit is een mededeling. 66ch houdt hem op twee regels op een
     laptop en laat hem op een telefoon gewoon lopen. */
  .lc-uitleg {
    margin: 0; max-width: 66ch;
    font-size: .88rem; line-height: 1.6; color: var(--inkt-3, var(--ink-3, #6E6E6E));
    text-wrap: pretty;
  }

  .lc-bron {
    position: absolute;
    left: calc((var(--lc-fl) + var(--lc-fw) / 2) / var(--lc-voet-deel, 1));
    translate: -50% 0;
    margin: 0; white-space: nowrap;
    font-family: var(--mono, var(--font-mono)); font-size: .72rem; font-stretch: 82%;
    letter-spacing: .06em; text-transform: uppercase; opacity: .62;
  }
  /* Op een smal scherm is er geen ruimte om ergens onder uit te lijnen: dan
     gaat hij gewoon op zijn eigen regel staan. */
  @media (max-width: 48rem) {
    .lc-voet { padding-right: 0; flex-wrap: wrap; }
    .lc-bron { position: static; translate: none; flex-basis: 100%; }
  }

  .lc-melding { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  /* ── RUSTIG VOOR WIE DAAROM VRAAGT ────────────────────────────────────────
     Geen overvloeiing, en het script start niet vanzelf. Slide 1 blijft staan
     en de pijlen blijven werken. */
  @media (prefers-reduced-motion: reduce) {
    .lc-slide, .lc-balk-in, .lc-pijl, .lc-rol { transition: none; }
    .lc-rol { scroll-behavior: auto; }
    .lc-omlaag { animation: none; transition: opacity .25s ease; }
    .lc-omlaag:hover { scale: 1; }
  }
</style>

<script is:inline data-astro-rerun>
  (() => {
    const s = document.querySelector('[data-lc]');
    if (!s || s.dataset.lcAan) return;
    s.dataset.lcAan = '1';

    const dia = [...s.querySelectorAll('[data-lc-slide]')];
    const fons = [...s.querySelectorAll('[data-lc-fon]')];
    const namen = [...s.querySelectorAll('[data-lc-naam]')];
    const balk = s.querySelector('[data-lc-balk]');
    const melding = s.querySelector('[data-lc-melding]');
    const n = dia.length;

    /* Een slide is óf één beeld, óf een stapel beelden onder elkaar. Beide
       tellen mee als stappen, zodat de streep per FOTO opschuift en niet per
       dienst — anders staat hij bij de catalogset tien seconden stil. */
    const rollen = dia.map((e) => e.querySelector('[data-lc-rol]'));
    const stappen = rollen.map((r) => (r ? r.children.length : 1));
    const totaal = stappen.reduce((a, b) => a + b, 0);
    if (totaal < 2) return;
    const plat = (k, m) => stappen.slice(0, k).reduce((a, b) => a + b, 0) + m;

    const stil = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let i = 0, j = 0, klok = null, zicht = false, gestopt = stil;

    const toon = (k, m) => {
      i = (k + n) % n;
      j = Math.max(0, Math.min(m || 0, stappen[i] - 1));
      dia.forEach((e, q) => {
        e.classList.toggle('is-aan', q === i);
        e.setAttribute('aria-hidden', q === i ? 'false' : 'true');
      });
      /* De telefoonbeelden staan per STAP in de HTML, niet per slide: welke
         erbij hoort staat in het element zelf en niet in een telling hier. */
      fons.forEach((e) => e.classList.toggle('is-aan', +e.dataset.lcSi === i && +e.dataset.lcBi === j));
      /* Elke rol krijgt zijn stand mee. De rollen die niet in beeld staan gaan
         terug naar boven; de CSS zet hun overgang dan uit, dus dat gebeurt
         zonder zichtbaar terugschuiven. */
      /* Een social-carousel schuift opzij met `translate`; een productgalerij
         is een echte schuifbak, zodat de bezoeker er met zijn muis zélf in kan.
         De richting staat in de HTML en niet in het script. */
      rollen.forEach((r, q) => {
        if (!r) return;
        const m = q === i ? j : 0;
        if (r.hasAttribute('data-lc-zij')) { r.style.translate = -m * 100 + '% 0'; return; }
        const hg = r.firstElementChild ? r.firstElementChild.offsetHeight : 0;
        r.scrollTo({ top: m * hg, behavior: q === i && !stil ? 'smooth' : 'auto' });
        const blad = r.parentElement;
        if (blad) blad.classList.toggle('is-eind', q === i && j === stappen[q] - 1);
      });
      dia.forEach((e, q) => {
        const st = e.querySelector('[data-lc-stip]');
        if (st) [...st.children].forEach((b, m) => b.classList.toggle('aan', q === i && m === j));
      });
      /* Alleen de zichtbare clip speelt. Vijf clips die allemaal tegelijk in
         een lus staan te draaien is vijf keer werk voor niets, en op een
         telefoon is dat meteen te merken. */
      dia.forEach((e, q) => {
        /* ALLE clips van deze slide en niet de eerste: sinds de speler een
           onscherpe grondlaag heeft (zie .lc-speler) staan er twee <video>'s in
           dezelfde slide, en `querySelector` zou de voorste laten doordraaien
           terwijl de achterste stilstaat — twee lagen van hetzelfde beeld die
           uit de pas lopen. */
        e.querySelectorAll('video').forEach((v) => {
          if (q === i) { v.currentTime = 0; v.play().catch(() => {}); } else { v.pause(); }
        });
      });
      /* De pijl terug in een nagebouwde post: alleen als er iets achter je
         ligt. Zie de noot bij de knop in de markup. */
      dia.forEach((e, q) => {
        const terug = e.querySelector('[data-lc-terug]');
        if (terug) terug.hidden = !(q === i && j > 0);
      });
      namen.forEach((e, q) => { e.hidden = q !== i; });
      balk.style.transform = 'translateX(' + plat(i, j) * 100 + '%)';
      melding.textContent = melding.textContent.replace(/\d+/, String(plat(i, j) + 1));
    };

    /* Eén stap is één FOTO. Binnen een stapel schuift de rol op; is die op,
       dan pas gaat hij naar de volgende dienst. Terug gaat altijd naar het
       begin van de vorige stapel: halverwege een galerij binnenvallen is
       verwarrender dan bovenaan beginnen. */
    const volgende = () => { if (j < stappen[i] - 1) toon(i, j + 1); else toon(i + 1, 0); };
    const vorige = () => { if (j > 0) toon(i, j - 1); else toon(i - 1, 0); };

    /* ── HETZELFDE, MAAR ZONDER RONDJE ────────────────────────────────────
       De knoppen mogen ronddraaien: wie op het pijltje drukt wil blijven
       kijken. Het MUISWIEL mag dat niet, want dan kom je er nooit meer uit —
       de pagina zou onder je cursor eeuwig in de hero blijven hangen. Deze
       twee lopen dus tot het einde en geven daarna `false` terug, en dát is
       het sein om het wiel weer aan de pagina te geven. */
    const wielVooruit = () => {
      if (j < stappen[i] - 1) { toon(i, j + 1); return true; }
      if (i < n - 1) { toon(i + 1, 0); return true; }
      return false;
    };
    const wielTerug = () => {
      if (j > 0) { toon(i, j - 1); return true; }
      if (i > 0) { toon(i - 1, stappen[i - 1] - 1); return true; }
      return false;
    };

    /* Wie met de muis in de galerij scrolt, bepaalt zelf waar hij is. Dat mag:
       hoveren pauzeert het afspelen toch al. Alleen de streep en de melding
       moeten meelopen, anders klopt de stand niet meer zodra het afspelen na
       het weghalen van de muis weer aanslaat. Geen `stop()` dus — scrollen is
       kijken, geen ingreep. */
    rollen.forEach((r, q) => {
      if (!r || r.hasAttribute('data-lc-zij')) return;
      let wacht = null;
      r.addEventListener('scroll', () => {
        clearTimeout(wacht);
        wacht = setTimeout(() => {
          if (q !== i) return;
          const hg = r.firstElementChild ? r.firstElementChild.offsetHeight : 0;
          if (!hg) return;
          const m = Math.max(0, Math.min(Math.round(r.scrollTop / hg), stappen[q] - 1));
          if (m === j) return;
          j = m;
          const blad = r.parentElement;
          if (blad) blad.classList.toggle('is-eind', j === stappen[q] - 1);
          balk.style.transform = 'translateX(' + plat(i, j) * 100 + '%)';
          melding.textContent = melding.textContent.replace(/\d+/, String(plat(i, j) + 1));
        }, 130);
      }, { passive: true });
    });

    /* setTimeout en geen setInterval: elke slide mag zijn eigen duur hebben, en
       een clip van zeven seconden hoort niet na tweeënhalf weg te springen. De
       volgende wachttijd wordt dus per slide opnieuw bepaald. */
    const duurVan = (k) => Number(dia[k].dataset.lcDuur) || 2500;
    const pauze = () => { clearTimeout(klok); klok = null; };
    const start = () => {
      if (gestopt || !zicht || klok) return;
      /* Staat de muis er nog op, of staat de focus erin? Dan niet. `:hover` in
         plaats van een eigen vlag, zodat hij ook klopt na een klik op een pijl:
         die pijl zit binnen de carousel, dus de aanwijzer is er nog. */
      if (s.matches(':hover') || s.contains(document.activeElement)) return;
      klok = setTimeout(() => { klok = null; volgende(); start(); }, duurVan(i));
    };
    /* ── INGRIJPEN PAUZEERT, WEGGAAN START WEER — 18 september 2026 ─────────
       Hier stond: één keer ingrijpen en het afspelen komt niet meer terug.
       Lucas: *"Ook als je van de laptop of pijlen afgaat met je muis moeten de
       foto's automatisch afspelen en verder gaan naar de volgende diaslide."*

       Zijn versie is beter, en de reden dat de oude regel bestond blijft
       overeind: het gaat erom dat er niets wegspringt terwijl je KIJKT. Zolang
       de muis op de laptop of de pijlen staat, staat hij dus stil — hoe lang je
       ook blijft. Ga je weg, dan loopt hij weer.

       `gestopt` blijft bestaan voor de enige twee gevallen waarin doorlopen
       echt niet hoort: een bezoeker die om minder beweging heeft gevraagd, en
       iemand die met het TOETSENBORD in de carousel staat — die ziet zijn
       focus anders onder zich vandaan schuiven. */
    const pauzeer = () => pauze();
    const stop = () => { pauze(); };

    s.addEventListener('click', (e) => {
      const k = e.target.closest('[data-lc-stap]');
      if (!k) return;
      stop(); Number(k.dataset.lcStap) > 0 ? volgende() : vorige();
    });
    s.addEventListener('keydown', (e) => {
      const vooruit = e.key === 'ArrowRight' || e.key === 'ArrowDown';
      const terug = e.key === 'ArrowLeft' || e.key === 'ArrowUp';
      if (!vooruit && !terug) return;
      e.preventDefault(); stop(); vooruit ? volgende() : vorige();
    });

    let x0 = null;
    s.addEventListener('pointerdown', (e) => { x0 = e.clientX; });
    s.addEventListener('pointerup', (e) => {
      if (x0 === null) return;
      const d = e.clientX - x0; x0 = null;
      if (Math.abs(d) < 40) return;
      stop(); d < 0 ? volgende() : vorige();
    });
    s.addEventListener('pointercancel', () => { x0 = null; });

    /* ── HET MUISWIEL LOOPT DOOR DE HELE REEKS ────────────────────────────
       Lucas: *"als je op de laatste foto van catalog zit en je hard door
       scrollt dat je dan ook naar de volgende dia slide gaat ... en bij de
       laatste weer hard doorscrollen en je gaat naar de volgende dia slide."*

       Drie soorten slides, drie afspraken:

       · Een PRODUCTGALERIJ scrollt zichzelf — dat is een echte schuifbak en
         daar hoort het script vanaf te blijven. Alleen aan de uiteinden nemen
         we het over, want daar zou de pagina anders wegglijden.
       · Een SOCIAL-CAROUSEL schuift opzij en heeft dus geen eigen scrol. Daar
         vertaalt het wiel meteen naar de volgende foto.
       · Een LOSSE SLIDE heeft niets om doorheen te lopen en geeft het wiel
         meteen door.

       De drempel is er met opzet: zonder die 200 pixels springt de reeks al
       verder bij het minste trackpadtrilletje, en dan is de laptop een val.
       Met de drempel is het een bewuste duw — "hard doorscrollen". De teller
       loopt leeg na 350 ms stilte, zodat twee losse duwtjes niet stiekem bij
       elkaar worden opgeteld.

       En op de laatste slide grijpen we NIET in: daar geeft het wiel gewoon de
       pagina weer terug. Zonder die uitgang kom je er met de muis nooit meer
       onderuit. Op aanraakschermen staat het hele ding uit; daar is verticaal
       vegen hoe je de pagina leest. */
    const muis = matchMedia('(hover: hover) and (min-width: 64rem)');
    /* TWEE drempels, en dat is de hele bediening in één regel: binnen een
       galerij is één muiswiel genoeg, eruit springen kost er twee. Zo loop je
       vanzelf door de foto's en moet je bewust duwen om de dienst te wisselen.

       Waarom het wiel óók binnen de galerij wordt overgenomen, terwijl dat een
       echte schuifbak is: met `scroll-snap: mandatory` haalt één muiswiel van
       100 pixels de helft van een vak van 352 niet, en snapt de browser netjes
       terug naar waar je vandaan kwam. Gemeten: zestien losse wielen achter
       elkaar en er gebeurde niets. Nu telt het script de duwen op en zet het
       de schuifbak zelf naar het volgende vak. */
    const BINNEN = 50, ERUIT = 240;
    let pot = 0, potKlok = null;
    s.addEventListener('wheel', (e) => {
      if (!muis.matches || e.ctrlKey || Math.abs(e.deltaY) <= Math.abs(e.deltaX)) return;
      const omlaag = e.deltaY > 0;
      const kan = omlaag ? (j < stappen[i] - 1 || i < n - 1) : (j > 0 || i > 0);
      /* Op de laatste slide grijpen we NIET in: daar geeft het wiel de pagina
         weer terug. Zonder die uitgang kom je er met de muis nooit meer
         onderuit. Op aanraakschermen staat het hele ding uit; daar is
         verticaal vegen hoe je de pagina leest. */
      if (!kan) { pot = 0; return; }
      e.preventDefault();
      if ((pot > 0) !== omlaag) pot = 0;   /* van richting gewisseld: opnieuw tellen */
      pot += e.deltaY;
      clearTimeout(potKlok);
      potKlok = setTimeout(() => { pot = 0; }, 500);
      const eigen = omlaag ? j < stappen[i] - 1 : j > 0;
      if (Math.abs(pot) < (eigen ? BINNEN : ERUIT)) return;
      pot = 0;
      (omlaag ? wielVooruit : wielTerug)();
    }, { passive: false });

    s.addEventListener('mouseenter', pauzeer);
    s.addEventListener('mouseleave', start);
    /* Met het toetsenbord erin: stil. Eruit: weer verder. Zelfde afspraak als
       met de muis, zodat er maar één regel te onthouden is. */
    s.addEventListener('focusin', pauzeer);
    s.addEventListener('focusout', () => setTimeout(start, 0));
    /* Buiten beeld ook de clip stilzetten: een lus die doordraait in een tab
       waar niemand kijkt, kost accu en levert niets op. */
    const clipsUit = () => dia.forEach((e) => e.querySelectorAll('video').forEach((v) => v.pause()));

    new IntersectionObserver((rs) => {
      zicht = rs[0].isIntersecting;
      if (zicht) { start(); toon(i, j); } else { pauze(); clipsUit(); }
    }, { threshold: .35 }).observe(s);
  })();
</script>
