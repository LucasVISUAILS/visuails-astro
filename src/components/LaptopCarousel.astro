      </button>
      <button class="lc-pijl lc-pijl-volgende" type="button" data-lc-stap="1" aria-label={t.volgende}>
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m9 5 7 7-7 7" /></svg>
      </button>
