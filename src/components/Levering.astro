---
/*
 * VISUAILS — ÉÉN LEVERING, VAN BEGIN TOT EIND. 23 september 2026.
 * ═══════════════════════════════════════════════════════════════════════════
 *
 * Lucas: *"Ik wil dat 'zo ziet een levering eruit' de standaard galerij look is
 * (…) Maak dit echt overzichtelijk en mooi uitziend met een mooie mock-up van een
 * order flow, want klanten gaan deze pagina gegarandeerd goed bestuderen en hier
 * hun mening op vormen."*
 *
 * Een galerij met losse beelden beantwoordt "kunnen jullie mooie foto's maken?".
 * Wie hier komt, vraagt iets anders: "wat krijg ík, als ik mijn foto's stuur?"
 * Dit blok beantwoordt die vraag met één echte bestelling, in de vorm van het
 * scherm waarin de klant hem zelf zou zien: VISUAILS Studio.
 *
 * DRIE STAPPEN, NIET VIER. Binnengekomen → gemaakt en nagekeken → gedownload.
 * Goedkeuren is geen aparte stap met dezelfde vier beelden nog een keer; het is
 * een vinkje op de beelden van stap twee. Hetzelfde beeld twee keer tonen is de
 * pagina langer maken zonder dat hij meer zegt.
 *
 * ALLES KOMT UIT DE BRON, NIETS IS NAGETEKEND:
 *   · de foto's uit src/data/voorbeeldset.js (dezelfde set als de voorpagina)
 *   · de mappen en bestandsnamen uit deliveryEntries() en deliveryDocs() in
 *     src/lib/delivery.js — precies de functies die de echte zip bouwen. Hernoemt
 *     iemand daar een map, dan verandert hij hier mee.
 *   · de maat (2048 px) uit RESOLUTIE in pricing.js
 *
 * EERLIJK OVER WAT VERZONNEN IS: de set is echt, het bestelnummer
 * (VOORBEELD_REF) en de productnaam zijn voorbeelden. Dat staat onder het blok.
 */
import { ingestuurd, geleverd, vormen, VOORBEELD_REF } from '../data/voorbeeldset.js';
import { deliveryEntries, deliveryDocs } from '../lib/delivery.js';
import { RESOLUTIE } from '../data/pricing.js';
import { DIENSTEN } from '../data/leveringen.js';

/* Sinds 23 september 2026 één van meerdere leveringen in de galerij (zie
   src/data/leveringen.js): de bestelling, het product en de dienst komen mee
   als props. Zonder props is het de wijde jeans, zoals voorheen. `plaatshouder`
   zet de noot onderaan om: dan zijn het de beelden van de voorbeeldset en niet
   van dit product, en dat staat er dan ook. */
interface Props {
  lang: 'en' | 'nl';
  nummer?: string;
  product?: string;
  dienst?: 'catalog' | 'lifestyle' | 'complete';
  plaatshouder?: boolean;
  id?: string;
}
const { lang, nummer: bestelRef = VOORBEELD_REF, product, dienst = 'catalog', plaatshouder = false, id = 'lv' } = Astro.props;
const nl = lang === 'nl';

const IN = ingestuurd(lang);
const UIT = geleverd(lang);
const VORMEN = vormen(lang);
const PRODUCT = product || (nl ? 'Wijde jeans' : 'Wide leg jeans');
const DIENST = DIENSTEN[dienst]?.meta?.[nl ? 'nl' : 'en'] || (nl ? 'Catalogset' : 'Catalog set');

/* De map, gebouwd door dezelfde twee functies als de echte zip. Vier beelden,
   elk in drie formaten — de rijen hieronder zijn wat deliveryEntries() daarvan
   maakt, niet wat ik denk dat hij maakt. */
const SHOTS = ['front', 'back', 'detail', 'worn'];
const nepBestanden = SHOTS.map((shot, i) => ({
  id: i + 1, product_key: 'p1', shot, r2_key: `x/${i}`, bytes: 0, filename: `${shot}.png`,
  assets: ['png', 'jpg', 'webp'].map((format) => ({ format, r2_key: `x/${i}.${format}`, bytes: 0 })),
}));
const entries = deliveryEntries(nepBestanden, lang, { ref: bestelRef, productNames: { p1: PRODUCT } });
const docs = deliveryDocs({ order: { ref: bestelRef, lang, brand: PRODUCT }, entries, taal: lang });
const wortel = entries[0]?.name.split('/')[0] || `VISUAILS-${bestelRef}`;
const productMap = entries[0]?.name.split('/')[1] || `01 - ${PRODUCT}`;
const perFormaat: Record<string, string[]> = {};
for (const e of entries) {
  const delen = e.name.split('/');
  (perFormaat[delen[2]] ||= []).push(delen[3]);
}
const formaten = Object.keys(perFormaat);
const bestanden = entries.length;
const px = RESOLUTIE.standaard;

const c = nl ? {
  venster: 'VISUAILS Studio',
  bestelling: `Bestelling ${bestelRef}`,
  status: 'Geleverd',
  meta: [
    ['Product', PRODUCT],
    ['Dienst', DIENST],
    ['Beelden', `${UIT.length}`],
    ['Maat', `${px} px`],
  ],
  stappen: [
    { nr: '01', kop: 'Binnengekomen', zin: `${IN.length} telefoonfoto’s op de magazijnvloer. Geen statief, geen studio, geen lichtset.` },
    { nr: '02', kop: 'Gemaakt en nagekeken', zin: 'Een specialist legt elk beeld naast je foto voordat het in Studio staat. Jij keurt per beeld goed, of vraagt met één klik een revisie.' },
    { nr: '03', kop: 'Gedownload', zin: `Eén map met ${bestanden} bestanden: elk beeld in ${formaten.length} formaten. Staand of verticaal erbij, voor je advertenties en reels, kies je bij het bestellen.` },
  ],
  labels: ['Voorkant', 'Achterkant', 'Detail', 'Op model'],
  ok: 'Goedgekeurd',
  revisie: 'Revisie aanvragen',
  goedkeuren: 'Goedkeuren',
  bestandenN: (n: number) => `${n} bestanden`,
  noot: plaatshouder
    ? `Beelden volgen. Tot die er zijn, staat hier de voorbeeldset (een wijde jeans) en niet de ${PRODUCT.toLowerCase()}. Het bestelnummer is een voorbeeld.`
    : 'Een echte set. Het bestelnummer en de productnaam zijn voorbeelden.',
  map: 'In de map',
} : {
  venster: 'VISUAILS Studio',
  bestelling: `Order ${bestelRef}`,
  status: 'Delivered',
  meta: [
    ['Product', PRODUCT],
    ['Service', DIENST],
    ['Images', `${UIT.length}`],
    ['Size', `${px} px`],
  ],
  stappen: [
    { nr: '01', kop: 'Came in', zin: `${IN.length} phone photos on a warehouse floor. No tripod, no studio, no lights.` },
    { nr: '02', kop: 'Made and checked', zin: 'A specialist puts every image next to your photo before it appears in Studio. You approve per image, or ask for a revision in one click.' },
    { nr: '03', kop: 'Downloaded', zin: `One folder with ${bestanden} files: every image in ${formaten.length} formats. Upright or vertical as well, for your ads and reels, is a choice you make when you order.` },
  ],
  labels: ['Front', 'Back', 'Detail', 'On model'],
  ok: 'Approved',
  revisie: 'Request a revision',
  goedkeuren: 'Approve',
  bestandenN: (n: number) => `${n} files`,
  noot: plaatshouder
    ? `Images to follow. Until they are here, this shows the sample set (wide leg jeans), not the ${PRODUCT.toLowerCase()}. The order number is an example.`
    : 'A real set. The order number and the product name are examples.',
  map: 'In the folder',
};
---

<article class="lv" aria-labelledby={`${id}-kop`}>
  {/* De balk van het venster. Tekst en geen logo: het is een tekening van
      Studio, en het woordmerk hoort in de kop van de site. */}
  <header class="lv-balk">
    <p class="lv-venster"><b>{c.venster}</b></p>
    <p class="lv-status"><span aria-hidden="true">✓</span> {c.status}</p>
    <h2 id={`${id}-kop`} class="lv-bestelling mono">{c.bestelling}</h2>
  </header>

  <dl class="lv-meta">
    {c.meta.map(([k, v]) => <div><dt class="mono">{k}</dt><dd>{v}</dd></div>)}
  </dl>

  <ol class="lv-stappen" role="list">
    {/* ── 01 · BINNENGEKOMEN ─────────────────────────────────────────────── */}
    <li class="lv-stap">
      <div class="lv-uitleg">
        <p class="mono lv-nr">{c.stappen[0].nr}</p>
        <h3 class="lv-woord">{c.stappen[0].kop}</h3>
        <p class="lv-zin">{c.stappen[0].zin}</p>
      </div>
      <ul class="lv-in" role="list">
        {IN.map((b) => (
          <li><img src={b.src} width={b.w} height={b.h} alt={b.alt} loading="lazy" decoding="async" /></li>
        ))}
      </ul>
    </li>

    {/* ── 02 · GEMAAKT EN NAGEKEKEN ──────────────────────────────────────── */}
    <li class="lv-stap">
      <div class="lv-uitleg">
        <p class="mono lv-nr">{c.stappen[1].nr}</p>
        <h3 class="lv-woord">{c.stappen[1].kop}</h3>
        <p class="lv-zin">{c.stappen[1].zin}</p>
        {/* De twee knoppen zoals ze in Studio staan, van gelijk gewicht. <span>
            en geen <button>: er valt hier niets te doen. */}
        <p class="lv-knoppen" aria-hidden="true">
          <span class="lv-knop is-ja">{c.goedkeuren}</span>
          <span class="lv-knop">{c.revisie}</span>
        </p>
      </div>
      <ul class="lv-uit" role="list">
        {UIT.map((b, i) => (
          <li>
            <figure>
              <img src={b.src} width={b.w} height={b.h} alt={b.alt} loading="lazy" decoding="async" />
              <figcaption>
                <span>{c.labels[i]}</span>
                <span class="lv-vink"><span aria-hidden="true">✓</span> {c.ok}</span>
              </figcaption>
            </figure>
          </li>
        ))}
      </ul>
    </li>

    {/* ── 03 · GEDOWNLOAD ────────────────────────────────────────────────── */}
    <li class="lv-stap">
      <div class="lv-uitleg">
        <p class="mono lv-nr">{c.stappen[2].nr}</p>
        <h3 class="lv-woord">{c.stappen[2].kop}</h3>
        <p class="lv-zin">{c.stappen[2].zin}</p>
      </div>
      <div class="lv-uitkomst">
        <ul class="lv-vormen" role="list">
          {VORMEN.map((v) => (
            <li>
              <span class="lv-vorm" style={`--lv-ratio:${v.ratio}`}>
                <img src={v.src} width="760" height="760" alt={v.alt} loading="lazy" decoding="async" />
              </span>
              <span class="mono lv-vorm-maat">{v.maat} · {v.waar}</span>
            </li>
          ))}
        </ul>
        {/* De map zoals hij uitpakt. De regels zijn wat deliveryEntries() en
            deliveryDocs() voor deze bestelling opleveren. */}
        <div class="lv-map" role="group" aria-label={c.map}>
          <p class="mono lv-map-kop">{c.map}</p>
          <ul class="lv-boom mono" role="list">
            <li class="is-map">{wortel}/</li>
            {docs.map((d) => <li class="d1">{d.name.split('/').pop()}</li>)}
            <li class="d1 is-map">{productMap}/</li>
            {formaten.map((f, i) => (
              i === 0
                ? <>
                    <li class="d2 is-map">{f}/</li>
                    {perFormaat[f].map((n) => <li class="d3">{n}</li>)}
                  </>
                : <li class="d2 is-map">{f}/ <span class="lv-telling">{c.bestandenN(perFormaat[f].length)}</span></li>
            ))}
          </ul>
        </div>
      </div>
    </li>
  </ol>

  <p class="mono lv-noot">{c.noot}</p>
</article>

<style>
  /* ── HET VENSTER ────────────────────────────────────────────────────────
     Een licht vlak in de donkere kamer: zo ziet Studio er ook uit, en het
     contrast zegt "dit is een scherm" zonder een laptopframe erom te tekenen. */
  .lv {
    background: var(--vel); color: var(--inkt);
    border-radius: calc(var(--ronding, 20px) - 6px);
    overflow: hidden;
  }
  .lv-balk {
    display: grid; grid-template-columns: 1fr auto 1fr; grid-template-areas: "venster bestelling status"; align-items: center; gap: 1rem;
    padding: .85rem clamp(1rem, 2.4vw, 1.6rem);
    border-bottom: 1px solid var(--lijn);
  }
  .lv-venster { grid-area: venster; margin: 0; font-size: .9rem; }
  .lv-venster b { font-weight: 600; letter-spacing: .01em; }
  .lv-bestelling { grid-area: bestelling; margin: 0; font-size: .78rem; font-weight: 400; letter-spacing: .06em; text-transform: uppercase; color: var(--inkt-2); }
  .lv-status {
    grid-area: status; margin: 0; justify-self: end; font-family: var(--mono2); font-size: .72rem; font-stretch: 82%;
    letter-spacing: .06em; text-transform: uppercase;
    padding: .35rem .75rem; border: 1px solid var(--lijn-sterk); border-radius: 999px;
  }

  .lv-meta {
    margin: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr));
    border-bottom: 1px solid var(--lijn);
  }
  .lv-meta > div { padding: .9rem clamp(1rem, 2.4vw, 1.6rem); border-left: 1px solid var(--lijn); }
  .lv-meta > div:first-child { border-left: 0; }
  .lv-meta dt { margin: 0 0 .25rem; font-size: .72rem; color: var(--inkt-2); letter-spacing: .06em; text-transform: uppercase; }
  .lv-meta dd { margin: 0; font-size: .98rem; }

  /* ── DE STAPPEN ─────────────────────────────────────────────────────────
     Links de uitleg, rechts wat er gebeurde. Dezelfde kolom voor alle drie,
     zodat je van boven naar beneden één lijn leest. */
  .lv-stappen { list-style: none; margin: 0; padding: 0; }
  .lv-stap {
    display: grid; grid-template-columns: minmax(0, 17rem) minmax(0, 1fr);
    gap: clamp(1.25rem, 3.5vw, 3.5rem);
    padding: clamp(1.5rem, 3.2vw, 2.6rem) clamp(1rem, 2.4vw, 1.6rem);
    border-bottom: 1px solid var(--lijn);
  }
  .lv-uitleg { display: grid; align-content: start; gap: .5rem; }
  .lv-nr { margin: 0; font-size: .72rem; letter-spacing: .08em; color: var(--inkt-2); }
  .lv-woord {
    margin: 0; font-family: var(--kop2); font-weight: 500; font-stretch: 125%; text-transform: uppercase;
    font-size: clamp(1.2rem, 1.9vw, 1.6rem); line-height: 1.05; letter-spacing: -.01em;
  }
  .lv-zin { margin: 0; font-size: .95rem; line-height: 1.55; color: var(--inkt-2); max-width: 32ch; text-wrap: pretty; }

  .lv-in, .lv-uit, .lv-vormen { list-style: none; margin: 0; padding: 0; }
  .lv img { display: block; width: 100%; height: 100%; object-fit: cover; border-radius: 6px; background: var(--lijn); }

  .lv-in { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: .6rem; align-self: start; }
  .lv-in img { aspect-ratio: 3 / 4; }

  .lv-uit { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: .8rem; align-self: start; }
  .lv-uit figure { margin: 0; display: grid; gap: .5rem; }
  .lv-uit img { aspect-ratio: 1 / 1; border: 1px solid var(--lijn); }
  .lv-uit figcaption { display: flex; justify-content: space-between; gap: .4rem; flex-wrap: wrap; font-size: .8rem; }
  .lv-vink { font-family: var(--mono2); font-size: .72rem; font-stretch: 82%; letter-spacing: .04em; text-transform: uppercase; color: var(--inkt-2); }

  .lv-knoppen { display: flex; flex-wrap: wrap; gap: .45rem; margin: .5rem 0 0; }
  .lv-knop {
    font-family: var(--mono2); font-size: .72rem; font-stretch: 82%; letter-spacing: .05em; text-transform: uppercase;
    padding: .5rem .85rem; border: 1px solid var(--lijn-sterk); border-radius: 999px;
  }
  /* Violet, want het IS de actie in Studio — het enige violet in dit venster. */
  .lv-knop.is-ja { background: var(--geel); color: var(--op-geel); border-color: var(--geel); }

  .lv-uitkomst { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: clamp(1rem, 2.5vw, 2rem); align-items: start; }
  .lv-vormen { display: grid; grid-template-columns: 1fr .8fr .5625fr; gap: .8rem; align-items: end; }
  .lv-vormen li { display: grid; gap: .45rem; }
  .lv-vorm { display: block; aspect-ratio: var(--lv-ratio); overflow: hidden; border-radius: 6px; }
  .lv-vorm-maat { font-size: .72rem; letter-spacing: .04em; color: var(--inkt-2); }

  .lv-map { border: 1px solid var(--lijn); border-radius: 10px; padding: .9rem 1rem; background: color-mix(in srgb, var(--vel) 60%, #fff); }
  .lv-map-kop { margin: 0 0 .6rem; font-size: .72rem; letter-spacing: .08em; text-transform: uppercase; color: var(--inkt-2); }
  .lv-boom { list-style: none; margin: 0; padding: 0; text-transform: none; letter-spacing: 0; font-size: .78rem; line-height: 1.75; overflow-x: auto; white-space: nowrap; }
  .lv-boom li { position: relative; }
  .lv-boom .d1 { padding-left: 1.1rem; }
  .lv-boom .d2 { padding-left: 2.2rem; }
  .lv-boom .d3 { padding-left: 3.3rem; color: var(--inkt-2); }
  .lv-boom .is-map { font-weight: 500; }
  .lv-telling { color: var(--inkt-2); font-weight: 400; }

  .lv-noot { margin: 0; padding: .9rem clamp(1rem, 2.4vw, 1.6rem); font-size: .72rem; letter-spacing: .04em; color: var(--inkt-2); }

  @media (max-width: 1100px) {
    .lv-uitkomst { grid-template-columns: minmax(0, 1fr); }
    /* Smallere tegels: naam en vinkje onder elkaar, dan breekt geen van beide
       halverwege af. */
    .lv-uit figcaption { flex-direction: column; gap: .15rem; }
  }
  @media (max-width: 860px) {
    .lv-stap { grid-template-columns: minmax(0, 1fr); }
    .lv-zin { max-width: 46ch; }
    .lv-meta { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .lv-meta > div:nth-child(3) { border-left: 0; }
    .lv-meta > div:nth-child(n+3) { border-top: 1px solid var(--lijn); }
  }
  @media (max-width: 560px) {
    .lv-balk { grid-template-columns: 1fr auto; grid-template-areas: "venster status" "bestelling bestelling"; row-gap: .5rem; }
    .lv-in { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .lv-uit { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
