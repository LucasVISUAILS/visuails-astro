    maatKaartRegel: `${CUSTOM_CREDITS_MIN} to ${CUSTOM_CREDITS_MAX} credits, exactly what you need.`,
    maatKaartVanaf: 'from',
    maatKaartCta: 'Build your own',
    samen: [
      'Fixed production days every month',
      `Unused credits roll over ${PLAN_ROLLOVER_MONTHS} month`,
      'Cancel any month',
    ],

    maatH: 'Build your own plan.',
    maatLede: 'Fill in how many credits you want each month, and see what you get for it.',
    maatLabel: 'Credits per month',
    maatMin: 'Fewer',
    maatMeer: 'More',
    maatFitH: 'That is enough for',
    maatFitOf: 'or',
    maatHelpH: 'Not sure? Count what you need',
    maatHelpLede: 'Add what you want each month; we add up the credits.',
    maatHelpTotaal: 'Your month',
    maatHelpZet: 'Use this number',
    maatSumPrijs: 'per month',
    maatSumPer: 'per credit',
    maatSumBesp: 'You save',
    maatSumBespVs: 'vs the same credits as catalog sets, ordered one-off',
    maatSumPreset: 'Or the',
    maatSumPresetPlan: 'plan',
    presetSep: ' ',
    maatSumCta: 'Continue with this plan',
    maatSumNoot: 'Always monthly. Cancel any month.',
    maatTeVeel: `More than ${CUSTOM_CREDITS_MAX} credits a month? Let us plan it with you.`,
    maatTeWeinig: `The minimum is ${CUSTOM_CREDITS_MIN} credits; what you do not use rolls over.`,
    maatContact: 'Get in touch',
    maatMelding: `Fill in ${CUSTOM_CREDITS_MIN} to ${CUSTOM_CREDITS_MAX} credits — that is what the price is based on.`,

    waaromH: 'Why a plan.',
    waarom: [
      [`${pctMin}–${pctMax}%`, 'cheaper', 'than the same catalog sets ordered one-off.'],
      [`${PLAN_SERVICES.length}`, 'services, one balance', 'Catalog, lifestyle, motion, hooks and lifestyle clips — you choose each month. A look of your own too, once it is built.'],
      ['Fixed', 'production days', 'Every month, ahead of one-off orders — even for one product.'],
      [`${TERMS.yearly.rollover}`, `months rollover`, `On the 12-month term; ${PLAN_ROLLOVER_MONTHS} on monthly. Nothing is lost in a quiet month.`],
    ],

    termH: 'Monthly, yearly or prepaid.',
    termen: [
      ['Monthly', 'Cancel any month.', `Unused credits roll over ${PLAN_ROLLOVER_MONTHS} month.`],
      ['12 months', 'Same price, fixed term.', `${TERMS.yearly.rollover} months rollover, a price lock, and on Studio your own Brand Model.`],
      ['12 months prepaid', `Pay 10, get 12: ${vrijMaanden} months free.`, 'Paid in one go. No refund if you stop early; the rest becomes credit.'],
    ],

    soonAllH: 'And what is on the way.',
    soonAllLede: 'What is on request, and what is not orderable yet.',
    hooksTag: 'On request',
    hooksPlan: `With a plan, a hook costs ${SERVICE_CREDITS.hooks} credits.`,
    stockNow: [`${STOCK_OFF_BRAND} new ${noun('stock', 'en')} every month`, 'with every plan, usable by any brand.'],
    stockSoon: [`${STOCK_ON_BRAND} on-brand ${noun('visual', 'en')} a month`, 'in your own style, with Editions.'],
    stockNowTag: 'Not running yet',
    soonFoot: 'Pricing and ordering details are still being finalized, which is why booking is currently inactive.',
    soonTag: 'Not ready yet',

    ctaH: 'Start with one product',
    ctaEm: `for ${euro(AMOUNT.testSample, 'en')}.`,
    ctaBody: 'See what comes back before any plan starts.',
    ctaSample: TEST_SAMPLE.en.cta,
    ctaPlan: 'Start a plan',
    outH: 'Not every month?',
    outCta: 'See the price per product',
  },
  nl: {
    eyebrow: 'Abonnementen',
    h1a: 'Elke maand credits.',
    h1b: 'Besteed ze aan wat je nodig hebt.',
    lead: `Eén maandbudget voor catalog, lifestyle en video — ${pctMin}–${pctMax}% goedkoper dan los bestellen.`,
    ctaPlans: 'Kies een abonnement',
    ctaMaat: 'Stel je eigen samen',
    menuH: 'Wat een credit oplevert',
    menuCredits: 'credits',

    plansH: 'Drie abonnementen. Of je eigen aantal.',
    perMaand: 'per maand',
    perCredit: 'per credit',
    credits: 'credits',
    of: 'of',
    catSets: 'catalogsets',
    carousels: 'carousels',
    hooks: 'hooks',
    bespaar: (s, n, los) => `Je bespaart ${s} per maand — ${n} catalogsets los kosten ${los}.`,
    merkmodel: 'Je eigen merkmodel inbegrepen',
    jaar: (p) => `of ${p} op de jaartermijn`,
    kiesPlan: (n) => `Kies ${n}`,
    maatKaartNaam: planName(CUSTOM_MONTH_ID, 'nl'),
    maatKaartRegel: `${CUSTOM_CREDITS_MIN} tot ${CUSTOM_CREDITS_MAX} credits, precies wat je nodig hebt.`,
    maatKaartVanaf: 'vanaf',
    maatKaartCta: 'Stel je eigen samen',
    samen: [
      'Elke maand vaste productiedagen',
      `Ongebruikte credits schuiven ${PLAN_ROLLOVER_MONTHS} maand door`,
      'Maandelijks opzegbaar',
    ],

    maatH: 'Stel je eigen abonnement samen.',
    maatLede: 'Vul in hoeveel credits je per maand wilt, en zie meteen wat je ervoor krijgt.',
    maatLabel: 'Credits per maand',
    maatMin: 'Minder',
    maatMeer: 'Meer',
    maatFitH: 'Daar krijg je bijvoorbeeld',
    maatFitOf: 'of',
    maatHelpH: 'Weet je het niet precies? Tel wat je nodig hebt',
    maatHelpLede: 'Zet erin wat je elke maand wilt; wij tellen de credits op.',
    maatHelpTotaal: 'Jouw maand',
    maatHelpZet: 'Gebruik dit aantal',
    maatSumPrijs: 'per maand',
    maatSumPer: 'per credit',
    maatSumBesp: 'Je bespaart',
    maatSumBespVs: 'tegenover dezelfde credits als catalogsets, los besteld',
    maatSumPreset: 'Of het',
    maatSumPresetPlan: 'abonnement',
    presetSep: '-',
    maatSumCta: 'Verder met dit abonnement',
    maatSumNoot: 'Altijd maandelijks. Elke maand opzegbaar.',
    maatTeVeel: `Meer dan ${CUSTOM_CREDITS_MAX} credits per maand? Dan plannen we het samen.`,
    maatTeWeinig: `Het minimum is ${CUSTOM_CREDITS_MIN} credits; wat je niet gebruikt schuift door.`,
    maatContact: 'Neem contact op',
    maatMelding: `Vul ${CUSTOM_CREDITS_MIN} tot ${CUSTOM_CREDITS_MAX} credits in — daar hangt de prijs van af.`,

    waaromH: 'Waarom een abonnement.',
    waarom: [
      [`${pctMin}–${pctMax}%`, 'goedkoper', 'dan dezelfde catalogsets los besteld.'],
      [`${PLAN_SERVICES.length}`, 'diensten, één saldo', 'Catalog, lifestyle, motion, hooks en lifestyleclips — jij kiest elke maand. Ook je eigen look, zodra hij gemaakt is.'],
      ['Vaste', 'productiedagen', 'Elke maand, vóór losse bestellingen — ook voor één product.'],
      [`${TERMS.yearly.rollover}`, 'maanden doorschuiven', `Op de jaartermijn; ${PLAN_ROLLOVER_MONTHS} op maandbasis. Een rustige maand kost je niets.`],
    ],

    termH: 'Per maand, per jaar of vooruit.',
    termen: [
      ['Maandelijks', 'Elke maand opzegbaar.', `Ongebruikte credits schuiven ${PLAN_ROLLOVER_MONTHS} maand door.`],
      ['12 maanden', 'Zelfde prijs, vaste looptijd.', `${TERMS.yearly.rollover} maanden doorschuiven, een prijsslot, en op Studio je eigen merkmodel.`],
      ['12 maanden vooruit', `Betaal 10, krijg 12: ${vrijMaanden} maanden gratis.`, 'In één keer betaald. Stop je eerder, dan komt er geen geld terug; het restant wordt tegoed.'],
    ],

    soonAllH: 'En wat eraan komt.',
    soonAllLede: 'Wat op aanvraag is, en wat nog niet te bestellen is.',
    hooksTag: 'Op aanvraag',
    hooksPlan: `Met een abonnement kost een hook ${SERVICE_CREDITS.hooks} credits.`,
    stockNow: [`${STOCK_OFF_BRAND} nieuwe ${noun('stock', 'nl')} per maand`, 'bij elk abonnement, bruikbaar voor elk merk.'],
    stockSoon: [`${STOCK_ON_BRAND} on-brand ${noun('visual', 'nl')} per maand`, 'in je eigen stijl, met Editions.'],
    stockNowTag: 'Nog niet actief',
    soonFoot: 'Omdat we de tarieven en het bestelproces nog afronden, is deze service tijdelijk niet actief.',
    soonTag: 'Nog niet klaar',

    ctaH: 'Begin met één product',
    ctaEm: `voor ${euro(AMOUNT.testSample, 'nl')}.`,
    ctaBody: 'Zie wat eruit komt voordat er een abonnement begint.',
    ctaSample: TEST_SAMPLE.nl.cta,
    ctaPlan: 'Sluit een abonnement af',
    outH: 'Niet elke maand?',
    outCta: 'Bekijk de prijs per product',
  },
};
const c = COPY[nl ? 'nl' : 'en'];
const volgendPreset = PRESETS.find((p) => p.credits > STANDAARD) || null;
---

<div class="s22 pl">

  {/* ── 1 · DE STELLING, EN HET MENU ──────────────────────────────────────
      Links wat een abonnement is in één zin; rechts wat een credit oplevert.
      Het menu IS de uitleg: wie het leest, snapt credits zonder woord uitleg. */}
  <section class="paneel" aria-labelledby="pl-h1">
    <div class="pl-open">
      <header class="paneel-kop pl-kop">
        <p class="etiket">{c.eyebrow}</p>
        <h1 id="pl-h1" class="hoog">{c.h1a} <em>{c.h1b}</em></h1>
        <p class="lopend">{c.lead}</p>
        <p class="acties">
          <a class="knop knop-inkt" href="#plannen">{c.ctaPlans}</a>
          <a class="knop knop-lijn" href="#op-maat">{c.ctaMaat}</a>
        </p>
      </header>
      <div class="pl-menu" aria-labelledby="pl-menu-h">
        <p id="pl-menu-h" class="mono pl-menu-h">{c.menuH}</p>
        <ul class="pl-menu-lijst" role="list">
          {DIENSTEN.map((d) => (
            <li>
              <span class="pl-menu-c"><b>{d.credits}</b> <span class="mono">{c.menuCredits}</span></span>
              <span class="pl-menu-naam">{d.naam}</span>
              <span class="pl-menu-per">{d.per}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  {/* ── 2 · DE PLANNEN ─────────────────────────────────────────────────────
      Drie kaarten met hetzelfde skelet, en een vierde voor je eigen aantal.
      Wat voor alle drie geldt, staat één keer onder de kaarten en niet drie
      keer erin. De knop draagt ?plan= mee (tests/subscribe.test.mjs). */}
  <section class="paneel" id="plannen" aria-labelledby="pl-plans">
    <header class="paneel-kop">
      <h2 id="pl-plans" class="hoog hoog-2">{c.plansH}</h2>
    </header>

    <ul class="pl-kaarten" role="list">
      {planList.map((p) => (
        <li class="pk">
          <h3 class="pk-naam">{p.name}</h3>
          <p class="pk-regel">{p.line}</p>
          <p class="pk-credits"><b>{p.credits}</b> <span>{c.credits}</span></p>
          <p class="pk-prijs">
            <span class="pk-bedrag">{p.price}</span>
            <span class="mono">{c.perMaand} · {ex}</span>
            <span class="mono pk-per">{p.perCredit} {c.perCredit}</span>
            {p.jaarPrijs && <span class="mono pk-per">{c.jaar(p.jaarPrijs)}</span>}
          </p>
          <ul class="pk-fit" role="list">
            <li><b>{p.fit.catalog}</b> {c.catSets}</li>
            <li><span class="pk-of">{c.of}</span> <b>{p.fit.lifestyle}</b> {c.carousels}</li>
            <li><span class="pk-of">{c.of}</span> <b>{p.fit.hooks}</b> {c.hooks}</li>
          </ul>
          {p.brandModel && <p class="pk-extra">{c.merkmodel}</p>}
          {(() => {
            const b = creditSaving(p.credits, PLAN_AMOUNT[p.id]);
            return b ? <p class="pk-besp">{c.bespaar(euro(b.saving, lang), b.count, euro(b.los, lang))}</p> : null;
          })()}
          <p class="pk-voet">
            <a href={`${lp('/start/plan')}?plan=${p.id}`} class="knop knop-inkt">{c.kiesPlan(p.name)}</a>
          </p>
        </li>
      ))}
      <li class="pk pk-maat">
        <h3 class="pk-naam">{c.maatKaartNaam}</h3>
        <p class="pk-regel">{c.maatKaartRegel}</p>
        <p class="pk-credits"><b>{CUSTOM_CREDITS_MIN}–{CUSTOM_CREDITS_MAX}</b> <span>{c.credits}</span></p>
        <p class="pk-prijs">
          <span class="mono">{c.maatKaartVanaf}</span>
          <span class="pk-bedrag">{euro(maatVanaf, lang)}</span>
          <span class="mono">{c.perMaand} · {ex}</span>
        </p>
        <p class="pk-voet">
          <a href="#op-maat" class="knop knop-lijn">{c.maatKaartCta}</a>
        </p>
      </li>
    </ul>

    <ul class="pl-samen" role="list">
      {c.samen.map((s) => <li>{s}</li>)}
    </ul>
  </section>

  {/* ── 3 · HET PLAN OP MAAT ───────────────────────────────────────────────
      Een gewoon formulier naar /start/plan met plan=maat en credits=N: zonder
      script werkt het ook, en de server rekent de prijs toch opnieuw uit. Het
      script eronder houdt de samenvatting rechts bij en telt de hulp op. */}
  <section class="paneel" id="op-maat" aria-labelledby="pl-maat">
    <header class="paneel-kop">
      <h2 id="pl-maat" class="hoog hoog-2">{c.maatH}</h2>
      <p class="lopend">{c.maatLede}</p>
    </header>

    <form class="pm" method="get" action={lp('/start/plan')} data-pm>
      <input type="hidden" name="plan" value={CUSTOM_MONTH_ID} />
      <div class="pm-links">
        <label class="pm-veld" for="pm-credits">{c.maatLabel}</label>
        <div class="pm-invoer">
          <button type="button" class="pm-stap" data-pm-stap={-CUSTOM_CREDITS_STEP} aria-label={c.maatMin}>−</button>
          <input id="pm-credits" name="credits" type="number" inputmode="numeric"
                 min={CUSTOM_CREDITS_MIN} max={CUSTOM_CREDITS_MAX} step="1" value={STANDAARD} required data-melding={c.maatMelding} data-pm-credits />
          <button type="button" class="pm-stap" data-pm-stap={CUSTOM_CREDITS_STEP} aria-label={c.maatMeer}>+</button>
        </div>
        <input class="pm-schuif" type="range" min={CUSTOM_CREDITS_MIN} max={CUSTOM_CREDITS_MAX} step={CUSTOM_CREDITS_STEP}
               value={STANDAARD} aria-label={c.maatLabel} data-pm-schuif tabindex="-1" />

        <p class="mono pm-fit-h">{c.maatFitH}</p>
        <ul class="pm-fit" role="list" data-pm-fit>
          {DIENSTEN.map((d, i) => (
            <li><span class="pm-of">{i ? c.maatFitOf : ''}</span> <b data-pm-fit-n={d.id}>{voorafFit[d.id]}</b> <span>{d.meer}</span></li>
          ))}
        </ul>

        <details class="pm-hulp">
          <summary>{c.maatHelpH}</summary>
          <p class="lopend">{c.maatHelpLede}</p>
          <ul class="pm-mix" role="list">
            {DIENSTEN.map((d) => (
              <li>
                <span class="pm-mix-naam">{d.naam} <span class="mono">· {d.credits} {c.menuCredits}</span></span>
                <span class="pm-mix-knop">
                  <button type="button" data-pm-mix={d.id} data-pm-mix-d="-1" aria-label={`${c.maatMin}: ${d.naam}`}>−</button>
                  <output data-pm-mix-n={d.id}>0</output>
                  <button type="button" data-pm-mix={d.id} data-pm-mix-d="1" aria-label={`${c.maatMeer}: ${d.naam}`}>+</button>
                </span>
              </li>
            ))}
          </ul>
          <p class="pm-mix-tot"><span>{c.maatHelpTotaal}:</span> <b data-pm-mix-tot>0</b> {c.menuCredits}
            <button type="button" class="knop knop-lijn pm-mix-zet" data-pm-mix-zet disabled>{c.maatHelpZet}</button></p>
