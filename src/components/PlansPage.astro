---
/*
 * VISUAILS — /plans en /nl/plans. Opnieuw opgebouwd op 23 september 2026.
 * ═══════════════════════════════════════════════════════════════════════════
 *
 * Lucas: *"Voeg ook nog aan de lijst toe om te kijken of abonnement nou wel
 * klopt omdat ik nog steeds producten zie staan en dat 1 product catalog en
 * lifestyle in 1 zijn, terwijl de klant niet alleen hieraan vast zit. Het lijkt
 * alsof het abonnement niks voorstelt bijna (…) Ook moet de klant credits kunnen
 * invoeren bij custom plan en dat hij dan ziet wat hij met die credits kan
 * krijgen voor content per maand zodat hij precies op zijn nodige hoeveelheid
 * kan kopen. Bedenk en redesign het abonnement pagina volledig van de grond op."*
 *
 * ── WAT ER MIS WAS ─────────────────────────────────────────────────────────
 *
 * De achterkant rekende sinds 19 september in credits (SERVICE_CREDITS en
 * PLAN_CREDITS in pricing.js, het saldo in slots.js). Deze pagina zei nog "5
 * producten, elk een catalogset én een carrousel" — precies het beeld van een
 * vast pakket waar je aan vastzit. En de maand op maat rekende het LOSSE tarief:
 * een abonnement op maat was even duur als los bestellen.
 *
 * ── WAT ER NU STAAT, IN DEZE VOLGORDE ─────────────────────────────────────
 *
 *   1 · De stelling: elke maand credits, en wat een credit oplevert (het menu).
 *   2 · De drie plannen, met credits, prijs per credit en wat je bespaart.
 *   3 · Het plan op maat: je vult credits in en ziet meteen wat je ervoor krijgt
 *       en wat het kost. Werkt ook zonder script (dan is het een gewoon
 *       formulier naar /start/plan).
 *   4 · Waarom een abonnement: vier voordelen, elk met een getal.
 *   5 · De drie termijnen.
 *   6 · Wat eraan komt (#binnenkort — het menu wijst hierheen).
 *   7 · Het slot.
 *
 * Elk bedrag en elk aantal komt uit pricing.js en plans.js. De prijs van een
 * plan op maat komt uit customCreditsTotal(), dezelfde functie die de server in
 * subscribe.js gebruikt: de tabel voor het script wordt hier bij het bouwen
 * uitgerekend, dus browser en server kunnen niet uit elkaar lopen.
 */
import {
  euro, vatLabel, plans, AMOUNT, PLAN_AMOUNT, PLAN_CREDITS, PLAN_ROLLOVER_MONTHS,
  SERVICE_CREDITS, PLAN_SERVICES, SLOT_KINDS,
  STOCK_OFF_BRAND, STOCK_ON_BRAND, TEST_SAMPLE,
  CUSTOM_MONTH_ID, CUSTOM_CREDITS_MIN, CUSTOM_CREDITS_MAX, CUSTOM_CREDITS_STEP,
  customCreditsTotal, creditSaving, creditsFit,
} from '../data/pricing.js';
import { planName } from '../data/planNames.js';
import { noun } from '../data/lexicon.js';
import { localizedPath } from '../i18n/ui.js';
import { TERMS, monthlyCents, prepayFreeMonths } from '../data/plans.js';
import { binnenkort } from '../data/binnenkort.js';
import '../styles/stijl22.css';

const { lang = 'en' } = Astro.props;
const nl = lang === 'nl';
const lp = (p) => localizedPath(lang, p);
const ex = vatLabel('excl', lang);

const JAAR_PRIJZEN = Object.fromEntries(
  Object.keys(PLAN_AMOUNT).map((id) => [id, monthlyCents(id, 'yearly') / 100])
);
const planList = plans(lang, { jaarRollover: TERMS.yearly.rollover, jaarPrijzen: JAAR_PRIJZEN });

/* Het menu: wat een credit oplevert. Dezelfde tabel als het dashboard. */
const DIENSTEN = PLAN_SERVICES.map((k) => ({
  id: k,
  naam: nl ? SLOT_KINDS[k].nl : SLOT_KINDS[k].en,
  per: nl ? SLOT_KINDS[k].per.nl : SLOT_KINDS[k].per.en,
  credits: SERVICE_CREDITS[k],
  /* Meervoud voor "daar krijg je 21 catalogsets": SLOT_KINDS kent alleen het enkelvoud. */
  meer: (nl
    ? { catalog: 'catalogsets', lifestyle: 'lifestyle-carousels', 'video-motion': 'motion-clips', 'video-lifestyle': 'lifestyle-clips', hooks: 'hooks' }
    : { catalog: 'catalog sets', lifestyle: 'lifestyle carousels', 'video-motion': 'motion clips', 'video-lifestyle': 'lifestyle clips', hooks: 'hooks' })[k] || (nl ? SLOT_KINDS[k].nl : SLOT_KINDS[k].en),
}));

/* De besparing over de drie plannen, als bereik. */
const pcts = planList.map((p) => p.savingPct).filter((x) => x > 0);
const pctMin = Math.min(...pcts);
const pctMax = Math.max(...pcts);

/* Het plan op maat. De standaardwaarde is het midden tussen Starter en Studio,
   afgerond op de stap: een getal dat laat zien dat je TUSSEN de plannen kunt
   zitten. */
const STANDAARD = Math.round(((PLAN_CREDITS.starter + PLAN_CREDITS.studio) / 2) / CUSTOM_CREDITS_STEP) * CUSTOM_CREDITS_STEP;
const maatVanaf = customCreditsTotal(CUSTOM_CREDITS_MIN).total;
const vooraf = customCreditsTotal(STANDAARD);
const voorafBesp = creditSaving(STANDAARD, vooraf.total);
const voorafFit = creditsFit(STANDAARD);

/* De tabel voor het script: per aantal credits de prijs en wat dezelfde credits
   los aan catalogsets kosten. Bij het bouwen uitgerekend, met dezelfde functies
   als de server. */
const TABEL = {};
for (let n = CUSTOM_CREDITS_MIN; n <= CUSTOM_CREDITS_MAX; n += 1) {
  const t = customCreditsTotal(n);
  const b = creditSaving(n, t.total);
  TABEL[n] = [t.total, b ? b.los : 0];
}
const PRESETS = Object.keys(PLAN_CREDITS)
  .map((id) => ({ id, naam: planName(id, lang), credits: PLAN_CREDITS[id], prijs: PLAN_AMOUNT[id] }))
  .sort((a, b) => a.credits - b.credits);
const DATA = JSON.stringify({
  min: CUSTOM_CREDITS_MIN, max: CUSTOM_CREDITS_MAX, stap: CUSTOM_CREDITS_STEP,
  tabel: TABEL, presets: PRESETS,
  diensten: DIENSTEN.map((d) => ({ id: d.id, credits: d.credits })),
  sep: nl ? ['.', ','] : [',', '.'],
});

const vrijMaanden = prepayFreeMonths('studio');

const COPY = {
  en: {
    eyebrow: 'Plans',
    h1a: 'Credits every month.',
    h1b: 'Spend them on anything.',
    lead: `One monthly budget for catalog, lifestyle and video — ${pctMin}–${pctMax}% cheaper than ordering one by one.`,
    ctaPlans: 'Choose a plan',
    ctaMaat: 'Build your own',
    menuH: 'What a credit buys',
    menuCredits: 'credits',

    plansH: 'Three plans. Or your own number.',
    perMaand: 'a month',
    perCredit: 'per credit',
    credits: 'credits',
    of: 'or',
    catSets: 'catalog sets',
    carousels: 'carousels',
    hooks: 'hooks',
    bespaar: (s, n, los) => `Save ${s} a month — ${n} catalog sets one-off cost ${los}.`,
    merkmodel: 'Your own Brand Model included',
