  .pl-prijs { display: flex; flex-wrap: wrap; align-items: baseline; gap: .4rem .5rem; margin: .6rem 0 .4rem; }
  .pl-prijs .mono { color: var(--inkt-2); }
  .pl-jaar { flex-basis: 100%; }
  .pl-besparing { color: var(--inkt-2); }
  /* De knop zakt naar de onderrand, zodat de drie op één lijn staan ook als de
     ene lijst langer is dan de andere. */
  .pl-kaart-voet { margin-top: auto; padding-top: 1.4rem; }

  .pl-maat { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 20rem); gap: clamp(1.4rem, 4vw, 3rem); align-items: center; margin-top: clamp(2.5rem, 5vw, 4rem); padding-top: clamp(1.6rem, 3vw, 2.4rem); border-top: 1px solid var(--lijn); }
  .pl-maat-t { display: grid; gap: .6rem; }
  .pl-maat-a { display: grid; gap: 1rem; justify-items: start; }
