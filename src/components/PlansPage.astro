  .pl-bank { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1fr); gap: clamp(1.5rem, 4vw, 3.5rem); align-items: center; }
  .pl-bank-t { display: grid; gap: 1.4rem; }
  .pl-bank-item { display: grid; gap: .4rem; padding-top: 1rem; border-top: 1px solid var(--lijn); }
  .pl-bank-n { font-family: var(--kop2); font-weight: 500; font-stretch: 125%; font-size: clamp(1.05rem, 1.8vw, 1.35rem); text-transform: uppercase; letter-spacing: -.01em; display: flex; flex-wrap: wrap; align-items: baseline; gap: .6rem; }
  .pl-bank-item.is-later .lopend { color: var(--inkt-3, #6E6E6E); }
  .pl-tag { color: var(--inkt); background: var(--geel); border-radius: 999px; padding: .25rem .6rem; }

  .pl-soon-lijst { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(1.4rem, 3.5vw, 3rem); }
  .pl-soon-lijst li { display: grid; gap: .6rem; align-content: start; padding-top: 1.2rem; border-top: 1px solid var(--lijn); }
  .pl-soon-n { font-family: var(--kop2); font-weight: 500; font-stretch: 125%; font-size: clamp(1.15rem, 2vw, 1.5rem); text-transform: uppercase; letter-spacing: -.01em; display: flex; flex-wrap: wrap; align-items: baseline; gap: .6rem; }
  .pl-soon-dl { display: grid; gap: .5rem; margin-top: .4rem; }
  .pl-soon-dl dt { color: var(--inkt-2); }
  .pl-soon-dl dd { margin: 0; font-size: .92rem; }
  .pl-soon-voet { margin-top: clamp(1.6rem, 3vw, 2.4rem); font-size: .92rem; }

  .pl-uit { display: grid; gap: .8rem; justify-items: start; }

  @media (max-width: 900px) {
    .pl-top, .pl-bank, .pl-maat, .pl-soon-lijst { grid-template-columns: 1fr; }
    /* Eén kolom: de plaatsing hierboven losgelaten, zodat de bronvolgorde de
       volgorde op het scherm is — eerst het bedrag, dan de uitleg. */
    .pl-uitleg, .pl-plaat { grid-column: auto; grid-row: auto; }
    .pl-kaarten { grid-template-columns: 1fr; }
    .pl-maat, .pl-bank { align-items: start; }
  }
</style>
