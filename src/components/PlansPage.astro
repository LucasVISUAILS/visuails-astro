---
/*
 * VISUAILS — /plans en /nl/plans: het abonnement als eigen pagina.
 *
 * ── WAAROM DEZE PAGINA BESTAAT — 20 augustus 2026 ──────────────────────────
 *
 * Lucas: *"Abonnementen zou ik wel graag echt een eigen pagina voor hebben dan
 * nu dat het slordig tussen de compare prices lijst staat. Het mag allemaal wel
 * wat meer gescheiden van elkaar zijn en maak de compare prices lijst dan heel
 * simpel met gewoon de prijzen en niet teveel informatie eromheen."*
 *
 * Hij heeft gelijk, en de reden is scherper dan "het staat er rommelig". Op
 * /pricing stonden TWEE prijsmodellen door elkaar: een staffel per product en
 * drie abonnementen. Dat zijn geen twee secties van hetzelfde onderwerp maar
 * twee manieren om te kopen, en een bezoeker die de tabel leest is nog aan het
 * uitrekenen wat één bestelling kost terwijl er onder diezelfde kop al drie
 * maandbedragen staan. Twee vragen tegelijk beantwoorden is geen van beide
 * beantwoorden.
 *
 * Nu: /pricing is de prijslijst en niets anders, /plans is het abonnement en
 * niets anders, en ze wijzen naar elkaar met één regel.
 *
 * ── DE LOOK KOMT VAN DE HOMEPAGE, EN LETTERLIJK ────────────────────────────
 *
 * Lucas in dezelfde adem: *"consistenter maken met de homepage look ... zodat
 * alles mooi consistent blijft en overloopt op elkaar."* Het limoen paneel dat
 * de homepage voor dit onderwerp gebruikt, staat sinds vandaag in global.css
 * als `.lime-panel` en wordt hier hergebruikt — niet nagebouwd. Zelfde blok,
 * zelfde licht, zelfde korrel, één definitie.
 *
 * ── GEEN GETAL IN DEZE COPY ────────────────────────────────────────────────
 *
 * Elk bedrag, elk aantal producten en elke levertijd komt uit plans() en
 * pricing.js. Wat hier staat is de zin eromheen. Dat is dezelfde regel als op
 * elke andere pagina en het is de reden dat een prijswijziging nergens een
 * vergeten string achterlaat.
 */
import Placeholder from './Placeholder.astro';
import {
  euro, vatLabel, plans, turnaround, AMOUNT,
  PLAN_AMOUNT, PLAN_PRODUCTS, PLAN_ROLLOVER_MONTHS,
  STOCK_OFF_BRAND, STOCK_ON_BRAND,
} from '../data/pricing.js';
// Het juiste woord per soort beeld — zie de kop van lexicon.js.
import { noun } from '../data/lexicon.js';
import { localizedPath } from '../i18n/ui.js';
import { waHref } from '../data/whatsapp.js';

import ServiceSwitch from './ServiceSwitch.astro';
import Note from './Note.astro';
const { lang = 'en' } = Astro.props;
const nl = lang === 'nl';
const lp = (p) => localizedPath(lang, p);

/* Het goedkoopste plan levert zowel het bedrag als het aantal producten, en
   die twee horen bij ELKAAR — los het laagste bedrag en het laagste aantal
   pakken werkt vandaag toevallig en gaat liegen zodra er een vierde plan komt
   met een ander verband. Zelfde afleiding als in HomeV2. */
const CHEAPEST = Object.keys(PLAN_AMOUNT).reduce((a, b) => (PLAN_AMOUNT[b] < PLAN_AMOUNT[a] ? b : a));
const FROM_AMOUNT = PLAN_AMOUNT[CHEAPEST];
const FROM_PRODUCTS = PLAN_PRODUCTS[CHEAPEST];

const planList = plans(lang);

/* De twee concepten die nog niet te bestellen zijn. Verhuisd van de homepage op
   30 augustus 2026 — zie de kop van src/data/binnenkort.js voor waarom ze hier
   zijn komen te staan en niet op twee eigen pagina's. */
import { binnenkort } from '../data/binnenkort.js';

const COPY = {
  en: {
    eyebrow: 'Subscription',
    h1a: 'The same studio, ',
    h1b: 'every month',
    h1c: '.',
    lead: 'A plan is not a bigger package. It is the same work on a standing arrangement: a fixed number of products every month, in a week the calendar keeps free for you, at a lower rate than ordering it one at a time.',

    panelH: ['What a plan', 'actually is.'],
    panelLede: 'Three things change when the work comes round every month instead of order by order. Nothing else does — the same studio, the same review, the same files.',
    facts: [
      'A fixed number of products each month, yours to spend as the collection needs.',
      'Your own week in the calendar, booked before anyone else can take it.',
      'A lower rate per product than the same output ordered separately.',
    ],
    from: 'from',
    unit: `a month · ${FROM_PRODUCTS} products`,
    cta: 'Start a plan',
    cta2: 'See the price per product',

    plansH: 'The three plans',
    plansSub: 'Same service on all three. What changes is how much of the month you book.',
    plansCta: 'Set up this plan',

    creditH: `${FROM_PRODUCTS} slots, not ${FROM_PRODUCTS} new products.`,
    // GESPLITST, 21 augustus 2026. Dit was één alinea van 55 woorden — de
    // langste van /plans. De twee zinnen die twijfel wegnemen ("je hoeft niets
    // nieuws te hebben" en "wat je niet gebruikt vervalt niet") staan er nog
    // gewoon; de opsomming van wát je erin kunt stoppen staat achter het
    // vraagteken, want dat is een voorbeeld en geen voorwaarde.
    creditBody: `A credit is a place in the month, not a demand that you have something new. What you do not use rolls over ${PLAN_ROLLOVER_MONTHS === 1 ? 'a' : PLAN_ROLLOVER_MONTHS} month${PLAN_ROLLOVER_MONTHS === 1 ? '' : 's'}.`,
    creditNoteTerm: 'a credit',
    creditNote: 'You decide each month what goes in it: a new item, an item you already sell in a different look for a campaign, or a set made for your socials.',
    creditAsk: 'Not sure what to spend the rest on?',
    creditAskCta: 'Ask us and we will go through it with you',
    creditWa: 'Hi! I have a plan and I would like to think through what to spend this month’s credits on.',

    stockH: 'And a month that is already filled.',
    stockNow: [`${STOCK_OFF_BRAND} new ${noun('stock', 'en')} every month`, 'included with every plan, usable by any brand — something to post on the days you have no new product.'],
    stockSoon: [`${STOCK_ON_BRAND} on-brand ${noun('visual', 'en')} a month`, 'set up on your style, your locations and your brand colours, with no product in them — they give the brand a feeling rather than sell an item. They arrive with Editions and are set up once per brand.'],
    /* Zie de noot bij stockNowTag in HomeV2.astro: de gedeelde bibliotheek
       bestaat nog niet, en de regel stond hier net als daar zonder label
       tussen dingen die wél meekomen met een abonnement. */
    stockNowTag: 'Not running yet',
    stockSoonTag: 'With Editions',
    stockShot: 'A month grid of visuals for one brand — twenty frames in the same colours and light, with no product in them',
    stockShotMsg: 'Mood, texture, hands, light — no garment and no packshot. If it reads as a stock library it has failed; it has to read as one brand.',

    soonH: 'And two things that are on the way.',
    soonLede: 'Neither can be ordered yet, so there is no price and no button. What they are is written out here rather than announced with a date we cannot hold.',
    soonFoot: 'This is the concept as it stands. Pricing and ordering details are still being finalized, which is why booking is currently inactive.',
    soonTag: 'Not ready yet',

    outH: 'Not every month, then.',
    outBody: 'Order by order works too, and the rate falls as the count rises. The price per product is on the pricing page.',
    outCta: 'See the price per product',

    ctaH: 'Start with one product',
    ctaEm: `for ${euro(AMOUNT.testSample, "en")}.`,
    ctaBody: 'Send the photos you already have and see what comes back before any plan starts.',
    ctaSample: 'Request a test sample',
    ctaPlan: 'Start a plan',
  },
  nl: {
    eyebrow: 'Abonnement',
    h1a: 'Dezelfde studio, ',
    h1b: 'elke maand',
    h1c: '.',
    lead: 'Een abonnement is geen groter pakket. Het is hetzelfde werk op een vaste afspraak: elke maand een vast aantal producten, in een week die de planning voor je vrijhoudt, tegen een lager tarief dan wanneer je het los bestelt.',

    panelH: ['Wat een abonnement', 'eigenlijk is.'],
    panelLede: 'Er veranderen drie dingen zodra het werk elke maand terugkomt in plaats van bestelling voor bestelling. Verder niets — dezelfde studio, dezelfde controle, dezelfde bestanden.',
    facts: [
      'Elke maand een vast aantal producten, te besteden zoals de collectie het vraagt.',
      'Je eigen week in de planning, vastgezet voordat iemand anders hem kan nemen.',
      'Een lager tarief per product dan hetzelfde werk los besteld.',
    ],
    from: 'vanaf',
    unit: `per maand · ${FROM_PRODUCTS} producten`,
    cta: 'Sluit een abonnement af',
    cta2: 'Bekijk de prijs per product',

    plansH: 'De drie abonnementen',
    plansSub: 'Dezelfde dienst bij alle drie. Wat verschilt is hoeveel van de maand je vastlegt.',
    plansCta: 'Dit abonnement opzetten',

    creditH: `${FROM_PRODUCTS} plekken, geen ${FROM_PRODUCTS} nieuwe producten.`,
    creditBody: `Een credit is een plek in de maand, niet de eis dat je iets nieuws hebt. Wat je niet gebruikt schuift ${PLAN_ROLLOVER_MONTHS === 1 ? 'een' : PLAN_ROLLOVER_MONTHS} maand door.`,
    creditNoteTerm: 'een credit',
    creditNote: 'Jij bepaalt elke maand wat erin gaat: een nieuw item, een item dat je al verkoopt in een andere look voor een campagne, of een set die je voor je socials maakt.',
    creditAsk: 'Weet je niet waar je de rest aan besteedt?',
    creditAskCta: 'Vraag het ons, dan lopen we het samen door',
    creditWa: 'Hoi! Ik heb een abonnement en wil graag even doornemen waar ik de credits van deze maand aan kan besteden.',

    stockH: 'En een maand die al gevuld is.',
    stockNow: [`${STOCK_OFF_BRAND} nieuwe ${noun('stock', 'nl')} per maand`, 'inbegrepen bij elk abonnement en bruikbaar voor elk merk — iets om te posten op de dagen dat je niets nieuws hebt.'],
    stockSoon: [`${STOCK_ON_BRAND} on-brand ${noun('visual', 'nl')} per maand`, 'opgezet op jouw stijl, jouw locaties en jouw merkkleuren, zonder product erin — ze geven het merk een gevoel in plaats van dat ze iets verkopen. Ze komen met Editions en worden één keer per merk opgezet.'],
    stockNowTag: 'Nog niet actief',
    stockSoonTag: 'Met Editions',
    stockShot: 'Een maandraster van beelden voor één merk — twintig foto’s naast elkaar in dezelfde kleuren en hetzelfde licht, zonder product erin',
    stockShotMsg: 'Sfeer, textuur, handen, licht — geen kledingstuk en geen packshot. Leest het als een stockbibliotheek, dan is het mislukt; het moet als één merk lezen.',

    soonH: 'En twee dingen die eraan komen.',
    soonLede: 'Allebei nog niet te bestellen, dus er staat geen prijs bij en geen knop. Wat ze zijn staat hier uitgeschreven, in plaats van aangekondigd met een datum die we niet kunnen vasthouden.',
    soonFoot: 'Dit is het concept zoals het er nu voorstaat. Omdat we de tarieven en het bestelproces nog afronden, is deze service tijdelijk niet actief.',
    soonTag: 'Nog niet klaar',

    outH: 'Toch liever niet elke maand.',
    outBody: 'Los bestellen kan net zo goed, en het tarief daalt naarmate het aantal stijgt. De prijs per product staat op de prijzenpagina.',
    outCta: 'Bekijk de prijs per product',

    ctaH: 'Begin met één product',
    ctaEm: `voor ${euro(AMOUNT.testSample, "nl")}.`,
    ctaBody: 'Stuur de foto’s die je al hebt en zie wat eruit komt voordat er een abonnement begint.',
    ctaSample: 'Vraag een proefvisual aan',
    ctaPlan: 'Sluit een abonnement af',
  },
};
const c = COPY[nl ? 'nl' : 'en'];
---

<section class="page-hero"><div class="container">
  <span class="eyebrow-page">{c.eyebrow}</span>
  <h1 class="display">{c.h1a}<em>{c.h1b}</em>{c.h1c}</h1>
  <p class="lead" style="margin-top:1.2rem">{c.lead}</p>
</div></section>

{/* ── HET PANEEL ─────────────────────────────────────────────────────────────
    Hetzelfde blok als op de homepage, uit global.css. Hier draagt het de
    propositie plus het instapbedrag; de drie plannen staan eronder op de
    paginagrond, zodat het paneel de UITLEG is en de kaarten de KEUZE. Zet je ze
    allebei in het paneel, dan is het weer één lange band met twee onderwerpen —
    precies waar deze pagina voor is opgesplitst. */}
<section class="section-tight"><div class="container">
  <div class="lime-panel">
    <div class="lime-panel-light" aria-hidden="true"></div>
    {/* ── `.on-bright` IS ERAF — 21 augustus 2026 ─────────────────────────
        En dit was geen schoonheidsfoutje. `.on-bright` is de scope die zegt
        "de grond onder mij is HELDER, draai de hele inktladder om naar
        bijna-zwart". Dat klopte zolang dit paneel een vlak van #C6F100 was.

        Op 20 augustus werd de grond een donkere foto met een limoen bundel.
        In HomeV2.astro is `.on-bright` toen weggehaald — met een noot erbij
        dat half omdraaien hier het gevaar is — maar deze pagina gebruikt
        hetzelfde blok en is vergeten. Sindsdien stond het hele
        abonnementspaneel op /plans en /nl/plans in bijna-zwarte letters op een
        bijna-zwarte foto.

        Gemeten op 21 augustus: vijftien tekstregels op 1,0 tot 1,04 : 1, waar
        4,5 de eis is. Dat is niet moeilijk leesbaar maar ONZICHTBAAR — de kop
        "What a plan actually is." was op een schermafdruk alleen te vinden door
        te weten waar hij stond.

        Gevonden door de leesbaarheidsmeting die de pagina twee keer afdrukt,
        één keer met alle tekstkleuren op doorzichtig, en de twee vergelijkt.
        Geen enkele controle die naar de STYLESHEET kijkt kon dit zien: daar
        stond keurig een kleur, alleen de grond eronder was een foto. */}
    <div class="lime-panel-in">
      <div class="pl-top">
        <div>
          <h2 class="pl-h">{c.panelH[0]} <em class="pl-em">{c.panelH[1]}</em></h2>
          <p class="pl-lede">{c.panelLede}</p>
          <ul class="pl-facts">
            {c.facts.map((f) => (
              <li>
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M20 6L9 17l-5-5" /></svg>
                <span>{f}</span>
              </li>
            ))}
          </ul>
          {/* ── DE ZIJDEUR STOND OP EEN EIGEN RASTERRIJ — 31 AUGUSTUS 2026 ──
              Hij hing als DERDE kind in een raster van twee kolommen, dus hij
              viel naar rij 2 — en rij 1 is zo hoog als de limoenplaat ernaast.
              Gemeten gaf dat 110px leegte tussen de drie vinkjes en deze regel,
              midden in het paneel dat de propositie draagt.

              Hij hoort ook inhoudelijk hier: het is de laatste regel van de
              linkerkolom, niet een derde blok. Buiten de limoen plaat blijft
              hij, want daarbinnen zou een rij grijze links de plaat rommelig
              maken — dat deel van de oude noot klopt nog. */}
          <ServiceSwitch current={['plan', 'complete']} lang={lang} class="pl-svcsw" />
        </div>

        <div class="lime-plate plaat-vol">
          {/* Dezelfde vorm als op de homepage en op /pricing, sinds 30 augustus
              2026 één keer gedefinieerd in global.css onder `.bedrag-*`. De maat
              wijkt hier bewust af — dit bedrag staat alleen in zijn kolom, niet
              naast een tweede — en dat staat als variabele op het blok in plaats
              van als eigen klasse. */}
          <div class="bedrag pl-bedrag">
            <span class="bedrag-label">{c.from}</span>
            <span class="bedrag-cijfer">{euro(FROM_AMOUNT, lang)}</span>
            <span class="bedrag-eenheid">{c.unit}</span>
            <span class="bedrag-btw">{vatLabel('excl', lang)}</span>
          </div>
          <div class="pl-cta">
            <a class="btn btn-primary" href={lp('/start/plan')}>{c.cta}</a>
            <a class="btn btn-ghost" href={lp('/pricing')}>{c.cta2}</a>
          </div>
        </div>
      </div>

      {/* De correctie op het getal, direct onder het getal dat hij corrigeert. */}
      <div class="pl-credit">
        <p class="pl-credit-h">{c.creditH}</p>
        <p class="pl-credit-b">{c.creditBody} <Note lang={lang} term={c.creditNoteTerm}>{c.creditNote}</Note></p>
        <p class="pl-credit-ask">
          <span>{c.creditAsk}</span>
          <a class="pl-credit-a" href={waHref(c.creditWa)} target="_blank" rel="noopener">{c.creditAskCta}<span class="pl-nb">&#160;<svg viewBox="0 0 24 24" class="i" aria-hidden="true" focusable="false"><path d="M5 12h14M13 6l6 6-6 6" /></svg></span></a>
        </p>
      </div>
    </div>
  </div>
</div></section>

{/* ── DE DRIE KAARTEN ────────────────────────────────────────────────────────
    Dezelfde `.pack`-opmaak als de rest van de site gebruikt, zodat een kaart
    hier hetzelfde leest als een kaart elders. De knop draagt ?plan= mee: zonder
    dat parameter opent /start/plan altijd op Studio, en wie op de Merk-kaart
    klikte kwam op een machtiging voor het verkeerde bedrag. */}
<section class="section-tight"><div class="container">
  <div class="section-head"><h2 id="plans">{c.plansH}</h2><p>{c.plansSub}</p></div>

  <div class="packs plans-3 reveal-group">
    {planList.map((p) => (
      <div class="pack reveal pending">
        <div class="pack-top"><h3 class="pack-name">{p.name}</h3></div>
        <p class="pack-line">{p.line}</p>

        <div class="pack-price">
          <span class="pp-amount">{p.price}</span>
          <span class="pp-unit">{p.unit}</span>
          <span class="pp-vat">{vatLabel('excl', lang)}</span>
        </div>

        <ul class="checklist pack-inc">
          {p.includes.map((f) => (
            <li><svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>{f}</li>
          ))}
        </ul>

        {p.saving && (
          <p class="pack-saving">{p.saving} <span class="pack-saving-vat">{`(${vatLabel('excl', lang)})`}</span></p>
        )}

        <a href={`${lp('/start/plan')}?plan=${p.id}`} class="btn btn-primary btn-block pack-cta">{c.plansCta}</a>
      </div>
    ))}
  </div>
</div></section>

{/* ── DE BEELDBANK ───────────────────────────────────────────────────────────
    Wat er naast de bestellingen in de maand zit. Staat hier en niet in het
    paneel, omdat het geen eigenschap van het abonnement is maar iets dat
    ernaast wordt geleverd. */}
<section class="section-tight"><div class="container">
  <div class="pl-stock">
    <div class="pl-stock-shot">
      <Placeholder
        lang={lang}
        ratio="4 / 3"
        subject={c.stockShot}
        message={c.stockShotMsg}
      />
    </div>
    <div>
      <h2 class="pl-stock-h">{c.stockH}</h2>
      <div class="pl-stock-item">
        <p class="pl-stock-n">{c.stockNow[0]} <em class="pl-soon">{c.stockNowTag}</em></p>
        <p class="pl-stock-b">{c.stockNow[1]}</p>
      </div>
      <div class="pl-stock-item is-soon">
        <p class="pl-stock-n">{c.stockSoon[0]} <em class="pl-soon">{c.stockSoonTag}</em></p>
        <p class="pl-stock-b">{c.stockSoon[1]}</p>
      </div>
    </div>
  </div>
</div></section>

{/* ── HOOKS EN EDITIONS ──────────────────────────────────────────────────────
    Verhuisd van de homepage op 30 augustus 2026. Daar was dit ruim 450 woorden
    — bijna een vijfde van de hele pagina — over twee dingen die er zelf bij
    zeggen dat je ze nog niet kunt bestellen.

    HET ANKER IS EEN AFSPRAAK. In src/i18n/ui.js staan Hooks en Editions bij de
    diensten in het menu, en die twee wijzen sinds vandaag hierheen. Verandert
    `#binnenkort`, dan verandert daar de href mee — tests/binnenkort.test.mjs
    legt de twee naast elkaar.

    UITGEKLAPT EN NIET DICHTGEKLAPT, anders dan op de homepage. Daar was de
    uitklapper er om ruimte te sparen op een pagina waar iemand nog aan het
    kijken is wát je maakt. Hier is dat de reden om te komen: wie doorklikt naar
    /plans#binnenkort heeft de vraag al gesteld, en die dan nog een keer laten
    klikken is een deur voor een deur. */}
<section class="section-tight" id="binnenkort"><div class="container">
  <div class="section-head">
    <h2>{c.soonH}</h2>
    <p>{c.soonLede}</p>
  </div>
  <div class="pl-soon-grid">
    {binnenkort(lang).map((b) => (
      <article class="pl-soon-card" id={b.id}>
        <p class="pl-soon-n">{b.name} <em class="pl-soon">{c.soonTag}</em></p>
        <p class="pl-soon-d">{b.desc}</p>
        <dl class="pl-soon-dl">
          {b.qBody.map(([kop, tekst]) => (<Fragment><dt>{kop}</dt><dd>{tekst}</dd></Fragment>))}
        </dl>
      </article>
    ))}
  </div>
  <p class="pl-soon-foot">{c.soonFoot}</p>
</div></section>

{/* ── DE UITGANG ─────────────────────────────────────────────────────────────
    Eén regel naar de prijslijst, en dat is de hele verbinding tussen de twee
    pagina's. Wie hier is en géén abonnement wil, hoort niet doodlopend te
    eindigen — en wie de staffel zoekt, hoort hem niet op deze pagina te vinden. */}
<section class="section-tight"><div class="container narrow">
  <div class="pl-out">
    <h2 class="pl-out-h">{c.outH}</h2>
    <p class="pl-out-b">{c.outBody}</p>
    <a class="link-arrow" href={lp('/pricing')}>{c.outCta}
      <svg viewBox="0 0 24 24" class="i" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
    </a>
  </div>
</div></section>

<section class="section-tight"><div class="container">
  <div class="cta-band reveal pending">
    <h2 class="display" style="font-size:var(--t-page-h2)">{c.ctaH}<br /><em>{c.ctaEm}</em></h2>
    <p style="margin-top:1rem;color:var(--ink-3);max-width:52ch;margin-inline:auto">{c.ctaBody}</p>
    <div class="flex" style="justify-content:center;margin-top:2rem">
      <a href={lp('/test-sample')} class="btn btn-primary btn-lg">{c.ctaSample}</a>
      <a href={lp('/start/plan')} class="btn btn-ghost btn-lg">{c.ctaPlan}</a>
    </div>
  </div>
</div></section>

<style>
  .pl-svcsw { margin-top: 1.4rem; }
  /* De opmaak binnen het paneel. De paneelvorm zelf, het licht, de korrel en de
     donkere plaat staan in global.css onder `.lime-panel` — zie de noot daar.
     Wat hier staat is alleen wat deze pagina in dat blok zet. */
  .pl-top { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: clamp(1.6rem, 3.2vw, 3rem); align-items: start; }
  @media (max-width: 60rem) { .pl-top { grid-template-columns: 1fr; } }

  /* ── DRIE KOPMATEN WERDEN ÉÉN — 31 AUGUSTUS 2026 ─────────────────────────
     Lucas: *"Ook is de abonnement pagina wat onoverzichtelijk."* Gemeten op
     1440px stonden er vijf verschillende kopmaten op deze pagina:

       64,0px  <h1>                          de paginakop
       57,6px  .pl-h  "What a plan actually is."
       52,8px  <h2>   "The three plans" / "And two things…"
