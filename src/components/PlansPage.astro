{/* ── HET SCRIPT VAN HET PLAN OP MAAT ────────────────────────────────────────
    Leest de tabel die bij het bouwen is uitgerekend (data-pm-data) en rekent
    zelf niets uit: prijs en losse waarde komen per aantal uit die tabel. Het
    echoot niets uit de URL. Zonder script blijft het formulier werken. */}
<script is:inline data-astro-rerun>
  (function () {
    var form = document.querySelector('[data-pm]');
    var bron = document.querySelector('[data-pm-data]');
    if (!form || !bron) return;
    var D;
    try { D = JSON.parse(bron.textContent || '{}'); } catch (e) { return; }
    var tekst = document.querySelector('[data-pm-tekst]');
    var invoer = form.querySelector('[data-pm-credits]');
    var schuif = form.querySelector('[data-pm-schuif]');
    /* Dezelfde vorm als euro() in pricing.js: "€1.170", "€6,58". */
    var euro = function (bedrag) {
      var centen = Math.round(bedrag * 100) % 100 !== 0;
      var delen = bedrag.toFixed(centen ? 2 : 0).split('.');
      var heel = delen[0].replace(/\B(?=(\d{3})+(?!\d))/g, D.sep[0]);
      return '€' + heel + (delen[1] ? D.sep[1] + delen[1] : '');
    };
    var fmt = { format: euro };
    var fmt2 = { format: euro };
    var uit = function (k) { return form.querySelector('[data-pm-out="' + k + '"]'); };
    var zet = function (k, v) { var el = uit(k); if (el) el.textContent = v; };
    var mix = {};

    function teken() {
      var ruw = parseInt(invoer.value, 10);
      var grens = form.querySelector('[data-pm-grens]');
      var contact = form.querySelector('[data-pm-contact]');
      var n = isNaN(ruw) ? D.min : ruw;
      var melding = '';
      if (n > D.max) { melding = tekst ? tekst.getAttribute('data-te-veel') : ''; n = D.max; }
      else if (n < D.min) { melding = tekst ? tekst.getAttribute('data-te-weinig') : ''; n = D.min; }
      if (grens) { grens.textContent = melding; grens.hidden = !melding; }
      if (contact) contact.hidden = !(ruw > D.max);
      if (schuif) schuif.value = String(Math.round(n / D.stap) * D.stap);
      var rij = D.tabel[n] || D.tabel[D.min];
      var prijs = rij[0], los = rij[1];
      zet('credits', String(n));
      zet('prijs', fmt.format(prijs));
      zet('per', fmt2.format(Math.round((prijs / n) * 100) / 100));
      var besp = form.querySelector('[data-pm-besp]');
      if (besp) {
        var s = los - prijs;
        besp.hidden = !(s > 0);
        zet('besp', fmt.format(s));
        zet('los', fmt.format(los));
      }
      D.diensten.forEach(function (d) {
        var el = form.querySelector('[data-pm-fit-n="' + d.id + '"]');
        if (el) el.textContent = String(Math.floor(n / d.credits));
      });
      var volgend = null;
      for (var i = 0; i < D.presets.length; i += 1) {
        if (D.presets[i].credits > n) { volgend = D.presets[i]; break; }
      }
      var pr = form.querySelector('[data-pm-preset]');
      if (pr) {
        pr.hidden = !volgend;
        if (volgend) {
          zet('preset-naam', volgend.naam);
          zet('preset-credits', String(volgend.credits));
          zet('preset-prijs', fmt.format(volgend.prijs));
        }
      }
    }

    function mixTotaal() {
      var tot = 0;
      D.diensten.forEach(function (d) { tot += (mix[d.id] || 0) * d.credits; });
      var el = form.querySelector('[data-pm-mix-tot]');
      if (el) el.textContent = String(tot);
      var knop = form.querySelector('[data-pm-mix-zet]');
      if (knop) knop.disabled = tot <= 0;
      return tot;
    }

    form.addEventListener('click', function (ev) {
      var t = ev.target.closest('button');
      if (!t || !form.contains(t)) return;
      if (t.hasAttribute('data-pm-stap')) {
        var n = parseInt(invoer.value, 10) || D.min;
        invoer.value = String(Math.min(D.max, Math.max(D.min, n + parseInt(t.getAttribute('data-pm-stap'), 10))));
        teken();
      } else if (t.hasAttribute('data-pm-mix')) {
        var id = t.getAttribute('data-pm-mix');
        mix[id] = Math.max(0, (mix[id] || 0) + parseInt(t.getAttribute('data-pm-mix-d'), 10));
        var o = form.querySelector('[data-pm-mix-n="' + id + '"]');
        if (o) o.textContent = String(mix[id]);
        mixTotaal();
      } else if (t.hasAttribute('data-pm-mix-zet')) {
        var tot = mixTotaal();
        if (tot > 0) { invoer.value = String(tot); teken(); invoer.focus(); }
      }
    });
    invoer.addEventListener('input', teken);
    if (schuif) {
      schuif.tabIndex = 0;
      schuif.addEventListener('input', function () { invoer.value = schuif.value; teken(); });
    }
    teken();
  })();
</script>

