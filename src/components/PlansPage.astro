---
/*
 * VISUAILS — /plans en /nl/plans: het abonnement als eigen pagina.
 *
 * ── WAAROM DEZE PAGINA BESTAAT — 20 augustus 2026 ──────────────────────────
 *
 * Lucas: *"Abonnementen zou ik wel graag echt een eigen pagina voor hebben dan
 * nu dat het slordig tussen de compare prices lijst staat. Het mag allemaal wel
 * wat meer gescheiden van elkaar zijn en maak de compare prices lijst dan heel
 * simpel met gewoon de prijzen en niet teveel informatie eromheen."*
 *
 * Hij heeft gelijk, en de reden is scherper dan "het staat er rommelig". Op
 * /pricing stonden TWEE prijsmodellen door elkaar: een staffel per product en
 * drie abonnementen. Dat zijn geen twee secties van hetzelfde onderwerp maar
 * twee manieren om te kopen, en een bezoeker die de tabel leest is nog aan het
 * uitrekenen wat één bestelling kost terwijl er onder diezelfde kop al drie
 * maandbedragen staan. Twee vragen tegelijk beantwoorden is geen van beide
 * beantwoorden.
 *
 * Nu: /pricing is de prijslijst en niets anders, /plans is het abonnement en
 * niets anders, en ze wijzen naar elkaar met één regel.
 *
 * ── DE LOOK KOMT VAN DE HOMEPAGE, EN LETTERLIJK ────────────────────────────
 *
 * Lucas in dezelfde adem: *"consistenter maken met de homepage look ... zodat
 * alles mooi consistent blijft en overloopt op elkaar."* Het limoen paneel dat
 * de homepage voor dit onderwerp gebruikt, staat sinds vandaag in global.css
 * als `.lime-panel` en wordt hier hergebruikt — niet nagebouwd. Zelfde blok,
 * zelfde licht, zelfde korrel, één definitie.
 *
 * ── GEEN GETAL IN DEZE COPY ────────────────────────────────────────────────
 *
 * Elk bedrag, elk aantal producten en elke levertijd komt uit plans() en
 * pricing.js. Wat hier staat is de zin eromheen. Dat is dezelfde regel als op
 * elke andere pagina en het is de reden dat een prijswijziging nergens een
 * vergeten string achterlaat.
 */
import Placeholder from './Placeholder.astro';
import {
  euro, vatLabel, plans, turnaround, AMOUNT,
  PLAN_AMOUNT, PLAN_PRODUCTS, PLAN_ROLLOVER_MONTHS,
  STOCK_OFF_BRAND, STOCK_ON_BRAND, TEST_SAMPLE, WINDOW_THRESHOLD,
  /* ── DE MAAND OP MAAT STOND HIER NIET, EN DRIE ANDERE PAGINA'S BELOOFDEN HEM ──
     4 september 2026. De homepage (PlanBand), /pricing en het bestelformulier
     noemen alle drie "of jouw maand op maat, vanaf N producten". Wie daarop
     klikte kwam hier en vond drie vaste pakketten en verder niets — een van de
     vier bezoekers in de doorloop van vandaag zei het letterlijk: *"ik klikte en
     vond drie vaste pakketten."* Dus staat hij hier nu ook, met hetzelfde
     minimum en hetzelfde bedrag als op die andere drie plekken: afgeleid uit
     customMonthTotal(), niet getypt. */
  CUSTOM_MONTH_MIN_PRODUCTS, CUSTOM_MONTH_MAX_PRODUCTS, customMonthTotal,
} from '../data/pricing.js';
import { planName } from '../data/planNames.js';
// Het juiste woord per soort beeld — zie de kop van lexicon.js.
import { noun } from '../data/lexicon.js';
import { localizedPath } from '../i18n/ui.js';
/* ── DE JAARTERMIJN STOND HIER NIET, EN DE VOORWAARDEN BELOOFDEN VAN WEL ─────
 * `terms.astro` zegt met zoveel woorden: *"…set out in full on our plans page.
 * The yearly term is priced there too."* Gecontroleerd in de gebouwde pagina: er
 * stond geen "12 maanden", geen tweede bedrag, geen termijn. Het enige plek waar
 * de jaarprijs bestond was /start/plan — achter de knop, dus pas nadat je hebt
 * gekozen. Een verwijzing in een bindend document naar een prijs die er niet
 * staat, is een van de twee die je echt niet wilt hebben (de andere is een prijs
 * die er wél staat en niet klopt). */
import { TERMS, monthlyCents } from '../data/plans.js';
import { waHref } from '../data/whatsapp.js';

import ServiceSwitch from './ServiceSwitch.astro';
import Note from './Note.astro';
import '../styles/stijl22.css';
const { lang = 'en' } = Astro.props;
const nl = lang === 'nl';
const lp = (p) => localizedPath(lang, p);

/* Het goedkoopste plan levert zowel het bedrag als het aantal producten, en
   die twee horen bij ELKAAR — los het laagste bedrag en het laagste aantal
   pakken werkt vandaag toevallig en gaat liegen zodra er een vierde plan komt
   met een ander verband. Zelfde afleiding als in HomeV2. */
const CHEAPEST = Object.keys(PLAN_AMOUNT).reduce((a, b) => (PLAN_AMOUNT[b] < PLAN_AMOUNT[a] ? b : a));
const FROM_AMOUNT = PLAN_AMOUNT[CHEAPEST];
const FROM_PRODUCTS = PLAN_PRODUCTS[CHEAPEST];

const JAAR_PRIJZEN = Object.fromEntries(
  Object.keys(PLAN_AMOUNT).map((id) => [id, monthlyCents(id, 'yearly') / 100])
);
const planList = plans(lang, { jaarRollover: TERMS.yearly.rollover, jaarPrijzen: JAAR_PRIJZEN });

/* De maand op maat — zie de noot bij de import. Het bedrag is wat een maand met
   het MINIMUM aantal producten kost, dus "vanaf". */
const maatNaam = planName('maat', lang);
const maatVanaf = euro(customMonthTotal({ products: CUSTOM_MONTH_MIN_PRODUCTS }).total, lang);
const maat = nl ? {
  /* Dezelfde formulering als PlanBand op de homepage: "Of jouw maand op maat". */
  h: `Of jouw ${maatNaam.toLowerCase()}`,
  body: `Past geen van de drie? Stel je maand zelf samen: jij kiest hoeveel catalogsets, carrousels en clips erin zitten, vanaf ${CUSTOM_MONTH_MIN_PRODUCTS} producten en tot ${CUSTOM_MONTH_MAX_PRODUCTS}. Dezelfde afspraken als hierboven — maandelijks opzegbaar, ongebruikte plekken schuiven een maand door.`,
  prijs: `Vanaf ${maatVanaf} per maand`,
  cta: 'Stel je maand samen',
} : {
  h: `Or your ${maatNaam.toLowerCase()}`,
  body: `None of the three fitting? Build the month yourself: you decide how many catalog sets, carousels and clips are in it, from ${CUSTOM_MONTH_MIN_PRODUCTS} products up to ${CUSTOM_MONTH_MAX_PRODUCTS}. Same terms as above — cancel monthly, unused slots roll over one month.`,
  prijs: `From ${maatVanaf} a month`,
  cta: 'Build your month',
};

/* De twee concepten die nog niet te bestellen zijn. Verhuisd van de homepage op
   30 augustus 2026 — zie de kop van src/data/binnenkort.js voor waarom ze hier
   zijn komen te staan en niet op twee eigen pagina's. */
import { binnenkort } from '../data/binnenkort.js';

const COPY = {
  en: {
    eyebrow: 'Subscription',
    h1a: 'The same studio, ',
    h1b: 'every month',
    h1c: '.',
    lead: 'A plan is not a bigger package. It is the same work on a standing arrangement: a fixed number of products every month, in a week the calendar keeps free for you, at a lower rate than ordering it one at a time.',

    panelH: ['What a plan', 'actually is.'],
    panelLede: 'Three things change when the work comes round every month instead of order by order. Nothing else does — the same studio, the same review, the same files.',
    facts: [
      'A fixed number of products each month, yours to spend as the collection needs.',
      'Your own week in the calendar, booked before anyone else can take it.',
      'A lower rate per product than the same output ordered separately.',
    ],
    from: 'from',
    unit: `a month · ${FROM_PRODUCTS} products`,
    cta: 'Start a plan',
    cta2: 'See the price per product',

    plansH: 'The three plans',
    plansSub: 'Same service on all three. What changes is how much of the month you book.',
    plansCta: 'Set up this plan',

    creditH: `${FROM_PRODUCTS} slots, not ${FROM_PRODUCTS} new products.`,
    // GESPLITST, 21 augustus 2026. Dit was één alinea van 55 woorden — de
    // langste van /plans. De twee zinnen die twijfel wegnemen ("je hoeft niets
    // nieuws te hebben" en "wat je niet gebruikt vervalt niet") staan er nog
    // gewoon; de opsomming van wát je erin kunt stoppen staat achter het
    // vraagteken, want dat is een voorbeeld en geen voorwaarde.
    creditBody: `A credit is a place in the month, not a demand that you have something new. What you do not use rolls over ${PLAN_ROLLOVER_MONTHS === 1 ? 'a' : PLAN_ROLLOVER_MONTHS} month${PLAN_ROLLOVER_MONTHS === 1 ? '' : 's'}.`,
    creditNoteTerm: 'a credit',
    creditNote: 'You decide each month what goes in it: a new item, an item you already sell in a different look for a campaign, or a set made for your socials.',
    /* ── HOE DE MAAND LOOPT — 4 september 2026 ──────────────────────────────
       Drie zinnen die elke reviewer miste: dat een abonnement een vaste week
       heeft ook onder tien producten (de uitzondering op "zo snel mogelijk"),
       dat de eerste maand meteen wordt afgeschreven, en waar je opzegt. */
    cycleBody: `Every plan — Starter too — has a fixed week in the month that is held for you; that is the difference with a one-off order under ${WINDOW_THRESHOLD} products, which runs as soon as possible. Your first month is charged when you set the plan up and the week is planned straight away. You cancel in your account, effective at the end of the running term; whatever is made stays yours.`,
    creditAsk: 'Not sure what to spend the rest on?',
    creditAskCta: 'Ask us and we will go through it with you',
    creditWa: 'Hi! I have a plan and I would like to think through what to spend this month’s credits on.',

    stockH: 'And a month that is already filled.',
    stockNow: [`${STOCK_OFF_BRAND} new ${noun('stock', 'en')} every month`, 'included with every plan, usable by any brand — something to post on the days you have no new product.'],
    stockSoon: [`${STOCK_ON_BRAND} on-brand ${noun('visual', 'en')} a month`, 'set up on your style, your locations and your brand colours, with no product in them — they give the brand a feeling rather than sell an item. They arrive with Editions and are set up once per brand.'],
    /* Zie de noot bij stockNowTag in HomeV2.astro: de gedeelde bibliotheek
       bestaat nog niet, en de regel stond hier net als daar zonder label
       tussen dingen die wél meekomen met een abonnement. */
    stockNowTag: 'Not running yet',
    stockSoonTag: 'With Editions',
    stockShot: 'A month grid of visuals for one brand — twenty frames in the same colours and light, with no product in them',
    stockShotMsg: 'Mood, texture, hands, light — no garment and no packshot. If it reads as a stock library it has failed; it has to read as one brand.',

    soonH: 'And two things that are on the way.',
    soonLede: 'Neither can be ordered yet, so there is no price and no button. What they are is written out here rather than announced with a date we cannot hold.',
    soonFoot: 'This is the concept as it stands. Pricing and ordering details are still being finalized, which is why booking is currently inactive.',
    soonTag: 'Not ready yet',

    outH: 'Not every month, then.',
    outBody: 'Order by order works too, and the rate falls as the count rises. The price per product is on the pricing page.',
    outCta: 'See the price per product',

    ctaH: 'Start with one product',
    ctaEm: `for ${euro(AMOUNT.testSample, "en")}.`,
    ctaBody: 'Send the photos you already have and see what comes back before any plan starts.',
    ctaSample: TEST_SAMPLE.en.cta,
    ctaPlan: 'Start a plan',
  },
  nl: {
    eyebrow: 'Abonnement',
    h1a: 'Dezelfde studio, ',
    h1b: 'elke maand',
    h1c: '.',
    lead: 'Een abonnement is geen groter pakket. Het is hetzelfde werk op een vaste afspraak: elke maand een vast aantal producten, in een week die de planning voor je vrijhoudt, tegen een lager tarief dan wanneer je het los bestelt.',

    panelH: ['Wat een abonnement', 'eigenlijk is.'],
    panelLede: 'Er veranderen drie dingen zodra het werk elke maand terugkomt in plaats van bestelling voor bestelling. Verder niets — dezelfde studio, dezelfde controle, dezelfde bestanden.',
    facts: [
      'Elke maand een vast aantal producten, te besteden zoals de collectie het vraagt.',
      'Je eigen week in de planning, vastgezet voordat iemand anders hem kan nemen.',
      'Een lager tarief per product dan hetzelfde werk los besteld.',
    ],
    from: 'vanaf',
    unit: `per maand · ${FROM_PRODUCTS} producten`,
    cta: 'Sluit een abonnement af',
    cta2: 'Bekijk de prijs per product',

    plansH: 'De drie abonnementen',
    plansSub: 'Dezelfde dienst bij alle drie. Wat verschilt is hoeveel van de maand je vastlegt.',
    plansCta: 'Dit abonnement opzetten',

    creditH: `${FROM_PRODUCTS} plekken, geen ${FROM_PRODUCTS} nieuwe producten.`,
    creditBody: `Een credit is een plek in de maand, niet de eis dat je iets nieuws hebt. Wat je niet gebruikt schuift ${PLAN_ROLLOVER_MONTHS === 1 ? 'een' : PLAN_ROLLOVER_MONTHS} maand door.`,
    /* Zie de noot bij de Engelse cycleBody. */
    cycleBody: `Elk abonnement — ook Starter — heeft een vaste week in de maand die voor jou wordt vrijgehouden; dat is het verschil met een losse bestelling onder ${WINDOW_THRESHOLD} producten, die zo snel mogelijk loopt. Je eerste maand wordt afgeschreven bij het afsluiten en de week staat meteen gepland. Opzeggen doe je in je account, per einde van de lopende termijn; wat al gemaakt is, blijft van jou.`,
    creditNoteTerm: 'een credit',
    creditNote: 'Jij bepaalt elke maand wat erin gaat: een nieuw item, een item dat je al verkoopt in een andere look voor een campagne, of een set die je voor je socials maakt.',
    creditAsk: 'Weet je niet waar je de rest aan besteedt?',
    creditAskCta: 'Vraag het ons, dan lopen we het samen door',
    creditWa: 'Hoi! Ik heb een abonnement en wil graag even doornemen waar ik de credits van deze maand aan kan besteden.',

    stockH: 'En een maand die al gevuld is.',
    stockNow: [`${STOCK_OFF_BRAND} nieuwe ${noun('stock', 'nl')} per maand`, 'inbegrepen bij elk abonnement en bruikbaar voor elk merk — iets om te posten op de dagen dat je niets nieuws hebt.'],
    stockSoon: [`${STOCK_ON_BRAND} on-brand ${noun('visual', 'nl')} per maand`, 'opgezet op jouw stijl, jouw locaties en jouw merkkleuren, zonder product erin — ze geven het merk een gevoel in plaats van dat ze iets verkopen. Ze komen met Editions en worden één keer per merk opgezet.'],
    stockNowTag: 'Nog niet actief',
    stockSoonTag: 'Met Editions',
    stockShot: 'Een maandraster van beelden voor één merk — twintig foto’s naast elkaar in dezelfde kleuren en hetzelfde licht, zonder product erin',
    stockShotMsg: 'Sfeer, textuur, handen, licht — geen kledingstuk en geen packshot. Leest het als een stockbibliotheek, dan is het mislukt; het moet als één merk lezen.',

    soonH: 'En twee dingen die eraan komen.',
    soonLede: 'Allebei nog niet te bestellen, dus er staat geen prijs bij en geen knop. Wat ze zijn staat hier uitgeschreven, in plaats van aangekondigd met een datum die we niet kunnen vasthouden.',
    soonFoot: 'Dit is het concept zoals het er nu voorstaat. Omdat we de tarieven en het bestelproces nog afronden, is deze service tijdelijk niet actief.',
    soonTag: 'Nog niet klaar',

    outH: 'Toch liever niet elke maand.',
    outBody: 'Los bestellen kan net zo goed, en het tarief daalt naarmate het aantal stijgt. De prijs per product staat op de prijzenpagina.',
    outCta: 'Bekijk de prijs per product',

    ctaH: 'Begin met één product',
    ctaEm: `voor ${euro(AMOUNT.testSample, "nl")}.`,
    ctaBody: 'Stuur de foto’s die je al hebt en zie wat eruit komt voordat er een abonnement begint.',
    ctaSample: TEST_SAMPLE.nl.cta,
    ctaPlan: 'Sluit een abonnement af',
  },
};
const c = COPY[nl ? 'nl' : 'en'];
---

{/* ═══ /plans IN DE STIJL VAN SECTIE 22 — 7 september 2026 ══════════════════
    Elfde pagina in de stijl. De inhoud is onaangeraakt: dezelfde COPY in beide
    talen, dezelfde drie abonnementen uit plans.js met hun jaartermijn, dezelfde
    maand op maat, dezelfde <Note> en <Placeholder>, dezelfde binnenkort-lijst
    met het anker #binnenkort waar het menu naar wijst.

    ── HET LIMEPANEEL IS EEN DONKERE KAMER GEWORDEN ─────────────────────────

    En dat lost meteen de fout op die Lucas op 7 september aanwees met een
    schermafdruk van deze pagina: *"Wel even altijd goed controleren op
    leesbaarheid. Hier gaat dat bijvoorbeeld fout."*

    Wat daar mis ging staat in de noot die hier stond, en het was geen
    schoonheidsfoutje: `.lime-panel` kreeg op 20 augustus een DONKERE foto als
    grond terwijl `.on-bright` — de scope die zegt "de grond is helder, draai de
    inktladder om" — er op de homepage wél af ging en hier niet. Vijftien
    tekstregels op 1,0 tot 1,04 : 1, waar 4,5 de eis is. Niet moeilijk leesbaar
    maar ONZICHTBAAR.

    De reparatie was toen het paneel in de inversielijst zetten. Nu is het een
    `.kamer`: één grond, één kleurenset, geen foto eronder en dus niets meer om
    half om te draaien. Het paneel dat de propositie draagt is daarmee ook de
    hoofdstukwissel van de pagina, en dat klopt — hier gaat het van "wat is dit"
    naar "welke neem ik". */}
<div class="s22">

  {/* ── 1 · DE OPENING ───────────────────────────────────────────────────── */}
  <section class="paneel" aria-labelledby="pl-h1">
    <header class="paneel-kop pl-kop">
      <p class="etiket">{c.eyebrow}</p>
      <h1 id="pl-h1" class="hoog">{c.h1a}<em>{c.h1b}</em>{c.h1c}</h1>
      <p class="lopend">{c.lead}</p>
    </header>
  </section>

  {/* ── 2 · WAT EEN ABONNEMENT IS ──────────────────────────────────────────
      De uitleg en het instapbedrag; de drie kaarten staan eronder in het licht.
      Zo is de kamer de UITLEG en zijn de kaarten de KEUZE — zet je ze allebei
      hier, dan is het weer één lange band met twee onderwerpen. */}
  <section class="kamer pl-kamer" aria-labelledby="pl-wat">
    <p class="spook spook-links" aria-hidden="true"><span>{c.eyebrow}</span><span>{c.eyebrow}</span></p>
    {/* ── DE PLAAT STAAT EERST IN DE BRON — 7 september 2026 ────────────────
        Gemeten op 390px: de eerste prijs stond op 1050px en de eerste knop op
        1128px, van een pagina van 9622px. Iemand die op de abonnementenpagina
        komt, komt voor het bedrag — en kreeg eerst 137 woorden.

        De plaat staat daarom vóór de uitleg in de HTML, en de twee kolommen
        hieronder worden op breed EXPLICIET geplaatst zodat de uitleg links
        blijft en de plaat rechts. Niet met `order`: dat laat de leesvolgorde
        (bron) en de kijkvolgorde (scherm) uit elkaar lopen, en op smal — waar
        het probleem zat — lopen ze dan juist verkeerd om. Zo klopt het op
        allebei: op smal is de bron de volgorde, op breed staan ze naast
        elkaar en is "bedrag, dan uitleg" een geldige leesvolgorde. */}
    <div class="pl-top">
      <div class="pl-plaat">
        <p class="pl-bedrag">
          <span class="mono">{c.from}</span>
          <span class="tarief pl-groot">{euro(FROM_AMOUNT, lang)}</span>
          <span class="mono">{c.unit}, {vatLabel('excl', lang)}</span>
        </p>
        <p class="acties">
          <a class="knop knop-wit" href={lp('/start/plan')}>{c.cta}</a>
          <a class="knop pl-knop-lijn" href={lp('/pricing')}>{c.cta2}</a>
        </p>
      </div>

      <div class="pl-uitleg">
        <h2 id="pl-wat" class="hoog hoog-2">{c.panelH[0]} <em>{c.panelH[1]}</em></h2>
        <p class="lopend">{c.panelLede}</p>
        <ul class="pl-vink" role="list">
          {c.facts.map((f) => <li>{f}</li>)}
        </ul>
        <ServiceSwitch current={['plan', 'complete']} lang={lang} class="pl-svcsw" />
      </div>
    </div>

    {/* De correctie op het getal, direct onder het getal dat hij corrigeert. */}
    <div class="pl-credit">
      <p class="etiket">{c.creditH}</p>
      <p class="lopend">{c.creditBody} <Note lang={lang} term={c.creditNoteTerm}>{c.creditNote}</Note></p>
      <p class="lopend">{c.cycleBody}</p>
      <p class="lopend pl-credit-vraag">
        {c.creditAsk} <a class="pijl pl-credit-a" href={waHref(c.creditWa)} target="_blank" rel="noopener">{c.creditAskCta}</a>
      </p>
    </div>
  </section>

  {/* ── 3 · DE DRIE ABONNEMENTEN ────────────────────────────────────────────
      De knop draagt ?plan= mee: zonder die parameter opent /start/plan altijd
      op Studio, en wie op de Merk-kaart klikte kwam op een machtiging voor het
      verkeerde bedrag. */}
  <section class="paneel" aria-labelledby="plans">
    <header class="paneel-kop">
      <h2 id="plans" class="hoog hoog-2">{c.plansH}</h2>
      <p class="lopend">{c.plansSub}</p>
    </header>

    <ul class="pl-kaarten" role="list">
      {planList.map((p) => (
        <li class="pl-kaart">
          {/* Hier stond `{c.eyebrow}` als etiket boven elke naam, en dat
              was drie keer hetzelfde woord ("Abonnement") boven drie
              abonnementen in een sectie die "De drie abonnementen" heet. Een
              etiket dat op elke kaart hetzelfde zegt, zegt niets. */}
          <h3 class="hoog hoog-3 pl-naam">{p.name}</h3>
          <p class="lopend pl-regel">{p.line}</p>

          <p class="pl-prijs">
            <span class="tarief pl-groot">{p.price}</span>
            <span class="mono">{p.unit}, {vatLabel('excl', lang)}</span>
            {/* Alleen als hij AFWIJKT, en dat is bij precies één plan zo. Bij
                Studio en Merk geeft de jaartermijn geen korting — zie
                discountMonths in plans.js — en twee keer hetzelfde bedrag naast
                elkaar laat de jaartermijn zinloos lijken terwijl hij dat niet
                is. Wat hij daar wél geeft, staat onderaan de kaart. */}
            {p.jaarPrijs && (
              <span class="mono pl-jaar">{nl ? `of ${p.jaarPrijs} op de jaartermijn` : `or ${p.jaarPrijs} on the 12-month term`}</span>
            )}
          </p>

          <ul class="pl-vink pl-vink-licht" role="list">
            {p.includes.map((f) => <li>{f}</li>)}
          </ul>

          {p.saving && (
            <p class="mono pl-besparing">{p.saving} ({vatLabel('excl', lang)})</p>
          )}

          <p class="pl-kaart-voet">
            <a href={`${lp('/start/plan')}?plan=${p.id}`} class="knop knop-inkt">{c.plansCta}</a>
          </p>
        </li>
      ))}
    </ul>

    {/* De vierde weg, en met opzet geen vierde kaart: hij heeft geen vaste
        inhoud en dus geen lijstje om af te vinken. Een regel onder de drie zegt
        wat hij is — de kaarten blijven de keuze, dit is de uitweg eronder. */}
    <div class="pl-maat">
      <div class="pl-maat-t">
        <h3 class="hoog hoog-3">{maat.h}</h3>
        <p class="lopend">{maat.body}</p>
      </div>
      <div class="pl-maat-a">
        <p class="pl-bedrag">
          <span class="tarief">{maat.prijs}</span>
          <span class="mono">{vatLabel('excl', lang)}</span>
        </p>
        <p class="acties">
          <a href={`${lp('/start/plan')}?plan=maat`} class="knop knop-inkt">{maat.cta}</a>
        </p>
      </div>
    </div>
  </section>

  {/* ── 4 · WAT ER NAAST DE BESTELLINGEN IN DE MAAND ZIT ─────────────────────
      Staat apart en niet in de kamer hierboven, omdat het geen eigenschap van
      het abonnement is maar iets dat ernaast geleverd wordt. */}
  <section class="paneel" aria-labelledby="pl-bank">
    <div class="pl-bank">
      <Placeholder
        lang={lang}
        ratio="4 / 3"
        caption={false}
        subject={c.stockShot}
        message={c.stockShotMsg}
      />
      <div class="pl-bank-t">
        <h2 id="pl-bank" class="hoog hoog-2">{c.stockH}</h2>
        <div class="pl-bank-item">
          <p class="pl-bank-n">{c.stockNow[0]} <span class="mono pl-tag">{c.stockNowTag}</span></p>
          <p class="lopend">{c.stockNow[1]}</p>
        </div>
        <div class="pl-bank-item is-later">
          <p class="pl-bank-n">{c.stockSoon[0]} <span class="mono pl-tag">{c.stockSoonTag}</span></p>
          <p class="lopend">{c.stockSoon[1]}</p>
        </div>
      </div>
    </div>
  </section>

  {/* ── 5 · HOOKS EN EDITIONS ───────────────────────────────────────────────
      HET ANKER IS EEN AFSPRAAK. In src/i18n/ui.js staan Hooks en Editions bij
      de diensten in het menu en die twee wijzen hierheen; verandert
      `#binnenkort`, dan verandert daar de href mee — tests/binnenkort.test.mjs
      legt de twee naast elkaar.

      Uitgeklapt en niet dichtgeklapt: wie doorklikt naar /plans#binnenkort
      heeft de vraag al gesteld, en die dan nog een keer laten klikken is een
      deur voor een deur. */}
  <section class="paneel" id="binnenkort" aria-labelledby="pl-soon">
    <header class="paneel-kop">
      <h2 id="pl-soon" class="hoog hoog-2">{c.soonH}</h2>
      <p class="lopend">{c.soonLede}</p>
    </header>
    <ul class="pl-soon-lijst" role="list">
      {binnenkort(lang).map((b) => (
        <li id={b.id}>
          <p class="pl-soon-n">{b.name} <span class="mono pl-tag">{c.soonTag}</span></p>
          <p class="lopend">{b.desc}</p>
          <dl class="pl-soon-dl">
            {b.qBody.map(([kop, tekst]) => (<Fragment><dt class="mono">{kop}</dt><dd class="lopend">{tekst}</dd></Fragment>))}
          </dl>
        </li>
      ))}
    </ul>
    <p class="lopend pl-soon-voet">{c.soonFoot}</p>
  </section>

  {/* ── 6 · DE UITGANG ───────────────────────────────────────────────────────
      Eén regel naar de prijslijst, en dat is de hele verbinding tussen de twee
      pagina's. Wie hier is en géén abonnement wil, hoort niet doodlopend te
      eindigen — en wie de staffel zoekt, hoort hem niet op deze pagina te
      vinden. */}
  <section class="paneel pl-uit" aria-labelledby="pl-out">
    <h2 id="pl-out" class="hoog hoog-3">{c.outH}</h2>
    <p class="lopend">{c.outBody}</p>
    <p class="acties"><a class="pijl" href={lp('/pricing')}>{c.outCta}</a></p>
  </section>

  {/* ── 7 · HET SLOT ─────────────────────────────────────────────────────── */}
  <section class="paneel paneel-slot" aria-labelledby="pl-slot">
    <h2 id="pl-slot" class="hoog">{c.ctaH}<br /><em>{c.ctaEm}</em></h2>
    <p class="lopend">{c.ctaBody}</p>
    <p class="acties">
      <a class="knop knop-inkt" href={lp('/test-sample')}>{c.ctaSample}</a>
      <a class="knop knop-lijn" href={lp('/start/plan')}>{c.ctaPlan}</a>
    </p>
  </section>
</div>

<style>
  .pl-kop { max-width: 46rem; margin-bottom: 0; }

  .pl-top { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, .85fr); gap: clamp(1.5rem, 5vw, 4rem); align-items: center; }
  /* Expliciet geplaatst, want in de bron staat de plaat eerst — zie de noot in
     de opmaak. Zonder deze twee regels zou de plaat in de linkerkolom landen. */
  .pl-uitleg { grid-column: 1; grid-row: 1; display: grid; gap: 1.1rem; justify-items: start; }
  .pl-plaat { grid-column: 2; grid-row: 1; }
  .pl-vink { display: grid; gap: .7rem; }
  .pl-vink li { position: relative; padding-left: 1.5rem; color: rgb(245 245 245 / .78); }
  .pl-vink li::before { content: "✓"; position: absolute; left: 0; color: var(--geel); }
  /* De lichte variant, voor de drie kaarten in een paneel. */
  .pl-vink-licht li { color: var(--inkt-2); }
  .pl-vink-licht li::before { color: var(--gloed, #9EB42F); }

  .pl-plaat { display: grid; gap: 1.4rem; justify-items: start; padding: clamp(1.5rem, 3.5vw, 2.4rem); border: 1px solid rgb(245 245 245 / .22); border-radius: calc(var(--ronding) - 8px); }
  .pl-bedrag { display: flex; flex-wrap: wrap; align-items: baseline; gap: .5rem; }
  .pl-groot { font-size: clamp(2rem, 4.5vw, 3.2rem); line-height: .95; }
  .pl-plaat .mono { color: rgb(245 245 245 / .66); }
  /* Een lijnknop op inkt: `.knop-lijn` zet inkt op inkt, want die is voor de
     lichte panelen gemaakt. Hier is de lijn en de letter het vel. */
  .pl-knop-lijn { color: var(--vel); }
  .pl-knop-lijn:hover { background: var(--vel); color: var(--inkt); }

  .pl-credit { display: grid; gap: .7rem; max-width: 46rem; margin-top: clamp(2.5rem, 5vw, 4rem); padding-top: clamp(1.6rem, 3vw, 2.4rem); border-top: 1px solid rgb(245 245 245 / .22); }
  .pl-credit .lopend { font-size: .92rem; }
  .pl-credit-vraag { display: flex; flex-wrap: wrap; align-items: baseline; gap: .5rem; }
  .pl-credit-a { color: var(--geel-letter); }

  /* De drie abonnementen. Geen kaartjes met een schaduw maar drie kolommen met
     een lijn erboven: het zijn drie versies van één ding, en een rand eromheen
     maakt er drie losse dingen van. */
  .pl-kaarten { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(1.2rem, 3vw, 2.5rem); }
  .pl-kaart { display: flex; flex-direction: column; gap: .6rem; padding-top: 1.2rem; border-top: 2px solid var(--inkt); }
