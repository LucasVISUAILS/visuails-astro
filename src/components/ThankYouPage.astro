---
/*
 * VISUAILS — de bevestigingspagina, gedeeld door /thank-you en /nl/thank-you.
 *
 * ── WAAROM DIT NU ÉÉN COMPONENT IS — 18 augustus 2026 ─────────────────────
 *
 * Het waren twee losse pagina's met dezelfde opbouw in twee talen. Dat is exact
 * de constructie die op /gallery al stilletjes uit elkaar is gelopen: de
 * Nederlandse versie kreeg een sectie die de Engelse niet heeft, en niemand die
 * het merkte. Twee bestanden die identiek moeten blijven, blijven dat niet.
 *
 * ── DE HERINDELING, EN WAAR HET MODEL VANDAAN KOMT ────────────────────────
 *
 * Lucas wees op Adobe’s bestelbevestiging. Wat die goed doet is niet de kleur
 * maar de INDELING: één balk die zegt dat het gelukt is, links één kaart met de
 * enige actie die telt, rechts een kolom met de feiten, en verder niets.
 *
 * Wat hier stond was één gecentreerde kolom met, onder elkaar: een eyebrow, een
 * kop, een lede, een betaalregel, een spamregel, een referentievak, een vraag
 * over hoe je ons vond, drie knoppen, een inlogregel, dan drie kaarten en dan
 * nog een kaart. Twaalf dingen die om beurten om aandacht vragen op het moment
 * dat iemand precies één vraag heeft: "en nu?"
 *
 * Alles is behouden. Niets is geschrapt — het is opnieuw ingedeeld naar wat het
 * DOET: de actie links, de feiten rechts, en de twee dingen die een gunst aan
 * ONS zijn (hoe vond je ons, extra foto’s) onderaan, waar een gunst hoort.
 *
 * ── ÉÉN <h1>, EN DIE ZIT IN DE BALK ───────────────────────────────────────
 *
 * De pagina had er twee: de bedanktekst en de annuleringskop, allebei een <h1>,
 * waarvan er altijd precies één zichtbaar is. Verdedigbaar en toch fout — een
 * validator telt ze allebei, en de twee kregen verschillende koptypografie, dus
 * de geannuleerde toestand had zichtbaar een andere paginatitel.
 *
 * Nu draagt de balk de <h1> en wisselt initThankYou() alleen de TEKST. Eén kop,
 * altijd, en de balk is er ook de natuurlijke plek voor: het is de zin die je
 * leest voordat je iets anders leest.
 */
import { waHref } from '../data/whatsapp.js';
/* AMOUNT erbij: de annuleringstekst noemt het teruggestorte bedrag van de
   proefvisual, en dat is een prijs — die hoort uit pricing.js te komen. */
import {
  TIERS, turnaround, AMOUNT, euro,
  /* Voor de abonnementsregel onderaan — zie PLAN_REGEL hieronder. */
  plans, planSaving, PLAN_AMOUNT, PLAN_PRODUCTS, PLAN_CLIPS, STOCK_OFF_BRAND,
  UPGRADE_TRIGGER_PRODUCTS,
} from '../data/pricing.js';
import { mailNote } from '../data/mailNote.js';
import { localizedPath } from '../i18n/ui.js';
import '../styles/stijl22.css';

interface Props { lang: 'en' | 'nl'; }
const { lang } = Astro.props;
const nl = lang === 'nl';
const lp = (p: string) => localizedPath(lang, p);

const T0 = TIERS.unattended;
const TIMING = turnaround('unattended', lang);

/*
 * ── DE ABONNEMENTSREGEL — 8 september 2026 ─────────────────────────────────
 *
 * Deze pagina zei niets over abonnementen. Iemand die net twintig producten
 * heeft besteld, stond op een scherm dat hem bedankte en verder niets vroeg,
 * terwijl de bevestigingsmail die een minuut later binnenkomt er via
 * upgradePrompt() wél over begint. Zie kladblok/VOORSTEL-D4-ABONNEMENTEN.md §4C.
 *
 * DEZELFDE DREMPEL ALS DE MAIL, en letterlijk dezelfde constante:
 * UPGRADE_TRIGGER_PRODUCTS. De mail telt een rollend kwartaal en deze pagina
 * kent alleen deze bestelling, dus de drempel is hier strenger — dat is de
 * goede kant om op te verschillen.
 *
 * TWEE VORMEN, OM DE REDEN DIE IN pipeline.js STAAT UITGESCHREVEN: een
 * abonnement levert `complete`, en tegen een CATALOGbestelling van hetzelfde
 * aantal is het duurder. Bij catalog staat er dus een regel zonder bedragen.
 * Allebei staan ze al in de HTML en interactions.js kiest er één — het aantal
 * en de soort komen uit sessionStorage en niet uit de adresbalk, om de reden
 * die in de kop van initThankYou() staat.
 */
const PLAN_ID = 'studio';
const PLAN_KAART = plans(lang).find((p) => p.id === PLAN_ID);
const PLAN_LADDER = planSaving(PLAN_ID);
const PLAN_DEKT = nl
  ? `${PLAN_PRODUCTS[PLAN_ID]} producten en ${PLAN_CLIPS[PLAN_ID]} clips`
  : `${PLAN_PRODUCTS[PLAN_ID]} products and ${PLAN_CLIPS[PLAN_ID]} clips`;
const PLAN_REGEL = nl ? {
  h: 'Elke maand hetzelfde nodig?',
  compare: `Het ${PLAN_KAART.name}-abonnement dekt ${PLAN_DEKT} per maand voor ${euro(PLAN_AMOUNT[PLAN_ID], 'nl')} — dezelfde levering los besteld is ${euro(PLAN_LADDER.onLadder, 'nl')}.`,
  steady: `Een abonnement legt het aantal vast en houdt een week in de planning voor je vrij, met ${STOCK_OFF_BRAND} Editions-beelden erbij.`,
  cta: 'Bekijk de abonnementen',
} : {
  h: 'Need the same every month?',
  compare: `The ${PLAN_KAART.name} plan covers ${PLAN_DEKT} a month for ${euro(PLAN_AMOUNT[PLAN_ID], 'en')} — the same delivery ordered one at a time is ${euro(PLAN_LADDER.onLadder, 'en')}.`,
  steady: `A plan fixes the count and holds a week in the calendar for you, with ${STOCK_OFF_BRAND} Editions visuals on top.`,
  cta: 'See the plans',
};

const c = nl ? {
  title: 'Bedankt — we hebben je aanvraag.',
  cancelled: 'Deze moesten we annuleren',
  nowH: 'Wat er nu gebeurt',
  payQ: 'Staat er een betaallink in je bevestigingsmail?',
  payA: 'Rond die betaling af — je bestelling staat genoteerd, maar de productie start pas als de betaling binnen is.',
  flow: 'Daarna lezen we wat je hebt gestuurd, maken we je visuals, en kijkt een specialist elk resultaat na voordat het bij jou komt.',
  cta: 'Bekijk je bestelling',
  signin: 'Log in met het e-mailadres van deze bestelling — we sturen je een link, er is geen wachtwoord.',
  sumH: 'Samenvatting',
  sumRef: 'Kenmerk',
  sumMail: 'Bevestiging verstuurd naar',
  sumTiming: 'Levertijd',
  sumQueue: T0.queue.nl,
  askH: 'Vragen?',
  wa: 'Stuur een WhatsApp',
  mail: 'Mail hello@visuails.com',
  guide: 'Lees hoe je aanlevert',
  guidePdf: 'Fotogids als pdf',
  extraH: 'Meer hoeken, nauwkeuriger resultaat',
  extraB: 'Hoe meer foto’s we hebben, hoe preciezer we pasvorm, kleur en detail de eerste keer raken. Een detailopname, de stof en een gedragen foto — gratis toe te voegen.',
  extraCta: 'Extra foto’s sturen',
  sourceQ: 'Nog één ding — hoe heb je ons gevonden?',
  cancelP1: `Uit onze administratie blijkt dat er al een proef naar je bedrijf is gegaan. Er is er één per bedrijf, dus deze tweede aanvraag is geannuleerd — en de ${euro(AMOUNT.testSample, "nl")} is onderweg terug naar de rekening waarvandaan je betaalde. Dat duurt meestal een paar werkdagen.`,
  cancelP2: 'Klopt dat niet — een collega bestelde zonder het te zeggen, of de eerste proef kwam nooit aan — reageer dan op de bevestigingsmail en we lossen het met de hand op.',
  cancelP3: 'Klaar voor het echte werk? De diensten beginnen bij de prijs per product, zonder minimum.',
  cancelCta: 'Bekijk de diensten',
} : {
  title: 'Thanks — we have your request.',
  cancelled: 'This one we had to cancel',
  nowH: 'What happens now',
  payQ: 'Is there a payment link in your confirmation email?',
  payA: 'Complete that payment — your order is noted, but production only starts once the payment has come through.',
  flow: 'After that we read what you sent, prepare your visuals, and a person checks every result before it reaches you.',
  cta: 'See your order',
  signin: 'Sign in with the email address on this order — we send you a link, there is no password.',
  sumH: 'Summary',
  sumRef: 'Reference',
  sumMail: 'Confirmation sent to',
  sumTiming: 'Turnaround',
  sumQueue: T0.queue.en,
  askH: 'Questions?',
  wa: 'Message us on WhatsApp',
  mail: 'Email hello@visuails.com',
  guide: 'Read the upload guidelines',
  guidePdf: 'Photo guide as pdf',
  extraH: 'More angles, a closer match',
  extraB: 'The more we have, the more accurately we match fit, colour and detail first time. A detail close-up, the fabric and an on-body shot — free to add.',
  extraCta: 'Send extra photos',
  sourceQ: 'One quick thing — how did you find us?',
  cancelP1: `Our records show a test sample already went out to your company. There is one per business, so this second request has been cancelled — and the ${euro(AMOUNT.testSample, "en")} is on its way back to the account you paid from. That usually takes a few working days.`,
  cancelP2: 'If that does not sound right — a colleague ordered without telling you, or the first sample never arrived — reply to the confirmation email and we will sort it out by hand.',
  cancelP3: 'Ready for the real thing? The services start at the per-product price, with no minimum order.',
  cancelCta: 'See the services',
};

const bronnen = nl
  ? [['Instagram', 'Instagram'], ['Google', 'Google'], ['Referral', 'Iemand vertelde het'], ['Other', 'Ergens anders']]
  : [['Instagram', 'Instagram'], ['Google', 'Google'], ['Referral', 'Someone told me'], ['Other', 'Somewhere else']];
---

{/* ── DE BALK ──────────────────────────────────────────────────────────────
    Volle breedte binnen de sectie-22-marge, gele vulling met inkt erop, en hij
    draagt de enige <h1> van de pagina. `data-ty-title` is waar interactions.js
    de tekst wisselt bij een annulering; `data-ty-title-cancelled` draagt het
    alternatief, zodat de tekst in dit bestand staat en niet in het script.

    ── WAAROM GEEL EN NIET LIME-MET-WIT — 7 september 2026 ───────────────────
    In de oude opmaak was dit `--accent` met `--accent-ink`, met de notitie dat
    wit op lime 1,31:1 meet en dus nooit klopt. In sectie 22 is dezelfde regel
    er nog steeds: het gele vlak draagt ALTIJD inkt, nooit vel. */}
<div class="s22 ty">

  <div class="ty-bar" data-ty-bar>
    <div class="ty-bar-in">
      <svg class="ty-check" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
      <h1 class="hoog hoog-2" data-ty-title data-ty-title-cancelled={c.cancelled}>{c.title}</h1>
    </div>
  </div>

  <section class="paneel ty-body">
    <div class="ty-grid">

      <div class="ty-main">
        {/* HET ANNULERINGSBLOK. Geen eigen kop meer — die zit in de balk. */}
        <div class="ty-cancelled" data-ty-cancelled role="status" tabindex="-1" hidden>
          <p class="lopend">{c.cancelP1}</p>
          <p class="lopend">{c.cancelP2}</p>
          <p class="lopend ty-cancelled-next">{c.cancelP3}</p>
          <p class="acties ty-act"><a class="knop knop-inkt" href={lp('/start')}>{c.cancelCta}</a></p>
        </div>

        <div class="ty-now ty-hide-when-cancelled">
          <h2 class="hoog hoog-3">{c.nowH}</h2>
          {/* De betaalregel. Voorwaardelijk geformuleerd, want het contactformulier,
              de checklist en de video-aanvraag landen hier ook en die hebben geen
              betaallink. Geen zijstreep: een gekleurde rand van 3px links is
              precies het soort accent dat deze codebase elders verbiedt. Een eigen
              vlak zegt hetzelfde zonder de streep.
              Sinds 3 september alleen als er een betaallink IS: initThankYou()
              zet hem aan bij ?pay=. Zonder link (contactformulier, checklist,
              terugkeer van Mollie) stond hier een vraag zonder antwoord. */}
          <p class="ty-pay" data-ty-payq hidden><strong>{c.payQ}</strong> {c.payA}</p>
          <p class="lopend">{c.flow}</p>
          <p class="acties ty-act"><a href={`/account?lang=${lang}`} class="knop knop-inkt">{c.cta}</a></p>
          <p class="ty-signin" data-ty-signin>{c.signin}</p>
        </div>
      </div>

      <aside class="ty-side ty-hide-when-cancelled">
        <h2 class="etiket ty-side-h">{c.sumH}</h2>
        {/* Gevuld door initThankYou() met het kenmerk uit ?ref. Blijft leeg en
            onzichtbaar als er geen geldig kenmerk is — wie hier op een andere manier
            belandt, krijgt gewoon geen kenmerkregel. */}
        {/* ── EEN ECHTE <dl> OM DE RIJEN ───────────────────────────────────────
            axe-core, 2 september 2026: "<dt> and <dd> elements must be contained by
            a <dl>". De rijen waren <div class="ty-row"> met een <dt> en een <dd>
            erin, en zonder <dl> eromheen is dat geen definitielijst maar twee
            elementen die toevallig zo heten — een schermlezer koppelt de term dan
            niet aan de omschrijving.

            De <div class="ty-row"> BLIJFT staan, want een <dl> mag een <div> om elk
            dt/dd-paar hebben en de hele opmaak hangt aan die klasse (.ty-row is de
            grid, de padding en de scheidingslijn). */}
        <dl class="ty-rows">
        <div class="ty-row" id="ty-summary" hidden>
          <dt>{c.sumRef}</dt><dd data-ty-ref></dd>
        </div>
        <div class="ty-row">
          <dt>{c.sumMail}</dt>
          {/* Het adres komt uit sessionStorage (pipeline.js zet het vlak voor de
              doorstuur); de spamnotitie stond hier ALLEEN, onder een kopje dat een
              adres beloofde. 3 september 2026. */}
          <dd><strong data-ty-mail></strong><span class="ty-mailnote">{mailNote(lang)}</span></dd>
        </div>
        <div class="ty-row">
          <dt>{c.sumTiming}</dt>
          <dd>{TIMING}. {c.sumQueue}</dd>
        </div>
        <div class="ty-row ty-row-ask">
          <dt>{c.askH}</dt>
          <dd>
            <a href={waHref(nl ? 'Hoi VISUAILS, ik heb net een aanvraag gedaan via de site.' : 'Hi VISUAILS, I just sent a request through the site.')} target="_blank" rel="noopener">{c.wa}</a><br />
            <a href="mailto:hello@visuails.com">{c.mail}</a><br />
            <a href={lp('/upload-guidelines')}>{c.guide}</a><br />
            {/* Het moment waarop iemand opstaat om de foto's te maken. De
                pagina lees je hier; de pdf gaat mee naar waar het product
                ligt. Zelfde bestand als op /upload-guidelines, /test-sample en
                de uploadstap. 7 september 2026. */}
            <a href={`/downloads/visuails-fotogids-${lang}.pdf`} download>{c.guidePdf}</a>
          </dd>
        </div>
        </dl>
      </aside>

    </div>
  </section>

  {/* ── DE TWEE GUNSTEN, ONDERAAN ──────────────────────────────────────────
      Extra foto's sturen helpt het resultaat, en de vraag hoe iemand ons vond
      helpt ALLEEN ons. Allebei horen ze na het antwoord op "en nu?" en niet
      ervoor. */}
  <section class="paneel ty-foot ty-hide-when-cancelled">
    <div class="ty-grid ty-grid-voet">
      <div class="ty-extra">
        <div>
          <h2 class="hoog hoog-3">{c.extraH}</h2>
          <p class="lopend">{c.extraB}</p>
        </div>
        <a href={waHref(nl ? 'Hoi VISUAILS, ik wil extra foto’s sturen voor mijn bestelling.' : 'Hi VISUAILS, I’d like to send extra photos for my order.')}
           class="knop knop-lijn" target="_blank" rel="noopener" data-track="ty-extra-photos">{c.extraCta}</a>
      </div>
      <div class="source-ask" data-source-ask>
        <span class="source-q">{c.sourceQ}</span>
        <div class="source-btns">
          {bronnen.map(([waarde, label]) => (
            <button type="button" class="source-btn" data-source={waarde}>{label}</button>
          ))}
        </div>
      </div>
    </div>

    {/* Verborgen tot interactions.js het aantal uit sessionStorage heeft
        gelezen. Blijft hij verborgen, dan mist de pagina niets — een
        bedankpagina die zonder opslag opent, is een bedankpagina. */}
    <p class="ty-plan" data-ty-plan data-ty-plan-min={String(UPGRADE_TRIGGER_PRODUCTS)} hidden>
      <b>{PLAN_REGEL.h}</b>
      <span data-ty-plan-compare hidden>{PLAN_REGEL.compare}</span>
      <span data-ty-plan-steady hidden>{PLAN_REGEL.steady}</span>
      <a class="ty-plan-a" href={lp('/plans')}>{PLAN_REGEL.cta}</a>
    </p>
  </section>

</div>

<style>
  /* ── DE BALK ─────────────────────────────────────────────────────────────
     Geel vlak met inkt erop, in dezelfde marge en ronding als een paneel, zodat
     hij bovenaan de pagina hetzelfde ritme heeft als alles eronder. */
  .ty-bar {
    margin: var(--rand) var(--rand) 0;
    padding: clamp(1.6rem, 4vw, 2.8rem) clamp(1.5rem, 5vw, 4rem);
    border-radius: var(--ronding);
    background: var(--geel);
    color: var(--inkt);
  }
  .ty-bar-in { display: flex; align-items: center; gap: clamp(.7rem, 2vw, 1.2rem); }
  .ty-bar h1 { margin: 0; color: var(--inkt); }
  .ty-check {
    width: clamp(26px, 4vw, 42px); height: clamp(26px, 4vw, 42px); flex: 0 0 auto;
    fill: none; stroke: var(--inkt); stroke-width: 2.5; stroke-linecap: round; stroke-linejoin: round;
  }
  /* Bij een annulering is er niets gelukt, dus verdwijnt de vulling en het vinkje.
     Geen rood: er is niets misgegaan en de klant heeft niets fout gedaan. */
  .ty-bar[data-ty-cancelled-state] { background: var(--vel); }
  .ty-bar[data-ty-cancelled-state] .ty-check { display: none; }

  /* Een bedankpagina hoeft niet de volle paneelhoogte van een verhaalpagina. */
  .ty-body { padding-block: clamp(2.2rem, 5vw, 4rem); }
  .ty-foot { padding-block: clamp(2rem, 4.5vw, 3.4rem); }
  /* Onder de twee gunsten, met een lijntje ertussen: het is een derde ding op
     een pagina die er twee had, en het hoort niet even hard te klinken. Geen
     kader, geen vlak — een zin met een link erachter. */
  .ty-plan {
    margin: clamp(1.6rem, 3vw, 2.2rem) 0 0;
    padding-top: clamp(1.2rem, 2.4vw, 1.6rem);
    border-top: 1px solid var(--lijn);
    font-size: .92rem;
    line-height: 1.6;
    color: var(--inkt-2);
    max-width: 68ch;
  }
  .ty-plan b { color: var(--inkt); font-weight: 500; margin-right: .3rem; }
  .ty-plan-a { margin-left: .4rem; color: inherit; text-decoration: underline; text-underline-offset: 3px; white-space: nowrap; }

  /* Actie links, feiten rechts. Onder de 880px vallen ze onder elkaar met de
     actie eerst, want dat is de volgorde waarin ze gelezen moeten worden. */
  .ty-grid { display: grid; gap: clamp(1.6rem, 4vw, 3rem); align-items: start; }
  @media (min-width: 880px) {
    .ty-grid { grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); }
    .ty-grid-voet { grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr); align-items: center; }
  }

  .ty-now h2, .ty-extra h2 { margin: 0 0 .9rem; }
  .ty-now p { margin: 0 0 .9rem; }
  .ty-pay {
    padding: 1rem 1.15rem; max-width: 34em;
    background: var(--wit); border: 1px solid var(--lijn);
    border-radius: calc(var(--ronding) - 14px);
    color: var(--inkt-2); text-wrap: pretty;
  }
  .ty-pay strong { color: var(--inkt); font-weight: 600; }
  .ty-act { margin: 1.4rem 0 0; }
  .ty-signin {
    margin: 1rem 0 0; max-width: 42em;
    font-family: var(--mono2); font-size: .75rem; font-stretch: 82%;
    line-height: 1.7; color: var(--inkt-2);
  }

  /* ── DE FEITENKOLOM ───────────────────────────────────────────────────── */
  .ty-side-h { margin: 0 0 .5rem; }
  .ty-rows { margin: 0; }
  .ty-row { padding: .95rem 0; border-bottom: 1px solid var(--lijn); display: grid; gap: .3rem; }
  .ty-row:last-child { border-bottom: 0; }
  .ty-row dt {
    margin: 0; font-family: var(--mono2); font-size: .75rem; font-stretch: 82%;
    letter-spacing: .04em; text-transform: uppercase; color: var(--inkt-2);
  }
  .ty-row dd { margin: 0; color: var(--inkt-2); font-size: .95rem; line-height: 1.6; }
  /* Onderstreping in de accentkleur, zoals overal in sectie 22: de letter blijft
     inkt (leesbaar), de kleur zit in de streep eronder. */
  .ty-row dd a {
    color: var(--inkt); text-decoration: underline; text-underline-offset: 3px;
    text-decoration-color: var(--geel); text-decoration-thickness: 2px;
  }
  .ty-row dd a:hover { text-decoration-color: var(--inkt); }
  .ty-row [data-ty-ref] {
    font-family: var(--mono2); font-stretch: 82%; letter-spacing: .04em;
    color: var(--inkt); font-size: 1rem;
  }
  .ty-mailnote { display: block; margin-top: .3rem; font-size: .85rem; color: var(--inkt-2); }
  [data-ty-mail]:not(:empty) { display: block; margin-bottom: .2rem; color: var(--inkt); font-weight: 600; }

  /* ── WAT initThankYou() BIJZET, EN WAAROM DIT `:global` MOET ──────────────
     Deze regels stonden hier ooit gewoon als `.ty-pay-cta`, en dat werkte niet.
     Astro maakt van een scoped selector `.ty-pay-cta[data-astro-cid-…]`, en dat
     attribuut zet hij op elementen die IN DEZE TEMPLATE staan. Dit blok wordt
     door src/scripts/interactions.js met createElement() gemaakt en draagt dat
     attribuut dus niet — de regels golden nooit ergens voor.

     De knop erin draagt sinds 7 september `knop knop-inkt` en niet meer
     `btn btn-primary`: hij landt in een paneel van sectie 22 en moet er dus
     uitzien als elke andere knop daar. Die klassen staan in stijl22.css, dus
     hieronder hoeft alleen de indeling eromheen te staan. */
  :global(.s22 .ty-pay-cta) { display: grid; gap: .8rem; margin: 1rem 0 0; justify-items: start; }
  :global(.s22 .ty-pay-cta span) { font-size: .92rem; line-height: 1.6; color: var(--inkt-2); }
  /* De bevestiging na een geslaagde betaling — zelfde herkomst, zelfde reden. */
  :global(.s22 .ty-paid-note) { margin: 1rem 0 0; font-size: .92rem; line-height: 1.6; color: var(--inkt-2); }

  /* ── DE TWEE GUNSTEN ──────────────────────────────────────────────────── */
  .ty-extra { display: grid; gap: 1.3rem; justify-items: start; }
  .ty-extra p { margin: 0; }
  @media (max-width: 560px) { .ty-extra .knop { width: 100%; justify-content: center; } }

  .source-q {
    display: block; margin-bottom: .9rem;
    font-family: var(--mono2); font-size: .75rem; font-stretch: 82%;
