---
// VISUAILS — FigPayback: the one claim on /pricing that a reader has to do
// arithmetic to believe.
//
// The sentence this replaces was `creditLine` in pricing.js: "€250 credited
// against each of your first 5 drops — the setup pays itself back." Every word
// of that is true and none of it is visible. A reader has to notice that 250
// times 5 is 1,250, that 1,250 is the setup price two lines above, and that the
// two therefore cancel. Three steps of mental arithmetic to reach a fact the
// page could simply show: the setup IS five credits, laid end to end.
//
// So the bar is the setup, cut into as many parts as it takes to repay it, and
// each part hands itself down to a drop. Nothing is claimed that is not drawn,
// and the drawn thing is the arithmetic.
//
// THE DIVISION IS DERIVED, NOT DECIDED. `steps` is BRAND_MODEL_CREDIT_DROPS,
// which pricing.js computes as brandModel / brandModelCredit. If either price
// moves, the number of cells moves with it and the drawing stays true by
// construction. That is the property worth having: a figure that can go stale
// silently is worse than a sentence, because a sentence at least reads as a
// claim somebody made. This one cannot disagree with the ladder — there is no
// number in this file to disagree with it, and there must never be one. If a
// future edit types a count here, delete it; the count belongs to the money.
//
// WHY THE CELLS ARE NOT NUMBERED, and why nothing counts down. A cell labelled
// "1st drop … 5th drop" would read as a schedule, and a bar that visibly
// shrinks left-to-right would read as a balance over time — both of which say
// something about WHEN, and /pricing is the page where task #190 retired every
// unsanctioned statement about when. The credits are equal because they are
// equal; the order they land in is not this figure's business. The reader is
// being shown a sum, not a timetable.
//
// All copy arrives as props from the calling page's bilingual COPY table, so
// check_lang_parity holds EN and NL in step on the words while the drawing
// itself stays language-free.
interface Props {
  totalLabel: string;
  total: string;
  credit: string;
  steps: number;
  runLabel: string;
  endLabel: string;
  note?: string;
}
const { totalLabel, total, credit, steps, runLabel, endLabel, note } = Astro.props;

// Built in the frontmatter rather than inline, for the reason recorded in
// FigCapacity: a computed expression inside the template is the shape that
// produced this repo's only build failure. Math.max(1, …) is not defensiveness
// about the data — pricing.js derives `steps` from two prices and cannot yield
// zero — it is about the ONE case that would render an empty bar with a full
// caption under it, which is a drawing that says the opposite of the truth.
const cells = Array.from({ length: Math.max(1, Math.round(steps)) }, (_, i) => i);
---

<figure class="pb">
  <div class="pb-row">
    <div class="pb-plate">
      <span class="pb-plate-k">{totalLabel}</span>
      <span class="pb-plate-v">{total}</span>
    </div>

    <div class="pb-main">
      <div class="pb-bar">
        {cells.map(() => <span class="pb-cell">{credit}</span>)}
      </div>
      <div class="pb-ticks" aria-hidden="true">
        {cells.map(() => <span class="pb-tick"></span>)}
      </div>
      <p class="pb-run">{runLabel}</p>
    </div>

    <p class="pb-end">{endLabel}</p>
  </div>
  {note && <figcaption class="pb-note">{note}</figcaption>}
</figure>

<style>
  .pb { margin: 0; }

  /* Three parts reading left to right — what it costs, what pays it off, and
     that it is then paid off. The order is the sentence, so on narrow screens
     the row stacks rather than wrapping: a wrapped "repaid" landing beside the
     setup price would put the ending next to the beginning. */
  .pb-row {
    display: flex;
    align-items: stretch;
    gap: clamp(.9rem, 2.4vw, 1.6rem);
  }
  @media (max-width: 720px) {
    .pb-row { flex-direction: column; align-items: stretch; }
  }

  /* The setup, stated once as a solid block: this is the whole of the thing
     the cells to the right are made out of. Bordered rather than filled — a
     filled plate would be the heaviest mark in the figure, and the heaviest
     mark should be the bar, which is what the reader is meant to count. */
  .pb-plate {
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: .3rem;
    padding: .8rem 1rem;
    border: 1px solid var(--ink);
  }
  .pb-plate-k { font-size: .72rem; color: var(--ink-3); line-height: 1.2; }
  .pb-plate-v {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.3rem, 2.4vw, 1.75rem);
    line-height: 1;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
  }

  .pb-main { flex: 1 1 auto; min-width: 0; display: flex; flex-direction: column; justify-content: center; }

  /* Equal columns, and equal is the claim: every credit is the same credit.
     grid rather than flex so a longer NL string cannot make one cell wider
     than its neighbours and turn "five equal parts" into a bar chart. */
  .pb-bar {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 1fr;
    border: 1px solid var(--ink);
  }
  .pb-cell {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 0;
    padding: .55rem .2rem;
    font-size: clamp(.66rem, 1.5vw, .82rem);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--ink);
    border-left: 1px solid var(--line-strong);
  }
  .pb-cell:first-child { border-left: 0; }

  /* One tick per cell, dropping out of the bar. This is the only part of the
     drawing that says the credits GO somewhere; without it the bar is a price
     divided up for no stated reason. Aligned by the same grid as the cells so
     a tick can never drift off the division it belongs to. */
  .pb-ticks {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 1fr;
    height: 12px;
  }
  .pb-tick {
    justify-self: center;
    width: 1px;
    background: var(--ink);
  }

  .pb-run {
    padding-top: .5rem;
    border-top: 1px solid var(--line-strong);
    font-size: .78rem;
    line-height: 1.35;
    color: var(--ink-2);
  }

  /* The end of the sentence, and deliberately the quietest mark here. It is a
     consequence, not an offer, and setting it at the weight of the setup price
     would make the figure look like it is selling the payback rather than
     showing it. */
  .pb-end {
    flex: 0 0 auto;
    align-self: center;
    max-width: 14ch;
    font-size: .8rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--ink);
  }
  @media (max-width: 720px) {
    .pb-end { max-width: none; }
  }

  .pb-note {
    margin-top: 1.3rem;
    padding-top: .8rem;
    border-top: 1px solid var(--line);
    font-size: .82rem;
    color: var(--ink-3);
    max-width: 62ch;
  }
</style>
