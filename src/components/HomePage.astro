<style>
  /* Everything this page needs that is not already sitewide furniture lives
     here rather than in global.css. The classes the removed sections used
     (.ticker, .svc-index/.idx-*, .set-strip/.sf-*, .plan-*) are stripped from
     global.css in the same pass — a homepage-only rule that outlives its
     markup is how a stylesheet gets to 1,000 lines. */

  /* ── Cover facts — the band the service ticker used to occupy. It inherits
     the dark scope from .hero-cover (global.css lists it in the .on-ink
     group). Task #271c, 2026-07-29: the Window (turnaround) and Review items
     now carry the same --flag/--verify rule global.css's .trust-item uses —
     a coloured border under the value only, never the text colour itself,
     because these raw (non -ink) tokens are documented as "large text and
     fills only" on this dark ground (DESIGN.md's contrast table: 4.12/4.33
     against --ink-900, a border passing the same non-text 3:1 bar). Studio
     (the third item) stays a plain role-token neutral — it isn't a review or
     delivery claim, so it gets no rule, same logic as every other page. */
  .cover-facts {
    border-top: 1px solid var(--line-strong);
    /* Harbor ink at 0.86, not the old ramp's 0.52. This bar sits on a
       photograph, so its ground is whatever the photograph happens to be
       under it — the alpha has to be chosen against the LIGHTEST pixel the
       image can put there, not against a comfortable one. At 0.52 the label
       row measured 1.58:1. At 0.86 the worst case tested (a #C9CAC7 sky) is
       5.06:1 for the muted label and 11.97:1 for the value. */
    background: rgb(var(--scrim) / 0.86);
  }
  .cf-row { display: grid; grid-template-columns: repeat(3, 1fr); margin: 0; padding-block: 1rem; }
  .cf-item { padding-inline: clamp(0rem, 1.4vw, 1.2rem); }
  .cf-item + .cf-item { border-left: 1px solid var(--line); }
  .cf-item:first-child { padding-left: 0; }
  .cf-k { font-size: .68rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--ink-3); }
  .cf-v { margin: .3rem 0 0; font-size: .86rem; line-height: 1.4; color: var(--ink); }
  .cf-item.tf-flag .cf-v,
  .cf-item.tf-verify .cf-v { display: inline-block; border-bottom: 3px solid; padding-bottom: .2rem; }
  .cf-item.tf-flag .cf-v { border-color: var(--flag); }
  .cf-item.tf-verify .cf-v { border-color: var(--verify); }
  @media (max-width: 700px) {
    .cf-row { grid-template-columns: 1fr; padding-block: .5rem; }
    .cf-item { padding: .55rem 0; }
    .cf-item + .cf-item { border-left: 0; border-top: 1px solid var(--line); }
  }

  /* ── The fitting room. One frame, three terms, and the small print set as
     the last thing inside the same border — not as a footnote outside it. */
  .fitting { border: 1px solid var(--line-strong); padding: clamp(1.6rem, 3.4vw, 3rem); }
  .fit-kicker { font-size: .72rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--ink-3); margin: 0; }
  .fit-h { font-family: var(--font-display); font-weight: 900; letter-spacing: -0.028em; line-height: 1.02;
    font-size: var(--t-h2); color: var(--ink); margin: .8rem 0 0; text-wrap: balance; max-width: 18ch; }
  .fitting .lead { margin-top: 1.1rem; max-width: 62ch; }
  .fit-points { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0; margin: clamp(2rem, 4vw, 2.8rem) 0 0;
    border-top: 1px solid var(--line-strong); }
  .fit-point { padding: 1.2rem clamp(0rem, 1.6vw, 1.4rem) 0; }
  .fit-point + .fit-point { border-left: 1px solid var(--line); }
  .fit-point:first-child { padding-left: 0; }
  .fit-point dt { font-family: var(--font-display); font-weight: 900; font-size: .92rem; letter-spacing: .06em;
    text-transform: uppercase; color: var(--ink); }
  .fit-point dd { margin: .45rem 0 0; font-size: .92rem; line-height: 1.55; color: var(--ink-2); }
  .fit-print { margin: clamp(1.8rem, 3.4vw, 2.4rem) 0 0; padding-top: 1.1rem; border-top: 1px solid var(--line);
    font-size: .84rem; line-height: 1.65; color: var(--ink-3); max-width: 92ch; }
  /* A step darker than the print it sits in, so the link reads as the one
     piece of that paragraph you can act on. Same treatment as .legal a. */
  .fit-print a { color: var(--ink-2); text-decoration: underline; text-underline-offset: 2px; }
  @media (max-width: 760px) {
    .fit-points { grid-template-columns: 1fr; }
    .fit-point { padding: 1.1rem 0 0; }
    .fit-point + .fit-point { border-left: 0; border-top: 1px solid var(--line); padding-top: 1.1rem; }
  }

  .dev-note { margin-top: .9rem; font-size: .82rem; color: var(--ink-3); }

  /* ── Drop or single product — task #268. Two tabs on a hairline, one panel
     of facts below, same grammar as .offer-facts so it reads as part of the
     same page rather than a bolted-on widget. The active tab is marked with
     a 2px underline in --accent, not a filled background — a filled "pill"
     tab is closer to a generic SaaS toggle than this system's flat, bordered
     furniture, and .btn-primary already owns solid-fill emphasis on this
     page. */
  .tier-toggle { border: 1px solid var(--line-strong); margin-top: clamp(2.2rem, 4.5vw, 3.2rem); }
  .tt-tabs { display: grid; grid-template-columns: 1fr 1fr; }
  .tt-tab { appearance: none; background: none; cursor: pointer; text-align: left; font-family: var(--font-display);
    font-weight: 900; font-size: clamp(1.02rem, 1.6vw, 1.22rem); letter-spacing: -0.01em; color: var(--ink-3);
    padding: clamp(1.1rem, 2vw, 1.5rem) clamp(1.2rem, 2.4vw, 1.8rem); border: none; border-bottom: 2px solid var(--line-strong);
    transition: color var(--dur-1) var(--ease), border-color var(--dur-1) var(--ease); }
  .tt-tab + .tt-tab { border-left: 1px solid var(--line-strong); }
  .tt-tab[aria-selected="true"] { color: var(--ink); border-bottom-color: var(--accent); }
  .tt-tab:hover { color: var(--ink); }
  .tt-panels { padding: clamp(1.6rem, 3vw, 2.4rem) clamp(1.2rem, 2.4vw, 1.8rem) clamp(.6rem, 1.4vw, 1rem); }
  .tt-panel { margin: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 0; }
  .tt-panel[hidden] { display: none; }
  .tt-row { padding-right: clamp(0rem, 1.6vw, 1.4rem); }
  .tt-row + .tt-row { border-left: 1px solid var(--line); padding-left: clamp(0rem, 1.6vw, 1.4rem); }
  .tt-row dt { font-family: var(--font-display); font-weight: 900; font-size: .8rem; letter-spacing: .06em;
    text-transform: uppercase; color: var(--ink-3); }
  .tt-row dd { margin: .5rem 0 0; font-size: .9rem; line-height: 1.5; color: var(--ink-2); }
  .tt-price dd { font-family: var(--font-display); font-weight: 800; font-size: clamp(1.4rem, 2.3vw, 1.8rem);
    letter-spacing: -0.02em; color: var(--ink); }
  .tt-price dd span { display: block; margin-top: .35rem; font-family: var(--font-body); font-weight: 400;
    font-size: .78rem; letter-spacing: normal; text-transform: none; color: var(--ink-3); }
  .tt-foot { margin: 0; padding: 0 clamp(1.2rem, 2.4vw, 1.8rem) clamp(1.3rem, 2.4vw, 1.7rem); font-size: .88rem; color: var(--ink-3); }
  @media (max-width: 820px) {
    .tt-tab { font-size: 1rem; padding: 1rem 1.1rem; }
    .tt-panels { padding: 1.4rem 1.1rem .4rem; }
    .tt-panel { grid-template-columns: 1fr; }
    .tt-row { padding: 1rem 0; }
    .tt-row:first-child { padding-top: 0; }
    .tt-row + .tt-row { border-left: 0; border-top: 1px solid var(--line); padding-left: 0; }
    .tt-foot { padding: 0 1.1rem 1.3rem; }
  }

  /* ── The offer. Three facts on a hairline rule, then two doors in one
     frame — the same construction as /start, so the two pages read as one
     argument rather than as two designs. */
  .offer-facts { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0; margin: clamp(2.4rem, 5vw, 3.6rem) 0 0;
    border-top: 1px solid var(--line-strong); }
  .of-item { padding: 1.3rem clamp(0rem, 1.8vw, 1.6rem) 0; }
  .of-item + .of-item { border-left: 1px solid var(--line); }
  .of-item:first-child { padding-left: 0; }
  .of-k { font-family: var(--font-display); font-weight: 900; font-size: .92rem; letter-spacing: .06em;
    text-transform: uppercase; color: var(--ink); }
  .of-v { margin: .5rem 0 0; font-size: .92rem; line-height: 1.55; color: var(--ink-2); }
  @media (max-width: 820px) {
    .offer-facts { grid-template-columns: 1fr; }
    .of-item { padding: 1.1rem 0 0; }
    .of-item + .of-item { border-left: 0; border-top: 1px solid var(--line); padding-top: 1.1rem; }
  }

  .doors2 { display: grid; grid-template-columns: 1fr 1fr; border: 1px solid var(--line-strong);
    margin-top: clamp(2.2rem, 4.5vw, 3.2rem); }
  .door2 { display: flex; flex-direction: column; padding: clamp(1.6rem, 3vw, 2.6rem); }
  .door2 + .door2 { border-left: 1px solid var(--line-strong); }
  .d2-name { font-family: var(--font-display); font-weight: 900; font-size: var(--t-h3); letter-spacing: -0.01em;
    color: var(--ink); margin: 0; }
  .d2-amount { font-family: var(--font-display); font-weight: 800; font-size: clamp(2rem, 3.4vw, 2.7rem);
    line-height: 1; letter-spacing: -0.03em; color: var(--ink); margin: .8rem 0 0; }
  .d2-basis { margin: .5rem 0 0; font-size: .78rem; font-weight: 700; letter-spacing: .06em;
