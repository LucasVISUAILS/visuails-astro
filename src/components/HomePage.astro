    caseSlot: 'Gereserveerd voor het volgende merk.',
    caseOffer: `<strong>De eerste drie merken, gratis.</strong> Een Drop Pilot — ${PILOT_PRODUCTS} producten, ${euro(AMOUNT.dropPilot, 'nl')} — kosteloos, in ruil voor toestemming om hem als één van deze drie te publiceren. Zodra de derde vol is, gaat dit eraf.`,
    caseCta: 'Vraag naar een plek',

    promiseEyebrow: 'Een nieuwe studio — dit is onze belofte',
    promiseH: ['Nog geen muur vol reviews.', 'Dus verdienen we het eerlijk.'],
    promiseQuote: `"Ik controleer elke visual zelf voordat hij bij je komt, en ik maak er liever één opnieuw dan dat ik hem zo lever. Nog niet zeker? Zie het eerst op je eigen product voor ${TEST_SAMPLE.nl.price}."`,
    promiseSign: 'oprichter, VISUAILS',
    promiseChecks: [
      [`Zie het eerst voor ${TEST_SAMPLE.nl.price}`, 'een proefvisual op je eigen product voordat je je ergens aan verbindt.'],
      ['We vragen het voordat we afronden', 'elke bestelling eindigt met dezelfde vraag: kloppen ze? Zo niet, dan nemen we het samen door.'],
      ['De eerste drie merken, gratis', 'een Drop Pilot kosteloos, in ruil voor een gepubliceerde case.'],
    ],
    trust: ['Gemaakt in Enschede, NL', 'KVK-geregistreerd bedrijf', reviewClaim('attended', 'nl'), 'Directe lijn via WhatsApp'],

    closeKicker: `Proefvisual · ${TEST_SAMPLE.nl.price}`,
    closeH: 'Zie het eerst op je eigen product.',
    closeSub: `Eén visual, gemaakt van jouw foto, met de hand gecontroleerd — voor een verificatie van ${TEST_SAMPLE.nl.price}. Eén per bedrijf.`,
    closeCta: 'Haal je proefvisual',
  },
};

const c = COPY[lang];

// The film strip: real output, no captions, no claims attached.
const strip = [
  '/img/lifestyle-flash-04.webp',
  '/img/lifestyle-dunes-01.webp',
  '/img/lifestyle-phone-made-05.webp',
  '/img/banners-12.webp',
  '/img/banners-02.webp',
];

const spreadImgs = [
  ['/img/custom-models-02.webp', '/catalog'],
  ['/img/catalog-after.webp', '/catalog'],
  ['/img/lifestyle-glow-01.webp', '/lifestyle'],
  ['/img/banners-16.webp', '/video'],
];

const dropImgs = [
  '/img/catalog-after.webp',
  '/img/lifestyle-glow-01.webp',
  '/img/banners-16.webp',
  '/img/custom-models-02.webp',
];
---

{/* ── COVER ─────────────────────────────────────────────────────────────────
    The H1 is untouched. The subline is the drop, and the service ticker that
    used to dock here is gone: it was a per-product menu in the hero, which
    section 13 rules out twice over. In its place, three facts that are true
    before anyone talks to us — all three read out of pricing.js. */}
<section class="hero-cover">
  <div class="hc2-bg"><img src="/img/hero-dunes.webp" alt={c.heroAlt} fetchpriority="high" transition:name="hero-photo" /></div>
  <div class="hc2-scrim" aria-hidden="true"></div>
  <div class="container cover-inner">
    <div class="cover-copy">
      <h1 class="cover-title">{c.h1.map((l, i) => (
        <span class="ch-l">{i === c.h1.length - 1 ? <em>{l}</em> : l}</span>
      ))}</h1>
      <p class="cover-sub">{c.coverSub}</p>
      <div class="cover-cta">
        <a href={lp('/start')} class="btn btn-primary btn-lg">{c.ctaStart}</a>
        <a href={lp('/test-sample')} class="btn btn-ghost btn-lg">{c.ctaSample}</a>
      </div>
    </div>
  </div>
  <div class="cover-facts">
    <dl class="container cf-row">
      {c.coverFacts.map(([k, v]) => (
        <div class="cf-item"><dt class="cf-k">{k}</dt><dd class="cf-v">{v}</dd></div>
      ))}
    </dl>
  </div>
</section>

{/* ── STATEMENT ─────────────────────────────────────────────────────────── */}
<section class="section-tight">
  <div class="container intro-split">
    <p class="editorial-statement reveal pending" set:html={c.statement} />
    <div class="mini-benefits reveal pending">
      <div class="mini-benefit">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="butt" stroke-linejoin="miter"><rect x="3" y="5" width="18" height="16" /><path d="M3 10h18M8 3v4M16 3v4" /></svg>
        <div><strong>{c.benefits[0][0]}</strong><span>{c.benefits[0][1]}</span></div>
      </div>
      <div class="mini-benefit">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="butt" stroke-linejoin="miter"><path d="M20 6L9 17l-5-5" /></svg>
        <div><strong>{c.benefits[1][0]}</strong><span>{c.benefits[1][1]}</span></div>
      </div>
      <div class="mini-benefit">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="butt" stroke-linejoin="miter"><path d="M3 7l9-4 9 4-9 4-9-4zM3 7v10l9 4 9-4V7" /></svg>
        <div><strong>{c.benefits[2][0]}</strong><span>{c.benefits[2][1]}</span></div>
      </div>
    </div>
  </div>
</section>

{/* ── THE PHOTO IS THE FITTING ROOM ─────────────────────────────────────────
    High on the page, per the brief, and carrying the small print. The print
    is not a disclaimer bolted to the bottom of a page — it is the argument.
    A studio that says out loud what its images are is the one you can trust
    with the fit. It states what we make and how we make it; it does not say
    what any of that satisfies in law — no page on this site does, and /ai-act
    refuses that claim in as many words. The link is a trailing line rather
    than an anchor inside the paragraph: a reader satisfied by the print stops
    where the print stops, and one who wants the long version has somewhere to
    go. It is a link, not a warning. */}
<section class="section-tight">
  <div class="container fitting reveal pending">
    <p class="fit-kicker">{c.fitKicker}</p>
    <h2 class="fit-h">{c.fitH}</h2>
    <p class="lead">{c.fitBody}</p>
    <dl class="fit-points">
      {c.fitPoints.map(([k, v]) => (
        <div class="fit-point"><dt>{k}</dt><dd>{v}</dd></div>
      ))}
    </dl>
    <p class="fit-print">{c.fitPrint} <a href={lp('/ai-act')}>{c.fitPrintLink}</a></p>
  </div>
</section>

{/* ── DEVELOP ───────────────────────────────────────────────────────────────
    On desktop, motion.js pins this section and scroll itself develops the
    photo (scrubbing the Compare's --cmp-pos); the slider stays draggable
    after. Mobile / no-JS: the auto comparison. */}
<section class="section-tight" id="develop">
  <div class="container two-col">
    <div class="reveal pending">
      <h2>{c.devH[0]} <em>{c.devH[1]}</em></h2>
      <p class="lead" style="margin-top:1rem">{c.devLead}</p>
      <div class="dev-steps" aria-hidden="true">
        {c.devSteps.map((s, i) => (
          <p class="dev-step"><span class="dn">{String(i + 1).padStart(2, '0')}</span>{s}</p>
        ))}
      </div>
      <div class="flex" style="margin-top:1.6rem">
        <a href={lp('/test-sample')} class="btn btn-primary">{c.devCta}</a>
        <a href={WA} class="btn btn-wa" target="_blank" rel="noopener">
          <svg class="i" viewBox="0 0 24 24"><path d="M21 11.5a8.38 8.38 0 0 1-8.5 8.5 8.5 8.5 0 0 1-4-1L3 20l1.5-4.5A8.38 8.38 0 0 1 3.5 11 8.5 8.5 0 0 1 12 3a8.38 8.38 0 0 1 8.5 8.5z" /></svg>
          {c.devWa}
        </a>
      </div>
      <p class="dev-note">{c.devNote}</p>
    </div>
    <div class="reveal pending">
      <Compare
        before="/img/catalog-before.webp"
        after="/img/catalog-after.webp"
        ratio="1/1"
        objectPosition="50% 62%"
        beforeLabel={c.cmpBefore}
        afterLabel={c.cmpAfter}
        beforeAlt={c.cmpBeforeAlt}
        afterAlt={c.cmpAfterAlt}
      />
    </div>
  </div>
</section>

{/* ── THE SPREAD ────────────────────────────────────────────────────────────
    Proof at scale. The captions used to carry the per-product price list;
    they now say where each visual lives, which is the more useful half of
    what they were doing anyway.

    The slot class below is written out in full rather than assembled as
    `sp-${...}`: .sp-a–.sp-d are grid-placement rules in global.css, and a
    class glued together from fragments is not greppable — a deleted rule
    would go unnoticed by both a reader and the dead-CSS check. Four whole
    strings cost nothing and stay findable.

    That note lived inside the .map() body until the first compile, which it
    killed. A brace-wrapped block comment is a comment only as a CHILD OF
    MARKUP; in the parenthesised body of an arrow function the context is
    already JavaScript, so Astro emitted the braces verbatim and esbuild read
    an empty object literal followed by a tagged template — "Expected ) but
    found $render". It is up here because up here is markup. */}
<section class="ch">
  <div class="container">
    <div class="ch-head">
      <h2 class="ch-title"><span class="ch-l">{c.spreadH[0]}</span><span class="ch-l dim">{c.spreadH[1]}</span></h2>
    </div>
    <div class="spread" data-spread>
      {spreadImgs.map(([img, href], i) => (
        <a class={['sp-item sp-a', 'sp-item sp-b', 'sp-item sp-c', 'sp-item sp-d'][i]} href={lp(href)}>
          <div class="sp-media" data-zoom>
            <img src={img} alt={`${c.spreadCaps[i][0]} — ${c.spreadCaps[i][1]}`} loading="lazy" />
            {i === 3 && <span class="sp-play" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z" /></svg></span>}
          </div>
          <div class="sp-cap"><b>{c.spreadCaps[i][0]}</b><span>{c.spreadCaps[i][1]}</span></div>
        </a>
      ))}
    </div>
  </div>
</section>

{/* ── THE OFFER ─────────────────────────────────────────────────────────────
    This block replaces the services ledger. The ledger sold photos by the
    unit and had to print three per-product prices to do it; this sells the
    drop, so it prints two. Every figure and every promise comes out of
    pricing.js — including the queue sentence, which is the one line that
    tells a Tier 0 customer the truth about what a drop outranks. */}
<section class="ch">
  <div class="container">
    <div class="ch-head">
      <h2 class="ch-title"><span class="ch-l">{c.offerH[0]}</span><span class="ch-l dim">{c.offerH[1]}</span></h2>
      <p class="ch-sub">{c.offerSub}</p>
    </div>

    <dl class="offer-facts reveal-group">
      {c.offerFacts.map(([k, v]) => (
        <div class="of-item reveal pending"><dt class="of-k">{k}</dt><dd class="of-v">{v}</dd></div>
      ))}
    </dl>

    <div class="doors2">
      <div class="door2">
        <h3 class="d2-name">{c.doorPilot}</h3>
        <p class="d2-amount">{euro(AMOUNT.dropPilot, lang)}</p>
        <p class="d2-basis">{c.doorPilotBasis}</p>
        <p class="d2-line">{c.doorPilotLine}</p>
        <a href={lp('/start')} class="btn btn-ghost">{c.doorCta}</a>
      </div>
      <div class="door2">
        <h3 class="d2-name">{c.doorFull}</h3>
        <p class="d2-amount">{euro(AMOUNT.fullDrop, lang)}</p>
        <p class="d2-basis">{c.doorFullBasis}</p>
        <p class="d2-line">{c.doorFullLine}</p>
        <a href={lp('/start')} class="btn btn-primary">{c.doorCta}</a>
      </div>
    </div>

    <p class="offer-foot">{c.offerFoot} <a class="link-arrow" href={lp('/pricing')}>{c.offerFootLink} &rarr;</a></p>
  </div>
</section>

{/* ── THE ANCHOR ────────────────────────────────────────────────────────────
    What used to be here was a two-panel "generic AI tool vs VISUAILS", with
    the left panel filled by an image we generated ourselves to look bad. It
    is gone. A comparison you author both sides of is not a comparison, and
    the brief's own standard — never invent results — does not stop applying
    because the invented result belongs to someone else.
    What replaces it is the alternative a real customer is actually weighing:
    a production day, itemised so the number is checkable rather than asserted
    (AUDIT-TASK-0.md §H·2). */}
<section class="section-tight">
  <div class="container">
    <div class="section-head" style="text-align:center;margin-inline:auto">
      <p class="ch-kicker">{c.anchorKicker}</p>
      <h2>{c.anchorH}</h2>
      <p style="margin-inline:auto">{c.anchorSub}</p>
    </div>
    <div class="anchor2 reveal pending">
      <div class="an-col">
        <h3 class="an-name">{c.anchorShoot}</h3>
        <p class="an-amount">{shoot.range}</p>
        <p class="an-basis">{c.anchorShootBasis}</p>
        <ul class="an-items">{shoot.items.map((it) => (<li>{it}</li>))}</ul>
        <p class="an-caveat">{shoot.caveat}</p>
      </div>
      <div class="an-rule" aria-hidden="true"></div>
      <div class="an-col an-ours">
        <h3 class="an-name">{c.anchorDrop}</h3>
        <p class="an-amount">{euro(AMOUNT.fullDrop, lang)}</p>
        <p class="an-basis">{c.anchorDropBasis}</p>
        <ul class="an-items">{c.anchorDropItems.map((it) => (<li>{it}</li>))}</ul>
        <p class="an-caveat">{c.anchorNote}</p>
      </div>
    </div>
  </div>
</section>

{/* ── PROCESS ───────────────────────────────────────────────────────────────
    Step 02 is the whole reposition in one paragraph: the calendar is checked
    before a date exists. The brief's hardest constraint — never promise a
    delivery date the capacity gate has not cleared — is a promise this page
    has to make in words before /start makes it in code. */}
<section class="ch">
  <div class="container">
    <div class="ed-head">
      <span class="ed-meta">{c.processMeta}</span>
      <div>
        <h2>{c.processH}</h2>
        <p class="ed-sub">{c.processSub}</p>
      </div>
    </div>
    <div class="process" data-stagger>
      {c.processSteps.map(([t, b], i) => (
        <div class="pr-step">
          <span class="pr-num">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="pr-t">{t}</h3>
          <p class="pr-b">{b}</p>
        </div>
      ))}
    </div>
  </div>
</section>

{/* ── FILM STRIP ────────────────────────────────────────────────────────── */}
<section class="section-tight">
  <div class="visual-marquee">
    <div class="vm-row">
      <img src={strip[0]} alt="Flash-style lifestyle visual" loading="lazy" />
      <img src={strip[1]} alt="Dunes-style lifestyle visual" loading="lazy" />
      <img src="/img/banners-09.webp" alt="Campaign visual" loading="lazy" />
      <img src={strip[2]} alt="Phone-made-style lifestyle visual" loading="lazy" />
      <img src={strip[0]} alt="" aria-hidden="true" loading="lazy" />
      <img src={strip[1]} alt="" aria-hidden="true" loading="lazy" />
      <img src="/img/banners-09.webp" alt="" aria-hidden="true" loading="lazy" />
      <img src={strip[2]} alt="" aria-hidden="true" loading="lazy" />
    </div>
    <div class="vm-row">
      <img src={strip[3]} alt="Campaign photography" loading="lazy" />
      <img src="/img/lifestyle-glow-05.webp" alt="Glow-style lifestyle visual" loading="lazy" />
      <img src={strip[4]} alt="Campaign photography" loading="lazy" />
      <img src="/img/lifestyle-flash-07.webp" alt="Flash-style lifestyle visual" loading="lazy" />
      <img src={strip[3]} alt="" aria-hidden="true" loading="lazy" />
      <img src="/img/lifestyle-glow-05.webp" alt="" aria-hidden="true" loading="lazy" />
      <img src={strip[4]} alt="" aria-hidden="true" loading="lazy" />
      <img src="/img/lifestyle-flash-07.webp" alt="" aria-hidden="true" loading="lazy" />
    </div>
  </div>
</section>

{/* ── QUALITY ───────────────────────────────────────────────────────────── */}
<section class="section-tight">
  <div class="container">
    <div class="ed-head" style="margin-bottom:clamp(2.4rem,4.5vw,3.6rem)">
      <span class="ed-meta">{c.qualityMeta}</span>
      <div>
        <h2 set:html={c.qualityH} />
        <p class="ed-sub">{c.qualitySub}</p>
      </div>
    </div>
    <div class="req-grid reveal-group">
      {c.reqs.map(([t, b], i) => (
        <div class="req-card reveal pending">
          <span class="rc-num">{String(i + 1).padStart(2, '0')}</span>
          <h4>{t}</h4>
          <p>{b}</p>
        </div>
      ))}
    </div>
    <p class="req-note reveal pending" set:html={c.reqNote} />
  </div>
</section>

{/* ── LEAD MAGNET ───────────────────────────────────────────────────────── */}
<section class="section-tight">
  <div class="container">
    <div class="lead-magnet reveal pending">
      <div class="lm-copy">
        <span class="lm-kicker">{c.lmKicker}</span>
        <h2>{c.lmH}</h2>
        <ul class="lm-list">{c.lmList.map((l) => (<li>{l}</li>))}</ul>
      </div>
      <form class="lm-form" action="/api/order" method="post">
        <input type="hidden" name="service" value="subscribe" />
        <input type="hidden" name="redirect" value={lp('/thank-you')} />
        <input type="hidden" name="lang" value={lang} />
        <input type="text" name="company_hp" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0" />
        <input type="hidden" name="subscribe" value="briefing-checklist" />
        <label class="lm-label" for="lm-email">{c.lmLabel}</label>
        <div class="lm-row">
          <input id="lm-email" type="email" name="email" required placeholder={c.lmPlaceholder} autocomplete="email" />
          <button type="submit" class="btn btn-primary" data-track="lead-magnet">{c.lmButton}</button>
        </div>
        <p class="lm-fine">{c.lmFine}</p>
      </form>
    </div>
  </div>
</section>

{/* ── YOUR BRAND MODEL ──────────────────────────────────────────────────────
    Promoted above the channel grid and rewritten to the drop. The link goes
    to /custom-models, which is the surviving URL of the two model pages
    (AUDIT-TASK-0.md §H·8). /models is deleted and 301s there, both
    languages, in public/_redirects. */}
<section class="section-tight">
  <div class="container">
    <div class="photo-split reveal pending">
      <div class="photo-split-media" data-zoom>
        <img src="/img/custom-models-02.webp" alt={c.modelsAlt} loading="lazy" />
      </div>
      <div>
        <h2>{c.modelsH[0]}<br /><em>{c.modelsH[1]}</em></h2>
        <p class="lead" style="margin-top:1rem">{c.modelsLead}</p>
        <div style="margin-top:1.2rem"><a class="link-arrow" href={lp('/custom-models')}>{c.modelsCta} &rarr;</a></div>
      </div>
    </div>
  </div>
</section>

{/* ── INSIDE A DROP ─────────────────────────────────────────────────────────
    The protected heading, over the channel grid, demoted below the models
    section and reframed as the contents of a drop. This is where the ledger
    accordion used to sit; what it lost was four prices and four links into
    order pages that no longer exist. The footnote states plainly which of
    the four are actually in a drop, because DROP_INCLUDES says catalog and
    lifestyle and a page that implied otherwise would be selling air. */}
<section class="section-tight">
  <div class="container">
    <div class="ed-head">
      <span class="ed-meta">{c.dropMeta}</span>
      <div>
        <h2>{c.dropH}</h2>
        <p class="ed-sub">{c.dropSub}</p>
      </div>
    </div>
    <div class="anatomy" data-stagger>
      {c.dropCards.map(([where, name, body, href], i) => (
        <a class="anat-card" href={lp(href)}>
          <div class="anat-media" data-zoom><img src={dropImgs[i]} alt={`${name} — ${where}`} loading="lazy" /></div>
          <div class="anat-body"><span class="anat-where">{where}</span><h3>{name}</h3><p>{body}</p></div>
        </a>
      ))}
    </div>
    <p class="anat-note reveal pending">{c.dropNote}</p>
  </div>
</section>

{/* ── CASE STUDIES, OPEN ────────────────────────────────────────────────────
    Three empty slots that have to read as an open offer rather than as a
    hole where proof should be. The brief forbids inventing testimonials,
    client names, logos, metrics or results, so the section says out loud
    that there are none yet and what it will take to fill it. This is also
    where the founding offer lives, scoped to a Drop Pilot rather than to a
    Full Drop (AUDIT-TASK-0.md §H·3: unscoped, it gave away up to €5,550 and
    made the €0.99 sample the weaker of two offers on the same page). */}
<section class="section-tight">
  <div class="container">
    <div class="ed-head">
      <span class="ed-meta">{c.caseMeta}</span>
      <div>
        <h2>{c.caseH}</h2>
        <p class="ed-sub">{c.caseSub}</p>
      </div>
    </div>
    <ol class="case-slots" data-stagger>
      {[0, 1, 2].map((i) => (
        <li class="case-slot">
          <span class="cs-n">{String(i + 1).padStart(2, '0')}</span>
          <span class="cs-state">{c.caseState}</span>
          <p class="cs-body">{c.caseSlot}</p>
        </li>
      ))}
    </ol>
    <div class="case-offer reveal pending">
      <p set:html={c.caseOffer} />
      <a href={lp('/contact')} class="btn btn-primary">{c.caseCta}</a>
    </div>
  </div>
</section>

{/* ── THE PROMISE ───────────────────────────────────────────────────────────
    Lit by the WebGL chrome field; .hero-fallback carries the same scene when
    the shader never initialises. Both are section 3's work — see global.css.
    Two lines moved: the unbounded revision promise became the check-in that
    ends every order, and the founding-perks line became the free pilot. */}
<section class="ch ch-promise">
  <div class="hero-fallback" aria-hidden="true"></div>
  <canvas id="hero-shader" aria-hidden="true"></canvas>
  <div class="container">
    <div class="promise-split">
      <div class="reveal pending">
        <span class="promise-eyebrow">{c.promiseEyebrow}</span>
        <h2 class="ch-title" style="text-align:left"><span class="ch-l">{c.promiseH[0]}</span><span class="ch-l dim">{c.promiseH[1]}</span></h2>
        <p class="promise-quote" style="margin-top:1.4rem">{c.promiseQuote}</p>
        <div class="promise-sign">
          <svg class="brand-mark promise-mark" viewBox="0 0 639 655" aria-hidden="true"><use href="#markglyph" /></svg>
          <span><strong>Lucas</strong> · {c.promiseSign}</span>
        </div>
      </div>
      <div class="reveal pending">
        <ul class="checklist">
          {c.promiseChecks.map(([t, b]) => (
            <li>
              <svg viewBox="0 0 24 24" class="i"><path d="M20 6L9 17l-5-5" /></svg>
              <span><strong>{t}</strong> — {b}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
