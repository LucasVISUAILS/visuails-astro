// VISUAILS — the homepage, rebuilt around the drop.
//
// This component holds the whole page body so that / and /nl are the SAME
// page in two languages rather than two pages that drift. The brief requires
// every change to land in EN and NL together; the cheapest way to guarantee
// that is one source file and one copy table. Same pattern as StartPage.astro
// and PricingPage.astro.
//
// SCOPE, read before editing — the two rules this page exists to obey:
//
//   1. Section 13: the per-product tier "must NOT appear on the homepage, in
//      the nav, or in any hero." That is why the services ledger (the
//      accordion at €39.99 / €59.99 / from €49), the "One product. Four
//      photos. €39.99." set strip and the "Per product" plan column are all
//      gone rather than merely re-sourced from pricing.js. The unit of sale
//      on this page is a drop.
//   2. AUDIT-TASK-0.md §B: the H1, the statement, "Real output. Zero
//      photoshoots.", "Four ways to look bigger than you are.", the quality
//      block, the lead magnet, the promise and the €0.99 close are all
//      explicitly protected. They survive here with their copy intact.
//
// Five euro figures appear on this page and each does a different job: the
// production-day anchor (a range, itemised so it is checkable), the two doors
// into a drop, and the €0.99 close. The old page carried six across four
// separate selling blocks, which is a price list. This one has one offer.
//
// Every fact about a tier — window, queue, review level, revision rounds,
// every euro — is read from src/data/pricing.js. Nothing is typed into this
// markup. If a promise on this page is wrong, it is wrong in pricing.js.
import Compare from './Compare.astro';
import {
  TIERS, reviewClaim, turnaround, aftercare, AMOUNT, euro, TEST_SAMPLE,
  PILOT_PRODUCTS, FULL_DROP_MIN, FULL_DROP_MAX, SHOOT_DAY,
} from '../data/pricing.js';
import { localizedPath } from '../i18n/ui.js';

interface Props { lang: 'en' | 'nl'; }
const { lang } = Astro.props;
const lp = (p: string) => localizedPath(lang, p);

const attended = TIERS.attended;
const shoot = SHOOT_DAY[lang];

