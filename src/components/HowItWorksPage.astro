    // images are stand-ins — lives in WALK_COPY in src/data/demo.js, because
    // /demo renders the same component and copy kept in two page files is copy
    // that drifts. These two are this page's own framing of it.
    flowH: 'Your order, end to end.',
    flowLede: 'One service at a time, from the phone photo you send to the files that come back. Pick one and scroll: the frame holds still and shows what exists at that moment.',
    gateLead: 'No date is printed until the calendar clears it.',
    gateBody: 'A reserved delivery date is confirmed before you pay, never after. If the week you need cannot be held, you hear that — not an optimistic guess. It is the one promise on this site we would rather lose an order over than break.',
    craftH: 'More than AI. Finished by hand.',
    craftBody: "The images are generated first, and then every one goes through a pair of hands. We finish it in professional editing software and grade the colour to your brand. Then a specialist checks three things: does the product match your own photo, do all the images look the same, and is the framing right.",
    chips: ['Professional editing & retouch', 'Colour grading to your brand', reviewClaim('attended', 'en')],
    beforeAlt: 'A flat, ungraded product scene before VISUAILS finishing',
    afterAlt: 'The same scene, finished and human-checked by VISUAILS',

    portalH: 'You approve it, image by image.',
    portalBody: `An order of ${WINDOW_THRESHOLD} products or more does not arrive as a zip file and a hope. ${clause(TIERS.attended.delivery.en)}.`,
    portalNote: `Smaller orders work differently and more simply. ${clause(TIERS.unattended.delivery.en)}.`,
    /* ── DE TEKENING VAN HET PORTAAL STAAT SINDS 30 AUGUSTUS 2026 HIER ────────
       Ze zat in de doorloop hierboven, als de laag bij de portaalstap. Die stap
       is samengevoegd met de downloadstap om de pagina in te korten, en één
       stap toont één laag — dus de tekening had geen plek meer.
       Deze sectie was de plek waar ze hoort: hij DOET de goedkeuringsbelofte en
       had nul beelden. Wat een lijst het slechtst kan laten zien is dat er
       dingen NAAST elkaar gebeuren, en dat is nu juist de belofte. Zelfde
       component als op de homepage, met eigen woorden. */
    portalFigH: 'Your order, image by image',
    portalFigOk: 'Approved by you',
    portalFigRev: 'Sent back with a note',
    portalFigWait: 'Still coming',
    portalFigNote: 'A drawing of the review screen, not a screenshot. One image going back does not hold up the rest.',

    verderH: 'Want to see more of the inner workings?',
    verderDemo: 'Walk through an order',
    verderStudio: 'The studio day and the calendar',
    verderAbout: 'Who is behind it',
    detailsH: 'The details that matter',
    details: [
      { t: 'Turnaround', b: `From ${WINDOW_THRESHOLD} products: ${clause(turnaround('attended', 'en')).toLowerCase()}. Below that: ${clause(turnaround('unattended', 'en')).toLowerCase()}, ${clause(TIERS.unattended.queue.en).toLowerCase()}.` },
      /* ── DEZE REGEL BELOOFDE EEN VERSCHIL DAT NIET BESTAAT — 25 aug 2026 ──
