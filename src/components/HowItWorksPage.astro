    fmtFrames: [
      { t: 'Shoplisting' },
      { t: 'Feedpost', alt: 'Dezelfde catalogvisual bijgesneden naar een staande 4:5-feedpost' },
      { t: 'Reel of story', alt: 'Dezelfde catalogvisual bijgesneden naar een schermvullende 9:16-reel of -story' },
      { t: 'Banner', alt: 'Dezelfde catalogvisual bijgesneden naar een brede 16:9-banner' },
      { t: 'Marktplaats', alt: 'Dezelfde catalogvisual bijgesneden naar een 3:4-vermelding op een marktplaats' },
    ],
    fmtNote: 'Hoge-resolutiebestanden, klaar voor e-commerce. Elk kader ís de verhouding waar het label bij staat.',

    faqH: 'Nog een vraag?',
    faqGuides: `De FAQ beantwoordt de praktische vragen; de langere stukken — hoe je de foto maakt die je ons stuurt, wat een shootdag echt kost — staan bij de <a href="${lp('/guides')}">gidsen</a>.`,
    faqCta: 'Lees de FAQ',

    ctaH: 'Zie het op je eigen product.',
    ctaBody: `Eén proefvisual per bedrijf — ${sample}, zonder verplichting. Hij loopt door dezelfde pipeline als een betaalde bestelling.`,
    ctaSampleBtn: 'Proefvisual',
    ctaStartBtn: 'Start een bestelling',
    wa: 'https://wa.me/31625436130?text=Hoi%20VISUAILS%2C%20ik%20heb%20een%20vraag%20over%20hoe%20een%20bestelling%20werkt.',
  },
};

const c = COPY[lang];

// Built here rather than inline in the <FigPipeline> attribute, and the reason
// is not taste. An arrow function inside a JSX attribute puts a `>` (the one in
// `=>`) inside the opening tag, and check_tags — which scans for tag
// boundaries, not JS — closed <FigPipeline> on it and then reported the next
// </div> as a mismatch against an unclosed `figpipeline`. The report was
// correct about what it could see. Same principle as FigCapacity's segments()
// helper: static analysis is the entire safety net in this repo (npm is
// blocked, nothing can be built or screenshotted), so markup that the checkers
// cannot parse is markup with no checker on it.
//
// The href is localised here too. FigPipeline has no `lang` prop and must not
// grow one — see its header comment.
const pipeStops = c.steps.map((s) => ({
  t: s.h,
  b: s.b,
  gate: s.gate,
  linkText: s.linkText,
  linkHref: s.linkHref ? lp(s.linkHref) : undefined,
}));
---

<!-- HERO -->
<section class="hero-editorial compact">
  <div class="bg" style="background-image:url('/img/banners-04.webp')"></div>
  <div class="fade"></div>
  <div class="hero-editorial-content container">
    <h1 class="display" data-split-lines>{c.h1a}<br />{c.h1b}<em>{c.h1em}</em>{c.h1c}</h1>
    <p class="lead" style="margin-top:1.2rem;max-width:60ch">{c.lead}</p>
    <div class="flex" style="margin-top:1.8rem">
      <span class="magnet-wrap"><span class="magnet-inner"><a href={lp('/start')} class="btn btn-primary btn-lg" data-track="hiw-start">{c.ctaStart}</a></span></span>
      <a href={lp('/test-sample')} class="btn btn-ghost btn-lg">{c.ctaSample}</a>
    </div>
  </div>
</section>

<!-- ONE FOLDER IN, A BATCH OUT — the H1, drawn. It sits directly under the hero
     because it is the same sentence: the hero says it, this shows it, and a
     reader who scrolls past the words still gets the account. -->
<section class="section-tight"><div class="container">
  <div class="reveal pending">
    <FigFanOut
      photo="/img/catalog-before.webp"
      photoAlt={c.fanPhotoAlt}
      made="/img/catalog-after.webp"
      madeAlt={c.fanMadeAlt}
      inLabel={c.fanIn}
      outLabel={c.fanOut}
      slots={c.fanSlots}
      note={c.fanNote}
    />
  </div>
</div></section>

<!-- THE FOUR STEPS, as a rail rather than four cards. Four, not three: the
     capacity check is a step, not a disclaimer, and hiding it inside "we
     produce" is how a studio ends up promising a week it cannot hold. The
     gate stop is drawn as a doorway, which is the one thing the old numbered
     grid could not say — it gave the refusal the same weight as "you send us
     photos". The hrefs are localised HERE, not inside the figure. -->
<section class="section-tight"><div class="container">
  <div class="reveal pending">
    <FigPipeline stops={pipeStops} note={c.pipeNote} />
  </div>
</div></section>

<!-- THE CAPACITY GATE. Same promise as /start, stated once more where the
     process is being explained rather than chosen — and then drawn, because
     the half of this promise that matters is the half where the answer is no,
     and prose can only tell you that happens. -->
<section class="section-tight"><div class="container narrow">
  <div class="gate reveal pending">
    <p class="editorial-statement">{c.gateLead}</p>
    <p class="gate-body">{c.gateBody}</p>
  </div>
  <div class="gate-fig reveal pending">
    <FigCapacity cases={c.capCases} note={c.capNote} />
  </div>
</div></section>

<!-- FINISHED BY HAND -->
<section class="section-tight"><div class="container two-col">
  <div class="reveal pending">
    <Compare
      grade
      before="/img/lifestyle-glow-06.webp"
      after="/img/lifestyle-glow-06.webp"
      beforeAlt={c.beforeAlt}
      afterAlt={c.afterAlt}
    />
  </div>
  <div class="reveal pending">
    <h2>{c.craftH}</h2>
    <p class="lead" style="margin-top:1.1rem">{c.craftBody}</p>
    <div class="chip-row" style="margin-top:1.4rem">
      {c.chips.map((chip) => (
        <span class="chip"><span class="dot"></span>{chip}</span>
      ))}
    </div>
  </div>
</div></section>

<!-- THE PORTAL -->
<section class="section-tight"><div class="container two-col">
  <div class="reveal pending">
    <h2>{c.portalH}</h2>
    <p class="lead" style="margin-top:1.1rem">{c.portalBody}</p>
    <p class="portal-note">{c.portalNote}</p>
  </div>
  <div class="reveal pending">
    <FigApproval
      head={c.apvHead}
      okLabel={c.apvOk}
      revLabel={c.apvRev}
      waitLabel={c.apvWait}
      note={c.apvNote}
    />
  </div>
</div></section>

<!-- THE DETAILS. The figure opens the section and the cards follow, so the
     band is not another uninterrupted run of identical boxes — and the "Files"
     claim that used to be the sixth box is now the thing you can see. -->
<section><div class="container">
  <div class="section-head"><h2>{c.formatsH}</h2></div>
  <div class="reveal pending" style="margin-bottom:clamp(3rem,6vw,4.5rem)">
    <FigFormats
      photo="/img/catalog-after.webp"
      alt={c.fmtAlt}
      width={1800}
      height={1800}
      frames={c.fmtFrames}
      note={c.fmtNote}
    />
  </div>
  <div class="section-head"><h2>{c.detailsH}</h2></div>
  <div class="grid grid-auto reveal-group">
    {c.details.map((d) => (
      <div class="card reveal pending">
        <h3 style="font-size:1.05rem">{d.t}</h3>
        <p style="margin-top:.5rem;font-size:.95rem;color:var(--ink-3)">{d.b}{d.linkText ? <> <a href={lp(d.linkHref)}>{d.linkText}</a>.</> : null}</p>
      </div>
    ))}
  </div>
</div></section>

<!-- FAQ -->
<section class="section-tight"><div class="container">
  <div style="text-align:center;max-width:60ch;margin:0 auto 1.4rem">
    <h2>{c.faqH}</h2>
    <p class="faq-guides" set:html={c.faqGuides} />
  </div>
  <div class="flex" style="justify-content:center"><a href={lp('/faq')} class="btn btn-ghost btn-lg">{c.faqCta}</a></div>
</div></section>

<!-- CTA -->
<section class="section-tight"><div class="container">
  <div class="cta-band reveal pending">
    <h2 class="display" style="font-size:clamp(2rem,4.5vw,3.2rem)">{c.ctaH}</h2>
    <p class="lead" style="margin:1rem auto 0;text-align:center">{c.ctaBody}</p>
    <div class="flex" style="justify-content:center;margin-top:1.8rem">
      <a href={lp('/test-sample')} class="btn btn-primary btn-lg" data-track="hiw-sample">{c.ctaSampleBtn}</a>
      <a href={lp('/start')} class="btn btn-ghost btn-lg">{c.ctaStartBtn}</a>
      <a href={c.wa} class="btn btn-wa" target="_blank" rel="noopener">WhatsApp</a>
    </div>
  </div>
</div></section>

<style>
  /* The `.steps.four` override and `.step p a` that used to live here are gone
     with the markup they styled — FigPipeline replaced the four step cards, so
     the rules had nothing left to select. Deleting them is not tidying: an
     emitted-nowhere CSS rule is exactly what verify3 [5] reports as dead, and
     leaving it would have cost a real finding to make room for a false one.
     Global .steps / .step / .step-n stay put — six other pages use them. */

  /* The capacity gate. A single heavy rule above it and nothing else — the
     sentence is the design. */
  .gate { border-top: 2px solid var(--ink); padding-top: clamp(1.4rem, 3vw, 2.2rem); }
  .gate-body { margin-top: 1.1rem; color: var(--ink-2); max-width: 66ch; }
  /* The figure is part of the gate block, not a new thought, so it sits inside
     the same narrow container under one rule rather than starting its own
     section with its own heading. */
  .gate-fig { margin-top: clamp(2rem, 4.5vw, 3.2rem); }

  .chip-row { display: flex; flex-wrap: wrap; gap: .5rem; }
  .chip { display: inline-flex; align-items: center; gap: .45rem; padding: .4rem .9rem; border: 1px solid var(--line); font-size: .8rem; color: var(--ink-2); }
  .chip .dot { width: 5px; height: 5px; background: var(--accent); }

  .portal-note { margin-top: 1.1rem; font-size: .9rem; color: var(--ink-3); max-width: 60ch; }

  .grid-auto { grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); }
  .card p a { color: var(--ink); text-decoration: underline; text-underline-offset: 2px; }

  /* The line to the guides hub under the FAQ heading. Its anchor arrives
     through set:html and carries no scope attribute, so :global() is what
     reaches it. */
  .faq-guides { margin-top: .9rem; font-size: .92rem; color: var(--ink-3); line-height: 1.6; }
  .faq-guides :global(a) { color: var(--accent-bright); text-decoration: underline; text-underline-offset: 3px; }
</style>
