  WINDOW_THRESHOLD, vatLabel, vatLead, vatDetail, TEST_SAMPLE,
  CATALOG_IMAGES, LIFESTYLE_IMAGES,
} from '../data/pricing.js';
import { localizedPath } from '../i18n/ui.js';

import Note from './Note.astro';
interface Props { lang: 'en' | 'nl'; }
const { lang } = Astro.props;
const lp = (p: string) => localizedPath(lang, p);

// The test sample is the only price this page prints, and it now prints with a
// VAT label attached — BRIEF-14's rule, and it was being broken here quietly:
// a bare €1 next to "no commitment" reads as the whole of what leaves the
// account, and it is not. Both figures are built here rather than in the copy
// table so neither branch can print one without the other.
const sample = `${euro(AMOUNT.testSample, lang)} ${vatLabel('excl', lang)}`;

// "WAAR DE BEELDEN LANDEN" — verhuisd van de homepage, augustus 2026.
// Elk getal hier is AFGELEID en niet getypt. De twee die een lezer kan
// natellen — 4 catalogbeelden, 3 lifestylebeelden — zijn CATALOG_IMAGES en
// LIFESTYLE_IMAGES, dezelfde twee constanten die /catalog en /lifestyle stuk
// voor stuk printen. Zo kan de som in de lede nooit ruzie krijgen met de
// aantallen die daar staan. Het voorbeeldseizoen van 30 producten is het
// getal dat op de homepage al werd gebruikt; het is een voorbeeld en geen
// belofte, en het staat daarom in de zin en niet in een tegel.
const PER_PRODUCT_VISUALS = CATALOG_IMAGES + LIFESTYLE_IMAGES;
const EX_FULL = 30;
const EX_VISUALS = PER_PRODUCT_VISUALS * EX_FULL;

// No `as const` — see PricingPage.astro for why (union-of-tuples breaks .map).
