      { t: 'Jouw rechten', b: 'Volledige commerciële gebruiksrechten op alles wat we leveren.', linkText: 'Lees de voorwaarden', linkHref: '/terms' },
    ],
    landH: 'Eén bestelling, overal waar hij heen moet.',
    landLede: `Een seizoen van ${EX_FULL} producten is ${PER_PRODUCT_VISUALS} foto’s per stuk — ${EX_VISUALS} afgewerkte foto’s, uitgesneden voor waar ze moeten staan.`,
    land: [
      ['Hero op de productpagina', 'Op wit of in scène'],
      ['Grid op de productpagina', 'Voorkant, achterkant en een stofdetail'],
