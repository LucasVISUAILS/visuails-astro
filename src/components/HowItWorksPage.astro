<style>
  /* The `.steps.four` override and `.step p a` that used to live here are gone
     with the markup they styled — FigPipeline replaced the four step cards, so
     the rules had nothing left to select. Deleting them is not tidying: an
     emitted-nowhere CSS rule is exactly what verify3 [5] reports as dead, and
     leaving it would have cost a real finding to make room for a false one.
     Global .steps / .step / .step-n stay put — six other pages use them. */

  /* The capacity gate. A single heavy rule above it and nothing else — the
     sentence is the design. */
  .gate { border-top: 2px solid var(--ink); padding-top: clamp(1.4rem, 3vw, 2.2rem); }
  .gate-body { margin-top: 1.1rem; color: var(--ink-2); max-width: 66ch; }
  /* `.gate-fig` used to be here and is gone with FigCapacity — see the note at
     the top of this block about not leaving a rule that selects nothing.
     The gate block now introduces the rail rather than a figure of its own, so
     what it needs is room underneath it, not around a drawing. */
  .gate { margin-bottom: clamp(2.4rem, 5vw, 3.6rem); }

  /* The lede above the gate promise. Wider than the prose max, because it is
     describing a thing the reader can see the whole of. */
  .flow-lede { max-width: 68ch; margin: 0 0 clamp(1.8rem, 4vw, 2.8rem); color: var(--ink-2); font-size: 1.02rem; line-height: 1.65; }

  .flow-vat { margin: clamp(1rem, 2vw, 1.4rem) auto 0; max-width: 46rem; font-size: .78rem; color: var(--ink-4); line-height: 1.6; }

  .chip-row { display: flex; flex-wrap: wrap; gap: .5rem; }
  .chip { display: inline-flex; align-items: center; gap: .45rem; padding: .4rem .9rem; border: 1px solid var(--line); font-size: .8rem; color: var(--ink-2); }
  .chip .dot { width: 5px; height: 5px; background: var(--accent); }

  .portal-note { margin-top: 1.1rem; font-size: .9rem; color: var(--ink-3); max-width: 60ch; }

  .grid-auto { grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); }
  .card p a { color: var(--ink); text-decoration: underline; text-underline-offset: 2px; }

  /* The line to the guides hub under the FAQ heading. Its anchor arrives
     through set:html and carries no scope attribute, so :global() is what
     reaches it. */
  .faq-guides { margin-top: .9rem; font-size: .92rem; color: var(--ink-3); line-height: 1.6; }
  .faq-guides :global(a) { color: var(--accent-bright); text-decoration: underline; text-underline-offset: 3px; }
</style>

<script>
  // Page-local, like /start's pipeline.js and /demo's demo-game.js: this is one
  // figure's behaviour and Layout.astro must not ship it to 86 pages to serve
  // one. Importing runs it immediately and registers the astro:page-load
  // listener for every ClientRouter navigation after — see src/scripts/flow.js,
  // which also explains why no price arithmetic lives in it.
  import '../scripts/flow.js';
</script>
