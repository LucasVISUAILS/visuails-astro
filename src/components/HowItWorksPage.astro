    details: [
      { t: 'Levertijd', b: `Vanaf ${WINDOW_THRESHOLD} producten: ${clause(turnaround('attended', 'nl')).toLowerCase()}. Daaronder: ${clause(turnaround('unattended', 'nl')).toLowerCase()}, ${clause(TIERS.unattended.queue.nl).toLowerCase()}.` },
      /* Zie de noot bij de Engelse tegenhanger: dezelfde dubbele punt en
         hetzelfde verzonnen verschil tussen de twee treden. */
      { t: 'Als iets niet klopt', b: `${aftercare('attended', 'nl')}` },
      // Zie de EN-tak: geen productbereik meer, de claim klopt bij elk aantal.
      { t: 'Consistentie', b: 'Dezelfde belichting, dezelfde hoek, dezelfde grade over elk product in de bestelling. Dat ze samen door de productie gaan is precies wat dat mogelijk maakt.' },
