      <a href={lp('/test-sample')} class="btn btn-ghost btn-lg">{c.ctaSample}</a>
    </div>
  </div>
</section>

<!-- THE WHOLE PIPELINE, AS ONE RAIL YOU CAN TURN KNOBS ON.
     This one section is what five were: FigFanOut (one folder in, a batch out),
     FigPipeline (the four stops and the gate), FigCapacity (both answers),
     FigApproval (three states at once) and FigFormats (five channel shapes).
     Lucas: "1 opzicht de gehele production pipeline" — and, separately, "meer
     interactief", which is why the scope switches and the count slider are real
     inputs rather than the reference's self-flipping decorations.

     The gate promise is stated in prose FIRST and drawn SECOND, the same order
     /start uses. A reader who stops at the paragraph has the whole promise; the
     figure is what makes the refusing half impossible to skim past. -->
<section class="section-tight"><div class="container">
  <div class="section-head"><h2>{c.flowH}</h2></div>
  <p class="flow-lede reveal pending">{c.flowLede}</p>
  <div class="gate reveal pending">
    <p class="editorial-statement">{c.gateLead}</p>
    <p class="gate-body">{c.gateBody}</p>
  </div>
  <div class="reveal pending">
    <FigFlow
      label={c.flowLabel}
      stages={c.flowStages}
      sources={c.flowSources}
      scopes={c.flowScopes}
      countLabel={c.flowCountLabel}
      countUnit={c.flowCountUnit}
      nextLabel={c.flowNextLabel}
      emptyLabel={c.flowEmpty}
      imagesLabel={c.flowImages}
      gatePass={c.flowGatePass}
      gateRefuse={c.flowGateRefuse}
      gateNote={c.flowGateNote}
      makeSteps={c.flowMake}
      portalStates={c.flowPortal}
      deliverPortal={c.flowDeliverPortal}
      deliverLink={c.flowDeliverLink}
      channels={c.flowChannels}
      rates={flowRates}
      timing={flowTiming}
      threshold={WINDOW_THRESHOLD}
      maxCount={FLOW_MAX}
      startCount={FLOW_START}
      vat={vatLabel('excl', lang)}
      note={c.flowNote}
    />
  </div>
  {/* vatNote() ONCE PER PAGE, and this page had never said it. Every number in
      the figure carries `excl. VAT` — that is BRIEF-14's per-number rule — but
      the second half of the rule is one line per page saying how VAT is
      actually handled, and the page went from printing one price (the test
      sample) to printing a live calculator without ever adding it. Plain
      paragraph rather than /pricing's <Disclose>: this is the foot of a figure,
      not a price table, and a thing you have to open to read is not "stated". */}
  <p class="flow-vat">{vatNote(lang)}</p>
</div></section>

<!-- FINISHED BY HAND -->
