---
/*
 * VISUAILS — /how-it-works. OPNIEUW GEMAAKT, 22 september 2026.
 * ═══════════════════════════════════════════════════════════════════════════
 *
 * Lucas: *"/how-it-works mag overigens veel simpeler uitgelegd worden en voelt
 * nu een beetje als een chaos terwijl het systeem heel simpel is. Deze pagina
 * mag volledig opnieuw gemaakt worden, en dan met name het gedeelte waar
 * uitgelegd word wat visuails doet van order tot levering."*
 *
 * Wat er stond, gemeten op 1440: 6.800 px, en het deel "van order tot
 * levering" was daar 2.800 van — een dienstkiezer met drie radioknoppen,
 * daaronder per dienst dezelfde drie fasen (drie keer in de HTML), lookkaartjes,
 * gezichten, knoppen, een tekening van het portaal met een eigen haarlijn, en
 * elk zinnetje met een vraagteken erachter. Alles waar. Alles uit te leggen.
 * En precies dat is de chaos: een systeem van drie zinnen dat er vijftien
 * bedieningen voor nodig heeft.
 *
 * ── WAT ER NU STAAT ────────────────────────────────────────────────────────
 *
 * De doorloop is DEZELFDE BAND als op de voorpagina (Stations.astro): drie
 * kolommen, jij bestelt — wij maken — jij keurt goed, elk met het beeld dat
 * de stap ís (dezelfde roze jeans, uit src/data/voorbeeldset.js). Wie van de
 * voorpagina komt, herkent de tekening en leest hier wat er onder elke stap
 * zit: drie of vier korte regels met een haarlijn ertussen. Geen kiezer, geen
 * vraagtekens, geen tweede tekening.
 *
 *   · De regels van stap 01 zijn de KOPPEN van de zes stappen uit demo.js —
 *     dezelfde woorden waar schema.js de HowTo-structuurdata van bouwt. Eén
 *     bron, dus de pagina en de structuurdata kunnen niet uit elkaar lopen.
 *   · De fasenamen (boven het beeld) en de duur (onder het woord) komen uit
 *     WALK_COPY.fasen, om dezelfde reden.
 *   · Het verschil tussen de drie diensten is één regel per dienst, onder de
 *     band: hoeveel beelden, en wat je kiest. De rest staat op /catalog,
 *     /lifestyle en /video en hoort daar.
 *   · De belofte over de agenda blijft de ene grote zin — dat is de uitspraak
 *     op deze site waarvoor we liever een bestelling verliezen dan hem breken.
 *
 * De rest van de pagina — met de hand afgewerkt, de details, waar de beelden
 * landen, het slot — was al kort en blijft. De vergelijker toont nu een ECHT
 * voor-en-na (catalog-before / catalog-after, het gewassen T-shirt) in plaats
 * van één foto die links ontkleurd werd.
 *
 * Wat eruit ging en niet terugkomt: FigWalk (bestand blijft staan, net als de
 * andere Fig-bestanden die niets meer importeert), FigApproval (de tekening
 * van het portaal staat nu in de band), de lookkaartjes en de gezichten (die
 * staan op de dienstpagina's en /models).
 *
 * Twee regels die blijven gelden:
 *   · geen enkele duur wordt getypt — turnaround() in pricing.js;
 *   · de agendaregel: nooit een leverdatum beloven die de agenda niet kan
 *     dragen. Vandaar de zin onder de band, groot.
 */
import { waHref } from '../data/whatsapp.js';
import Compare from './Compare.astro';
import Stations from './Stations.astro';
import Uitleg from './Uitleg.astro';
import Note from './Note.astro';
import {
  TIERS, reviewClaim, turnaround, aftercare, euro, AMOUNT,
  WINDOW_THRESHOLD, vatLabel, vatLead, vatDetail, TEST_SAMPLE, clause,
  CATALOG_IMAGES, LIFESTYLE_IMAGES, VIDEO_OP_AANVRAAG,
} from '../data/pricing.js';
import { WALK_COPY, WALK_SERVICES, DEMO_BACKGROUNDS } from '../data/demo.js';
import { localizedPath } from '../i18n/ui.js';
import '../styles/stijl22.css';

interface Props { lang: 'en' | 'nl'; }
const { lang } = Astro.props;
const nl = lang === 'nl';
const lp = (p: string) => localizedPath(lang, p);
const t = WALK_COPY[lang] || WALK_COPY.en;

/* De ene prijs op deze pagina, mét btw-label — BRIEF-14. */
const sample = `${euro(AMOUNT.testSample, lang)} ${vatLabel('excl', lang)}`;

/* "Waar de beelden landen": elk getal afgeleid, niets getypt. */
const PER_PRODUCT_VISUALS = CATALOG_IMAGES + LIFESTYLE_IMAGES;
const EX_FULL = 30;
const EX_VISUALS = PER_PRODUCT_VISUALS * EX_FULL;

/* De regels van stap 01: de koppen van de vier bestelstappen uit demo.js. */
const bestelRegels = ['upload', 'look', 'window', 'pay'].map((id) => t.steps[id].h);
const fase = (id: string) => t.fasen[id] || { n: '', duur: '', h: '' };
const kopregel = (nr: string, id: string) => [nr, fase(id).n].filter(Boolean).join(' · ');

/* Eén regel per dienst: wat je krijgt en wat je kiest. De namen van de
   achtergronden komen uit demo.js/backgrounds.js, dus ze kunnen hier niet
   anders heten dan op /catalog. */
const achtergronden = DEMO_BACKGROUNDS.map((b) => t.backgroundNames[b.id] || b.id);
const lijst = (xs: string[]) => nl
  ? xs.slice(0, -1).join(', ') + ' of ' + xs[xs.length - 1]
  : xs.slice(0, -1).join(', ') + ' or ' + xs[xs.length - 1];
const DIENST_PAD: Record<string, string> = { catalog: '/catalog', lifestyle: '/lifestyle', video: '/video' };

const COPY = {
  en: {
    h1a: 'One folder in.',
    h1b: 'A whole ',
    h1em: 'batch',
    h1c: ' out.',
    lead: `You send a folder of product photos and a short note. We give the order a delivery date the calendar can actually hold, produce it, check it by hand, and hand it back image by image.`,
    ctaStart: 'Start an order',
    ctaSample: TEST_SAMPLE.en.cta,

    flowH: 'Your order, end to end.',
    flowLede: 'Three steps, and that is all of it: you order, we make, you approve. The same road for catalog, lifestyle and video.',
    stations: [
      {
        woord: fase('bestellen').h,
        zin: 'One form: your photos, the look, how many products and when you need them. You pay at the end — production starts after that.',
        etiket: 'Sent in', etiketNoot: '3 of 5 · phone',
      },
      {
        woord: fase('maken').h,
        zin: 'Every product runs as one series, so light, angle and grade match across the whole order. A specialist checks every image.',
        regels: ['One series per product', 'A face from the shared roster, at no extra cost', 'Every image checked by a specialist'],
        etiket: 'Delivered', etiketNoot: `${CATALOG_IMAGES} images · 2048 px`,
        link: 'See more work',
      },
      {
        woord: 'You approve',
        zin: 'Approve each image on its own, or send it back with a note. What is good, you download straight away.',
        regels: ['One revision round per order', 'Download at 2048 px, as jpg, png and webp', 'Full commercial rights'],
        noot: `Smaller orders work more simply still. ${clause(TIERS.unattended.delivery.en)}.`,
        link: 'Look inside the portal',
      },
    ],
    gateLead: 'You only see dates the calendar can still hold.',
    gateBody: `From ${WINDOW_THRESHOLD} products you pick a delivery date in the form, and the calendar only offers days with room left. That date is held the moment your order is in, and you pay straight away. Should a day fill up between choosing and ordering, you hear that at once and pick again — no date is invented to keep an order. It is the one promise on this site we would rather lose an order over than break.`,
    dienstenH: 'Per service',
    kiest: {
      catalog: `Background: ${lijst(achtergronden)}`,
      lifestyle: 'A look from the range',
      video: VIDEO_OP_AANVRAAG ? 'On request' : 'A style from the range',
    },
    verderH: 'Want to see more of the inner workings?',
    verderStudio: 'The studio day and the calendar',
    verderAbout: 'Who is behind it',

    craftH: 'More than AI. Finished by hand.',
    craftBody: "We build every image ourselves. Generating is one of the steps — then it goes through a pair of hands: finished in professional editing software, colour graded to your brand. Then a specialist checks three things: does the product match your own photo, do all the images look the same, and is the framing right.",
    chips: ['Professional editing & retouch', 'Colour grading to your brand', reviewClaim('attended', 'en')],
    beforeAlt: 'The T-shirt as it was sent in: a phone photo on a wooden table',
    afterAlt: 'The same T-shirt, finished on off-white and checked by hand',

    detailsH: 'The details that matter',
    details: [
      { t: 'Turnaround', b: `From ${WINDOW_THRESHOLD} products: ${clause(turnaround('attended', 'en')).toLowerCase()}. Below that: ${clause(turnaround('unattended', 'en')).toLowerCase()}, ${clause(TIERS.unattended.queue.en).toLowerCase()}.` },
      { t: 'If something is off', b: `${aftercare('attended', 'en')}` },
      { t: 'Your rights', b: 'Full commercial usage rights to everything we deliver.', linkText: 'Read the terms', linkHref: '/terms' },
    ],
    landH: 'One order, every place it has to go.',
    landLede: `A season of ${EX_FULL} products is ${PER_PRODUCT_VISUALS} images each — ${EX_VISUALS} finished images, cut for where they have to sit.`,
    land: [
      ['Product page hero', 'On white or in scene'],
      ['Product page grid', 'Front, back and a fabric detail'],
      ['On-model shot', 'In every catalog set'],
      ['Instagram carousel', 'Three styled frames per product'],
      ['Reels and TikTok', 'Vertical clips, added per clip to any order'],
      ['Paid social', 'The same look in ad crops'],
      ['Marketplaces', 'For the likes of Zalando, Amazon and bol'],
      ['Email and linesheets', 'Wide crops for newsletters and wholesale'],
    ],
    landNote: 'You pick the aspect ratio for these when you order, and every image arrives as jpg, png and webp.',

    faqGuides: `The FAQ answers the practical ones; the longer reads — how to shoot the photo you send us, what a shoot day actually costs — are in the <a href="${lp('/guides')}">guides</a>.`,
    faqCta: 'Read the FAQ',
    ctaH: 'One of your own products, as a catalog set or a carousel.',
    ctaBody: `One test sample per business — ${sample}, no commitment. It runs through the same production as a paid order.`,
    ctaSampleBtn: TEST_SAMPLE.en.cta,
    ctaStartBtn: 'Start an order',
    wa: waHref("Hi VISUAILS, I have a question about how an order works."),
  },

  nl: {
    h1a: 'Eén map erin.',
    h1b: 'Een hele ',
    h1em: 'bestelling',
    h1c: ' eruit.',
    lead: 'Jij stuurt een map met productfoto’s en een korte notitie. Wij geven de bestelling een leverdatum die de agenda ook echt kan vasthouden, produceren hem, controleren met de hand, en geven hem beeld voor beeld terug.',
    ctaStart: 'Start een bestelling',
    ctaSample: TEST_SAMPLE.nl.cta,

    flowH: 'Je bestelling, van begin tot eind.',
    flowLede: 'Drie stappen, en meer is het niet: jij bestelt, wij maken, jij keurt goed. Dezelfde weg voor catalog, lifestyle en video.',
    stations: [
      {
        woord: fase('bestellen').h,
        zin: 'Eén formulier: je foto’s, de look, hoeveel producten en wanneer je ze nodig hebt. Je betaalt aan het eind — daarna start de productie.',
        etiket: 'Ingestuurd', etiketNoot: '3 van 5 · telefoon',
      },
      {
        woord: fase('maken').h,
        zin: 'Elk product gaat als één serie door de productie, dus licht, hoek en kleur kloppen over de hele bestelling. Een specialist kijkt elk beeld na.',
        regels: ['Eén serie per product', 'Een gezicht uit de gedeelde bibliotheek, zonder meerprijs', 'Elk beeld nagekeken door een specialist'],
        etiket: 'Geleverd', etiketNoot: `${CATALOG_IMAGES} beelden · 2048 px`,
        link: 'Meer werk zien',
      },
      {
        woord: 'Je keurt goed',
        zin: 'Elk beeld apart goedkeuren, of terugsturen met een notitie. Wat goed is, download je meteen.',
        regels: ['Eén revisieronde per bestelling', 'Downloaden op 2048 px, als jpg, png en webp', 'Volledige commerciële rechten'],
        noot: `Kleinere bestellingen werken nog simpeler. ${clause(TIERS.unattended.delivery.nl)}.`,
        link: 'Het portaal van binnen',
      },
    ],
    gateLead: 'Je ziet alleen dagen die de agenda nog kan vasthouden.',
    gateBody: `Vanaf ${WINDOW_THRESHOLD} producten kies je in het formulier een leverdatum, en de agenda biedt alleen dagen aan waar nog ruimte is. Die datum ligt vast zodra je bestelling binnen is, en je betaalt meteen. Is een dag net vol geraakt tussen kiezen en bestellen, dan hoor je dat direct en kies je opnieuw — er wordt geen datum verzonnen om een bestelling binnen te houden. Het is de enige belofte op deze site waarvoor we liever een bestelling verliezen dan dat we hem breken.`,
    dienstenH: 'Per dienst',
    kiest: {
      catalog: `Achtergrond: ${lijst(achtergronden)}`,
      lifestyle: 'Een look uit de reeks',
      video: VIDEO_OP_AANVRAAG ? 'Op aanvraag' : 'Een stijl uit de reeks',
    },
    verderH: 'Wil je meer van het binnenwerk zien?',
    verderStudio: 'De studiodag en de kalender',
    verderAbout: 'Wie erachter zit',

    craftH: 'Meer dan AI. Met de hand afgewerkt.',
    craftBody: 'Wij bouwen elk beeld zelf op. Genereren is daarin één stap — daarna gaat het beeld door de hand: afgewerkt in professionele editingsoftware, kleur gecorrigeerd naar je merk. Daarna kijkt een specialist naar drie dingen: klopt het product met je eigen foto, zien alle beelden er hetzelfde uit, en zit de uitsnede goed.',
    chips: ['Professionele editing & retouche', 'Kleurcorrectie naar je merk', reviewClaim('attended', 'nl')],
    beforeAlt: 'Het T-shirt zoals het werd ingestuurd: een telefoonfoto op een houten tafel',
    afterAlt: 'Hetzelfde T-shirt, afgewerkt op gebroken wit en met de hand gecontroleerd',

    detailsH: 'De details die ertoe doen',
    details: [
      { t: 'Levertijd', b: `Vanaf ${WINDOW_THRESHOLD} producten: ${clause(turnaround('attended', 'nl')).toLowerCase()}. Daaronder: ${clause(turnaround('unattended', 'nl')).toLowerCase()}, ${clause(TIERS.unattended.queue.nl).toLowerCase()}.` },
      { t: 'Als iets niet klopt', b: `${aftercare('attended', 'nl')}` },
      { t: 'Jouw rechten', b: 'Volledige commerciële gebruiksrechten op alles wat we leveren.', linkText: 'Lees de voorwaarden', linkHref: '/terms' },
    ],
    landH: 'Eén bestelling, overal waar hij heen moet.',
    landLede: `Een seizoen van ${EX_FULL} producten is ${PER_PRODUCT_VISUALS} foto’s per stuk — ${EX_VISUALS} afgewerkte foto’s, uitgesneden voor waar ze moeten staan.`,
    land: [
      ['Hero op de productpagina', 'Op wit of in scène'],
      ['Grid op de productpagina', 'Voorkant, achterkant en een stofdetail'],
      ['Beeld op een model', 'In elke catalogset'],
      ['Instagram-carousel', 'Drie gestylede beelden per product'],
      ['Reels en TikTok', 'Verticale clips, per clip bij elke bestelling te voegen'],
      ['Betaalde social', 'Dezelfde look in advertentie-uitsnedes'],
      ['Marktplaatsen', 'Voor partijen als Zalando, Amazon en bol'],
      ['E-mail en linesheets', 'Brede uitsnedes voor nieuwsbrieven en wholesale'],
    ],
    landNote: 'De beeldverhouding hiervoor kies je bij het bestellen, en elk beeld komt als jpg, png en webp.',

    faqGuides: `De FAQ beantwoordt de praktische vragen; de langere stukken — hoe je de foto maakt die je ons stuurt, wat een shootdag echt kost — staan bij de <a href="${lp('/guides')}">gidsen</a>.`,
    faqCta: 'Lees de FAQ',
    ctaH: 'Eén product van jezelf, als catalogset of carousel.',
    ctaBody: `Eén proef per bedrijf — ${sample}, zonder verplichting. Hij loopt door dezelfde productie als een betaalde bestelling.`,
    ctaSampleBtn: TEST_SAMPLE.nl.cta,
    ctaStartBtn: 'Start een bestelling',
    wa: waHref("Hoi VISUAILS, ik heb een vraag over hoe een bestelling werkt."),
  },
};

const c = COPY[lang];

/* De drie stations, met de tekening per stap en de regels eronder. */
const STATIONS = [
  { nr: '01', n: kopregel('01', 'bestellen'), duur: fase('bestellen').duur, beeld: 'in' as const, ...c.stations[0], regels: bestelRegels },
  { nr: '02', n: kopregel('02', 'maken'), duur: fase('maken').duur, beeld: 'uit' as const, ...c.stations[1], link: { href: lp('/gallery'), tekst: c.stations[1].link } },
  { nr: '03', n: kopregel('03', 'goedkeuren'), duur: fase('goedkeuren').duur, beeld: 'dash' as const, ...c.stations[2], etiket: '', link: { href: lp('/portal'), tekst: c.stations[2].link } },
];
---

<div class="s22">

  {/* ── 1 · DE OPENING ───────────────────────────────────────────────────── */}
  <section class="paneel" aria-labelledby="hiw-h1">
    <div class="hiw-open">
      <div class="paneel-kop">
        <h1 id="hiw-h1" class="hoog">{c.h1a} <br />{c.h1b}<em>{c.h1em}</em>{c.h1c}</h1>
        <p class="lopend">{c.lead}</p>
        <p class="acties">
          <a class="knop knop-inkt" href={lp('/start')} data-track="hiw-start">{c.ctaStart}</a>
          <a class="knop knop-lijn" href={lp('/test-sample')}>{c.ctaSample}</a>
        </p>
      </div>
      <span class="kaart kaart-stil hiw-beeld">
        <img src="/img/banners-04.webp" alt="" width="928" height="1152" loading="eager" fetchpriority="high" decoding="async" />
      </span>
    </div>
  </section>

  {/* ── 2 · JE BESTELLING, VAN BEGIN TOT EIND ───────────────────────────────
      De band van de voorpagina, met drie stations en de regels eronder. */}
  <section class="paneel" aria-labelledby="hiw-flow">
    <header class="paneel-kop hiw-flow-kop">
      <h2 id="hiw-flow" class="hoog hoog-2">{c.flowH}</h2>
      <p class="lopend">{c.flowLede}</p>
    </header>
    <Stations lang={lang} stations={STATIONS} />

    {/* De belofte: één zin, groot, met de onderbouwing achter het vraagteken. */}
    <div class="hiw-poort">
      <p class="hoog hoog-3 hiw-poort-kop">{c.gateLead}<Uitleg tekst={c.gateBody} over={nl ? 'de leverdatum' : 'the delivery date'} lang={lang} /></p>
    </div>

    {/* Per dienst één regel: wat je krijgt, wat je kiest. */}
    <ul class="hiw-diensten" role="list" aria-label={c.dienstenH}>
      {WALK_SERVICES.map((svc: any) => (
        <li>
          <a class="hiw-dienst-naam" href={lp(DIENST_PAD[svc.id])}>{t.services[svc.id].name}</a>
          <span class="mono">{t.services[svc.id].line}</span>
          <span class="lopend hiw-dienst-kiest">{(c.kiest as any)[svc.id]}</span>
        </li>
      ))}
    </ul>

    <p class="mono hiw-verder">
      {c.verderH}{' '}
      <a href={lp('/studio')}>{c.verderStudio}</a>{' · '}
      <a href={lp('/about')}>{c.verderAbout}</a>
    </p>
  </section>

  {/* ── 3 · MET DE HAND AFGEMAAKT ────────────────────────────────────────── */}
  <section class="paneel" aria-labelledby="hiw-hand">
    <div class="hiw-twee">
      {/* Een echt voor-en-na: het gewassen T-shirt, ingestuurd op een houten
          tafel en afgewerkt op gebroken wit. 5:4 en niet 1:1, zodat het paar
          naast de tekst past zonder dat de kraag of de zoom eraf valt. */}
      <Compare
        ratio="5 / 4"
        before="/img/catalog-before-1x1.webp"
        after="/img/catalog-after.webp"
        beforeAlt={c.beforeAlt}
        afterAlt={c.afterAlt}
      />
      <div class="hiw-hand">
        <h2 id="hiw-hand" class="hoog hoog-2">{c.craftH}</h2>
        <p class="lopend">{c.craftBody}</p>
        <ul class="hiw-chips" role="list">
          {c.chips.map((chip) => <li>{chip}</li>)}
        </ul>
      </div>
    </div>
  </section>

  {/* ── 4 · DE DETAILS ───────────────────────────────────────────────────── */}
  <section class="paneel" aria-labelledby="hiw-details">
    <header class="paneel-kop">
      <h2 id="hiw-details" class="hoog hoog-2">{c.detailsH}</h2>
    </header>
    <ul class="hiw-details" role="list">
      {c.details.map((d) => (
        <li>
          <b>{d.t}</b>
          <span class="lopend">{d.b}{d.linkText ? <> <a href={lp(d.linkHref)}>{d.linkText}</a>.</> : null}</span>
        </li>
      ))}
    </ul>
  </section>

  {/* ── 5 · WAAR DE BEELDEN LANDEN ──────────────────────────────────────────
      Geen eurobedrag hier — dat is het werk van de prijspagina. */}
  <section class="kamer hiw-kamer" aria-labelledby="hiw-land">
    <header class="kamer-kop">
      <h2 id="hiw-land" class="hoog hoog-2">{c.landH}</h2>
      <p class="lopend">{c.landLede}</p>
    </header>
    <ul class="hiw-land" role="list">
      {c.land.map(([t2, b]) => (
        <li><span class="hiw-land-t">{t2}</span><span class="mono">{b}</span></li>
      ))}
    </ul>
    <p class="lopend hiw-land-noot">{c.landNote}</p>
  </section>

  {/* ── 6 · HET SLOT ────────────────────────────────────────────────────── */}
  <section class="paneel paneel-slot" aria-labelledby="hiw-slot">
    <h2 id="hiw-slot" class="hoog">{c.ctaH}</h2>
    <p class="lopend">{c.ctaBody}</p>
    <p class="acties">
      <a class="knop knop-inkt" href={lp('/test-sample')} data-track="hiw-sample">{c.ctaSampleBtn}</a>
      <a class="knop knop-lijn" href={lp('/start')}>{c.ctaStartBtn}</a>
      <a class="knop knop-lijn" href={c.wa} target="_blank" rel="noopener">WhatsApp</a>
    </p>
    <p class="lopend hiw-gidsen"><a href={lp('/faq')}>{c.faqCta}</a> · <span set:html={c.faqGuides} /></p>
    {/* vatNote() één keer per pagina, bij de enige prijs die erop staat. */}
    <p class="hiw-btw">{vatLead(lang)} <Note lang={lang} term={vatLabel('excl', lang)} wide>{vatDetail(lang)}</Note></p>
  </section>
</div>

<style>
  /* Alles begint BOVEN: de kop, en het beeld ernaast op dezelfde hoogte. De
     regel geldt voor alle openingsrasters op de site (8 september 2026). */
  .hiw-open { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, .85fr); gap: clamp(1.5rem, 5vw, 4rem); align-items: start; }
  .hiw-open .paneel-kop { margin-bottom: 0; gap: 1.1rem; }
  /* Liggend, niet staand — Lucas, 9 september 2026: een sectiebeeld naast
     tekst moet in één scherm passen. object-position houdt het onderwerp in
     beeld nu er boven en onder wordt bijgesneden. */
  .hiw-beeld { aspect-ratio: 3 / 2; }
  .hiw-beeld img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 34%; }

  .hiw-flow-kop { max-width: 46rem; }

  /* De belofte over de agenda: een uitspraak in de lopende tekst met een
     accentlijn ernaast, geen kaart. Ná de band, met lucht ervoor. */
