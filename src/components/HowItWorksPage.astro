const c = COPY[lang];

---

<!-- HERO -->
<section class="hero-editorial compact">
  {/* De foto en de sluier zitten in een STILLE vloer. Het masker dat de
      onderrand laat oplossen hangt daaraan en niet aan .bg zelf: die laag
      schuift met de parallax, en een masker schuift met zijn element mee —
      dan valt de uitdoving naast de rand die ze moet oplossen. */}
  <div class="hero-vloer rand-los-voet" aria-hidden="true">
    <div class="bg" style="background-image:url('/img/banners-04.webp')"></div>
    <div class="fade"></div>
  <div class="korrel-mee" aria-hidden="true"></div>
  </div>
  <div class="hero-editorial-content container">
    <h1 class="display" data-split-lines>{c.h1a}<br />{c.h1b}<em>{c.h1em}</em>{c.h1c}</h1>
    <p class="lead" style="margin-top:1.2rem;max-width:60ch">{c.lead}</p>
    <div class="flex" style="margin-top:1.8rem">
      <span class="magnet-wrap"><span class="magnet-inner"><a href={lp('/start')} class="btn btn-primary btn-lg" data-track="hiw-start">{c.ctaStart}</a></span></span>
      <a href={lp('/test-sample')} class="btn btn-ghost btn-lg">{c.ctaSample}</a>
    </div>
  </div>
</section>

<!-- ONE ORDER, FOLLOWED FROM END TO END. This section is what six were: the
     five figures the page carried, and then FigFlow, which replaced them for a
     day. What changed between FigFlow and this is not the drawing but the
     question it answers. FigFlow put all three services on screen as switches
     you could combine — a calculator, good for finding a price and useless for
     understanding a process, because there is no order and no story in it.
     This follows ONE service, and while you are in it the other two are not on
     the page. Lucas: "Ieder apart van elkaar."

     The gate promise stays in prose above it, where it has always been. It is
     the one claim on this page we would rather lose an order over than break,
     and it belongs in a sentence a reader cannot skim past rather than in a
     node on a diagram they might. -->
<section class="section-tight"><div class="container">
  <div class="section-head"><h2>{c.flowH}</h2></div>
  <p class="flow-lede reveal pending">{c.flowLede}</p>
  <div class="gate reveal pending">
    <p class="editorial-statement">{c.gateLead}</p>
    <p class="gate-body">{c.gateBody}</p>
  </div>
  <div class="reveal pending">
    <FigWalk lang={lang} />
  </div>
</div></section>

