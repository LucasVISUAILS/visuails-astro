  },
};

const c = COPY[lang];

// ── THE RATE TABLE THE FIGURE SHIPS TO THE BROWSER ───────────────────────────
// Every price FigFlow can show, precomputed here: one entry per (scope
// combination × product count). Seven priced combinations × FLOW_MAX counts is
// a few hundred short strings — well under 40 kB of JSON, a fraction of that
// gzipped — and it buys the thing that matters. The ladder is implemented ONCE,
// in src/data/pricing.js, and the browser only ever looks a key up.
//
// KEYED BY THE SWITCHES, NOT BY THE LADDER. The first draft keyed on the ladder
// name and left the browser to work out that catalog + lifestyle means the
// `complete` rung — which put that rule in two places, and the two promptly
// disagreed: switching lifestyle off left the previous rung's "and every
// product drops to €109" standing under a catalog price. The key is now the
// literal state of the three switches, so there is no rule to duplicate and no
// state that can go stale, because every state has its own row.
//
// FLOW_MAX is 40 rather than the ladder's open top rung because a slider needs
// an end and 40 is a season. The last rung (35+) is reached and visible, which
// is the part that has to be true; anything beyond it prices identically.
const FLOW_MAX = 40;
const FLOW_START = 12;   // above WINDOW_THRESHOLD on purpose — the server-rendered
                         // state should be the one that shows the portal, since
                         // that is the half of the figure a no-JS reader would
                         // otherwise never see.

// No arrow functions in JSX attributes is the rule for MARKUP; this is
// frontmatter, where they are fine. Named anyway, because a stack trace that
// says `rateRow` beats one that says `<anonymous>`.
function ladderFor(cat, life) {
  if (cat && life) return 'complete';
  if (cat) return 'catalog';
  if (life) return 'lifestyle';
  return null;
}

function rateRow(cat, life, vid, n) {
  const kind = ladderFor(cat, life);
  if (!kind && !vid) return null;   // nothing switched on — nothing to quote

  const q = kind ? quote(kind, n) : null;
  // The headline is what ONE product costs at the scope on screen. A clip is
  // priced per product like everything else, so it belongs in that figure
  // rather than in a footnote the reader has to add up themselves.
  const perProduct = (q ? q.rate : 0) + (vid ? AMOUNT.video : 0);
  const total = (q ? q.listTotal : 0) + (vid ? AMOUNT.video * n : 0);

  let next = null;
  if (q && q.nextRung) {
    const add = q.nextRung.addProducts;
    // The next rung's PER-PRODUCT figure, on the same basis as the headline —
    // clip included when the clip is switched on. Quoting the bare photo rung
    // next to a headline that includes the clip is two numbers that look like
    // they should match and do not.
    const to = euro(q.nextRung.rate + (vid ? AMOUNT.video : 0), lang);
    // WITH THE VAT LABEL. This sentence prints a price, and BRIEF-14's rule is
    // every number, not every block — the `excl. VAT` span belongs to the price
    // paragraph above and never reaches this one. It was unlabelled until a
    // review caught it.
    const vl = vatLabel('excl', lang);
    if (lang === 'nl') {
      next = add === 1
        ? `Nog één product en elk product zakt naar ${to} ${vl}.`
        : `Nog ${add} producten en elk product zakt naar ${to} ${vl}.`;
    } else {
      next = add === 1
        ? `One more product and every product drops to ${to} ${vl}.`
        : `${add} more products and every product drops to ${to} ${vl}.`;
    }
  }

  const unit = lang === 'nl' ? 'per product' : 'a product';
  const totalLine = lang === 'nl'
    ? `${n} ${n === 1 ? 'product' : 'producten'} · ${euro(total, lang)} totaal`
    : `${n} ${n === 1 ? 'product' : 'products'} · ${euro(total, lang)} total`;

  return { rate: euro(perProduct, lang), per: unit, total: totalLine, next };
}

// The key is the switch state, digit by digit, then the count: "110:12" is
// catalog on, lifestyle on, video off, twelve products. Built the same way on
// both sides — see flowKey() in src/scripts/flow.js.
const flowRates = {};
for (const cat of [0, 1]) {
  for (const life of [0, 1]) {
    for (const vid of [0, 1]) {
      for (let n = 1; n <= FLOW_MAX; n++) {
        const row = rateRow(!!cat, !!life, !!vid, n);
        if (row) flowRates[`${cat}${life}${vid}:${n}`] = row;
      }
    }
  }
}

// The timing strings. turnaround() and nothing else — pricing.js's header calls
// this the only sanctioned source, and a figure that flips between two tiers is
// exactly the surface tempted to type "2–4 days" by hand.
const flowTiming = {
  attended: turnaround('attended', lang),
  unattended: turnaround('unattended', lang),
};
