{/* ═══ /how-it-works IN DE STIJL VAN SECTIE 22 — 7 september 2026 ═══════════
    Tiende pagina in de stijl. De inhoud is onaangeraakt: dezelfde COPY in
    beide talen, dezelfde <FigWalk>, <Compare grade> en <FigApproval>, dezelfde
    <Note> over de btw. Alleen de opmaak verandert.

    DE HERO WAS EEN FULL-BLEED FOTO MET TEKST EROVERHEEN. Die vorm — een beeld
    onder een sluier met een kop erop — is precies wat deze stijl niet doet: het
    beeld staat ernaast en niet eronder, zodat het beeld beeld blijft. De foto
    (banners-04) staat er dus nog, in een kaart naast de kop.

    DE BELOFTE OVER DE POORT BLIJFT PROZA. Het is de ene bewering op deze pagina
    waarvoor we liever een bestelling verliezen dan hem breken, en die hoort in
    een zin te staan waar een lezer niet langs kan scrollen — niet in een knoop
    van een tekening die hij misschien overslaat. */}
<div class="s22">

  {/* ── 1 · DE OPENING ───────────────────────────────────────────────────── */}
  <section class="paneel" aria-labelledby="hiw-h1">
    <div class="hiw-open">
      <div class="paneel-kop">
        <h1 id="hiw-h1" class="hoog">{c.h1a} <br />{c.h1b}<em>{c.h1em}</em>{c.h1c}</h1>
        <p class="lopend">{c.lead}</p>
        <p class="acties">
          <a class="knop knop-inkt" href={lp('/start')} data-track="hiw-start">{c.ctaStart}</a>
          <a class="knop knop-lijn" href={lp('/test-sample')}>{c.ctaSample}</a>
        </p>
      </div>
      <span class="kaart kaart-stil hiw-beeld">
        <img src="/img/banners-04.webp" alt="" width="928" height="1152" loading="eager" fetchpriority="high" decoding="async" />
      </span>
    </div>
  </section>

  {/* ── 2 · ÉÉN BESTELLING, VAN BEGIN TOT EIND ──────────────────────────────
      Deze sectie is wat er zes waren. <FigWalk> volgt ÉÉN dienst, en zolang je
      daarin zit staan de andere twee niet op de pagina. Lucas: *"Ieder apart
      van elkaar."* */}
  <section class="paneel" aria-labelledby="hiw-flow">
    <header class="paneel-kop">
      <h2 id="hiw-flow" class="hoog hoog-2">{c.flowH}</h2>
      <p class="lopend">{c.flowLede}</p>
    </header>
    <div class="hiw-poort">
      <p class="hoog hoog-3 hiw-poort-kop">{c.gateLead}</p>
      <p class="lopend">{c.gateBody}</p>
    </div>
    <FigWalk lang={lang} />
  </section>

  {/* ── 3 · MET DE HAND AFGEMAAKT ────────────────────────────────────────── */}
  <section class="paneel" aria-labelledby="hiw-hand">
    <div class="hiw-twee">
      <Compare
        grade
        before="/img/lifestyle-glow-06.webp"
        after="/img/lifestyle-glow-06.webp"
        beforeAlt={c.beforeAlt}
        afterAlt={c.afterAlt}
      />
      <div class="hiw-hand">
        <h2 id="hiw-hand" class="hoog hoog-2">{c.craftH}</h2>
        <p class="lopend">{c.craftBody}</p>
        <ul class="hiw-chips" role="list">
          {c.chips.map((chip) => <li>{chip}</li>)}
        </ul>
      </div>
    </div>
  </section>

  {/* ── 4 · HET PORTAAL ────────────────────────────────────────────────────
      De enige plek op de pagina die over goedkeuren gaat. De drie pagina's
      onderaan waren nergens vandaan bereikbaar (gemeten op de gebouwde site,
      21 aug 2026); dit is waar iemand staat die wil weten hoe het werkt, dus
      hier horen ze. */}
  <section class="paneel" aria-labelledby="hiw-portaal">
    <div class="hiw-twee">
      <div class="hiw-portaal">
        <h2 id="hiw-portaal" class="hoog hoog-2">{c.portalH}</h2>
        <p class="lopend">{c.portalBody}</p>
        <p class="lopend hiw-portaal-noot">{c.portalNote}</p>
        <p class="mono hiw-verder">
          {c.verderH}{' '}
          {/* De /demo-link stond hier en /demo bestaat niet — 26 augustus 2026,
              gevonden door audit-links.mjs. `verderDemo` blijft als tekst
              bestaan zodat de regel terug kan zodra de pagina er is. */}
          <a href={lp('/studio')}>{c.verderStudio}</a>{' · '}
          <a href={lp('/about')}>{c.verderAbout}</a>
        </p>
      </div>
      <FigApproval
        head={c.portalFigH}
        okLabel={c.portalFigOk}
        revLabel={c.portalFigRev}
        waitLabel={c.portalFigWait}
        note={c.portalFigNote}
      />
    </div>
  </section>

  {/* ── 5 · DE DETAILS ───────────────────────────────────────────────────── */}
  <section class="paneel" aria-labelledby="hiw-details">
    <header class="paneel-kop">
      <h2 id="hiw-details" class="hoog hoog-2">{c.detailsH}</h2>
    </header>
    <ul class="hiw-details" role="list">
      {c.details.map((d) => (
        <li>
          <b>{d.t}</b>
          <span class="lopend">{d.b}{d.linkText ? <> <a href={lp(d.linkHref)}>{d.linkText}</a>.</> : null}</span>
        </li>
      ))}
    </ul>
  </section>

  {/* ── 6 · WAAR DE BEELDEN LANDEN ──────────────────────────────────────────
      Verhuisd van de homepage. Het rekent de prijs om naar stukskosten zonder
      korting te geven: een seizoenstotaal is geen bedrag meer maar een bedrag
      gedeeld door ruwweg tweehonderd plaatsingen. Er staat met opzet geen enkel
      eurobedrag in — dat is het werk van de prijspagina. */}
  <section class="kamer hiw-kamer" aria-labelledby="hiw-land">
    <header class="kamer-kop">
      <h2 id="hiw-land" class="hoog hoog-2">{c.landH}</h2>
      <p class="lopend">{c.landLede}</p>
    </header>
    <ul class="hiw-land" role="list">
      {c.land.map(([t, b]) => (
        <li><span class="hiw-land-t">{t}</span><span class="mono">{b}</span></li>
      ))}
    </ul>
    <p class="lopend hiw-land-noot">{c.landNote}</p>
  </section>

  {/* ── 7 · DE VRAGEN STAAN ERGENS ANDERS ────────────────────────────────── */}
  <section class="paneel" aria-labelledby="hiw-faq">
    <header class="paneel-kop">
      <h2 id="hiw-faq" class="hoog hoog-2">{c.faqH}</h2>
      <p class="lopend hiw-gidsen" set:html={c.faqGuides} />
    </header>
    <p class="acties"><a class="knop knop-lijn" href={lp('/faq')}>{c.faqCta}</a></p>
  </section>

  {/* ── 8 · HET SLOT ────────────────────────────────────────────────────── */}
  <section class="paneel paneel-slot" aria-labelledby="hiw-slot">
    <h2 id="hiw-slot" class="hoog">{c.ctaH}</h2>
    <p class="lopend">{c.ctaBody}</p>
    <p class="acties">
      <a class="knop knop-inkt" href={lp('/test-sample')} data-track="hiw-sample">{c.ctaSampleBtn}</a>
      <a class="knop knop-lijn" href={lp('/start')}>{c.ctaStartBtn}</a>
      <a class="knop knop-lijn" href={c.wa} target="_blank" rel="noopener">WhatsApp</a>
    </p>
    {/* vatNote() één keer per pagina. Elk bedrag hier draagt zijn eigen
        excl.-btw-label; dit is de ene regel die zegt hoe de btw echt werkt. Hij
        staat hier en niet onder de doorloop, want hier staat de enige prijs van
        de pagina — een btw-regel onder een figuur zonder bedrag is een voetnoot
        bij niets. */}
    <p class="hiw-btw">{vatLead(lang)} <Note lang={lang} term={vatLabel('excl', lang)} wide>{vatDetail(lang)}</Note></p>
  </section>
</div>

<style>
  .hiw-open { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, .85fr); gap: clamp(1.5rem, 5vw, 4rem); align-items: center; }
  .hiw-open .paneel-kop { margin-bottom: 0; gap: 1.1rem; }
  .hiw-beeld { aspect-ratio: 4 / 5; }
  .hiw-beeld img { width: 100%; height: 100%; object-fit: cover; }

  /* De belofte over de poort. Een blok met een gele lijn ernaast en niet een
     kaart: het is een uitspraak in de lopende tekst en geen los ding. */
  .hiw-poort { display: grid; gap: .8rem; max-width: 44rem; margin-bottom: clamp(2.5rem, 5vw, 4rem); padding-left: clamp(1rem, 2.5vw, 1.8rem); border-left: 2px solid var(--geel); }
  .hiw-poort-kop { max-width: 24em; }

  .hiw-twee { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(1.5rem, 4vw, 3.5rem); align-items: center; }
  .hiw-hand, .hiw-portaal { display: grid; gap: 1rem; align-content: center; }
  .hiw-chips { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: .4rem; }
  .hiw-chips li { font-family: var(--mono2); font-size: .72rem; font-stretch: 82%; letter-spacing: .04em; text-transform: uppercase; color: var(--inkt-2); border: 1px solid var(--lijn); border-radius: 999px; padding: .4rem .85rem; }
  .hiw-portaal-noot { font-size: .92rem; }
  .hiw-verder { color: var(--inkt-2); }
  .hiw-verder a { color: var(--inkt); text-decoration: underline; text-underline-offset: 3px; text-decoration-color: var(--geel); text-decoration-thickness: 2px; }

  /* De details als regels en niet als kaartjes: het zijn korte antwoorden op
     losse vragen, en twaalf kaders zetten twaalf keer een rand om één zin. */
  .hiw-details { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 clamp(1.5rem, 4vw, 3.5rem); }
  .hiw-details li { display: grid; gap: .4rem; align-content: start; padding: clamp(1rem, 2.2vw, 1.5rem) 0; border-top: 1px solid var(--lijn); }
  .hiw-details b { font-family: var(--kop2); font-weight: 500; font-stretch: 125%; font-size: 1.05rem; text-transform: uppercase; letter-spacing: -.01em; }
  .hiw-details .lopend { font-size: .92rem; }
  .hiw-details a { color: var(--inkt); text-decoration: underline; text-underline-offset: 3px; text-decoration-color: var(--geel); text-decoration-thickness: 2px; }

  .hiw-land { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: clamp(1rem, 2.5vw, 2rem); }
  .hiw-land li { display: grid; gap: .4rem; align-content: start; padding-top: 1rem; border-top: 1px solid rgb(245 245 245 / .18); }
  .hiw-land-t { font-family: var(--kop2); font-weight: 500; font-stretch: 125%; font-size: clamp(1.05rem, 1.8vw, 1.35rem); text-transform: uppercase; letter-spacing: -.01em; }
  .hiw-land li .mono { color: rgb(245 245 245 / .66); text-transform: none; letter-spacing: 0; font-size: .88rem; line-height: 1.5; }
  .hiw-land-noot { margin-top: clamp(1.6rem, 3vw, 2.4rem); font-size: .92rem; }

  .hiw-gidsen :global(a) { color: var(--inkt); text-decoration: underline; text-underline-offset: 3px; text-decoration-color: var(--geel); text-decoration-thickness: 2px; }
  .hiw-btw { margin-top: 1.6rem; font-size: .84rem; line-height: 1.6; max-width: 70ch; }

  @media (max-width: 900px) {
    .hiw-open, .hiw-twee, .hiw-details { grid-template-columns: 1fr; }
    .hiw-land { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
