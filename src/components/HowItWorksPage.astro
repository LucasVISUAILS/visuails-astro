    detailsH: 'The details that matter',
    details: [
      { t: 'Turnaround', b: `From ${WINDOW_THRESHOLD} products: ${turnaround('attended', 'en').toLowerCase()}. Below that: ${turnaround('unattended', 'en').toLowerCase()}, ${TIERS.unattended.queue.en.toLowerCase()}.` },
      { t: 'If something is off', b: `From ${WINDOW_THRESHOLD} products: ${aftercare('attended', 'en').toLowerCase()}. Below that: ${aftercare('unattended', 'en').toLowerCase()}.` },
