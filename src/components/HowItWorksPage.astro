    // FigCapacity's whole argument and the reason it was a figure at all.
    flowGatePass: 'The calendar can hold it',
    flowGateRefuse: 'It cannot — and then you are told that, with the next window that can, instead of a date invented to keep the order',
    flowGateNote: 'Checked before anything is charged. It is the one promise on this site we would rather lose an order over than break.',

    flowMake: [
      { t: 'Produced', b: 'Every product in the order runs together, which is what makes the lighting, the angle and the grade match across all of them.' },
