    // a question already is, and it says which questions the FAQ does not take.
    faqGuides: `The FAQ answers the practical ones; the longer reads — how to shoot the photo you send us, what a shoot day actually costs — are in the <a href="${lp('/guides')}">guides</a>.`,
    faqCta: 'Read the FAQ',

    ctaH: 'One of your own products, as a catalog set or a carousel.',
    ctaBody: `One test sample per business — ${sample}, no commitment. It runs through the same production as a paid order.`,
    ctaSampleBtn: TEST_SAMPLE.en.cta,
    ctaStartBtn: 'Start an order',
    wa: waHref("Hi VISUAILS, I have a question about how an order works."),
  },

  nl: {
    h1a: 'Eén map erin.',
    h1b: 'Een hele ',
