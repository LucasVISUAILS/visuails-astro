    ],
    hoeFoot: 'Er gaat geen product van jou in, dus je hoeft ons maandelijks niets te sturen. Na de opzet doe jij niets meer.',

    prijsH: 'Wat Editions kost',
    prijsMaand: `<strong>${maand} per maand</strong> ${vatLabel('excl', 'nl')}, bovenop je abonnement.`,
    prijsOpzet: `<strong>${opzet} eenmalig</strong> om je merk op te zetten: de stijl, de locaties en het kleurenpalet waar elke maand daarna op draait.`,
    prijsWaaromH: 'Waarom twee bedragen en niet één',
    prijsWaarom: 'Omdat er twee verschillende dingen gebeuren. De opzet is werk dat één keer per merk gedaan wordt; de maand is de set zelf. De opzet in het maandbedrag vouwen zou hem uitsmeren over maanden waar je nog niet aan vastzit — en dan hangt de prijs stilletjes af van hoe lang je blijft.',
    zekerH: 'Waar je op kunt rekenen.',
    zeker: [
      `${STOCK_ON_BRAND} beelden per maand, of je nu iets nieuws te fotograferen had of niet`,
      'Voor één merk gemaakt en aan één merk geleverd — niemand anders krijgt deze set',
      'In VISUAILS Studio bij je bestellingen, niet in een aparte bibliotheek',
      reviewClaim('unattended', 'nl'),
    ],
    prijsCta: 'Praat met ons over Editions',

    rechtMeta: '( Rechten en vermelding )',
    rechtH: 'Gedeeld betekent gedeeld, en dat zeggen we liever hier dan in de kleine lettertjes.',
    rechtP: [
      'Onze klanten zijn kledingmerken, en dus elkaars concurrenten. Twee merken die hetzelfde beeld plaatsen staan in dezelfde feed voor dezelfde koper, dus een gedeelde set is geen detail om weg te stoppen — het is het eerste wat je moet weten over de helft die niets kost.',
      'De twee sets dragen daarom twee verschillende licenties, en in het bestand dat meekomt staat welke van de twee je hebt. De gedeelde set is niet-exclusief: van jou om te bewerken, te publiceren en commercieel te gebruiken, en van jou om te houden als je opzegt, maar hetzelfde beeld kan bij een ander merk opduiken. Editions is exclusief, net als elke bestelling die je plaatst — niemand anders mag die beelden gebruiken.',
    ],
    rechtLijst: [
      ['Allebei met AI gemaakt, en dat staat in het bestand', `Elk bestand draagt een machineleesbare herkomsttag. Omdat er geen foto van jou in zit, dragen deze de sterkste van de twee waardes — “door een model gemaakt” en niet “deels door een model gemaakt”. De zichtbare vermelding op je eigen post plaats je nog steeds zelf; op <a href="${lp('/ai-act')}">de AI-verordeningspagina</a> staat de zin.`],
      ['Geen gezichten, in geen van beide sets', 'Modellen per set kiezen maakt van een maandelijkse ronde elke keer een controleronde, en dát is wat het duur zou maken. Verandert dat, dan staat het hier als eerste.'],
      ['Zeg je op, dan hou je wat je hebt opgehaald', 'Allebei de licenties blijven na het abonnement staan. Er hoeft niets offline; je krijgt alleen geen nieuwe sets meer.'],
    ],

    faqH: 'Vragen over Editions, beantwoord',
    faqs: serviceFaqs('editions', 'nl'),
    ctaH: 'Vul de maand waar<br>je niets voor hebt.',
    ctaP: `${STOCK_OFF_BRAND} gedeelde beelden zitten bij elk abonnement. ${STOCK_ON_BRAND} eigen beelden kosten ${maand} per maand, na een opzet van ${opzet}.`,
    belofte: 'Geen van beide sets loopt al, dus er valt vandaag niets te kopen en er wordt niets afgeschreven. Waar deze pagina voor is: dat je weet welke helft inbegrepen is en welke niet, vóór de eerste factuur in plaats van erna.',
  },
};
const c = COPY[lang];
---

<!-- ── 1 · HERO ──────────────────────────────────────────────────────────── -->
<section class="page-hero">
  <div class="container two-col hero-split">
    <div class="reveal pending">
      <span class="eyebrow-page">{c.eyebrow}</span>
      <h1 class="display ed-h1" style="margin-top:1rem" set:html={c.h1} />
      <p class="lead" style="margin-top:1.2rem">{c.lead}</p>
      <div class="flex" style="margin-top:1.8rem">
        <span class="magnet-wrap"><span class="magnet-inner"><a href={lp('/contact')} class="btn btn-primary btn-lg">{c.ctaPrimary}</a></span></span>
        <a href={lp('/plans')} class="btn btn-ghost btn-lg">{c.ctaPlans}</a>
        <a href={c.wa} class="btn btn-wa" target="_blank" rel="noopener">{c.waLabel}</a>
      </div>
      <ServiceSwitch current={['complete']} lang={lang} />
      <HeroFacts eigen={c.trust} lang={lang} />
      <p class="queue-note"><em class="ed-soon">{c.soonTag}</em> {c.queueNote}</p>
    </div>
    <div class="reveal pending">
      <Placeholder lang={lang} ratio={r('maandgrid')} caption={false} subject={p('maandgrid', 'subject')} message={p('maandgrid', 'message')} />
    </div>
  </div>
</section>

<!-- ── 2 · DE VERGELIJKING ────────────────────────────────────────────────
     Direct onder de hero, en dat is het verschil met elke andere dienstpagina.
     Zie de kop van dit bestand: de vraag die deze pagina beantwoordt IS een
     vergelijking, dus staat hij vooraan en niet als naslag onderaan.

     De vorm komt van TierCompare: twee kaarten met dezelfde rijen, gelijk
     opgemaakt. Gelijk opgemaakt is hier geen esthetische keuze maar de
     boodschap — zodra één van de twee een accentkleur of een lint krijgt,
     pleit het blok voor een van de twee in plaats van ze uit elkaar te houden.
     En de linker is de gratis helft, dus juist die mag niet wegvallen. -->
<section class="section-tight">
  <div class="container">
    <div class="section-head">
      <h2 class="section-h">{c.vglH}</h2>
      <p class="lead">{c.vglSub}</p>
    </div>
    <div class="ed-vgl reveal-group">
      {[c.gedeeld, c.eigen].map((kolom) => (
        <div class="ed-vgl-col reveal pending">
          <div class="ed-vgl-kop">
            <h3>{kolom.naam}</h3>
            <span class="ed-vgl-tag">{kolom.tag}</span>
          </div>
          <dl class="ed-vgl-rijen">
            {kolom.rijen.map(([label, waarde]) => (
              <div class="ed-vgl-rij">
                <dt>{label}</dt>
                <dd>{waarde}</dd>
              </div>
            ))}
          </dl>
          <a href={lp(kolom.href)} class="link-arrow ed-vgl-cta">
            {kolom.cta}
            <svg viewBox="0 0 24 24" class="i" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
        </div>
      ))}
    </div>
    <p class="ed-vgl-foot">{c.vglFoot}</p>
  </div>
</section>

<!-- ── 3 · WAT HET NIET IS ────────────────────────────────────────────────
     Twee beelden naast elkaar, en allebei nodig: één ervan laten zien legt
     niets uit. Zie punt 2 in de kop van dit bestand. -->
<section class="section-tight">
  <div class="container">
    <div class="section-head">
      <h2 class="section-h">{c.nietH}</h2>
      <p class="lead">{c.nietSub}</p>
    </div>
    <div class="ed-niet reveal-group">
      <div class="reveal pending">
        <Placeholder lang={lang} ratio={r('welProduct')} caption={false} subject={p('welProduct', 'subject')} message={p('welProduct', 'message')} />
        <h3 class="ed-niet-h">{c.nietA[0]}</h3>
        <p class="ed-niet-p">{c.nietA[1]}</p>
      </div>
      <div class="reveal pending">
        <Placeholder lang={lang} ratio={r('geenProduct')} caption={false} subject={p('geenProduct', 'subject')} message={p('geenProduct', 'message')} />
        <h3 class="ed-niet-h">{c.nietB[0]}</h3>
        <p class="ed-niet-p">{c.nietB[1]}</p>
      </div>
    </div>
    <p class="ed-vgl-foot">{c.nietFoot}</p>
  </div>
</section>

<!-- ── 4 · WAAR ZE VOOR ZIJN ──────────────────────────────────────────── -->
<section class="section-tight">
  <div class="container">
    <div class="ed-head">
      <span class="ed-meta">{c.gebruikMeta}</span>
      <div>
        <h2>{c.gebruikH}</h2>
        <p class="ed-sub">{c.gebruikSub}</p>
      </div>
    </div>
    <Placeholder lang={lang} space ratio={r('feed')} subject={p('feed', 'subject')} message={p('feed', 'message')} />
    <div class="svc-explain">
      <div class="svc-explain-main">
        <h3>{c.gebruikH}</h3>
        {c.gebruikP.map((alinea) => <p>{alinea}</p>)}
      </div>
      <aside class="svc-explain-side">
        <h3>{c.gebruikH2}</h3>
        <ul class="svc-where-list">
          {c.gebruik.map(([sterk, rest]) => (
            <li><strong>{sterk}</strong> — {rest}</li>
          ))}
        </ul>
      </aside>
    </div>
  </div>
</section>

<!-- ── 5 · HOE ON-BRAND GEMAAKT WORDT ────────────────────────────────────
     Vanaf hier gaat de pagina alleen nog over de BETAALDE helft. De gedeelde
     set heeft geen opzet, geen stappen en geen prijs — die is er gewoon. -->
<section class="section-tight">
  <div class="container">
    <div class="photo-split reveal pending">
      <div class="photo-split-media">
        <Placeholder lang={lang} ratio={r('opzet')} caption={false} subject={p('opzet', 'subject')} message={p('opzet', 'message')} />
      </div>
      <div>
        <h2>{c.hoeH}</h2>
        <div class="steps steps-stacked" style="margin-top:1.6rem">
          {c.hoe.map(([kop, tekst], i) => (
            <div class="step"><span class="step-n">{String(i + 1).padStart(2, '0')}</span><h3>{kop}</h3><p>{tekst}</p></div>
          ))}
        </div>
        <p class="ed-hoe-foot">{c.hoeFoot}</p>
      </div>
    </div>
  </div>
</section>

<!-- ── 6 · DRIE MAANDEN NAAST ELKAAR ──────────────────────────────────────
     Het antwoord op de enige echte bezwaarvraag bij een maandelijkse set: is
     het na drie maanden niet twaalf keer hetzelfde? Eén beeld, geen tekst — de
     vraag is visueel en het antwoord dus ook. -->
<section class="section-tight">
  <div class="container">
    <Placeholder lang={lang} ratio={r('twaalf')} subject={p('twaalf', 'subject')} message={p('twaalf', 'message')} />
  </div>
</section>

<!-- ── 7 · DE PRIJS ─────────────────────────────────────────────────────── -->
<section class="section-tight">
  <div class="container two-col">
    <div class="reveal pending">
      <h2>{c.zekerH}</h2>
      <ul class="checklist" style="margin-top:1.4rem">
        {c.zeker.map((li) => (
          <li><svg viewBox="0 0 24 24" class="i" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg><span>{li}</span></li>
        ))}
      </ul>
    </div>
    <div class="reveal pending ed-prijs">
      <h3>{c.prijsH}</h3>
      <p set:html={c.prijsMaand} />
      <p set:html={c.prijsOpzet} />
      <p class="ed-prijs-vlak"><strong>{c.prijsWaaromH}</strong> {c.prijsWaarom}</p>
      <div class="flex" style="margin-top:1.4rem">
        <a href={lp('/contact')} class="btn btn-primary">{c.prijsCta}</a>
        <a href={c.wa} class="btn btn-wa" target="_blank" rel="noopener">{c.waLabel}</a>
      </div>
    </div>
  </div>
</section>

<!-- ── 8 · RECHTEN EN VERMELDING ──────────────────────────────────────────
     Deze band staat op geen enkele andere dienstpagina, en dat is met reden:
     geen enkele andere dienst levert iets dat ook naar een ander merk gaat.
     Zie punt 3 in de kop van dit bestand. -->
<section class="section-tight">
  <div class="container">
    <div class="ed-head">
      <span class="ed-meta">{c.rechtMeta}</span>
      <div>
        <h2>{c.rechtH}</h2>
      </div>
    </div>
    <div class="svc-explain">
      <div class="svc-explain-main">
        {c.rechtP.map((alinea) => <p>{alinea}</p>)}
      </div>
      <aside class="svc-explain-side">
        <ul class="ed-recht-lijst">
          {c.rechtLijst.map(([kop, body]) => (
            <li><strong>{kop}</strong><span set:html={body} /></li>
          ))}
        </ul>
      </aside>
    </div>
  </div>
</section>

<section>
  <div class="container" style="max-width:760px">
    <h2 class="section-h">{c.faqH}</h2>
    <div class="faq-stack">
      {c.faqs.map((f) => (
        <Disclose summary={f.q} tone="panel">
          <p>{f.a}</p>
        </Disclose>
      ))}
    </div>
  </div>
</section>

<section class="section-tight">
  <div class="container">
    <div class="cta-band reveal pending">
      <h2 class="display" style="font-size:var(--t-page-h2)" set:html={c.ctaH} />
      <p class="lead" style="margin:1.2rem auto 0;text-align:center">{c.ctaP}</p>
      <div class="flex" style="justify-content:center;margin-top:2rem">
        <span class="magnet-wrap"><span class="magnet-inner"><a href={lp('/contact')} class="btn btn-primary btn-lg">{c.ctaPrimary}</a></span></span>
        <a href={lp('/plans')} class="btn btn-ghost btn-lg">{c.ctaPlans}</a>
        <a href={c.wa} class="btn btn-wa" target="_blank" rel="noopener">{c.waLabel}</a>
      </div>
      <p class="ed-belofte">{c.belofte}</p>
    </div>
  </div>
</section>

<style>
  .ed-h1 em { font-family: var(--font-editorial); font-style: italic; font-weight: 700; }
  .queue-note { margin-top: .9rem; font-size: .88rem; color: var(--ink-3); }

  /* Zelfde merkje als in de navigatie en op /hooks: één vorm voor één
     betekenis. Zie de noot bij .hk-soon in HooksPage.astro. */
  .ed-soon {
    display: inline-block; margin-right: .45rem; padding: .12rem .45rem;
    border: 1px solid var(--line-strong); border-radius: var(--r-sm);
    font-style: normal; font-size: .72rem; letter-spacing: .08em;
    text-transform: uppercase; color: var(--ink-3); vertical-align: .08em;
  }

  /* ── DE VERGELIJKING ──────────────────────────────────────────────────
     Twee kaarten met echte ruimte ertussen, en niet één doos met een streep
     erdoor — zie de lange noot bij .tierc-grid in TierCompare.astro, waar
     precies deze vorm is uitgezocht. De verhoging komt uit de `.lift`-groep
     in global.css, waar .ed-vgl-col nu bij staat; twee kopieën van dezelfde
     schaduw zijn twee dingen die uit elkaar kunnen lopen.

     GELIJK OPGEMAAKT, EN DAT IS DE BOODSCHAP. Geen accentkleur op een van de
     twee, geen lint, geen grotere kop. Zodra één kolom opvalt, pleit dit blok
     voor een van de twee in plaats van ze uit elkaar te houden — en de kolom
     die dan wegvalt is de GRATIS helft, precies degene die een klant moet
     zien voordat hij voor de andere betaalt. */
  .ed-vgl {
    margin-top: clamp(1.6rem, 3vw, 2.4rem);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(.9rem, 1.8vw, 1.4rem);
  }
  @media (max-width: 46rem) { .ed-vgl { grid-template-columns: minmax(0, 1fr); } }
  .ed-vgl-col {
    background: var(--surface);
    border-radius: var(--r-lg);
    padding: clamp(1.5rem, 2.8vw, 2.1rem);
    display: flex;
    flex-direction: column;
  }
  .ed-vgl-kop { display: flex; align-items: baseline; justify-content: space-between; gap: .8rem; flex-wrap: wrap; }
  .ed-vgl-kop h3 { font-size: clamp(1.05rem, 1.7vw, 1.25rem); line-height: 1.25; }
  /* Het etiket zegt WAT voor ding dit is en niet hoe goed het is, dus het is
     een label en geen keurmerk: geen vlak, geen kleur, alleen een rand. */
  .ed-vgl-tag {
    flex: 0 0 auto;
    padding: .12rem .5rem;
    border: 1px solid var(--line-strong); border-radius: var(--r-sm);
    font-size: .7rem; letter-spacing: .08em; text-transform: uppercase;
    color: var(--ink-3);
  }
  .ed-vgl-rijen { margin-top: var(--gap-head-block); flex: 1; }
  .ed-vgl-rij { padding: .85rem 0; border-top: 1px solid var(--line); }
  .ed-vgl-rij:first-child { border-top: 0; padding-top: 0; }
  .ed-vgl-rij dt { font-size: .72rem; font-weight: 600; color: var(--ink-3); }
  .ed-vgl-rij dd { margin: .3rem 0 0; color: var(--ink); font-size: .95rem; line-height: 1.45; }
  .ed-vgl-cta { margin-top: clamp(1.2rem, 2.4vw, 1.7rem); }
  /* De regel onder de twee kolommen, links uitgelijnd met de kop erboven —
     zie de noot bij .hk-krijg in HooksPage.astro over gecentreerde rijen
     tussen links uitgelijnde blokken. */
  .ed-vgl-foot {
    margin-top: clamp(1.4rem, 2.6vw, 2rem);
    font-size: .9rem; color: var(--ink-3);
    max-width: var(--measure-note, 68ch);
  }

  /* ── DIT WEL, DIT NIET ────────────────────────────────────────────────
     Twee vierkanten naast elkaar. Onder de 46rem onder elkaar en niet
     kleiner: het hele punt is dat je ze VERGELIJKT, en twee beelden van 160px
     naast elkaar op een telefoon vergelijk je niet. */
  .ed-niet {
    margin-top: clamp(1.6rem, 3vw, 2.4rem);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(1rem, 2.4vw, 1.8rem);
  }
  @media (max-width: 46rem) { .ed-niet { grid-template-columns: minmax(0, 1fr); } }
  .ed-niet-h { margin-top: 1rem; font-size: 1rem; font-weight: 700; color: var(--ink); }
  .ed-niet-p { margin-top: var(--gap-label-note); font-size: .92rem; color: var(--ink-2); line-height: 1.55; }

  .ed-hoe-foot { margin-top: clamp(1.4rem, 2.6vw, 1.9rem); font-size: .9rem; color: var(--ink-3); }

  /* Het prijsblok, zelfde vorm als .buy-note op /video en .hk-prijs op
     /hooks: volle rand, geen nesting, geen accenttint. */
  .ed-prijs { border: 1px solid var(--line-strong); padding: clamp(1.4rem, 3vw, 2rem); }
  .ed-prijs h3 { font-family: var(--font-display); font-weight: 800; font-size: 1.15rem; letter-spacing: -0.01em; }
  .ed-prijs p { margin-top: var(--gap-label-note); color: var(--ink-2); }
  .ed-prijs p :global(strong) { color: var(--ink); font-weight: 600; }
  .ed-prijs .ed-prijs-vlak {
    margin-top: 1.1rem; padding-top: 1rem;
    border-top: 1px solid var(--line);
    font-size: .9rem; line-height: 1.55; color: var(--ink-3);
  }
  .ed-prijs .ed-prijs-vlak strong { color: var(--ink); font-weight: 700; }

  /* De rechtenlijst in de zijkolom. Zelfde ritme als .svc-where-list, maar met
     een kop per regel omdat er drie afzonderlijke afspraken in staan en geen
     opsomming van plekken. */
  .ed-recht-lijst { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.1rem; }
  .ed-recht-lijst li { display: grid; gap: .3rem; padding-top: .9rem; border-top: 1px solid var(--line); }
  .ed-recht-lijst li:first-child { padding-top: 0; border-top: 0; }
  .ed-recht-lijst strong { color: var(--ink); font-size: .95rem; }
  .ed-recht-lijst span { color: var(--ink-2); font-size: .9rem; line-height: 1.55; }
  .ed-recht-lijst :global(a) { color: var(--accent-bright); text-decoration: underline; text-underline-offset: 3px; }

  .faq-stack { display: flex; flex-direction: column; gap: .7rem; }

  .ed-belofte {
    max-width: 68ch;
    margin: clamp(2rem, 4vw, 2.8rem) auto 0;
    padding-top: clamp(1.2rem, 2.4vw, 1.6rem);
    border-top: 1px solid var(--line);
    text-align: center; font-size: .88rem; line-height: 1.6; color: var(--ink-3);
  }
</style>
