---
import { waHref } from '../data/whatsapp.js';
/*
 * VISUAILS — /editions en /nl/editions delen dit lichaam.
 *
 * ════════════════════════════════════════════════════════════════════════════
 * WAAROM DEZE PAGINA EEN ANDERE OPBOUW HEEFT DAN DE DIENSTPAGINA'S
 * ════════════════════════════════════════════════════════════════════════════
 *
 * Lucas, 2 september 2026: *"Bedenk een eigen opbouw hiervan omdat dit een extra
 * add-on product is voor mensen die een abonnement hebben lopen. Doe dit
 * zorgvuldig en maak het zo dat het makkelijk te begrijpen is wat wat is en
 * waarvoor dit soort beelden bedoelt zijn."*
 *
 * /catalog, /lifestyle, /video en /hooks beantwoorden allemaal dezelfde vraag —
 * "wat is dit en wil ik het" — en delen daarom één bandenvolgorde. Deze pagina
 * beantwoordt een andere vraag, en die is een vergelijking: er zijn TWEE soorten
 * beeld, de ene heb je al en de andere kost geld, en als een bezoeker dat
 * verschil niet binnen tien seconden ziet, is de pagina mislukt hoe mooi hij
 * verder ook is.
 *
 * Vandaar dat de vergelijking hier NIET onderaan staat waar TierCompare op de
 * dienstpagina's staat, maar direct onder de hero. Het is de ruggengraat en niet
 * een naslagblok. Alles daarna legt één van de twee kolommen uit.
 *
 * De onderdelen zijn wél dezelfde: `page-hero`, `ed-head`, `svc-explain`,
 * `photo-split`, `checklist`, `faq-stack`, `cta-band`, en `ServiceSwitch` en
 * `HeroFacts` in de hero. Een eigen VOLGORDE is niet hetzelfde als een eigen
 * taal.
 *
 * ════════════════════════════════════════════════════════════════════════════
 * DE DRIE DINGEN DIE DEZE PAGINA MOET VOORKOMEN
 * ════════════════════════════════════════════════════════════════════════════
 *
 * 1 · DAT IEMAND BETAALT VOOR WAT HIJ AL HEEFT. De gedeelde set van
 *     STOCK_OFF_BRAND beelden hoort bij ELK abonnement. Het dashboard zette hem
 *     tot 2 september onder "wat er zou komen" bij Editions, en dat sprak /plans
 *     tegen — een betalende klant las dus in zijn eigen scherm dat hij moest
 *     bijbetalen voor iets wat hij al had. Rechtgezet in account.js; deze pagina
 *     zegt het op drie plekken opnieuw, want het is de fout die geld kost.
 *
 * 2 · DAT IEMAND DENKT DAT HIER ZIJN PRODUCT IN ZIT. Er zit GEEN product van de
 *     klant in deze beelden — niet in de gedeelde set en niet in de on-brand
 *     set. Ze geven het merk een gevoel; ze verkopen geen artikel. Dat is het
 *     verschil met alles wat er verder op deze site staat, en het is de tweede
 *     band op de pagina omdat het de eerste verwarring is.
 *
 * 3 · DAT GEDEELD BEELD ALS EXCLUSIEF LEEST. Onze klanten zijn allemaal
 *     kledingmerken en dus elkaars concurrenten: twee abonnees die hetzelfde
 *     beeld posten, staan in dezelfde feed voor dezelfde koper. Dat mag geen
 *     kleine lettertjes worden. De modelkiezer noemt de gedeelde bibliotheek al
 *     met zoveel woorden gedeeld, en deze pagina doet hetzelfde — met een eigen
 *     band over rechten, die geen enkele andere dienstpagina heeft omdat geen
 *     enkele andere dienst iets deelt.
 *
 * ── DE PRIJS ──────────────────────────────────────────────────────────────
 *
 * € 149 per maand na een eenmalige opzet van € 295, allebei uit AMOUNT. Tot
 * 2 september stond er NERGENS een bedrag: niet in AMOUNT, niet als `null`, en
 * ook niet in STOCK-IDEE.md, dat het idee verder volledig beschrijft. Zie de
 * noot bij AMOUNT.editions voor waarom het er twee zijn en niet één.
 *
 * ── EN JE KUNT HET NOG NIET BESTELLEN ─────────────────────────────────────
 *
 * Net als bij Hooks: er is een prijs, en er is nog geen gewicht in KIND_IMAGES,
 * dus de agenda kan er niet mee rekenen. De knoppen gaan naar een gesprek.
 *
 * ── ELKE FOTO IS EEN PLACEHOLDER ──────────────────────────────────────────
 *
 * Er bestaat nog geen enkele set. Een bestaand lifestylebeeld lenen zou hier
 * precies het tegenovergestelde bewijzen van wat de pagina beweert, want die
 * beelden hébben een product erin.
 */
import {
  AMOUNT, euro, vatLabel, STOCK_OFF_BRAND, STOCK_ON_BRAND,
  reviewClaim, plans,
} from '../data/pricing.js';
/* Het woord voor deze beelden komt uit de lexicon en niet uit deze pagina:
   "stock photos" / "stockfoto's", enkelvoud en meervoud op één plek. Zie
   tests/woorden.test.mjs, dat de hele site op dat lijstje nakijkt. */
import { noun } from '../data/lexicon.js';
import { serviceFaqs } from '../data/faq.js';
import { localizedPath } from '../i18n/ui.js';
import Disclose from './Disclose.astro';
import ServiceSwitch from './ServiceSwitch.astro';
import HeroFacts from './HeroFacts.astro';
import Placeholder from './Placeholder.astro';

interface Props { lang: 'en' | 'nl'; }
const { lang } = Astro.props;
const nl = lang === 'nl';
const lp = (p: string) => localizedPath(lang, p);

const maand = euro(AMOUNT.editions, lang);
const opzet = euro(AMOUNT.editionsSetup, lang);
/* Het goedkoopste abonnement, om te kunnen zeggen waar de gedeelde set al bij
   zit. Uit plans() en niet ingetypt — zelfde reden als overal. */
const eerstePlan = plans(lang)[0];

/* ── DE BEELDPLEKKEN ──────────────────────────────────────────────────────
 *
 * Zes plekken, en twee ervan staan naast elkaar met opzet: op deze pagina moet
 * je ZIEN wat het verschil is tussen een beeld met een product erin en een beeld
 * zonder. Eén van de twee alleen laten zien legt niets uit.
 */
const PLEKKEN = {
  maandgrid: {
    ratio: '4 / 5',
    subject: {
      nl: `Een maandraster van ${STOCK_ON_BRAND} beelden voor één merk — steeds dezelfde kleuren en hetzelfde licht, en in geen enkel beeld een product`,
