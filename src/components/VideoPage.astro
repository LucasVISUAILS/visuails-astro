---
import { waHref } from '../data/whatsapp.js';
// VISUAILS — /video and /nl/video share this body.
//
// Same conversion as CatalogPage.astro and LifestylePage.astro: two 156-line
// inline pages, each holding its own copy of the prices, replaced by one body
// taking a `lang` prop. EN/NL parity becomes a property of the file layout.
//
// This page carried the worst price defect on the site. Its inline
// `videoStyles` literal — and src/data/videoStyles.js behind it — priced
// Lifestyle Video at €59, a figure that appears nowhere in pricing.js and
// never has. The sitewide price scan missed it for months because "€59" is a
// string prefix of "€59.99", so every occurrence was folded into the catalog
// lifestyle tally. There is one clip rate now and it comes from AMOUNT.video.
//
// WHY THIS PAGE STILL PRINTS ONE FIGURE WHERE /catalog AND /lifestyle PRINT A
// LADDER (August 2026 — section 0 of src/data/pricing.js). A catalog set and a
// lifestyle carousel are priced per PRODUCT and their rate falls as the count
// rises. A clip is not on that ladder: it is a flat rate per clip, the same
// inside an order as on its own, and that flatness is the claim this page has
// always made about it. So the figure here is genuinely one number — but it is
// one number that now has to say so, because a reader arriving from /pricing
// has just been shown a falling rate and will assume this one falls too.
//
// EVERY PRINTED PRICE CARRIES A VAT LABEL, from vatLabel() — BRIEF-14's
// hardest rule, and never a typed "excl. VAT".
//
// "DROP" IS NOT WHAT WE SELL. It means a collection going live to the brands
// we sell to; a work order is an order — in Dutch, een bestelling. "The same
// rate on its own or added to a drop" was the one line on this page that used
// the word for a work order, and it is the line the change matters most on,
// because it is the sentence about the price.
//
// SERVICE LEVEL FOLLOWS SIZE: from WINDOW_THRESHOLD products an order gets the
// reserved window, below it the standard queue.
import {
  TIERS, AMOUNT, euro, vatLabel, WINDOW_THRESHOLD, PLAN_CLIPS, plans,
  reviewClaim, turnaround,
} from '../data/pricing.js';
import { localizedPath } from '../i18n/ui.js';
import Disclose from './Disclose.astro';
import TierCompare from './TierCompare.astro';
import { videoStyles as videoStylesEn } from '../data/videoStyles.js';
import { videoStyles as videoStylesNl } from '../data/videoStyles.nl.js';

interface Props { lang: 'en' | 'nl'; }
const { lang } = Astro.props;
const lp = (p: string) => localizedPath(lang, p);

const kinds = lang === 'nl' ? videoStylesNl : videoStylesEn;

// One rate, flat. Formatted once here rather than at every call site, so the
// clip price and its VAT label cannot get separated by an edit.
const clip = euro(AMOUNT.video, lang);
const t0 = TIERS.unattended;

// The plan that includes clips, named rather than typed — /pricing says the
// same thing off the same two constants, so the two pages cannot disagree
// about how many clips a Studio month carries.
const studioPlan = plans(lang).find((pl) => pl.id === 'studio');

// Motion and Lifestyle Video are the two fixed-rate clips; Campaign and
// Custom are scoped and quoted. Keeping the rule here rather than in
// videoStyles.js means no euro figure lives in the style data at all — which
// is exactly how the stale €59 survived as long as it did.
const QUOTED = new Set(['campaign', 'custom']);

// w/h on both tables are the intrinsic pixel size of the file in public/img —
// the real photo, not the .photo-band / .photo-grid box it crops into. They
// are attributes, not layout: the browser needs the aspect ratio before the
// bytes arrive or the grid reflows under the reader (§12).
const posters: Record<string, { src: string; w: number; h: number }> = {
  motion: { src: '/img/banners-04.webp', w: 928, h: 1152 },
  lifestyle: { src: '/img/lifestyle-glow-03.webp', w: 768, h: 1376 },
  campaign: { src: '/img/banners-08.webp', w: 928, h: 1152 },
  custom: { src: '/img/banners-13.webp', w: 2400, h: 1792 },
};

const strip = [
  { src: '/img/banners-01.webp', wide: true, key: 'campaign', w: 928, h: 1152 },
  { src: '/img/lifestyle-flash-02.webp', wide: false, key: 'flash', w: 1340, h: 2400 },
  { src: '/img/lifestyle-phone-made-09.webp', wide: false, key: 'phone', w: 2400, h: 1792 },
  { src: '/img/lifestyle-dunes-02.webp', wide: false, key: 'dunes', w: 928, h: 1152 },
  { src: '/img/banners-06.webp', wide: true, key: 'campaign', w: 928, h: 1152 },
];

// No `as const` — COPY[lang] on a const-asserted object gives a union of
// readonly tuples and .map() on that union is a TS error.
const COPY = {
  en: {
    eyebrow: 'Video',
    h1: 'Short product videos<br />that <em>move</em>.',
    lead: `8 seconds, subtle motion. ${clip} per clip, ${vatLabel('excl', 'en')} — the same rate whether it is one clip or twenty.`,
    // SECTION 13: Tier 0 "must NOT appear ... in any hero." See CatalogPage for
    // the full note. Used in the hero and the closing band; the buy block lower
    // down names the tier from TIERS.unattended.label instead.
    ctaPrimary: 'Start an order',
    wa: waHref("Hi VISUAILS, I'd like to talk about a product video."),
    waQuote: waHref("Hi VISUAILS, I'd like a quote for a campaign video."),
    waLabel: 'WhatsApp',
    waQuoteLabel: 'Quote a campaign',
    // The third hero button. /catalog and /lifestyle both offer it and this
    // page did not, so the one service page whose price is a single flat
    // figure was also the one that gave a visitor no way to see the figure in
    // context. It says "pricing" rather than "the price ladder": a clip is not
    // on the ladder, and sending someone to look for a falling rate that does
    // not exist for this service is the confusion buyFlat exists to prevent.
    ctaPrices: 'See pricing',
    trust: [
      ['8s', 'clean product videos'],
      [clip, `per clip · ${vatLabel('excl', 'en')}`],
    ],
    // Visible, not buried. Section 13: a visitor must not be able to leave
    // this page believing a delivery date was promised — and now that size
    // decides the service level, the line names the count as well.
    queueNote: `Under ${WINDOW_THRESHOLD} products: ${t0.queue.en.toLowerCase()}. From ${WINDOW_THRESHOLD}, we hold a delivery date for the order and confirm it in writing.`,
    reviewNote: reviewClaim('unattended', 'en'),
    kindsH: 'Ways to add motion.',
    perClip: `${clip} / clip · ${vatLabel('excl', 'en')}`,
    quoted: 'Quoted per project',
    exampleAlt: (n: string) => `${n} example`,
    edMeta: '( Where it fits )',
    edH: 'Product video: motion where a still photo plateaus.',
    edSub: 'A few seconds of movement, made for feeds and ads.',
    whatH: 'What it is',
    whatP: [
      'A product video is a short, clean film with subtle motion — a slow turn, a drape, a catch of light — built to give a product life without a full production. On a feed tuned for movement, a few seconds of motion earns attention a static image can’t, and holds it long enough to land the message.',
      "It isn't a replacement for your photos; it's the layer on top that lifts them where it counts. The same product that sits still on your shop can move in your ads and socials, where dwell time and click-through decide whether people stop — or keep scrolling.",
    ],
    // Brief §1: every service page links to /custom-models. It goes here,
    // in the paragraph about what a clip is, because "who is in it" is a real
    // question a clip raises and the answer is the same face as the stills.
    modelNote: `Where a person appears in the clip, that person can be <a href="${lp('/custom-models')}">a Brand Model made only for you</a> — the same face your catalog and lifestyle sets already run on.`,
    buyFlatH: 'Why the clip rate does not fall',
    whereH: 'Where it lives',
    where: [
      ['Reels, TikTok & Shorts', 'where motion is the native language.'],
      ['Paid ads', 'higher dwell time and click-through.'],
      ['Product pages', 'an autoplay clip beside the stills.'],
      ['Email & landing pages', 'a moment of life above the fold.'],
    ],
    stepsH: 'Three steps to a moving product.',
    steps: [
      ['Send a product photo', 'One clean still is enough to start.'],
      ['We add the motion', 'A slow turn, a drape, a catch of light — held subtle.'],
      [turnaround('unattended', 'en'), 'Sized for pages, social and ads.'],
    ],
    stepsAlt: 'A product video still from a VISUAILS Motion clip',
    cleanH: 'Clean motion, ready to publish.',
    clean: [
      '8-second video with subtle motion',
      'Sized for pages, social and ads',
      'Consistent style across your range',
      reviewClaim('unattended', 'en'),
    ],
    buyH: 'Two ways to buy video',
    // The whole point of the clip price: a video does not get cheaper or more
    // expensive for arriving with a collection. Photos are priced per product
    // on a falling ladder; a clip is priced per clip and stays put, which is
    // the difference this block now has to state out loud rather than imply.
    buyFixed: `<strong>Motion &amp; Lifestyle</strong> — a fixed ${clip} per clip, ${vatLabel('excl', 'en')}, on its own or added to any order.`,
    buyQuote: '<strong>Campaign</strong> — bigger, multi-shot, quoted per project.',
    buyFlat: `Catalog and lifestyle photos are priced per product and the rate falls as the count rises. A clip does not work that way: it is one rate, whatever else is in the order. ${studioPlan ? `${PLAN_CLIPS.studio} clips a month are included in the ${studioPlan.name} plan.` : ''}`,
    buyCta: 'Start an order',
    stripAlt: {
      campaign: 'Campaign photography',
      flash: 'Flash-style lifestyle visual',
      phone: 'Phone-made-style lifestyle visual',
      dunes: 'Dunes-style lifestyle visual',
    },
    faqH: 'Video questions, answered',
    faqs: [
      {
        q: 'What does a clip cost?',
        a: `${clip} ${vatLabel('excl', 'en')} per clip for Motion and Lifestyle Video, whether you order one or twenty. Campaign is bigger and multi-shot, so it is quoted per project.${studioPlan ? ` ${PLAN_CLIPS.studio} clips a month are included in the ${studioPlan.name} plan.` : ''}`,
      },
      {
        q: 'Why does the clip rate not fall with volume?',
        a: 'Catalog and lifestyle photos are priced per product, and that rate falls a step at a time as the count rises. A clip is not part of that price per product — the work per clip is the same whether it arrives alone or with fifty products, so the rate stays put. It is the same figure on its own as it is inside a larger order.',
      },
      {
        q: 'How long is a clip, and what do I get?',
        a: 'Eight seconds of subtle motion, exported at sizes that fit a product page, a feed and an ad — the same style held across your whole range, so clips ordered months apart still look like they belong together.',
      },
      {
        q: 'How long does it take?',
        a: `Under ${WINDOW_THRESHOLD} products: ${turnaround('unattended', 'en').toLowerCase()}. ${t0.queue.en} — an order of ${WINDOW_THRESHOLD} products or more already has a date held for it, so a busy week can move a smaller order. From ${WINDOW_THRESHOLD} products your own order is the one with the date: ${turnaround('attended', 'en').toLowerCase()}.`,
      },
      {
        q: 'Can a model appear in the clip?',
        a: 'Yes. Where a person appears, that person can come from the standard roster or be a Brand Model made only for you — the same face your catalog and lifestyle sets already run on, so a shopper sees one person across stills and motion alike.',
      },
      {
        q: 'What if I need changes?',
        a: `${t0.aftercare.en}. Tell us what is wrong and we go through it with you.`,
      },
    ],
    ctaH: 'Give your product<br>a little movement.',
    ctaP: `${clip} per clip, ${vatLabel('excl', 'en')} — ${turnaround('unattended', 'en').toLowerCase()} under ${WINDOW_THRESHOLD} products.`,
    ctaSecondary: 'Contact us',
  },
  nl: {
    eyebrow: 'Video',
    h1: 'Korte productvideo’s<br />die <em>bewegen</em>.',
    lead: `8 seconden, subtiele beweging. ${clip} per clip, ${vatLabel('excl', 'nl')} — hetzelfde tarief of het er nu één is of twintig.`,
    ctaPrimary: 'Start een bestelling',
    wa: waHref("Hoi VISUAILS, ik wil graag praten over een productvideo."),
    waQuote: waHref("Hoi VISUAILS, ik wil graag een offerte voor een campagnevideo."),
    waLabel: 'WhatsApp',
    waQuoteLabel: 'Offerte voor een campagne',
    ctaPrices: 'Bekijk de prijzen',
    trust: [
      ['8s', 'strakke productvideo’s'],
      [clip, `per clip · ${vatLabel('excl', 'nl')}`],
    ],
    queueNote: `Onder ${WINDOW_THRESHOLD} producten: ${t0.queue.nl.toLowerCase()}. Vanaf ${WINDOW_THRESHOLD} gaat de bestelling in de agenda en krijgt hij de vastgezette leverdatum.`,
    reviewNote: reviewClaim('unattended', 'nl'),
    kindsH: 'Manieren om beweging toe te voegen.',
    perClip: `${clip} / clip · ${vatLabel('excl', 'nl')}`,
    quoted: 'Offerte per project',
    exampleAlt: (n: string) => `${n} voorbeeld`,
    edMeta: '( Waar het past )',
    edH: 'Productvideo: beweging waar een foto niet verder komt.',
    edSub: 'Een paar seconden beweging, gemaakt voor feeds en ads.',
    whatH: 'Wat het is',
    whatP: [
      'Een productvideo is een korte, strakke film met subtiele beweging — een langzame draai, een val van stof, een lichtvonk — gemaakt om een product leven te geven zonder een volledige productie. Op een feed die op beweging is afgestemd, verdienen een paar seconden motion aandacht die een stilstaand beeld niet krijgt, en houden ze die lang genoeg vast om de boodschap te laten landen.',
      'Het is geen vervanging van je foto’s; het is de laag erbovenop die ze optilt waar het telt. Hetzelfde product dat stil staat op je shop kan bewegen in je ads en socials, waar kijktijd en doorklik bepalen of mensen stoppen — of verder scrollen.',
    ],
    modelNote: `Waar er een persoon in de clip verschijnt, kan dat <a href="${lp('/custom-models')}">een merkmodel zijn dat alleen voor jou gemaakt is</a> — hetzelfde gezicht waar je catalog- en lifestylesets al op draaien.`,
    buyFlatH: 'Waarom het cliptarief niet daalt',
    whereH: 'Waar het leeft',
    where: [
      ['Reels, TikTok & Shorts', 'waar alles beweegt.'],
      ['Betaalde ads', 'hogere kijktijd en doorklik.'],
      ['Productpagina’s', 'een autoplay-clip naast de stills.'],
      ['E-mail & landingspagina’s', 'iets dat leeft, meteen bij het eerste beeld.'],
    ],
    stepsH: 'Drie stappen naar een bewegend product.',
    steps: [
      ['Stuur een productfoto', 'Eén strakke still is genoeg om te beginnen.'],
      ['Wij brengen het in beweging', 'Een langzame draai, een val van stof, een lichtvonk — subtiel gehouden.'],
      [turnaround('unattended', 'nl'), 'Op maat voor pagina’s, social en advertenties.'],
    ],
    stepsAlt: 'Een still uit een VISUAILS Motion-clip',
    cleanH: 'Strakke beweging, klaar om te publiceren.',
    clean: [
      'Video van 8 seconden met subtiele beweging',
      'Op maat voor pagina’s, social en advertenties',
      'Consistente stijl door je hele assortiment',
      reviewClaim('unattended', 'nl'),
    ],
    buyH: 'Twee manieren om video te kopen',
    buyFixed: `<strong>Motion &amp; Lifestyle</strong> — een vaste ${clip} per clip, ${vatLabel('excl', 'nl')}, los of toegevoegd aan elke bestelling.`,
    buyQuote: '<strong>Campaign</strong> — groter, meerdere shots, offerte per project.',
    buyFlat: `Catalog- en lifestylefoto’s zijn geprijsd per product en dat tarief daalt naarmate het aantal stijgt. Bij een clip werkt dat niet zo: het is één tarief, wat er verder ook in de bestelling zit. ${studioPlan ? `${PLAN_CLIPS.studio} clips per maand zitten in het ${studioPlan.name}-plan.` : ''}`,
    buyCta: 'Start een bestelling',
    stripAlt: {
      campaign: 'Campagnefotografie',
      flash: 'Lifestyle-visual in Flash-stijl',
      phone: 'Lifestyle-visual in Phone-made-stijl',
      dunes: 'Lifestyle-visual in Dunes-stijl',
    },
    faqH: 'Video-vragen, beantwoord',
    faqs: [
      {
        q: 'Wat kost een clip?',
        a: `${clip} ${vatLabel('excl', 'nl')} per clip voor Motion en Lifestyle Video, of je er nu één bestelt of twintig. Campaign is groter en bestaat uit meerdere shots, dus die gaat op offerte per project.${studioPlan ? ` ${PLAN_CLIPS.studio} clips per maand zitten in het ${studioPlan.name}-plan.` : ''}`,
      },
      {
        q: 'Waarom daalt het cliptarief niet bij grotere aantallen?',
        a: 'Catalog- en lifestylefoto’s zijn geprijsd per product, en dat tarief zakt stap voor stap naarmate het aantal stijgt. Bij een clip werkt dat niet zo — het werk per clip is hetzelfde of hij nu alleen komt of met vijftig producten, dus het tarief blijft staan. Los is het hetzelfde bedrag als binnen een grotere bestelling.',
      },
      {
        q: 'Hoe lang is een clip, en wat krijg ik?',
        a: 'Acht seconden subtiele beweging, geëxporteerd op maten die passen op een productpagina, een feed en een advertentie — met dezelfde stijl door je hele assortiment, zodat clips die maanden uit elkaar besteld zijn nog steeds bij elkaar horen.',
      },
      {
        q: 'Hoe lang duurt het?',
        a: `Onder ${WINDOW_THRESHOLD} producten: ${turnaround('unattended', 'nl').toLowerCase()}. ${t0.queue.nl} — een bestelling van ${WINDOW_THRESHOLD} producten of meer staat al in de agenda en houdt zijn leverdatum vast, dus een drukke week kan een kleinere bestelling verschuiven. Vanaf ${WINDOW_THRESHOLD} producten is jouw bestelling degene met de leverdatum: ${turnaround('attended', 'nl').toLowerCase()}.`,
      },
      {
        q: 'Kan er een model in de clip?',
        a: 'Ja. Waar een persoon in beeld komt, kan die uit de standaardroster komen of een merkmodel zijn dat alleen voor jou gemaakt is — hetzelfde gezicht waar je catalog- en lifestylesets al op draaien, zodat een klant één persoon ziet in stills én in beweging.',
      },
      {
        q: 'Wat als ik wijzigingen nodig heb?',
        a: `${t0.aftercare.nl}. Laat weten wat er niet klopt, dan nemen we het samen door.`,
      },
    ],
    ctaH: 'Geef je product<br>een beetje beweging.',
    ctaP: `${clip} per clip, ${vatLabel('excl', 'nl')} — ${turnaround('unattended', 'nl').toLowerCase()} onder ${WINDOW_THRESHOLD} producten.`,
    ctaSecondary: 'Neem contact op',
  },
};

const c = COPY[lang];
const kindPrice = (slug: string) => (QUOTED.has(slug) ? c.quoted : c.perClip);
---

<section class="hero-editorial compact">
  <div class="bg" style="background-image:url('/img/banners-03.webp')"></div>
  <div class="fade"></div>
  <div class="hero-editorial-content container">
    <!-- The page label every other page component already prints. See
         CatalogPage.astro's own note: this and /catalog were the two service
         pages missing it. -->
    <span class="eyebrow-page">{c.eyebrow}</span>
    <h1 class="display vid-h1" style="font-size:clamp(2.8rem,6.5vw,5.4rem);margin-top:1rem" set:html={c.h1} />
    <p class="lead" style="margin-top:1.2rem">{c.lead}</p>
    <div class="flex" style="margin-top:1.8rem">
      <span class="magnet-wrap"><span class="magnet-inner"><a href={lp('/start')} class="btn btn-primary btn-lg">{c.ctaPrimary}</a></span></span>
      <a href={lp('/pricing')} class="btn btn-ghost btn-lg">{c.ctaPrices}</a>
      <a href={c.wa} class="btn btn-wa" target="_blank" rel="noopener">{c.waLabel}
      </a>
    </div>
    <div class="trust-row" style="margin-top:2.2rem">
      {c.trust.map(([strong, rest]) => (
        <span class="trust-item"><strong>{strong}</strong> {rest}</span>
      ))}
      <span class="trust-item tf-flag"><strong>{turnaround('unattended', lang)}</strong></span>
      <span class="trust-item tf-verify"><strong>{c.reviewNote}</strong></span>
    </div>
    <p class="queue-note">{c.queueNote}</p>
  </div>
</section>

<section>
  <div class="container">
    <h2 style="margin-bottom:2rem">{c.kindsH}</h2>
    <div class="grid grid-3 reveal-group">
      {kinds.map((s) => (
        <a href={lp(`/video/${s.slug}`)} class="reveal pending" style="display:block">
          <div class="photo-band tall">
            <img src={posters[s.slug].src} alt={c.exampleAlt(s.name)} loading="lazy" decoding="async" width={posters[s.slug].w} height={posters[s.slug].h} />
            <div class="scrim"></div>
            <div class="caption">
              <h3>{s.name} &rarr;</h3>
              <p style="font-size:.9rem;margin-top:.35rem">{kindPrice(s.slug)}</p>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<section class="section-tight">
  <div class="container">
    <div class="ed-head">
      <span class="ed-meta">{c.edMeta}</span>
      <div>
        <h2>{c.edH}</h2>
        <p class="ed-sub">{c.edSub}</p>
      </div>
    </div>
    <div class="svc-explain">
      <div class="svc-explain-main">
        <h3>{c.whatH}</h3>
        {c.whatP.map((p) => <p>{p}</p>)}
        <p class="model-note" set:html={c.modelNote} />
      </div>
      <aside class="svc-explain-side">
        <h3>{c.whereH}</h3>
        <ul class="svc-where-list">
          {c.where.map(([strong, rest]) => (
            <li><strong>{strong}</strong> — {rest}</li>
          ))}
        </ul>
      </aside>
    </div>
  </div>
</section>

<!-- HOW IT WORKS, in the same place and the same shape as /catalog's. The
     three service pages tell the story in the same order now: what it is,
     where it lives, the kinds, the three steps, the checklist, the price
     block, the tier line, the questions. -->
<section class="section-tight">
  <div class="container">
    <div class="photo-split reveal pending">
      <div class="photo-split-media">
        <img src="/img/banners-04.webp" alt={c.stepsAlt} loading="lazy" decoding="async" width="928" height="1152" />
      </div>
      <div>
        <h2>{c.stepsH}</h2>
        <div class="steps steps-stacked" style="margin-top:1.6rem">
          {c.steps.map(([h, p], i) => (
            <div class="step"><span class="step-n">{String(i + 1).padStart(2, '0')}</span><h3>{h}</h3><p>{p}</p></div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<section class="section-tight">
  <div class="container two-col">
    <div class="reveal pending">
      <h2>{c.cleanH}</h2>
      <ul class="checklist" style="margin-top:1.4rem">
        {c.clean.map((li) => (
          <li><svg viewBox="0 0 24 24" class="i"><path d="M20 6L9 17l-5-5"/></svg><span>{li}</span></li>
        ))}
      </ul>
    </div>
    <div class="reveal pending buy-note">
      <h3>{c.buyH}</h3>
      <p set:html={c.buyFixed} />
      <p set:html={c.buyQuote} />
      {/* The flatness, stated rather than implied. A reader arriving from
          /pricing has just read a rate that falls with volume; without this
          they will assume the clip rate falls too and find out at checkout
          that it does not. */}
      <p class="buy-flat"><strong>{c.buyFlatH}</strong> {c.buyFlat}</p>
      <div class="flex" style="margin-top:1.4rem">
        {/* The button used to print the tier label — "Order individual
            products" — which was a door the buyer picked between. Size picks
            the service level now, so the button is a verb. */}
        <a href={lp('/start')} class="btn btn-primary">{c.buyCta}</a>
        <a href={c.waQuote} class="btn btn-wa" target="_blank" rel="noopener">{c.waQuoteLabel}
        </a>
      </div>
    </div>
  </div>
</section>

<section class="section-tight">
  <div class="container">
    <div class="photo-grid reveal pending">
      {strip.map((s) => (
        <img src={s.src} alt={c.stripAlt[s.key]} loading="lazy" decoding="async" width={s.w} height={s.h} class={s.wide ? 'wide' : undefined} />
      ))}
    </div>
  </div>
</section>

<!-- WHAT CHANGES AT WINDOW_THRESHOLD PRODUCTS. This block used to be section
     13's two doors — "order individual products" against "run a whole drop" —
     a choice the buyer made. Size makes it now, so the component states a line
     rather than offering a fork; see TierCompare.astro's own header.
     One shared component, not a paragraph pasted into each service page: the
     tier facts it prints all come from pricing.js accessors, so /catalog,
     /lifestyle, /video and /pricing cannot drift apart in either language.
     See TierCompare.astro for why both columns are styled identically. -->
<section class="section-tight">
  <div class="container">
    <TierCompare lang={lang} />
  </div>
</section>

<section>
  <div class="container" style="max-width:760px">
    <h2 style="margin-bottom:1.8rem">{c.faqH}</h2>
    <div class="faq-stack">
      {c.faqs.map((f) => (
        <Disclose summary={f.q} tone="panel">
          <p>{f.a}</p>
        </Disclose>
      ))}
    </div>
  </div>
</section>

<section class="section-tight">
  <div class="container">
    <div class="cta-band reveal pending">
      <h2 class="display" style="font-size:clamp(2.2rem,5vw,3.6rem)" set:html={c.ctaH} />
      <p class="lead" style="margin:1.2rem auto 0;text-align:center">{c.ctaP}</p>
      <div class="flex" style="justify-content:center;margin-top:2rem">
        <span class="magnet-wrap"><span class="magnet-inner"><a href={lp('/start')} class="btn btn-primary btn-lg">{c.ctaPrimary}</a></span></span>
        <a href={lp('/contact')} class="btn btn-ghost btn-lg">{c.ctaSecondary}</a>
        <a href={c.wa} class="btn btn-wa" target="_blank" rel="noopener">{c.waLabel}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  /* Editorial accent (task #271b, Lucas's own request) — see global.css's
     --font-editorial comment. Same emphasis-word treatment as the other
     hero H1s. */
  .vid-h1 em { font-family: var(--font-editorial); font-style: italic; font-weight: 700; }

  /* The queue disclosure. Section 13 requires the "no fixed delivery date"
     half of the promise to be visible, not hidden — so it is set at body
     weight directly under the trust row rather than as footnote-sized grey. */
  .queue-note { margin-top: .9rem; font-size: .88rem; color: var(--ink-3); }

  /* The Brand Model link in the "What it is" column. It arrives through
     set:html and so carries no scope attribute — :global() on the descendant
     is what reaches it. Same treatment as every other inline prose link. */
  .model-note :global(a) { color: var(--accent-bright); text-decoration: underline; text-underline-offset: 3px; }

  /* This block used to be a `.card` with an overridden border colour sitting
     inside a two-column grid, i.e. a card nested in a layout that already
     framed it. Full border, no nesting, no accent tint. */
  .buy-note { border: 1px solid var(--line-strong); padding: clamp(1.4rem, 3vw, 2rem); }
  .buy-note h3 { font-family: var(--font-display); font-weight: 800; font-size: 1.15rem; letter-spacing: -0.01em; }
  .buy-note p { margin-top: .8rem; color: var(--ink-2); }
  .buy-note p strong { color: var(--ink); font-weight: 600; }
  /* Ruled off rather than boxed: it is a note ON the two lines above it, not a
     third way to buy, and a second frame inside .buy-note would read as one. */
  .buy-note .buy-flat {
    margin-top: 1.1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
    font-size: .9rem;
    line-height: 1.55;
    color: var(--ink-3);
  }
  .buy-note .buy-flat strong { color: var(--ink); font-weight: 700; }

  /* The question list. `Disclose` styles the panels; this only sets the gap
     between them, exactly as on /catalog and /lifestyle. */
  .faq-stack { display: flex; flex-direction: column; gap: .7rem; }

  /* `.drop-note` lived here, and identically in CatalogPage.astro and
     LifestylePage.astro. Three copies of one block is what TierCompare.astro
     replaced; its styles are scoped to that component now. */
</style>
