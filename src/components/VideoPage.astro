---
import { waHref } from '../data/whatsapp.js';
// VISUAILS — /video and /nl/video share this body.
//
// Same conversion as CatalogPage.astro and LifestylePage.astro: two 156-line
// inline pages, each holding its own copy of the prices, replaced by one body
// taking a `lang` prop. EN/NL parity becomes a property of the file layout.
//
// This page carried the worst price defect on the site. Its inline
// `videoStyles` literal — and src/data/videoStyles.js behind it — priced
// Lifestyle Video at €59, a figure that appears nowhere in pricing.js and
// never has. The sitewide price scan missed it for months because "€59" is a
// string prefix of "€59.99", so every occurrence was folded into the catalog
// lifestyle tally. There is one clip rate now and it comes from AMOUNT.video.
//
// WHY THIS PAGE STILL PRINTS ONE FIGURE WHERE /catalog AND /lifestyle PRINT A
// LADDER (August 2026 — section 0 of src/data/pricing.js). A catalog set and a
// lifestyle carousel are priced per PRODUCT and their rate falls as the count
// rises. A clip is not on that ladder: it is a flat rate per clip, the same
// inside an order as on its own, and that flatness is the claim this page has
// always made about it. So the figure here is genuinely one number — but it is
// one number that now has to say so, because a reader arriving from /pricing
// has just been shown a falling rate and will assume this one falls too.
//
// EVERY PRINTED PRICE CARRIES A VAT LABEL, from vatLabel() — BRIEF-14's
// hardest rule, and never a typed "excl. VAT".
//
// "DROP" IS NOT WHAT WE SELL. It means a collection going live to the brands
// we sell to; a work order is an order — in Dutch, een bestelling. "The same
// rate on its own or added to a drop" was the one line on this page that used
// the word for a work order, and it is the line the change matters most on,
// because it is the sentence about the price.
//
// SERVICE LEVEL FOLLOWS SIZE: from WINDOW_THRESHOLD products an order gets the
// reserved window, below it the standard queue.
//
// ── EN VIDEO STAAT NIET OP DIE LADDER — 13 augustus 2026 ────────────────────
//
// Die regel hierboven gold voor deze pagina niet, en dat stond er wel. Drie
// plekken beloofden dat je vanaf tien een leverdatum krijgt die niet meer wijkt:
// de FAQ "hoe lang duurt het", de regel onder de hero, en de slotalinea.
//
// tierFor() in pricing.js geeft voor `service: 'video'` ALTIJD 'unattended',
// omdat video niet op de prijsladder staat (zie isLadderService). Een aanvraag
// van twaalf clips kan dus per definitie geen gereserveerd venster krijgen — er
// is geen bestelstroom, geen capaciteitspoort en geen agenda voor. De pagina
// beloofde iets dat het systeem niet alleen niet doet, maar niet KAN doen.
//
// WAT WEL WAAR IS, en dat is het onderscheid dat de teksten nu maken: clips die
// MEELIFTEN op een bestelling van tien producten of meer vallen binnen het
// venster van die bestelling. Niet omdat het clips zijn, maar omdat de
// BESTELLING de datum draagt. Een losse clipaanvraag draagt niets.
//
// Vandaar ook dat de knoppen naar /start/video gaan en niet naar /start: dit is
// de enige dienst op deze pagina, en de keuzepagina opnieuw laten kiezen wat de
// bezoeker net gekozen heeft, is een stap die niets oplevert.
import {
  TIERS, AMOUNT, euro, vatLabel, WINDOW_THRESHOLD, PLAN_CLIPS, plans,
  reviewClaim, turnaround,
  clause, VIDEO_OP_AANVRAAG,
} from '../data/pricing.js';
/* De vragen onderaan deze pagina staan in faq.js en niet meer hier. Reden:
   schema.js bouwt zijn FAQPage-knoop uit het pad en kan de frontmatter van
   een component niet lezen — zie de kop boven serviceFaqs(). */
import { serviceFaqs } from '../data/faq.js';
import { localizedPath } from '../i18n/ui.js';
import Vragen from './Vragen.astro';
import '../styles/stijl22.css';
import { videoStyles as videoStylesEn } from '../data/videoStyles.js';
import { videoStyles as videoStylesNl } from '../data/videoStyles.nl.js';

import ServiceSwitch from './ServiceSwitch.astro';
import HeroFacts from './HeroFacts.astro';
import LaptopCarousel from './LaptopCarousel.astro';
import { laptopSlides } from '../data/laptopSlides.js';
import StyleRows from './StyleRows.astro';
interface Props { lang: 'en' | 'nl'; }
const { lang } = Astro.props;
const lp = (p: string) => localizedPath(lang, p);

const kinds = lang === 'nl' ? videoStylesNl : videoStylesEn;

// One rate, flat. Formatted once here rather than at every call site, so the
// clip price and its VAT label cannot get separated by an edit.
const clip = euro(AMOUNT.video, lang);
const t0 = TIERS.unattended;
/* ── OP AANVRAAG ZOLANG DE PIJPLIJN NIET STAAT — 19 september 2026 ─────────
   Zie VIDEO_OP_AANVRAAG in pricing.js. Op deze pagina betekent dat: geen
   bedrag in de feitenrij en op de kaarten, geen bestelknop bij de vaste
   kinds, en een "clip volgt"-plaat in plaats van een geleend sfeerbeeld —
   dezelfde vorm als een lifestyle-look zonder foto, zodat Lucas ziet hoe de
   pagina eruit komt te zien zodra de clips er zijn. De aanvraagknop blijft
   bovenaan en bij de eigen look. */
const opAanvraag = VIDEO_OP_AANVRAAG;
const opAanvraagWoord = lang === 'nl' ? 'Op aanvraag' : 'On request';

// The plan that includes clips, named rather than typed — /pricing says the
// same thing off the same two constants, so the two pages cannot disagree
// about how many clips a Studio month carries.
const studioPlan = plans(lang).find((pl) => pl.id === 'studio');

// Motion and Lifestyle Video are the two fixed-rate clips; Campaign and
// Custom are scoped and quoted. Keeping the rule here rather than in
// videoStyles.js means no euro figure lives in the style data at all — which
// is exactly how the stale €59 survived as long as it did.
const QUOTED = new Set(['campaign', 'custom']);

// w/h on both tables are the intrinsic pixel size of the file in public/img —
// the real photo, not the .photo-band / .photo-grid box it crops into. They
// are attributes, not layout: the browser needs the aspect ratio before the
// bytes arrive or the grid reflows under the reader (§12).
// ── DE ALT-TEKST OP DEZE PAGINA IS GEEN DECORATIE — 23 AUGUSTUS 2026 ────────
//
// Hier stond `stepsAlt: 'A product video still from a VISUAILS Motion clip'` op
// /img/banners-04.webp, en `exampleAlt: (n) => `${n} example`` op de vier
// posters hierboven. Allebei onwaar, en niet op een manier die je ziet: er
// bestaat geen enkele Motion-clip. `src/data/videoExamples.js` heeft acht
// ingangen die allemaal `file: null` dragen, er staat geen .mp4 of .webm in het
// project, en VideoExamples.astro rendert daarom overal het lege vakje.
//
// Een foto die zichzelf een filmstill noemt, is precies het soort claim dat
// tests/promises.test.mjs moet tegenhouden: een belofte in tekst die door niets
// wordt nagekomen. Dat het in een alt-tekst stond in plaats van in een kop,
// maakt het niet kleiner — een schermlezer krijgt hem als het enige wat er over
// dat beeld gezegd wordt, en Google leest hem als een beschrijving van de
// pagina-inhoud.
//
// De nieuwe teksten beschrijven wat er te ZIEN is: een productfoto. Voor de
// stappenafbeelding is dat bovendien betere copy, want stap 1 op die plek is
// letterlijk "Stuur een productfoto".
//
// De echte videovoorbeelden komen in VideoExamples.astro te staan zodra er
// bestanden zijn. Zolang die er niet zijn, staat er een leeg vakje dat dat
// zegt, en dat is de eerlijke vorm.
const posters: Record<string, { src: string; w: number; h: number }> = {
  motion: { src: '/img/banners-04.webp', w: 928, h: 1152 },
  lifestyle: { src: '/img/lifestyle-glow-03.webp', w: 768, h: 1376 },
  campaign: { src: '/img/banners-08.webp', w: 928, h: 1152 },
  custom: { src: '/img/banners-13.webp', w: 2400, h: 1792 },
};

const strip = [
  { src: '/img/banners-01.webp', wide: true, key: 'campaign', w: 928, h: 1152 },
  { src: '/img/lifestyle-flash-02.webp', wide: false, key: 'flash', w: 1340, h: 2400 },
  /* ── HET ONDERWERP STOND HALF BUITEN BEELD — 23 AUGUSTUS 2026 ────────────
     Deze foto is liggend (2400x1792) en staat in een staande strook. Bij
     `object-fit: cover` valt daar 71% van de breedte weg, en met de standaard
     `50% 50%` wordt dat de MIDDELSTE 29% — terwijl het onderwerp in deze opname
     links staat. Resultaat op /video: een halve persoon tegen de linkerrand en
     twee derde lege bestrating ernaast, met het kledingstuk — het product — er
     bijna helemaal uit.

     Gemeten over acht pagina's viel dit als enige echt om. De andere beelden die
     evenveel of meer verliezen (de galerijtegels, de stroken op /lifestyle) zijn
     centraal gecomponeerd en overleven de uitsnede gewoon. Het percentage is dus
     niet het signaal — waar het onderwerp staat, is dat wel. */
  { src: '/img/lifestyle-phone-made-09.webp', wide: false, key: 'phone', w: 2400, h: 1792, pos: '26% 50%' },
  { src: '/img/lifestyle-dunes-02.webp', wide: false, key: 'dunes', w: 928, h: 1152 },
  { src: '/img/banners-06.webp', wide: true, key: 'campaign', w: 928, h: 1152 },
];

// No `as const` — COPY[lang] on a const-asserted object gives a union of
// readonly tuples and .map() on that union is a TS error.
const COPY = {
  en: {
    eyebrow: 'Video',
    h1: 'Short product videos <br />that <em>move</em>.',
    /* De prijszin is eruit, zoals op /catalog: het bedrag staat twee regels
       lager in de specificatiestrook, en een bedrag lees je niet in lopende
       tekst. Wat de lead nog doet is wat de strook niet kan — zeggen wat je
       krijgt. Zie de noot bij `lead` in CatalogPage.astro. */
    lead: `8 seconds of subtle motion, cut vertical for Reels and TikTok — made from the product photos you already sent.`,
    // SECTION 13: Tier 0 "must NOT appear ... in any hero." See CatalogPage for
    // the full note. Used in the hero and the closing band; the buy block lower
    // down names the tier from TIERS.unattended.label instead.
    ctaPrimary: 'Ask about a video clip',
    wa: waHref("Hi VISUAILS, I'd like to talk about a product video."),
    waQuote: waHref("Hi VISUAILS, I'd like a quote for a campaign video."),
    waLabel: 'WhatsApp',
    waQuoteLabel: 'Quote a campaign',
    // The third hero button. /catalog and /lifestyle both offer it and this
    // page did not, so the one service page whose price is a single flat
    // figure was also the one that gave a visitor no way to see the figure in
    // context. It says "pricing" rather than "the price ladder": a clip is not
    // on the ladder, and sending someone to look for a falling rate that does
    // not exist for this service is the confusion buyFlat exists to prevent.
    ctaPrices: 'See pricing',
    /* PRIJS EERST, ZOALS OP /catalog EN /lifestyle. Deze twee stonden
       omgekeerd — formaat, dan prijs — en dat was de enige pagina van de drie
       waar de bezoeker de rij in een andere volgorde las. */
    trust: [
      opAanvraag ? [opAanvraagWoord, 'we reply in writing with a price'] : [clip, `per clip · ${vatLabel('excl', 'en')}`],
      ['8s', 'clean product videos'],
    ],
    // Visible, not buried. Section 13: a visitor must not be able to leave
    // this page believing a delivery date was promised — and now that size
    // decides the service level, the line names the count as well.
    queueNote: `Clips run in the ${clause(t0.queue.en).toLowerCase()}. A held delivery date comes with an order of ${WINDOW_THRESHOLD} products or more — clips can ride inside one, but a clip request on its own does not get a date.`,
    // The qualifier above TierCompare. That component is shared with /catalog,
    // /lifestyle and /pricing and prints the ladder's two service levels; on
    // THIS page it needs one sentence of context, because neither column is
    // reachable by ordering clips. Removing the component instead would take
    // away information a buyer who also orders photos does want.
    tierNote: opAanvraag
      ? `The two columns below describe the price per quantity for catalog and lifestyle products. Clips are on request for now and run at the standard turnaround — the right-hand column reaches your clips only when they are added to an order of ${WINDOW_THRESHOLD} products or more.`
      : `The two columns below describe the price per quantity for catalog and lifestyle products. A clip is ${clip} however many you order, and a clip request runs at the standard turnaround — the right-hand column reaches your clips only when they are added to an order of ${WINDOW_THRESHOLD} products or more.`,
    reviewNote: reviewClaim('unattended', 'en'),
    heroAlt: 'A still from a short VISUAILS product clip',
    heroCap: 'Video · a frame from an 8-second clip',
    kiesCta: 'Pick your clip',
    levert: 'one clip of eight seconds.',
    kindsH: 'Ways to add motion.',
    perClip: opAanvraag ? 'On request' : `${clip} / clip · ${vatLabel('excl', 'en')}`,
    quoted: 'Quoted per project',
    exampleAlt: (n: string) => `A product photo in the ${n} style`,
    edMeta: '( Where it fits )',
    edH: 'Product video: a short clip, made from one of your product photos.',
    edSub: 'A few seconds of movement, made for feeds and ads.',
    whatH: 'What it is',
    whatP: [
      'A product video is a short, clean film with subtle motion — a slow turn, a drape, a catch of light — built to give a product life without a full production. On a feed tuned for movement, a few seconds of motion earns attention a static image can’t, and holds it long enough to land the message.',
      "It isn’t a replacement for your photos; it’s the layer on top that lifts them where it counts. The same product that sits still on your shop can move in your ads and socials, where dwell time and click-through decide whether people stop — or keep scrolling.",
    ],
    // Brief §1: every service page links to /custom-models. It goes here,
    // in the paragraph about what a clip is, because "who is in it" is a real
    // question a clip raises and the answer is the same face as the stills.
    modelNote: `Where a person appears in the clip, that person can be <a href="${lp('/custom-models')}">a Brand Model made only for you</a> — the same face your catalog and lifestyle sets already run on.`,
    buyFlatH: 'Why the clip rate does not fall',
    whereH: 'Where it lives',
    where: [
      ['Reels, TikTok & Shorts', 'where motion is the native language.'],
      ['Paid ads', 'higher dwell time and click-through.'],
      ['Product pages', 'an autoplay clip beside the stills.'],
      ['Email & landing pages', 'a moment of life above the fold.'],
    ],
    stepsH: 'Three steps to a moving product.',
    steps: [
      ['Send a product photo', 'One clean still is enough to start.'],
      ['We add the motion', 'A slow turn, a drape, a catch of light — held subtle.'],
      [turnaround('unattended', 'en'), 'Sized for pages, social and ads.'],
    ],
    stepsAlt: 'A product photo of the kind a clip starts from',
    cleanH: 'Clean motion, ready to publish.',
    clean: [
      '8-second video with subtle motion',
      'Sized for pages, social and ads',
      'Consistent style across your range',
      reviewClaim('unattended', 'en'),
    ],
    buyH: 'Two ways to buy video',
    // The whole point of the clip price: a video does not get cheaper or more
    // expensive for arriving with a collection. Photos are priced per product
    // on a falling ladder; a clip is priced per clip and stays put, which is
    // the difference this block now has to state out loud rather than imply.
    buyFixed: opAanvraag
      ? '<strong>Motion &amp; Lifestyle</strong> — on request while the video pipeline is being built. You send the form, on its own or on top of an order, and we reply in writing with a price and a date before anything runs. Nothing is charged until you say yes.'
      : `<strong>Motion &amp; Lifestyle</strong> — a fixed ${clip} per clip, ${vatLabel('excl', 'en')}. There is no checkout for video yet: you request it through the form, on its own or on top of an order, and we confirm what and when in writing before anything runs.`,
    buyQuote: '<strong>Campaign</strong> — bigger, multi-shot, quoted per project.',
    buyFlat: `Catalog and lifestyle images are priced per product and the rate falls as the count rises. A clip does not work that way: it is one rate, whatever else is in the order. ${studioPlan ? `${PLAN_CLIPS.studio} clips a month are included in the ${studioPlan.name} plan.` : ''}`,
    /* Deze knop wijst naar /start/video en heette "Start an order". Dat is
       precies de mismatch die op elke dienstpagina is rechtgezet: het label
       moet zeggen wat er achter de knop gebeurt, niet wat er in het algemeen
       mogelijk is. Zelfde tekst als de hoofdknop bovenaan deze pagina. */
    buyCta: 'Ask about a video clip',
    stripAlt: {
      campaign: 'Campaign photography',
      flash: 'Flash-style lifestyle image',
      phone: 'Phone-made-style lifestyle image',
      dunes: 'Dunes-style lifestyle image',
    },
    faqs: serviceFaqs('video', 'en'),
    ctaH: 'Give your product <br>a little movement.',
    ctaP: opAanvraag
      ? `On request — ${turnaround('unattended', 'en').toLowerCase()} once we have said yes in writing, no fixed delivery date.`
      : `${clip} per clip, ${vatLabel('excl', 'en')} — ${turnaround('unattended', 'en').toLowerCase()}, no fixed delivery date.`,
    ctaSecondary: 'Contact us',
  },
  nl: {
    eyebrow: 'Video',
    h1: 'Korte productvideo’s <br />die <em>bewegen</em>.',
    /* De prijszin is eruit, zoals op /catalog: het bedrag staat twee regels
       lager in de specificatiestrook, en een bedrag lees je niet in lopende
       tekst. Wat de lead nog doet is wat de strook niet kan — zeggen wat je
       krijgt. Zie de noot bij `lead` in CatalogPage.astro. */
    lead: `8 seconden subtiele beweging, verticaal gesneden voor Reels en TikTok — gemaakt van de productfoto’s die je al stuurde.`,
    ctaPrimary: 'Vraag een videoclip aan',
    wa: waHref("Hoi VISUAILS, ik wil graag praten over een productvideo."),
    waQuote: waHref("Hoi VISUAILS, ik wil graag een offerte voor een campagnevideo."),
    waLabel: 'WhatsApp',
    waQuoteLabel: 'Offerte voor een campagne',
    ctaPrices: 'Bekijk de prijzen',
    trust: [
      opAanvraag ? [opAanvraagWoord, 'we antwoorden schriftelijk met een prijs'] : [clip, `per clip · ${vatLabel('excl', 'nl')}`],
      ['8s', 'strakke productvideo’s'],
    ],
    queueNote: `Clips lopen mee in de ${clause(t0.queue.nl).toLowerCase()}. Een vrijgehouden leverdatum hoort bij een bestelling van ${WINDOW_THRESHOLD} producten of meer — clips kunnen daarin meegaan, maar een losse clipaanvraag krijgt geen datum.`,
    // Zie de Engelse kant voor waarom deze regel er staat.
    tierNote: opAanvraag
      ? `De twee kolommen hieronder gaan over de prijs per aantal voor catalog- en lifestyleproducten. Clips zijn voorlopig op aanvraag en blijven in de normale doorlooptijd — de rechterkolom raakt je clips alleen als ze meegaan met een bestelling van ${WINDOW_THRESHOLD} producten of meer.`
      : `De twee kolommen hieronder gaan over de prijs per aantal voor catalog- en lifestyleproducten. Een clip is ${clip}, hoeveel je er ook bestelt, en een clipaanvraag blijft in de normale doorlooptijd — de rechterkolom raakt je clips alleen als ze meegaan met een bestelling van ${WINDOW_THRESHOLD} producten of meer.`,
    reviewNote: reviewClaim('unattended', 'nl'),
    heroAlt: 'Een stilstaand beeld uit een korte productclip van VISUAILS',
    heroCap: 'Video · een beeld uit een clip van 8 seconden',
    kiesCta: 'Kies je clip',
    levert: 'één clip van acht seconden.',
    kindsH: 'Manieren om beweging toe te voegen.',
    perClip: opAanvraag ? 'Op aanvraag' : `${clip} / clip · ${vatLabel('excl', 'nl')}`,
    quoted: 'Offerte per project',
    exampleAlt: (n: string) => `Een productfoto in de stijl ${n}`,
    edMeta: '( Waar het past )',
    edH: 'Productvideo: beweging waar een foto niet verder komt.',
    edSub: 'Een paar seconden beweging, gemaakt voor je feed en je advertenties.',
    whatH: 'Wat het is',
    whatP: [
      'Een productvideo is een korte, strakke film met subtiele beweging — een langzame draai, stof die valt, licht dat over het materiaal trekt — gemaakt om een product te laten leven zonder een volledige productie. In een feed die op beweging is gebouwd, valt een paar seconden video op waar een stilstaand beeld voorbijgaat.',
      'Het vervangt je foto’s niet; het komt erbij. Hetzelfde product staat stil op je productpagina en beweegt in je advertenties en op je socials — de plekken waar kijktijd en doorklikken meetellen.',
    ],
    modelNote: `Waar er een persoon in de clip verschijnt, kan dat <a href="${lp('/custom-models')}">een merkmodel zijn dat alleen voor jou gemaakt is</a> — hetzelfde gezicht waar je catalog- en lifestylesets al op draaien.`,
    buyFlatH: 'Waarom het cliptarief niet daalt',
    whereH: 'Waar je het gebruikt',
    where: [
      ['Reels, TikTok & Shorts', 'waar alles beweegt.'],
      ['Betaalde ads', 'hogere kijktijd en doorklik.'],
      ['Productpagina’s', 'een autoplay-clip naast de stills.'],
      ['E-mail & landingspagina’s', 'beweging in het eerste beeld dat iemand ziet.'],
    ],
    stepsH: 'Drie stappen naar een bewegend product.',
    steps: [
      ['Stuur een productfoto', 'Eén strakke still is genoeg om te beginnen.'],
      ['Wij brengen het in beweging', 'Een langzame draai, stof die valt, licht dat over het materiaal trekt — subtiel gehouden.'],
      [turnaround('unattended', 'nl'), 'Op maat voor pagina’s, social en advertenties.'],
    ],
    stepsAlt: 'Een productfoto zoals een clip er een als vertrekpunt neemt',
    cleanH: 'Strakke beweging, klaar om te publiceren.',
    clean: [
      'Video van 8 seconden met subtiele beweging',
      'Op maat voor pagina’s, social en advertenties',
      'Consistente stijl door je hele assortiment',
      reviewClaim('unattended', 'nl'),
    ],
    buyH: 'Twee manieren om video te kopen',
    buyFixed: opAanvraag
      ? '<strong>Motion &amp; Lifestyle</strong> — op aanvraag zolang de videopijplijn in aanbouw is. Je stuurt het formulier, los of bovenop een bestelling, en we antwoorden schriftelijk met een prijs en een datum voordat er iets draait. Er wordt niets afgeschreven voordat jij ja zegt.'
      : `<strong>Motion &amp; Lifestyle</strong> — een vaste ${clip} per clip, ${vatLabel('excl', 'nl')}. Video heeft nog geen afrekenstap: je vraagt het aan via het formulier, los of bovenop een bestelling, en we bevestigen op schrift wat en wanneer voordat er iets draait.`,
    buyQuote: '<strong>Campaign</strong> — groter, meerdere scènes, offerte per project.',
    buyFlat: `Catalog- en lifestylefoto’s hebben een tarief per product, en dat daalt naarmate het aantal stijgt. Bij een clip werkt dat niet zo: het tarief blijft hetzelfde, wat er verder ook in de bestelling zit. ${studioPlan ? `${PLAN_CLIPS.studio} clips per maand zitten in het ${studioPlan.name}-plan.` : ''}`,
    buyCta: 'Vraag een videoclip aan',
    stripAlt: {
      campaign: 'Campagnefotografie',
      flash: 'Lifestylefoto in Flash-stijl',
      phone: 'Lifestylefoto in Phone-made-stijl',
      dunes: 'Lifestylefoto in Dunes-stijl',
    },
    faqs: serviceFaqs('video', 'nl'),
    ctaH: 'Geef je product <br>een beetje beweging.',
    ctaP: opAanvraag
      ? `Op aanvraag — ${turnaround('unattended', 'nl').toLowerCase()} zodra we schriftelijk ja hebben gezegd, geen vaste leverdatum.`
      : `${clip} per clip, ${vatLabel('excl', 'nl')} — ${turnaround('unattended', 'nl').toLowerCase()}, geen vaste leverdatum.`,
    ctaSecondary: 'Neem contact op',
  },
};

const c = COPY[lang];
const kindPrice = (slug: string) => (QUOTED.has(slug) ? c.quoted : c.perClip);
const nl = lang === 'nl';

/* ── ELKE VIDEOSOORT ZIJN EIGEN REGEL, DE EIGEN LOOK BOVENAAN — 4 september 2026 ──
   Zie de kop van StyleRows.astro. Custom gaat naar WhatsApp (ctaExternal) en
   niet naar een formulier; dat blijft zo. */
/* De waaier per soort: de poster plus stills uit dezelfde reeks. Tot de
   video-stills er zijn, zijn dit de banners die de pagina al gebruikt. */
/* ── ÉÉN KAART, WANT JE KRIJGT ÉÉN CLIP — 4 september 2026 ─────────────────
   Hier stonden drie tot vier beelden per soort, en dat was een verkeerde
   belofte: een videobestelling levert ÉÉN clip. Catalog toont er vier omdat een
   catalogset er vier heeft, lifestyle drie om dezelfde reden — dan hoort video
   er één te tonen. Naast die ene staat de ingestuurde telefoonfoto, zodat je in
   één oogopslag ziet wat erin gaat en wat eruit komt.

   Campaign is de uitzondering en dat staat in de dienst zelf: dat is een film
   MET meerdere shots, dus drie kaarten zijn daar geen overdrijving maar de
   beschrijving. */
const WAAIER: Record<string, string[]> = {
  motion: ['/img/banners-04.webp'],
  lifestyle: ['/img/lifestyle-glow-03.webp'],
  campaign: ['/img/banners-08.webp', '/img/banners-01.webp'],
  custom: ['/img/banners-13.webp'],
};
const TINT: Record<string, string> = { motion: '#8fa3b8', lifestyle: '#a86bd6', campaign: '#c9a06a', custom: '#c8c9cd' };
const naarRij = (s: (typeof kinds)[number]) => ({
  slug: s.slug,
  name: s.name,
  tagline: s.tagline,
  desc: s.cardDesc,
  price: kindPrice(s.slug),
  bestFor: s.bestFor || [],
  /* Zolang video op aanvraag is, geen geleend sfeerbeeld maar een "clip
     volgt"-plaat per kaart (StyleRows tekent een Media zonder src als
     plaatshouder met dit label). Campaign houdt zijn twee kaarten, want dat
     is een film met meerdere shots. */
  media: opAanvraag && s.slug !== 'custom'
    ? { label: nl ? 'Clip volgt' : 'Clip to follow' }
    : { src: posters[s.slug].src, w: posters[s.slug].w, h: posters[s.slug].h, alt: c.exampleAlt(s.name) },
  photos: opAanvraag && s.slug !== 'custom'
    ? (WAAIER[s.slug] || [posters[s.slug].src]).map((_, i) => ({ label: nl ? (i === 0 ? 'Clip volgt' : `Shot ${i + 1} volgt`) : (i === 0 ? 'Clip to follow' : `Shot ${i + 1} to follow`) }))
    : (WAAIER[s.slug] || [posters[s.slug].src]).map((src, i) => ({ src, alt: i === 0 ? c.exampleAlt(s.name) : '' })),
  /* Dezelfde telefoonfoto als op /catalog en /lifestyle: het ingestuurde beeld
     hoort bij elke dienst hetzelfde te zijn, want het IS bij elke dienst
     hetzelfde — één foto van je product. */
  before: { src: '/img/catalog-before-1x1.webp', alt: '' },
  /* En het geleverde beeld zegt hier wat het is: geen foto maar een clip. */
  naLabel: nl ? 'Clip · 8 sec' : 'Clip · 8 sec',
  tint: TINT[s.slug],
  detailHref: lp(`/video/${s.slug}`),
  detailLabel: nl ? `Ontdek ${s.name}` : `Explore ${s.name}`,
  /* Geen bestelknop op de vaste kinds zolang video op aanvraag is: de kaart
     linkt naar de detailpagina, en aanvragen gaat via de knop bovenaan en bij
     de eigen look. Campaign en custom blijven een offerte-aanvraag. */
  orderHref: opAanvraag && (s.slug === 'motion' || s.slug === 'lifestyle') ? undefined : s.ctaHref,
  orderLabel: s.ctaLabel,
});
const eigenLook = naarRij(kinds.find((s) => s.slug === 'custom')!);
const vasteLooks = kinds.filter((s) => s.slug !== 'custom').map(naarRij);
---

{/* `hero-bright` — deze foto is de lichtste van de site (wit overhemd tegen
    licht beton) en heeft een zwaardere sluier nodig dan de andere twee hero's.
    Zie de noot bij .hero-bright in global.css voor de gemeten waarden. */}
<!-- ══ DEZELFDE HERO ALS /catalog EN /lifestyle — 31 AUGUSTUS 2026 ═══════════
     Lucas: *"Alle service pagina's zien er afschuwlijk lelijk, onoverzichtelijk
     en inconsistent uit. Zorg dat elke pagina goed op elkaar aansluit."*

     Gemeten op 1440px, en dit was de scherpste van de verschillen: deze pagina
     droeg `.hero-editorial compact hero-bright` — een full-bleed foto over de
     volle hoogte met de tekst eroverheen — terwijl /catalog en /lifestyle
     `.page-hero` met twee kolommen droegen. Drie zusterpagina's, twee
     verschillende herocomponenten. Gevolgen die je zag zonder te meten: de
     eyebrow begon op 83px tegen 163 en 216, de feitenrij liep hier over de
     volle 1400px en daar over 764, en de kop was 455 breed tegen 667.

     `.page-hero` is bovendien niet "de vorm van die twee" maar de vorm van de
     hele site: /pricing, /compare, /models, /custom-models, /start, /ai-act en
     /plans dragen hem ook. Deze pagina was de uitzondering, dus deze pagina
     gaat mee — niet andersom.

     DE FOTO BLIJFT, MAAR ALS FOTO. Hij stond als achtergrondlaag onder de
     tekst met een sluier eroverheen; nu staat hij in de rechterkolom in
     dezelfde `.photo-band tall` die /lifestyle al gebruikte. Dat is ook wat
     het eerste ontwerpprincipe vraagt: toon het werk vóór de belofte, en een
     foto die half onder een verloop ligt toont het werk maar half. -->
{/* ═══ /video IN DE STIJL VAN SECTIE 22 — 7 september 2026 ═══════════════════
    Zesde pagina in de stijl, en de eerste van de drie dienstpagina's. De vijf
    gedeelde componenten — ServiceSwitch, HeroFacts, StyleRows, TierCompare en
    Disclose — staan er nog precies zoals ze waren: hun opmaak, hun
    toetsenbordgedrag en hun aria zijn niet aangeraakt. Alleen hun uiterlijk
    volgt nu de stijl, via het blok onderaan src/styles/stijl22.css. Dat scheelt
    drie keer hetzelfde werk op /catalog en /lifestyle, en het houdt het gedrag
    waarvan de toetsen al bewijzen dat het klopt.

    De inhoud is niet aangeraakt: dezelfde COPY in beide talen, dezelfde looks
    uit videoStyles.js, dezelfde getallen uit pricing.js. */}
<div class="s22">

  {/* ── 1 · DE OPENING ───────────────────────────────────────────────────── */}
  <section class="paneel vid-grond" aria-labelledby="vid-h1">
    <div class="vid-open">
      {/* Dezelfde opbouw als /catalog — zie de noot daar voor waarom deze
          volgorde en waarom de WhatsApp-knop weg is. De volgorde volgt de
          vragen: wat is het, wat kost het, wat is de haak, wat doe ik nu, en
          anders. Alle dienstpagina's dragen deze vorm; dat was het punt van
          Lucas' *"maak dit consistent bij alle pagina's"*. */}
      <div class="paneel-kop">
        <p class="etiket">{c.eyebrow}</p>
        <h1 id="vid-h1" class="hoog" set:html={c.h1} />
        <p class="lopend">{c.lead}</p>
        <HeroFacts eigen={c.trust} lang={lang} />
        <p class="vid-wacht">{c.queueNote}</p>
        <p class="acties">
          {/* PAGINA-OPBOUW.md stelde de aanvraag als hoofdknop voor. Niet
              gedaan (23 september 2026): Lucas' vaste regel is "eerst een
              look, dan het formulier", en tests/request-flow bewaakt die. */}
          <a class="knop knop-inkt" href="#looks">{c.kiesCta}</a>
          <a class="knop knop-lijn" href={lp('/pricing')}>{c.ctaPrices}</a>
        </p>
        <ServiceSwitch current={['video', 'complete']} lang={lang} />
      </div>
      {/* ── DE LAPTOP IN DE OPENING — 17 september 2026 ──────────────────────
          Lucas: *"Ik wil de laptop ook bovenaan op de eerste sectie en rechts
          van de tekst mooi consistent bij elke categorie zodat de klant meteen
          ziet wat de categorie is en biedt."*

          Hier stond één sfeerbeeld. Dat toont de LOOK, maar niet wat je krijgt
          en waar het landt — en dat is de vraag waarmee iemand op een
          dienstpagina binnenkomt. De laptop toont het geleverde beeld én de
          telefoonfoto waar het uit komt, in een echte productpagina.

          `vorm="naast"` laat hem doorlopen tot voorbij de rechterrand en daar
          vervagen; zonder dat is de kolom te smal om het nagebouwde scherm
          leesbaar te houden. Zie de noot bij `.lc.is-naast`. */}
      <div class="vid-beeld">
        <LaptopCarousel lang={lang} vorm="naast" slides={[laptopSlides(lang).video]} titel={c.lcH ?? c.h1 ?? c.eyebrow} />
      </div>
    </div>
  </section>

  {/* ── 2 · DE LOOKS ─────────────────────────────────────────────────────── */}
  <section class="paneel" id="looks">
    <StyleRows lang={lang} dienst="video" h={c.kindsH} lead={eigenLook} items={vasteLooks} levert={c.levert} />
  </section>

  {/* ── 3 · DE DONKERE KAMER IS WEG — 19 september 2026 ───────────────────
      "Wat het is" en "Waar je het gebruikt" stonden hier als donkere kamer
      (926 px op 1440). Lucas: *"Diepere snoei op /catalog e.d. … doorvoeren."*
      De hero zegt al wat het is en de looks laten het zien; het enige dat
      nergens anders stond — wáár je het gebruikt — staat nu als één regel
      onder de checklist bij de drie stappen. De copy blijft in COPY staan. */}

  {/* ── DE DRIE STAPPEN ZIJN WEG — 23 september 2026 ─────────────────────
      "Drie stappen naar een bewegend product" (865 px) staat op
      /how-it-works. Waar je het gebruikt en de modelregel staan nu in het
      blok hieronder, onder de checklist. */}

  {/* ── 5 · WAT ER SCHOON MOET, EN WAT HET KOST ──────────────────────────── */}
  <section class="paneel">
    <div class="vid-twee-licht">
      <div>
        <h2 class="hoog hoog-2">{c.cleanH}</h2>
        <ul class="vid-check" role="list">
          {c.clean.map((li) => <li>{li}</li>)}
        </ul>
        <p class="vid-waar-regel"><span class="etiket">{c.whereH}</span> {c.where.map(([w]) => w).join(' · ')}</p>
        <p class="lopend vid-noot" set:html={c.modelNote} />
      </div>
      <div class="vid-koop">
        <h3 class="hoog hoog-3">{c.buyH}</h3>
        <p class="lopend" set:html={c.buyFixed} />
        <p class="lopend" set:html={c.buyQuote} />
        <p class="lopend vid-vast"><b>{c.buyFlatH}</b> {c.buyFlat}</p>
        <p class="acties">
          <a class="knop knop-inkt" href={lp('/start/video')}>{c.buyCta}</a>
          <a class="knop knop-lijn" href={c.waQuote} target="_blank" rel="noopener">{c.waQuoteLabel}</a>
        </p>
      </div>
    </div>
  </section>

  {/* ── 6 · (WEG) WAT ER VERANDERT BIJ EEN GROTERE BESTELLING ──────────────
      TierCompare stond hier tot 19 september 2026 met een noot erboven die
      uitlegde dat geen van beide kolommen over clips ging. Een blok dat een
      uitleg nodig heeft waarom hij er staat, hoort er niet te staan; de
      leverdatum-regel staat in queueNote in de opening, het blok op /pricing. */}

  {/* ── 7 · VRAGEN — de eerste vijf; de rest op /faq ───────────────────── */}
  <Vragen lang={lang} id="vid-faq" dienst="video" faqs={c.faqs} />

  {/* ── 8 · HET SLOT — twee knoppen (PAGINA-OPBOUW.md, regel 5) ─────────────────────────────────────────────────────── */}
  <section class="paneel paneel-slot" aria-labelledby="vid-slot">
    <h2 id="vid-slot" class="hoog" set:html={c.ctaH} />
    <p class="lopend">{c.ctaP}</p>
    <p class="acties">
      <a class="knop knop-inkt" href={lp('/start/video')}>{c.ctaPrimary}</a>
      <a class="knop knop-lijn" href={lp('/contact')}>{c.ctaSecondary}</a>
    </p>
  </section>
</div>

<style>
  /* ── DE KOP BEGINT BOVENAAN, HET BEELD MAG ZWEVEN — 8 september 2026 ──────
     Lucas over /portal: *"bij deze pagina ook niet eerste sectie volledig
     gevuld."* Gemeten: de tekstkolom is daar 418 hoog naast een figuur van 954,
     en met `align-items: center` zweeft die tekst in het midden — 268 pixels
     wit bóven de kop. Een kop die op een derde van het paneel begint, leest als
     een fout en niet als lucht.
     Alle tien de openingsrasters op de site zijn nagemeten (kladblok/_open):
     vier stonden op 145 tot 268 pixels scheef. De regel is nu overal dezelfde:
     alles begint BOVEN. Daar begin je met lezen, daar staat de kop, en daar
     hoort het beeld ernaast te beginnen. Een uitzondering voor het beeld is
     geprobeerd en weer weggehaald: de plaatshouderfiguren komen uit een ander
     component en krijgen in Astro een eigen scope-attribuut, dus die regel
     raakte de helft van de gevallen niet — en een consistentieregel die op de
     helft van de pagina's iets anders doet, is geen regel. Eén uitlijning,
     tien pagina's, geen uitzonderingen. */
  /* ── DE LAPTOP KRIJGT DE GROOTSTE HELFT — 17 september 2026 ───────────────
     Lucas: *"Het mag wel wat groter, het voelt nu alsof het niet belangrijk is.
     Kijk of groter maken beter is of pas de indeling van de sectie aan waardoor
     het alsnog groter gemaakt kan worden."*

     De tweede weg, want de eerste loopt vast: de plaat groter maken binnen een
     kolom van 48% betekent hem over de tekst heen leggen. De INDELING verandert
     dus — de tekstkolom wordt de kleinste van de twee.

     0,85 tegen 1,15 en niet 1,05 tegen 0,95. Op 1440 gaat de plaat daarmee van
     678 naar ongeveer 860 pixels, een derde groter, en de tekstkolom houdt nog
     ruim 500 — genoeg voor de kop, de vier feiten naast elkaar en twee knoppen
     op een regel. Kleiner dan dat wordt de feitenstrook een kolom van één, en
     dan wint de plaat ruimte die de tekst nodig had. */
  /* ── DE GROND VAN DE OPENING — 18 september 2026 ──────────────────────────
     Lucas koos hier het vierde bannerbeeld: een harde schaduwlijn met een donker vlak ernaast.

     Een laag onder de inhoud en geen `background` op de sectie zelf: zo blijft
     `--vel` de grond en ligt het beeld erop als iets dat je in één regel uit
     kunt zetten. Dezelfde constructie als op de voorpagina.

     De laptop blijft staan waar hij stond — Lucas: *"de laptop blijft
     overal"* — dus dit beeld moet ACHTER hem door kunnen lopen zonder de tekst
     links te raken. Vandaar `right center`: de uitsnede houdt de harde schaduw met het donkere vlak aan de
     rechterkant, waar de plaat eroverheen valt, en laat de tekstkolom op de
     rustige helft staan. */
  .vid-grond { position: relative; isolation: isolate; }
  .vid-grond::before {
    content: '';
    /* ── ALLEEN DE RECHTERHELFT ──────────────────────────────────────────────
       Over de hele breedte gemeten viel de schaduwband precies over de kop:
       inkt op middengrijs, en dat is de enige plek op deze pagina waar de tekst
       niet mag vechten. Deze band begint daarom op 38% en loopt met een masker
       in vanaf links, zodat hij achter de laptop staat — daar waar hij hoort,
       want dat is het donker waarin een clip leeft — en de tekstkolom op schoon
       `--vel` blijft staan.

       Hetzelfde masker als op de plaat zelf (zie `.lc.is-naast`): een verloop
       dat op nul begint en niet op een rand, anders zie je een naad. */
    position: absolute; inset: 0 0 0 38%;
    background: url('/img/band-video.webp') no-repeat right center / cover;
    /* Twee verlopen die elkaar SNIJDEN: links invaren, en onderaan weer
       uitvaren. Dat tweede is er voor de regel onder de plaat ("↑ wat jij
       stuurt") en de dienstenrij eronder — inkt op een donkere band is precies
       het soort onleesbaarheid dat een sfeerbeeld niet waard is. */
    -webkit-mask-image:
      linear-gradient(to right, transparent 0%, #000 22%, #000 100%),
      linear-gradient(to bottom, #000 0%, #000 44%, transparent 68%);
    mask-image:
      linear-gradient(to right, transparent 0%, #000 22%, #000 100%),
      linear-gradient(to bottom, #000 0%, #000 44%, transparent 68%);
    -webkit-mask-composite: source-in;
    mask-composite: intersect;
    pointer-events: none;
    z-index: -1;
  }
  /* Op een smal scherm staat de laptop ONDER de tekst en is er geen rechterhelft
     meer; dan zou de band dwars over de kop vallen. Daar blijft hij weg. */
  @media (max-width: 900px) {
    .vid-grond::before { content: none; }
  }
  .vid-open { display: grid; grid-template-columns: minmax(0, .85fr) minmax(0, 1.15fr); gap: clamp(1.2rem, 3.5vw, 2.6rem); align-items: start; }
  .vid-open .paneel-kop { margin-bottom: 0; gap: 1.1rem; }
  /* Geen vaste verhouding meer: de laptopplaat brengt zijn eigen 1,77 mee en
     een 4:3 eromheen zou hem samendrukken. */
  .vid-beeld { position: relative; }
  .vid-wacht { font-size: .92rem; color: var(--inkt-2); }

  .vid-waar-regel { margin-top: 1.4rem; font-size: .92rem; color: var(--inkt-2); display: flex; flex-wrap: wrap; gap: .4rem .6rem; align-items: baseline; }
  /* Op licht sinds de kamer weg is: geen gele letter meer (die was voor inkt),
     gewoon de inktkleur met een streep. */
  .vid-noot { margin-top: .8rem; font-size: .92rem; color: var(--inkt-2); max-width: 62ch; }
  .vid-noot :global(a) { color: inherit; text-decoration: underline; text-underline-offset: 3px; }

  .vid-stappen { display: grid; }
  .vid-stappen li { display: grid; grid-template-columns: auto minmax(0, 22rem) minmax(0, 30rem); align-items: baseline; gap: clamp(1rem, 3vw, 2.5rem); padding: clamp(1.1rem, 2.4vw, 1.8rem) 0; border-top: 1px solid var(--lijn); }
  .vid-stappen li:last-child { border-bottom: 1px solid var(--lijn); }
  .vid-stappen .nr { color: var(--inkt-2); }
  .vid-stappen b { font-family: var(--kop2); font-weight: 500; font-stretch: 125%; font-size: clamp(1.05rem, 1.8vw, 1.45rem); text-transform: uppercase; letter-spacing: -.01em; }

  .vid-twee-licht { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(1.5rem, 4vw, 3.5rem); align-items: start; }
  .vid-check { display: grid; gap: .6rem; margin-top: 1.4rem; }
  .vid-check li { position: relative; padding-left: 1.4rem; color: var(--inkt-2); }
  .vid-check li::before { content: "✓"; position: absolute; left: 0; color: var(--gloed, currentColor); }
  .vid-koop { display: grid; gap: .8rem; padding: clamp(1.4rem, 3vw, 2rem); border: 1px solid var(--lijn-sterk); border-radius: calc(var(--ronding) - 8px); }
  .vid-vast { padding-top: 1rem; border-top: 1px solid var(--lijn); font-size: .92rem; }
  .vid-vast b { font-weight: 500; }

  .vid-tiernoot { color: var(--inkt-2); margin-bottom: 1.6rem; }

  @media (max-width: 900px) {
    .vid-open, .vid-twee-licht { grid-template-columns: 1fr; }
    .vid-stappen li { grid-template-columns: auto 1fr; }
    .vid-stappen li .lopend { grid-column: 2; }
  }
</style>
