---
import { useTranslations } from '../i18n/ui.js';

// VISUAILS — Compare: the working before/after. Replaces the old drag-slider
// (.ba) and cursor-lens (.spot), which shipped blank because they were gated
// behind a scroll-reveal clip that didn't always fire. This one is always
// visible and pure CSS: the divider drifts on a slow loop so it reads as a
// comparison with no interaction needed; hovering pauses it (see global.css
// .cmp). Two modes:
//   • true pair  — pass a distinct `before` and `after` photo (e.g. the real
//     raw-phone → catalog shot).
//   • grade mode — pass `grade` with the same photo for both; the "before"
//     is auto-flattened (desaturated) so it reads as an honest colour-grade
//     before/after for the styles where we have one finished photo, not a
//     separate raw one.
interface Props {
  before: string;
  after: string;
  beforeAlt?: string;
  afterAlt?: string;
  grade?: boolean;
  ratio?: string;
  beforeLabel?: string;
  afterLabel?: string;
  objectPosition?: string;
}
// Locale-aware default labels (the visible BEFORE/AFTER tags). Two locales,
// not three: src/i18n/ui.js's own header is explicit that the site has never
// shipped German ("no German" — grep confirms no /de/ route in verify3's
// route inventory, no de.astro anywhere). A 'de' branch lived here anyway,
// dead since this component was written — reachable only if a caller passed
// a literal '/de/...' pathname, which nothing on the site does. Removed in
// the 2026-07-28 audit (task #263) rather than left as a third language this
// file alone appeared to support.
const _seg = (Astro.url.pathname || '/').split('/')[1];
const _lang = _seg === 'nl' ? _seg : 'en';
const _lbl = { en: ['Before', 'After'], nl: ['Voor', 'Na'] }[_lang];
// The slider handle's own label. It was hardcoded English on every Dutch page —
// and unlike a visible label, this string has exactly one audience: someone
// using a screen reader, for whom the wrong language is the whole message.
//
// It then sat here as its own two-language object while cmp_drag held the exact
// same two sentences in src/i18n/ui.js, where every other string on the site
// lives. Two copies of one sentence is how a translation goes stale without
// anything failing: change one, and nothing anywhere reports the other.
const _drag = useTranslations(_lang)('cmp_drag');
const {
  before,
  after,
  beforeAlt = 'Before VISUAILS',
  afterAlt = 'After VISUAILS',
  grade = false,
  ratio,
  beforeLabel = _lbl[0],
  afterLabel = _lbl[1],
  objectPosition,
} = Astro.props;
// When before/after have different aspect ratios (e.g. a 3:4 raw phone photo
// vs a 1:1 finished shot in a square frame), object-position lets the caller
// re-centre the crop so the product isn’t clipped at an edge.
const posStyle = objectPosition ? `object-position:${objectPosition}` : undefined;

// Intrinsic pixel size of every photo any caller hands this component, read
// from the files in public/img — NOT the displayed size. The .cmp box is
// absolutely positioned and object-fit: cover, so these attributes never
// change what you see; they exist so the browser knows the aspect ratio
// before the bytes land (§12: LCP under 2.5s on 4G, no shift).
//
// Deliberately a hard lookup, not a lookup-with-fallback: pass a photo that
// isn’t listed and the build stops, which is the only way a new call site
// can’t quietly reintroduce a width-less <img>. Add the entry, don’t soften
// the throw.
const INTRINSIC: Record<string, [number, number]> = {
  '/img/banners-13.webp': [2400, 1792],
  '/img/catalog-after.webp': [1800, 1800],
  '/img/catalog-before.webp': [1350, 1800],
  /* De vierkante uitsnede van diezelfde telefoonfoto — 23 augustus 2026.
     `catalog-after` is 1800x1800; de bron van de before is 1350x1800. Zolang die
     twee verschilden, moest elke aanroeper met `objectPosition` bijsturen, en op
     de homepage stond de vergelijking daarom in 3:4 — waardoor het EINDRESULTAAT
     niet volledig in beeld stond, terwijl dat het beeld is dat het argument moet
     maken. Nu dragen beide kanten dezelfde verhouding en valt het bijsturen weg. */
  '/img/catalog-before-1x1.webp': [1350, 1350],
  '/img/lifestyle-dunes-01.webp': [928, 1152],
  '/img/lifestyle-flash-01.webp': [928, 1152],
  '/img/lifestyle-flash-02.webp': [1340, 2400],
  '/img/lifestyle-glow-01.webp': [1340, 2400],
  '/img/lifestyle-glow-06.webp': [2400, 1792],
  '/img/lifestyle-phone-made-01.webp': [2400, 1792],
  '/img/lifestyle-phone-made-11.webp': [2400, 1792],
};
const size = (src: string): [number, number] => {
  const d = INTRINSIC[src];
  if (!d) throw new Error(`Compare.astro: no intrinsic size on record for ${src} — add it to INTRINSIC.`);
  return d;
};
const [beforeW, beforeH] = size(before);
const [afterW, afterH] = size(after);
---

<div class:list={['cmp', grade && 'cmp-grade']} style={ratio ? `aspect-ratio:${ratio}` : undefined}>
  <img class="cmp-before" src={before} alt={beforeAlt} loading="lazy" decoding="async" width={beforeW} height={beforeH} style={posStyle} />
  <img class="cmp-after" src={after} alt={afterAlt} loading="lazy" decoding="async" width={afterW} height={afterH} style={posStyle} />
  <span class="cmp-tag before">{beforeLabel}</span>
  <span class="cmp-tag after">{afterLabel}</span>
  <span class="cmp-divider">
    <span class="cmp-knob" tabindex="0" role="slider" aria-label={_drag} aria-valuemin="0" aria-valuemax="100" aria-valuenow="50"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 7l-4 5 4 5M16 7l4 5-4 5" /></svg></span>
  </span>
</div>
