---
/* Eén beeld in een bestelling: de tegel, het bijschrift, de beoordeelknoppen
   en wat erover gezegd is. De toestand komt uit shotView() in account.js —
   dezelfde beslissingen als het oude shotTile()/reviewControls(), dus het
   scherm biedt nooit iets aan wat /account/review weigert.

   De formulieren posten naar dezelfde routes als voorheen (accountPost). Het
   aanvinkvak en de notitie voor de revisieronde dragen `form="ronde-<id>"` en
   horen bij het formulier onderaan de bestelling (Bestelling.astro). */
import { standKlasse } from '../../data/status.js';
import NieuwTabblad from '../NieuwTabblad.astro';
/* `lang` (8 oktober 2026, o26): alleen voor de zin "opent in een nieuw tabblad". */
/* `proefEenKeer`: Product.astro zet de proefzin dan één keer onder de beelden. */
const { v, orderId, lang = 'en', proefEenKeer = false } = Astro.props;
/* HET VINKJE DAT GOEDKEURT (levering 57; afvinklijst 34, b-vink = doen). Het vinkje uit
   het kit in drie delen: het korte been, het lange been en het vlagje. Na "Goedkeuren"
   komt de klant terug op #f<id> (account.js); alleen dat beeld is dan :target, en daar
   zet het vinkje zich in drie tikken (studio-hal.css). Alle andere goedgekeurde beelden
   staan stil: niets beweegt bij het laden. Geen script (de CSP van Studio). */
const VINK3 = '<svg class="st-vink3" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path class="kort" d="M8 13.19L7.6 12.9L7.15 12.7L6.66 12.61L1.21 12.6L9.4 20.24L9.4 13.44L9 14.13Z"/><path class="lang" d="M10 20.8L15.64 11.04L12.9 7.39L9.4 13.44L9.4 20.24Z"/><path class="vlag" d="M14.15 5.21L16.89 8.86L20.6 2.45L15.75 2.45Z"/></svg>';
---
<li class="st-beeld" id={`f${v.id}`}>
  {v.gone
    ? <div class="st-beeld-media is-weg"><span>{v.expiredText}</span></div>
    : <a class={`st-beeld-media${v.viewable ? '' : ' is-bestand'}`} href={v.href} target="_blank" rel="noopener">
        {v.viewable
          ? <img src={v.href} alt={v.caption} loading="lazy" decoding="async" />
          : <span class="st-beeld-ext">{v.ext}</span>}
        {v.badge && <span class={`st-badge ${standKlasse(v.badge.kind)}`}>{v.badge.kind === 'approved' && <Fragment set:html={VINK3} />}{v.badge.text}</span>}
        <NieuwTabblad lang={lang} />
      </a>}
  <div class="st-beeld-body">
    <span class="st-beeld-cap">{v.caption}</span>
    {v.file && <span class="st-beeld-file">{v.file}</span>}
    {v.review.kind === 'sample' && !proefEenKeer && <p class="st-meta st-beeld-noot">{v.review.text}</p>}
    {v.review.kind === 'settled' && <p class="st-meta st-beeld-noot">{v.review.text}</p>}
    {v.review.kind === 'undo' && (
      <form class="st-keur" method="post" action="/account/review">
        <input type="hidden" name="file" value={v.id} />
        <button class="btn btn-2nd btn-sm" type="submit" name="action" value="undo">{v.review.label}</button>
      </form>
    )}
    {v.review.kind === 'approve' && (
      <Fragment>
        <form class="st-keur" method="post" action="/account/review">
          <input type="hidden" name="file" value={v.id} />
          <button class="btn btn-primary btn-sm" type="submit" name="action" value="approve" formnovalidate>{v.review.label}</button>
        </form>
        {v.review.ask && v.review.ask.revoked && <p class="st-meta st-beeld-noot">{v.review.ask.revoked}</p>}
        {v.review.ask && !v.review.ask.revoked && (
          <div class="st-aanmerk">
            <label class="st-vink">
              <input type="checkbox" form={`ronde-${orderId}`} name="file" value={v.id} />
              <span>{v.review.ask.tick}</span>
            </label>
            <label class="sr-only" for={`n${v.id}`}>{v.review.ask.note}</label>
            <textarea id={`n${v.id}`} class="st-veld st-veld-klein" form={`ronde-${orderId}`} name={`note-${v.id}`} rows="2" maxlength={v.review.ask.max} placeholder={v.review.ask.hint}></textarea>
          </div>
        )}
      </Fragment>
    )}
    {v.said.map((s) => (
      s.kind === 'said'
        ? <p class="st-gezegd">{s.text}</p>
        : <p class="st-gezegd is-antwoord"><b>{s.label}</b> {s.text}</p>
    ))}
  </div>
</li>
