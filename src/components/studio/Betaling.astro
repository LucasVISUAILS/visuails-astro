---
/* Het betaalblok van een bestelling. paymentView() in account.js bepaalt de
   regels, de zin en of er een knop is; hier staat alleen de vorm. */
import { paymentView } from '../../lib/account.js';
const { t, lang, order } = Astro.props;
const v = paymentView(t, lang, order);
---
{v && (
  <div class={`st-betaal ${v.cls}`}>
    <dl class="st-betaal-rijen">
      {v.rows.map(([k, val]) => <div class="st-betaal-rij"><dt>{k}</dt><dd>{val}</dd></div>)}
    </dl>
    <p class="st-betaal-staat">{v.line}</p>
    {/* 2.02: bij een creditsbestelling de termijnfactuur die hem dekt. */}
    {v.facturen && v.facturen.length > 0 && (
      <p class="st-betaal-factuur">{v.factuurLabel} {v.facturen.map((f, i) => <Fragment>{i > 0 && ', '}<a class="st-link" href={f.href}>{f.label}</a></Fragment>)}</p>
    )}
    {v.payHref && (
      <form method="post" action={v.payHref}><button class="btn btn-primary btn-sm" type="submit">{t.payNow}</button></form>
    )}
  </div>
)}
