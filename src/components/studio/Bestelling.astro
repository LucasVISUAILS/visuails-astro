---
/* De volledige bestelkaart op Bestellingen. Klapt in (native <details>, geen
   script): de kop draagt kenmerk, dienst · aantal · datum · openstaand bedrag,
   de vier stappen als stippen en de statuspil. Open staat wat aandacht vraagt
   — de nieuwste, een onbetaalde, een met een revisie, een gesloten zonder
   tevredenheidsvraag — en de bestelling waar de link naar wijst. Gegevens en
   beslissingen: orderView() in account.js.

   Twee blokken komen als HTML binnen: de tevredenheidsvraag (feedback.js, met
   public/feedback.css) en het revisiebeleid (een lijst uit revisiebeleid()). */
import Pil from './Pil.astro';
import Voortgang from './Voortgang.astro';
import Betaling from './Betaling.astro';
import Product from './Product.astro';
import Beeld from './Beeld.astro';
const { t, lang, v, order, events = [], files = [] } = Astro.props;
---
<details class="st-kaart-vlak st-bestelling" id={`order-${v.id}`} open={v.openNow}>
  <summary class="st-bestelling-kop">
    <h2 class="st-ref">{v.ref}</h2>
    <span class="st-bestelling-meta">{v.bits.map(([k, val]) => <span class={`st-bit st-bit-${k}`}>{val}</span>)}</span>
    {v.mini.length > 0 && (
      <span class="st-mini" role="img" aria-label={v.statusLabel}>{v.mini.map((s) => <i class={`st-mini-stip is-${s}`}></i>)}</span>
    )}
    <Pil status={v.status} lang={lang} />
    <span class="st-chevron" aria-hidden="true"></span>
  </summary>
  <div class="st-bestelling-body">
    {v.windowLine && <p class="st-meta">{v.windowLine}</p>}
    {Number(Astro.url.searchParams.get('order')) === Number(v.id) && Astro.url.searchParams.get('terug') === '1' && v.status === 'awaiting_payment' && (
      <p class="st-melding" role="status">{t.payTerug}</p>
    )}
    <Betaling t={t} lang={lang} order={order} />
    <Voortgang t={t} lang={lang} order={order} events={events} files={files} />
    {/* Ronde 9, F55: foto's bij een bestaande bestelling zetten — de bestelling
        die de studio namens de klant aanmaakt, heeft ze vaak nog niet. Gegevens
        en wanneer hij verschijnt: fotosView() in account.js. */}
    {(() => {
      const q = Astro.url.searchParams;
      if (Number(q.get('order')) !== Number(v.id) || !q.has('fotos')) return null;
      const f = q.get('fotos');
      const n = Number(f);
      const tekst = f === 'dicht' ? t.fotosDicht : n > 0 ? t.fotosOk(n) : t.fotosNiets;
      return <p class={`st-melding ${n > 0 ? 'is-ok' : 'is-warn'}`} role="status">{tekst}</p>;
    })()}
    {v.fotos && (
      <form class={`st-ronde st-fotos${v.fotos.leeg ? ' is-ready' : ''}`} method="post" action={v.fotos.action} enctype="multipart/form-data">
        <h3>{v.fotos.h}</h3>
        <p>{v.fotos.p}</p>
        <label class="st-fotos-kies">
          <span class="sr-only">{v.fotos.cta}</span>
          <input type="file" name="fotos" multiple required data-melding={lang === 'nl' ? 'Kies eerst een of meer foto’s van je product — daar maken we de beelden van.' : 'Choose one or more photos of your product first — that is what we make the images from.'} accept=".jpg,.jpeg,.png,.webp,.avif,.heic,.heif,image/jpeg,image/png,image/webp,image/avif,image/heic" />
        </label>
        <button class={`btn ${v.fotos.leeg ? 'btn-primary' : 'btn-2nd'} btn-sm`} type="submit">{v.fotos.cta}</button>
        <p class="st-meta">{v.fotos.hint}</p>
      </form>
    )}
    {v.note && (
      <div class="st-nota"><span class="st-nota-wie">{t.noteFrom}</span><p>{v.note}</p></div>
    )}
    {v.closedNote && <p class="st-meta st-gesloten">{v.closedNote}</p>}
    {v.feedbackHtml && <div class="st-tevreden" set:html={v.feedbackHtml} />}

    {/* De map bovenaan en niet onder twintig productkaarten (29 september 2026):
        downloaden is wat de klant hier het vaakst komt doen. */}
    {v.products && v.folder && (
      <section class="st-map">
        <div class="st-map-tekst"><h3>{v.folder.h}</h3><p>{v.folder.body}</p>{v.folder.note && <p class="st-meta">{v.folder.note}</p>}</div>
        {v.folder.href && <a class="btn btn-primary btn-sm" href={v.folder.href}>{v.folder.cta}</a>}
      </section>
    )}

    {/* Alles in één keer goedkeuren (30 september 2026). Staat boven de
        productkaarten: wie tevreden is, hoeft ze niet één voor één open te
        klappen. Gegevens en de regel wanneer hij verschijnt: orderView(). */}
    {v.allesGoed && (
      <form class="st-keur-bestelling" method="post" action="/account/review">
        <input type="hidden" name="order" value={v.id} />
        <button class="btn btn-2nd btn-sm" type="submit" name="action" value="approve-order" formnovalidate>{v.allesGoed.label}</button>
        <p class="st-meta">{v.allesGoed.note}</p>
      </form>
    )}

    {/* ── TWINTIG LEGE RIJEN ZIJN ÉÉN REGEL — 19 september 2026 ──────────
        Zolang er voor geen enkel product iets geleverd is, zegt elke rij
        hetzelfde ("Hier is nog niets voor geleverd"). Bij een bestelling van
        twintig was dat twintig keer dezelfde zin onder elkaar. Vanaf zeven
        producten zonder levering staat de lijst dichtgeklapt achter één regel
        met het aantal; wie zijn productnamen wil nalopen, klapt hem open. */}
    {v.products && (() => {
      const nietsGeleverd = v.products.every((p) => !(p.delivered && p.delivered.length));
      const dicht = nietsGeleverd && v.products.length >= 7;
      const lijst = <div class="st-producten">{v.products.map((p) => <Product t={t} v={p} orderId={v.id} />)}</div>;
      return dicht
        ? (
          <details class="st-producten-dicht">
            <summary class="st-meta">{lang === 'nl'
              ? `${v.products.length} producten · nog niets geleverd`
              : `${v.products.length} products · nothing delivered yet`}</summary>
            {lijst}
          </details>
        )
        : lijst;
    })()}
    {v.sides && (
      <Fragment>
        {v.folder && (
          <section class="st-map">
            <div class="st-map-tekst"><h3>{v.folder.h}</h3><p>{v.folder.body}</p>{v.folder.note && <p class="st-meta">{v.folder.note}</p>}</div>
            {v.folder.href && <a class="btn btn-primary btn-sm" href={v.folder.href}>{v.folder.cta}</a>}
          </section>
        )}
        <div class="st-kanten">
          {[v.sides.delivered, v.sides.uploaded].map((k) => (
            <section class="st-kant">
              <h3>{k.h}</h3>
              {k.shots.length ? <ul class="st-beelden">{k.shots.map((b) => <Beeld v={b} orderId={v.id} />)}</ul> : <p class="st-meta">{k.empty}</p>}
            </section>
          ))}
        </div>
      </Fragment>
    )}

    {v.ronde && v.ronde.kind !== 'form' && (
      <section class={`st-ronde is-${v.ronde.kind}`}><h3>{v.ronde.h}</h3><p>{v.ronde.p}</p></section>
    )}
    {v.ronde && v.ronde.kind === 'form' && (
      <form class="st-ronde is-form" id={`ronde-${v.id}`} method="post" action={v.ronde.action}>
        <h3>{v.ronde.h}</h3>
        <p class="st-ronde-waarschuwing">{v.ronde.warn}</p>
        <p class="st-meta">{v.ronde.after}</p>
        <button class="btn btn-primary" type="submit">{v.ronde.send}</button>
        <div class="st-beleid" set:html={v.ronde.beleidHtml} />
      </form>
    )}

    {/* Eén vaste weg naar een mens, onder elke bestelling (ronde 8, S-B17). */}
    {v.contact && (
      <p class="st-contact">
        <span class="st-contact-h">{v.contact.h}</span>
        <a href={v.contact.wa.href} rel="noopener" target="_blank">{v.contact.wa.label}</a>
        <a href={v.contact.mail.href}>{v.contact.mail.label}</a>
        <span class="st-meta">{v.contact.note}</span>
      </p>
    )}
  </div>
</details>
