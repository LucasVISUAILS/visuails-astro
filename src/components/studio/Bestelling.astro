---
/* De volledige bestelkaart op Bestellingen. Klapt in (native <details>, geen
   script): de kop draagt kenmerk, dienst · aantal, de vier stappen als stippen
   en de statuspil, en daaronder de Nu-zin en (bij een geleverde bestelling) de
   twee datums. Onder de DICHTE kaart staat één knop; open begint de inhoud met
   "Downloaden (zip)" (punt 2.03, 8 oktober 2026). Open staat wat aandacht vraagt
   — de nieuwste, een onbetaalde, een met een revisie, een gesloten zonder
   tevredenheidsvraag — en de bestelling waar de link naar wijst. Gegevens en
   beslissingen: orderView() in account.js.

   Twee blokken komen als HTML binnen: de tevredenheidsvraag (feedback.js, met
   public/feedback.css) en het revisiebeleid (een lijst uit revisiebeleid()). */
import Pil from './Pil.astro';
import NieuwTabblad from '../NieuwTabblad.astro';
import Voortgang from './Voortgang.astro';
import Betaling from './Betaling.astro';
import Product from './Product.astro';
import Beeld from './Beeld.astro';
import { formaatMelding } from '../../lib/formaten.js';
const { t, lang, v, order, events = [], files = [] } = Astro.props;
---
<article class="st-kaart-vlak st-bestelling">
<details class="st-bestelling-klap" id={`order-${v.id}`} open={v.openNow}>
  <summary class="st-bestelling-kop">
    <h2 class="st-ref">{v.ref}</h2>
    {/* Ronde B (§28.2): "Credits" naast het kenmerk bij een bestelling die met
        abonnementscredits betaald is. */}
    {v.credits && <span class="credits-pil" title={t.pilCreditsTitel}><span aria-hidden="true">{t.pilCredits}</span><span class="sr-only">{t.pilCreditsTitel}</span></span>}
    <span class="st-bestelling-meta">{v.bits.map(([k, val]) => <span class={`st-bit st-bit-${k}`}>{val}</span>)}</span>
    {v.mini.length > 0 && (
      <span class="st-mini" role="img" aria-label={v.statusLabel}>{v.mini.map((s) => <i class={`st-mini-stip is-${s}`}></i>)}</span>
    )}
    <Pil status={v.status} lang={lang} />
    <span class="st-chevron" aria-hidden="true"></span>
    {/* Punt 2.03: één zin over wat er nu gebeurt of wat de klant moet doen,
        en na de levering de revisie- en de bewaardatum (leverdatums.js). */}
    {v.nu && v.nu.zin && (
      <span class="st-nu">
        <span class="st-nu-zin">{v.nu.zin}</span>
        {v.datums.map((d) => <span class="st-nu-datum">{d}</span>)}
      </span>
    )}
  </summary>
  <div class="st-bestelling-body">
    {/* De open kaart begint met "Downloaden (zip)" (punt 2.03): downloaden is
        wat de klant hier het vaakst komt doen. Ook bij de oudere bestellingen
        zonder producten (v.sides), waar de map eerst onder de kanten stond. */}
    {/* Punt 3.05 (8 oktober 2026): is de bestelling afgerond, dan staan de map
        (met de bewaardatum) en het tevredenheidsblok samen bovenaan, in het
        afrondblok waar "Alles goed" naartoe stuurt (#afgerond-<id>). */}
    <div class={v.afrondScherm ? 'st-afrond' : 'st-afrond-niet'} id={v.afrondScherm ? `afgerond-${v.id}` : undefined}>
    {v.folder && (
      <section class="st-map">
        <div class="st-map-tekst"><h3>{v.folder.h}</h3><p>{v.folder.body}</p>{v.afrondScherm && v.datums.length > 0 && <p class="st-map-datum">{v.datums.join(' ')}</p>}{v.folder.note && <p class="st-meta">{v.folder.note}</p>}</div>
        {v.folder.href && <a class="btn btn-primary btn-sm" href={v.folder.href}>{v.folder.cta}</a>}
      </section>
    )}
    {/* k401 (11 oktober 2026): jpg is de standaard; png en webp vraag je hier
        los aan. Eén gewoon formulier met twee knoppen, geen script; een
        aangevraagd formaat staat er als regel met de datum. Gegevens:
        formaatView() in src/lib/formaten.js. */}
    {v.formaten && (
      <form class="st-formaten" id={v.formaten.id} method="post" action={v.formaten.action}>
        <p class="st-formaten-uitleg"><span class="st-formaten-kop">{v.formaten.kop}</span> {v.formaten.uitleg}</p>
        <div class="st-formaten-knoppen">
          {v.formaten.knoppen.map((k) => k.staat
            ? <span class={`st-formaat-staat${k.klaar ? ' is-klaar' : ''}`}>{k.staat}</span>
            : <button class="btn btn-2nd btn-sm" type="submit" name="formaat" value={k.formaat}>{k.label}</button>)}
        </div>
        {Number(Astro.url.searchParams.get('order')) === Number(v.id) && formaatMelding(Astro.url.searchParams.get('formaat'), lang) && (
          <p class={`st-meta st-formaten-melding${Astro.url.searchParams.get('formaat') === 'fout' ? ' is-warn' : ''}`} role="status">{formaatMelding(Astro.url.searchParams.get('formaat'), lang)}</p>
        )}
      </form>
    )}
    {v.afrondScherm && v.feedbackHtml && <div class="st-tevreden" set:html={v.feedbackHtml} />}
    {/* Punt 3.07: "Bestel met dezelfde look" — één gewone link met alleen de
        lookkeuzes (herbestel.js); abonnees zien de credits per product. */}
    {v.herbestel && (
      <section class="st-herbestel" aria-label={v.herbestel.kop}>
        <h3>{v.herbestel.kop}</h3>
        <a class={`btn ${v.herbestel.proef ? 'btn-primary' : 'btn-2nd'} btn-sm`} href={v.herbestel.href}>{v.herbestel.label}</a>
        {v.herbestel.proef && v.herbestel.delen.length > 0 && <p class="st-meta">{v.herbestel.delen.join(' · ')}</p>}
        {(v.herbestel.proef || v.herbestel.credits) && <p class="st-herbestel-regel">{[v.herbestel.proef ? v.herbestel.vanaf : '', v.herbestel.credits].filter(Boolean).join(' · ')}</p>}
        <p class="st-meta">{v.herbestel.uitleg}</p>
        {v.herbestelAlles && (
          <p class="st-herbestel-alles"><a class="st-link" href={v.herbestelAlles.href}>{v.herbestelAlles.label} →</a> <span class="st-meta">{v.herbestelAlles.uitleg}</span></p>
        )}
      </section>
    )}
    </div>
    {v.windowLine && <p class="st-meta">{v.windowLine}</p>}
    {Number(Astro.url.searchParams.get('order')) === Number(v.id) && Astro.url.searchParams.get('terug') === '1' && v.status === 'awaiting_payment' && (
      <p class="st-melding" role="status">{t.payTerug}</p>
    )}
    <Betaling t={t} lang={lang} order={order} />
    <Voortgang t={t} lang={lang} order={order} events={events} files={files} />
    {/* Ronde 9, F55: foto's bij een bestaande bestelling zetten — de bestelling
        die de studio namens de klant aanmaakt, heeft ze vaak nog niet. Gegevens
        en wanneer hij verschijnt: fotosView() in account.js. */}
    {(() => {
      const q = Astro.url.searchParams;
      if (Number(q.get('order')) !== Number(v.id) || !q.has('fotos')) return null;
      const f = q.get('fotos');
      const n = Number(f);
      const mis = Number(q.get('mis')) || 0;
      /* Sinds 15 oktober (werklijst 14) ook: vervangen (vv) en verwijderd (weg). */
      const vv = Number(q.get('vv')) || 0;
      const weg = Number(q.get('weg')) || 0;
      const iets = n > 0 || vv > 0 || weg > 0;
      const tekst = f === 'dicht' ? t.fotosDicht : f === 'dag' ? t.fotosDag : iets
        ? [n > 0 ? (mis > 0 ? t.fotosDeels(n, mis) : t.fotosOk(n)) : '', vv > 0 ? t.fotosVervangen(vv) : '', weg > 0 ? t.fotosWeg(weg) : '', !n && mis > 0 ? t.fotosNiets : ''].filter(Boolean).join(' ')
        : t.fotosNiets;
      return <p class={`st-melding ${iets && !mis ? 'is-ok' : 'is-warn'}`} role="status">{tekst}</p>;
    })()}
    {/* Punt 2.05 (8 oktober 2026): per product de vier vakken, gevuld of leeg
        met een eigen bestandsveld, en bovenaan de ene lijst "wat ontbreekt".
        Eén gewoon formulier, geen script (Studio heeft een strenge CSP). Gegevens
        en wanneer hij verschijnt: fotosView() in account.js. */}
    {v.fotos && (v.fotos.los ? (
      <form class={`st-ronde st-fotos${v.fotos.leeg ? ' is-ready' : ''}`} id={v.fotos.anker} method="post" action={v.fotos.action} enctype="multipart/form-data">
        <h3>{v.fotos.h}</h3>
        <p>{v.fotos.p}</p>
        <label class="st-fotos-kies">
          <span class="sr-only">{v.fotos.cta}</span>
          <input type="file" name="fotos" multiple required data-melding={lang === 'nl' ? 'Kies eerst een of meer foto’s van je product — daar maken we de beelden van.' : 'Choose one or more photos of your product first — that is what we make the images from.'} accept=".jpg,.jpeg,.png,.webp,.avif,.heic,.heif,image/jpeg,image/png,image/webp,image/avif,image/heic" />
        </label>
        <button class={`btn ${v.fotos.leeg ? 'btn-primary' : 'btn-2nd'} btn-sm`} type="submit">{v.fotos.cta}</button>
        <p class="st-meta">{v.fotos.hint}</p>
      </form>
    ) : (() => {
      const product = (p) => (
        <fieldset class="st-vak-product" id={p.anker}>
          <legend class="st-vak-legend">{p.label}</legend>
          <ul class="st-vakken">
            {p.vakken.map((vak) => (
              <li class={`st-vak ${vak.gevuld ? 'is-gevuld' : vak.mist ? 'is-mist' : 'is-leeg'}`}>
                {vak.gevuld && (
                  <span class="st-vak-beeld" aria-hidden="true">
                    {vak.gevuld.beeld ? <img src={vak.gevuld.href} alt="" loading="lazy" decoding="async" /> : <span class="st-vak-ext">{vak.gevuld.ext || '—'}</span>}
                  </span>
                )}
                <span class="st-vak-naam">{vak.naam}</span>
                {vak.staat && <span class="st-vak-staat">{vak.staat}</span>}
                {vak.veld && (
                  <input class="st-vak-veld" type="file" name={vak.veld} aria-label={vak.aria} accept=".jpg,.jpeg,.png,.webp,.avif,.heic,.heif,image/jpeg,image/png,image/webp,image/avif,image/heic" />
                )}
              </li>
            ))}
          </ul>
          {/* Extra foto's: vervangen of verwijderen (werklijst 14, 15 oktober 2026).
              "Verwijderen" is een verzendknop van ditzelfde formulier met het
              nummer van de foto als waarde; wat je verder koos, gaat mee. */}
          {p.extra.length > 0 && (
            <ul class="st-vakken is-extra">
              {p.extra.map((x) => (
                <li class="st-vak is-gevuld is-extra">
                  <span class="st-vak-beeld" aria-hidden="true">
                    {x.gevuld.beeld ? <img src={x.gevuld.href} alt="" loading="lazy" decoding="async" /> : <span class="st-vak-ext">{x.gevuld.ext || '—'}</span>}
                  </span>
                  <span class="st-vak-naam">{x.naam}</span>
                  <label class="st-vak-vervang">
                    <span>{x.vervangLabel}</span>
                    <input class="st-vak-veld" type="file" name={x.vervang} aria-label={x.vervangAria} accept=".jpg,.jpeg,.png,.webp,.avif,.heic,.heif,image/jpeg,image/png,image/webp,image/avif,image/heic" />
                  </label>
                  <details class="st-vak-weg">
                    <summary>{x.wegLabel}</summary>
                    <button class="btn btn-ghost btn-sm" type="submit" name="weg" value={String(x.id)} aria-label={x.wegAria} formnovalidate>{x.wegJa}</button>
                  </details>
                </li>
              ))}
            </ul>
          )}
          {p.ander && (
            <label class="st-vak-ander">
              <span>{p.ander.label}</span>
              <input class="st-vak-veld" type="file" name={p.ander.veld} aria-label={p.ander.aria} accept=".jpg,.jpeg,.png,.webp,.avif,.heic,.heif,image/jpeg,image/png,image/webp,image/avif,image/heic" />
            </label>
          )}
        </fieldset>
      );
      return (
        <form class="st-ronde st-fotos st-vakform" id={v.fotos.anker} method="post" action={v.fotos.action} enctype="multipart/form-data">
          <h3>{v.fotos.h}</h3>
          {v.fotos.ontbreekt && (
            <div class="st-ontbreekt" role="note">
              <p class="st-ontbreekt-h">{v.fotos.ontbreekt.h}</p>
              <ul>{v.fotos.ontbreekt.regels.map((r) => <li>{r}</li>)}</ul>
              <p class="st-meta">{v.fotos.ontbreekt.na}</p>
            </div>
          )}
          <p>{v.fotos.p}</p>
          {v.fotos.vast && <p class="st-meta st-vak-vast">{v.fotos.vast}</p>}
          {v.fotos.producten.map(product)}
          {v.fotos.compleet.length > 0 && (
            <details class="st-vak-compleet" open={v.fotos.producten.length === 0}>
              <summary>{v.fotos.compleetLabel}</summary>
              {v.fotos.compleet.map(product)}
            </details>
          )}
          <button class="btn btn-primary btn-sm" type="submit">{v.fotos.cta}</button>
          <p class="st-meta">{v.fotos.hint}</p>
        </form>
      );
    })())}
    {v.note && (
      <div class="st-nota"><span class="st-nota-wie">{t.noteFrom}</span><p>{v.note}</p></div>
    )}
    {v.closedNote && <p class="st-meta st-gesloten">{v.closedNote}</p>}
    {!v.afrondScherm && v.feedbackHtml && <div class="st-tevreden" set:html={v.feedbackHtml} />}


    {/* Alles in één keer goedkeuren (30 september 2026). Staat boven de
        productkaarten: wie tevreden is, hoeft ze niet één voor één open te
        klappen. Gegevens en de regel wanneer hij verschijnt: orderView(). */}
    {v.allesGoed && (
      <form class="st-keur-bestelling" method="post" action="/account/review">
        <input type="hidden" name="order" value={v.id} />
        <button class="btn btn-2nd btn-sm" type="submit" name="action" value="approve-order" formnovalidate>{v.allesGoed.label}</button>
        <p class="st-meta">{v.allesGoed.note}</p>
      </form>
    )}

    {/* ── TWINTIG LEGE RIJEN ZIJN ÉÉN REGEL — 19 september 2026 ──────────
        Zolang er voor geen enkel product iets geleverd is, zegt elke rij
        hetzelfde ("Hier is nog niets voor geleverd"). Bij een bestelling van
        twintig was dat twintig keer dezelfde zin onder elkaar. Vanaf zeven
        producten zonder levering staat de lijst dichtgeklapt achter één regel
        met het aantal; wie zijn productnamen wil nalopen, klapt hem open. */}
    {v.products && (() => {
      const nietsGeleverd = v.products.every((p) => !(p.delivered && p.delivered.length));
      const dicht = nietsGeleverd && v.products.length >= 7;
      const lijst = <div class="st-producten">{v.products.map((p) => <Product t={t} v={p} orderId={v.id} lang={lang} />)}</div>;
      return dicht
        ? (
          <details class="st-producten-dicht">
            <summary class="st-meta">{lang === 'nl'
              ? `${v.products.length} producten · nog niets geleverd`
              : `${v.products.length} products · nothing delivered yet`}</summary>
            {lijst}
          </details>
        )
        : lijst;
    })()}
    {v.sides && (
      <Fragment>
        <div class="st-kanten">
          {[v.sides.delivered, v.sides.uploaded].map((k) => (
            <section class="st-kant">
              <h3>{k.h}</h3>
              {k.shots.length ? <ul class="st-beelden">{k.shots.map((b) => <Beeld v={b} orderId={v.id} lang={lang} />)}</ul> : <p class="st-meta">{k.empty}</p>}
            </section>
          ))}
        </div>
      </Fragment>
    )}

    {v.ronde && v.ronde.kind !== 'form' && (
      <section class={`st-ronde is-${v.ronde.kind}`}><h3>{v.ronde.h}</h3><p>{v.ronde.p}</p></section>
    )}
    {v.ronde && v.ronde.kind === 'form' && (
      <form class="st-ronde is-form" id={`ronde-${v.id}`} method="post" action={v.ronde.action}>
        <h3>{v.ronde.h}</h3>
        <p class="st-ronde-waarschuwing">{v.ronde.warn}</p>
        <p class="st-meta">{v.ronde.after}</p>
        <button class="btn btn-primary" type="submit">{v.ronde.send}</button>
        <div class="st-beleid" set:html={v.ronde.beleidHtml} />
      </form>
    )}

    {/* Werklijst 33: bij een bestelling die nog loopt staat "Opnieuw bestellen met
        alle instellingen" hier (bij een geleverde staat hij bij "Meer producten
        in deze look?"). */}
    {!v.herbestel && v.herbestelAlles && (
      <p class="st-herbestel-alles"><a class="st-link" href={v.herbestelAlles.href}>{v.herbestelAlles.label} →</a> <span class="st-meta">{v.herbestelAlles.uitleg}</span></p>
    )}
    {/* Eén vaste weg naar een mens, onder elke bestelling (ronde 8, S-B17). */}
    {v.contact && (
      <p class="st-contact">
        <span class="st-contact-h">{v.contact.h}</span>
        <a href={v.contact.wa.href} rel="noopener" target="_blank">{v.contact.wa.label}<NieuwTabblad lang={lang} /></a>
        <a href={v.contact.mail.href}>{v.contact.mail.label}</a>
        <span class="st-meta">{v.contact.note}</span>
      </p>
    )}
  </div>
</details>
{/* De ene knop onder de dichte kaart (punt 2.03). Open staat de actie zelf
    bovenaan de inhoud; dan verbergt studio.css deze knop (details[open] + …). */}
{v.nu && v.nu.knop && (
  <div class="st-nu-knop">
    {v.nu.knop.form
      ? <form method="post" action={v.nu.knop.form}><button class="btn btn-primary btn-sm" type="submit">{v.nu.knop.label}</button></form>
      : <a class="btn btn-primary btn-sm" href={v.nu.knop.href}>{v.nu.knop.label}</a>}
  </div>
)}
</article>
