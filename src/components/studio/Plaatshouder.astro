---
/* Een plaatshouder in Studio, in dezelfde taal als de plaatshouders van de site
   (scripts/plaatshouders.mjs): een vlak, een haarlijn, het teken op 12%, en
   "FOTO VOLGT" in mono. Inline svg, want Studio laadt geen beelden van buiten
   en de CSP staat geen inline style toe. `naam` is het onderschrift (wat hier
   straks komt te staan), `ratio` de verhouding als "4/5". `donker` voor op een
   inktvlak. `klein` laat de tekst weg — alleen het teken. */
const { naam = '', ratio = '4/5', donker = false, klein = false, label = 'FOTO VOLGT' } = Astro.props;
const [rw, rh] = String(ratio).split('/').map(Number);
const w = 400, h = Math.round(400 * (rh || 5) / (rw || 4));
const k = Math.min(w, h);
const fs1 = Math.round(k * 0.07), fs2 = Math.round(k * 0.055);
const cx = w / 2, cy = h / 2;
/* Het V-beeldmerk (MERK_V/MERK_VLAG) stond hier tot 19 september 2026 op 12 %
   in elk plaatshoudertje — dus ook op elk "vastgezet"-kader in het abonnement
   en op elke "foto volgt"-kaart in Studio. Dat merk is uit de roulatie. Wat
   overblijft is de stilste vorm die nog iets zegt: het vlak, de haarlijn en
   een dun kruis van hoek tot hoek — het teken voor "hier komt beeld". */
/* Uit KLEURENSCHEMA.md, 20 september 2026: de tweede trede van elke modus,
   met de lijn- en inktwaarden die daarbij horen. */
const grond = donker ? '#1C1F25' : '#E4E7EC', lijn = donker ? '#3A3E46' : '#AFB4BC', inkt = donker ? '#F2F3F5' : '#000000';

/* DE LETTER IN DIT PLAATSHOUDERTJE STAAT VOLUIT, NIET ALS var(--font-mono).
   Een SVG erft de tokens van zijn pagina wel, maar dit ding wordt ook los
   gerenderd — in tests en in de proefpagina's — waar dat :root er niet is.
   Sinds sectie 22 is de mono van de site Martian Mono; hier stond nog Sometype
   Mono, dat nergens meer geladen wordt, dus viel het terug op Menlo. De 82%
   breedte is dezelfde als .etiket in stijl22.css. */
---
<svg class={`st-ph${donker ? ' is-donker' : ''}`} viewBox={`0 0 ${w} ${h}`} role="img" aria-label={naam ? `${label}: ${naam}` : label}>
  <rect width={w} height={h} fill={grond} />
  <rect x="0.5" y="0.5" width={w - 1} height={h - 1} fill="none" stroke={lijn} />
  <g stroke={lijn} stroke-width="1" opacity=".7"><line x1="0.5" y1="0.5" x2={w - 0.5} y2={h - 0.5} /><line x1={w - 0.5} y1="0.5" x2="0.5" y2={h - 0.5} /></g>
  {!klein && (
    <g font-family="Martian Mono Variable, ui-monospace, Menlo, monospace" font-stretch="82%" text-anchor="middle" fill={inkt}>
      <text x={cx} y={cy + fs1 * 0.6} font-size={fs1} letter-spacing={fs1 * 0.08}>{label}</text>
      {naam && <text x={cx} y={cy + fs1 * 0.6 + fs2 * 1.9} font-size={fs2} opacity=".6">{naam}</text>}
    </g>
  )}
</svg>
