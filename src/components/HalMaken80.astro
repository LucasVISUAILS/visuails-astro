---
import SectieKop from './SectieKop.astro';
import { halV } from '../data/beeldVersie.js';
/* ═══════════════════════════════════════════════════════════════════════════════
   WAT WE MAKEN — levering 80, 1 november 2026 (lijst 64, s-maken); als vijf kaarten sinds levering 95 (13 november 2026)
   ═══════════════════════════════════════════════════════════════════════════════
   Lucas (13 november, 00:46): "Ik wil de categorie kaarten een beetje zoals het voorbeeld met de kleurrijke platen hebben.
   Voeg dan ook hooks en beeld op maat toe. De klant kan dan zonder overdonderd te worden kiezen wat hij nodig heeft." En:
   "Zorg dat alles mooi consistent oogt en rust geeft met een minimalistische interface." Lijst 95: A1 a (één kaart groot in
   het midden, de buren kleiner ernaast), A2 a (lifestyle: de vrouw in de duinen, vol beeld), A3 a ("Eigen look"), en zijn
   notities: de hoodie op de grond van de site en iets groter, volle beelden (niets uitgeknipt), video = het stilstaande
   beeld met de sneeuw bij de waterval als naadloze lus, hooks nog zonder video, de eigen look "geen foto maar meer een soort
   op maat gemaakt en overleggen met ons". Geen kleurverloop en geen glas zoals in zijn voorbeeld: dat past niet in het
   kleurenschema; de rust komt van één grote kaart tegelijk en weinig tekst.

   ZONDER SCRIPT staan de vijf kaarten in een rij die je opzij schuift (scroll-snap), elk met zijn naam en prijs eronder.
   MET SCRIPT (.m8-aan, sinds levering 99, lijst 100 A1 a): 2,5 kaarten in beeld, de gekozen kaart groot links, de volgende
   en de helft van die daarna op 82 % tot de rand van het venster; zwaar en soepel doorklikken, na de laatste terug naar de
   eerste met bewegingsonscherpte, en vanzelf verder als de muis er niet is (zie het script onderaan). Eronder de naam,
   één zin, de prijs, de knop naar de dienst en "Bestel dit" (naar zijn plek op /start, lijst 100 E2), en onder de kaarten
   één regel dat de beelden van de klant zijn (lijst 100 A3 a).
   Klik een kaart, de pijlen of de streepjes, de pijltjestoetsen, of veeg. Een klik op de gekozen kaart opent de dienst.
   De video speelt als hij de gekozen kaart is en in beeld staat; de animaties op Productfoto's en Lifestyle spelen onder de
   muis (op een telefoon als de kaart gekozen is); nooit bij "minder beweging".
   ═══════════════════════════════════════════════════════════════════════════════ */
import '../styles/maken-80.css';
import { laptopSlides } from '../data/laptopSlides.js';
import { openingVersie } from '../data/openingStanden.js';
import { localizedPath } from '../i18n/ui.js';
import { ikoon, IKOON } from '../data/iconen.js';

interface Props {
  lang: 'nl' | 'en';
  kop: string;
  zin: string;
  diensten: string[][];         /* [naam, prijs, href, zin, knop, bestel?] uit COPY.diensten: productfoto's, lifestyle, video, hooks, eigen look */
  vrij?: string[];              /* levering 99 (lijst 100 A3 a): [zin, linktekst, href] — de klant is vrij in waar hij de beelden gebruikt */
  bestelTekst?: string;         /* levering 99 (lijst 100 E2): de stille link naast de knop */
  ookKop: string;
  ook: string[][];              /* [naam, href] */
  eenProduct?: string;          /* wat één product kost (afvinklijst 5): klein onder wat er verder is */
  label?: string;               /* levering 96: met een label de vaste sectiekop (SectieKop.astro) */
  /** fase 3 (lijst 113): als rij, de foto's links en de tekst rechts */
  rij105?: boolean;
}
const { lang, kop, zin, diensten, ookKop, ook, eenProduct, label, vrij, bestelTekst, rij105 } = Astro.props;
const nl = lang === 'nl';
const lp = (p: string) => localizedPath(lang, p);
const T = nl
  ? { vorige: 'Vorige', volgende: 'Volgende', baan: 'Wat we maken', kaart: (i: number, n: number, naam: string) => `${naam}, ${i} van ${n}`,
      chip: ['Foto', 'Foto', 'Video', 'Video', 'Op maat'],
      alt: ['Blauwe zip-hoodie van NON/STD', 'Een vrouw in een zwarte leren jas en lange leren rok in de duinen, bij het blauwe uur', 'Een man in een bordeauxrode jas met kap staat stil voor een waterval terwijl het sneeuwt'] }
  : { vorige: 'Previous', volgende: 'Next', baan: 'What we make', kaart: (i: number, n: number, naam: string) => `${naam}, ${i} of ${n}`,
      chip: ['Photo', 'Photo', 'Video', 'Video', 'Made to measure'],
      alt: ['Blue NON/STD zip hoodie', 'A woman in a black leather jacket and long leather skirt in the dunes at blue hour', 'A man in a burgundy hooded jacket stands still in front of a waterfall while it snows'] };
/* levering 96 (lijst 96 C1 b, lijst 98): de catalogusanimatie op de kaart Productfoto's (src/scripts/catalogkaart96.js). De
   namen en prijzen zijn die van de verzonnen winkel NON/STD (laptopSlides.js); de herkleuringen: scripts/catalogus-kleuren-96.py */
const NS: any[] = (laptopSlides(lang, { product: 'nonstd' }).catalog as any).producten || [];
const nsP = (naam: string) => NS.find((p) => p.naam === naam) || { titel: naam, prijs: '' };
const K = nl ? { blauw: 'blauw', zwart: 'zwart', indigo: 'indigo', wit: 'wit' } : { blauw: 'blue', zwart: 'black', indigo: 'indigo', wit: 'white' };
const CAT = '/img/hal/maken/catalogus/';
const CAT96 = {
  /* de versie achter elk beeld (zoals de opening, tests/letter-77): verandert een beeld, dan haalt elke browser hem opnieuw */
  v: openingVersie(),
  foto: `${CAT}foto`, clip: '/img/hal/telefoon/clip-hoodie', voor: '/img/hal/opening/galerij/hoodie-0', achter: '/img/hal/opening/galerij/hoodie-1', detail: '/img/hal/opening/galerij/hoodie-3',
  zes: ([['hoodie', 'hoodie-blauw', 'blauw'], ['hoodie', 'hoodie-zwart', 'zwart'], ['broek', 'jeans-zwart', 'zwart'], ['broek', 'jeans-indigo', 'indigo'], ['sokken', 'sokken-wit', 'wit'], ['sokken', 'sokken-zwart', 'zwart']] as [string, string, keyof typeof K][])
    .map(([p, b, k]) => ({ src: `${CAT}${b}`, naam: `${nsP(p).titel} [${K[k]}]`, prijs: `${nsP(p).prijs.replace('€ ', '€')} EUR` })),
  woorden: nl ? { voor: 'Voorkant', cat: 'Catalogus', achter: 'Achterkant', detail: 'Detail', alles: 'Bekijk alles' } : { voor: 'Front', cat: 'Catalogue', achter: 'Back', detail: 'Detail', alles: 'View all' },
};
const srcset = (n: string, maten: number[], ext: string, map = 'rust') => maten.map((b) => `${halV(`/img/hal/${map}/${n}-${b}.${ext}`)} ${b}w`).join(', ');
const SIZES = '(max-width: 700px) 62vw, 340px';
/* alleen "Bekijk …": een bestelknop gaat nooit rechtstreeks naar een formulier (de vaste regel, tests/start-looks); bestellen
   doe je op de pagina van de dienst of met "Start een bestelling" in de banner */
const data = diensten.map(([naam, prijs, href, z, knop, bestel]) => ({ naam, prijs, zin: z, knop, href: lp(href), bestel: bestel ? lp(bestel) : '' }));
/* levering 99 (lijst 100 A2 a): de lifestyleanimatie (src/scripts/lifestylekaart99.js), met de foto's op model van NON/STD
   (zoals de laptop op /lifestyle) en het bericht van NON/STD */
const LIFE99 = {
  v: openingVersie(), clip: '/img/hal/telefoon/clip-hoodie', account: 'nonstd', likes: 1204,
  fotos: ['hoodie', 'jeans', 'sokken'].map((n) => ({ src: `/img/hal/maken/lifestyle99/${n}` })),
  woorden: nl ? { life: 'Lifestyle', feed: 'In je feed' } : { life: 'Lifestyle', feed: 'In your feed' },
};
---
<section class:list={['m8', rij105 && 'r105', label && 'sk-s']} id="maken" aria-labelledby="m8-kop">
  {label ? <SectieKop id="m8-kop" label={label} kop={kop} zin={zin} /> : (
  <div class="m8-kopgroep">
    <h2 id="m8-kop" class="h-kop m8-kop">{kop}</h2>
    <p class="m8-zin">{zin}</p>
  </div>)}
  <div class="m8-carrousel" data-m8 role="region" aria-roledescription={nl ? 'carrousel' : 'carousel'} aria-label={T.baan}>
    <ul class="m8-baan" role="list" data-m8-baan>
      {diensten.map(([naam, prijs, href], i) => (
        <li class={`m8-dienst m8-k${i}`} style={`--i:${i}`} data-m8-kaart={i}>
          <a href={lp(href)} class="m8-kaart" data-m8-link aria-label={T.kaart(i + 1, diensten.length, naam)}>
            {i === 0 && (
              <picture>
                <source type="image/avif" srcset={srcset('hoodie', [480, 720, 960], 'avif')} sizes={SIZES} />
                <img class="m8-prod" src={halV(`/img/hal/rust/hoodie-720.webp`)} srcset={srcset('hoodie', [480, 720, 960], 'webp')} sizes={SIZES} width="1564" height="1811" alt={T.alt[0]} loading="lazy" decoding="async" />
              </picture>
            )}
            {i === 0 && <span class="c96" data-m8-cat data-d={JSON.stringify(CAT96)} aria-hidden="true"></span>}
            {i === 1 && <span class="c96 l99" data-m8-life data-d={JSON.stringify(LIFE99)} aria-hidden="true"></span>}
            {i === 1 && (
              <picture>
                <source type="image/avif" srcset={srcset('lifestyle', [480, 720, 1080], 'avif', 'maken')} sizes={SIZES} />
                <img src={halV('/img/hal/maken/lifestyle-720.webp')} srcset={srcset('lifestyle', [480, 720, 1080], 'webp', 'maken')} sizes={SIZES} width="1080" height="1350" alt={T.alt[1]} loading="lazy" decoding="async" />
              </picture>
            )}
            {i === 2 && (
              <video class="m8-video" data-m8-video muted loop playsinline preload="none" poster={halV('/img/hal/maken/video-poster-720.webp')}
                     data-klein={halV('/img/hal/maken/video-720.mp4')} data-groot={halV('/img/hal/maken/video-1080.mp4')} aria-label={T.alt[2]}></video>
            )}
            {i > 2 && <span class="m8-ikoon" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><path fill-rule="evenodd" d={IKOON[i === 3 ? 'afspelen' : 'potlood']} /></svg></span>}
          </a>
          <p class="m8-onder"><span class="m8-naam">{naam}</span><span class="m8-prijs">{prijs}</span></p>
        </li>
      ))}
    </ul>
    <div class="m8-info" aria-live="polite" data-m8-info hidden>
      <h3 class="m8-info-naam" data-m8-naam></h3>
      <p class="m8-info-zin" data-m8-zin></p>
      <p class="m8-info-prijs" data-m8-prijs></p>
      <p class="m8-knoppen">
        <a class="h-knop k k-vol" data-rol="doorgaan" data-m8-knop href={data[0].href}><span data-m8-knoptekst>{data[0].knop}</span><Fragment set:html={ikoon('pijl')} /></a>
        {bestelTekst && <a class="m8-bestel" data-m8-bestel href={data[0].bestel || lp('/start')} hidden={!data[0].bestel}>{bestelTekst}</a>}
      </p>
    </div>
    <div class="m8-nav" data-m8-nav hidden>
      <button type="button" class="m8-pijl" data-m8-r="-1" aria-label={T.vorige}><svg viewBox="0 0 24 24" focusable="false" aria-hidden="true"><path fill-rule="evenodd" d={IKOON['pijl-links']} /></svg></button>
      <div class="m8-stip">{diensten.map(([naam], i) => <button type="button" data-m8-ga={i} aria-label={naam}><i></i></button>)}</div>
      <button type="button" class="m8-pijl" data-m8-r="1" aria-label={T.volgende}><svg viewBox="0 0 24 24" focusable="false" aria-hidden="true"><path fill-rule="evenodd" d={IKOON.pijl} /></svg></button>
    </div>
    <script type="application/json" data-m8-data set:html={JSON.stringify(data)} />
  </div>
  {vrij && <p class="m8-vrij">{vrij[0]} <a href={lp(vrij[2])}>{vrij[1]}</a></p>}
  <p class="m8-ook"><span class="m8-ook-kop">{ookKop}</span>{ook.map(([naam, href]) => <a href={lp(href)}>{naam}</a>)}</p>
  {eenProduct && <p class="h-onderregel m8-regel">{eenProduct}</p>}
</section>

<script>
  import { catalogKaart } from '../scripts/catalogkaart96.js';
  import { lifestyleKaart } from '../scripts/lifestylekaart99.js';
  type D = { naam: string; prijs: string; zin: string; knop: string; href: string; bestel: string };
  /* ═══ DE BAAN — levering 99, 13 november 2026 (lijst 100 A1 a, met Lucas' notitie) ═══════════════════════════════════
     "2,5 in beeld en de rest zie je pas als je door klikt en de kaarten mogen wat groter", "smooth … als Apple en dat de
     animatie wat zwaar voelt en iets langzaam maar niet te langzaam", "als de laatste kaart is bereikt en er word verder
     geklikt springt hij dus weer terug naar de eerste kaart met de motion blur", "Ook als de klant niet op de sectie zit
     met zijn muis gaan de kaarten vanzelf rustig verder … redelijk wat tijd tussen het wisselen … als de muis in het
     kaartengebied zit en er omheen dan bewegen de kaarten niet vanzelf."
     - De gekozen kaart staat zo dat hij, de volgende (82 %) en de helft van de kaart daarna (82 %) precies tot de rand
       van het venster lopen: 2,5 in beeld. Links ervan is lucht; daar verdwijnen de kaarten die geweest zijn. Op een
       telefoon: de kaart 76 % breed vanaf de marge, de volgende er half naast.
     - De kaart is 4 : 5 en zo groot als past: hoogstens 62 % van de hoogte van het venster en 600 px breed.
     - De overgang: 0,9 s, cubic-bezier(.32, .72, 0, 1) (de curve van iOS): snel weg, lang en zwaar uitlopen.
     - Na de laatste: terug naar de eerste in 0,75 s met horizontale bewegingsonscherpte (een SVG-filter dat met de vaart
       meegroeit, dezelfde veeg als bij de galerij).
     - Vanzelf: elke 7 s de volgende, alleen als de baan in beeld is, de muis niet in het gebied (plus 64 px eromheen) staat,
       er geen focus in zit, het tabblad zichtbaar is, en niet bij "minder beweging". Na een klik begint de 7 s opnieuw.
     - De animaties op de kaarten (catalogus, lifestyle) spelen met een muis alleen als je op die kaart staat; zonder
       muis (telefoon) als de kaart gekozen is en in beeld staat. De video speelt als de kaart gekozen is. */
  function m8() {
    const c = document.querySelector<HTMLElement>('[data-m8]');
    if (!c || c.dataset.m8Aan) return;
    c.dataset.m8Aan = '1';
    const data = JSON.parse(c.querySelector('[data-m8-data]')!.textContent || '[]') as D[];
    const baan = c.querySelector<HTMLElement>('[data-m8-baan]')!;
    const kaarten = [...c.querySelectorAll<HTMLElement>('[data-m8-kaart]')];
    const links = [...c.querySelectorAll<HTMLAnchorElement>('[data-m8-link]')];
    const info = c.querySelector<HTMLElement>('[data-m8-info]')!, nav = c.querySelector<HTMLElement>('[data-m8-nav]')!;
    const stip = [...c.querySelectorAll<HTMLButtonElement>('[data-m8-ga]')];
    const vid = c.querySelector<HTMLVideoElement>('[data-m8-video]');
    const minder = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const muis = matchMedia('(hover: hover) and (pointer: fine)').matches;
    const catLaag = c.querySelector<HTMLElement>('[data-m8-cat]');
    const cat = catLaag ? catalogKaart(catLaag, JSON.parse(catLaag.dataset.d || '{}')) : null;
    const lifeLaag = c.querySelector<HTMLElement>('[data-m8-life]');
    const life = lifeLaag ? lifestyleKaart(lifeLaag, JSON.parse(lifeLaag.dataset.d || '{}')) : null;
    const bestel = c.querySelector<HTMLAnchorElement>('[data-m8-bestel]');
    const n = kaarten.length;
    let nu = 0, zicht = false, onder = -1, binnen = false, klok = 0;
    c.classList.add('m8-aan'); info.hidden = false; nav.hidden = false;

    /* de veeg: een horizontaal SVG-filter, één voor de hele baan */
    const NS = 'http://www.w3.org/2000/svg';
    const svg = document.createElementNS(NS, 'svg'); svg.setAttribute('width', '0'); svg.setAttribute('height', '0'); svg.setAttribute('aria-hidden', 'true');
    svg.style.position = 'absolute';
    svg.innerHTML = '<filter id="m8-veeg" x="-20%" y="0" width="140%" height="100%"><feGaussianBlur stdDeviation="0 0" /></filter>';
    c.appendChild(svg);
    const veeg = svg.querySelector('feGaussianBlur')!;

    function maat() {
      const bw = baan.clientWidth || 1000;
      /* als rij (fase 3) staan de kaarten in hun eigen kolom: niet tot de rand van het venster */
      const rechts = c.closest('.r105') ? 0 : Math.max(0, document.documentElement.clientWidth - baan.getBoundingClientRect().right);
      const tel = bw < 700, s = .82, g = tel ? 14 : Math.round(Math.min(28, bw * .02));
      const ruimte = bw + rechts;                               /* van de linkermarge tot de rand van het venster */
      let w = tel ? Math.round(bw * .76) : Math.round(Math.min(600, innerHeight * .62 * .8, (ruimte - 2 * g) / (1 + s * 1.5)));
      w = Math.max(220, w);
      /* op de telefoon staat de gekozen kaart in het midden (lijst 114: "op telefoon het toch gecentreerd") */
      const x0 = tel ? Math.max(0, Math.round((bw - w) / 2)) : Math.max(0, Math.round(ruimte - (w + g + s * w + g + s * w * .5)));
      return { w, s, g, x0, tel };
    }
    function zet(sprong = false) {
      const { w, s, g, x0 } = maat();
      baan.style.setProperty('--m8-w', `${w}px`);
      c.style.setProperty('--m8-x0', `${x0}px`);
      kaarten.forEach((k, i) => {
        const d = i - nu;
        let x: number, sc: number, o: number;
        if (d === 0) { x = x0; sc = 1; o = 1; }
        else if (d > 0) { x = x0 + w + g + (d - 1) * (s * w + g); sc = s; o = d > 2 ? 0 : 1; }
        else { x = x0 + d * (w + g); sc = s; o = 0; }
        k.style.setProperty('--x', `${Math.round(x)}px`); k.style.setProperty('--s', String(sc)); k.style.setProperty('--o', String(o));
        k.style.zIndex = String(10 - Math.abs(d));
        k.classList.toggle('m8-nu', d === 0);
        const weg = d < 0 || d > 2;
        k.setAttribute('aria-hidden', weg ? 'true' : 'false');
        links[i].tabIndex = weg ? -1 : 0;
        if (d === 0) links[i].setAttribute('aria-current', 'true'); else links[i].removeAttribute('aria-current');
      });
      stip.forEach((st, i) => st.setAttribute('aria-current', i === nu ? 'true' : 'false'));
      const dd = data[nu];
      c.querySelector('[data-m8-naam]')!.textContent = dd.naam;
      c.querySelector('[data-m8-zin]')!.textContent = dd.zin;
      c.querySelector('[data-m8-prijs]')!.textContent = dd.prijs;
      const knop = c.querySelector<HTMLAnchorElement>('[data-m8-knop]')!; knop.href = dd.href;
      c.querySelector('[data-m8-knoptekst]')!.textContent = dd.knop;
      if (bestel) { bestel.hidden = !dd.bestel; if (dd.bestel) bestel.href = dd.bestel; }
      speel();
    }
    function speel() {
      const mag = !minder && zicht;
      const wil = (i: number) => mag && (muis ? onder === i : nu === i);
      if (cat) { if (wil(0)) cat.speel(); else cat.stop(); }
      if (life) { if (wil(1)) life.speel(); else life.stop(); }
      if (!vid) return;
      if (mag && nu === 2) {
        if (!vid.src) { const groot = kaarten[2].getBoundingClientRect().width * Math.min(2, devicePixelRatio || 1) > 760; vid.src = (groot ? vid.dataset.groot : vid.dataset.klein) || ''; }
        vid.play().catch(() => {});
      } else vid.pause();
    }
    /* terug naar de eerste: met de veeg, die meegroeit met de vaart (een klok over de duur van de overgang) */
    function terug() {
      c.classList.add('m8-terug');
      const t0 = performance.now(), D = 750;
      const stap = (t: number) => {
        const p = Math.min(1, (t - t0) / D), v = Math.sin(Math.PI * Math.min(1, p * 1.15));
        veeg.setAttribute('stdDeviation', `${(v * 22).toFixed(1)} 0`);
        if (p < 1) requestAnimationFrame(stap); else { veeg.setAttribute('stdDeviation', '0 0'); c.classList.remove('m8-terug'); }
      };
      requestAnimationFrame(stap);
    }
    const naar = (i: number, hand = true) => {
      if (i >= n) { nu = 0; if (!minder) terug(); }
      else if (i < 0) { nu = n - 1; if (!minder) terug(); }
      else nu = i;
      zet(); if (hand) wacht();
    };
    /* vanzelf */
    function wacht() {
      clearTimeout(klok);
      if (minder) return;
      klok = window.setTimeout(() => { if (!binnen && zicht && !document.hidden && !c.contains(document.activeElement)) naar(nu + 1, false); wacht(); }, 7000);
    }
    /* de muis in het gebied (de kaarten, de tekst en de knoppen, plus 64 px eromheen) */
    const gebied = c;
    if (muis) {
      addEventListener('pointermove', (e) => {
        const r = gebied.getBoundingClientRect(), m = 64;
        binnen = e.clientX >= r.left - m && e.clientX <= Math.min(innerWidth, r.right + m) && e.clientY >= r.top - m && e.clientY <= r.bottom + m;
      }, { passive: true });
      document.addEventListener('pointerleave', () => { binnen = false; });
      links.forEach((l, i) => {
        l.addEventListener('pointerenter', () => { onder = i; speel(); });
        l.addEventListener('pointerleave', () => { if (onder === i) { onder = -1; speel(); } });
      });
    }
    /* een klik op een kaart die niet gekozen is, kiest hem; een klik op de gekozen kaart opent de dienst */
    links.forEach((l, i) => l.addEventListener('click', (e) => { if (i !== nu) { e.preventDefault(); naar(i); } }));
    c.querySelectorAll<HTMLButtonElement>('[data-m8-r]').forEach((p) => p.addEventListener('click', () => naar(nu + Number(p.dataset.m8R))));
    stip.forEach((st, i) => st.addEventListener('click', () => naar(i)));
    c.addEventListener('keydown', (e) => {
      if ((e.target as HTMLElement).closest('.m8-info')) return;
      if (e.key === 'ArrowRight') { naar(nu + 1); e.preventDefault(); }
      if (e.key === 'ArrowLeft') { naar(nu - 1); e.preventDefault(); }
    });
    let x0: number | null = null, y0 = 0;
    baan.addEventListener('pointerdown', (e) => { x0 = e.clientX; y0 = e.clientY; });
    baan.addEventListener('pointerup', (e) => {
      if (x0 !== null && Math.abs(e.clientX - x0) > 40 && Math.abs(e.clientX - x0) > Math.abs(e.clientY - y0)) {
