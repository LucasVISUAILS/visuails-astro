  },

  nl: {
    h1: ['Al je bestellingen.', 'Op één plek.'],
    lede: `In VISUAILS Studio staan al je bestellingen: waar elke bestelling staat, de beelden zodra ze klaar zijn, en bij elk beeld een knop om het goed te keuren of te zeggen wat er niet klopt. Je logt in met je e-mailadres — we mailen je een code en een link, en een wachtwoord is er niet. Bij elke bestelling krijg je daarnaast een privélink, voor wie mee moet kijken zonder in te loggen. Vanaf ${WINDOW_THRESHOLD} producten staat er een leverdatum naast: gereserveerd zodra je bestelt, vast zodra je hebt betaald.`,
    ctaLogin: 'Inloggen',
    ctaStart: 'Start een bestelling',

    stateH: 'Waar hij staat, zonder te vragen.',
    // Zie de noot bij de Engelse stateLede.
    /* 14 oktober 2026: "het portaal" heet overal VISUAILS Studio, en het laatste heet "Afgerond", zoals in Studio zelf (nuzin.js). */
    stateLede: 'Studio begint bij de status van je bestelling. Vier stappen die hij doorloopt, een revisie die onderweg kan gebeuren en het afronden aan het eind — en waar jij staat is het eerste dat je ziet.',
    states: [
      ['Ontvangen', `Je bestelling is binnen. Vanaf ${WINDOW_THRESHOLD} producten is de leverdatum gereserveerd, en na betaling ligt hij vast.`],
      ['In productie', 'De studio werkt de map door.'],
      ['Wordt nagekeken', 'Elk beeld wordt bekeken voordat het weggaat.'],
