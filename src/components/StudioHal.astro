interface Props { lang: 'en' | 'nl'; }
const { lang } = Astro.props;
const nl = lang === 'nl';
const lp = (p: string) => localizedPath(lang, p);

const COPY = {
  en: {
    h1: ['Every order.', 'In one place.'],
