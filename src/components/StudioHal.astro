    dlManifest: 'Elk geleverd bestand krijgt een onzichtbaar label mee dat zegt dat er AI is gebruikt. Reken daar niet alleen op: de vermelding die telt is de zichtbare die jij plaatst, en op de AI Act-pagina staat een zin die je kunt gebruiken.',
    dlManifestNoteTerm: 'de herkomsttag',
    dlManifestNote: 'We zetten hem ook in de WebP, waar de omzetting weggooide wat de modelaanbieder erin had gezet. Toch: elk programma dat een beeld opnieuw opslaat kan hem er weer uit halen, en aanbieders van systemen die al op de markt waren hebben tot 2 december 2026 om überhaupt te markeren.',

    logH: 'Elke goedkeuring en revisie blijft terug te lezen.',
    logLede: 'Elke goedkeuring en elke revisie krijgt een tijdstempel en wordt bewaard bij het betreffende beeld, en je kunt de reeks op elk moment teruglezen via je eigen link. Vraag ernaar en we schrijven het voor je uit als overzicht. Er zit hier geen knop die een document genereert, en we doen ook niet alsof.',
    logCta: 'Lees de AI Act-pagina',

    secH: 'Waarom er geen wachtwoord is.',
    secLede: 'Een wachtwoord is nog iets om kwijt te raken, en voor een link die je drie keer opent levert het niets op. Daarom hebben we de link zelf zo gemaakt dat niemand hem kan raden.',
    sec: [
      ['Niet te raden', 'De link bestaat uit 256 willekeurige bits — geen volgnummer dat je kunt ophogen om bij de bestelling van iemand anders te komen.'],
      ['Nooit leesbaar opgeslagen', 'We bewaren alleen een onomkeerbare vingerafdruk ervan, dus niemand kan de link uit onze database teruglezen.'],
      ['Tegen raden beschermd', 'Wie blijft proberen, wordt na een paar pogingen tegengehouden, nog voordat er iets wordt opgezocht.'],
      ['Hij verloopt', `De link werkt niet meer vanaf ${PORTAL_TTL_DAYS} dagen nadat de bestelling is afgerond. De bronbestanden die je stuurde worden ${UPLOAD_DAYS} dagen na het afronden verwijderd.`],
    ],
    secNote: 'Behandel de link zoals je een sleutel behandelt: wie hem heeft, kan de bestelling zien. Stuur hem gerust door als een collega hem nodig heeft, en vraag ons om een nieuwe als hij ergens belandt waar hij niet hoort.',

    closeH: 'Eerst één product van jezelf, als catalogset of carrousel.',
    closeLede: `${TEST_SAMPLE.nl.deliverable}, gemaakt van je eigen foto en vóór levering nagekeken. VISUAILS Studio krijg je bij elke betaalde bestelling.`,
    closeCta: TEST_SAMPLE.nl.cta,
    closeAlt: 'Start een bestelling',
  },
};

const c = COPY[lang];

/* ── DE INLEIDING, OPGEKNIPT ───────────────────────────────────────────────
   Vier zinnen: wat er in Studio staat, hoe je inlogt, de privélink, de leverdatum.
   De eerste staat bij de kop, de andere drie elk op hun eigen kaart. Breekt een
   wijziging aan de inleiding dat in iets anders dan vier zinnen, dan stopt de bouw
   hier in plaats van stil een kaart leeg te laten. */
const zinnen = c.lede.split(/(?<=\.)\s+(?=[A-Z])/);
if (zinnen.length !== 4) throw new Error(`StudioHal: de inleiding (${lang}) heeft ${zinnen.length} zinnen, verwacht 4`);

/* ── DE HAL ─────────────────────────────────────────────────────────────── */
/* De iconen uit het kit (levering 54, afvinklijst 34): links de naam in dit
   onderdeel, rechts het icoon in src/data/iconen.js. */
const ICOON = { pijl: 'pijl-schuin', rechts: 'pijl', check: 'vink', label: 'prijs', klok: 'klok', revisie: 'vernieuwen', slot: 'slot', map: 'map', dobbel: 'onleesbaar', vinger: 'versleuteld', rem: 'meter', sleutel: 'sleutel' } as const;
const ik = (n: keyof typeof ICOON) => ikoon(ICOON[n]);
const DRIE = (n: number) => String(n).padStart(2, '0');

/* Het voorbeeldlogboek hoort bij dezelfde verzonnen bestelling als FigDash en
   FigGallery (figdemo.js): dezelfde referentie, de dag na het levervenster. */
const venster = demoWindow(DEMO_ORDER.products);
const naLevering = dayLabel(new Date(Date.parse(`${venster.end}T00:00:00Z`) + 86400000).toISOString().slice(0, 10), lang);

const H = nl ? {
  kaarten: [
    { label: c.ctaLogin, titel: 'Een code in je mail.' },
    { label: 'Privélink', titel: 'Een link om mee te kijken.' },
    { label: 'Leverdatum' },
  ],
  staatPil: 'Status',
  staatKop: ['Waar hij staat,', 'zonder te vragen.'],
  onderweg: ['Onderweg', 'Na de levering'],
  galPil: 'Galerij',
  galKop: ['Beeld voor beeld', 'goedkeuren.'],
  dlPil: 'Downloaden',
  dlKop: ['Eén map,', 'en alles zit erin.'],
  logPil: 'Logboek',
  logKop: ['Elke goedkeuring en revisie', 'blijft terug te lezen.'],
  logBadge: 'Voorbeeld met verzonnen gegevens',
  log: [
    ['10:14', 'Product 1 · voorkant', 'Goedgekeurd', ''],
    ['10:16', 'Product 1 · achterkant', 'Revisie aangevraagd', 'De mouw valt links anders dan rechts.'],
    ['10:21', 'Product 2 · achterkant', 'Goedgekeurd', ''],
  ],
  secPil: 'De link',
  secKop: ['Waarom er', 'geen wachtwoord is.'],
  bits: 'bits',
  dagen: 'dagen',
  proefKop: ['Eén product van jezelf,', 'voor'] as [string, string], /* 14 okt: korter, de zin eronder noemt de set al */
} : {
  kaarten: [
    { label: c.ctaLogin, titel: 'A code in your inbox.' },
    { label: 'Private link', titel: 'A link to look along.' },
    { label: 'Delivery date' },
  ],
  staatPil: 'Status',
  staatKop: ['Where it is,', 'without asking.'],
  onderweg: ['Along the way', 'After delivery'],
  galPil: 'Gallery',
  galKop: ['Approve it', 'image by image.'],
  dlPil: 'Download',
  dlKop: ['One folder,', 'and everything is in it.'],
  logPil: 'Log',
  logKop: ['Every approval and revision', 'stays readable afterwards.'],
  logBadge: 'Example with made-up data',
  log: [
    ['10:14', 'Product 1 · front', 'Approved', ''],
    ['10:16', 'Product 1 · back', 'Revision requested', 'The sleeve sits differently on the left than on the right.'],
    ['10:21', 'Product 2 · back', 'Approved', ''],
  ],
  secPil: 'The link',
  secKop: ['Why there is', 'no password.'],
  bits: 'bits',
  dagen: 'days',
  proefKop: ['One of your own products,', 'for'] as [string, string],
};

/* De drie kaarten onder het scherm: de zinnen 2, 3 en 4 van de inleiding. */
const KAARTEN = [
  { ...H.kaarten[0], zin: zinnen[1], href: `/account?lang=${lang}` },
  { ...H.kaarten[1], zin: zinnen[2], href: '#sleutel' },
  { ...H.kaarten[2], zin: zinnen[3], href: `${lp('/how-it-works')}#planning`, getal: `${WINDOW_THRESHOLD}+` },
];
/* Vier stappen die een bestelling doorloopt, en twee dingen die onderweg kunnen gebeuren
   (zie de noot bij stateLede in StudioPage.astro: revisie is een toestand van een BEELD,
   afgesloten is closed_at — geen van beide is een orderstatus). */
const STAPPEN = c.states.slice(0, 4);
const ONDERWEG = c.states.slice(4);
/* De map, sinds 14 oktober 2026 uit dezelfde functie als de echte zip
   (deliveryEntries in delivery.js), zoals in FigGallery: "01 - Wijde jeans/" met
   per formaat een map en "1-voorkant.jpg". Hier stond "product-1/" met
   "voorkant.png" en de drie formaten alsof ze er altijd in zitten. JPG voorop;
   PNG en WebP met de opmerking dat je ze erbij vraagt. */
const ZIP = deliveryEntries([{ id: 1, product_key: 'p1', shot: 'front', r2_key: 'x/0', bytes: 0, filename: 'front.jpg',
  assets: ['jpg', 'png', 'webp'].map((format) => ({ format, r2_key: `x/0.${format}`, bytes: 0 })) }],
  lang, { ref: DEMO_ORDER.ref, productNames: { p1: nl ? 'Gewassen T-shirt' : 'Washed T-shirt' } })
  .map((e) => e.name.split('/').slice(1));
const productMap = ZIP[0][0];
const VOLG = ['JPG', 'PNG', 'WEBP'];
const bestanden = ZIP.map((p) => p.slice(1)).sort((x, y) => VOLG.indexOf(x[0]) - VOLG.indexOf(y[0]));
const opAanvraag = nl ? 'met één klik erbij' : 'one click to add';
/* 15 oktober 2026 (Lucas: *"Deze foto mag ook aangepast worden naar een gehele andere
   foto omdat deze lage kwaliteit is"*): hier stond de modelfoto van de roze jeans, 760 px
   breed en op deze plek op ruim 650 px getoond. Nu het gewassen T-shirt uit de
   voor-en-na op /catalog, 1800 × 1800 — een voorkant, net als "1-front.jpg" in de map
   eronder, en de map heet nu naar dat product. */
const MAPFOTO = { src: '/img/catalog-after.webp', w: 1800, h: 1800 };
/* Het label op de voorpagina: de waarde die écht in elk bestand komt (src/lib/iptc.js). */
const IPTC_WAARDE = tagNaam(LEVERTAG);
const IPTC_WOORD = TAG_WOORD[LEVERTAG][lang];
/* De sleutel: de eerste kaart draagt de 256 bits, de laatste de dagen uit token.js. */
const SLEUTEL_IKOON: (keyof typeof ICOON)[] = ['dobbel', 'vinger', 'rem', 'klok'];
---

<div class="h-pagina h-sd-pagina">

  {/* ── 1 · DE OPENING: de koprij, en het scherm er direct onder ─────────── */}
  <header class="h-sd-kop">
    <div class="h-sd-kop-links">
      <p class="h-pil h-op" style="--d:0"><span>VISUAILS Studio</span></p>
      <h1 class="h-kop h-h1 h-op" style="--d:1"><span class="l">{c.h1[0]}</span> <span class="d">{c.h1[1]}</span></h1>
    </div>
    <div class="h-sd-kop-rechts">
      <p class="h-lede h-op" style="--d:2">{zinnen[0]}</p>
      {/* Inloggen bovenaan (1.11): letterlijk /account met ?lang=, nooit door lp() —
          /account heeft geen /nl-variant (tests/nav.test.mjs §11). */}
      <p class="h-acties h-op" style="--d:3">
        <a class="h-knop h-knop-inkt" href={`/account?lang=${lang}`}>{c.ctaLogin}<span class="o" set:html={ik('pijl')} /></a>
        <a class="h-knop h-knop-lijn" href={lp('/start')}>{c.ctaStart}</a>
      </p>
    </div>
  </header>

  <section class="h-sec h-sd-scherm-sec" aria-label={nl ? 'VISUAILS Studio, een voorbeeld' : 'VISUAILS Studio, an example'}>
    <div class="h-sd-scherm h-in">
      <span class="h-korrel" aria-hidden="true"></span>
      <div class="h-sd-fig"><FigDash lang={lang} uitleg /></div>
    </div>
    <ul class="h-weten-rij h-sd-rij" role="list">
      {KAARTEN.map((k, i) => (
        <li class={`h-in${k.getal ? ' h-groot' : ''}`} style={`--d:${i}`}>
          <a href={k.href}>
            <span class="h-weten-boven"><span class="h-pil h-pil-wit"><span>{k.label}</span></span><span class="h-cirkel h-cirkel-wit" aria-hidden="true" set:html={ik('pijl')} /></span>
            {k.getal
              ? <span class="h-weten-onder"><span class="h-getal">{k.getal}</span><span class="h-weten-zin">{k.zin}</span></span>
              : <span class="h-weten-onder"><b>{k.titel}</b><span class="h-weten-zin">{k.zin}</span></span>}
          </a>
        </li>
      ))}
    </ul>
  </section>

  {/* ── 2 · DE TOESTANDEN: vier stappen, en twee dingen onderweg ─────────── */}
  <section class="h-sec h-sd-staat-sec" aria-labelledby="sd-staat">
    <div class="h-sd-staat h-in">
      <header class="h-sd-staat-kop">
        <div>
          <p class="h-pil h-pil-wit"><span>{H.staatPil}</span></p>
          <h2 id="sd-staat" class="h-kop h-h2"><span class="l">{H.staatKop[0]}</span> {H.staatKop[1]}</h2>
        </div>
        <p class="h-pr-kopzin">{c.stateLede}</p>
      </header>
      <ol class="h-st-stappen h-sd-stappen" role="list">
        {STAPPEN.map(([k, v], i) => (
          <li class="h-st-stap" style={`--d:${i}`}>
            <p class="h-nr" aria-hidden="true"><b>{DRIE(i + 1)}</b><i></i><span>/ {DRIE(STAPPEN.length)}</span></p>
            <span class="h-st-stap-naam">{k}</span>
            <span class="h-sd-zin">{v}</span>
          </li>
        ))}
      </ol>
      <ul class="h-sd-onderweg" role="list">
        {ONDERWEG.map(([k, v], i) => (
          <li>
            <span class="h-sd-onderweg-boven"><span class="h-cirkel h-cirkel-wit h-cirkel-klein" aria-hidden="true" set:html={ik(i === 0 ? 'revisie' : 'slot')} /><span class="h-sd-etiket">{H.onderweg[i] || H.onderweg[0]}</span></span>
            <span class="h-st-stap-naam">{k}</span>
            <span class="h-sd-zin">{v}</span>
          </li>
        ))}
      </ul>
      <p class="h-sd-noot"><span class="h-sd-noot-i" aria-hidden="true" set:html={ik('klok')} /><span>{c.stateNote}</span></p>
    </div>
  </section>

  {/* ── 3 · DE GALERIJ: beeld voor beeld goedkeuren ───────────────────────── */}
  <section class="h-sec h-sd-gal-sec" aria-labelledby="sd-gal">
    <div class="h-sd-twee">
      <div class="h-sd-tekst h-in">
        <p class="h-pil"><span>{H.galPil}</span></p>
        <h2 id="sd-gal" class="h-kop h-h2"><span class="l">{H.galKop[0]}</span> {H.galKop[1]}</h2>
        <p class="h-sd-zin-groot">{c.galleryLede}</p>
        <dl class="h-sd-def">
          {c.galleryList.map(([k, v]) => (<div><dt>{k}</dt><dd>{v}</dd></div>))}
        </dl>
      </div>
      <div class="h-sd-vlak h-in" style="--d:1">
        <div class="h-sd-fig"><FigGallery lang={lang} uitleg /></div>
      </div>
    </div>
  </section>

  {/* ── 4 · DE MAP: één foto, de boom als glas erover ──────────────────────── */}
  <section class="h-sec h-sd-dl-sec" aria-labelledby="sd-dl">
    <header class="h-sec-kop h-in">
      <div>
        <p class="h-pil"><span>{H.dlPil}</span></p>
        <h2 id="sd-dl" class="h-kop h-h2"><span class="l">{H.dlKop[0]}</span> {H.dlKop[1]}</h2>
      </div>
    </header>
    <div class="h-sd-dl">
      <figure class="h-sd-map h-in">
        <img src={MAPFOTO.src} width={MAPFOTO.w} height={MAPFOTO.h} alt="" loading="lazy" decoding="async" />
        {/* het onzichtbare label, zichtbaar gemaakt: hetzelfde etiket als op de voorpagina */}
        <span class="h-label h-sd-map-label" aria-hidden="true">
          <span class="h-label-kop"><i>IPTC</i>Digital Source Type</span>
          <span class="h-label-waarde">{IPTC_WAARDE}</span>
          <span class="h-label-zegt"><span set:html={ik('check')} />{IPTC_WOORD}</span>
        </span>
        <div class="h-sd-boom">
          <span class="h-sd-boom-map"><span set:html={ik('map')} />{productMap}/</span>
          <span class="h-sd-boom-lijst">
            {bestanden.map(([fmt, bestand]) => <span class="h-sd-boom-r"><b>{fmt}/</b>{bestand}{fmt !== 'JPG' && <em class="h-sd-boom-extra"> · {opAanvraag}</em>}</span>)}
          </span>
        </div>
      </figure>
      <div class="h-sd-dl-tekst h-in" style="--d:1">
        <p class="h-sd-zin-groot">{c.dlLede}</p>
        <ul class="h-sd-formaten" role="list">
          {c.dl.map(([k, v]) => (<li><span class="h-sd-fmt">{k}</span><span class="h-sd-zin">{v}</span></li>))}
        </ul>
        <p class="h-sd-manifest"><span class="h-sd-manifest-i" aria-hidden="true" set:html={ik('label')} /><span class="h-sd-zin">{c.dlManifest} <Note lang={lang} term={c.dlManifestNoteTerm}>{c.dlManifestNote}</Note></span></p>
      </div>
    </div>
  </section>

  {/* ── 5 · HET LOGBOEK ─────────────────────────────────────────────────── */}
  <section class="h-sec h-sd-log-sec" aria-labelledby="sd-log">
    <div class="h-sd-log h-in">
      <div class="h-sd-log-tekst">
        <p class="h-pil h-pil-wit"><span>{H.logPil}</span></p>
        <h2 id="sd-log" class="h-kop h-h3"><span class="l">{H.logKop[0]}</span> {H.logKop[1]}</h2>
        <p class="h-sd-zin">{c.logLede}</p>
        <p class="h-acties"><a class="h-knop h-knop-lijn h-knop-klein" href={lp('/ai-act')}>{c.logCta}</a></p>
      </div>
      <div class="h-sd-logboek" aria-hidden="true">
        <span class="h-sd-logboek-kop"><b>{DEMO_ORDER.ref}</b><span>{naLevering}</span><i>{H.logBadge}</i></span>
        <span class="h-sd-logboek-lijst">
          {H.log.map(([tijd, beeld, wat, zei]) => (
            <span class={`h-sd-logboek-r${zei ? ' is-terug' : ''}`}>
              <span class="h-sd-logboek-t">{tijd}</span>
              <span class="h-sd-logboek-i" set:html={ik(zei ? 'revisie' : 'check')} />
              <span class="h-sd-logboek-w"><b>{wat}</b><span>{beeld}</span>{zei && <em>{zei}</em>}</span>
            </span>
          ))}
        </span>
      </div>
    </div>
  </section>

  {/* ── 6 · DE SLEUTEL: de link is de sleutel, dus hij is er als een gebouwd ── */}
  <section class="h-sec h-sd-sec-sec" id="sleutel" aria-labelledby="sd-sec">
    <header class="h-sec-kop h-in">
      <div>
        <p class="h-pil"><span>{H.secPil}</span></p>
        <h2 id="sd-sec" class="h-kop h-h2"><span class="l">{H.secKop[0]}</span> {H.secKop[1]}</h2>
      </div>
      <p class="h-pr-kopzin">{c.secLede}</p>
    </header>
    <ul class="h-sd-sleutel" role="list">
      {c.sec.map(([k, v], i) => (
        <li class={`h-in h-sd-sl${i === 0 ? ' h-groot h-sd-sl-groot' : ''}`} style={`--d:${i}`}>
          <span class="h-cirkel h-cirkel-wit" aria-hidden="true" set:html={ik(SLEUTEL_IKOON[i])} />
          <span class="h-sd-sl-onder">
            {i === 0 && <span class="h-sd-sl-getal"><span class="h-getal">256</span><span class="h-sd-eenheid">{H.bits}</span></span>}
            {i === c.sec.length - 1 && <span class="h-sd-sl-getal"><span class="h-getal">{PORTAL_TTL_DAYS}</span><span class="h-sd-eenheid">{H.dagen}</span></span>}
            <b>{k}</b>
            <span class="h-sd-zin">{v}</span>
          </span>
        </li>
      ))}
      <li class="h-in h-sd-sl h-sd-sl-noot" style={`--d:${c.sec.length}`}>
        <span class="h-cirkel h-cirkel-wit" aria-hidden="true" set:html={ik('sleutel')} />
        <span class="h-sd-zin">{c.secNote}</span>
      </li>
    </ul>
  </section>

  {/* ── 7 · HET SLOT: de proef ───────────────────────────────────────────── */}
  <HalProef lang={lang} id="sd-slot" kop={H.proefKop} zin={c.closeLede} alt={{ label: c.closeAlt, href: '/start' }} />
</div>
<HalBeweging />
