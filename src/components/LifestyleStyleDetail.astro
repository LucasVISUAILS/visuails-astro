---
/*
 * VISUAILS — de detailpagina van een lifestylestijl, gedeeld door
 * /lifestyle/[slug] en /nl/lifestyle/[slug].
 *
 * ── KORT EN BEELDVULLEND SINDS 11 OKTOBER 2026 (k101 = a) ─────────────────
 *
 * De pagina zelf is LookDetailHal.astro: grote foto's, drie korte koppen (voor
 * welke kleding, welk gevoel, welke kanalen) uit `kort` in de lookdata, en
 * onderaan "Kies deze look" en "Probeer VISUAILS · €1". Hier staat alleen wat
 * bij lifestyle hoort: de beelden van deze look (alleen echte, isEcht), de
 * feitenregel, en de lange uitleg die ingeklapt onder "Meer over …" staat
 * (de sfeer, de stappen, wat je krijgt, het model).
 *
 * Titel, meta, canonical en JSON-LD staan in de route (src/pages/…/[slug].astro)
 * en in Layout; daar is niets aan veranderd.
 *
 * ── DE DOORLOOPTIJD IS EEN TIER-FEIT ─────────────────────────────────────
 *
 * Levertijd, controleniveau en wachtrijgedrag komen uit pricing.js en niet uit
 * de stijl — zo kan een capaciteitswijziging geen belofte laten stranden op een
 * detailpagina. En een look OP AANVRAAG heeft eerst een ONTWERP; daar geldt de
 * gewone doorlooptijd pas ná.
 */
/* Sinds 12 oktober 2026 (afvinklijst 8) in het sjabloon van de hal; het vorige
   sjabloon (LookDetail.astro) staat op _opruimen/LIJST.txt. hub = waar de pil terug
   naartoe wijst (standaard de eigen dienst). */
import LookDetailHal from './LookDetailHal.astro';
import { ikoon, IKOON } from '../data/iconen.js';
import { reviewClaim, turnaround, TIERS, TEST_SAMPLE } from '../data/pricing.js';
import { localizedPath } from '../i18n/ui.js';
import { isEcht } from '../lib/beeldAanwezig.js';

interface Props { lang: 'en' | 'nl'; style: any; zusters: { href: string; naam: string }[]; priceLine: string; hub?: string; }
const { lang, style, zusters, priceLine, hub } = Astro.props;
const nl = lang === 'nl';
const lp = (p: string) => localizedPath(lang, p);
/* ── DE PROEF BEGINT BIJ DEZE LOOK — 8 oktober 2026 (1.06) ─────────────────
   /test-sample?style=<look> slaat de eerste vraag van de proef over en vinkt de
   look aan. Niet bij de look op maat: dat is een aanvraag en geen look om te
   proberen. De knoptekst komt uit TEST_SAMPLE ("Probeer VISUAILS · €1"). */
const proefHref = style.slug === 'custom' ? lp('/test-sample') : `${lp('/test-sample')}?style=${encodeURIComponent(style.slug)}`;

const TIMING = style.slug === 'custom'
  ? (nl ? 'Eerst het ontwerp, daarna de gewone doorlooptijd per bestelling.' : 'Design first, then the ordinary turnaround per order.')
  : turnaround('unattended', lang);
const REVIEW = reviewClaim('unattended', lang);
const QUEUE = style.slug === 'custom' ? '' : TIERS.unattended.queue[lang];

/* De beelden: eerst de hero, dan het raster, elk één keer en alleen als het
   echt bestaat (geen plaatshouder, geen getekend vak). */
const alt = nl ? `Voorbeeld in de ${style.name}-stijl` : `${style.name}-style example`;
const bronnen = [style.heroPhoto, ...(style.grid || []).map((g: any) => g.photo)].filter(Boolean);
const beelden = [...new Set(bronnen)].filter((src) => isEcht(src)).map((src, i) => ({
  src,
  alt: i === 0 ? (nl ? `De ${style.name}-stijl van VISUAILS` : `The VISUAILS ${style.name} style`) : alt,
}));

const c = nl ? {
  kies: style.orderLabel ?? 'Kies deze look',
  voeltH: `Hoe ${style.name} voelt`,
  stapH: `Hoe ${style.name} tot stand komt`,
  idealH: 'Ideaal voor',
  krijgH: 'Wat je krijgt',
  modelNoot: ['Het model in een ', '-scène: een standaardgezicht, of ', 'je eigen merkmodel', '.'],
} : {
  kies: style.orderLabel ?? 'Choose this look',
  voeltH: `How ${style.name} feels`,
  stapH: `How ${style.name} comes together`,
  idealH: 'Best for',
  krijgH: 'What you get',
  modelNoot: ['The model in a ', ' scene: a standard face, or ', 'your own Brand Model', '.'],
};
/* het vinkje uit het kit (levering 54) */
---

<LookDetailHal
  hub={hub}
  lang={lang}
  dienst="lifestyle"
  style={style}
  zusters={zusters}
  feiten={[priceLine, TIMING, REVIEW]}
  queue={QUEUE}
  beelden={beelden}
  kies={{ href: style.orderHref ?? lp('/start'), label: c.kies }}
  proef={{ href: proefHref, label: TEST_SAMPLE[lang].cta }}
>
  <Fragment slot="meer">
    <div class="lm">
      <h3 class="hoog hoog-3">{c.voeltH}</h3>
      {style.moodParagraphs.map((p: string) => <p class="lopend">{p}</p>)}
      <h3 class="hoog hoog-3">{c.idealH}</h3>
      <ul class="lm-vinkjes" role="list">
        {style.bestFor.map((item: string) => (
          <li><svg viewBox="0 0 24 24" class="ik lm-i" aria-hidden="true" focusable="false"><path fill-rule="evenodd" d={IKOON.vink} /></svg><span>{item}</span></li>
        ))}
      </ul>
      <h3 class="hoog hoog-3">{c.stapH}</h3>
      <ol class="lm-stappen" role="list">
        {style.steps.map((s: any, i: number) => (
          <li><span class="mono lm-nr">{String(i + 1).padStart(2, '0')}</span> <b>{s.title}</b> <span>{s.body}</span></li>
        ))}
      </ol>
      <h3 class="hoog hoog-3">{c.krijgH}</h3>
      <ul class="lm-vinkjes" role="list">
        {style.whatYouGet.map((item: string) => (
          <li><svg viewBox="0 0 24 24" class="ik lm-i" aria-hidden="true" focusable="false"><path fill-rule="evenodd" d={IKOON.vink} /></svg><span>{item}</span></li>
        ))}
      </ul>
      <p class="lm-noot">
        {c.modelNoot[0]}{style.name}{c.modelNoot[1]}<a href={lp('/custom-models')}>{c.modelNoot[2]}</a>{c.modelNoot[3]}
      </p>
    </div>
  </Fragment>
</LookDetailHal>
