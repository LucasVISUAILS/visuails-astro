const f = FORM[lang];

// "1 product" / "2 products". renderSummary() reads the chosen option's own
// text back, so this label is what a client sees on the confirm screen too.
const countLabel = (n: number) => `${n} ${n === 1 ? 'product' : lang === 'nl' ? 'producten' : 'products'}`;

// ── The two service levels ─────────────────────────────────────────────────
// NOT a question any more. Under the package model these were two radio
// buttons and the buyer picked one; under the ladder the level FOLLOWS the
// count (tierFor(), WINDOW_THRESHOLD), so this block is a statement of what
// the current count earns rather than a control. pipeline.js puts .is-current
// on one of the two columns and updates it as the count changes.
//
// Content differs; visual weight does not. Section 13: "Do not use words like
// 'basic,' 'lite,' or 'starter' for Tier 0, and never style it as a lesser
// card. It is a different SERVICE MODEL, not a worse product." Equal columns
// are what holds that up now that the reader is not choosing between them —
// a narrower or lighter queue column would read as a penalty for ordering
// nine products instead of ten.
//
// The row set is TIER_ROWS, the same five facts in the same order that
// /pricing's Tier 0 block and the TierCompare section on /catalog, /lifestyle
// and /video print. It was four rows hand-listed here, with the labels typed
// beside them, and the Dutch list read ['Timing', 'Wachtrij', 'Levering', 'Na
// levering'] — the first label still in English on a live Dutch page. That
// exact list had been copied to /pricing, which is how one typo became two.
//
// Review is the row that reads the SAME in both columns. That is not padding:
// "human-checked, every visual" appearing identically on both sides is what
// says the cheaper count is not the unchecked one. Section 13: "Keep that
// promise across BOTH tiers for now."
const rowLabels = tierRowLabels(lang);
const levels = [
  {
    tier: 'unattended',
    heading: f.s1.levelUnattended[0],
    band: f.s1.levelUnattended[1],
    values: TIER_ROWS.map((r) => tierRow('unattended', r.key, lang)),
  },
  {
    tier: 'attended',
    heading: f.s1.levelAttended[0],
    band: f.s1.levelAttended[1],
    values: TIER_ROWS.map((r) => tierRow('attended', r.key, lang)),
  },
];

// ── The config blob ────────────────────────────────────────────────────────
// Every number the script needs, from the module that owns it. The caps come
// from src/lib/uploads.js and pipeline.js's preflight() checks a file against
// all three of them before it opens the XHR, so the browser refuses exactly
// what /api/upload refuses. The LADDER comes from pricing.js, whole, so the
// running total and the invoice cannot disagree — and so that no euro figure
// is written down in a file that runs in a browser. Nothing here is typed
// twice, and nothing here is authoritative: the server re-derives every price.
const config = {
  lang,
  // The rungs themselves, not a flattened per-kind rate: the whole point of
  // the ladder is that the rate is a function of the count, and a script that
  // was handed one number could only ever price one rung.
  ladder: LADDER,
  vatRate: VAT_RATE,
  // From this count up an order is put in the capacity calendar. tierFor()'s
  // threshold, so the page and pricing.js cannot disagree about where the line
  // is — the script re-implements the comparison, never the number.
  windowThreshold: WINDOW_THRESHOLD,
  // What one reserved window holds, and therefore the largest count this form
  // is willing to price. Above it the gate's own 'too-large' answer applies.
  maxProducts: ATTENDED_PER_WINDOW,
  maxFileBytes: MAX_FILE_BYTES,
  maxBatchFiles: MAX_BATCH_FILES,
  // The extension table's own keys — the list /api/upload matches on, not a
  // second list of image formats written out by hand. accept="image/*" on the
  // input is a hint to the file picker; this is the rule.
  uploadExt: Object.keys(UPLOAD_TYPES),
  // Task #271f.
  outfitSurcharge: OUTFIT_SURCHARGE,
  maxOutfit: MAX_OUTFIT_PRODUCTS,
  copy: PIPE[lang],
};
// JSON inside a <script> element ends at the first literal "</script>", and a
// stray "<" is the only character that can start one. Escaping it is what makes
// this blob safe to write with set:html.
const configJson = JSON.stringify(config).replace(/</g, '\\u003c');

// The count select. One option per count, all the way up, because under the
// ladder the count IS the price — a select that offered 25 and 30 but not 27
// would quote a brand with 27 products for something they did not order.
//
// It stops at what a single reserved window holds (capacity.js), and the
// catch-all past it is deliberately NOT parseable as an integer: countOf() in
// /api/order would read "30+" as thirty and record a number nobody chose. That
// last option is the conversation, and the gate has a panel for it.
const counts = Array.from({ length: ATTENDED_PER_WINDOW }, (_, i) => i + 1);

// Task #271f — 0 (the default, "single product") through MAX_OUTFIT_PRODUCTS.
// syncOutfit() in pipeline.js hides options past whatever the current products
// count allows, so the form can never submit an outfit count larger than the
// order itself.
const outfitCounts = Array.from({ length: MAX_OUTFIT_PRODUCTS + 1 }, (_, i) => i);
---

<!-- HERO -->
<section class="page-hero"><div class="container">
  <span class="eyebrow-page">{c.eyebrow}</span>
  <h1 class="display">{c.h1}</h1>
  <p class="lead" style="margin-top:1.2rem">{c.lead}</p>
</div></section>

<!-- THE PIPELINE -->
<section class="section-tight"><div class="container">
  <form
    id="pl-form"
    class="pl-form"
    data-pipeline
    method="post"
    action="/api/order"
    enctype="multipart/form-data"
  >
    <script type="application/json" data-pipeline-config is:inline set:html={configJson}></script>

    {/* `service` IS the step 1 radio group now — see f.s1.kindOptions and the
        note there. It is deliberately not a hidden input any more: as one it
        sat on a safe default that no-JS orders never left, so an order for a
        whole collection arrived labelled `catalog`. A field the visitor
        actually answers cannot be stale.

        `tier` stays hidden and stays written by the script, because it is
        derived (tierFor(count)) rather than answered. Its default is the tier
        that reserves nothing: a no-JS order arrives in the queue and the
        window is agreed by email, which is what the <noscript> promises. */}
    <input type="hidden" name="tier" value="unattended" />
    <input type="hidden" name="redirect" value={lp('/thank-you')} />
    <input type="hidden" name="lang" value={lang} />
    <input type="hidden" name="window_start" value="" />
    <input type="hidden" name="window_end" value="" />
    <input type="hidden" name="upload_batch" value="" />
    <input type="hidden" name="source" value="start-pipeline" />
    <input type="text" name="company_hp" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0" />

    {/* Backwards only — see bindNav() in pipeline.js. Buttons rather than bare
        list items so the rail is reachable from the keyboard at all. */}
    <ol class="pl-rail" aria-label={f.railLabel}>
      {f.rail.map((t, i) => (
        <li>
          <button type="button" class="pl-rail-item" data-pl-rail-item={String(i + 1)}>
            <span class="pl-rail-n">{String(i + 1).padStart(2, '0')}</span>
            <span class="pl-rail-t">{t}</span>
          </button>
        </li>
      ))}
    </ol>

    <noscript><p class="pl-noscript">{f.noscript}</p></noscript>

    {/* aria-hidden is deliberately absent from every step's markup. show() owns
        it and sets all five on init; writing aria-hidden="true" here would hide
        four fifths of the form from a screen reader on the no-JS path, where
        all five steps are the page. */}
    <!-- STEP 1 · THE ORDER -->
    <section class="pl-step" data-pl-step="1">
      <h2 class="pl-h" data-pl-head>{f.s1.h}</h2>
      <p class="pl-lead">{f.s1.lead}</p>

      {/* ONE question, three answers. It used to be two questions — a scope
          door, then a package or a product kind inside it — and the second one
          only existed because the price list had two shapes. The ladder has
          one shape, so this has one question, and the answer is the ladder's
          own kind.

          Nothing here is hidden and nothing is toggled: with JavaScript off
          this is a plain radio group with a default already checked, so the
          form posts a coherent order. The sub-panels that used to be visible
          for exactly that reason are gone with the door they belonged to. */}
      <fieldset class="pl-fieldset">
        <legend class="pl-sr">{f.s1.legend}</legend>
        <h3 class="pl-sub-h">{f.s1.kindH}</h3>
        <div class="opt-stack">
          {/* data-pl-req is not decoration: syncRequired() rewrites .required
              on every field from this attribute alone, so a control that
              carries `required` without it goes optional the moment the script
              initialises. One radio marked required makes the whole group
              required natively, which is why only the first has it.

              data-pl-kind is the ladder kind; the value is what the server
              stores. pipeline.js prices from the former and never parses the
              latter — see kindOf() there. */}
          {f.s1.kindOptions.map(([v, kind, title, desc], i) => (
            <label class="opt">
              <input
                type="radio"
                name="service"
                value={v}
                data-pl-kind={kind}
                checked={i === 0}
                required={i === 0}
                data-pl-req={i === 0 ? '1' : undefined}
              />
              <span class="opt-main">
                <span class="opt-title">{title}</span>
                <span class="opt-desc">{desc}</span>
              </span>
            </label>
          ))}
        </div>
        <p class="pl-panel-note" set:html={f.s1.kindLink} />
        <p class="pl-panel-note" set:html={f.s1.brandModel} />
        <p class="pl-panel-note">{f.s1.videoNote}</p>
      </fieldset>

      {/* One select, one name. Every option is a real count and the last one
          deliberately is not — see the `counts` note in the frontmatter. */}
      <div class="field">
        <label for="pl-products">{f.s1.countLabel} <span class="req">*</span></label>
        <select id="pl-products" class="select" name="products" required data-pl-req="1">
          {counts.map((n) => <option value={String(n)}>{countLabel(n)}</option>)}
          <option value={f.s1.more}>{f.s1.more}</option>
        </select>
        <span class="hint">{f.s1.countHint}</span>
      </div>

      {/* Task #271f — Single Product/Full outfit. One select, every kind on the
          ladder has a rate to surcharge. syncOutfit() in pipeline.js narrows
          the option list to what the current product count allows. Not
          [data-pl-req]: 0 ("single product") is always a valid answer, so this
          field is never required. */}
      <div class="field" data-pl-outfit>
        <label for="pl-outfit">{f.s1.outfitLabel}</label>
        <select id="pl-outfit" class="select" name="outfit_count">
          <option value="0">{f.s1.outfitNone}</option>
          {outfitCounts.slice(1).map((n) => <option value={String(n)}>{f.s1.outfitCount(n)}</option>)}
        </select>
        <span class="hint">{f.s1.outfitHint}</span>
      </div>

      {/* THREE LINES, NEVER ONE. A bare total cannot say which side of VAT it
          is on, and BRIEF-14's hardest rule is that no price is printed without
          saying so. [data-pl-total] stays on the gross figure because that is
          the number a client reads as "the total" — the net and the VAT line
          are what make it readable.

          None of it is authoritative. It is a preview computed in the browser
          from the ladder in the config blob; the invoice is derived again
          server-side, and nothing this form posts carries an amount at all. */}
      <div class="pl-total">
        <span class="pl-total-label">{f.s1.totalLabel}</span>
        <dl class="pl-total-lines">
          <div class="pl-total-row">
            <dt>{f.s1.netLabel}</dt>
            <dd data-pl-total-net></dd>
          </div>
          <div class="pl-total-row">
            <dt>{f.s1.vatRowLabel}</dt>
            <dd data-pl-total-vat></dd>
          </div>
          <div class="pl-total-row is-gross">
            <dt>{f.s1.grossLabel}</dt>
            <dd data-pl-total></dd>
          </div>
        </dl>
        <p class="pl-total-note" data-pl-total-note></p>
        {/* The ladder's own upsell, written by syncTotal() from two computed
            totals. Hidden until there is a rung within reach. */}
        <p class="pl-total-rung" data-pl-rung hidden></p>
        <p class="pl-total-first">{f.s1.firstOrder}</p>
        <p class="pl-total-display">{f.s1.displayNote}</p>
      </div>

      {/* What the count earns. Not a control — see the `levels` note in the
          frontmatter. pipeline.js marks one column and writes the line under
          it; without JS both columns stand as a plain statement of the two
          service models, which is what section 13 asks the page to make
          visible either way. */}
      <div class="pl-levels">
        <h3 class="pl-sub-h">{f.s1.levelsH}</h3>
        <div class="levels">
          {levels.map((d) => (
