    footBody: `${sample.line} One product, ${sample.price}, ${sample.unit}. It runs through the same pipeline as a paid order, so what you see is what you would get.`,
    footCta: `Try a test sample · ${sample.price}`,
    footWa: 'Ask on WhatsApp',
  },
  nl: {
    eyebrow: 'Start',
    h1: 'Wat we maken, en hoeveel.',
    lead: `Eén tarief per product, en dat daalt naarmate het aantal stijgt — van ${euro(ladderRate('complete', 1), 'nl')} naar ${euro(ladderFloor('complete'), 'nl')} per product. Vanaf ${WINDOW_THRESHOLD} producten gaat de bestelling in de studioagenda met een gereserveerd venster; daaronder loopt ze mee in de standaard wachtrij.`,
    gateLead: 'Er wordt geen datum genoemd voordat de agenda die heeft vrijgegeven.',
    gateBody: `Vanaf ${WINDOW_THRESHOLD} producten komt een bestelling in de capaciteitsagenda en krijgt ze een gereserveerd venster, schriftelijk bevestigd voordat je betaalt en nooit erna. Een kleinere bestelling loopt mee in de standaard wachtrij, zonder datum eraan. Geen van beide is een optimistische gok.`,
    sharedH: 'Wat bij elk aantal hetzelfde is',
    shared: [
      ['De pipeline', `Dezelfde productie bij één product en bij ${ATTENDED_PER_WINDOW}. Er is geen tweederangs baan.`],
      ['De controle', `${reviewClaim('unattended', 'nl')}. Bij elk aantal, zonder uitzondering.`],
      ['De bestanden', 'Hoge resolutie en e-commerce-klaar. Van jou, overal te gebruiken, zonder licentie per gebruik.'],
    ],
    // An invitation, not a claim about state: this block also sits under a
    // step 5 whose summary already reads a finished order back.
    footH: 'Nog niet klaar om te bestellen?',
    footBody: `${sample.line} Eén product, ${sample.price}, ${sample.unit}. Het loopt door dezelfde pipeline als een betaalde bestelling, dus wat je ziet is wat je zou krijgen.`,
    footCta: `Probeer een proefvisual · ${sample.price}`,
    footWa: 'Vraag het via WhatsApp',
  },
};

const c = COPY[lang];

// ── The copy pipeline.js reads ─────────────────────────────────────────────
// This tree is serialised into the config blob below and reached by dotted
// path from the script — c('upload.err.too-large', { max }) and so on. The
// keys are a contract with src/scripts/pipeline.js; a missing one renders as
// an empty string rather than throwing, which is exactly why they are listed
// here in full instead of being added ad hoc.
//
// Two of them are deliberately NOT written here: `sum.queue` is
// unattended.queue[lang] verbatim, because section 13's "no fixed delivery
// date" line must have exactly one home, and that home is pricing.js.
const PIPE = {
  en: {
    total: {
      // The rate is the LADDER's rate at this count, never a package price:
      // change the count and this line has to change with it.
      each: `{rate} per product × {n}, ${vatLabel('excl', 'en')}.`,
      more: 'That is more than one reserved window holds, so it is planned with you rather than priced by a form. Send this and we come back with the same ladder in writing.',
