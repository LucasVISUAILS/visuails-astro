/* ── HET AANTAL DEUREN STOND IN DE ZIN — 10 september 2026 ─────────────────
   Er stond "Negen deuren, geen rangorde", en toen de negende weg ging (zie de
   noot bij `complete` hierboven) stond er een getal in de lead dat niet meer
   klopte met de lijst eronder. Dat is precies het soort fout dat niemand ziet
   bij het schrijven en iedereen ziet bij het tellen.

   Het getal komt daarom uit de lijst. In woorden en niet in cijfers, want dit
   is een zin en geen specificatie — en het telwoord komt uit een lijstje van
   tien, met het cijfer als terugval zodra er meer dan tien deuren zijn. Dan
   staat er "11 deuren" in plaats van niets. */
const TELWOORD = {
  en: ['zero', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine', 'ten'],
  nl: ['nul', 'één', 'twee', 'drie', 'vier', 'vijf', 'zes', 'zeven', 'acht', 'negen', 'tien'],
};
const telwoord = (n, taal) => TELWOORD[taal][n] || String(n);

const c = { ...COPY[lang] };
c.lead = c.lead.replace(/\{n\}/g, telwoord(c.deuren.length, lang));
/* Het telwoord staat vooraan de zin, dus daar hoort een hoofdletter. Hier en
   niet in de lijst: "acht" midden in een zin krijgt er geen. */
c.lead = c.lead.charAt(0).toUpperCase() + c.lead.slice(1);

/* ── HOEVEEL DEUREN ER ACHTER ELK FILTER ZITTEN ────────────────────────────
   Geteld uit `deuren` en niet ergens genoteerd: een filter dat "3" belooft en
   er twee toont, is erger dan een filter zonder getal. `doel` draagt één of
   twee woorden — werk op maat staat onder foto's én sfeer — dus splitsen en
   niet vergelijken. */
const telPerTak = Object.fromEntries(c.takken.map((t) => [
  t.id,
  t.id === 'alles' ? c.deuren.length : c.deuren.filter((d) => String(d.doel).split(/\s+/).includes(t.id)).length,
]));
const nl = lang === 'nl';
---

<div class="s22">

  {/* ── 1 · DE TRECHTER: EERST DE TAK, DAN DE CATEGORIE ─────────────────────

      Lucas: *"ik wil de trechter laten beginnen bij mensen te laten kiezen
      tussen afbeeldingen of video, en daarin dan de categorieën plaatsen (…)
      om het rustiger te maken."*

      Acht deuren tegelijk is te veel om te lezen; vier of drie is te doen. En
      de eerste vraag is er een die iedereen meteen kan beantwoorden — stil of
      bewegend — terwijl "catalog of lifestyle" pas te beantwoorden is als je
      weet wat die woorden hier betekenen.

      GEEN JAVASCRIPT. Twee radioknoppen die visueel verborgen zijn, met labels
      erop die eruitzien als knoppen; de zusterselector eronder laat de
      bijbehorende rij zien. Dat werkt met de toetsen (pijltjes wisselen van
      radio, zoals in elke radiogroep), het werkt zonder script, en beide rijen
      staan in de HTML — dus een zoekmachine ziet alle acht deuren en een
      bezoeker die de pagina zonder CSS krijgt ook.

      De radio's staan vóór de fieldset omdat een zusterselector alleen vooruit
      kijkt. Zelfde constructie als de dienstenkiezer op de voorpagina. */}
  <section class="paneel st-kies" aria-labelledby="st-h1">
    <header class="paneel-kop st-kop">
      <p class="etiket">{c.eyebrow}</p>
      <h1 id="st-h1" class="hoog">{c.h1}</h1>
      <p class="lopend">{c.lead}</p>
    </header>

    {c.takken.map((t, i) => (
      <input class="visueel-verborgen keuze" type="radio" name="st-tak" id={`st-tak-${i}`} data-st-tak={t.id} checked={i === 0} />
    ))}
    <fieldset class="st-takrij">
      <legend class="visueel-verborgen">{c.takLabel}</legend>
  {c.takken.map((t, i) => (
        <label class="st-tak" for={`st-tak-${i}`}>
          {/* Het vierkantje is de radio die je niet ziet. Een vorm en niet
              alleen een kleur, zodat "welke staat aan" ook leesbaar is voor wie
              het geel niet als aan-stand leest. */}
          <span class="st-tak-vink" aria-hidden="true"></span>
          <span class="st-tak-naam">{t.naam}</span>
          {/* Het aantal komt uit de deuren zelf en is dus altijd waar. Het is
              ook het enige wat een filter je vóór het klikken kan vertellen:
              niet wat erin zit, maar hoeveel. Dat verving de uitlegregel die
              hier stond — zie de noot bij .st-takrij. */}
          <span class="st-tak-n">{telPerTak[t.id]}</span>
        </label>
      ))}
    </fieldset>

    {/* ── EEN LINK DIE AL EEN FILTER MEEBRENGT — 10 september 2026 ─────────
        Lucas: *"waarna de klant bij /start uitkomt gesorteerd op wat hij
        klikte."*

        Het filter zelf is CSS: vier radio's en een zusterselector, zonder
        script (zie de noot hierboven). Maar een RADIO AANZETTEN vanuit een URL
        kan CSS niet — `:target` mikt op een element, niet op een keuze. Dit is
        dus de enige plek op deze pagina waar wel een regel JavaScript staat,
        en hij doet precies één ding.

        Wat er gebeurt zonder script, of met een `zie` die nergens op slaat: de
        pagina staat op "alle diensten" en toont alles. Dat is de goede
        terugval — een bezoeker mist dan een voorselectie, geen inhoud. */}
    <script is:inline data-astro-rerun>
      (function () {
        try {
          var zie = new URLSearchParams(location.search).get('zie');
          if (!zie) return;
          var el = document.querySelector('input[data-st-tak="' + zie.replace(/[^a-z]/gi, '') + '"]');
          if (el) el.checked = true;
        } catch (e) { /* een oude browser houdt gewoon "alles" aan */ }
      })();
    </script>

    {/* ÉÉN LIJST VAN ACHT, en de tabs verbergen wat er niet bij hoort — geen
        aparte lijst per bestemming. Twee redenen, en de tweede is de
        belangrijkste:

          1. Een deur die op twee plekken thuishoort (werk op maat is zowel
             een foto- als een sfeervraag) staat dan maar één keer in de HTML.
          2. De standaardstand toont alle acht, dus wat een bezoeker zonder
             te klikken ziet, is het hele aanbod — en niet de helft die wij
             hebben uitgekozen.

        `data-doel` draagt één of twee woorden; de CSS hieronder verbergt op
        `:not([data-doel~="..."])`, en `~=` is precies de selector voor een
        woord uit een lijst. */}
    <ul class="st-deuren" role="list">
      {c.deuren.map((d) => (
          <li class={`st-deur${d.later ? ' is-later' : ''}${d.voorwaarde ? ' is-voorwaarde' : ''}`} data-doel={d.doel}>
            <span class="kaart st-beeld">
              {SHOT[d.id]
                ? <img src={SHOT[d.id].src} alt="" width={SHOT[d.id].w} height={SHOT[d.id].h} loading="lazy" decoding="async" />
                : <Placeholder
                    lang={lang}
                    ratio="4 / 3"
                    caption={false}
                    kind="video"
                    subject={`${d.name} — ${d.where}`}
                    message={nl
                      ? 'Eén beeld dat het tweebeeldsformaat van een Hook laat zien: de eerste seconde en de tweede naast elkaar, zodat je in één blik ziet dat het één clip is en geen twee. Zolang die er niet is, staat hier wat er is — een lege plek met de opdracht erin.'
                      : 'One frame showing a Hook’s two-shot format: the first second and the second beside each other, so you see at a glance that it is one clip and not two. Until that exists, what stands here is what there is — an empty slot with the brief in it.'}
                  />}
              {d.merk && <span class="mono st-merk">{d.merk}</span>}
            </span>
            <div class="st-tekst">
              <p class="st-kopregel">
                <span class="mono st-dienst">{d.name}</span>
                {/* Gevuld als het jouw product gebruikt, stil omlijnd als dat niet
                    hoeft. Twee VORMEN en niet twee kleuren: het verschil moet ook
                    te zien zijn voor wie het geel niet als "ja" leest. */}
                {/* Drie standen sinds 10 september: met, zonder, en allebei —
                    zie productStand() in eigenproduct.js. De klasse volgt de
                    stand, dus een deur die van stand verandert, verandert
                    vanzelf ook van vorm. */}
                <span class={`st-eigen is-${productStand(d.id)}`}>
                  {PRODUCT_COPY[lang][productStand(d.id)]}
                </span>
              </p>
              <h2 class="st-waar">{d.where}</h2>
              <p class="st-krijgt">{d.gets}</p>
              <p class="lopend st-regel">{d.line}</p>
              {/* Het bedrag draagt zijn eigen btw-label. BRIEF-14: het label
                  reist mee met het getal en staat niet alleen in de noot
                  eronder. Elke rij heeft dezelfde vorm — label, getal, eenheid
                  — zodat de bedragen van een groep op één lijn staan.

                  `from` staat er bij alles wat een ONDERGRENS is: de drie op de
                  ladder, en Hooks. Bij een vaste prijs (de productclip) en bij
                  een maandbedrag staat het er niet, want dan zou het liegen. */}
              <p class="st-tarief">
                {(d.kind || d.vanaf) && <span class="mono">{c.from}</span>}
                <span class="tarief">{d.fig || vanaf(d.kind)}</span>
                <span class="mono">{d.unit}</span>
              </p>
              <p class="st-wegen">
                <a class={`knop ${d.later ? 'knop-lijn' : 'knop-inkt'}`} href={lp(d.href)}>{d.cta}</a>
                <a class="pijl st-lees" href={lp(d.read)}>{d.readCta}</a>
              </p>
            </div>
          </li>
      ))}
    </ul>

    <div class="st-onder">
      <p class="lopend st-ladder">{c.ladderLine} <a class="st-link" href={lp('/pricing')}>{c.ladderCta}</a></p>
      <p class="st-btw">{vatLead(lang)} <Note lang={lang} term={vatLabel('excl', lang)} wide>{vatDetail(lang)}</Note></p>
    </div>
  </section>

  {/* ── 2 · HOE JE HET BETAALT ─────────────────────────────────────────────
      DIRECT ONDER DE DEUREN, en tot 8 september 2026 stond dit als paneel 5:
      ná "wat er daarna gebeurt" en ná "wat er meegaat". Dat is twee panelen
      verder dan waar de vraag thuishoort, want dit is een vraag OVER de deuren
      die er vlak boven staan — dezelfde beelden, een andere manier van betalen
      — en elk paneel ertussen is een plek om te stoppen met lezen. Zie
      kladblok/VOORSTEL-D4-ABONNEMENTEN.md §4B.

      HET BLIJFT EEN RIJ EN WORDT GEEN TEGEL. Punt 4 van de kop hierboven staat
      onverkort: een abonnement is geen vierde dienst. Alleen de VOLGORDE is
      veranderd, niet de vorm.

      DE PRIJSBEWERING IS ERUIT. payLine zei "kost minder dan datzelfde aantal
      producten los besteld", en dat is alleen waar tegenover een complete
      levering — een catalogbestelling van hetzelfde aantal is goedkoper dan
      elk abonnement (12 producten: € 612 los tegen € 790 Studio). De regel
      noemt nu wat een abonnement wél alleen heeft: de week in de planning, de
      Editions-beelden en het doorschuiven. De prijsvergelijking staat op de
      plek waar de twee echte getallen naast elkaar passen — het bestelformulier
      en /plans. */}
  <section class="paneel st-abo" aria-labelledby="st-betalen">
    <div class="st-rij">
      <div class="st-rij-tekst">
        <h2 id="st-betalen" class="hoog hoog-3">{c.payH}</h2>
        <p class="lopend">{c.payLine}</p>
      </div>
      <div class="st-rij-zij">
        <p class="st-mee-bedrag">
          <span class="mono">{c.from}</span>
          <span class="tarief st-groot">{planFrom.price}</span>
          <span class="mono">{planFrom.unit}, {vatLabel('excl', lang)}</span>
        </p>
        <p class="acties">
          <a class="knop knop-inkt" href={lp('/start/plan')}>{c.payCta}</a>
          <a class="knop knop-lijn" href={lp('/plans')}>{c.payCta2}</a>
        </p>
      </div>
    </div>
  </section>

  {/* ── 3 · WAT ER DAARNA GEBEURT ───────────────────────────────────────────
      De pagina die de bestelling begint, zei nergens wat drukken doet. De vijf
      stappen komen letterlijk uit de rail van OrderFlow.astro, zodat ze niet
      uiteen kunnen lopen met het formulier waar ze over gaan. */}
  <section class="kamer st-kamer" aria-labelledby="st-daarna">
    <header class="kamer-kop">
      <h2 id="st-daarna" class="hoog hoog-2">{c.afterH}</h2>
      <p class="lopend">{c.afterLead}</p>
    </header>

    <ol class="st-stappen">
      {c.steps.map((s, i) => (
        <li><span class="mono nr">{String(i + 1).padStart(2, '0')}</span><span class="st-stap-naam">{s}</span></li>
      ))}
    </ol>

    <ul class="st-feiten" role="list">
      {c.facts.map(([h, b]) => (
        <li><b>{h}</b><span class="lopend">{b}</span></li>
      ))}
    </ul>
  </section>

  {/* ── 4 · WAT ER MEEGAAT ──────────────────────────────────────────────────
      Het merkmodel en de look op maat. Allebei geen dienst maar een eigenschap
      van een bestelling — zie punt 4 van de kop. Ze staan hier ONDER de deuren
      en met een kop die zegt dat ze meegaan, zodat niemand ze leest als een
      vijfde en zesde keuze. */}
  <section class="paneel" aria-labelledby="st-mee">
    <header class="paneel-kop">
      <h2 id="st-mee" class="hoog hoog-2">{c.withH}</h2>
      <p class="lopend">{c.withLead}</p>
    </header>
    <ul class="st-mee" role="list">
      {c.withs.map((w) => (
        <li>
          <p class="mono st-mee-etiket">{w.name}</p>
          <h3 class="hoog hoog-3">{w.h}</h3>
          <p class="lopend">{w.body}</p>
          <p class="st-mee-bedrag">
            <span class="tarief">{w.fig}</span>
            <span class="mono">{w.unit}</span>
          </p>
          <p class="acties">
            <a class="knop knop-inkt" href={lp(w.href)}>{w.cta}</a>
            <a class="pijl" href={lp(w.href2)}>{w.cta2}</a>
          </p>
        </li>
      ))}
    </ul>
  </section>

  {/* ── 5 · NOG NIET ZEKER ──────────────────────────────────────────────── */}
  <section class="paneel paneel-slot" aria-labelledby="st-slot">
    <h2 id="st-slot" class="hoog">{c.footH}</h2>
    <p class="lopend">{c.footBody}</p>
    <p class="acties">
      <a class="knop knop-inkt" href={lp('/test-sample')}>{c.footCta}</a>
      <a class="knop knop-lijn" href={waHref(c.footWaText)} target="_blank" rel="noopener">{c.footWa}</a>
    </p>
  </section>
</div>

<style>
  .st-kop { max-width: 46rem; }

  /* ── DE EERSTE VRAAG: WAAR MOET HET BEELD TERECHT ─────────────────────────
     Vier knoppen, en de eerste ("alles") staat aan. Ze zijn kleiner dan de twee
     die hier stonden, en dat is met opzet: dit is nu een FILTER en niet de
     beslissing zelf. De beslissing staat eronder, in acht deuren die allemaal
     even zwaar zijn. De radio's zelf staan visueel verborgen boven de fieldset;
     het label is de knop. Zie de noot bij de markup voor waarom hier geen
     script bij hoort. */
  /* ═══════════════════════════════════════════════════════════════════════
     HET EERSTE SCHERM — 9 september 2026

     Lucas: *"Ik zou ook graag de What are we making? pagina wat overzichtelijker
     willen hebben, dus dat de eerste pagina bijna in 1 scherm past. Kijk hoe je
     dit mooi kan indelen."*

     GEMETEN VOORAF, op 1440 × 900 (kladblok/startmaat.mjs): de kop liep tot 410,
     de filterrij van 461 tot 610, en de eerste deur begon op 658. Van een kaart
     van 632 pixels stond er dus 242 in beeld — een derde beeld en verder niets.
     Je zag de vraag, je zag de knoppen, en je zag niet één antwoord.

     WAT ER MIS WAS, was niet dat het te veel was maar dat het onder elkaar stond.
     De kop is 46rem breed en het scherm is 1440: rechts van "What are we making?"
     stond een half scherm leeg, terwijl de filterrij daaronder de volle breedte
     nam voor vier woorden. Twee blokken van samen 455 pixels hoog, waarvan er één
     de halve breedte niet gebruikte.

     DUS STAAN ZE NU NAAST ELKAAR, vanaf 1024px: de vraag links, de vier filters
     als kolom rechts. Samen zo hoog als de hoogste van de twee in plaats van de
     som, en het gat rechts van de kop is precies waar ze staan.

     WAAROM DIT ZONDER EEN EXTRA <div> KAN. De vier radioknoppen moeten broer en
     zus blijven van zowel .st-takrij als .st-deuren — de hele filter is een
     zusterselector en die kijkt alleen vooruit binnen één ouder. Een omhullende
     div om kop en filters zou dat breken. Daarom wordt .st-kies zélf het raster:
     de radio's staan op `position: absolute` (zie .visueel-verborgen) en nemen
     dus geen enkele cel in, en de vier echte kinderen krijgen hun plek.

     ONDER 1024px verandert er niets aan de volgorde — kop, filters, deuren — maar
     staan de filters twee bij twee in plaats van vier onder elkaar. Op een
     telefoon scheelde dat 180 pixels.
     ═══════════════════════════════════════════════════════════════════════ */
  /* ══ HET FILTER IS EEN LIJST GEWORDEN — 10 september 2026 ═════════════════
     Lucas, met een schermafdruk van de vier knoppen: *"Deze knoppen mogen ook
     wel een ander design hebben en wat consistenter en moderner zijn."*

     Wat er stond waren vier vakken van twee bij twee, elk met een rand, een
     ronding, een naam in kopletter en een uitlegregel eronder. Drie dingen
     gingen daar mis, en de eerste is de reden dat het er rommelig uitzag:

     · TWEE VAN DE VIER NAMEN BRAKEN EN TWEE NIET. "Alle diensten" en "Lifestyle
       beelden" vielen over twee regels, "Productfoto's" en "Productvideo's"
       niet. Vier knoppen die hetzelfde zouden moeten wegen, met twee
       verschillende hoogtes tekst erin. Dat is niet op te lossen met kortere
       woorden — het zijn de woorden die Lucas wil — maar wel door ze niet meer
       in kopletter naast elkaar te zetten.

     · ZE ZAGEN ERUIT ALS DE DEUREN. Zelfde rand, zelfde ronding, zelfde maat
       als de kaarten eronder. Een filter dat eruitziet als inhoud laat een
       bezoeker eerst uitzoeken wat het IS voordat hij het kan gebruiken.

     · EN DE UITLEGREGEL WAS OVERBODIG GEWORDEN. Hij bestond omdat de oude namen
       abstract waren — "De pagina", "Het merk" — en dan moet erbij staan wat je
       daar vindt. Sinds vanmiddag heten ze "Productfoto's", "Lifestyle beelden"
       en "Productvideo's", en dan zegt de regel eronder hetzelfde nog een keer.

     WAT ERVOOR IN DE PLAATS KOMT: een lijst. Vier regels onder elkaar,
     haarlijnen ertussen, één regel per filter — dezelfde vorm als het
     contactblad op /per-product en als de tabel bij "wat verandert bij 10
     producten". Geen kaders, geen ronding, geen tweede lettergrootte.

     En er staat iets bij dat er eerst niet stond: HET AANTAL. Dat is het enige
     wat een filter je vóór het klikken kan vertellen — niet wat erin zit, dat
     zie je zo, maar hoeveel. Het wordt geteld uit de deuren zelf (zie
     `telPerTak`), dus het kan niet gaan afwijken van wat er verschijnt. */
  .st-takrij {
    display: grid; gap: 0; border: 0; padding: 0;
    margin: 0 0 clamp(1.6rem, 3vw, 2.2rem);
    border-top: 1px solid var(--lijn);
  }
  .st-tak {
    display: flex; align-items: center; gap: .7rem; cursor: pointer;
    padding: .8rem .2rem;
    border-bottom: 1px solid var(--lijn);
    color: var(--inkt-3);
    transition: color .25s var(--uit);
  }
  /* Het vierkantje is de radio. Vier pixels groter dan hij hoeft te zijn, want
     hij draagt in zijn eentje het antwoord op "welke staat aan". */
  .st-tak-vink {
    flex: 0 0 auto; width: 11px; height: 11px;
    border: 1px solid var(--lijn-sterk);
    transition: background .25s var(--uit), border-color .25s var(--uit);
  }
  /* De naam in de kopletter, maar op leesmaat en niet op kopmaat: hij staat op
     één regel, en dat is het hele punt. */
  .st-tak-naam {
    flex: 1 1 auto; min-width: 0;
    font-family: var(--kop2); font-weight: 500; font-stretch: 110%;
    font-size: .95rem; text-transform: uppercase; letter-spacing: -.005em;
    line-height: 1.2;
  }
  /* Het aantal in mono en met vaste cijferbreedte, zodat de vier getallen onder
     elkaar op één lijn staan in plaats van te dansen. */
  .st-tak-n {
    flex: 0 0 auto;
    font-family: var(--mono2); font-size: .75rem; font-stretch: 82%;
    font-variant-numeric: tabular-nums;
    color: var(--inkt-3);
  }
  .st-tak:hover { color: var(--inkt); }
  .st-tak:hover .st-tak-vink { border-color: var(--inkt); }

  @media (min-width: 1024px) {
    .st-kies {
      display: grid;
      grid-template-columns: minmax(0, 1fr) clamp(21rem, 30vw, 28rem);
      column-gap: clamp(2rem, 5vw, 4rem);
      align-items: start;
    }
    .st-kop { grid-column: 1; grid-row: 1; }
    /* Vier regels onder elkaar in deze kolom, en dat is nu juist de winst: als
       lijst is het filter ~180 pixels in plaats van de 242 die twee bij twee
       kostte, en er breekt geen naam meer. */
    .st-takrij { grid-column: 2; grid-row: 1; margin-bottom: 0; }
    /* De deuren en de voetregels pakken beide kolommen: het raster geldt voor de
       kop en het filter, niet voor de pagina eronder. */
    .st-deuren, .st-onder { grid-column: 1 / -1; }
    .st-deuren { margin-top: clamp(1.6rem, 2.6vw, 2.2rem); }
  }

  /* De gekozen regel. Eén selector per combinatie, want een zusterselector kan
     niet rekenen. Geen gevuld vlak meer over de hele regel: in een lijst van
     haarlijnen is een blok inkt een balk, en dan lees je de balk in plaats van
     de naam. De inkt gaat naar de LETTER en het accent naar het vierkantje —
     twee signalen, allebei klein. */
  .st-kies #st-tak-0:checked ~ .st-takrij label[for="st-tak-0"],
  .st-kies #st-tak-1:checked ~ .st-takrij label[for="st-tak-1"],
  .st-kies #st-tak-2:checked ~ .st-takrij label[for="st-tak-2"],
  .st-kies #st-tak-3:checked ~ .st-takrij label[for="st-tak-3"] { color: var(--inkt); }
  .st-kies #st-tak-0:checked ~ .st-takrij label[for="st-tak-0"] .st-tak-vink,
  .st-kies #st-tak-1:checked ~ .st-takrij label[for="st-tak-1"] .st-tak-vink,
  .st-kies #st-tak-2:checked ~ .st-takrij label[for="st-tak-2"] .st-tak-vink,
  .st-kies #st-tak-3:checked ~ .st-takrij label[for="st-tak-3"] .st-tak-vink {
    background: var(--accent); border-color: var(--accent);
  }
  .st-kies #st-tak-0:checked ~ .st-takrij label[for="st-tak-0"] .st-tak-n,
  .st-kies #st-tak-1:checked ~ .st-takrij label[for="st-tak-1"] .st-tak-n,
  .st-kies #st-tak-2:checked ~ .st-takrij label[for="st-tak-2"] .st-tak-n,
  .st-kies #st-tak-3:checked ~ .st-takrij label[for="st-tak-3"] .st-tak-n { color: var(--inkt-2); }

  /* ── HET FILTER VERBERGT, HET SORTEERT NIET ─────────────────────────────
     Bij `#st-tak-0` (alles) staat hier niets: dan geldt geen enkele regel en
     staan alle acht deuren er. Elke andere knop verbergt wat niet bij die
     bestemming hoort. `~=` en niet `=`, want Catalog + Lifestyle draagt er
     twee: `data-doel="pagina feed"`.

     `display: none` en geen `opacity`: een deur die er nog half staat, is nog
     steeds een deur waar je overheen moet lezen — en dat was precies het
     probleem met de gedimde kaarten op de voorpagina. */
  /* De drie woorden hier zijn de `id`s uit `takken` hierboven, op volgorde: de
     knop op plek 1 hoort bij foto, 2 bij sfeer, 3 bij video. Verandert die
     volgorde, dan verandert deze regel mee — er is geen andere koppeling dan
     de plek, want een CSS-zusterselector kan niet lezen wat er op de knop
     staat. Vandaar deze noot en niet alleen de selector. */
  .st-kies #st-tak-1:checked ~ .st-deuren .st-deur:not([data-doel~="foto"]),
  .st-kies #st-tak-2:checked ~ .st-deuren .st-deur:not([data-doel~="sfeer"]),
  .st-kies #st-tak-3:checked ~ .st-deuren .st-deur:not([data-doel~="video"]) { display: none; }
  /* De toetsenbordring hoort om de knop die je met de pijltjes verplaatst, en
     de radio zelf is onzichtbaar. */
  .st-kies .keuze:focus-visible ~ .st-takrij label { outline: 2px solid var(--inkt); outline-offset: 3px; }

  /* ═══════════════════════════════════════════════════════════════════════════
     DE VIER DEUREN — één rij, en dat is de hele herbouw.

     Ze zijn opzettelijk NIET gesorteerd naar of er een kassa achter zit. Video
     draagt hetzelfde kader, dezelfde foto en dezelfde letters als de andere
     drie; wat verschilt is dat er een statuswoord staat waar bij de andere een
     tarief staat, en dat de knop een lijnknop is in plaats van een inktknop.
     Dat is precies genoeg om te zeggen "hier gebeurt iets anders" en te weinig
     om te zeggen "dit doen we niet".
     ═══════════════════════════════════════════════════════════════════════════ */
  /* DRIE KOLOMMEN, en dat is geen willekeurig getal: er zijn negen deuren en
     drie bestemmingen, en ze staan in die volgorde. De standaardstand leest
     daardoor als drie rijen van drie — de productpagina, de feed, en wat om het
     merk heen zit — zonder dat er een kopje boven elke rij hoeft. Klik je een
     bestemming aan, dan blijft precies die rij over.

     Rij- en kolomafstand apart: gestapeld op een telefoon moet de ruimte TUSSEN
     twee blokken groter zijn dan die erbinnen, anders hoort een regel evenveel
     bij het blok eronder als bij het blok waar hij bij hoort. Zelfde reparatie
     als bij .kaarten in stijl22.css; gemeten met kladblok/witruimte.mjs. */
  .st-deuren { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); column-gap: clamp(.8rem, 1.8vw, 1.4rem); row-gap: clamp(2.2rem, 5.5vw, 2.8rem); }
  /* Flex en geen grid: de knop moet met `margin-top: auto` naar de onderrand
     zakken zodat de vier knoppen op één lijn staan, ook als de ene regel twee
     keer afbreekt en de andere niet. */
  .st-deur { display: flex; flex-direction: column; gap: .75rem; }
  /* 3:2 en niet 4:3. Op 1440 scheelt dat 35 pixels per kaart, en drie kaarten
     naast elkaar hebben die hoogte niet nodig: wat je van een deur moet zien is
     wát het is, niet de foto beeldvullend. */
  .st-beeld { position: relative; aspect-ratio: 3 / 2; flex: 0 0 auto; }
  .st-beeld img { width: 100%; height: 100%; object-fit: cover; transition: scale .6s var(--uit); }
  .st-beeld :global([data-placeholder]) { position: absolute; inset: 0; margin: 0; }
  .st-beeld :global([data-placeholder] > *) { width: 100%; height: 100%; border-radius: 0; }
  .st-deur:hover .st-beeld img { scale: 1.04; }
  /* ── HET ETIKET DRAAGT NOG MAAR ÉÉN DING — 9 september 2026 ──────────────
     Hier stond: geel is een AANBEVELING ("meest besteld"), wit is een STAAT
     ("hoort bij een abonnement"). De gele helft is weg met "meest besteld"
     zelf — een populariteitsbadge zegt de bezoeker welke deur de goede is, en
     dat is precies wat deze pagina sinds vandaag niet meer doet.

     Wat overblijft is de staat, en die is altijd wit: een feit over hoe je het
     bestelt, niet een oordeel over of je het zou moeten. */
  .st-merk { position: absolute; z-index: 1; top: .6rem; left: .6rem; background: var(--wit); color: var(--inkt); padding: .3rem .65rem; border-radius: 999px; }
  /* De videodeur: het beeld iets teruggenomen, want er zit nog geen kassa
     achter. Niet grijs — het werk bestaat wel. */
  .st-deur.is-later .st-beeld img { opacity: .72; }

  .st-tekst { display: flex; flex-direction: column; gap: .35rem; flex: 1; }
  .st-dienst { color: var(--inkt-2); }
  /* ── HET PRODUCT-ETIKET — 10 september 2026 ──────────────────────────────
     Op dezelfde regel als de dienstnaam, want het is een eigenschap van die
     dienst en geen tweede kop. `flex-wrap` omdat het in het Nederlands langer
     is dan in het Engels en op een smal scherm moet kunnen zakken. */
  .st-kopregel { display: flex; flex-wrap: wrap; align-items: center; gap: .45rem .6rem; margin: 0 0 .2rem; }
  .st-eigen {
    font-family: var(--mono, ui-monospace, monospace);
    font-size: .62rem; letter-spacing: .07em; text-transform: uppercase;
    padding: .12rem .45rem; white-space: nowrap;
    border: 1px solid var(--inkt);
  }
  .st-eigen.is-met { background: var(--accent); color: var(--inkt); }
  .st-eigen.is-zonder { border-color: var(--lijn-sterk); color: var(--inkt-3); }
  /* De derde stand ligt tussen de twee in, en de vorm zegt dat ook: de omlijning
     van "zonder" met de inkt van "met". Niet half-accent — een kleur op halve
     sterkte leest als uitgeschakeld, en dit is geen zwakkere belofte maar een
     andere. */
  .st-eigen.is-beide { border-color: var(--inkt); color: var(--inkt); }
  .st-waar { font-family: var(--kop2); font-weight: 500; font-stretch: 125%; font-size: clamp(1.1rem, 1.8vw, 1.4rem); text-transform: uppercase; letter-spacing: -.01em; line-height: 1.05; }
  .st-krijgt { font-size: .88rem; color: var(--inkt); }
  /* De beschrijving slikt de speling op, en niet de knop met `margin-top:auto`.
     Verschil: zo staan de VIER TARIEFREGELS ook op één lijn, en niet alleen de
     vier knoppen — en dat is de regel die je vergelijkt. */
  /* .6rem en niet niets: gemeten met kladblok/te-dicht.mjs stonden deze twee
     alinea's 6px uit elkaar en lazen ze als één blok grijs. Het zijn twee
     verschillende dingen — wat je krijgt, en waar het voor is. */
  .st-regel { font-size: .88rem; flex: 1; margin-top: .6rem; }
  /* `min-height` van twee regels, want "On request · no standard rate" past
     niet op één en elke andere deur wel. Zonder deze regel zakte de knop van die
     ene deur een regel lager dan de rest — en de vier knoppen op één lijn is
     precies wat een rij deuren vergelijkbaar maakt. */
  .st-tarief { display: flex; flex-wrap: wrap; align-items: baseline; align-content: flex-start; gap: .4rem .5rem; min-height: 3.4rem; margin-top: .5rem; padding-top: .8rem; border-top: 1px solid var(--lijn); }
  .st-tarief .mono { color: var(--inkt-2); }
  .st-wegen { display: flex; flex-wrap: wrap; align-items: center; gap: .6rem 1rem; margin-top: .6rem; }
  .st-lees { color: var(--inkt-2); }
  .st-lees:hover { color: var(--inkt); }

  .st-onder { display: grid; gap: .8rem; max-width: 62rem; margin-top: clamp(2rem, 4vw, 3rem); }
  .st-ladder { max-width: none; font-size: .92rem; }
  .st-link { color: var(--inkt); text-decoration: underline; text-underline-offset: 3px; text-decoration-color: var(--geel); text-decoration-thickness: 2px; }
  .st-btw { font-size: .84rem; line-height: 1.6; color: var(--inkt-2); }

  /* ── De vijf stappen, als een liniaal en niet als kaarten ─────────────────
     Ze zijn genummerd omdat het écht een volgorde is: dit is de volgorde waarin
     het formulier ze stelt. */
  .st-stappen { display: grid; grid-auto-flow: column; grid-auto-columns: 1fr; gap: clamp(.6rem, 2vw, 1.5rem); margin-bottom: clamp(2.5rem, 5vw, 4rem); }
  .st-stappen li { display: grid; gap: .4rem; padding-top: .9rem; border-top: 1px solid rgb(245 245 245 / .28); }
  .st-stappen .nr { color: rgb(245 245 245 / .5); }
  .st-stap-naam { font-family: var(--kop2); font-weight: 500; font-stretch: 125%; font-size: clamp(.95rem, 1.5vw, 1.25rem); text-transform: uppercase; letter-spacing: -.01em; }

  .st-feiten { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(1.4rem, 3.5vw, 3rem); }
  .st-feiten li { display: grid; gap: .5rem; align-content: start; padding-top: 1rem; border-top: 1px solid var(--geel); }
  .st-feiten b { font-family: var(--kop2); font-weight: 500; font-stretch: 125%; font-size: clamp(1.05rem, 1.6vw, 1.3rem); text-transform: uppercase; letter-spacing: -.01em; }
  .st-feiten .lopend { font-size: .92rem; }

  /* ── Wat er meegaat ──────────────────────────────────────────────────────
     Twee blokken naast elkaar, met een rand eromheen omdat het hier wél twee
     losse dingen zijn — anders dan de vier deuren, die één rij vormen. */
  .st-mee { display: grid; grid-template-columns: minmax(0, 46rem); gap: clamp(1rem, 2.5vw, 1.8rem); }
  .st-mee li { display: grid; gap: .7rem; align-content: start; padding: clamp(1.4rem, 3vw, 2.2rem); border: 1px solid var(--lijn); border-radius: calc(var(--ronding) - 8px); }
  .st-mee-etiket { color: var(--inkt-2); }
  .st-mee li .lopend { font-size: .92rem; }
  .st-mee-bedrag { display: flex; flex-wrap: wrap; align-items: baseline; gap: .5rem; margin-top: .3rem; }
  .st-mee-bedrag .mono { color: var(--inkt-2); }
  .st-mee .acties { margin-top: .5rem; }

  /* ── Het abonnement ──────────────────────────────────────────────────────
     Tekst links, het bedrag en de twee knoppen rechts. Eén beslissing met één
     getal, en dat getal hoort naast de knop die erop volgt. */
  .st-rij { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 22rem); gap: clamp(1.4rem, 4vw, 3.5rem); align-items: center; }
  .st-rij-tekst { display: grid; gap: .7rem; }
  .st-rij-zij { display: grid; gap: 1.2rem; justify-items: start; }
  .st-groot { font-size: clamp(1.8rem, 3.4vw, 2.6rem); line-height: 1; }

  @media (max-width: 1100px) {
    .st-deuren { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    /* `.st-takrij` stond hier op twee kolommen. Als lijst is één kolom de vorm
       op elk scherm: vier regels van 45 pixels, en geen naam die in een halve
       breedte alsnog breekt. Gemeten op 390 brak "Lifestyle beelden" in de
       tweekoloms-stand wél, en dan is de rij weer twee hoogtes hoog. */
  }
  @media (max-width: 900px) {
    .st-stappen { grid-auto-flow: row; }
    .st-feiten, .st-mee { grid-template-columns: 1fr; }
    .st-rij { grid-template-columns: 1fr; align-items: start; }
  }
  @media (max-width: 620px) {
    .st-deuren { grid-template-columns: minmax(0, 1fr); }
  }
</style>
