      // Taak #271f.
      outfit: ' Plus {price} × {n} voor full outfit.',
    },
    rung: {
      one: `Nog één product en elk product zakt van {now} naar {rate} — {count} voor {then}, ${vatLabel('excl', 'nl')}.`,
      many: `Nog {add} producten en elk product zakt van {now} naar {rate} — {count} voor {then}, ${vatLabel('excl', 'nl')}.`,
    },
    level: {
      attended: `${WINDOW_THRESHOLD} producten of meer, dus deze bestelling gaat in de capaciteitsagenda. ${turnaround('attended', 'nl')}.`,
      unattended: `${TIERS.unattended.queue.nl}. Vanaf ${WINDOW_THRESHOLD} producten komt een bestelling in de capaciteitsagenda en krijgt ze in plaats daarvan een gereserveerd venster.`,
    },
    kind: {
      complete: 'Catalogset en lifestyle-carousel',
      catalog: 'Catalogset',
      lifestyle: 'Lifestyle-carousel',
    },
    sum: {
      kind: 'Wat we maken',
      count: 'Producten',
      // Taak #271f.
      outfit: 'Full outfit',
      outfitN: '{price} extra × {n}',
      net: `Orderbedrag (${vatLabel('excl', 'nl')})`,
      vat: vatLabel('rate', 'nl'),
      total: `Totaal (${vatLabel('incl', 'nl')})`,
      files: 'Referentiemateriaal',
      noFiles: 'Nog niets gestuurd — je kunt het later mailen',
      window: 'Levering',
      windowLater: 'Venster wordt nog gereserveerd',
      queue: TIERS.unattended.queue.nl,
      email: 'E-mail',
    },
    upload: {
      sending: 'Versturen…',
      done: 'Verstuurd',
      retry: 'Opnieuw',
      remove: 'Verwijderen',
      count: '{n} van {max} geüpload',
      err: {
        'too-large': 'Te groot — {max} per bestand is het maximum.',
        'batch-full': 'Dat zijn {max} bestanden, het maximum voor één bestelling.',
        rate: 'Te veel tegelijk. Wacht even en probeer het opnieuw.',
        unavailable: 'We konden nu geen bestanden aannemen.',
        network: 'De verbinding viel weg voordat deze binnen was.',
        generic: 'Deze is niet doorgekomen.',
        'bad-type': 'Geen beeld dat we kunnen lezen. JPG, PNG, WebP, AVIF, HEIC, GIF of TIFF.',
        empty: 'Dit bestand is leeg.',
        'no-file': 'Er kwam niets mee.',
        'bad-batch': 'Deze uploadsessie is zijn plek kwijt. Herlaad de pagina en kies de bestanden opnieuw.',
        'bad-request': 'Deze is niet doorgekomen.',
      },
    },
    s3: {
      prefillNote: 'Ingevuld vanuit je account ({email}) — pas aan wat niet meer klopt.',
    },
    gate: {
      windowSub: 'Beschikbaar venster',
    },
    submit: {
      sending: 'Versturen…',
      email: 'Dat e-mailadres kwam er niet doorheen. Controleer het en verstuur opnieuw.',
      network: 'Het verzoek is niet afgerond en we kunnen niet zien of het is aangekomen. Verstuur het niet twee keer maar mail hello@visuails.com, dan bevestigen wij wat er binnen is.',
      generic: 'Er ging iets mis aan onze kant. Er is niets in rekening gebracht. Probeer het opnieuw, of mail hello@visuails.com.',
    },
  },
};

// ── The contract, enforced at build time ───────────────────────────────────
// Every dotted path src/scripts/pipeline.js passes to c(), in both languages.
// A key that is missing, empty, or filed in the wrong table fails `npm run
// build` here rather than reaching a visitor as an empty string.
//
// This list exists because that is exactly what happened. Task #271e added
// s3.prefillNote to FORM — the markup table, which is never serialised — so
// c('s3.prefillNote') resolved to '' and bindPrefill() un-hid an empty
// paragraph on step 3 for every returning signed-in customer. Nothing broke,
// nothing logged, and nothing could have caught it except reading the two
// tables side by side. Now the build reads them.
//
// Adding a c() call to pipeline.js means adding its path here. That is the
// point: the two files are one contract and this is where it is written down.
const REQUIRED_COPY = [
  'total.each', 'total.more', 'total.quote', 'total.onRequest', 'total.outfit',
  'rung.one', 'rung.many',
  'level.attended', 'level.unattended',
  'kind.complete', 'kind.catalog', 'kind.lifestyle',
  'sum.kind', 'sum.count', 'sum.outfit', 'sum.outfitN',
  'sum.net', 'sum.vat', 'sum.total',
  'sum.files', 'sum.noFiles', 'sum.window', 'sum.windowLater', 'sum.queue', 'sum.email',
  'upload.sending', 'upload.done', 'upload.retry', 'upload.remove', 'upload.count',
  // Every code functions/api/upload.js can answer with, plus the generic
  // fallback uploadError() reaches for when it answers with something else.
  'upload.err.too-large', 'upload.err.batch-full', 'upload.err.rate',
  'upload.err.unavailable', 'upload.err.network', 'upload.err.generic',
  'upload.err.bad-type', 'upload.err.empty', 'upload.err.no-file',
  'upload.err.bad-batch', 'upload.err.bad-request',
  's3.prefillNote',
  'gate.windowSub',
  'submit.sending', 'submit.email', 'submit.network', 'submit.generic',
];

for (const l of ['en', 'nl'] as const) {
  for (const path of REQUIRED_COPY) {
    let node: unknown = PIPE[l];
    for (const key of path.split('.')) {
      node = node && typeof node === 'object' ? (node as Record<string, unknown>)[key] : undefined;
    }
    if (typeof node !== 'string' || !node.trim()) {
      throw new Error(
        `StartPage.astro: PIPE.${l}.${path} is missing or empty, and src/scripts/pipeline.js reads it. `
        + 'Script copy belongs in PIPE, not in FORM — FORM is markup labels and is never sent to the browser.'
      );
    }
  }
}

// ── The form's own copy ────────────────────────────────────────────────────
// Markup labels, kept apart from PIPE above so the config blob the browser
// downloads carries only what the script actually reads. Every euro and every
// count in here is interpolated from pricing.js — none is typed.
const FORM = {
  en: {
    railLabel: 'Order steps',
    rail: ['Order', 'Material', 'Brief', 'Timing', 'Confirm'],
    next: 'Continue',
    back: 'Back',
    optional: 'optional',
    s1: {
      h: 'What are we making?',
      lead: 'Two answers: what each product gets, and how many products there are. The rate follows from the second one, and so does whether a window in the calendar is reserved for you.',
      legend: 'What we make',
      kindH: 'What does each product get?',
      // [wire value, ladder kind, title, description]
      //
      // THE VALUE IS THE WIRE FORMAT, NOT THE MODEL'S NAME. These three are
      // what functions/api/order.js already accepts (ORDER_SERVICES) and what
      // the D1 `service` column already stores — which is why this radio group
      // can BE the `service` field and a no-JS post can carry the real answer.
      // `drop` is the stored name for "a catalog set and a lifestyle carousel";
      // renaming it to `complete` is a server change and a migration, not a
      // form change, so the ladder's own kind travels beside it in data-pl-kind
      // and pipeline.js prices from that.
      //
      // Every rate here is read from the ladder. The first is what ONE product
      // costs and the second is where the rate stops falling, so the pair says
      // what a single figure could not: this is a range you move along.
      kindOptions: [
        ['drop', 'complete', 'Catalog set and lifestyle carousel',
          `Seven finished images a product — the four catalog shots and the three-image carousel. ${euro(ladderRate('complete', 1), 'en')} a product, down to ${euro(ladderFloor('complete'), 'en')} as the count rises.`],
        ['catalog', 'catalog', 'Catalog set only',
          `Four images a product: front, back, a fabric or logo close-up, and one on-model shot. ${euro(ladderRate('catalog', 1), 'en')} a product, down to ${euro(ladderFloor('catalog'), 'en')}.`],
        ['lifestyle', 'lifestyle', 'Lifestyle carousel only',
          `Three images a product in one styled look, ready to post. ${euro(ladderRate('lifestyle', 1), 'en')} a product, down to ${euro(ladderFloor('lifestyle'), 'en')}.`],
      ],
      // Brief §1 wants /start wired to the pillar pages, and this is the one
      // moment on the form where a visitor is genuinely choosing between them
      // — so the names in the radio list above become the links, in a sentence
      // that answers the question the list raises rather than a row of "learn
      // more" chips under it.
      kindLink: `A <a href="${lp('/catalog')}">catalog set</a> is the clean product page and a <a href="${lp('/lifestyle')}">lifestyle carousel</a> is the same product in a scene. <a href="${lp('/pricing')}">The whole ladder is on the pricing page</a>.`,
      // The Brand Model attaches to an order and changes every order after it,
      // so it belongs at the moment the work is picked.
      brandModel: `Any order can run on <a href="${lp('/custom-models')}">a Brand Model</a> — one face, made only for you, so every order after this one is recognisably yours.`,
      videoNote: `Video clips are ${euro(AMOUNT.video, 'en')} each, ${vatLabel('excl', 'en')}. Say how many in the brief and they go on the same invoice.`,
      countLabel: 'How many products?',
      countHint: `Every count has a rate and the rate only ever falls. More than ${ATTENDED_PER_WINDOW} is more than one reserved window holds — take the last option and we plan it with you.`,
      more: `More than ${ATTENDED_PER_WINDOW}`,
      totalLabel: 'Running total',
      // Three rows, never one number. BRIEF-14's hardest rule is that no price
      // is printed without saying which side of VAT it is on, and the labels
      // come from vatLabel() so "excl. VAT" has one home sitewide.
      netLabel: `Order value (${vatLabel('excl', 'en')})`,
      vatRowLabel: vatLabel('rate', 'en'),
      grossLabel: `Total (${vatLabel('incl', 'en')})`,
      firstOrder: `First order for a brand: ${Math.round(FIRST_ORDER_DISCOUNT * 100)}% comes off the order value. It is applied on the invoice, so it is not in the figures above.`,
      // Said out loud rather than only in a code comment. The client-side sum
      // is a display; the invoice is derived server-side from the same ladder,
      // and nothing the browser posts decides what anything costs.
      displayNote: 'These figures are worked out in your browser as a preview. The invoice is calculated again on our side, from the same ladder.',
      levelsH: 'What this count earns',
      levelAttended: ['Reserved window', `From ${WINDOW_THRESHOLD} products`],
      levelUnattended: ['Standard queue', `Up to ${WINDOW_THRESHOLD - 1} products`],
      // Task #271f — Single Product/Full outfit.
      outfitLabel: 'Any of these a full outfit?',
      outfitHint: `Several products styled together on one shot — trousers and a t-shirt on the same model, for example — instead of one product on its own. Adds ${euro(OUTFIT_SURCHARGE, 'en')} per product styled this way, up to ${MAX_OUTFIT_PRODUCTS}. ${OUTFIT_COPY.en}`,
      outfitNone: 'None — single product',
      outfitCount: (n: number) => `${n} full outfit${n === 1 ? '' : 's'}`,
    },
    s2: {
      h: 'Send the product photos',
      lead: 'Whatever you already have. Phone photos on a table are enough — they are reference for the pipeline, not the finished shot.',
      dropzone: 'Choose files, or drag them here',
      dropzoneHint: `JPG, PNG, WebP, AVIF, HEIC, GIF or TIFF · up to ${Math.round(MAX_FILE_BYTES / (1024 * 1024))} MB each · ${MAX_BATCH_FILES} files per order`,
      off: 'Files cannot be taken at the moment. Carry on with the order — we will ask for them by email, and nothing about your order depends on this step.',
      skip: 'You can skip this and email the material afterwards. The order still reaches us.',
    },
    s3: {
      h: 'Who is this for?',
      lead: 'Enough to invoice it and come back to you. Nothing here is used for anything else.',
