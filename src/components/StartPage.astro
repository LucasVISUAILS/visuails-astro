      outfit: 'Full outfit',
      outfitN: '{price} extra × {n}',
      // Three rows, never one. BRIEF-14: no price is printed without saying
      // which side of VAT it is on, and a single "Total" on a confirm screen is
      // exactly where that rule gets broken.
      net: `Order value (${vatLabel('excl', 'en')})`,
      vat: vatLabel('rate', 'en'),
      total: `Total (${vatLabel('incl', 'en')})`,
