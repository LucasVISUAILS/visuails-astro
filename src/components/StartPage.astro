     kleur van de pagina. Deze twee zijn de nieuwe banden — een brillenwand en
     een woestijn — en die brengen tegelijk twee producttypes binnen die de
     galerij nog niet heeft. */
  complete: { src: '/img/lifestyle-band-06.webp', w: 1800, h: 1013 },
  editions: { src: '/img/lifestyle-band-01.webp', w: 1800, h: 1005 },
  'custom-photo': { src: '/img/banners-16.webp', w: 2400, h: 1792 },
  'video-product': { src: '/img/banners-03.webp', w: 928, h: 1152 },
  'video-scene': { src: '/img/banners-05.webp', w: 928, h: 1152 },
  'video-custom': { src: '/img/banners-01.webp', w: 928, h: 1152 },
