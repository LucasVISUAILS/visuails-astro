      <h2 class="pl-h" data-pl-head>{f.s5.h}</h2>
      <p class="pl-lead">{f.s5.lead}</p>

      {/* renderSummary() fills this on every arrival at step 5. Empty in the
          markup and empty without JS, where the answers are on screen already
          and reading them back would be a second copy of the same form. */}
      <dl class="pl-summary" data-pl-summary></dl>

      <p class="pl-error" data-pl-error hidden role="alert"></p>

      {/* The order exists and its window did not survive the insert. Saying so
          here is the only honest move: the alternative is a thank-you page
          showing a date the gate took back a second before the row landed. */}
      <div class="pl-lost" data-pl-lost hidden role="alert">
        <h3 class="pl-lost-h">{f.s5.lostH}</h3>
        <p class="pl-lost-body">{f.s5.lostBody}</p>
        <button type="button" class="btn btn-primary" data-pl-lost-go>{f.s5.lostGo}</button>
      </div>

      <div class="pl-after">
        <h3 class="pl-sub-h">{f.s5.afterH}</h3>
        <ul class="pl-after-list">
