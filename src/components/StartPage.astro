---
// VISUAILS — /start, the single door into the order pipeline.
//
// This component holds the whole page body so that /start and /nl/start are
// the SAME page in two languages rather than two pages that drift. The brief
// requires every change to land in EN and NL together; the cheapest way to
// guarantee that is to give them one source file and one copy table.
//
// It replaced five parallel order pages (/order, /order-catalog,
// /order-lifestyle, /order-video, /order-custom — AUDIT-TASK-0.md §E). Those
// files are deleted; all five URLs are host-level 301s to this page, in both
// languages, in public/_redirects. Nothing in src/ links to them any more.
//
// SCOPE, read before editing:
//   · This is section 10's five-step pipeline: order → material → brief →
//     capacity gate → confirm. src/scripts/pipeline.js drives it and this
//     file is the DOM contract that script queries. Every [data-pl-*] hook
//     below is load-bearing; renaming one silently disables a step.
//   · Step 1 used to ask TWO questions — a "door" (a drop, or single products)
//     and then a package inside it. The package model is gone (see section 0 of
//     src/data/pricing.js): there is one ladder, priced per product, and the
//     service level FOLLOWS the count rather than being a second thing the
//     buyer answers. So step 1 asks what we make per product, and how many.
//   · Section 13 still supplies every promise on this page; which set of
//     promises applies is now decided by tierFor(count), not by a radio.
//
// Every fact about a tier is read from src/data/pricing.js. No price, queue
// position, promise or turnaround is typed into this markup. If a
// promise on this page is wrong, it is wrong in pricing.js.
//
// ─────────────────────────────────────────────────────────────────────────────
// WHAT THIS PAGE DOES WITHOUT JAVASCRIPT
// All five steps render at once as one long form that posts to /api/order the
// same way the five retired order pages did. What is lost is real, and is
// stated in the <noscript> rather than hidden: no file upload (the endpoint is
// XHR-driven), no capacity check, no reserved window and no running total —
// those are settled by email instead.
//
// What is NOT lost any more: the thing we make. `service` used to be a hidden
// input on a safe default, so a no-JS order for a whole collection arrived
// labelled `catalog` with the truth buried in details_json. The step 1 radio
// group IS that field now — its three values are the three the server already
// accepts (ORDER_SERVICES in functions/api/order.js) — so a no-JS post carries
// the real answer. `tier` is still a hidden input written by the script, and
// still defaults to `unattended`: the tier that reserves nothing is the one it
// is safe to arrive on.
// ─────────────────────────────────────────────────────────────────────────────
import {
  TIERS, reviewClaim, AMOUNT, euro, TEST_SAMPLE,
  TIER_ROWS, tierRow, tierRowLabels, turnaround,
  ladderRate, ladderFloor, LADDER, VAT_RATE, vatLabel,
  WINDOW_THRESHOLD, FIRST_ORDER_DISCOUNT,
  OUTFIT_SURCHARGE, MAX_OUTFIT_PRODUCTS, OUTFIT_COPY,
} from '../data/pricing.js';
import { ATTENDED_PER_WINDOW } from '../data/capacity.js';
import { MAX_BATCH_FILES, MAX_FILE_BYTES, UPLOAD_TYPES } from '../lib/uploads.js';
import { localizedPath } from '../i18n/ui.js';

interface Props { lang: 'en' | 'nl'; }
const { lang } = Astro.props;
const lp = (p: string) => localizedPath(lang, p);

// Only the unattended tier is read by name here (its queue line is quoted
// verbatim on step 4). The attended tier reaches this file through turnaround()
// and tierRow(), which is what those accessors exist for.
const unattended = TIERS.unattended;
const sample = TEST_SAMPLE[lang];

// ── Copy ───────────────────────────────────────────────────────────────────
// Only language-specific *prose* lives here. Anything that is a promise
// (timing, queue, delivery, aftercare, review level, every euro) is pulled
// from pricing.js below, in both languages, from the same object.
const COPY = {
