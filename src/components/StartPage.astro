    <!-- STEP 2 · MATERIAL -->
    <section class="pl-step" data-pl-step="2">
      <h2 class="pl-h" data-pl-head>{f.s2.h}</h2>
      <p class="pl-lead">{f.s2.lead}</p>

      {/* Live-only: the input carries no name attribute, so without JS it would
          be a control that silently sends nothing. The noscript above says what
