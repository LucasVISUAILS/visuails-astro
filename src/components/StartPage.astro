---
import { waHref } from '../data/whatsapp.js';
/* ═══════════════════════════════════════════════════════════════════════════
 * VISUAILS — /start, de kiezer. HERBOUWD VANAF NUL, 7 september 2026.
 * ═══════════════════════════════════════════════════════════════════════════
 *
 * Lucas: *"de what are we making pagina moet een volledige redo worden (…) kijk
 * wat er zou moeten komen te staan door als een klant door de website te
 * navigeren en te kijken wat het meest logische is. Ik vind het namelijk een
 * hele onlogische pagina."*
 *
 * ── WIE HIER BINNENKOMT, GETELD ────────────────────────────────────────────
 *
 * /start is het doel van de knop ORDER in de kop, van dezelfde knop in de
 * voettekst, van de voorpagina, /pricing, /models, /studio, /compare,
 * /gallery, /guides, /upload-guidelines, /test-sample, /thank-you, /portal en
 * de 404. Zesentwintig plekken.
 *
 * Wie al WEET wat hij wil, komt hier niet: de dienstpagina's linken rechtstreeks
 * naar /start/catalog, /start/lifestyle en /start/video. Iedereen die hier
 * aankomt heeft dus op een algemene bestelknop gedrukt en heeft de keuze nog
 * niet gemaakt. Dat is de enige bezoeker die deze pagina heeft, en de pagina
 * moet precies één ding voor hem doen: hem naar de goede deur brengen.
 *
 * ── WAT ER MIS WAS, EN WAAROM HET ONLOGISCH VOELDE ─────────────────────────
 *
 * 1 · DE PAGINA DEELDE OP NAAR ONZE KASSA, NIET NAAR ZIJN VRAAG. Bovenaan
 *     stond "Nu te bestellen" met drie kaarten; twee schermen lager "Op
 *     aanvraag" met video en de look op maat. Wie video zoekt, leest de eerste
 *     rij, ziet geen video, en concludeert dat we het niet doen. De vraag is
 *     in beide gevallen dezelfde — wat moet er gemaakt worden — dus hoort het
 *     antwoord in één rij te staan. Of er al een kassa achter zit, is ONS
 *     probleem en mag op de deur staan, maar het mag de deuren niet sorteren.
 *
 * 2 · DE PRIJSMECHANIEK STOND VÓÓR DE KEUZE. De eerste zin ging over een
 *     dalend tarief en over de grens van tien producten, allebei voordat je
 *     iets gekozen had. En elke kaart droeg een BEREIK (€89–€39): twee getallen
 *     waar je niets mee kunt tot je je aantal weet. De ladder is het werk van
 *     /pricing. Hier hoort één getal: waar het begint.
 *
 * 3 · VIJF BESLISSINGEN OP DE PAGINA DIE ÉÉN BESLISSING MOET AFHANDELEN.
 *     Welke dienst · wel of geen merkmodel · wel of geen abonnement · een van
 *     de twee op aanvraag · of toch eerst een proef. Alleen de eerste is de
 *     reden dat iemand op ORDER drukte.
 *
 * 4 · TWEE ERVAN WAREN GEEN KEUZE MAAR EEN CATEGORIEFOUT. Een merkmodel is
 *     geen vierde dienst — het is een gezicht dat MEEGAAT in een bestelling.
 *     Een look op maat is geen dienst maar een LOOK, die je binnen catalog of
 *     lifestyle kiest; de pagina zei dat zelf ("eenmaal ontworpen staat hij als
 *     tegel in het bestelformulier") en zette hem toch naast catalog en video.
 *     Een abonnement is geen dienst maar een MANIER VAN BETALEN voor hetzelfde
 *     werk. Ze naast de diensten zetten stelt een keuze voor die niet bestaat.
 *
 * 5 · DE PAGINA ZEI NERGENS WAT ER GEBEURT ALS JE DRUKT. Geen woord over hoe
 *     lang het formulier is, dat er niets in rekening wordt gebracht voordat je
 *     verstuurt, of dat de leverdatum vóór de betaling vaststaat. Dat is het
 *     meest geruststellende dat een doorverwijspagina kan zeggen, en de site
 *     zegt het overal behalve hier.
 *
 * ── DE OPBOUW NU: VIER GROEPEN, VIER VERSCHILLENDE VRAGEN ──────────────────
 *
 *   1. WAT WORDT ER GEMAAKT?      vier deuren, op bestemming gesorteerd
 *   2. HOE BETAAL JE HET?         eenmalig, of maandelijks — één rij
 *   3. WAT GEBEURT ER DAARNA?     de vijf stappen, en wanneer je betaalt
 *   4. WAT GAAT ER MEE?           merkmodel en eigen look — bij een bestelling
 *   ...en voor wie het nog niet weet: de proef.
 *
 * DE BETAALVRAAG STAAT SINDS 8 SEPTEMBER 2026 OP TWEE en niet meer op vier. Hij
 * gaat over de deuren die er vlak boven staan, en stond er twee panelen vanaf.
 *
 * De deuren heten naar WAAR DE BEELDEN HEEN GAAN en niet naar hoe wij ze
 * noemen. "Catalogsets" is ons woord; "op je productpagina" is het zijne. De
 * dienstnaam staat er als etiket bij, want die heeft hij overal elders op de
 * site gelezen en die moet blijven kloppen.
 *
 * ── WAT ONGEWIJZIGD BLIJFT ─────────────────────────────────────────────────
 *
 * HET WOORD "VIER HUISSTIJLEN" STAAT ER UITGESCHREVEN, EN DAT IS BEWAAKT.
 * tests/promises.test.mjs leest dit bestand en eist dat het aantal echte
 * huisstijlen uit styles.js hier als WOORD staat, in beide talen. Verandert het
 * aantal, dan wordt die toets rood en zegt hij welke zin waar aangepast moet
 * worden. Vandaar "house styles" en niet "house looks": het is het woord dat de
 * toets kent en dat op de meeste plekken van de site staat.
 *
 * Elke euro komt uit src/data/pricing.js — geen enkel bedrag is hier getypt.
 * Elk bedrag draagt zijn btw-label uit vatLabel(), en de <Note> met vatDetail()
 * staat er één keer, bij de deuren waar de bedragen staan. De zes routes
 * eronder zijn niet aangeraakt: dit bestand verwijst alleen.
 * ═══════════════════════════════════════════════════════════════════════════ */
import {
  ladderRate, euro, vatLabel, vatLead, vatDetail, AMOUNT, plans,
  WINDOW_THRESHOLD, TEST_SAMPLE, TIERS, clause,
  CATALOG_IMAGES, LIFESTYLE_IMAGES, COMPLETE_IMAGES,
  STOCK_OFF_BRAND, STOCK_ON_BRAND, PLAN_ROLLOVER_MONTHS,
} from '../data/pricing.js';
/* ── HET ETIKET DAT ZEGT OF JE IETS MOET OPSTUREN — 10 september 2026 ────────
   Lucas' idee, en het is de eerste vraag die een bezoeker op deze pagina heeft
   zonder dat hij ergens staat. Eén bron voor het feit én voor het woord, in
   beide talen: src/data/eigenproduct.js. */
import { productStand, PRODUCT_COPY } from '../data/eigenproduct.js';
import { localizedPath } from '../i18n/ui.js';

import Note from './Note.astro';
import Placeholder from './Placeholder.astro';
import '../styles/stijl22.css';
interface Props { lang: 'en' | 'nl'; }
const { lang } = Astro.props;
const lp = (p: string) => localizedPath(lang, p);

const sample = TEST_SAMPLE[lang];
const planList = plans(lang);
const planFrom = planList[0];
const t0 = TIERS.unattended;

/* De foto op elke deur, met de ECHTE afmeting van het bestand op schijf — niet
   die van het kader waarin hij belandt. Een verkeerd getypte hoogte reserveert
   de verkeerde plek en laat de rij verspringen zodra het beeld binnenkomt.

   ── WAAROM DE VIDEODEUREN EEN FOTO DRAGEN ─────────────────────────────────
   Er staat geen enkel videostill op schijf, en een still verzinnen mag niet.
   Wat er wel staat zijn onze eigen campagnebeelden, en dat is ook precies waar
   een clip van gemaakt wordt: video op deze site is beeld dat gaat bewegen. De
   deur draagt dus het soort scène, niet een frame uit een bestaande clip, en er
   staat geen afspeelknop op — die zou beloven dat er een video achter zit.

   Hooks heeft niets: /hooks draagt zelf ook alleen <Placeholder>s, want het
   tweebeeldsformaat is nog niet geschoten. Die deur krijgt dus de plaatshouder
   met de opdracht erin, dezelfde afspraak als overal. */
/* ── DE DEUR MOET LATEN ZIEN WAT DE DIENST IS — 9 september 2026 ────────────
 *
 * Lucas: *"Deze kan je gebruiken om te laten zien wat catalog bijvoorbeeld is
 * want het is nu alleen het t-shirt met witte achtergrond."*
 *
 * Dat was letterlijk zo: op de catalogdeur stond `catalog-after.webp`, één zwart
 * T-shirt op wit. Een bezoeker die tassen verkoopt, of brillen, of schoenen, zag
 * daar een T-shirt en moest zelf bedenken dat zijn product er ook onder valt.
 *
 * Het nieuwe beeld is het raster uit "Catalog banners": twaalf producten in
 * dezelfde catalogbehandeling — T-shirt, hoodie, gebreide trui, puffer, bomber,
 * overhemd, jeans, pantalon, pet, sneakers, TAS en sjaal. Dat beantwoordt de
 * vraag die de vorige foto opriep in plaats van hem te stellen.
 *
 * De lifestyledeur draagt om dezelfde reden een scène met een tas en een
 * zonnebril erin, en niet nog een foto van een jas. */
