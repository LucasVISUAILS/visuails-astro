      onRequest: '—',
      // Task #271f — appended to whichever note above already applies.
      outfit: ' Plus {price} × {n} for full outfit.',
    },
    // THE LADDER'S OWN UPSELL. Both totals are computed from the ladder before
    // this sentence is written — see syncTotal() in pipeline.js — because a
    // rounded or estimated "you would save about" is a number a client can
    // disprove with a calculator, and this one is offered unprompted.
    rung: {
      // NOT "{then} instead of {now}". {then} is the total for MORE products,
      // so it is the larger number — reading it as a saving is exactly wrong,
      // and a prospect who spots that stops trusting every other figure on the
      // page. The comparison that is actually true is per product: the rate
      // falls, and the sentence says so before it names any total.
      one: `One more product and every product drops from {now} to {rate} — {count} for {then}, ${vatLabel('excl', 'en')}.`,
