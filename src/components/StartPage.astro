    <!-- STEP 3 · BRIEF -->
    <section class="pl-step" data-pl-step="3">
      <h2 class="pl-h" data-pl-head>{f.s3.h}</h2>
      <p class="pl-lead">{f.s3.lead}</p>
      {/* Task #271e, 2026-07-29: hidden by default — no JS, no signed-in
          account, or a signed-in account with nothing on file all leave this
          exactly as it was. pipeline.js's bindPrefill() fills the text and
          un-hides it only once it has actually written a value into a field
