---
import { waHref } from '../data/whatsapp.js';
// VISUAILS — /start, the chooser.
//
// WHAT THIS PAGE USED TO BE
// The whole order pipeline: 2,300 lines, five steps, and a first question that
// asked which of three things you wanted made. That question was already
// answered everywhere it was asked from — /catalog's own call to action says
// "order catalog sets", and the visitor who clicked it arrived at a form that
// made them pick again from a grid of three. It also quietly decided that
// video, the Brand Model and the monthly plans did not exist, because they had
// no place in a form built around one ladder. Lucas noticed the video-shaped
// hole; the rest of this page is the same hole in three other shapes.
//
// So /start is a chooser now, and each service owns its own route:
//
//   /start/catalog      real flow      catalog sets, with the background picker
//   /start/lifestyle    real flow      carousels, with the look picker
//   /start/complete     real flow      both, with the background picker
//   /start/video        placeholder    the flow is not built; register interest
//   /start/brand-model  placeholder    one-time setup, agreed in conversation
//   /start/plan         placeholder    monthly plans, agreed by intake
//
// A link can now point at the flow it means. Nothing on this page is a form:
// six doors, what is behind each one, and what state each one is in.
//
// EVERY EURO IS READ, NOT TYPED. The three rates below are the ladder's own
// first rung per kind (ladderRate(kind, 1)) and its floor (ladderFloor(kind)),
// so a repricing in src/data/pricing.js changes this page without anyone
// opening it. The two placeholder amounts come from AMOUNT for the same reason.
import {
  ladderRate, ladderFloor, euro, vatLabel, vatLead, vatDetail, AMOUNT, plans,
  WINDOW_THRESHOLD, TEST_SAMPLE,
} from '../data/pricing.js';
import { localizedPath } from '../i18n/ui.js';

import Note from './Note.astro';
interface Props { lang: 'en' | 'nl'; }
const { lang } = Astro.props;
const lp = (p: string) => localizedPath(lang, p);

const sample = TEST_SAMPLE[lang];
const planList = plans(lang);
// The cheapest plan, named rather than described — "from <the Starter price> a
// month" is the only figure this page needs about the plans, and it is read off
// the list rather than typed here or in the comment above it.
const planFrom = planList[0];

// ── The photographs ────────────────────────────────────────────────────────
// One per real service, and the smallest file in public/img that actually
// shows the thing. They render at roughly 370 CSS px in the three-up grid, so
// the worst oversample here is about 5× at 1× DPR and 2.5× on a retina screen.
// The order form used to draw the same 2,400px files into 84px boxes — a 14×
// oversample of seven photographs, on the step where nobody was looking at
// them. That grid is gone; this one is where the pictures earn their bytes.
const SHOT = {
  catalog: { src: '/img/catalog-after.webp', w: 1800, h: 1800 },
  lifestyle: { src: '/img/lifestyle-dunes-01.webp', w: 928, h: 1152 },
  complete: { src: '/img/lifestyle-glow-04.webp', w: 1200, h: 896 },
};

const COPY = {
  en: {
    eyebrow: 'Start',
    h1: 'What are we making?',
    lead: `Pick what you want made and we only ask the questions that service needs. The rate per product falls as the count rises, and from ${WINDOW_THRESHOLD} products an order gets a reserved delivery date instead of the normal turnaround.`,
    readyH: 'Order it now',
    laterH: 'Ask for it',
    laterLead: 'Three services the studio does that a form cannot price on its own yet. Each has a page saying where it stands and how to get in line.',
    from: 'from',
    perProduct: 'a product',
    go: 'Start this order',
    ask: 'Read where this stands',
    services: [
      {
        id: 'catalog',
        kind: 'catalog',
        href: '/start/catalog',
        name: 'Catalog sets',
        gets: 'From 4 images per product — front, back, detail, on model',
        line: 'The product page shots. Clean ground, consistent across a whole range.',
      },
      {
        id: 'lifestyle',
        kind: 'lifestyle',
        href: '/start/lifestyle',
        name: 'Lifestyle carousels',
        gets: '3 images per product — one styled look',
        line: 'The same product in a scene, in one of four house styles.',
      },
      {
        id: 'complete',
        kind: 'complete',
        href: '/start/complete',
        name: 'Both together',
        gets: '7 images per product — 4 catalog, 3 lifestyle',
        line: 'A whole range shot once: the page and the feed, in one order.',
      },
    ],
    later: [
      {
        id: 'video',
        href: '/start/video',
        name: 'Video clips',
        status: 'No order form yet',
        price: `${euro(AMOUNT.video, 'en')} a clip`,
        line: 'Clips are being made today; the order flow for them is not finished.',
      },
      {
        id: 'brand-model',
        href: '/start/brand-model',
        name: 'A Brand Model',
        status: 'By conversation',
        price: `${euro(AMOUNT.brandModel, 'en')} one-time`,
        line: 'One face made only for you. We build it from what you tell us, so it starts with a conversation.',
      },
      /* ── DE LOOK OP MAAT, 18 augustus 2026 ────────────────────────────────
         Hij stond als vijfde radio in het bestelformulier, afgerekend op de
         lifestyle-ladder, terwijl /lifestyle/custom "Op aanvraag" zei. Lucas:
         een stijl op maat heeft geen standaardtarief; die prijs volgt pas als
         de klant heeft gezegd wat hij wil.

         Hier hoort hij dus, en niet daar: dit is de groep voor werk dat de
         studio doet en waar dit formulier geen prijs voor kan uitrekenen. De
         `price`-regel is de enige van de drie zonder bedrag, en dat is het
         eerlijke antwoord in plaats van een gat. */
      {
        id: 'custom-look',
        href: '/start/custom-look',
        name: 'A custom look',
        status: 'Priced per request',
        price: 'No standard rate',
        line: 'A world designed around your product rather than picked from the four. What it costs follows from what you want built.',
      },
    ],
    /* ── HET ABONNEMENT STAAT NIET MEER ONDER "OP AANVRAAG" ─────────────────
       18 augustus 2026. Het stond in de `later`-lijst met status "After a
       conversation" en de knop "Read where it stands" — drie signalen dat je
       het niet kunt kopen. De LINK wees al naar /start/plan, en dat is sinds
       deze week een echte kassa: kiezen, machtigen via Mollie, klaar.

       Een bezoeker leest de status en de knop, niet de href. Dit was dus een
       werkende kassa met een bordje "gesloten" ervoor, op het duurste product
       dat de studio verkoopt en het enige dat elke maand terugkomt.

       EN GEEN VIERDE TEGEL BOVEN. Dat is dezelfde afweging als op de homepage:
       een abonnement is geen vierde dienst maar een andere MANIER VAN BETALEN
       voor wat er in de drie tegels staat. Ernaast zetten zou een keuze
       suggereren tussen "catalog" en "abonnement", en dat is de verkeerde
       vraag. Dus een eigen rij, direct onder de drie, met het getal en de weg
       naar binnen. */
    planH: 'Or put it on a monthly plan',
    planLine: 'The same work on a standing arrangement: a fixed number of products every month, in a week the calendar keeps free for you. You arrange it yourself — no conversation needed first.',
    planCta: 'Start a plan',
    planCta2: 'Compare the plans',
    footH: 'Not ready to order?',
    footBody: `One product, ${sample.price}, ${sample.unit}. It runs through the same production as a paid order, so what you see is what you would get.`,
    footCta: `Try a test sample · ${sample.price}`,
    footWa: 'Ask on WhatsApp',
    // Zie de noot bij OrderFlow.astro's footWaText: deze knop opende WhatsApp
    // met een leeg bericht. Hier staat de bezoeker nog vóór het formulier, dus
    // de zin is een vraag en geen vastgelopen bestelling.
    footWaText: "Hi VISUAILS, I'm not sure which service fits my products.",
    ladder: 'Every price by count, and what each one includes',
  },
  nl: {
    eyebrow: 'Start',
    h1: 'Wat gaan we maken?',
    lead: `Kies wat je wilt laten maken, daarna volgen de stappen. Het tarief per product daalt naarmate het aantal stijgt, en vanaf ${WINDOW_THRESHOLD} producten krijgt een bestelling een vastgezette leverdatum in plaats van de normale doorlooptijd.`,
    readyH: 'Nu te bestellen',
    laterH: 'Op aanvraag',
    laterLead: 'Drie dingen die we maken en waar dit formulier nog geen prijs voor kan uitrekenen. Bij elk staat een pagina met hoe het ervoor staat en hoe je je aanmeldt.',
    from: 'vanaf',
    perProduct: 'per product',
    go: 'Start deze bestelling',
    ask: 'Lees hoe het ervoor staat',
    services: [
      {
        id: 'catalog',
        kind: 'catalog',
        href: '/start/catalog',
        name: 'Catalogsets',
        gets: 'Vanaf 4 beelden per product — voor, achter, detail, op model',
        line: 'De beelden voor je productpagina. Egale ondergrond, en elk product ziet er hetzelfde uit.',
      },
      {
        id: 'lifestyle',
        kind: 'lifestyle',
        href: '/start/lifestyle',
        name: 'Lifestyle-carousels',
        gets: '3 beelden per product — één gestylede look',
        line: 'Hetzelfde product in een scène, in een van vier huisstijlen.',
      },
      {
        id: 'complete',
        kind: 'complete',
        href: '/start/complete',
        name: 'Allebei samen',
        gets: '7 beelden per product — 4 catalog, 3 lifestyle',
        line: 'Een hele reeks in één keer: de pagina en de feed, in één bestelling.',
      },
    ],
    later: [
      {
        id: 'video',
        href: '/start/video',
        name: 'Videoclips',
        status: 'In aanbouw',
        price: `${euro(AMOUNT.video, 'nl')} per clip`,
        line: 'Clips maken we al, maar je kunt ze hier nog niet zelf bestellen.',
      },
      {
        id: 'brand-model',
        href: '/start/brand-model',
        name: 'Een merkmodel',
        status: 'In gesprek',
        price: `${euro(AMOUNT.brandModel, 'nl')} eenmalig`,
        line: 'Eén gezicht, alleen voor jou. We bouwen het van wat jij ons vertelt, dus het begint met een gesprek.',
      },
      /* Zie de noot bij de Engelse tegenhanger. */
      {
        id: 'custom-look',
        href: '/start/custom-look',
        name: 'Een look op maat',
        status: 'Prijs op aanvraag',
        price: 'Geen standaardtarief',
        line: 'Een wereld die om jouw product heen ontworpen wordt in plaats van gekozen uit de vier. Wat het kost, volgt uit wat je gebouwd wilt hebben.',
      },
    ],
    planH: 'Of doe het op een maandabonnement',
    planLine: 'Hetzelfde werk op een vaste afspraak: elke maand een vast aantal producten, in een week die de planning voor je vrijhoudt. Je regelt het zelf — er hoeft geen gesprek aan vooraf te gaan.',
    planCta: 'Sluit een abonnement af',
    planCta2: 'Vergelijk de abonnementen',
    footH: 'Nog niet klaar om te bestellen?',
    footBody: `Eén product, ${sample.price}, ${sample.unit}. Het loopt door dezelfde productie als een betaalde bestelling, dus wat je ziet is wat je zou krijgen.`,
    footCta: `Probeer een proefvisual · ${sample.price}`,
    footWa: 'Vraag het via WhatsApp',
    footWaText: 'Hoi VISUAILS, ik weet niet zeker welke dienst bij mijn producten past.',
    ladder: 'Alle prijzen per aantal, en wat je er bij elk aantal voor krijgt',
  },
};

const c = COPY[lang];

// First rung to floor, both read, neither typed — not even in this comment. One
// figure cannot say the thing that matters about the ladder, which is that it
// is a range you move along.
const rateRange = (kind: string) => `${euro(ladderRate(kind, 1), lang)}–${euro(ladderFloor(kind), lang)}`;
---

<section class="page-hero"><div class="container">
  <span class="eyebrow-page">{c.eyebrow}</span>
  <h1 class="display">{c.h1}</h1>
  <p class="lead" style="margin-top:1.2rem">{c.lead}</p>
</div></section>

<!-- THE THREE THAT HAVE A FLOW -->
<section class="section-tight"><div class="container">
  <h2 class="pick-h">{c.readyH}</h2>
  <div class="pick-grid">
    {c.services.map((s) => (
      <a class="pick" href={lp(s.href)}>
        <img
          class="pick-shot"
          src={SHOT[s.id].src}
          alt=""
          width={SHOT[s.id].w}
          height={SHOT[s.id].h}
          loading="lazy"
          decoding="async"
        />
        <span class="pick-body">
          <span class="pick-name">{s.name}</span>
          <span class="pick-gets">{s.gets}</span>
          <span class="pick-line">{s.line}</span>
          {/* BRIEF-14: the label rides with the figure, the way it does on the
              cards below. It used to sit only in the note under the grid, and
              the note already opens with the same words — so the page said
              "excl. VAT. All figures are excl. VAT." and neither price on the
              card was labelled. */}
          <span class="pick-rate">
            <span class="pick-from">{c.from}</span>
            {rateRange(s.kind)}
            <span class="pick-per">{c.perProduct}, {vatLabel('excl', lang)}</span>
          </span>
          <span class="pick-cta">{c.go}</span>
        </span>
      </a>
    ))}
  </div>
  {/* BRIEF-14: every figure above carries its own excl.-VAT label; this is the
      one line per page that says how VAT is actually handled. vatNote() opens
      with "All figures are excl. VAT", so prefixing it with vatLabel() said the
      same thing twice. */}
  <p class="pick-vat">{vatLead(lang)} <Note lang={lang} term={vatLabel('excl', lang)} wide>{vatDetail(lang)}</Note></p>
  <p class="pick-more"><a href={lp('/pricing')}>{c.ladder}</a></p>
</div></section>

<!-- HET ABONNEMENT — een andere manier van betalen, geen vierde dienst -->
<section class="section-tight"><div class="container">
  <div class="startplan">
    <div class="startplan-copy">
      <h2>{c.planH}</h2>
      <p>{c.planLine}</p>
    </div>
    <div class="startplan-side">
      <p class="startplan-fig">
        <span class="startplan-from">{c.from}</span>
        <strong>{planFrom.price}</strong>
        <span class="startplan-unit">{planFrom.unit}, {vatLabel('excl', lang)}</span>
      </p>
      <div class="startplan-cta">
        <a class="btn btn-primary" href={lp('/start/plan')}>{c.planCta}</a>
        <a class="btn btn-ghost" href={lp('/plans')}>{c.planCta2}</a>
      </div>
    </div>
  </div>
</div></section>

<!-- THE THREE THAT DO NOT, AND SAY SO -->
<section class="section-tight"><div class="container">
  <h2 class="pick-h">{c.laterH}</h2>
  <p class="pick-lead">{c.laterLead}</p>
  <div class="ask-grid">
    {c.later.map((s) => (
      <a class="ask" href={lp(s.href)}>
        <span class="ask-status">{s.status}</span>
        <span class="ask-name">{s.name}</span>
        <span class="ask-price">{s.price}, {vatLabel('excl', lang)}</span>
        <span class="ask-line">{s.line}</span>
        <span class="ask-cta">{c.ask}</span>
      </a>
    ))}
  </div>
</div></section>

<!-- NOT SURE YET -->
<section class="section-tight"><div class="container">
  <div class="start-foot">
    <div>
      <h2>{c.footH}</h2>
      <p class="start-foot-body">{c.footBody}</p>
    </div>
    <div class="start-foot-cta">
      <a href={lp('/test-sample')} class="btn btn-primary btn-lg">{c.footCta}</a>
      <a href={waHref(c.footWaText)} target="_blank" rel="noopener" class="btn btn-ghost btn-lg">{c.footWa}</a>
    </div>
  </div>
</div></section>

<style>
  /* ═══════════════════════════════════════════════════════════════════════════
     Two grids, and the difference between them is the point of the page.

     The three that can be ordered carry a photograph, a rate and a call to
     action that starts something. The three that cannot carry a status word
     where the photograph would be, a price that is still true, and a call to
     action that is honest about what pressing it does. They are not styled as
     lesser — same corner radius, same border weight, same type — because they
     are not lesser work. They are work with no checkout yet.
     ═══════════════════════════════════════════════════════════════════════════ */
  .pick-h { font-size: var(--t-h3); line-height: 1.2; }
  .pick-lead { margin-top: .7rem; color: var(--ink-3); max-width: 66ch; }

  .pick-grid,
  .ask-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(.9rem, 1.8vw, 1.4rem);
    margin-top: clamp(1.4rem, 3vw, 2rem);
  }

  .pick {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--line-strong);
    border-radius: var(--r-lg);
    background: var(--surface);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: border-color var(--dur-1) var(--ease), background var(--dur-1) var(--ease);
  }
  .pick:hover { border-color: var(--accent); background: var(--accent-soft); }
  .pick:focus-visible { outline: 2px solid var(--focus-ring); outline-offset: 3px; }
  .pick-shot {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    background: var(--surface-2);
  }
  .pick-body {
    display: flex;
    flex-direction: column;
    gap: .3rem;
    padding: clamp(.9rem, 2vw, 1.2rem);
    flex: 1;
  }
  .pick-name { font-family: var(--font-display); font-weight: 800; font-size: 1.15rem; line-height: 1.2; color: var(--ink); }
  .pick-gets { font-size: .82rem; color: var(--ink-2); line-height: 1.4; }
  .pick-line { font-size: .86rem; color: var(--ink-3); line-height: 1.55; }
  .pick-rate {
    margin-top: .5rem;
    font-variant-numeric: tabular-nums;
    color: var(--ink);
    font-weight: 500;
  }
  .pick-from,
  .pick-per { font-size: .76rem; color: var(--ink-3); font-weight: 400; }
  .pick-cta {
    margin-top: auto;
    padding-top: .8rem;
    font-size: .84rem;
    font-weight: 600;
    color: var(--accent-bright);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .pick-vat { margin-top: 1rem; font-size: .78rem; color: var(--ink-3); line-height: 1.55; max-width: 70ch; }
  .pick-more { margin-top: .6rem; font-size: .9rem; }
  .pick-more a,
  .pick-more :global(a) { color: var(--accent-bright); text-decoration: underline; text-underline-offset: 3px; }

  /* No photograph, and that is deliberate rather than a gap: what these three
     need said first is what state they are in, so the status word takes the
     place the picture takes on the cards above it. The system colour is the one
     the site already uses for statements of process. */
  .ask {
    display: flex;
    flex-direction: column;
    gap: .3rem;
    padding: clamp(1rem, 2.2vw, 1.4rem);
    border: 1px solid var(--line-strong);
    border-radius: var(--r-lg);
    background: var(--paper-2);
    text-decoration: none;
    color: inherit;
    transition: border-color var(--dur-1) var(--ease);
  }
  .ask:hover { border-color: var(--signal); }
  .ask:focus-visible { outline: 2px solid var(--focus-ring); outline-offset: 3px; }
  .ask-status {
    align-self: flex-start;
    padding: .22rem .55rem;
    border: 1px solid var(--signal);
    border-radius: var(--r-sm);
    font-size: .68rem; font-weight: 700; letter-spacing: .09em;
    text-transform: uppercase; color: var(--signal-ink);
  }
  .ask-name { margin-top: .5rem; font-family: var(--font-display); font-weight: 800; font-size: 1.15rem; line-height: 1.2; color: var(--ink); }
  .ask-price { font-size: .86rem; color: var(--ink-2); font-variant-numeric: tabular-nums; }
  .ask-line { margin-top: .2rem; font-size: .86rem; color: var(--ink-3); line-height: 1.55; }
  .ask-cta {
    margin-top: auto;
    padding-top: .9rem;
    font-size: .84rem;
    font-weight: 600;
    color: var(--accent-bright);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .start-foot {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: clamp(1.6rem, 4vw, 3.5rem);
    align-items: center;
    border-top: 1px solid var(--line-strong);
    padding-top: clamp(2rem, 4vw, 3rem);
  }
  .start-foot-body { margin-top: .9rem; color: var(--ink-3); max-width: 52ch; }
  .start-foot-cta { display: flex; flex-wrap: wrap; gap: .8rem; }
  .start-foot-cta > .btn { flex: 1 0 auto; }

  @media (max-width: 900px) {
    .pick-grid, .ask-grid { grid-template-columns: 1fr 1fr; }
    .start-foot { grid-template-columns: 1fr; }
  }
  @media (max-width: 620px) {
    .pick-grid, .ask-grid { grid-template-columns: 1fr; }
  }
  @media (prefers-reduced-motion: reduce) {
    .pick, .ask { transition: none; }
  }
  /* ── het abonnement op /start ─────────────────────────────────────────────
     Tekst links, het bedrag en de twee knoppen rechts. Dezelfde tweedeling als
     de abonnementsband op de homepage, en om dezelfde reden: het is één
     beslissing met één getal, en dat getal hoort naast de knop te staan die
     erop volgt in plaats van erboven in een alinea. */
  .startplan {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: clamp(1.4rem, 4vw, 3rem);
    align-items: center;
    padding: clamp(1.4rem, 3vw, 2.2rem) 0;
    box-shadow: inset 0 1px 0 var(--line), inset 0 -1px 0 var(--line);
  }
  .startplan-copy h2 { font-size: var(--t-h3); }
  .startplan-copy p { margin-top: .6rem; max-width: 64ch; font-size: .95rem; line-height: 1.6; color: var(--ink-3); }
  .startplan-fig { margin: 0; display: flex; align-items: baseline; gap: .5rem; flex-wrap: wrap; }
  .startplan-from { font-size: .72rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--ink-3); }
  .startplan-fig strong { font-family: var(--font-display); font-weight: 900; font-size: clamp(1.8rem, 3.4vw, 2.4rem); line-height: 1; color: var(--ink); }
  .startplan-unit { font-size: .85rem; color: var(--ink-3); }
  .startplan-cta { margin-top: 1rem; display: flex; gap: .7rem; flex-wrap: wrap; }
  @media (max-width: 52rem) {
    .startplan { grid-template-columns: 1fr; align-items: start; }
  }
</style>
