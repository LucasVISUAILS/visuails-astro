---
// VISUAILS — the service-level block: what changes at WINDOW_THRESHOLD products.
//
// WHAT THIS BLOCK USED TO BE, AND WHY IT IS NOT THAT ANY MORE. It used to be a
// CHOICE: "order individual products" against "run a whole drop", two doors the
// buyer picked between, under a heading taken from brief section 13 — "the
// dividing line is not order size, it is whether a human commits to a deadline."
//
// The August 2026 model falsifies exactly that sentence and nothing else about
// this file. Under the ladder (see section 0 of src/data/pricing.js, the
// governing document) the buyer no longer picks a service level at all: size
// picks it. From WINDOW_THRESHOLD products an order goes into the capacity
// calendar and gets the reserved window; below it, the standard queue. So this
// block stopped being a comparison of two things you choose between and became
// a statement of what changes when your order crosses one line. The old heading
// is not softened here, it is reversed, because a page that still asks the
// buyer to weigh two service models is describing a price list we no longer
// sell.
//
// The number is the SAME line the rate crosses — WINDOW_THRESHOLD is the count
// at which the ladder's third rung starts — and that coincidence is deliberate
// in pricing.js. It is why the paragraph can say "one line, not two", and why
// this block does not need to print a rate to make its point.
//
// THREE THINGS THAT SURVIVED THE CHANGE UNALTERED, because the reasoning behind
// them still holds and each is easy to undo by accident.
//
// FIRST, the two columns are typographically and structurally identical. Same
// heading size, same border, same padding, same row set, same link treatment.
// There is no "recommended" ribbon, no scale difference, no accent on one side.
// The old reason was section 13's — "It is a different SERVICE MODEL, not a
// worse product [...] never style it as a lesser card." The new model makes
// that rule STRONGER rather than retiring it: styling one column as the better
// one would tell a reader they can pick it, and they cannot. Their order size
// already did. If a future pass adds emphasis to one column it will have put a
// choice back on a page whose whole subject is that there isn't one.
//
// SECOND, every cell AND every row label is read from src/data/pricing.js, not
// typed here. Section 13: "put the review-level claim in a single content
// variable per tier, not hardcoded across pages." That rule is written about
// the review claim and it applies with equal force to the other four rows —
// this component renders on /catalog, /lifestyle and /video in two languages,
// and the same rows are printed again by the service block on /pricing. The
// labels are shared for a reason that is not theoretical: when they were typed
// per page the Dutch pair had already drifted, with /pricing printing "Timing"
// in English on a Dutch page.
//
// THIRD, THE CONSTRAINT THAT OUTRANKS EVERYTHING ELSE HERE: the unattended
// column's timing row reads "Typically 2–4 working days" and its queue row
// reads "Standard queue, no fixed delivery date". It never shows a date, and
// there is no prop on this component that could make it show one. Section 13
// calls that "the single most important constraint in this section", and the
// new model does not touch it — it only changes WHICH orders land in that
// column.
//
// This block replaced a prose paragraph that was pasted into all three service
// pages, along with three identical copies of its CSS. That duplication is why
// this is a component rather than a fourth paste.
import {
  TIER_ROWS, tierRow, tierRowLabels, WINDOW_THRESHOLD,
} from '../data/pricing.js';
import { localizedPath } from '../i18n/ui.js';

interface Props {
  lang: 'en' | 'nl';
  /** Where the under-threshold column points. /start takes any size. */
  href0?: string;
  /** Where the at-threshold column points. Defaults to /pricing; pass another path on /pricing itself. */
  href1?: string;
  /** Drop the heading block when the host section already has one. */
  compact?: boolean;
}

const { lang, href0 = '/start', href1 = '/pricing', compact = false } = Astro.props;
const lp = (p: string) => localizedPath(lang, p);

// The column headings are NOT TIERS[id].label any more. Those two strings still
// read "Order individual products" / "Run a whole drop" — the names of the two
// doors a buyer used to choose between — and printing them over these columns
// would re-offer the choice in the header while the paragraph above says there
// isn't one. The headings are the two sides of the line instead, built from the
// threshold itself, so they cannot disagree with the number in the copy.
// (/pricing's service block names its columns the same way, for the same
// reason.)
const label = lang === 'nl'
  ? { unattended: `Onder ${WINDOW_THRESHOLD} producten`, attended: `Vanaf ${WINDOW_THRESHOLD} producten` }
  : { unattended: `Under ${WINDOW_THRESHOLD} products`, attended: `From ${WINDOW_THRESHOLD} products` };

// No product count is given a row of its own, and that is unchanged from the
// version this replaced — but the reason flipped with the model. It used to be
// that a size row would build an order-size comparison under a heading denying
// order size was the comparison. Now order size IS the comparison, and it is
// already in both column headings; a third statement of it would be the only
// row in the table that says the same thing twice.
const t = lang === 'nl'
  ? {
      h: `Wat er verandert bij ${WINDOW_THRESHOLD} producten`,
      p: `Je kiest geen serviceniveau — de omvang van je bestelling bepaalt het. Vanaf ${WINDOW_THRESHOLD} producten gaat een bestelling in de agenda en krijgt hij de vastgezette leverdatum; daaronder loopt hij in de normale doorlooptijd. Dat is ook precies het aantal waarbij het tarief per product een stap zakt, dus er is één grens, geen twee. Beide lopen door dezelfde productie en dezelfde controle.`,
      cta0: 'Start een bestelling',
      cta1: 'Bekijk de prijs per product',
    }
  : {
      h: `What changes at ${WINDOW_THRESHOLD} products`,
      p: `You do not pick a service level — the size of your order sets it. From ${WINDOW_THRESHOLD} products we hold a delivery date for the order and confirm it in writing; below that count the normal turnaround applies. That is also the count at which the rate per product drops a step, so there is one line to cross rather than two. Both run through the same production and the same check.`,
      cta0: 'Start an order',
      cta1: 'See the price per product',
    };

// The row labels are NOT typed in `t` above with the rest of the copy. They
// live in pricing.js (TIER_ROWS) because the Tier 0 block on /pricing prints
// the same five labels, and when they were typed per page the Dutch pair fell
// out of step — /pricing's Dutch list read "Timing" where this one read
// "Levertijd", in English, on a live Dutch page. One list, two consumers.
const rowLabels = tierRowLabels(lang);

// Built once, in tier order, so the two columns cannot drift apart in row
// count or row order — a comparison where the rows do not line up is not a
// comparison. Order is unattended-first because that is now the order of the
// NUMBER LINE — under the threshold, then from it — not because it is lesser.
// Reversing it would make the columns count downwards.
//
// Cells are mapped over the same TIER_ROWS that produced the labels, so a row
// added to pricing.js appears in both columns with its label already attached;
// there is no index in this file that could drift against the label list.
const columns = (['unattended', 'attended'] as const).map((id) => ({
  id,
  label: label[id],
  href: id === 'unattended' ? lp(href0) : lp(href1),
  cta: id === 'unattended' ? t.cta0 : t.cta1,
  cells: TIER_ROWS.map((r) => tierRow(id, r.key, lang)),
}));
---

<div class="tierc reveal pending">
  {!compact && (
    <div class="tierc-head">
      <h2>{t.h}</h2>
      <p>{t.p}</p>
    </div>
  )}

  <div class="tierc-grid">
    {columns.map((col) => (
      <div class="tierc-col">
        <h3>{col.label}</h3>
        <dl class="tierc-rows">
          {col.cells.map((cell, i) => (
            <div class="tierc-row">
              <dt>{rowLabels[i]}</dt>
              <dd>{cell}</dd>
            </div>
          ))}
        </dl>
        <a href={col.href} class="link-arrow tierc-cta">
          {col.cta}
          <svg viewBox="0 0 24 24" class="i"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
      </div>
    ))}
  </div>
</div>

<style>
  .tierc-head { max-width: 68ch; }
  .tierc-head h2 { font-size: clamp(1.4rem, 2.4vw, 1.9rem); }
  .tierc-head p { margin-top: .7rem; color: var(--ink-2); }

  /* TWO CARDS, NOT ONE BOX WITH A LINE DOWN IT — August 2026. Lucas: *"bij
     sommige elementen zit een soort grijze rand eromheen, maak dit mooier."*
     This block was the worst of them.

     What it was: a 1px grid gap over a --line-strong ground, plus a 1px border
     of the same colour around the whole thing. That is the site's hairline
     trick and it is a good trick — one background showing through the gutter
     gives a true 1px rule at every zoom level instead of two adjacent borders
     that composite to 2px on some. But the trick draws a BOX, and a box in a
     mid grey on a near-black page is the single most dated shape a dark UI
     can make: it reads as a table border from 2009, and it flattens two
     independent choices into one object with a divider.

     They are two choices. So they are two cards, separated by real space, each
     with a raised surface and the site's radius, and both wearing .lift from
     global.css — a lit top edge, a contact shadow and a cast shadow, which is
     how an object sits above a dark ground when a grey outline cannot. The
     hover lift is what tells you they are each clickable, which the box never
     did.

     The hairline trick is NOT deleted from the codebase; .compare-static still
     uses it, correctly, for a genuine table. */
  .tierc-grid {
    margin-top: clamp(1.6rem, 3vw, 2.4rem);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(.9rem, 1.8vw, 1.4rem);
  }

  .tierc-col {
    background: var(--surface);
    border-radius: var(--r-lg);
    padding: clamp(1.5rem, 2.8vw, 2.1rem);
    display: flex;
    flex-direction: column;
  }

  /* Identical on both columns. See the file header — the moment one of these
     grows a larger font, an accent colour or a ribbon, the block is arguing for
     a tier instead of describing two. */
  .tierc-col h3 {
    font-size: clamp(1.05rem, 1.7vw, 1.25rem);
    line-height: 1.25;
  }

  .tierc-rows { margin-top: 1.3rem; flex: 1; }
  .tierc-row { padding: .85rem 0; border-top: 1px solid var(--line); }
  .tierc-row:first-child { border-top: 0; padding-top: 0; }

  .tierc-row dt {
    font-size: .72rem;
    font-weight: 600;
    color: var(--ink-3);
  }
  .tierc-row dd {
    margin: .3rem 0 0;
    color: var(--ink);
    font-size: .95rem;
    line-height: 1.45;
    text-wrap: pretty;
  }

  /* No `.i` override here on purpose. The site's arrow is 20px at
     stroke-width 1.8 with butt caps (global.css `.i`), and it is the same
     arrow in every link-arrow on every page. A local resize would make this
     one block's arrow subtly wrong. */
  .tierc-cta { margin-top: 1.5rem; align-self: start; }

  /* One column below the point where two 5-row stacks stop being scannable
     side by side. The row labels repeat in each column rather than living in a
     shared rail, which is what makes the stacked state readable at all. */
  @media (max-width: 760px) {
    .tierc-grid { grid-template-columns: 1fr; }
  }
</style>
