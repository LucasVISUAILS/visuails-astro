---
// VISUAILS — /start/plan. De pagina waar een abonnement echt begint.
//
// WAT HIER STOND EN WAAROM HET WEG IS
// HoldingPage.astro, met de regel *"the plans are a minimum-term commitment.
// Both are conversations. A card form here would be the studio pretending a
// decision has been made that has not."* Dat was waar zolang er geen mandaat
// bestond en Lucas elke aanvraag met de hand omzette. Sinds 17 augustus 2026 is
// er een SEPA-machtiging via Mollie, een maandboekhouding en een dashboard — en
// dan is de pagina die zegt "dit kan nog niet" zelf het obstakel geworden.
//
// De brand-model- en videopagina houden HoldingPage; voor die twee klopt de
// redenering nog. Deze niet meer.
//
// ── GEEN JAVASCRIPT ────────────────────────────────────────────────────────
//
// Radio's en een <select>, en een gewone POST. Geen prijsberekening in de
// browser: de bedragen komen uit plans.js en staan al in de tekst. Wat de klant
// kiest, wordt op de server opnieuw gecontroleerd — PLAN_IDS en TERM_IDS in
// handleSubscribeStart(). Een keuze die alleen in de browser bestaat, is geen
// keuze maar een suggestie.
//
// ── WAAROM DE POST NAAR /account/plan/start GAAT ───────────────────────────
//
// Een abonnement hangt aan een klant, en accounts ontstaan in dit systeem alleen
// door te bestellen. De handler zit dus in account.js, achter de sessiecontrole:
// wie niet is ingelogd, komt op de inlogpagina en niet op een betaalscherm. Zie
// de kop van src/lib/subscribe.js voor waarom dat de goede kant op is.
/* MANDATE_AMOUNT stond hier tot 4 september 2026: de machtiging kostte een euro
   en de tekst noemde hem. Sinds de eerste betaling de eerste maand is, noemt de
   tekst geen bedrag meer voor de machtiging; AMOUNT blijft voor de proefvisual. */
import {
  plans, euro, vatLabel, AMOUNT, planSaving,
  CUSTOM_MONTH_ID, CUSTOM_MONTH_MIN_PRODUCTS, CUSTOM_MONTH_MAX_PRODUCTS,
  customMonthTotal, addOnRate, CATALOG_IMAGES, LIFESTYLE_IMAGES, COMPLETE_IMAGES,
} from '../../data/pricing.js';
import { TERMS, TERM_IDS, monthlyCents, productsFor, clipsFor, hasBrandModel, term as termOf } from '../../data/plans.js';
import { planName } from '../../data/planNames.js';
import { localizedPath } from '../../i18n/ui.js';

import Note from '../Note.astro';
interface Props {
  lang: 'en' | 'nl';
}
const { lang } = Astro.props;
const nl = lang === 'nl';
const lp = (p: string) => localizedPath(lang, p);

const planList = plans(lang);

// De fout uit de vorige poging, als die er is. Eén zin per reden, en `vol` is de
// enige die niet over een vergissing gaat maar over capaciteit — zie de
// capaciteitspoort in handleSubscribeStart().
const fout = String(Astro.url.searchParams.get('fout') || '');
const FOUTEN: Record<string, string> = nl ? {
  plan: 'Kies eerst een abonnement.',
  termijn: 'Kies eerst een termijn.',
  vol: 'Er is deze maand geen plek meer voor dit abonnement. Mail hello@visuails.com — dan zetten we je op de lijst voor de eerstvolgende plek.',
  maat: `Kies bij een maand op maat minstens ${CUSTOM_MONTH_MIN_PRODUCTS} en hoogstens ${CUSTOM_MONTH_MAX_PRODUCTS} producten, en niet meer carrousels dan producten.`,
  opslaan: 'We konden je aanvraag niet vastleggen. Probeer het opnieuw, of mail hello@visuails.com.',
  mollie: 'Het betaalscherm ging niet open. Er is niets afgeschreven. Probeer het opnieuw, of mail hello@visuails.com.',
} : {
  plan: 'Choose a plan first.',
  termijn: 'Choose a term first.',
  vol: 'There is no room for this plan this month. Email hello@visuails.com and we will put you on the list for the next opening.',
  maat: `A custom month needs at least ${CUSTOM_MONTH_MIN_PRODUCTS} and at most ${CUSTOM_MONTH_MAX_PRODUCTS} products, and no more carousels than products.`,
  opslaan: 'We could not record your request. Try again, or email hello@visuails.com.',
  mollie: 'The payment screen did not open. Nothing has been charged. Try again, or email hello@visuails.com.',
};
const foutTekst = FOUTEN[fout] || '';

/*
 * ── DE FOUTMELDING WERD NOOIT GETOOND, 18 augustus 2026 ────────────────────
 *
 * astro.config.mjs zegt `output: 'static'`. Deze pagina wordt dus ÉÉN keer
 * gebouwd, en `Astro.url` is op dat moment de bouw-URL zonder querystring.
 * `fout` was daarmee altijd leeg en `{foutTekst && ...}` heeft nog nooit iets
 * gerenderd — op geen enkele bezoeker, in geen van beide talen.
 *
 * Wat daar achter wegviel is niet klein. subscribe.js stuurt hier vijf redenen
 * heen, en drie ervan gaan over geld:
 *
 *   · vol      — de agenda zit vol voor dit plan deze maand;
 *   · mollie   — het betaalscherm ging niet open, er is niets afgeschreven;
 *   · opslaan  — we konden de aanvraag niet vastleggen.
 *
 * Wat de klant zag was: klik op "Doorgaan naar de machtiging", even niets, en
 * dan hetzelfde formulier terug. Geen zin, geen reden, geen bevestiging dat er
 * niets is afgeschreven. De kop van handleSubscribeStart() zegt letterlijk dat
 * een technische fout hier een zin hoort te zijn; die zin bestond, hij kwam
 * alleen nooit op het scherm.
 *
 * ── WAAROM DIT MET EEN SCRIPT MOET EN NIET ANDERS ─────────────────────────
 *
 * De pagina statisch houden is de bedoeling — zie de kop van dit bestand: geen
 * prijsberekening in de browser, gewone POST, alles opnieuw gecontroleerd op de
 * server. Een SSR-route hiervan maken om één zin te tonen, is de hele stroom
 * verbouwen voor het uitzonderingsgeval.
 *
 * Dus: alle vijf de zinnen staan al in de HTML, elk verborgen en elk met zijn
 * eigen sleutel. Het script zet er hoogstens één aan.
 *
 * ── EN HET ECHOT DE URL NIET ──────────────────────────────────────────────
 *
 * Het voor de hand liggende script leest ?fout= en schrijft de waarde in de
 * pagina. Dat is een reflected-XSS met extra stappen. Hier wordt de parameter
 * alleen gebruikt om een element OP TE ZOEKEN dat wij zelf hebben gerenderd:
 * staat er geen element met die sleutel, dan gebeurt er niets. Er gaat geen
 * enkel teken uit de URL de DOM in.
 */
const FOUT_IDS = Object.keys(FOUTEN);

/* ── HERONTWERP, 4 SEPTEMBER 2026 ────────────────────────────────────────────
 *
 * Lucas: *"het abonnement ziet er op het moment super saai en niet waardevol
 * uit, dit mag je volledig aanpassen."*
 *
 * Wat er stond: vier grijze vakken onder elkaar met een radio, drie regels
 * uitleg per vak en zes bedragen; daaronder nog drie vakken en een alinea over
 * de machtiging. Alles even zwaar, niets dat zei wat je KRIJGT. Het duurste
 * formulier van de site zag eruit als een enquête.
 *
 * Wat er nu staat: links de drie keuzes als korte stappen (welk plan, welke
 * termijn, welke week), rechts één plaat in de accentkleur — dezelfde plaat als
 * op /plans en de homepage — die per keuze laat zien wat de maand oplevert:
 * hoeveel beelden, wat het los zou kosten, wat er nu gebeurt, en de knop.
 *
 * ── NOG STEEDS ZONDER SCRIPT ───────────────────────────────────────────────
 *
 * De plaat wisselt mee met de radio's via `:has()` in CSS: alle zeven varianten
 * (drie plannen × twee termijnen, plus de maand op maat) staan in de HTML en er
 * is er precies één zichtbaar. Geen rekenwerk in de browser — de bedragen
 * komen uit plans.js en pricing.js bij het bouwen, zoals hiervoor. Een browser
 * zonder `:has()` (2022 en ouder) ziet alle varianten onder elkaar; dat is
 * lelijker, niet fout. */
const CHECK = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>';

type Regel = { t: string; sub?: string };
type Variant = {
  plan: string; term: string; naam: string; kop: string;
  bedrag: string; eenheid: string; per?: string;
  regels: Regel[]; los?: string; bespaar?: string;
};

const kopVan = (id: string) => ({
  starter: nl ? 'Elke maand iets nieuws.' : 'Something new every month.',
  studio: nl ? 'Elke week iets te posten.' : 'Something to post every week.',
  brand: nl ? 'Je hele collectie, met je eigen gezicht.' : 'Your whole collection, with your own face.',
}[id] || '');

const varianten: Variant[] = [];
for (const p of planList) {
  for (const t of TERM_IDS) {
    const n = productsFor(p.id);
    const k = clipsFor(p.id);
    const cents = monthlyCents(p.id, t);
    const tt = termOf(t);
    const besp = planSaving(p.id);
    const beelden = n * COMPLETE_IMAGES;
    const regels: Regel[] = [
      { t: nl ? `${n} producten` : `${n} products`,
        sub: nl
          ? `elk een catalogset van ${CATALOG_IMAGES} en een lifestyle-carrousel van ${LIFESTYLE_IMAGES} — ${beelden} afgemaakte beelden`
          : `each a ${CATALOG_IMAGES}-image catalog set and a ${LIFESTYLE_IMAGES}-image lifestyle carousel — ${beelden} finished images` },
      ...(k ? [{ t: nl ? `${k} motion-clips` : `${k} motion clips`, sub: nl ? 'het product in beweging, 8 seconden' : 'the product in motion, 8 seconds' }] : []),
      ...(hasBrandModel(p.id, t) ? [{ t: nl ? 'Je eigen merkmodel' : 'Your own brand model', sub: nl ? 'één gezicht, alleen voor jouw merk' : 'one face, for your brand only' }] : []),
      { t: nl ? 'Een vaste week' : 'A fixed week',
        sub: nl
          ? (tt.perks.includes('standingWindow') ? 'dezelfde dagen, elke maand, vóór iedereen vrijgehouden' : 'elke maand voor jou gereserveerd vóór andere bestellingen')
          : (tt.perks.includes('standingWindow') ? 'the same days every month, held before anyone else' : 'reserved for you every month before other orders') },
      { t: nl ? `Ongebruikt schuift ${tt.rollover} ${tt.rollover === 1 ? 'maand' : 'maanden'} door` : `Unused rolls over ${tt.rollover} month${tt.rollover === 1 ? '' : 's'}` },
      ...(tt.perks.includes('priceLock') ? [{ t: nl ? 'Prijsslot' : 'Price lock', sub: nl ? 'gaat het tarief omhoog, dan blijft het jouwe staan' : 'if the rate goes up, yours stays' }] : []),
      { t: tt.fixed
          ? (nl ? `Looptijd ${tt.months} maanden` : `${tt.months}-month term`)
          : (nl ? 'Maandelijks opzegbaar' : 'Cancel any month'),
        sub: tt.fixed ? undefined : (nl ? 'zelf, in je dashboard' : 'yourself, in your dashboard') },
    ];
    varianten.push({
      plan: p.id, term: t, naam: planName(p.id, lang), kop: kopVan(p.id),
      bedrag: euro(cents / 100, lang),
      eenheid: nl ? 'per maand' : 'per month',
      per: tt.fixed && cents !== monthlyCents(p.id, 'monthly')
        ? (nl ? `op de jaartermijn — ${euro(monthlyCents(p.id, 'monthly') / 100, lang)} maandelijks` : `on the 12-month term — ${euro(monthlyCents(p.id, 'monthly') / 100, lang)} monthly`)
        : undefined,
      regels,
      los: besp ? (nl ? `Los besteld: ${euro(besp.onLadder, lang)} per maand.` : `Ordered one-off: ${euro(besp.onLadder, lang)} a month.`) : undefined,
      bespaar: besp ? (nl ? `Je bespaart ${euro(besp.saving, lang)}` : `You save ${euro(besp.saving, lang)}`) : undefined,
    });
  }
}

/* De maand op maat heeft geen vast bedrag; hij volgt het laddertarief over jouw
   aantal. Drie voorbeelden zeggen meer dan de regel: wat vijf, tien en twintig
   producten mét carrousel kosten, uitgerekend met dezelfde functie als de
   server gebruikt. */
const maatVanaf = euro(customMonthTotal({ products: CUSTOM_MONTH_MIN_PRODUCTS }).total, lang);
const maatVoorbeelden = [CUSTOM_MONTH_MIN_PRODUCTS, 10, 20].map((n) => {
  const r = customMonthTotal({ products: n, carousels: n });
  return { n, bedrag: euro(r.total, lang), beelden: r.images };
});

const c = nl ? {
  h: 'Je abonnement',
  lede: 'Kies hoeveel je elke maand wilt laten maken. Rechts zie je meteen wat die maand oplevert.',
  stap1: 'Welk abonnement',
  stap2: 'Welke termijn',
  stap3: 'Je vaste week',
  perMaand: '/ mnd',
  producten: 'producten',
  clips: 'clips',
  merkmodel: 'merkmodel',
  maatNaam: 'Maand op maat',
  maatLine: `Stel zelf samen, vanaf ${CUSTOM_MONTH_MIN_PRODUCTS} producten.`,
  maatFacts: 'laddertarief over jouw aantal',
  maatProducten: 'Producten per maand',
  maatCarrousels: 'Daarvan met lifestyle-carrousel',
  maatClips: 'Motion-clips per maand',
  maatHint: `Je betaalt het gewone laddertarief over jouw aantal — dezelfde prijs per product als bij een losse bestelling van die omvang; een carrousel kost er ${euro(addOnRate(CUSTOM_MONTH_MIN_PRODUCTS), 'nl')} tot ${euro(addOnRate(20), 'nl')} bovenop. Nooit meer carrousels dan producten. Een maand op maat loopt altijd maandelijks.`,
  maatCustomH: 'Wil je een eigen look erin?',
  maatCustomBody: 'Een eigen look of je eigen merkmodel kan wél in een abonnement — maar niet via dit formulier. Zo’n look moet eerst worden opgezet, anders betaal je vanaf de eerste maand voor iets dat nog niet bestaat. Vraag hem aan via /start/custom-look; zodra hij klaar is, staat hij als tegel in je account en in het bestelformulier, ook binnen je maand.',
  maatCustomCta: 'Neem contact op',
  termMaand: 'Maandelijks',
  termMaandSub: 'Elke maand opzegbaar, in je dashboard.',
  termJaar: '12 maanden',
  termJaarSub: 'Vaste looptijd. Daarvoor terug: een staande week, drie maanden doorschuiven, een prijsslot, en het merkmodel ook op Studio. Op Starter bovendien goedkoper per maand.',
  termMaat: 'Een maand op maat loopt altijd maandelijks.',
  weekHint: 'De dag van de maand waarop wij aan jouw producten beginnen. Elke maand dezelfde; je kunt hem later wijzigen.',
  weekNote: 'Wij reserveren die week in de planning voor jou, elke maand opnieuw, vóórdat er andere bestellingen in mogen. Heb je die maand niets klaarstaan, dan vervalt de week niet: je producten schuiven door. Je kunt de dag altijd wijzigen in je dashboard.',
  weekLabel: 'Dag van de maand',
  sumLabel: 'Jouw maand',
  sumElke: 'Elke maand',
  sumMaatH: 'Wat een maand op maat kost',
  sumMaatSub: `Het bedrag volgt jouw aantal en staat op het scherm na de machtiging. Drie voorbeelden, elk product met carrousel:`,
  sumMaatBeelden: 'beelden',
  nuH: 'Wat er nu gebeurt',
  nu: [
    'Je betaalt je eerste maand via Mollie. Met die betaling geeft je bank ook de machtiging af voor de maanden erna.',
    'Je vaste week staat meteen gepland en je saldo staat klaar.',
    'Je uploadt je producten in VISUAILS Studio; wij maken ze in jouw week.',
  ],
  mandateNote: 'Een machtiging is de toestemming die je bank nodig heeft om ons maandelijks te laten incasseren — een SEPA-incasso, dezelfde vorm als bij een energieleverancier. Je geeft hem één keer af en je kunt hem altijd intrekken. De betaling van je eerste maand is de transactie waarmee je bank hem uitgeeft.',
  submit: 'Doorgaan naar de machtiging',
  cancelNote: 'Opzeggen kan zelf, in je dashboard. Wat je hebt laten maken, blijft van jou.',
  signedOut: `Je moet ingelogd zijn om een abonnement af te sluiten. Heb je nog nooit bij ons besteld, probeer VISUAILS dan eerst voor ${euro(AMOUNT.testSample, 'nl')} — dan weet je wat je koopt.`,
  signIn: 'Inloggen',
  sample: `Eerst proberen · ${euro(AMOUNT.testSample, 'nl')}`,
} : {
  h: 'Your plan',
  lede: 'Choose how much you want made every month. On the right you see straight away what that month delivers.',
  stap1: 'Which plan',
  stap2: 'Which term',
  stap3: 'Your fixed week',
  perMaand: '/ mo',
  producten: 'products',
  clips: 'clips',
  merkmodel: 'brand model',
  maatNaam: 'Custom month',
  maatLine: `Compose it yourself, from ${CUSTOM_MONTH_MIN_PRODUCTS} products.`,
  maatFacts: 'ladder rate for your volume',
  maatProducten: 'Products a month',
  maatCarrousels: 'Of those, with a lifestyle carousel',
  maatClips: 'Motion clips a month',
  maatHint: `You pay the ordinary ladder rate for your volume — the same per-product price a one-off order of that size costs; a carousel adds ${euro(addOnRate(CUSTOM_MONTH_MIN_PRODUCTS), 'en')} to ${euro(addOnRate(20), 'en')} on top. Never more carousels than products. A custom month always runs monthly.`,
  maatCustomH: 'Want your own look in it?',
  maatCustomBody: 'A look of your own, or your own brand model, can go into a plan — but not through this form. That look has to be set up first, otherwise you are paying from month one for something that does not exist yet. Request it via /start/custom-look; once it is ready, it appears as a tile in your account and in the order form, also within your month.',
  maatCustomCta: 'Get in touch',
  termMaand: 'Monthly',
  termMaandSub: 'Cancel any month, in your dashboard.',
  termJaar: '12 months',
  termJaarSub: 'A fixed term. In return: a standing week, three months of rollover, a price lock, and the brand model on Studio too. On Starter also cheaper per month.',
  termMaat: 'A custom month always runs monthly.',
  weekHint: 'The day of the month we start on your products. The same every month; you can change it later.',
  weekNote: 'We reserve that week in the calendar for you, every month, before any other order can take it. If you have nothing ready that month the week is not lost: your products roll over. You can change the day at any time in your dashboard.',
  weekLabel: 'Day of the month',
  sumLabel: 'Your month',
  sumElke: 'Every month',
  sumMaatH: 'What a custom month costs',
  sumMaatSub: 'The amount follows your numbers and is shown after the mandate. Three examples, every product with a carousel:',
  sumMaatBeelden: 'images',
  nuH: 'What happens next',
  nu: [
    'You pay your first month through Mollie. That same payment makes your bank issue the mandate for the months after it.',
    'Your fixed week is planned straight away and your credits are ready.',
    'You upload your products in VISUAILS Studio; we make them in your week.',
  ],
  mandateNote: 'A mandate is the permission your bank needs to let us collect monthly — a SEPA direct debit, the same shape as an energy supplier uses. You give it once and you can withdraw it at any time. Paying your first month is the transaction that makes your bank issue it.',
  submit: 'Continue to the mandate',
  cancelNote: 'You can cancel yourself, in your dashboard. Whatever you had made stays yours.',
  signedOut: `You need to be signed in to start a plan. Never ordered from us? Start with a ${euro(AMOUNT.testSample, 'en')} sample so you know what you are buying.`,
  signIn: 'Sign in',
  sample: 'Try a sample first',
};

const termijnen = TERM_IDS.map((id) => ({ id, naam: TERMS[id].name[nl ? 'nl' : 'en'], maanden: TERMS[id].months }));

/* Wat op de kaart staat: naam, maandbedrag en één regel feiten. De jaarprijs
   staat er alleen als hij afwijkt — bij precies één plan (zie discountMonths in
   plans.js); twee keer hetzelfde bedrag laat de jaartermijn zinloos lijken. */
const kaarten = planList.map((p) => {
  const n = productsFor(p.id);
  const k = clipsFor(p.id);
  const maand = monthlyCents(p.id, 'monthly');
  const jaar = monthlyCents(p.id, 'yearly');
  return {
    id: p.id,
    naam: planName(p.id, lang),
    line: p.line,
    bedrag: euro(maand / 100, lang),
    jaar: jaar !== maand ? (nl ? `${euro(jaar / 100, lang)} op de jaartermijn` : `${euro(jaar / 100, lang)} on the 12-month term`) : null,
    facts: [
      `${n} ${c.producten}`,
      ...(k ? [`${k} ${c.clips}`] : []),
      ...(hasBrandModel(p.id, 'monthly') ? [c.merkmodel] : []),
    ].join(' · '),
  };
});
---

<section class="wrap plan-start">
  <div class="container">
    <header class="ps-head">
      <h1>{c.h}</h1>
      <p class="lede">{c.lede}</p>
    </header>

    {/* foutTekst blijft staan voor het geval deze pagina ooit wél per verzoek
        gerenderd wordt; dan wint de server en heeft het script niets te doen.
        Vandaag is hij altijd leeg — zie de noot hierboven. */}
    {foutTekst && <p class="error" role="alert">{foutTekst}</p>}

    <div class="plan-fouten" data-plan-fouten>
      {FOUT_IDS.map((id) => (
        <p class="error" data-plan-fout={id} hidden>{FOUTEN[id]}</p>
      ))}
    </div>

    <form method="post" action="/account/plan/start" class="plan-form">
      <input type="hidden" name="lang" value={lang} />

      <div class="ps-grid">
        <div class="ps-keuzes">

          {/* ── 1 · HET PLAN ─────────────────────────────────────────────── */}
          <fieldset class="ps-set">
            <legend><span class="ps-n">1</span>{c.stap1}</legend>
            <div class="ps-plans">
              {kaarten.map((k, i) => (
                <label class="ps-plan">
                  <input type="radio" name="plan" value={k.id} required checked={i === 1} />
                  <span class="ps-plan-top">
                    <strong class="ps-plan-naam">{k.naam}</strong>
                    <span class="ps-plan-prijs"><b>{k.bedrag}</b><small>{c.perMaand}</small></span>
                  </span>
                  <span class="ps-plan-line">{k.line}</span>
                  <span class="ps-plan-facts">{k.facts}</span>
                  {k.jaar && <span class="ps-plan-jaar">{k.jaar}</span>}
                </label>
              ))}

              {/* ── DE VIERDE OPTIE — 1 september 2026 ──────────────────────
                  Een radio zoals de andere drie; de drie velden staan eronder en
                  verschijnen zodra hij aanstaat. De prijs staat er niet als
                  bedrag — de server rekent hem uit en hij staat op het scherm
                  ná de machtiging; de plaat rechts geeft drie voorbeelden.
                  `min`, `max` en `required` zijn geen validatie: die staat in
                  handleSubscribeStart() en is de enige die telt. */}
              <label class="ps-plan ps-maat">
                <input type="radio" name="plan" value={CUSTOM_MONTH_ID} />
                <span class="ps-plan-top">
                  <strong class="ps-plan-naam">{c.maatNaam}</strong>
                  <span class="ps-plan-prijs"><small>{nl ? 'vanaf' : 'from'}</small> <b>{maatVanaf}</b><small>{c.perMaand}</small></span>
                </span>
                <span class="ps-plan-line">{c.maatLine}</span>
                <span class="ps-plan-facts">{c.maatFacts}</span>
              </label>
            </div>

            <div class="maat-velden">
              <span class="maat-veld">
                <label for="maat-producten">{c.maatProducten}</label>
                <input id="maat-producten" type="number" name="producten" inputmode="numeric"
                       min={CUSTOM_MONTH_MIN_PRODUCTS} max={CUSTOM_MONTH_MAX_PRODUCTS}
                       step="1" placeholder={String(CUSTOM_MONTH_MIN_PRODUCTS)} />
              </span>
              <span class="maat-veld">
                <label for="maat-carrousels">{c.maatCarrousels}</label>
                <input id="maat-carrousels" type="number" name="carrousels" inputmode="numeric"
                       min="0" max={CUSTOM_MONTH_MAX_PRODUCTS} step="1" placeholder="0" />
              </span>
              <span class="maat-veld">
                <label for="maat-clips">{c.maatClips}</label>
                <input id="maat-clips" type="number" name="clips" inputmode="numeric"
                       min="0" max={CUSTOM_MONTH_MAX_PRODUCTS} step="1" placeholder="0" />
              </span>
              <p class="maat-hint">{c.maatHint}</p>
            </div>

            {/* ── DE POORT VOOR ALLES WAT EERST OPGEZET MOET WORDEN ──────────
                Lucas, 1 september 2026: een eigen look in het abonnement kan,
                maar vereist opzetting — anders betaal je al terwijl die stijl
                nog niet bestaat. Geen veld dat het aanbiedt en daarna weigert;
                één uitklapregel die zegt dat het KAN en langs welke weg. */}
            <details class="ps-look">
              <summary>{c.maatCustomH}</summary>
              <p>{c.maatCustomBody}</p>
              <p><a class="btn btn-ghost btn-sm" href={lp('/contact')}>{c.maatCustomCta}</a></p>
            </details>
          </fieldset>

          {/* ── 2 · DE TERMIJN ─────────────────────────────────────────────
              De jaarvorm maakt maar één plan goedkoper (discountMonths in
              plans.js); wat hij bij de andere twee geeft, staat in de regel
              onder de keuze en op de plaat rechts. */}
          <fieldset class="ps-set">
            <legend><span class="ps-n">2</span>{c.stap2}</legend>
            <div class="ps-terms">
              {termijnen.map((t, i) => (
                <label class="ps-term">
                  <input type="radio" name="term" value={t.id} required checked={i === 0} />
                  <span class="ps-term-naam">{t.id === 'yearly' ? c.termJaar : c.termMaand}</span>
                  <span class="ps-term-sub">{t.id === 'yearly' ? c.termJaarSub : c.termMaandSub}</span>
                </label>
              ))}
            </div>
            <p class="ps-term-maat">{c.termMaat}</p>
          </fieldset>

          {/* ── 3 · DE WEEK ────────────────────────────────────────────────── */}
          <fieldset class="ps-set">
            <legend><span class="ps-n">3</span>{c.stap3} <Note lang={lang} term={nl ? 'je vaste week' : 'your fixed week'}>{c.weekNote}</Note></legend>
            <p class="ps-hint">{c.weekHint}</p>
            <label class="plan-day">
              <span>{c.weekLabel}</span>
              {/* 1 tot 28 en niet 1 tot 31, om dezelfde reden als window_day in
                  migratie 0030: februari mag geen uitzondering worden. */}
              <select name="window_day">
                {Array.from({ length: 28 }, (_, i) => i + 1).map((d) => (
                  <option value={d} selected={d === 8}>{d}</option>
                ))}
              </select>
            </label>
          </fieldset>
        </div>

        {/* ── DE PLAAT: WAT DEZE MAAND OPLEVERT ───────────────────────────────
            Dezelfde `.lime-plate.plaat-vol` als op /plans en de homepage. Eén
            variant per plan-en-termijn; CSS onderaan zet er één aan. */}
        <aside class="ps-sum lime-plate plaat-vol">
          <p class="ps-sum-label">{c.sumLabel}</p>

          {varianten.map((v) => (
            <div class="ps-sumv" data-plan={v.plan} data-term={v.term}>
              <h2 class="ps-sum-naam">{v.naam}</h2>
              <p class="ps-sum-kop">{v.kop}</p>
              <div class="bedrag ps-bedrag">
                <span class="bedrag-cijfer">{v.bedrag}</span>
                <span class="bedrag-eenheid">{v.eenheid}{v.per ? ` — ${v.per}` : ''} · {vatLabel('excl', lang)}</span>
              </div>
              <p class="ps-sum-h">{c.sumElke}</p>
              <ul class="ps-sum-list">
                {v.regels.map((r) => (
                  <li><span class="ps-sum-i" set:html={CHECK} /><span><b>{r.t}</b>{r.sub ? <span class="ps-sum-sub"> — {r.sub}</span> : null}</span></li>
                ))}
              </ul>
              {v.los && (
                <p class="ps-sum-los"><span>{v.los}</span> <b>{v.bespaar}</b></p>
              )}
            </div>
          ))}

          <div class="ps-sumv" data-plan={CUSTOM_MONTH_ID} data-term="monthly">
            <h2 class="ps-sum-naam">{c.maatNaam}</h2>
            <p class="ps-sum-kop">{c.maatLine}</p>
            <p class="ps-sum-h">{c.sumMaatH}</p>
            <p class="ps-sum-maatsub">{c.sumMaatSub}</p>
            <ul class="ps-sum-vb">
              {maatVoorbeelden.map((m) => (
                <li>
                  <span class="ps-vb-n">{m.n} {c.producten}</span>
                  <span class="ps-vb-b">{m.bedrag}<small> {c.perMaand}</small></span>
                  <span class="ps-vb-i">{m.beelden} {c.sumMaatBeelden}</span>
                </li>
              ))}
            </ul>
            <p class="ps-sum-sub">{c.termMaat}</p>
          </div>

          <div class="ps-nu">
            <p class="ps-sum-h">{c.nuH} <Note lang={lang} term={nl ? 'machtiging' : 'mandate'}>{c.mandateNote}</Note></p>
            <ol class="ps-nu-list">
              {c.nu.map((z) => <li>{z}</li>)}
            </ol>
          </div>

          <button class="btn btn-primary btn-lg btn-block" type="submit">{c.submit}</button>
          <p class="ps-sum-meta">{c.cancelNote}</p>
        </aside>
      </div>
    </form>

    {/* Alleen voor wie uitgelogd is — Layout.astro zet [data-acct]-blokken aan of
        uit na één /account/me. Geen `hidden` in de markup: zonder script blijft
        de uitleg staan, en dat is hier de goede kant — zie de noot van 18
        augustus 2026 in de geschiedenis van dit bestand. */}
    <div class="plan-signedout" data-acct="out">
      <p>{c.signedOut}</p>
      <p>
        <a class="btn btn-ghost" href={`/account/login?lang=${lang}`}>{c.signIn}</a>
        <a class="btn btn-ghost" href={lp('/test-sample')}>{c.sample}</a>
      </p>
    </div>
  </div>
</section>

<script is:inline data-astro-rerun>
  /* ── `data-astro-rerun`, OM DEZELFDE REDEN ALS IN HomeV2.astro ─────────────
     Astro voert een inline script bij een zachte navigatie maar één keer uit:
     de eerste keer dat de router hem tegenkomt. Zonder dit attribuut werkt alles
     hieronder dus precies één keer per bezoek.
     
     Dat is hier niet cosmetisch. Wie op /plans op de Merk-kaart klikt, komt via
     een zachte navigatie op /start/plan?plan=brand — en het aanvinken van het
     juiste plan gebeurt hieronder. Draait dit niet, dan staat Studio (€ 790)
     aangevinkt terwijl de bezoeker net op Merk (€ 1.690) heeft geklikt, op een
     formulier dat eindigt in een doorlopende machtiging. De noot bij "HET PLAN
     UIT DE URL" verderop beschrijft precies die fout; hij was gerepareerd voor
     de eerste klik en niet voor de tweede.

     Hier hoeft niets opgeruimd te worden: dit blok zet alleen iets in de opmaak
     en laat geen timer of luisteraar achter. */
  /* Zie de lange noot in de frontmatter. Eén ding: zoek het blok op dat bij de
     reden in de URL hoort, en zet het aan. `role="alert"` staat al in de markup,
     maar een alert die er bij het laden al staat wordt door schermlezers niet
     aangekondigd — vandaar dat hij hier pas zichtbaar wordt, en dat de focus
     erheen gaat zodat toetsenbord en schermlezer bij de zin uitkomen in plaats
     van bovenaan een formulier dat ze net hebben ingevuld. */
  (function () {
    var reden = new URLSearchParams(location.search).get('fout');
    if (!reden) return;
    /* Selector-injectie is hier net zo goed injectie: een reden als "a],[b" zou
       anders elk foutblok tegelijk aanzetten. Alleen letters, en verder niets. */
    if (!/^[a-z]+$/.test(reden)) return;
    var el = document.querySelector('[data-plan-fout="' + reden + '"]');
    if (!el) return;
    el.hidden = false;
    el.setAttribute('tabindex', '-1');
    el.focus();
  })();

  /* ── HET PLAN UIT DE URL ───────────────────────────────────────────────────
   *
   * De drie kaarten op /pricing wezen alle drie naar dezelfde kale URL, en
   * hierboven staat Studio standaard aan. Wie op de Merk-kaart klikte, koos
   * dus €1.690 en kreeg €790 aangevinkt — op een formulier dat eindigt in een
   * doorlopende machtiging. Zie de noot bij de knop in PricingPage.astro.
   *
   * Dezelfde discipline als bij de foutmelding hierboven: de waarde uit de URL
   * gaat nergens de pagina in. Hij wordt gefilterd op letters en daarna alleen
   * gebruikt om een radio op te zoeken die wij zelf hebben gerenderd — bestaat
   * hij niet, dan blijft staan wat er stond. `term` gaat mee omdat de knop hem
   * ooit mee kan geven en dan hetzelfde hoort te doen.
   *
   * GEEN `change`-event. Er hangt geen script aan deze radio's — de bedragen
   * staan alle zes uitgeschreven, juist omdat er niets te herberekenen valt. */
  (function () {
    var qs = new URLSearchParams(location.search);
    ['plan', 'term'].forEach(function (veld) {
      var waarde = qs.get(veld);
      if (!waarde || !/^[a-z]+$/.test(waarde)) return;
      var radio = document.querySelector(
        'input[name="' + veld + '"][value="' + waarde + '"]'
      );
      if (radio) radio.checked = true;
    });
  })();
</script>

<style>
  .plan-fouten:empty { display: none; }
  .plan-start h1 { font-size: var(--t-page-h1); }
  .plan-start { padding-block: clamp(2.75rem, 5vw, 4.5rem); }
  .ps-head .lede { max-width: 58ch; }

  /* ── HET RASTER: KEUZES LINKS, DE PLAAT RECHTS ─────────────────────────────
     De plaat plakt mee bij het scrollen zodat de keuze en het gevolg naast
     elkaar blijven staan. Onder 60rem één kolom, de plaat onder de keuzes en
     niet plakkend: op een telefoon zou een plakkende plaat het halve scherm
     opeten. */
  .plan-form { margin-top: clamp(1.6rem, 3vw, 2.4rem); }
  .ps-grid { display: grid; grid-template-columns: minmax(0, 7fr) minmax(20rem, 5fr); gap: clamp(1.6rem, 3.5vw, 3.4rem); align-items: start; }
  .ps-keuzes { display: grid; gap: clamp(1.8rem, 3.2vw, 2.6rem); min-width: 0; }
  .ps-sum { position: sticky; top: 5.5rem; }
  @media (max-width: 60rem) {
    .ps-grid { grid-template-columns: 1fr; }
    .ps-sum { position: static; }
  }

  .ps-set { border: 0; padding: 0; margin: 0; display: grid; gap: .8rem; min-width: 0; }
  .ps-set legend {
    padding: 0; margin-bottom: .4rem;
    display: flex; align-items: center; gap: .6rem;
    font-family: var(--font-heading); font-weight: 800; font-size: 1.35rem; letter-spacing: -0.01em; color: var(--ink);
  }
  .ps-n {
    display: inline-grid; place-items: center; width: 1.6rem; height: 1.6rem;
    border-radius: 50%; border: 1px solid var(--line-strong);
    font-family: var(--font-body, inherit); font-size: .8rem; font-weight: 700; color: var(--ink-3);
  }
  .ps-hint { color: var(--ink-3); font-size: .9rem; margin: 0; max-width: 60ch; }

  /* ── DE PLANKAARTEN: TWEE NAAST ELKAAR ─────────────────────────────────────
     De radio is er nog (toetsenbord, formulier) maar tekent niet mee; de kaart
     zelf licht op. `:has()` en geen span-truc — dezelfde aanpak als de
     stijlkiezer. */
  .ps-plans { display: grid; grid-template-columns: 1fr 1fr; gap: .8rem; }
  @media (max-width: 34rem) { .ps-plans { grid-template-columns: 1fr; } }
  .ps-plan {
    position: relative; display: grid; gap: .35rem; align-content: start;
    padding: 1.1rem 1.2rem 1.15rem;
    border: 1px solid var(--line); border-radius: var(--r-lg);
    background: var(--paper-2); cursor: pointer;
    transition: border-color .15s ease, background-color .15s ease;
  }
  .ps-plan input { position: absolute; inset: 0; width: 100%; height: 100%; margin: 0; opacity: 0; cursor: pointer; }
  .ps-plan:hover { border-color: var(--line-strong); }
  .ps-plan:has(input:checked) { border-color: var(--accent); background: rgb(198 241 0 / 0.06); }
  .ps-plan:has(input:focus-visible) { outline: 2px solid var(--accent); outline-offset: 2px; }
  .ps-plan-top { display: flex; align-items: baseline; justify-content: space-between; gap: .6rem; }
  .ps-plan-naam { font-family: var(--font-heading); font-weight: 800; font-size: 1.35rem; letter-spacing: -0.01em; color: var(--ink); }
  .ps-plan-prijs { white-space: nowrap; font-variant-numeric: tabular-nums; }
  .ps-plan-prijs b { font-weight: 800; font-size: 1.1rem; color: var(--ink); }
  .ps-plan-prijs small { margin-left: .2rem; font-size: .8rem; color: var(--ink-3); }
  .ps-plan-line { color: var(--ink-2); font-size: .93rem; line-height: 1.5; }
  .ps-plan-facts { font-size: .82rem; color: var(--ink-3); }
  .ps-plan-jaar { font-size: .78rem; color: var(--accent-bright, var(--accent)); }
  /* Het vinkje van de gekozen kaart: een stip in de accentkleur, rechtsboven. */
  .ps-plan::after {
    content: ''; position: absolute; top: .9rem; right: .95rem; width: .55rem; height: .55rem;
    border-radius: 50%; background: var(--accent); opacity: 0; transition: opacity .15s ease;
  }
  .ps-plan:has(input:checked)::after { opacity: 1; }
  .ps-plan:has(input:checked) .ps-plan-top { padding-right: 1rem; }

  /* ── DE MAAND OP MAAT: DE VELDEN PAS ALS HIJ AANSTAAT ──────────────────────
     Ze staan in de HTML (een formulier zonder script kan ze niet wegnemen) en
     worden getoond zodra de vierde radio aan is. Zonder `:has()` staan ze er
     gewoon altijd. */
  .maat-velden {
    flex-wrap: wrap; gap: .8rem 1rem;
    padding: 1rem 1.2rem; border: 1px solid var(--line); border-radius: var(--r-lg); background: var(--paper-2);
  }
  @supports selector(:has(input)) {
    .maat-velden { display: none; }
  }
  @supports not selector(:has(input)) {
    .maat-velden { display: flex; }
  }
  .plan-form:has(input[name="plan"][value="maat"]:checked) .maat-velden { display: flex; }
  .maat-veld { display: grid; gap: .3rem; flex: 1 1 10rem; }
  .maat-veld label { font-size: .74rem; letter-spacing: .04em; text-transform: uppercase; color: var(--ink-3); }
  .maat-veld input[type="number"] {
    width: 100%; padding: .6rem .9rem;
    border-radius: var(--r-md); border: 1px solid var(--line-strong);
    background: var(--paper); color: inherit; font: inherit;
  }
  .maat-veld input[type="number"]::placeholder { color: var(--ink-4); }
  .maat-veld input[type="number"]:focus-visible { border-color: var(--accent); outline: none; }
  .maat-hint { flex: 1 1 100%; margin: .2rem 0 0; font-size: .84rem; line-height: 1.55; color: var(--ink-3); }

  .ps-look { margin-top: .2rem; }
  .ps-look > summary { cursor: pointer; font-size: .9rem; color: var(--ink-3); list-style: none; text-decoration: underline; text-underline-offset: 3px; }
  .ps-look > summary::-webkit-details-marker { display: none; }
  .ps-look > summary:hover { color: var(--ink); }
  .ps-look p { margin: .7rem 0 0; font-size: .92rem; line-height: 1.6; color: var(--ink-2); max-width: 64ch; }

  /* ── DE TERMIJN: TWEE KEUZES NAAST ELKAAR ─────────────────────────────── */
  .ps-terms { display: grid; grid-template-columns: 1fr 1fr; gap: .8rem; }
  @media (max-width: 34rem) { .ps-terms { grid-template-columns: 1fr; } }
  .ps-term {
    position: relative; display: grid; gap: .3rem; align-content: start;
    padding: 1rem 1.2rem; border: 1px solid var(--line); border-radius: var(--r-lg); background: var(--paper-2); cursor: pointer;
    transition: border-color .15s ease, background-color .15s ease;
  }
  .ps-term input { position: absolute; inset: 0; width: 100%; height: 100%; margin: 0; opacity: 0; cursor: pointer; }
  .ps-term:hover { border-color: var(--line-strong); }
  .ps-term:has(input:checked) { border-color: var(--accent); background: rgb(198 241 0 / 0.06); }
  .ps-term:has(input:focus-visible) { outline: 2px solid var(--accent); outline-offset: 2px; }
  .ps-term-naam { font-weight: 800; color: var(--ink); }
  .ps-term-sub { font-size: .86rem; line-height: 1.5; color: var(--ink-3); }
  .ps-term-maat { display: none; margin: 0; font-size: .86rem; color: var(--ink-3); }
  .plan-form:has(input[name="plan"][value="maat"]:checked) .ps-terms { opacity: .45; }
  .plan-form:has(input[name="plan"][value="maat"]:checked) .ps-term-maat { display: block; }

  .plan-day { display: flex; align-items: center; gap: .8rem; flex-wrap: wrap; }
  .plan-day select {
    min-width: 7rem; padding: .6rem .9rem;
    border-radius: var(--r-md); border: 1px solid var(--line-strong);
    background: var(--paper-2); color: inherit; font: inherit;
  }

  /* ── DE PLAAT ──────────────────────────────────────────────────────────────
     Kleur en inkt komen van `.plaat-vol.lime-plate` in global.css; hier alleen
     de indeling. Eén variant zichtbaar, gekozen door de radio's. */
  .ps-sum { padding: clamp(1.4rem, 2.6vw, 2rem); border-radius: var(--r-lg); display: grid; gap: 1.1rem; }
  .ps-sum-label { margin: 0; font-size: .74rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--ink-3); }
  .ps-sumv { display: grid; gap: .9rem; }
  @supports selector(:has(input)) {
    .ps-sumv { display: none; }
    .plan-form:has([name="plan"][value="starter"]:checked):has([name="term"][value="monthly"]:checked) .ps-sumv[data-plan="starter"][data-term="monthly"],
    .plan-form:has([name="plan"][value="starter"]:checked):has([name="term"][value="yearly"]:checked)  .ps-sumv[data-plan="starter"][data-term="yearly"],
    .plan-form:has([name="plan"][value="studio"]:checked):has([name="term"][value="monthly"]:checked)  .ps-sumv[data-plan="studio"][data-term="monthly"],
    .plan-form:has([name="plan"][value="studio"]:checked):has([name="term"][value="yearly"]:checked)   .ps-sumv[data-plan="studio"][data-term="yearly"],
    .plan-form:has([name="plan"][value="brand"]:checked):has([name="term"][value="monthly"]:checked)   .ps-sumv[data-plan="brand"][data-term="monthly"],
    .plan-form:has([name="plan"][value="brand"]:checked):has([name="term"][value="yearly"]:checked)    .ps-sumv[data-plan="brand"][data-term="yearly"],
    .plan-form:has([name="plan"][value="maat"]:checked) .ps-sumv[data-plan="maat"] { display: grid; }
  }
  .ps-sum-naam { margin: 0; font-size: clamp(1.9rem, 3vw, 2.4rem); line-height: 1; }
  .ps-sum-kop { margin: -.4rem 0 0; font-size: 1rem; color: var(--ink-2); }
  .ps-bedrag { --bedrag-maat: clamp(2.4rem, 4.5vw, 3.2rem); gap: .2rem; }
  .ps-bedrag .bedrag-eenheid { font-size: .88rem; }
  .ps-sum-h { margin: .2rem 0 0; font-size: .74rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--ink-3); display: flex; align-items: center; gap: .4rem; }
  .ps-sum-list { list-style: none; margin: -.3rem 0 0; padding: 0; display: grid; gap: .5rem; }
  .ps-sum-list li { display: grid; grid-template-columns: 18px 1fr; gap: .6rem; font-size: .93rem; line-height: 1.5; color: var(--ink-2); }
  .ps-sum-list b { color: var(--ink); font-weight: 700; }
  .ps-sum-sub { color: var(--ink-3); }
  .ps-sum-i svg { width: 16px; height: 16px; margin-top: .25rem; fill: none; stroke: var(--ink); stroke-width: 2.4; }
  .ps-sum-los { margin: 0; padding-top: .9rem; border-top: 1px solid var(--line); font-size: .92rem; color: var(--ink-2); display: flex; flex-wrap: wrap; gap: .2rem .6rem; align-items: baseline; }
  .ps-sum-los b { color: var(--ink); font-size: 1rem; }
  .ps-sum-maatsub { margin: -.4rem 0 0; font-size: .9rem; line-height: 1.5; color: var(--ink-2); }
  .ps-sum-vb { list-style: none; margin: 0; padding: 0; display: grid; gap: .45rem; }
  .ps-sum-vb li { display: grid; grid-template-columns: 1fr auto; gap: .1rem .8rem; padding: .55rem 0; border-top: 1px solid var(--line); font-size: .92rem; }
  .ps-vb-n { color: var(--ink); font-weight: 700; }
  .ps-vb-b { text-align: right; font-weight: 800; color: var(--ink); font-variant-numeric: tabular-nums; }
  .ps-vb-b small { font-weight: 400; color: var(--ink-3); }
  .ps-vb-i { grid-column: 1 / -1; font-size: .82rem; color: var(--ink-3); }
  .ps-nu { padding-top: 1rem; border-top: 1px solid var(--line); display: grid; gap: .6rem; }
  .ps-nu-list { margin: 0; padding: 0 0 0 1.2rem; display: grid; gap: .4rem; font-size: .9rem; line-height: 1.5; color: var(--ink-2); }
  .ps-nu-list li::marker { font-weight: 800; color: var(--ink); }
  .ps-sum .btn-block { width: 100%; margin-top: .2rem; }
  .ps-sum-meta { margin: 0; font-size: .82rem; color: var(--ink-3); }

  .plan-signedout { margin-top: 2.5rem; padding-top: 1.5rem; border-top: 1px solid var(--line); color: var(--ink-3); max-width: 70ch; }
  .plan-signedout .btn { margin-right: .5rem; }
</style>
