---
// VISUAILS — /start/plan. De pagina waar een abonnement echt begint.
//
// WAT HIER STOND EN WAAROM HET WEG IS
// HoldingPage.astro, met de regel *"the plans are a minimum-term commitment.
// Both are conversations. A card form here would be the studio pretending a
// decision has been made that has not."* Dat was waar zolang er geen mandaat
// bestond en Lucas elke aanvraag met de hand omzette. Sinds 17 augustus 2026 is
// er een SEPA-machtiging via Mollie, een maandboekhouding en een dashboard — en
// dan is de pagina die zegt "dit kan nog niet" zelf het obstakel geworden.
//
// De brand-model- en videopagina houden HoldingPage; voor die twee klopt de
// redenering nog. Deze niet meer.
//
// ── GEEN JAVASCRIPT ────────────────────────────────────────────────────────
//
// Radio's en een <select>, en een gewone POST. Geen prijsberekening in de
// browser: de bedragen komen uit plans.js en staan al in de tekst. Wat de klant
// kiest, wordt op de server opnieuw gecontroleerd — PLAN_IDS en TERM_IDS in
// handleSubscribeStart(). Een keuze die alleen in de browser bestaat, is geen
// keuze maar een suggestie.
//
// ── WAAROM DE POST NAAR /account/plan/start GAAT ───────────────────────────
//
// Een abonnement hangt aan een klant, en accounts ontstaan in dit systeem alleen
// door te bestellen. De handler zit dus in account.js, achter de sessiecontrole:
// wie niet is ingelogd, komt op de inlogpagina en niet op een betaalscherm. Zie
// de kop van src/lib/subscribe.js voor waarom dat de goede kant op is.
/* MANDATE_AMOUNT en AMOUNT staan erbij omdat de teksten hieronder twee
   verschillende bedragen van één euro noemen: de MACHTIGING (de transactie
   waarmee de bank de incasso afgeeft) en de PROEFVISUAL (een product). Ze
   kostten allebei €1 en werden allebei als "€1" ingetypt, dus ze waren niet uit
   elkaar te houden — en dan verandert er bij een prijswijziging één te veel. */
import { plans, euro, vatLabel, AMOUNT, MANDATE_AMOUNT } from '../../data/pricing.js';
import { TERMS, TERM_IDS, monthlyCents, productsFor, clipsFor, hasBrandModel } from '../../data/plans.js';
import { planName } from '../../data/planNames.js';
import { localizedPath } from '../../i18n/ui.js';

import Note from '../Note.astro';
interface Props {
  lang: 'en' | 'nl';
}
const { lang } = Astro.props;
const nl = lang === 'nl';
const lp = (p: string) => localizedPath(lang, p);

const planList = plans(lang);

// De fout uit de vorige poging, als die er is. Eén zin per reden, en `vol` is de
// enige die niet over een vergissing gaat maar over capaciteit — zie de
// capaciteitspoort in handleSubscribeStart().
const fout = String(Astro.url.searchParams.get('fout') || '');
const FOUTEN: Record<string, string> = nl ? {
  plan: 'Kies eerst een abonnement.',
  termijn: 'Kies eerst een termijn.',
  vol: 'Er is deze maand geen plek meer voor dit abonnement. Mail hello@visuails.com — dan zetten we je op de lijst voor de eerstvolgende plek.',
  opslaan: 'We konden je aanvraag niet vastleggen. Probeer het opnieuw, of mail hello@visuails.com.',
  mollie: 'Het betaalscherm ging niet open. Er is niets afgeschreven. Probeer het opnieuw, of mail hello@visuails.com.',
} : {
  plan: 'Choose a plan first.',
  termijn: 'Choose a term first.',
  vol: 'There is no room for this plan this month. Email hello@visuails.com and we will put you on the list for the next opening.',
  opslaan: 'We could not record your request. Try again, or email hello@visuails.com.',
  mollie: 'The payment screen did not open. Nothing has been charged. Try again, or email hello@visuails.com.',
};
const foutTekst = FOUTEN[fout] || '';

/*
 * ── DE FOUTMELDING WERD NOOIT GETOOND, 18 augustus 2026 ────────────────────
 *
 * astro.config.mjs zegt `output: 'static'`. Deze pagina wordt dus ÉÉN keer
 * gebouwd, en `Astro.url` is op dat moment de bouw-URL zonder querystring.
 * `fout` was daarmee altijd leeg en `{foutTekst && ...}` heeft nog nooit iets
 * gerenderd — op geen enkele bezoeker, in geen van beide talen.
 *
 * Wat daar achter wegviel is niet klein. subscribe.js stuurt hier vijf redenen
 * heen, en drie ervan gaan over geld:
 *
 *   · vol      — de agenda zit vol voor dit plan deze maand;
 *   · mollie   — het betaalscherm ging niet open, er is niets afgeschreven;
 *   · opslaan  — we konden de aanvraag niet vastleggen.
 *
 * Wat de klant zag was: klik op "Doorgaan naar de machtiging", even niets, en
 * dan hetzelfde formulier terug. Geen zin, geen reden, geen bevestiging dat er
 * niets is afgeschreven. De kop van handleSubscribeStart() zegt letterlijk dat
 * een technische fout hier een zin hoort te zijn; die zin bestond, hij kwam
 * alleen nooit op het scherm.
 *
 * ── WAAROM DIT MET EEN SCRIPT MOET EN NIET ANDERS ─────────────────────────
 *
 * De pagina statisch houden is de bedoeling — zie de kop van dit bestand: geen
 * prijsberekening in de browser, gewone POST, alles opnieuw gecontroleerd op de
 * server. Een SSR-route hiervan maken om één zin te tonen, is de hele stroom
 * verbouwen voor het uitzonderingsgeval.
 *
 * Dus: alle vijf de zinnen staan al in de HTML, elk verborgen en elk met zijn
 * eigen sleutel. Het script zet er hoogstens één aan.
 *
 * ── EN HET ECHOT DE URL NIET ──────────────────────────────────────────────
 *
 * Het voor de hand liggende script leest ?fout= en schrijft de waarde in de
 * pagina. Dat is een reflected-XSS met extra stappen. Hier wordt de parameter
 * alleen gebruikt om een element OP TE ZOEKEN dat wij zelf hebben gerenderd:
 * staat er geen element met die sleutel, dan gebeurt er niets. Er gaat geen
 * enkel teken uit de URL de DOM in.
 */
const FOUT_IDS = Object.keys(FOUTEN);

const c = nl ? {
  h: 'Een abonnement afsluiten',
  lede: 'Elke maand een vast aantal afgemaakte producten, in een week die voor jou gereserveerd is. Maandelijks opzegbaar.',
  planH: 'Welk abonnement',
  termH: 'Welke termijn',
  weekH: 'Je vaste week',
  weekHint: 'De dag van de maand waarop wij aan jouw producten beginnen. Elke maand dezelfde. Weet je het nog niet, laat hem dan staan — je kunt hem later wijzigen.',
  /* ── DRIE BEGRIPPEN DIE NERGENS UITGELEGD STONDEN — 21 augustus 2026 ──
     "Machtiging", "vaste week" en "prijsslot" stonden alle drie als bekend
     verondersteld op het duurste formulier van de site — een doorlopende
     incasso. Ze staan nu in een zwevende notitie: de pagina wordt er niet langer
     van, en wie het woord niet kent, hoeft er niet meer omheen te lezen. */
  weekNote: 'Wij reserveren die week in de planning voor jou, elke maand opnieuw, vóórdat er andere bestellingen in mogen. Heb je die maand niets klaarstaan, dan vervalt de week niet: je producten schuiven door. Je kunt de dag altijd wijzigen in je dashboard.',
  mandateNote: `Een machtiging is de toestemming die je bank nodig heeft om ons maandelijks te laten incasseren — een SEPA-incasso, dezelfde vorm als bij een energieleverancier. Je geeft hem één keer af en je kunt hem altijd intrekken. De ${euro(MANDATE_AMOUNT, "nl")} is de transactie waarmee je bank hem uitgeeft.`,
  weekLabel: 'Dag van de maand',
  perMonth: 'per maand',
  products: 'producten per maand',
  clips: 'clips per maand',
  brandModel: 'Inclusief jouw eigen dedicated Merkmodel — volledig afgestemd op jouw merkesthetiek.',
  termNote: 'De jaartermijn is op Starter goedkoper per maand. Op Studio en Merk is hij dat niet, en dat is met opzet: die twee zitten met hun maandbedrag al op of onder de laagste prijs per product, en daar gaat niets meer af. Wat de jaartermijn daar geeft, staat hieronder.',
  submit: 'Doorgaan naar de machtiging',
  mandateH: 'Wat er nu gebeurt',
  mandateBody: `Je betaalt zo eenmalig ${euro(MANDATE_AMOUNT, "nl")}. Dat is geen eerste maand maar de transactie waarmee je bank de machtiging afgeeft — zonder die betaling kan er niets worden afgeschreven. Je eerste maandtermijn valt een maand later.`,
  cancelNote: 'Opzeggen kan zelf, in je eigen dashboard. Wat je hebt laten maken, blijft van jou.',
  signedOut: `Je moet ingelogd zijn om een abonnement af te sluiten. Heb je nog nooit bij ons besteld, begin dan met een proefvisual van ${euro(AMOUNT.testSample, "nl")} — dan weet je wat je koopt.`,
  signIn: 'Inloggen',
  sample: 'Eerst een proefvisual',
} : {
  h: 'Start a plan',
  lede: 'A fixed number of finished products every month, in a week reserved for you. Cancel any month.',
  planH: 'Which plan',
  termH: 'Which term',
  weekH: 'Your fixed week',
  weekHint: 'The day of the month we start on your products. The same every month. Not sure yet? Leave it — you can change it later.',
  weekNote: 'We reserve that week in the calendar for you, every month, before any other order can take it. If you have nothing ready that month the week is not lost: your products roll over. You can change the day at any time in your dashboard.',
  mandateNote: `A mandate is the permission your bank needs to let us collect monthly — a SEPA direct debit, the same shape as an energy supplier uses. You give it once and you can withdraw it at any time. The ${euro(MANDATE_AMOUNT, "en")} is the transaction that makes your bank issue it.`,
  weekLabel: 'Day of the month',
  perMonth: 'per month',
  products: 'products a month',
  clips: 'clips a month',
  brandModel: 'Includes a dedicated Brand Model tailored to your brand — no separate casting or usage fees.',
  termNote: 'The 12-month term is cheaper per month on Starter. On Studio and Brand it is not, and that is deliberate: their monthly price already sits at or below the lowest per-product rate, and there is nothing left to take off. What the 12-month term gives you there is listed below.',
  submit: 'Continue to the mandate',
  mandateH: 'What happens next',
  mandateBody: `You pay ${euro(MANDATE_AMOUNT, "en")} once. That is not a first month but the transaction your bank needs to issue the mandate — without it nothing can be charged. Your first monthly term falls a month later.`,
  cancelNote: 'You can cancel yourself, in your own dashboard. Whatever you had made stays yours.',
  signedOut: `You need to be signed in to start a plan. Never ordered from us? Start with a ${euro(AMOUNT.testSample, "en")} sample so you know what you are buying.`,
  signIn: 'Sign in',
  sample: 'Try a sample first',
};

// De twee termijnen, met wat ze kosten voor het GEKOZEN plan. Omdat er geen
// script is, staat het bedrag per plan per termijn er gewoon uit — drie plannen
// maal twee termijnen is zes bedragen, en dat is minder verwarrend dan een
// prijs die pas verschijnt als je iets aanklikt.
const termijnen = TERM_IDS.map((id) => ({
  id,
  naam: TERMS[id].name[nl ? 'nl' : 'en'],
  maanden: TERMS[id].months,
}));
---

<section class="wrap plan-start">
  <div class="container container-narrow">
    <h1>{c.h}</h1>
    <p class="lede">{c.lede}</p>

    {/* foutTekst blijft staan voor het geval deze pagina ooit wél per verzoek
        gerenderd wordt; dan wint de server en heeft het script niets te doen.
        Vandaag is hij altijd leeg — zie de noot hierboven. */}
    {foutTekst && <p class="error" role="alert">{foutTekst}</p>}

    <div class="plan-fouten" data-plan-fouten>
      {FOUT_IDS.map((id) => (
        <p class="error" data-plan-fout={id} hidden>{FOUTEN[id]}</p>
      ))}
    </div>

    <form method="post" action="/account/plan/start" class="plan-form">
      <input type="hidden" name="lang" value={lang} />

      <fieldset class="plan-set">
        <legend>{c.planH}</legend>
        {planList.map((p, i) => (
          <label class="plan-opt">
            <input type="radio" name="plan" value={p.id} required checked={i === 1} />
            <span class="plan-opt-body">
              <strong>{planName(p.id, lang)}</strong>
              <span class="plan-opt-line">{p.line}</span>
              <span class="plan-opt-facts">
                {productsFor(p.id)} {c.products}
                {clipsFor(p.id) ? ` · ${clipsFor(p.id)} ${c.clips}` : ''}
                {hasBrandModel(p.id, 'monthly') ? ` · ${c.brandModel}` : ''}
              </span>
              {/* TWEE BEDRAGEN ALLEEN ALS ZE VERSCHILLEN, en dat is bij precies
                  één plan zo. Alleen Starter krijgt jaarkorting; bij Studio en
                  Merk zit de waarde van de jaartermijn in de vier extra's en niet
                  in de prijs — zie de rekensom bij TERMS in plans.js. Twee keer
                  hetzelfde bedrag naast elkaar laat de jaartermijn zinloos lijken
                  terwijl hij dat niet is, en dat is erger dan één bedrag. */}
              <span class="plan-opt-prices">
                {monthlyCents(p.id, 'monthly') === monthlyCents(p.id, 'yearly') ? (
                  <span class="plan-opt-price">
                    <strong>{euro(monthlyCents(p.id, 'monthly') / 100, lang)}</strong> {c.perMonth}
                  </span>
                ) : termijnen.map((t) => (
                  <span class="plan-opt-price">
                    {t.naam}: <strong>{euro(monthlyCents(p.id, t.id) / 100, lang)}</strong> {c.perMonth}
                  </span>
                ))}
              </span>
            </span>
          </label>
        ))}
      </fieldset>

      {/* ── WAAROM DE JAARVORM MAAR ÉÉN PLAN GOEDKOPER MAAKT ─────────────────
          18 augustus 2026. De kaarten hierboven zetten er zes bedragen uit, en
          bij Studio en Merk staat er twee keer hetzelfde getal. Dat is juist —
          discountMonths in plans.js geeft alleen Starter korting, en de reden
          daarvoor staat daar uitgerekend: twee maanden korting duwt Studio en
          Merk ónder de bodem van de ladder, en dan verkoop je dertig producten
          per maand goedkoper aan de klant die de meeste capaciteit opeet.

          Maar op deze pagina stond dat nergens. Wie op Studio klikt en dan op
          "12 maanden", ziet hetzelfde bedrag staan en heeft twee gedachten die
          allebei slecht zijn: óf de pagina rekent niet goed, óf ik zit twaalf
          maanden vast voor niets. Het antwoord is beter dan allebei en het is
          één zin — en het is dezelfde zin die de jaarvorm verkoopt, want wat
          hij wél geeft staat er direct achter. */}
      <fieldset class="plan-set">
        <legend>{c.termH}</legend>
        <p class="plan-hint">{c.termNote}</p>
        {termijnen.map((t, i) => (
          <label class="plan-opt plan-opt-row">
            <input type="radio" name="term" value={t.id} required checked={i === 0} />
            <span class="plan-opt-body">
              <strong>{t.naam}</strong>
              {/* DE REGEL BEGINT NIET MET HET LABEL. Er stond hier
                  "Maandelijks, en elke maand opzegbaar" ónder een vetgedrukt
                  "Maandelijks", en bij de jaarvorm "12 maanden vast" onder
                  "12 maanden". In de bron valt dat niet op, want label en regel
                  staan tien tekens uit elkaar; op het scherm staan ze recht
                  boven elkaar en lees je het woord twee keer achter elkaar.
                  Het getal komt nog steeds uit TERMS.months — alleen niet meer
                  als eerste woord van de zin. */}
              <span class="plan-opt-line">
                {nl
                  ? (t.id === 'yearly'
                    ? `Een vaste looptijd van ${t.maanden} maanden. Daarvoor terug: een staande week, drie maanden doorschuiven, een prijsslot, en het merkmodel ook op Studio.`
                    : 'Elke maand opzegbaar. Je zegt op in je eigen dashboard.')
                  : (t.id === 'yearly'
                    ? `A fixed term of ${t.maanden} months. In return: a standing week, three months of rollover, a price lock, and the Brand Model on Studio too.`
                    : 'Cancellable any month. You cancel it yourself in your dashboard.')}
              </span>
            </span>
          </label>
        ))}
      </fieldset>

      <fieldset class="plan-set">
        <legend>{c.weekH} <Note lang={lang} term={nl ? 'je vaste week' : 'your fixed week'}>{c.weekNote}</Note></legend>
        <p class="plan-hint">{c.weekHint}</p>
        <label class="plan-day">
          <span>{c.weekLabel}</span>
          {/* 1 tot 28 en niet 1 tot 31, om dezelfde reden als window_day in
              migratie 0030: februari mag geen uitzondering worden. */}
          <select name="window_day">
            {Array.from({ length: 28 }, (_, i) => i + 1).map((d) => (
              <option value={d} selected={d === 8}>{d}</option>
            ))}
          </select>
        </label>
      </fieldset>

      <div class="plan-mandate">
        <h2>{c.mandateH} <Note lang={lang} term={nl ? 'machtiging' : 'mandate'}>{c.mandateNote}</Note></h2>
        <p>{c.mandateBody}</p>
        {/* Twee losse feiten, dus twee regels. Aan elkaar geplakt leest het als
            "blijft van jou excl. btw", en dat is een zin die niets betekent. */}
        <p class="meta">{c.cancelNote}</p>
        <p class="meta">{nl ? 'Alle bedragen' : 'All amounts'} {vatLabel('excl', lang)}.</p>
      </div>

      <button class="btn btn-primary btn-lg" type="submit">{c.submit}</button>
    </form>

    {/* De uitleg voor wie nog geen account heeft. Geen foutmelding en geen
        blokkade: de POST stuurt hem vanzelf naar de inlogpagina, en dit is de
        zin die uitlegt waarom dat gebeurt vóórdat het gebeurt.

        ── EN ALLEEN VOOR WIE UITGELOGD IS ────────────────────────────────────
        18 augustus 2026. Dit blok stond er voor iedereen. Deze pagina is
        statisch, dus bij het bouwen is er geen sessie en kan Astro het niet
        weten — maar de site heeft daar al een mechanisme voor, en drie andere
        formulieren gebruiken het. Layout.astro doet één gememoïseerde
        /account/me per paginalading en zet elk [data-acct]-blok in één keer
        aan of uit; zie ModelPicker.astro en .pl-signin in OrderFlow.astro.

        Zonder dat las een klant die net had ingelogd, direct ónder de knop
        "Doorgaan naar de machtiging", de zin "Je moet ingelogd zijn om een
        abonnement af te sluiten". Op precies het duurste knopje van de site
        is dat geen ruis maar twijfel: het leest als een waarschuwing dat de
        klik niet gaat werken, en de klant die dan tóch klikt is de klant die
        we net hebben laten aarzelen.

        GEEN `hidden` IN DE MARKUP, en dat is de asymmetrie met
        [data-acct="in"] in Layout.astro, die hem wél draagt. Zonder
        JavaScript draait paint() nooit, en dan blijft staan wat er staat.
        Voor "in" is dat goed (een naam tonen die je niet kunt controleren is
        erger dan geen naam) en hier is het omgekeerde goed: de fout die we
        niet willen is een uitgelogde bezoeker die de uitleg mist en op een
        knop drukt die hem naar een inlogscherm gooit zonder dat hem verteld
        is waarom. */}
    <div class="plan-signedout" data-acct="out">
      <p>{c.signedOut}</p>
      <p>
        <a class="btn btn-ghost" href={`/account/login?lang=${lang}`}>{c.signIn}</a>
        <a class="btn btn-ghost" href={lp('/test-sample')}>{c.sample}</a>
      </p>
    </div>
  </div>
</section>

<script is:inline data-astro-rerun>
  /* ── `data-astro-rerun`, OM DEZELFDE REDEN ALS IN HomeV2.astro ─────────────
     Astro voert een inline script bij een zachte navigatie maar één keer uit:
     de eerste keer dat de router hem tegenkomt. Zonder dit attribuut werkt alles
     hieronder dus precies één keer per bezoek.
     
     Dat is hier niet cosmetisch. Wie op /plans op de Merk-kaart klikt, komt via
     een zachte navigatie op /start/plan?plan=brand — en het aanvinken van het
     juiste plan gebeurt hieronder. Draait dit niet, dan staat Studio (€ 790)
     aangevinkt terwijl de bezoeker net op Merk (€ 1.690) heeft geklikt, op een
     formulier dat eindigt in een doorlopende machtiging. De noot bij "HET PLAN
     UIT DE URL" verderop beschrijft precies die fout; hij was gerepareerd voor
     de eerste klik en niet voor de tweede.

     Hier hoeft niets opgeruimd te worden: dit blok zet alleen iets in de opmaak
     en laat geen timer of luisteraar achter. */
  /* Zie de lange noot in de frontmatter. Eén ding: zoek het blok op dat bij de
     reden in de URL hoort, en zet het aan. `role="alert"` staat al in de markup,
     maar een alert die er bij het laden al staat wordt door schermlezers niet
     aangekondigd — vandaar dat hij hier pas zichtbaar wordt, en dat de focus
     erheen gaat zodat toetsenbord en schermlezer bij de zin uitkomen in plaats
     van bovenaan een formulier dat ze net hebben ingevuld. */
  (function () {
    var reden = new URLSearchParams(location.search).get('fout');
    if (!reden) return;
    /* Selector-injectie is hier net zo goed injectie: een reden als "a],[b" zou
       anders elk foutblok tegelijk aanzetten. Alleen letters, en verder niets. */
    if (!/^[a-z]+$/.test(reden)) return;
    var el = document.querySelector('[data-plan-fout="' + reden + '"]');
    if (!el) return;
    el.hidden = false;
    el.setAttribute('tabindex', '-1');
    el.focus();
  })();

  /* ── HET PLAN UIT DE URL ───────────────────────────────────────────────────
   *
   * De drie kaarten op /pricing wezen alle drie naar dezelfde kale URL, en
   * hierboven staat Studio standaard aan. Wie op de Merk-kaart klikte, koos
   * dus €1.690 en kreeg €790 aangevinkt — op een formulier dat eindigt in een
   * doorlopende machtiging. Zie de noot bij de knop in PricingPage.astro.
   *
   * Dezelfde discipline als bij de foutmelding hierboven: de waarde uit de URL
   * gaat nergens de pagina in. Hij wordt gefilterd op letters en daarna alleen
   * gebruikt om een radio op te zoeken die wij zelf hebben gerenderd — bestaat
   * hij niet, dan blijft staan wat er stond. `term` gaat mee omdat de knop hem
   * ooit mee kan geven en dan hetzelfde hoort te doen.
   *
   * GEEN `change`-event. Er hangt geen script aan deze radio's — de bedragen
   * staan alle zes uitgeschreven, juist omdat er niets te herberekenen valt. */
  (function () {
    var qs = new URLSearchParams(location.search);
    ['plan', 'term'].forEach(function (veld) {
      var waarde = qs.get(veld);
      if (!waarde || !/^[a-z]+$/.test(waarde)) return;
      var radio = document.querySelector(
        'input[name="' + veld + '"][value="' + waarde + '"]'
      );
      if (radio) radio.checked = true;
    });
  })();
</script>

<style>
  .plan-fouten:empty { display: none; }
  /* De <h1> viel terug op de standaard h1-maat (67px) terwijl elke andere
     bestelpagina — /start/catalog, /start/lifestyle, /start/custom-look — op de
     paginatitelmaat van 64 staat. Zie de noot bij --t-page-h1 in global.css. */
  .plan-start h1 { font-size: var(--t-page-h1); }
  /* Gelijk aan `.section-tight` (72/72 op 1440) en niet aan een eigen clamp.
     Gemeten op 19 augustus 2026: deze pagina stond op 64/64 terwijl
     /start/catalog, /start/lifestyle en /start/complete allemaal op 72/72
     stonden — vier stappen van dezelfde flow met drie keer dezelfde en één
     keer een andere maat. Zie de noot bij --section-tight in global.css. */
  .plan-start { padding-block: clamp(2.75rem, 5vw, 4.5rem); }
  .plan-form { margin-top: 2rem; display: grid; gap: 2rem; }
  .plan-set { border: 0; padding: 0; margin: 0; display: grid; gap: .7rem; }
