---
// VISUAILS — step 2 of /start: the product photos, one product at a time.
//
// WHAT THIS REPLACED
// One <input type="file" multiple> and a flat list of rows. A customer ordering
// 25 products dropped 100 files into it and nothing recorded which file was
// which product, or which of the four angles. The studio sorted it afterwards
// by hand, and the customer never learned whether what they sent was enough.
// The reasoning for the four shots, and every word describing them, is
// src/data/shots.js — read that file, not this one, for WHY the front and the
// back are required and the other two are not.
//
// ─────────────────────────────────────────────────────────────────────────────
// THE ONE THING TO GET RIGHT: WHERE THE EXPLANATION LIVES
// Four shots × 25 products is a hundred slots, and a slot that explains itself
// is four explanations printed a hundred times. That is Lucas's standing
// complaint about this site — "soms wordt het te veel" — arriving as a
// hundredfold. So the four drawings, the `how` and the `buys` are printed ONCE,
// at the top, where a customer reads them before they start; inside a card a
// slot is a drawing and a word, and the drawing is the same drawing they just
// read about. That is the whole information design of this step: the diagram is
// the index into an explanation given once.
//
// ─────────────────────────────────────────────────────────────────────────────
// WHAT IS SERVER-RENDERED HERE AND WHAT IS NOT
// Everything a customer reads before they touch anything: the guide, the two
// ways in, the tray's heading, the no-JS ending. The cards themselves are not —
// there are between one and thirty of them and the number comes from a <select>
// on step 1, so src/scripts/pipeline.js builds them and this file supplies the
// empty <ol> plus the four <template> diagrams the script clones into slots.
//
// NO-JS ENDS HONESTLY. The uploader needs XMLHttpRequest — it always has, and
// the old input carried no `name` attribute so that a JS-off browser would post
// nothing rather than post a file /api/order would throw away. That is still
// true, and instead of a dead control this now says what actually happens:
// order first, send the photos afterwards, in the copy shots.js keeps for it
// (`laterH` / `laterLead`). .pl-form.is-live is what swaps the two.
//
// ─────────────────────────────────────────────────────────────────────────────
// THE QUESTION, AND WHY IT DOES NOT COST TWENTY-FIVE PARAGRAPHS
// src/data/attributes.js adds one optional question per product: what the
// product is made of. It carries a `buys` line explaining what answering is
// worth, and printing that on twenty-five cards is twenty-five copies of one
// explanation, which is the exact failure the paragraph above describes. So it
// follows the same rule as the shots: the `buys` line is printed ONCE, in a
// second guide block at the top of this step, in a paragraph with a stable id
// (`pu-q-<id>-buys`). A card carries a label, a control, and an
// aria-describedby pointing back at that one paragraph.
//
// Everything here iterates PRODUCT_QUESTIONS rather than naming `material`, so
// the block still holds if Lucas ever adds a second question — that decision
// lives in the data file, not in this markup.
//
// The material field's suggestions are a shared <datalist> per question
// (`pu-dl-<id>`), rendered once here rather than per card — a datalist is
// referenced by id and twenty-five inputs may all name the same one.
// REQUIRED_SHOT was imported here and never used; it is gone from shots.js now
// (the rule is two shots, not one), so the dead name goes with it rather than
// sitting here as an import of an export that no longer exists.
import { SHOTS, copy as shotCopy } from '../../data/shots.js';
import { PRODUCT_QUESTIONS, copy as attrCopy } from '../../data/attributes.js';
import { MAX_BATCH_FILES, MAX_FILE_BYTES } from '../../lib/uploads.js';
/* De belofte over herkenbaarheid staat in pricing.js, niet hier — zie de kop
   van PRODUCTTROUW. Dit is de derde plek waar hij staat en de enige waar de
   klant op dat moment zijn eigen foto voor zich heeft. */
import { producttrouw } from '../../data/pricing.js';
import ShotDiagram from './ShotDiagram.astro';
/* ── DE TIPS NAAST DEZE STAP ───────────────────────────────────────────────
   Uit een eigen module en niet hier uitgeschreven, want /concept/bestelrij
   toont dezelfde reeks. Twee kopieën is één kopie die na de eerste wijziging
   stil uit elkaar loopt; zie de kop van src/data/uploadTips.js. */
import { tipsVoor, belofteVoor, TIP_COPY, TIP_INTERVAL_MS } from '../../data/uploadTips.js';
import { VLAK, FON, PLAAT, OVERLAY, overlayAlt } from '../../data/laptopVlak.js';
import Disclose from '../Disclose.astro';
import { existsSync } from 'node:fs';
import { fileURLToPath } from 'node:url';

/* Voorbeeldfoto per foto-soort, alleen als het bestand bestaat. */
const PUB = fileURLToPath(new URL('../../../public/', import.meta.url));
const example = (id: string) => (existsSync(`${PUB}img/voorbeeld-${id}.webp`) ? `/img/voorbeeld-${id}.webp` : '');

interface Props { lang: 'en' | 'nl'; }
const { lang } = Astro.props;
const k = shotCopy(lang);
const a = attrCopy(lang);

// The handful of labels shots.js does not own, because they are about THIS
// control rather than about the photographs. Same arrangement as
// StylePicker.astro: a component's own markup strings live with the markup.
const COPY = {
  en: {
    folder: 'Choose a folder instead',
    folderHint: 'One folder per product. We read the folder name as the product.',
    off: 'Files cannot be taken at the moment. Carry on — we will ask for them by email, and nothing about your order depends on this step.',
    guideH: 'What we ask for, and what each one is for',
    pdf: 'Take the photo guide with you (pdf)',
  },
  nl: {
    folder: 'Of kies een map',
    folderHint: 'Eén map per product. We lezen de mapnaam als het product.',
    off: 'Je kunt op dit moment geen bestanden versturen. Ga gerust verder — we vragen ze per e-mail op, en je bestelling hangt niet van deze stap af.',
    guideH: 'Wat we vragen, en waar elke foto voor is',
    pdf: 'Neem de fotogids mee (pdf)',
  },
};
const t = COPY[lang];

const mb = Math.round(MAX_FILE_BYTES / (1024 * 1024));
const hint = lang === 'nl'
  ? `JPG, PNG, WebP, AVIF, HEIC, GIF of TIFF · max ${mb} MB per stuk · ${MAX_BATCH_FILES} bestanden per bestelling`
  : `JPG, PNG, WebP, AVIF, HEIC, GIF or TIFF · up to ${mb} MB each · ${MAX_BATCH_FILES} files per order`;

/* ── HET TIPPANEEL ─────────────────────────────────────────────────────────
   De tips reizen als JSON mee in een data-attribuut, zoals de conceptpagina
   het ook doet. Niet via de PIPE-tabel in OrderFlow.astro: dat is een tabel van
   platte sleutels en dit is een reeks objecten met beeldpaden erbij. Eén regel
   JSON is hier eerlijker dan vijf sleutels per tip die je met de hand moet
   bijhouden zodra er een tip bij komt.

   De NAAM van het vak komt uit shots.js en wordt niet in uploadTips.js
   overgetypt, anders heet "Voorkant" in dit paneel ooit anders dan in het
   vakje drie centimeter hoger. */
const tipCopy = TIP_COPY[lang === 'nl' ? 'nl' : 'en'];
const tips = tipsVoor(lang).map((tip) => ({
  ...tip,
  naam: (SHOTS.find((sh) => sh.id === tip.vak) || { name: {} }).name[lang] || tip.vak,
}));
/* De belofte per vak reist apart mee: hij hoort bij het vakje dat je aanraakt
   en niet bij de tip die toevallig langskomt. */
const beloftes = Object.fromEntries(SHOTS.map((sh) => [sh.id, belofteVoor(sh.id, lang)]));
const lcStijl = [
  `--lc-plaat:${PLAAT}`,
  `--lc-l:${VLAK.links}%`, `--lc-t:${VLAK.boven}%`, `--lc-w:${VLAK.breed}%`, `--lc-h:${VLAK.hoog}%`,
  `--lc-fl:${FON.links}%`, `--lc-ft:${FON.boven}%`, `--lc-fw:${FON.breed}%`, `--lc-fh:${FON.hoog}%`,
].join(';');
---

<div class="pu">
  {/* ── THE LIVE UPLOADER ──────────────────────────────────────────────────
      ÉÉN WEG TEGELIJK, EN PER PRODUCT IS DE VOORKEUR — 8 augustus 2026.

      Hier stonden beide manieren onder elkaar op één scherm: eerst de sleepbak
      voor de hele hoop, daarna de kaarten per product. Lucas: *"Ook het slepen
      van bestanden of mappen werkt niet zo fijn. (…) niet beide opties tonen,
      laat eerst invulscherm zien en maak een knop om over te schakelen naar map
      uploaden en dan verdwijnt het andere scherm."*

      Twee dingen veranderden daarmee. De ORDE: de kaarten staan nu eerst en de
      sleepbak erachter, want per product ingevuld is de weg die geen navraag
      kost. En de EXCLUSIVITEIT: er is er altijd precies één zichtbaar. Twee
      manieren naast elkaar is geen keuze aanbieden maar de keuze doorschuiven —
      de klant moet dan zelf uitzoeken welke van de twee voor hem bedoeld is, en
      dat is precies het moment waarop iemand de verkeerde pakt.

      De maproute is NIET weggestopt. Hij is sneller en voor een merk met een
      exportmap de enige redelijke weg. Hij kost alleen een gesprek achteraf, en
      dat staat er nu bij vóórdat je hem kiest.

      DE BAK BLIJFT VOOR BEIDE WERKEN. pipeline.js hangt zijn sleep-luisteraars
      aan het formulier en niet aan dit paneel, dus een map op de kaarten slepen
      werkt nog steeds — verbergen is geen uitschakelen. Dat is bewust: iemand die
      per product invult en tóch een map naar binnen sleept, bedoelde dat. */}
  <div class="pu-live" data-pu-modes>
    <section class="pu-manual" data-pu-panel="cards" aria-labelledby="pu-manual-h">
      <h3 class="pu-sub-h" id="pu-manual-h">{k.manualH}</h3>
      {/* ONCE, over the whole list — the same rule the guide follows. Twenty-five
          cards each carrying a sentence about what to type in their name field
          is twenty-five copies of one instruction. */}
      <p class="pu-sub-lead">{k.leadShort} {k.productNameHint}</p>
      {/* ═══ ÉÉN PRODUCT TEGELIJK, VAN LINKS NAAR RECHTS — 17 SEPTEMBER 2026 ══
          Lucas: *"Misschien kan het bestelformulier wel van links naar rechts
          gaan — dat zorgt voor overzicht, je vult per product de foto's in en
          klikt op klaar, en dan gaat hij naar de volgende productinvulpagina.
          Je kan dan met pijltjes nog wel terug naar het vorige product of juist
          vooruit; op het einde krijg je een melding als er nog een product of
          meerdere niet ingevuld is."* En na het prototype: *"bestelformulier van
          links naar rechts is goed en overzichtelijker."*

          ── WAT ER NIET VERANDERT ────────────────────────────────────────────
          De KAART zelf niet, en dat is opzet. De vakjes, het slepen, de lade,
          de gratis referentievakken, de bijbestelde foto's, het gezicht per
          product — dat werkt allemaal en het is het duurste deel van dit
          formulier om opnieuw te maken. Wat verandert is wat je ERVAN ZIET:
          één kaart in beeld in plaats van een kolom van vijfentwintig, met een
          balk erboven die zegt waar je bent en twee pijlen om te verplaatsen.

          ── DE BALK IS GEEN VERSIERING ───────────────────────────────────────
          Hij is de enige plek waar je in één blik ziet hoeveel er nog moet, en
          hij is aanklikbaar: naar product 14 springen is één tik in plaats van
          dertien keer vooruit. Hij wordt gekloond uit het <li> hieronder en
          niet met createElement gebouwd — Astro hangt zijn data-astro-cid aan
          elke selector, en wat na de bouw ontstaat draagt dat niet en krijgt
          dus geen enkele scoped regel. Drie keer eerder in gelopen in dit
          project; zie de kop van bestelrij.astro.

          ── EN DE VOORUITKNOP IS DE POORT ───────────────────────────────────
          Lucas, over de draagfoto: *"'Sla deze over' moet aangeklikt worden,
          anders kan de klant niet verder naar het volgende product."* In een
          kolom is er geen "verder" om tegen te houden; hier wel. De knop staat
          uit zolang de kaart niet af is, met de reden eronder — dezelfde zin
          die op de kaart zelf staat, uit cardStateText(). */}
      <div class="pu-rij" data-pl-rij hidden>
        <ol class="pu-rail" data-pl-rail role="list">
          {/* ── HET VAKJE ZEGT SINDS 17 SEPTEMBER OOK WÁÁR HET GAT ZIT ──────────
          Tot vandaag was dit één vierkantje per product: vol of leeg, af of
          niet af. Je wist dus hoeveel producten er nog lagen, maar niet wat er
          aan ontbrak — waarvoor je elk product moest openklikken.

          Nu draagt de knop een streepje per verplichte foto. Vol is binnen,
          leeg mist nog. Die streepjes worden door pipeline.js gemaakt (het
          aantal hangt van de bestelde hoeken af), dus de opmaak ervan staat
          onder `:global()` verderop — een element dat tijdens het gebruik
          ontstaat, draagt Astro's scope-attribuut niet. */}
      <li class="pu-rail-item"><button type="button" class="pu-rail-knop" data-pl-rail-knop><span class="pu-rail-vakjes" data-pl-rail-vakjes aria-hidden="true"></span><span class="pu-sr" data-pl-rail-naam></span></button></li>
        </ol>
        <p class="pu-rij-tel" data-pl-rij-tel aria-live="polite"></p>
      </div>

      {/* Built by pipeline.js from the count on step 1, and rebuilt when that
          count changes. Empty in the markup on purpose: a card list rendered
          here would be a guess at a number the visitor has already answered. */}
      <ol class="pu-cards" data-pl-cards></ol>

      {/* De twee pijlen staan ONDER de kaart en niet erboven: je leest de kaart
          van boven naar beneden en de handeling "klaar, volgende" hoort aan het
          eind van dat lezen. Verborgen tot pipeline.js weet dat er meer dan één
          product is. */}
      <div class="pu-nav" data-pl-nav hidden>
        <button type="button" class="btn btn-ghost pu-nav-knop" data-pl-vorige>
          <svg viewBox="0 0 24 24" class="i" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M11 18l-6-6 6-6"/></svg>
          <span data-pl-vorige-tekst>{k.vorige}</span>
        </button>
        <span class="pu-nav-reden hint" data-pl-nav-reden></span>
        <button type="button" class="btn btn-primary pu-nav-knop" data-pl-volgende>
          <span data-pl-volgende-tekst>{k.volgende}</span>
          <svg viewBox="0 0 24 24" class="i" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </button>
      </div>
      {/* ── DE TIPS ─────────────────────────────────────────────────────────
          Lucas: *"rechts tips die de klant elke 10 seconden kort vertellen wat
          waarvoor is en waarom het handig is."* Gebouwd op /concept/bestelrij,
          op 17 september hiernaartoe gehaald.

          ── ONDER DE KAART EN NIET VASTGEPLAKT ONDERAAN ─────────────────────
          Op de conceptpagina plakt dit paneel aan de onderkant van het scherm.
          Hier kan dat niet: deze stap heeft onderaan al twee dingen die om die
          rand vechten — de pijlen van de rij en de Vorige/Verder van de wizard
          — en op stap 1 zit daar op een telefoon ook nog de totaalbalk. Een
          derde zwevende strook is er één te veel.

          Dus staat hij in de stroom, direct onder de pijlen: je leest de kaart,
          je gaat door, en wie twijfelt vindt de uitleg op de plek waar hij
          stopte. Open op een groot scherm, dicht op een telefoon — daar is de
          ruimte waar je in werkt te kostbaar om er ongevraagd een paneel in te
          zetten.

          ALLES STAAT IN DE MARKUP. Geen enkel deel hiervan wordt door
          pipeline.js gemaakt: dat script wisselt alleen teksten en bronnen om.
          Dat is met opzet — een element dat tijdens het gebruik ontstaat, krijgt
          geen van de gescopeerde regels hieronder (zie de kop van dit bestand),
          en die val heeft dit project al vier keer gekost. */}
      <aside
        class="pu-tips"
        data-pu-tips={JSON.stringify(tips)}
        data-pu-beloftes={JSON.stringify(beloftes)}
        data-pu-tip-ms={TIP_INTERVAL_MS}
        data-pu-merk={tipCopy.merk}
      >
        <h3 class="pu-tips-kop">
          <button
            type="button"
            class="pu-tips-knop"
            data-pu-tips-schuif
            aria-expanded="true"
            aria-controls="pu-tips-in"
          >
            <span class="pu-tips-woord">{tipCopy.kop}</span>
            {/* De regel naast de knop verschijnt pas als het paneel dicht is:
                dan is hij het enige dat er nog van over is. Staat hij er ook
                open bij, dan staat dezelfde zin twee keer op het scherm. */}
            <span class="pu-tips-nu" data-pu-tips-nu></span>
            <svg class="pu-tips-pijl" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6"><path d="m6 9 6 6 6-6"/></svg>
          </button>
        </h3>

        <div class="pu-tips-in" id="pu-tips-in">
          <div class="pu-tips-doek" style={lcStijl}>
            <div class="pu-tips-vlak"><img data-pu-tips-laptop src={tips[0].na} alt="" width="760" height="760" loading="lazy" decoding="async" /></div>
            <div class="pu-tips-fon"><img data-pu-tips-fon src={tips[0].voor} alt="" width="760" height="1013" loading="lazy" decoding="async" /></div>
            <img class="pu-tips-plaat" src={OVERLAY} alt={overlayAlt(lang)} width="1792" height="1013" loading="lazy" decoding="async" />
            {/* Het label hoort bij het LAPTOPbeeld en staat daarom binnen het
                schermvlak, linksboven, waar nooit een telefoon overheen valt. */}
            <p class="pu-tips-merk" data-pu-tips-merk></p>
          </div>

          <div class="pu-tips-woorden">
            <p class="pu-tips-vaknaam" data-pu-tips-vaknaam></p>
            <p class="pu-tips-zin" data-pu-tips-zin></p>
            <p class="pu-tips-noot" set:html={tipCopy.noot}></p>
            {/* De streepjes zeggen hoeveel tips er zijn en waar je bent. Geen
                knoppen: dit is iets dat langskomt, niet iets dat je bedient. */}
            <p class="pu-tips-tikken" data-pu-tips-tikken aria-hidden="true">
              {tips.map(() => (<i></i>))}
            </p>
          </div>
        </div>
      </aside>

      {/* Verborgen tot pipeline.js beslist heeft of hij nodig is — hij bestaat
          alleen voor de keuze "meer dan N" (het plafond per dienst), waar het aantal onbekend is. Zonder
          dit stond er een lege ghost-knop in beeld zolang het script nog niet
          gedraaid had. */}
      <p class="pu-add-row"><button type="button" class="btn btn-ghost pu-add" data-pl-add hidden>{k.addProduct}</button></p>

      <p class="pu-swap">
        <button type="button" class="pu-link" data-pu-switch="folder">{k.toFolder}</button>
        <span class="hint">{k.toFolderWhy}</span>
      </p>
    </section>

    <section class="pu-bulk" data-pu-panel="folder" hidden aria-labelledby="pu-bulk-h">
      <h3 class="pu-sub-h" id="pu-bulk-h">{k.bulkH}</h3>
      <p class="pu-sub-lead">{k.bulkLead}</p>
      <label class="dropzone pu-drop">
        <input type="file" data-pl-file multiple accept="image/*" class="pu-file-input" />
        <span class="dz-main">{k.bulkCta}</span>
        <span class="dz-hint">{hint}</span>
      </label>
      {/* A SECOND input, because webkitdirectory and multiple-files are not the
          same picker: a browser that has directory upload opens a folder
          chooser for one and a file chooser for the other, and there is no
          attribute that offers both in one dialog. The button is hidden by
          pipeline.js on a browser without the property rather than rendered
          dead. Dropping a folder needs neither — that is webkitGetAsEntry. */}
      <p class="pu-folder-row" data-pl-folder-row hidden>
        <button type="button" class="pu-link" data-pl-folder>{t.folder}</button>
        <span class="hint pu-folder-hint">{t.folderHint}</span>
      </p>
      <input type="file" data-pl-folder-input multiple accept="image/*" class="pu-file-input" tabindex="-1" aria-hidden="true" />

      <p class="pu-swap">
        <button type="button" class="pu-link" data-pu-switch="cards">{k.toCards}</button>
        <span class="hint">{k.toCardsWhy}</span>
      </p>
    </section>

    {/* Progress that is about products, never about files. "8 of 25 products
        ready" is a sentence a customer can act on; "31 files uploaded" is a
        receipt for work they cannot check.

        BUITEN DE PANELEN, want hij gaat over de bestelling en niet over de weg
        die je koos: wie een map stuurt wil net zo goed weten hoeveel producten
        er klaar zijn. */}
    <p class="pu-progress" data-pl-progress aria-live="polite"></p>

    {/* ── DE TUSSENSTAP BIJ ONTBREKENDE FOTO'S — 3 september 2026 ──────────
        Gevuld en getoond door askMissing() in pipeline.js zodra iemand op
        Verder drukt terwijl een product zijn voor- of achterkant mist. Geen
        poort: de tweede knop stuurt door. Wél het gevolg, in woorden. */}
    <div class="pu-missing" data-pl-missing hidden role="group" aria-labelledby="pu-missing-h">
      <h3 class="pu-sub-h" id="pu-missing-h" data-pl-missing-h>{k.missingHOne}</h3>
      {/* ── EEN RASTER EN GEEN OPSOMMING — 17 september 2026 ──────────────
          Hier stond een lijstje dat na zes regels ophield met "en nog 19" —
          op het enige scherm waar je juist wilt weten wélke negentien. Op
          /concept/bestelrij was dit een raster van tegels: elk product met
          zijn vakjes, en één klik om er heen te springen.

          De tegels worden door askMissing() gemaakt (het aantal producten
          staat pas vast als de klant het heeft ingevuld), dus hun opmaak
          staat onder `:global()` — zie de noot bij de streepjes in de balk. */}
      <p class="pu-missing-tik hint">{k.missingTap}</p>
      <ol class="pu-missing-raster" data-pl-missing-list></ol>
      <p class="pu-sub-lead">{k.missingBody}</p>
      <p class="pu-missing-btns">
        <button type="button" class="btn btn-primary" data-pl-missing-fix>{k.missingFix}</button>
        <button type="button" class="btn btn-ghost" data-pl-missing-go>{k.missingGo}</button>
      </p>
    </div>

    {/* ── THE TRAY ─────────────────────────────────────────────────────────
        Files we could not attribute. It is hidden until there is one, because
        an empty box labelled "not placed yet" is an accusation.

        Drag onto a slot works, and it is NOT the only way: the menu on each
        item lists every product against every shot, so this is reachable by
        click, by keyboard and by a thumb on a phone — none of which can drag. */}
    <section class="pu-tray" data-pl-tray hidden aria-labelledby="pu-tray-h">
      <h3 class="pu-sub-h" id="pu-tray-h">{k.trayH}</h3>
      <p class="pu-sub-lead">{k.trayLead}</p>
      <ul class="pu-tray-list" data-pl-tray-list></ul>
    </section>

    <p class="pl-note pu-off" data-pl-upload-note="off" hidden>{t.off}</p>
  </div>

  {/* ── WITHOUT JAVASCRIPT ─────────────────────────────────────────────────
      The end of the honest path. No dead control, no input that posts nothing:
      the order goes through and the photographs follow, which is what happens
      anyway for every client who would rather send them later. */}
  {/* ── DE UITLEG, ONDER DE KAARTEN EN INGEKLAPT — 3 september 2026 ────────
      Hij stond bovenaan: twee schermen tekst voordat de eerste upload in beeld
      was. Lucas: "duidelijk maar niet druk". Elke kaart draagt nu zelf één regel
      per foto (pu.how in pipeline.js), en de volledige uitleg — met de
      voorbeeldfoto's — staat hier achter één uitklapper. De aria-describedby-
      doelen (#pu-q-<vraag>-buys) blijven in het document, dus de kaarten
      wijzen nog steeds naar dezelfde uitleg. */}
  <Disclose summary={t.guideH} tone="plain" class="pu-guide-fold">
  {/* ── THE GUIDE, ONCE ────────────────────────────────────────────────────
      Printed here and nowhere else. See the header: a slot inside a card is a
      drawing and a word, and this is the page that gives the drawing meaning. */}
  <section class="pu-guide" aria-labelledby="pu-guide-h">
    <h3 class="pu-guide-h" id="pu-guide-h">{t.guideH}</h3>
    <p class="pu-lead">{k.lead}</p>
    {/* Wat er met die foto's gebeurt. Binnen de uitklapper en niet erbuiten: wie
        hem opent, vraagt zich af wat er van zijn product terugkomt. */}
    <p class="pu-lead pu-trouw">{producttrouw(lang)}</p>
    <ul class="pu-guide-list">
      {SHOTS.map((s) => (
        <li class="pu-guide-item">
          <span class="pu-guide-dia"><ShotDiagram shot={s.id} /></span>
          {/* Een echte voorbeeldfoto naast de tekening, als hij op schijf staat
              (public/img/voorbeeld-<shot>.webp). Ontbreekt hij, dan staat er
              alleen de tekening — geen leeg vak. 3 september 2026. */}
          {example(s.id) && <img class="pu-guide-eg" src={example(s.id)} alt={s.name[lang]} width="120" height="150" loading="lazy" decoding="async" />}
          <div class="pu-guide-body">
            <h4 class="pu-guide-name">
              {s.name[lang]}
              <span class:list={['pu-tag', s.required && 'is-req']}>{s.required ? k.required : k.optional}</span>
            </h4>
            <p class="pu-guide-how">{s.how[lang]}</p>
            <p class="pu-guide-buys">{s.buys[lang]}</p>
          </div>
        </li>
      ))}
    </ul>
    <p class="pu-quality">{k.quality}</p>
    {/* ── DE GIDS OM MEE TE NEMEN — 7 september 2026 ────────────────────────
        Dit is de enige stap waar iemand ontdekt dat de foto's die hij heeft
        niet zijn wat we vragen — en het volgende dat hij doet, is opstaan om
        ze te maken. Dan staat deze pagina niet meer op zijn scherm.

        Daarom hier de pdf en niet nog een link naar /upload-guidelines: die
        lees je, deze neem je mee. `download` zorgt dat hij in de downloadmap
        landt in plaats van in een tabblad dat hij kwijtraakt. Zelfde bestand
        als op /upload-guidelines en /test-sample; scripts/handleiding.mjs
        maakt hem. */}
    <p class="acties pu-gids">
      <a class="pijl" href={`/downloads/visuails-fotogids-${lang}.pdf`} download>{t.pdf}</a>
    </p>
  </section>

  {/* ── THE SECOND HALF OF THE GUIDE, ALSO ONCE ─────────────────────────────
      The same shape as the block above and for the same reason: a name, an
      optional mark, and the one sentence that says what answering buys. Every
      card's control points here with aria-describedby, so the explanation is
      read once and referenced twenty-five times instead of printed
      twenty-five times.

      Inside .pu-live because the question lives on generated cards: with
      JavaScript off there are no cards, and a guide to a field that is not on
      the page is the worst kind of text wall — one that cannot even be acted
      on. */}
  <section class="pu-guide pu-about-guide" aria-labelledby="pu-about-h">
    <h3 class="pu-guide-h" id="pu-about-h">{a.aboutH}</h3>
    <p class="pu-lead">{a.aboutLead}</p>
    <ul class="pu-about-list">
      {PRODUCT_QUESTIONS.map((qn) => (
        <li class="pu-about-item">
          <div class="pu-guide-body">
            <h4 class="pu-guide-name">
              {qn.name[lang]}
              <span class="pu-tag">{a.optional}</span>
            </h4>
            <p class="pu-guide-buys" id={`pu-q-${qn.id}-buys`}>
              <span class="pu-buys-lede">{a.whatItBuys}</span>{qn.buys[lang]}
            </p>
          </div>
        </li>
      ))}
    </ul>
  </section>

  </Disclose>

  <div class="pu-later">
    <h3 class="pu-sub-h">{k.laterH}</h3>
    <p class="pu-sub-lead">{k.laterLead}</p>
  </div>

  {/* ── DE VIER TEKENINGEN STAAN NOG MAAR OP ÉÉN PLEK — 17 september 2026 ────
      Ze werden hiervandaan door pipeline.js in elk leeg vakje gekloond. Sinds
      een leeg vakje een plusje draagt (zie buildSlot), gebeurt dat niet meer en
      zou deze reeks <template>'s vier onbereikbare SVG's per pagina zijn.

      Ze zijn niet weg: in de gids bovenaan deze stap staan ze naast elkaar
      (.pu-guide-dia), en dáár doen ze hun werk — vier hoeken naast elkaar leert
      je het verschil, dezelfde vier los in vier vakken laat je raden. */}

  {/* ── HET GEZICHT PER PRODUCT, ALS TEGELS — 18 september 2026 ────────────
      Lucas: *"Het is ook belangrijk dat klanten per product visueel een ander
      model kunnen kiezen per product, dit hoeft niet groot en is puur
      optioneel."* Dit was een keuzelijst in de lade van de kaart: elf namen
      onder elkaar, en je moest weten wie "Ava" is voordat je iets kon kiezen.

      Nu is het een rij duimnagels op de kaart zelf, waarvan de eerste
      "hetzelfde als de bestelling" is en het gezicht van de bestelling toont.
      Wie niets doet, ziet één gekozen tegel en klaar.

      ── WAAROM EEN <template> EN GEEN createElement ────────────────────────
      Astro scopet zijn CSS met een attribuut dat een element dat pipeline.js
      maakt niet draagt. Een tegel die hier in de bron staat, wordt wél gescopet,
      en een kloon daarvan is dus een echte tegel — dezelfde afspraak als bij de
      eigen modeltegel in ModelPicker.astro, en om dezelfde reden: die ging een
      keer mis en leverde een portret van 760 pixels op in een raster van 86. */}
  <template data-pu-model>
    <div class="pu-mk" role="group">
      <p class="pu-mk-h"></p>
      <div class="pu-mk-rij" role="radiogroup"></div>
      <p class="pu-mk-hint hint"></p>
    </div>
  </template>
  <template data-pu-model-tegel>
    <label class="pu-mk-tegel">
      <input type="radio" class="pu-mk-radio" />
      <img class="pu-mk-beeld" alt="" width="120" height="160" loading="lazy" decoding="async" />
      <span class="pu-mk-naam"></span>
    </label>
  </template>

  {/* One <datalist> per question that has examples, shared by every card's
      input through `list="pu-dl-<id>"`. Suggestions, never a closed list —
      attributes.js says so on the `examples` key and a datalist is the only
      native control that suggests without refusing. */}
  {PRODUCT_QUESTIONS.filter((qn) => qn.examples).map((qn) => (
    <datalist id={`pu-dl-${qn.id}`}>
      {qn.examples[lang].map((x) => <option value={x}></option>)}
    </datalist>
  ))}
</div>

<style>
  /* ═══════════════════════════════════════════════════════════════════════════
     Step 2 — the per-product uploader.

     SAME TWO RULES AS OrderFlow.astro'S SHEET, for the same reasons, and this
     block is unreadable without them:

     · Astro scopes every selector here to this component. The cards, the slots
       and the tray rows are built by pipeline.js with createElement and never
       receive the scope attribute, so every rule for a generated element is a
       scoped ancestor with a :global() descendant — `.pu-cards :global(.pu-card)`.
     · .pl-form.is-live is the live/no-JS switch. Without it the uploader is not
       shown at all and .pu-later is; with it, the opposite. A control that
       silently does nothing is worse than a control that is not there.
     ═══════════════════════════════════════════════════════════════════════════ */

  /* The UA's own `[hidden] { display: none }` sits in the user-agent origin,
     where it loses to ANY author rule — and several rules below set display on
     an element pipeline.js hides. OrderFlow.astro declares the same pair for
     the same reason; it cannot cover this component, because its copy is scoped
     to ITS hash and these elements carry this one's. */
  [hidden] { display: none !important; }
  .pu :global([hidden]) { display: none !important; }

  /* global.css puts clamp(4.5rem, 9vw, 9rem) of padding on every <section>,
     which at 1440px is 130px above AND below each of the four in here — half a
     screen of nothing between the guide and the dropzone. These are sections
     because they are sections (each has its own heading and is labelled by it),
     not because they are page bands. OrderFlow.astro does the same thing to
     .pl-step one line into its own sheet, for the same reason.

     First, so the two that declare a padding of their own still win. */
  .pu-guide, .pu-bulk, .pu-tray, .pu-manual { padding-block: 0; }

  .pu-live { display: none; }
  :global(.pl-form.is-live) .pu-live { display: block; }
  :global(.pl-form.is-live) .pu-later { display: none; }

  /* .dropzone, .dropzone:hover, .dropzone:focus-within and .dropzone.is-dragover
     are all in global.css — including the drag state, which is why nothing here
     invents one. These two are the labels inside it, and they are declared here
     rather than inherited from OrderFlow.astro's sheet for the scoping reason
     above. */
  .dz-main { display: block; color: var(--ink); font-weight: 500; }
  .dz-hint { display: block; margin-top: .35rem; font-size: .85rem; color: var(--ink-3); }

  /* ── The guide ────────────────────────────────────────────────────────────
     Four items, each a drawing and two sentences: what to photograph, and what
     skipping it costs. The second sentence is the one that earns its place —
     "recommended" with no reason attached is nagging, and a customer who knows
     what a missing back shot costs can make that trade themselves. */
  .pu-guide {
    margin-top: 1.2rem;
    padding: clamp(1rem, 2.6vw, 1.6rem);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    background: var(--surface);
  }
  .pu-guide-h {
    font-size: .72rem; font-weight: 700; letter-spacing: .09em;
    text-transform: uppercase; color: var(--ink-3);
  }
  .pu-lead { margin-top: .5rem; color: var(--ink-2); font-size: .95rem; line-height: 1.6; max-width: 64ch; }
  /* Onder een haarlijn en niet in een kader — zie dezelfde afweging op
     /how-to-photograph. */
  .pu-trouw { margin-top: .9rem; padding-top: .9rem; border-top: 1px solid var(--line, #DFDFDF); }

  .pu-guide-list {
    list-style: none;
    margin: 1.2rem 0 0;
    padding: 0;
    display: grid;
    gap: 1rem 1.6rem;
    /* Two by two at the form's 880px measure, one column on a phone. Four
       across fits arithmetically and reads badly: `buys` is a sentence, and a
       sentence in a 200px column is eight lines of two words. */
    grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
  }
  .pu-guide-item {
    display: grid;
    grid-template-columns: 46px auto 1fr;
    gap: .8rem;
    padding-top: .9rem;
    border-top: 1px solid var(--line);
  }
  .pu-guide-dia { display: block; width: 46px; height: 46px; color: var(--ink-2); }
  .pu-guide-name {
    display: flex; flex-wrap: wrap; align-items: baseline; gap: .5rem;
    font-size: 1rem; line-height: 1.2;
  }
  .pu-guide-how { margin-top: .35rem; font-size: .86rem; color: var(--ink-2); line-height: 1.5; }
  .pu-guide-buys { margin-top: .35rem; font-size: .8rem; color: var(--ink-3); line-height: 1.5; }

  /* A mark, so --r-sm. The required one is the only thing in the guide that is
     a rule rather than a recommendation, and it is the only thing coloured. */
  .pu-tag {
    padding: .12rem .4rem;
    border: 1px solid var(--line);
    border-radius: var(--r-sm);
    font-size: .72rem; font-weight: 700; letter-spacing: .07em;
    text-transform: uppercase; color: var(--ink-3);
    white-space: nowrap;
  }
  .pu-tag.is-req { border-color: var(--signal); color: var(--signal-ink); background: var(--paper-2); }

  .pu-quality { margin-top: 1.1rem; font-size: .82rem; color: var(--ink-3); line-height: 1.55; max-width: 70ch; }
  .pu-gids { margin-top: 1rem; }

  /* ── The second guide: what the product is made of ────────────────────────
     Only shown on the live form. See the note in the markup: without JS there
     are no cards, so there is no field for this to explain. */
  .pu-about-guide { display: none; }
  :global(.pl-form.is-live) .pu-about-guide { display: block; }
  /* ITS OWN LIST, NOT .pu-guide-list, and that is a scar. These items have no
     drawing to sit beside, so they were given .pu-guide-item with the gutter
     column overridden — and the ≤560px media query further down redeclares
     that gutter at equal specificity and later in the sheet, so on a phone
     every paragraph was placed back into a 38px column and wrapped one word
     per line. The block was 2,365px tall. A shared class that has to be
     un-declared in two places is not a shared class. */
  .pu-about-list {
    list-style: none;
    margin: 1.1rem 0 0;
    padding: 0;
    display: grid;
    gap: .85rem 1.6rem;
    /* auto-fit at 250px, which today means one full-width item because there
       is one question. The track sizing is kept measured rather than replaced
       with a single column: the form's 880px measure minus this block's own
       padding leaves 830px, so three tracks plus two 1.6rem gaps need
       3×250 + 51 = 801 and still fit if a second or third question is ever
       added back in attributes.js. At 260 the third track missed by half a
       pixel, which is why it is not 260. */
    grid-template-columns: repeat(auto-fit, minmax(min(250px, 100%), 1fr));
  }
  .pu-about-item {
    min-width: 0;
    /* The measure guard for the one-question case: a single auto-fit track is
       830px wide, and a 130-character line is not a line anyone reads. With
       two or three items the track is already under this, so it does nothing
       there. */
    max-width: 70ch;
    padding-top: .8rem;
    border-top: 1px solid var(--line);
  }
  /* The label attributes.js writes for the `buys` sentence, inline so it costs
     a phrase rather than a line. The dash is punctuation, not words — it is in
     CSS because it is the same mark in both languages. */
  .pu-buys-lede { font-weight: 700; color: var(--ink-2); }
  .pu-buys-lede::after { content: ' — '; font-weight: 400; }

  /* ── The two ways in ──────────────────────────────────────────────────────*/
  .pu-bulk, .pu-manual, .pu-tray { margin-top: clamp(1.6rem, 3.4vw, 2.4rem); }

  /* ── DE OMSCHAKELREGEL ────────────────────────────────────────────────────
     Onderaan het paneel en niet bovenaan: de keuze om van weg te wisselen komt
     nadat je hebt gezien wat de huidige weg van je vraagt, niet ervoor. Een
     tekstknop en geen tweede knop met vulling — er staat al een primaire actie
     op deze stap, en een tweede gevulde knop ernaast maakt twee hoofdacties.

     De reden staat ernaast en niet in een tooltip: dit is de plek waar iemand
     een keuze maakt die hem later een telefoontje kost. */
  .pu-swap {
    margin: clamp(1.4rem, 3vw, 2.1rem) 0 0;
    padding-top: clamp(1rem, 2vw, 1.4rem);
    border-top: 1px solid var(--line);
    display: flex; flex-wrap: wrap; align-items: baseline; gap: .3rem .7rem;
  }
  .pu-swap .hint { flex: 1 1 26ch; max-width: 62ch; margin: 0; }
  .pu-sub-h { font-size: 1.05rem; line-height: 1.3; }
  .pu-sub-lead { margin-top: .45rem; font-size: .9rem; color: var(--ink-3); line-height: 1.6; max-width: 66ch; }
  .pu-drop { margin-top: .9rem; border-radius: var(--r-md); }
  .pu-file-input { position: absolute; opacity: 0; pointer-events: none; width: 1px; height: 1px; }
  .pu-folder-row { margin-top: .7rem; display: flex; flex-wrap: wrap; align-items: baseline; gap: .2rem .7rem; }
  .pu-folder-hint { margin: 0; }
  .pu-link {
    background: none; border: 0; padding: 0;
    font: inherit; font-size: .86rem;
    color: var(--accent-bright); text-decoration: underline; text-underline-offset: 3px;
    cursor: pointer; border-radius: var(--r-sm);
  }
  .pu-link:focus-visible { outline: 2px solid var(--focus-ring); outline-offset: 3px; }

  /* ── Progress ─────────────────────────────────────────────────────────────
     One line, always about products. It is a live region, so it is deliberately
     short: a screen reader re-reads the whole thing on every change. */
  .pu-progress {
    margin-top: clamp(1.4rem, 3vw, 2rem);
    padding: .7rem .95rem;
    border: 1px solid var(--signal);
    border-radius: var(--r-md);
    background: var(--paper-2);
    color: var(--signal-ink);
    font-size: .9rem;
    line-height: 1.5;
  }
  .pu-progress:empty { display: none; }

  /* De tussenstap: één kader in de waarschuwingskleur, want het gaat over een
     gevolg en niet over een fout. Hairline, zoals het hele ontwerp. */
  .pu-missing {
    margin-top: 1rem;
    padding: 1rem 1.15rem;
    border: 1px solid var(--warn);
    border-radius: var(--r-md);
    background: var(--paper-2);
  }
  .pu-missing:focus { outline: 2px solid var(--focus-ring); outline-offset: 2px; }
  .pu-missing .pu-sub-h { color: var(--warn-ink); }
  .pu-missing-tik { margin: .35rem 0 0; }
  .pu-missing-raster {
    list-style: none; margin: .7rem 0 0; padding: 0;
    display: grid; grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); gap: .6rem;
  }
  /* Leeg komt in de praktijk niet voor — het paneel verschijnt alleen als er
     iets mist — maar een leeg raster mag geen marge overhouden. */
  .pu-missing-raster:empty { display: none; }
  /* ── DE TEGELS ──────────────────────────────────────────────────────────
     Gemaakt door askMissing(), dus `:global()`: een element dat tijdens het
     gebruik ontstaat draagt Astro's scope-attribuut niet. */
  .pu-missing :global(.pu-mis-tegel) {
    width: 100%; height: 100%; display: grid; gap: .3rem; justify-items: start; text-align: left;
    padding: .7rem .8rem; border: 1px solid var(--line); border-radius: var(--radius-s, 10px);
    background: var(--paper); color: inherit; font: inherit; cursor: pointer;
    transition: border-color .15s;
  }
  .pu-missing :global(.pu-mis-tegel:hover) { border-color: var(--ink); }
  .pu-missing :global(.pu-mis-tegel:focus-visible) { outline: 2px solid var(--focus-ring); outline-offset: 2px; }
  /* Een gat krijgt de inktrand. Niet de waarschuwingskleur: dit paneel staat er
     al in, en dan zouden twintig tegels het hele blok rood maken terwijl het om
     de twee gaat die er tussen staan. */
  .pu-missing :global(.pu-mis-tegel.is-gat) { border-color: var(--ink); }
  /* .72rem en niet de .66 van het prototype: onder 11,5 pixels houdt dit
     project op met lezen, en dat is precies de maat die daar nog boven zit. */
  .pu-missing :global(.pu-mis-nr) {
    font-family: var(--font-mono); font-size: .72rem; letter-spacing: .08em; color: var(--ink-3);
  }
  .pu-missing :global(.pu-mis-naam) { font-weight: 600; font-size: .88rem; line-height: 1.35; }
  .pu-missing :global(.pu-mis-wat) { font-size: .78rem; color: var(--ink-2); line-height: 1.5; }
  .pu-missing :global(.pu-mis-vakjes) { display: flex; gap: 4px; margin-top: .15rem; }
  .pu-missing :global(.pu-mis-vakjes i) {
    width: 11px; height: 11px; display: block;
    border: 1px solid currentColor; opacity: .3; border-radius: 2px;
  }
  .pu-missing :global(.pu-mis-vakjes i.is-vol) {
    background: var(--accent); border-color: var(--accent); opacity: 1;
  }
  /* Een gat is niet "niets", het is een vakje dat wacht: vollere rand, geen
     vulling. Zonder dit verschil lezen leeg en ontbrekend hetzelfde. */
  .pu-missing :global(.pu-mis-vakjes i.is-gat) { opacity: .9; border-width: 2px; }
  .pu-missing .pu-sub-lead { margin-top: .6rem; }
  .pu-missing-btns { display: flex; flex-wrap: wrap; gap: .6rem; margin-top: .9rem; }

  .pu-add-row { margin-top: 1rem; }

  /* Shown once, when the bucket refuses everything. Same object as
     OrderFlow.astro's .pl-note — declared here because that one is scoped to
     that component and this element is not in it. */
  .pu-off {
    margin: 1.2rem 0 0;
    padding: 1.05rem 1.25rem;
    border: 1px solid var(--warn);
    border-radius: var(--r-md);
    background: var(--paper-2);
    color: var(--warn-ink);
    font-size: .95rem;
    line-height: 1.55;
    max-width: 78ch;
  }

  /* ── The no-JS ending ─────────────────────────────────────────────────────*/
  .pu-later {
    margin-top: clamp(1.6rem, 3.4vw, 2.4rem);
    padding: clamp(1rem, 2.6vw, 1.5rem);
    border: 1px solid var(--signal);
    border-radius: var(--r-lg);
    background: var(--paper-2);
  }
  .pu-later .pu-sub-h { color: var(--signal-ink); }

  /* ═══════════════════════════════════════════════════════════════════════════
     GENERATED: the cards. Everything below is :global() under a scoped
     ancestor. See the note at the top of this sheet.
     ═══════════════════════════════════════════════════════════════════════════ */

  .pu-cards { list-style: none; margin: 1rem 0 0; padding: 0; display: grid; gap: .7rem; }

  /* ═══ DE RIJ ══════════════════════════════════════════════════════════════
     Zie de noot bij `data-pl-rij` in de markup hierboven. De kaart zelf is
     onaangeraakt; wat hier staat is de balk erboven en de twee pijlen eronder. */
  .pu-rij { margin-top: 1rem; display: grid; gap: .5rem; }
  /* De balk. Vierkantjes en geen bolletjes: een bolletjesrij leest als een
     carrousel ("er is hier iets moois te zien") en dit is een voortgangsmaat. */
  .pu-rail {
    list-style: none; margin: 0; padding: 0;
    display: flex; flex-wrap: wrap; gap: 5px;
  }
  .pu-rail-item { display: block; }
  /* 22 pixels en niet kleiner: dit is een aanraakdoel op een telefoon, en onder
     de 24 pixels wordt het op een duim een gokspel. Met de tussenruimte erbij
     komt het doel op 27 — de ondergrens die de toegankelijkheidskeuring van dit
     project aanhoudt voor een doel dat naast zijn buren staat. */
  .pu-rail-knop {
    display: block; width: 22px; height: 22px; padding: 0;
    border: 1px solid var(--line-strong); border-radius: 4px;
    background: var(--paper); cursor: pointer;
    transition: background .15s, border-color .15s, transform .15s;
  }
  .pu-rail-knop:hover { border-color: var(--ink); }
  .pu-rail-knop:focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; }
  /* Af: gevuld met het accent. Nu: een dikke inktrand, zodat "waar ben ik" en
     "wat is af" twee verschillende signalen zijn en niet één kleur die beide
     moet dragen. */
  .pu-rail-knop.is-af { background: var(--accent); border-color: var(--accent); }

  /* ── DE STREEPJES IN DE KNOP ──────────────────────────────────────────────
     Alleen bij een overzichtelijk aantal producten: zie paintRail() voor de
     grens en waarom hij er is. `:global()` omdat pipeline.js ze maakt. */
  .pu-rij :global(.pu-rail-vakjes) { display: none; gap: 2px; }
  .pu-rail-knop.heeft-vakjes { width: auto; min-width: 22px; padding: 0 3px; }
  .pu-rail-knop.heeft-vakjes :global(.pu-rail-vakjes) { display: flex; }
  .pu-rij :global(.pu-rail-vakjes i) {
    width: 3px; height: 10px; display: block;
    background: currentColor; opacity: .26;
    border-radius: 1px;
  }
  .pu-rij :global(.pu-rail-vakjes i.is-vol) { opacity: 1; }
  /* Op een afgeronde knop staat het accent al als vulling; de streepjes moeten
     daar de inkt dragen, anders is het geel op geel. */
  .pu-rail-knop.is-af :global(.pu-rail-vakjes i) { background: var(--ink); }
  .pu-rail-knop.is-nu { border-color: var(--ink); border-width: 2px; transform: scale(1.12); }
  /* De naam van het product zit in de knop voor een schermlezer; op het scherm
     doet het vierkantje het werk. `aria-label` draagt daarnaast de toestand. */
  /* ── TWEE KEER DEZELFDE REGEL, EN DAT MOET ────────────────────────────────
     Astro plakt bij de bouw `data-astro-cid-…` achter elk deel van een selector.
     De bovenste regel geldt dus alleen voor `.pu-sr` die HIER in de markup staat
     — het railvakje. Het woordje "Verplicht" naast het sterretje op een vakje
     wordt door pipeline.js gemaakt, draagt dat attribuut niet, en zou zonder de
     tweede regel gewoon zichtbaar op het scherm komen te staan.

     Dit is de vierde keer dat deze val in dit project toeslaat. Vandaar de
     regel in de kop van dit bestand: wat tijdens het gebruik verschijnt, wordt
     gekloond of gedekt door een `:global()`. */
  .pu-sr {
    position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0;
    overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0;
  }
  .pu-cards :global(.pu-sr) {
    position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0;
    overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0;
  }
  .pu-rij-tel { margin: 0; font-size: .82rem; color: var(--ink-2); font-variant-numeric: tabular-nums lining-nums; }

  /* ── DE TWEE PIJLEN ─────────────────────────────────────────────────────
     De reden staat ERTUSSEN en niet onder de knop: op het moment dat de
     vooruitknop uitstaat, is de vraag "waarom" — en die hoort op ooghoogte met
     de knop te staan, niet eronder waar je hem pas ziet na het klikken dat niet
     werkte. */
  .pu-nav {
    margin-top: .9rem; display: flex; flex-wrap: wrap; align-items: center; gap: .6rem 1rem;
  }
  .pu-nav-knop { display: inline-flex; align-items: center; gap: .45rem; }
  .pu-nav-knop .i { width: 1em; height: 1em; flex: none; }
  .pu-nav-knop:disabled { opacity: .45; cursor: not-allowed; }
  .pu-nav-reden { flex: 1 1 14ch; min-width: 0; margin: 0; }
  /* De vooruitknop rechts, de terugknop links, en de reden in het midden: op een
     telefoon valt de reden dan onder de twee knoppen in plaats van ertussen. */
  @media (max-width: 34rem) {
    .pu-nav { gap: .5rem; }
    .pu-nav-reden { flex-basis: 100%; order: 3; }
    .pu-nav-knop { flex: 1 1 auto; justify-content: center; }
  }
  @media (prefers-reduced-motion: reduce) {
    .pu-rail-knop { transition: none; }
    .pu-rail-knop.is-nu { transform: none; }
  }

  .pu-cards :global(.pu-card) {
    border: 1px solid var(--line-strong);
    border-radius: var(--r-lg);
    background: var(--surface);
    /* ── RUIMER — 17 september 2026 ────────────────────────────────────────
       Lucas: *"het voelt heel krap allemaal nu."* Gemeten stond de kaart op
       12,8 boven en 17,6 opzij; dat is de maat van een rij in een lijst, niet
       van het scherm waar de klant het echte werk doet. */
    padding: 1.35rem clamp(1.1rem, 2.4vw, 1.6rem) 1.5rem;
  }
  /* THE COLLAPSE. A card whose front photo is in has nothing left that needs
     asking, so it folds to one row — which is what makes a 25-product list
     scannable rather than a mile of identical boxes. It is not locked: the
     head is a disclosure, and the three optional shots are one tap away for as
     long as the customer wants them. */
  .pu-cards :global(.pu-card.is-collapsed) { padding-bottom: .8rem; }
  .pu-cards :global(.pu-card.is-collapsed .pu-slots) { display: none; }
  /* The question folds with the four slots, because they are the same
     disclosure: a collapsed card is one row, open or nothing. Twenty-five
     cards each showing a text field is the same mile of boxes the collapse
     exists to prevent. */
  /* ── DE LADE VOUWT MEE MET DE KAART — 9 september 2026 ───────────────────
     Sinds de herindeling zit alles wat kan afwijken in één `.pu-meer`, en die
     valt onder dezelfde uitklap als de vier vakken: een ingeklapte kaart is één
     regel, open of niets. De losse regels voor .pu-about, .pu-ratios, .pu-hoog
     en .pu-model die hier stonden, zijn daarmee overbodig — die blokken zitten
     nu in de lade. Ze zijn weg en niet op `display:none` gezet: een regel die
     niets meer verbergt maar wel blijft staan, is de vorm waarin dit over drie
     maanden per ongeluk terugkomt. */
  .pu-cards :global(.pu-card.is-collapsed .pu-meer) { display: none; }
  /* De verhouding per beeld vouwt mee met de vraag en de vier vakken: het is
     dezelfde uitklap, en de knop noemt ze alle drie in aria-controls. Alleen op
     lifestyle en complete aanwezig — buildRatios() in pipeline.js geeft null
     terug waar de dienst één verhouding voor de hele bestelling heeft. */
  .pu-cards :global(.pu-ratios) { margin-top: .8rem; }

  /* ═══════════════════════════════════════════════════════════════════════
     DE LADE — 9 september 2026

     Eén knop over de volle breedte met de samenvatting erop, en alles wat kan
     afwijken erin. Zie de lange noot bij buildMeer() in pipeline.js voor de
     meting die hiertoe leidde.

     GEEN KADER OM DE LADE. Hij hoort bij de kaart waar hij in staat; een tweede
     rand binnen een kaart maakt er een kaart-in-een-kaart van, en dat is precies
     de gestapelde vorm waar deze herindeling vanaf wilde. Eén haarlijn erboven
     is genoeg om te zeggen "hier houdt het werk op en begint de verfijning".
     ═══════════════════════════════════════════════════════════════════════ */
  /* ── STIL, MAAR NIET WEG — 9 september 2026 ──────────────────────────────
     De uitleg bij het plusje staat op kaart één en daarna niet meer; zie de
     noot in pipeline.js. `clip` en geen `display: none`, want de knop wijst er
     met aria-describedby naar en dat moet blijven werken voor wie het vakje met
     een schermlezer bereikt. */
  .pu-cards :global(.pu-ref-hint.is-stil),
  .pu-cards :global(.pu-ref-terug.is-stil) {
    position: absolute; width: 1px; height: 1px;
    margin: -1px; padding: 0; overflow: hidden;
    clip-path: inset(50%); white-space: nowrap;
  }

  .pu-cards :global(.pu-meer) { margin-top: .9rem; border-top: 1px solid var(--line); }
  .pu-cards :global(.pu-meer-knop) {
    display: flex; align-items: baseline; gap: .6rem; width: 100%;
    padding: .7rem 0 .1rem; margin: 0;
    background: none; border: 0; cursor: pointer; text-align: left;
    font: inherit; color: var(--ink-2);
  }
  .pu-cards :global(.pu-meer-t) { font-size: .82rem; font-weight: 600; color: var(--ink-2); flex: 0 0 auto; }
  /* De samenvatting is de reden dat deze knop bestaat, dus hij krijgt de ruimte
     en de rest schuift op. `min-width: 0` zodat een lange regel afbreekt in
     plaats van de pijl van de kaart af te duwen. */
  .pu-cards :global(.pu-meer-vat) {
    flex: 1 1 auto; min-width: 0;
    font-size: .82rem; line-height: 1.45; color: var(--ink-3);
  }
  /* Wijkt er iets af, dan is dat een FEIT over dit product en geen bijzin: het
     krijgt de leeskleur en een limoen stip ervoor, zodat je bij twintig kaarten
     in één blik ziet welke anders zijn. */
  .pu-cards :global(.pu-meer-vat.is-afwijkend) { color: var(--ink); font-weight: 600; }
  .pu-cards :global(.pu-meer-vat.is-afwijkend)::before {
    content: ''; display: inline-block; vertical-align: .08em;
    width: 6px; height: 6px; margin-right: .45rem; border-radius: 50%;
    background: var(--accent, #9EB42F);
  }
  .pu-cards :global(.pu-meer-pijl) { flex: 0 0 auto; width: 14px; height: 14px; color: var(--ink-3); transition: rotate .2s var(--ease, ease); }
  .pu-cards :global(.pu-meer-pijl svg) { width: 100%; height: 100%; display: block; }
  .pu-cards :global(.pu-meer-knop.is-open .pu-meer-pijl) { rotate: 180deg; }
  .pu-cards :global(.pu-meer-knop:hover .pu-meer-t) { color: var(--ink); }
  .pu-cards :global(.pu-meer-knop:focus-visible) { outline: 2px solid var(--ink); outline-offset: 2px; border-radius: var(--r-sm, 6px); }
  /* De inhoud krijgt de ruimte die de kaart erbuiten juist inlevert: dit is de
     plek waar iemand oplet, dus hier mag het ademen. */
  .pu-cards :global(.pu-meer-in) { display: grid; gap: 1.4rem; padding: 1rem 0 .4rem; }
  /* En de blokken erin dragen hun eigen scheiding niet meer: de `gap` hierboven
     doet dat, en een haarlijn per blok zou vier lijnen in één lade zetten. */
  .pu-cards :global(.pu-meer-in .pu-hoog),
  .pu-cards :global(.pu-meer-in .pu-model) { margin-top: 0; padding-top: 0; border-top: 0; }
  .pu-cards :global(.pu-meer-in .pu-ratios),
  .pu-cards :global(.pu-meer-in .pu-about) { margin-top: 0; }
  .pu-cards :global(.pu-ratios-h) { margin: 0; font-size: .82rem; font-weight: 600; color: var(--ink-2); }
  .pu-cards :global(.pu-ratios-hint) { margin: .15rem 0 0; font-size: .76rem; color: var(--ink-3); }

  /* ── 4K OP DIT PRODUCT — 9 september 2026 ─────────────────────────────────
     Eén vinkje per kaart, en het vouwt mee met de rest van de kaart. Een lijn
     erboven en niet een kader eromheen: het is een regel bij dit product, geen
     los blok — en een kader zou hem zwaarder maken dan de vier uploadvakken
     erboven, die het echte werk van deze kaart zijn. */
  .pu-cards :global(.pu-hoog) { margin-top: .9rem; padding-top: .8rem; border-top: 1px solid var(--line); }
  .pu-cards :global(.pu-hoog-rij) { display: flex; align-items: flex-start; gap: .55rem; cursor: pointer; }
  .pu-cards :global(.pu-hoog-rij input) { margin-top: .18rem; flex: 0 0 auto; }
  .pu-cards :global(.pu-hoog-t) { font-size: .82rem; font-weight: 600; color: var(--ink); }
  .pu-cards :global(.pu-hoog-hint) { margin: .25rem 0 0 1.6rem; font-size: .76rem; line-height: 1.5; color: var(--ink-3); }

  /* ── HET GEZICHT PER PRODUCT — 9 september 2026 ───────────────────────────
     Dezelfde vorm als de verhouding per beeld erboven: een kopje, een label en
     één keuzelijst, met de uitleg eronder. Geen tegels met foto's: de tien
     gezichten staan al als tegels in stap 1, en ze dertig keer herhalen is de
     muur die deze stap juist opruimt. */
  .pu-cards :global(.pu-model) { margin-top: .9rem; padding-top: .8rem; border-top: 1px solid var(--line); }
  .pu-cards :global(.pu-model-h) { margin: 0; font-size: .82rem; font-weight: 600; color: var(--ink-2); }
  .pu-cards :global(.pu-model-label) { display: block; margin: .5rem 0 .25rem; font-size: .78rem; color: var(--ink-3); }
  .pu-cards :global(.pu-model-sel) { width: 100%; max-width: 22rem; }
  .pu-cards :global(.pu-model-hint) { margin: .3rem 0 0; font-size: .76rem; line-height: 1.5; color: var(--ink-3); }
  /* auto-fit met een ruime minimum: drie beelden passen op een desktop naast
     elkaar en gaan op een telefoon onder elkaar, zonder mediaquery en zonder
     dat een lange optienaam de kolom uit loopt. */
  .pu-cards :global(.pu-ratios-row) {
    display: grid; gap: .5rem; margin-top: .5rem;
    grid-template-columns: repeat(auto-fit, minmax(min(190px, 100%), 1fr));
  }
  .pu-cards :global(.pu-ratio-q) { display: grid; gap: .2rem; }
  .pu-cards :global(.pu-ratio-label) { font-size: .76rem; color: var(--ink-3); }
  .pu-cards :global(.pu-ratio-field) { padding: .45rem .6rem; font-size: .86rem; border-radius: var(--r-md); }
  .pu-cards :global(.pu-card.is-ready) { border-color: var(--signal); }

  /* ── DE KOP IS ÉÉN REGEL — 17 september 2026 ──────────────────────────────
     Hij bestond uit vier dingen naast elkaar: een nummerchip, een omkaderd
     invoerveld, een chevron en daaronder de staatregel. In de rij is de helft
     daarvan overbodig geworden. Er staat nog maar één kaart in beeld, dus
     in- en uitklappen bestaat niet meer (pipeline.js verbergt de chevron al in
     rijmodus), en het nummer staat al in het balkje erboven.

     Wat overblijft is wat het concept liet zien: een klein nummer, en de naam
     als een regel waarop je schrijft. Een onderstreepte regel en geen doosje —
     zoals je op papier een naam op een lijn zet. Het kader eromheen zei alleen
     maar "dit is een formulierveld", en dat wist je al.

     `.input` is een globale primitieve met een eigen rand, achtergrond en
     ronding; die worden hier alle drie teruggedraaid. Expliciet en niet met
     `all: unset`, want de primitieve levert ook de focusring en de
     tekstkleur, en die wil ik juist houden. */
  .pu-cards :global(.pu-head) {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: baseline;
    gap: .35rem .8rem;
  }
  .pu-cards :global(.pu-n) {
    font-family: var(--font-mono); font-weight: 400; font-size: .72rem;
    letter-spacing: .08em; color: var(--ink-3); font-variant-numeric: tabular-nums;
  }
  .pu-cards :global(.pu-name) {
    padding: .2rem 0;
    font-size: clamp(1.05rem, 2.2vw, 1.35rem); font-weight: 600; letter-spacing: -.01em;
    border: 0; border-bottom: 1px solid var(--line); border-radius: 0;
    background: none;
  }
  .pu-cards :global(.pu-name:focus-visible),
  .pu-cards :global(.pu-name:focus) { outline: none; border-bottom-color: var(--ink); }
  .pu-cards :global(.pu-name::placeholder) { font-weight: 400; color: var(--ink-3); }

  .pu-cards :global(.pu-state) {
    grid-column: 2 / -1;
    display: flex; flex-wrap: wrap; align-items: center; gap: .5rem;
    font-size: .76rem; color: var(--ink-3);
  }
  .pu-cards :global(.pu-card.is-ready .pu-state) { color: var(--signal-ink); }

  /* The disclosure. A real button with aria-expanded, and a tap target that
     clears 44px on a phone without drawing a second box around itself. */
  .pu-cards :global(.pu-toggle) {
    grid-row: 1; grid-column: 3;
    min-width: 44px; min-height: 44px;
    display: inline-flex; align-items: center; justify-content: center;
    background: none; border: 1px solid var(--line);
    border-radius: var(--r-md);
    color: var(--ink-2); cursor: pointer;
    font: inherit; font-size: .8rem;
    transition: border-color var(--dur-1) var(--ease);
  }
  .pu-cards :global(.pu-toggle:hover) { border-color: var(--accent-line); }
  .pu-cards :global(.pu-toggle:focus-visible) { outline: 2px solid var(--focus-ring); outline-offset: 2px; }
  .pu-cards :global(.pu-toggle > svg) { width: 14px; height: 14px; transition: transform var(--dur-1) var(--ease); }
  .pu-cards :global(.pu-card:not(.is-collapsed) .pu-toggle > svg) { transform: rotate(180deg); }

  /* ── The four slots ───────────────────────────────────────────────────────
     Four across on a desktop, two across on a phone. Two rather than four is
     the whole mobile decision: at 390px four columns is a 72px square, which
     clears the 44px tap minimum and then has nowhere to put a word. */
  .pu-cards :global(.pu-slots) {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    /* .9rem en niet .5: vier vakken met 8 pixels ertussen lezen als één
       geblokte strook. Met 14 zijn het vier vakken. */
    gap: .9rem;
    margin-top: 1.1rem;
  }
  .pu-cards :global(.pu-slot) {
    display: flex; flex-direction: column; gap: .3rem;
    min-width: 0;
  }

  /* ── HET PLUSJE: NOG EEN FOTO, GRATIS — 13 augustus 2026 ──────────────────
     Lucas: *"een plusje naast de 4 aanbevolen foto’s"*, en dat is letterlijk waar
     hij staat: als vijfde cel van hetzelfde raster, in dezelfde maat als de vier
     ernaast. Een knop erboven of eronder zou een nieuwe vraag lijken; hier leest
     hij als "en dit vakje mag er ook nog bij".

     ZACHTER DAN EEN UPLOADVAK, want dit is een aanbod en geen verzoek. Dunnere
     rand, geen streepjes: de streepjesrand betekent op deze kaart "hier hoort een
     foto en die is er nog niet", en dat is precies wat dit NIET is. */
  /* ── DE GRATIS REFERENTIEVAKKEN, IN EEN EIGEN STROOK ──────────────────────
     17 september 2026. Ze stonden als vijfde cel in het raster hierboven, even
     groot als een uploadvak. Sinds de vier vakken staande beelden van 3/4 zijn
     geworden, maakt een vijfde van dat formaat van een AANBOD een vijfde
     VERZOEK — en dat is precies wat deze vakken niet zijn.

     Duimnagels van 78 pixels, vierkant, onder een eigen regel. Klein genoeg om
     te lezen als "en dit mag er ook nog bij", groot genoeg om een foto in te
     herkennen en om met een vinger te raken (78 > 44). */
  .pu-cards :global(.pu-refs) {
    display: grid; gap: .45rem;
    margin-top: .9rem; padding-top: .8rem;
    border-top: 1px solid var(--line);
  }
  .pu-cards :global(.pu-refs-rij) { display: flex; flex-wrap: wrap; align-items: flex-start; gap: .5rem; }

  /* ── HET GEZICHT PER PRODUCT ────────────────────────────────────────────────
     Een rij duimnagels op de kaart en geen keuzelijst in de lade: zie de noot
     bij het <template> hierboven. De tegels worden door pipeline.js gekloond,
     dus alles hieronder staat onder `:global()`.

     Klein houden is de opgave — Lucas: *"dit hoeft niet groot"*. Een tegel is
     52 pixels breed; met elf gezichten is dat één regel die opzij schuift, geen
     tweede raster op elke kaart. */
  .pu-cards :global(.pu-mk) {
    margin-top: 1rem; padding-top: .9rem;
    border-top: 1px solid var(--line);
    display: grid; gap: .45rem;
  }
  .pu-cards :global(.pu-mk-h) {
    margin: 0; font-family: var(--font-mono);
    font-size: .72rem; letter-spacing: .04em; text-transform: uppercase; color: var(--ink-3);
  }
  /* Eén regel die opzij schuift. `scroll-snap` zodat een tegel nooit half in
     beeld blijft staan, en ruimte onderaan voor de schuifbalk op een muis. */
  .pu-cards :global(.pu-mk-rij) {
    display: flex; gap: .45rem;
    overflow-x: auto; scroll-snap-type: x proximity;
    padding-bottom: .35rem; margin-bottom: -.35rem;
    scrollbar-width: thin;
  }
  .pu-cards :global(.pu-mk-tegel) {
    position: relative;
    flex: 0 0 auto; width: 52px; scroll-snap-align: start;
    display: grid; gap: .25rem; cursor: pointer;
    border-radius: var(--radius-s, 8px);
  }
  /* De radio blijft bereikbaar met een toetsenbord — weggeknipt en niet
     `display: none`, want dat haalt hem uit de tabvolgorde én uit de groep. */
  .pu-cards :global(.pu-mk-radio) {
    position: absolute; width: 1px; height: 1px;
    margin: -1px; padding: 0; overflow: hidden; clip-path: inset(50%);
  }
  .pu-cards :global(.pu-mk-beeld) {
    display: block; width: 100%; aspect-ratio: 3 / 4; object-fit: cover;
    border-radius: var(--radius-s, 8px);
    background: var(--surface-2);
    box-shadow: inset 0 0 0 1px var(--line-strong);
    transition: box-shadow .15s;
  }
  /* De stille "Zelfde"-tegel zonder portret: zelfde maat en ring als een
     portret, met een =-teken. Gekozen krijgt dezelfde accentring. */
  .pu-cards :global(.pu-mk-leeg) {
    display: grid; place-items: center; width: 100%; aspect-ratio: 3 / 4;
    border-radius: var(--radius-s, 8px); background: var(--surface-2);
    box-shadow: inset 0 0 0 1px var(--line-strong);
    font-family: var(--font-display); font-weight: 500; font-size: 1.3rem; color: var(--ink-3);
    transition: box-shadow .15s;
  }
  .pu-cards :global(.pu-mk-tegel:has(input:checked) .pu-mk-leeg) {
    box-shadow: inset 0 0 0 2px var(--accent), 0 0 0 1px var(--accent); color: var(--ink);
  }
  .pu-cards :global(.pu-mk-tegel:hover .pu-mk-leeg) { box-shadow: inset 0 0 0 2px var(--line-strong); }
  .pu-cards :global(.pu-mk-tegel:has(input:focus-visible) .pu-mk-leeg) { outline: 2px solid var(--focus-ring); outline-offset: 2px; }
  .pu-cards :global(.pu-mk-naam) {
    font-size: .72rem; line-height: 1.25; color: var(--ink-3);
    overflow: hidden; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2;
  }
  /* Gekozen: dezelfde accentring als een tegel in de grote kiezer, zodat "dit
     staat aan" er op beide plekken hetzelfde uitziet. */
  .pu-cards :global(.pu-mk-tegel:has(input:checked) .pu-mk-beeld) {
    box-shadow: inset 0 0 0 2px var(--accent), 0 0 0 1px var(--accent);
  }
  .pu-cards :global(.pu-mk-tegel:has(input:checked) .pu-mk-naam) { color: var(--ink); font-weight: 600; }
  .pu-cards :global(.pu-mk-tegel:hover .pu-mk-beeld) { box-shadow: inset 0 0 0 2px var(--line-strong); }
  .pu-cards :global(.pu-mk-tegel:has(input:focus-visible) .pu-mk-beeld) {
    outline: 2px solid var(--focus-ring); outline-offset: 2px;
  }
  /* De naam onder de eerste tegel is de langste ("Zelfde als de bestelling" is
     in de toegankelijke naam te vinden) en mag niet de rij hoger maken. */
  .pu-cards :global(.pu-mk-hint) { margin: 0; }
  @media (prefers-reduced-motion: reduce) {
    .pu-cards :global(.pu-mk-beeld) { transition: none; }
  }
  /* De vakken in de strook krijgen het kleine formaat, en niet de staande
     3/4 van de vier hierboven. Alles wat eraan hangt — slepen, vervangen,
     weghalen — blijft hetzelfde; alleen de maat verschilt. */
  .pu-cards :global(.pu-refs .pu-slot) { width: 92px; gap: .25rem; }
  .pu-cards :global(.pu-refs .pu-slot-btn) { aspect-ratio: 1; padding: .3rem; }
  .pu-cards :global(.pu-refs .pu-slot-dia) { width: 16px; height: 16px; }
  /* .72rem = 11.5px, de ondergrens die op deze site geldt voor tekst die
     gelezen moet worden. Vandaar ook 92 en geen 78 pixels breed: "Referentie 1"
     en "Nog een foto" moeten er in twee regels in passen zonder af te breken. */
  .pu-cards :global(.pu-refs .pu-slot-name) {
    font-family: var(--font-mono); font-size: .72rem; font-weight: 400;
    letter-spacing: .04em; text-transform: uppercase; color: var(--ink-3);
  }

  /* Het plusje heeft dezelfde bouw als een referentievakje ernaast: een
     vierkant waar de foto zou komen, met het woord eronder. De RAND zit op het
     vierkant en niet op de knop, anders staat het bijschrift binnen het kader
     en leest de knop weer als een doosje met tekst erin — precies wat deze
     ronde bij de vier vakken hierboven heeft weggehaald. */
  .pu-cards :global(.pu-ref-add) {
    display: grid; gap: .25rem;
    width: 92px;
    padding: 0; border: 0; background: none;
    color: var(--ink-3);
    font: inherit; line-height: 1.3; text-align: left;
    cursor: pointer;
  }
  .pu-cards :global(.pu-ref-plus) {
    display: grid; place-items: center;
    width: 100%; aspect-ratio: 1;
    border: 1px dashed var(--line);
    border-radius: var(--r-md);
    font-size: 1.2rem; line-height: 1; font-weight: 400;
    transition: border-color var(--dur-1) var(--ease), color var(--dur-1) var(--ease);
  }
  .pu-cards :global(.pu-ref-add:hover .pu-ref-plus) { border-color: var(--ink); color: var(--ink-2); }
  .pu-cards :global(.pu-ref-add:focus-visible) { outline: 2px solid var(--focus-ring); outline-offset: 3px; border-radius: var(--r-sm); }
  .pu-cards :global(.pu-ref-add-label) {
    font-family: var(--font-mono); font-size: .72rem;
    letter-spacing: .04em; text-transform: uppercase; color: var(--ink-3);
  }
  /* De uitleg loopt over de HELE breedte en niet onder het plusje: "je krijgt nog
     steeds 4 beelden" is de zin die de verwachting recht zet, en in een kolom van
     78 pixels breed wordt hij zes regels die niemand leest. */
  .pu-cards :global(.pu-ref-hint) {
    margin: 0;
    font-size: .82rem; color: var(--ink-2); line-height: 1.45;
  }
  .pu-cards :global(.pu-ref-lead) { color: var(--ink); font-weight: 600; margin-right: .2em; }
  /* De weg terug naar stap 1, onder de strook. Een tint lichter dan de uitleg
     erboven: die zin gaat over wat je hier doet, deze wijst ergens anders heen
     en hoort daar niet mee te wedijveren. Niet kleiner dan .78rem — dat is de
     leesbaarheidsondergrens van dit project. */
  .pu-cards :global(.pu-ref-terug) {
    margin: .55rem 0 0;
    font-size: .78rem; color: var(--ink-3); line-height: 1.55;
  }
  /* Even hoog, allemaal. De vier vakjes hebben teksten van verschillende lengte
     en dus vier verschillende hoogtes — waardoor "Sla deze over" eronder op vier
     hoogtes stond en de rij er rommelig uitzag. Het vakje rekt nu mee met de
     hoogste van de rij. */
  /* ── DE KNOP IS HET BEELD — 17 september 2026 ─────────────────────────────
     Lucas: *"Ik vind die nieuwe juist wel rustiger ogen."*

     Hiervoor was de knop een kadertje met de tekening, de naam, twee regels
     uitleg en een badge er allemaal IN. Vier daarvan naast elkaar leest als
     vier blokjes tekst. Nu is de knop niets anders dan de plek waar de foto
     komt, en staan de woorden eronder als bijschrift — zie buildSlot() in
     pipeline.js voor de kant van de DOM.

     3/4, want dat is de verhouding waarin kleding gefotografeerd wordt, en het
     is dezelfde verhouding die het vakje straks vult zodra er een foto in zit.
     Een vak dat van vorm verandert zodra je hem vult, springt.

     GEEN VULLING. De rust komt voor een groot deel hiervandaan: vier grijze
     vlakken naast elkaar zijn vier objecten, vier omlijnde open plekken zijn
     één rij. Alleen bij slepen kleurt hij op, en dan is die kleur informatie. */
  .pu-cards :global(.pu-slot) { display: flex; flex-direction: column; gap: .55rem; }

  .pu-cards :global(.pu-slot-btn) {
    position: relative;
    display: grid; place-items: center;
    width: 100%; aspect-ratio: 3 / 4;
    padding: .6rem .4rem;
    border: 1px dashed var(--line-strong);
    border-radius: var(--r-md);
    background: none;
    color: var(--ink-3);
    font: inherit;
    cursor: pointer;
    overflow: hidden;
    transition: border-color var(--dur-1) var(--ease), color var(--dur-1) var(--ease), background var(--dur-1) var(--ease);
  }
  /* Doorlopend = we wachten hierop. Onderbroken = het mag ontbreken. Hetzelfde
     onderscheid dat het concept maakt, en het enige verschil dat je nog zonder
     lezen ziet nu de gevulde badge weg is. */
  .pu-cards :global(.pu-slot[data-req="1"] .pu-slot-btn) { border-style: solid; }
  .pu-cards :global(.pu-slot-btn:hover) { border-color: var(--ink); color: var(--ink-2); }
  .pu-cards :global(.pu-slot-btn:focus-visible) { outline: 2px solid var(--focus-ring); outline-offset: 2px; }
  .pu-cards :global(.pu-slot.is-over .pu-slot-btn) { border-color: var(--accent); background: var(--accent-soft); }
  /* Het plusje. 22 pixels, zoals op /concept/bestelrij — groot genoeg om te
     zien dat er iets hoort, klein genoeg om de open plek open te laten. */
  .pu-cards :global(.pu-slot-dia) { display: block; width: 22px; height: 22px; color: var(--ink-3); }
  .pu-cards :global(.pu-slot-dia svg) { width: 100%; height: 100%; display: block; }

  /* ── NAAM EN EIS OP ÉÉN REGEL ─────────────────────────────────────────────
     Precies de vorm die stap 3 boven elk invoerveld gebruikt: de naam, en er
     direct achter in klein kapitaal of hij moet. Dat is geen toevallige
     gelijkenis maar het punt van deze ronde — het formulier hoorde overal
     dezelfde taal te spreken en dit vakje was de enige plek die het anders
     deed. */
  .pu-cards :global(.pu-slot-woord) {
    display: flex; align-items: baseline; flex-wrap: wrap; gap: .1rem .5rem;
    min-width: 0;
  }
  /* ── EN DIT IS HET BIJSCHRIFT UIT HET CONCEPT ─────────────────────────────
     Tussenstand van 17 september: ik had hier eerst het VELDLABEL van stap 3
     neergezet — alles in mono kapitaal met een sterretje erachter — omdat het
     formulier overal dezelfde taal hoort te spreken. Dat klopte als redenering
     en was lelijk in de praktijk: vier regels kapitaal onder vier foto's leest
     als vier kopjes, en de foto's raken hun bijschrift kwijt.

     Lucas, met beide platen naast elkaar: *"Ik vind het huidige beeld zo lelijk,
     pas deze toch aan naar degene met de roze broek."*

     Dus: de naam in gewone letters met gewicht, en de eis er klein in kapitaal
     achter. Een bijschrift onder een foto, niet een kop boven een veld. Het
     verschil met stap 3 is nu een bewuste keuze en geen slordigheid — daar staat
     een label BOVEN een leeg veld en moet het opvallen, hier staat het ONDER een
     beeld dat het al uitlegt.

     .72rem en niet de .64rem van het concept: 10,2 pixels viel onder de
     leesbaarheidsgrens die op deze site geldt. Bij kapitaal mono is het verschil
     op het scherm nauwelijks te zien en gelezen wordt het wel. */
  .pu-cards :global(.pu-slot-name) { font-size: .95rem; font-weight: 600; color: var(--ink); }
  .pu-cards :global(.pu-slot-eis) {
    font-family: var(--font-mono); font-size: .72rem; font-weight: 400;
    letter-spacing: .07em; text-transform: uppercase; color: var(--ink-3);
  }
  /* 1,6 en niet 1,45: dit is de enige lopende tekst op de kaart en hij staat in
     een kolom van een kwart breed, dus hij breekt sowieso in vier of vijf
     regels. Die regels moeten dan wel uit elkaar staan. */
  .pu-cards :global(.pu-slot-how) { font-size: .82rem; color: var(--ink-2); line-height: 1.6; }
  .pu-cards :global(.pu-slot.is-thumb .pu-slot-how) { display: none; }
  .pu-guide-fold { margin-top: clamp(1.4rem, 3vw, 2rem); max-width: var(--pl-measure); }
  .pu-guide-eg { width: 72px; height: 90px; object-fit: cover; border-radius: var(--r-sm); flex: none; }
  /* .pu-slot-req — de gevulde VERPLICHT-badge in de hoek — is op 17 september
     2026 vervangen door .pu-slot-eis onder het beeld. Zie het blok hierboven. */

  /* FILLED. The photograph fills the box and the drawing goes — the drawing was
     the instruction and the instruction has been followed.

     .is-thumb, NOT the state, is what swaps them, and the difference matters on
     a phone: a HEIC straight off an iPhone is a file this browser cannot decode,
     so the <img> never paints. The slot is still filled, still uploading and
     still correct — it just has no picture to show, and in that case the drawing
     has to stay. pipeline.js sets the class from the image's own load/error, so
     what is on screen is what the browser actually managed to render. */
  .pu-cards :global(.pu-slot-img) {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    border-radius: calc(var(--r-md) - 1px);
  }
  /* ── EEN VOORBEELD OM IETS AAN TE ZIEN — 10 september 2026 ─────────────────
     Lucas: *"ik wil als een klant een productfoto upload dat hij die foto ook
     kan zien om overzicht te houden [...] of het wel de goede was."*

     Het vakje is 96px hoog omdat het LEEG een tekening en een woord draagt, en
     bij vijfentwintig producten is honderd keer 96px al een lange stap. Met een
     foto erin is diezelfde maat een liggende strook van ongeveer 200 bij 94 —
     en `object-fit: cover` snijdt daar bij een staande productfoto de kop en de
     zoom vanaf. Je ziet dat er íets in zit; je ziet niet wélke.

     Dus: alleen een vakje MET voorbeeld krijgt een staande verhouding. Leeg
     blijft het vakje zo klein als het was, dus de stap wordt niet langer voor
     wie nog niets geüpload heeft — hij groeit precies daar waar er iets te
     zien is. 4:5 en niet 1:1, omdat kleding staand gefotografeerd wordt en een
     vierkant er nog steeds bovenaan en onderaan af haalt.

     De rij trekt zichzelf gelijk (grid), dus een vakje zonder voorbeeld — een
     HEIC die deze browser niet kan tekenen — groeit mee en houdt zijn vinkje
     gecentreerd. */
  /* ── EN SINDS 17 SEPTEMBER 2026 HOEFT DAT NIET MEER ───────────────────────
     Het stuk hierboven beschrijft een vakje dat LEEG klein was (96px hoog) en
     GEVULD naar 4:5 groeide, zodat de stap niet langer werd voor wie nog niets
     had geüpload. Dat probleem is verdwenen met de herindeling: het vakje is nu
     altijd 3/4, leeg zowel als vol, want de woorden staan eronder en nemen geen
     hoogte meer weg uit het beeld.

     Twee verhoudingen zijn nu bovendien schadelijk in plaats van nuttig: een
     vak dat 3/4 is zolang het leeg is en 4:5 zodra de foto binnen is, verspringt
     op het moment dat de klant net iets heeft neergezet — precies het moment
     waarop je hem niet wilt laten schrikken. Eén verhouding, altijd.

     De naam hoeft ook niet meer over de foto heen: hij staat nu ONDER het
     beeld, dus er is geen chipje meer nodig om hem leesbaar te houden. */
  .pu-cards :global(.pu-slot[data-state="filled"] .pu-slot-btn),
  .pu-cards :global(.pu-slot[data-state="sending"] .pu-slot-btn) { border-style: solid; border-color: var(--line-strong); }
  /* ── DE WEGHAALKNOP OP DE LAATSTE KAART ─────────────────────────────────── */
  .pu-cards :global(.pu-weg) {
    grid-column: 2 / -1; justify-self: start;
    margin-top: .1rem;
    font: inherit; font-size: .78rem; font-weight: 600;
    padding: .25rem .1rem;
    border: 0; background: none; color: var(--ink-3);
    text-decoration: underline; text-underline-offset: 3px;
    cursor: pointer;
  }
  .pu-cards :global(.pu-weg:hover) { color: var(--warn-ink, var(--ink)); }
  .pu-cards :global(.pu-weg:focus-visible) { outline: 2px solid var(--focus-ring); outline-offset: 2px; border-radius: var(--r-sm); }

  /* GEVULD, MAAR ZONDER VOORBEELD. De tekening blijft (er is niets anders te
     tonen) maar zakt weg, de uitleg verdwijnt — die is gevolgd — en er komt een
     vinkje overheen. Zonder dit verschil ziet een vakje met een HEIC erin er
     hetzelfde uit als een vakje waar nog niets in zit. */
  .pu-cards :global(.pu-slot-vink) {
    position: absolute; inset: 0; display: none; place-items: center;
    background: color-mix(in oklab, var(--accent) 12%, transparent);
  }
  .pu-cards :global(.pu-slot-vink svg) {
    width: 26px; height: 26px; fill: none; stroke: var(--accent); stroke-width: 2.5;
    stroke-linecap: round; stroke-linejoin: round;
  }
  .pu-cards :global(.pu-slot[data-state="filled"]:not(.is-thumb) .pu-slot-vink) { display: grid; }
  .pu-cards :global(.pu-slot[data-state="filled"]:not(.is-thumb) .pu-slot-dia) { opacity: .28; }
  .pu-cards :global(.pu-slot[data-state="filled"]:not(.is-thumb) .pu-slot-how) { display: none; }
  .pu-cards :global(.pu-slot[data-state="filled"]:not(.is-thumb) .pu-slot-btn) { border-color: var(--accent-line); }
  .pu-cards :global(.pu-slot[data-state="filled"]:not(.is-thumb) .pu-slot-name) { position: relative; z-index: 1; }
  /* Offscreen rather than display:none: one per slot, and a hidden input is
     what the slot button, the Replace action and the tray's menu all end up
     clicking. */
  .pu-cards :global(.pu-slot-input) {
    position: absolute; opacity: 0; pointer-events: none; width: 1px; height: 1px;
  }
  .pu-cards :global(.pu-slot[data-state="skipped"] .pu-slot-btn) { opacity: .5; border-style: dotted; }
  .pu-cards :global(.pu-slot[data-state="failed"] .pu-slot-btn) { border-color: var(--warn); border-style: solid; }

  .pu-cards :global(.pu-slot-bar) { display: block; height: 2px; background: var(--line); border-radius: var(--r-sm); overflow: hidden; }
  .pu-cards :global(.pu-slot-bar > i) {
    display: block; height: 100%; width: 100%;
    transform: scaleX(0); transform-origin: left;
    background: var(--accent);
    transition: transform var(--dur-1) var(--ease);
  }
  .pu-cards :global(.pu-slot[data-state="filled"] .pu-slot-bar > i) { background: var(--signal); }
  /* .72rem en niet .7rem: 11.2 pixels viel net onder de leesbaarheidsgrens die
     op deze site geldt, en dit is de regel waarin een foutmelding staat. */
  .pu-cards :global(.pu-slot-msg) { font-size: .72rem; color: var(--ink-3); line-height: 1.45; overflow-wrap: anywhere; }
  .pu-cards :global(.pu-slot[data-state="failed"] .pu-slot-msg) { color: var(--warn-ink); }
  /* ── DE BEELDKEURING LEEST ALS EEN OPMERKING EN NIET ALS EEN FOUT ──────────
     `data-let` staat op een vakje waarvan de foto DOOR is en waar alleen iets
     over te zeggen valt: te donker, of ver gecomprimeerd. Zie keurBeeld() in
     src/data/shots.js voor waarom die twee melden en niet weigeren.

     Vandaar --ink-2 en niet --warn-ink: een klant die een donkere foto stuurt
     heeft niets fout gedaan, en een waarschuwingskleur op een geslaagde upload
     zet hem aan het zoeken naar een probleem dat er niet is. Wat het wél doet is
     iets meer contrast dan de gewone --ink-3, zodat de zin niet wegvalt tussen
     "geüpload" en de bestandsnaam. */
  .pu-cards :global(.pu-slot[data-let="1"] .pu-slot-msg) { color: var(--ink-2); }

  .pu-cards :global(.pu-acts) { display: flex; flex-wrap: wrap; gap: .1rem .6rem; }
  .pu-cards :global(.pu-act) {
    background: none; border: 0; padding: .2rem 0;
    font: inherit; font-size: .72rem;
    color: var(--accent-bright);
    text-decoration: underline; text-underline-offset: 3px;
    cursor: pointer; border-radius: var(--r-sm);
  }
  .pu-cards :global(.pu-act:focus-visible) { outline: 2px solid var(--focus-ring); outline-offset: 2px; }

  /* ── GENERATED: the product question ──────────────────────────────────────
     LABEL AND CONTROL, AND NOTHING ELSE. The `buys` sentence is in
     .pu-about-guide at the top of the step, once, and every control on every
     card reaches it with aria-describedby (and repeats it in `title` for a
     pointer). One explanation printed on twenty-five cards is twenty-five
     paragraphs; one id referenced from twenty-five cards is one.

     Still a grid rather than a block: auto-fit gives the single field the full
     card width today and lays a second one beside it without a rewrite. 190px
     is where the material placeholder stops wrapping mid-word. */
  .pu-cards :global(.pu-about) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(190px, 100%), 1fr));
    gap: .55rem .7rem;
    margin-top: .85rem;
    padding-top: .8rem;
    border-top: 1px solid var(--line);
  }
  .pu-cards :global(.pu-q) { display: flex; flex-direction: column; gap: .28rem; min-width: 0; }
  .pu-cards :global(.pu-q-label) {
    font-size: .74rem; font-weight: 600; line-height: 1.3;
    color: var(--ink-2);
  }
  /* .input and .select are global primitives and both already clear 40px; this
     only trims them to the card's scale, the way .pu-name trims .input. The
     min-height is restated so a future padding edit cannot quietly drop a
     control under the tap minimum. */
  .pu-cards :global(.pu-q-field) {
    padding: .5rem .7rem;
    font-size: .88rem;
    min-height: 40px;
    border-radius: var(--r-md);
  }
  /* The gap global.css leaves for the caret. The shorthand above would drop it,
     which is the same trap .select itself has to re-state its way out of. */
  .pu-cards :global(select.pu-q-field) { padding-right: 2.4rem; }

  /* The colour swatch, for the question that carries one. Positioned rather
     than added to the flex column: the field is label-over-control, and a third
     child would push the swatch onto its own line under the input. Sitting it
     inside the control's right edge keeps the row one line tall and reads as
     part of the field rather than as a fourth thing. */
  .pu-cards :global(.pu-q-has-swatch) { position: relative; }
  .pu-cards :global(.pu-q-swatch) {
    position: absolute;
    right: .55rem;
    bottom: 10px;
    width: 20px;
    height: 20px;
    border-radius: var(--r-sm);
    background: var(--swatch, transparent);
    box-shadow: inset 0 0 0 1px var(--line-strong);
    pointer-events: none;
  }
  /* The input has to give the swatch its room, or a long hex sits under it. */
  .pu-cards :global(.pu-q-has-swatch .pu-q-field) { padding-right: 2.2rem; }
  .pu-cards :global(.pu-q-swatch[hidden]) { display: none !important; }

  /* ── Extra photos ─────────────────────────────────────────────────────────
     Its own hairline row under the questions, because it is a different KIND
     of answer: material describes the product, this buys something. Grouping
     it with the questions would read as a fifth thing we need to know rather
     than as a thing the customer is choosing to add.

     The counter is narrow and the description takes the rest of the row, so a
     card with no extras is a label and a "0" — the smallest shape this control
     can have while still being visible on every product, which is what asking
     per product requires. Built by pipeline.js, so every selector here is
     :global(); the wrapper is the one element this sheet can reach directly. */
  /* ── EEN BLOK MET EEN PRIJSKAARTJE — 4 september 2026 ─────────────────────
     Zie de noot bij buildExtras() in pipeline.js. Wat hier veranderde: een
     eigen omkaderd vlak in plaats van een streep, een kop op leesformaat, het
     tarief op leesformaat direct onder de kop, en een accentrand zodra er
     daadwerkelijk iets bijbesteld is. */
  .pu-cards :global(.pu-extra) {
    /* Over de VOLLE breedte van de kaart, niet als derde kolom naast de twee
       vragen: het is geen extra vraagje maar een bijbestelling, en in een kolom
       van 190px kreeg elke beschrijvingsregel zes regels. */
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: minmax(5.5rem, 7rem) minmax(0, 1fr);
    gap: .35rem .7rem;
    align-items: start;
    margin-top: 1rem;
    padding: .85rem .9rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--r-md);
    background: var(--paper-2);
    transition: border-color var(--dur-1) var(--ease), background var(--dur-1) var(--ease);
  }
  .pu-cards :global(.pu-extra.is-aan) { border-color: var(--accent-line); background: var(--accent-soft); }
  .pu-cards :global(.pu-extra-h) {
    grid-column: 1 / -1;
    font-family: var(--font-display); font-weight: 800;
    font-size: .95rem; line-height: 1.25;
    color: var(--ink);
  }
  /* Wat je koopt, in gewone leesmaat. Dit stond in .68rem grijs onder de velden. */
  .pu-cards :global(.pu-extra-wat) {
    grid-column: 1 / -1; margin: .1rem 0 .35rem;
    font-size: .8rem; line-height: 1.5; color: var(--ink-3); max-width: 62ch;
  }
  /* Het bedrag, niet het tarief. Verschijnt pas als er iets gekozen is. */
  .pu-cards :global(.pu-extra-som) {
    grid-column: 1 / -1; margin: .1rem 0 0;
    font-size: .88rem; font-weight: 700; line-height: 1.45;
    color: var(--ink);
    font-variant-numeric: tabular-nums lining-nums;
  }
  .pu-cards :global(.pu-extra-count) { grid-column: 1; }

  /* ── EEN RIJ PER BIJBESTELDE FOTO (augustus 2026) ─────────────────────────
     Hier stond één beschrijvingsveld naast de teller. Sinds er per extra foto
     een uploadvak én een eigen notitie is, is dat een lijst geworden en niet
     langer een tweede kolom — dus de rijen lopen over de volle breedte en het
     uploadvak staat links van zijn eigen notitie.

     Waarom het slot een vaste breedte krijgt en de notitie de rest: het slot is
     een miniatuur met een vaste verhouding (zie .pu-slot), de notitie is
     leestekst. Ze omgekeerd laten rekken zou een klein plaatje uitrekken en een
     zin in een kolom van vijf woorden persen. */
