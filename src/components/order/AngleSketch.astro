---
/*
 * VISUAILS — de schets bij een extra hoek (de hoekenkiezer in stap 1 en /per-product).
 *
 * ── OPNIEUW GETEKEND — 15 oktober 2026 ──────────────────────────────────────
 * Lucas (afvinklijst 27, en daarna bij de hoekenkiezer): *"De add angle schetsen
 * kunnen ook aanzienlijk verbeterd worden en een volledige redesign krijgen."* en
 * *"Maak de extra angles in dezelfde style als deze"* — de schetsen in het
 * zijpaneel "Wat je krijgt". Hier stonden acht tekeningen in eigen SVG, met een
 * violet hoekje en een eigen lijndikte: een tweede stijl naast die van het
 * paneel. Nu is het dezelfde set, uit hetzelfde script
 * (scripts/schetsen-zijpaneel.py → public/img/schets/hoek-<id>.svg), en dezelfde
 * tekening komt in het zijpaneel te staan zodra iemand de hoek aanvinkt
 * (pipeline.js, paintAngles).
 *
 * Een <img> en geen inline SVG: één bestand per hoek, gecachet, en geen id's
 * meer die twee keer op een pagina staan (de oude clipPath-noot over 'eigen').
 * De tekening is decoratie bij een tegel met een naam; vandaar alt="".
 */
import { ANGLE_IDS } from '../../data/angles.js';

interface Props { id: string; sleutel?: string; }
const { id, sleutel } = Astro.props;
/* 'eigen' is de hoek die de klant zelf bedenkt: geen vaste naam, wel een plek in
   elke groep. Welke tekening (op een model of op de ondergrond) volgt uit de
   sleutel die de kiezer meegeeft ("eigen-model" / "eigen-ground"). */
const VRIJE_SCHETSEN = ['eigen'];
if (!ANGLE_IDS.includes(id) && !VRIJE_SCHETSEN.includes(id)) {
  throw new Error(`AngleSketch: '${id}' staat niet in ANGLE_IDS — een schets zonder hoek is een tekening van niets.`);
}
const bestand = id === 'eigen' ? (sleutel === 'eigen-model' ? 'hoek-eigen-model' : 'hoek-eigen-ground') : `hoek-${id}`;
---
<img class="hs" src={`/img/schets/${bestand}.svg`} width="120" height="120" alt="" loading="lazy" decoding="async" />

<style>
  /* Het vak blijft 4:3 (de tegel); de vierkante schets staat erin, zoals in het zijpaneel. */
  .hs { display: block; width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: contain; }
</style>
