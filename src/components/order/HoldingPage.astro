---
// VISUAILS — the three services you cannot check out of yet.
//
// WHY THESE PAGES EXIST INSTEAD OF NOT EXISTING
// The chooser at /start lists six things the studio sells. Three of them have a
// real flow. The other three do not, and the previous answer was to leave them
// off the form entirely — which is exactly what Lucas noticed about video: it
// is on /video, it is on /pricing, it is in the ladder, and the one page whose
// job is to take an order pretended it was not there. A gap a visitor can see
// is worse than an unfinished page that says what it is.
//
// So: one page each, one shared treatment, and the treatment is honest rather
// than apologetic. The three read as the same KIND of page on purpose — same
// status strip, same three facts, same short request form — because that is
// what they are: work the studio does, that a form cannot yet price on its own.
// A solo studio saying "this exists, here is where it is going, here is how to
// get in the queue" is a different thing from a broken button.
//
// WHAT THEY POST. Nothing new. `service` is one of ORDER_SERVICES in
// functions/api/order.js — `video` for clips, `custom` for the Brand Model and
// the plans — and everything that distinguishes them (`request`, `plan`,
// `clips`) is an ordinary field that lands in details_json, because it is not in
// TOP_FIELDS. No server change, no migration, and an order record that still
// reads. `clips` joined that list on 13 August 2026; see the long note at the
// field itself for why it is not `products`.
//
// NO CHECKOUT, DELIBERATELY. The Brand Model is a one-time setup that changes
// every order after it, and the plans are a minimum-term commitment. Both are
// conversations. A card form here would be the studio pretending a decision has
// been made that has not.
import { AMOUNT, euro, vatLabel, vatLead, vatDetail, turnaround } from '../../data/pricing.js';
import { localizedPath } from '../../i18n/ui.js';

import Note from '../Note.astro';
interface Props {
  lang: 'en' | 'nl';
  /* 'brand-model' STOND HIER, EN IS WEG — 23 augustus 2026.
     Sinds /start/brand-model een echte bestelstroom met een afrekenstap is
     (BrandModelBrief.astro), rendert niets deze soort meer. De twee blokken die
     erbij hoorden zeiden bovendien twee dingen die niet meer waar zijn: "er is
     hier geen afrekenstap en die komt voorlopig ook niet", en dat het bedrag
     wordt verrekend met de eerste bestellingen — de terugverdienconstructie die
     met de prijswijziging is vervallen. Dode tekst is vervelend; dode tekst die
     iets belooft, is een rekening.

     'plan' is om dezelfde reden meegegaan. /start/plan is sinds 17 augustus
     PlanPicker.astro — je kunt daar wél zelf een abonnement afsluiten — terwijl
     het blok hier bleef zeggen dat dat niet kan en dat we de eerste maand pas
     factureren als we het eens zijn. Twee soorten over, en allebei renderen ze
     echt: video en custom-look. */
  kind: 'video' | 'custom-look';
}
const { lang, kind } = Astro.props;
const lp = (p: string) => localizedPath(lang, p);
const nl = lang === 'nl';

// Common chrome. The status word is the only thing that changes size on the
// page, and it is the one thing a visitor needs before anything else.
const UI = {
  en: {
    eyebrow: 'Start',
    statusLabel: 'Where this stands',
    factsH: 'What it is',
    formH: 'Send your request',
    formLead: 'No payment, no commitment. It reaches the studio inbox and gets a written answer.',
    name: 'Your name',
    brand: 'Brand or shop name',
    email: 'Email',
    phone: 'Phone or WhatsApp',
    website: 'Website or shop link',
    optional: 'optional',
    message: 'What do you have in mind?',
    /* ── DRIE MELDINGEN, EN WAAROM ZE HIER STAAN ────────────────────────
       Zonder `data-melding` toont de browser zijn eigen zin ("Please fill out
       this field") in de UI-taal van de bezoeker, en niet in de taal van de
       pagina — een Engelse bubbel op een Nederlands formulier. De machinerie
       staat in initVeldmeldingen() in src/scripts/interactions.js; hier staat
       alleen de tekst, in de taal van de pagina waar hij op verschijnt. */
    nameErr: 'Add your name, so we know who is asking.',
    brandErr: 'Add the brand or shop name — it tells us what this is for.',
    emailErr: 'Add a full email address, like you@yourbrand.com — otherwise we cannot reply.',
    submit: 'Send this request',
    nextH: 'What happens next',
    next: [
      'A written answer from Lucas, not an automated one.',
      // NIET "the same figures on this page": deze drie regels staan onder ELKE
      // wachtpagina, en /start/custom-look zet er geen bedragen op — die pagina
      // zegt juist "price on request". Een belofte die op de ene pagina klopt en
      // op de andere naar niets verwijst, is op die andere pagina een fout.
      'A quote in writing, or a conversation if the work needs one.',
      'Nothing is charged, and nothing is reserved, until you say yes in writing.',
    ],
    back: 'Back to all services',
    readMore: 'Read the whole story',
  },
  nl: {
    eyebrow: 'Start',
    statusLabel: 'Hoe het ervoor staat',
    factsH: 'Wat het is',
    formH: 'Stuur je aanvraag',
    formLead: 'Geen betaling, geen verplichting. Je aanvraag komt bij ons binnen en je krijgt schriftelijk antwoord.',
    name: 'Je naam',
    brand: 'Merk- of shopnaam',
    email: 'E-mail',
    phone: 'Telefoon of WhatsApp',
    website: 'Website of shoplink',
    optional: 'optioneel',
    message: 'Wat heb je in gedachten?',
    /* Zie de noot bij de Engelse tegenhanger. */
    nameErr: 'Vul je naam in, dan weten we wie er vraagt.',
    brandErr: 'Vul de merk- of shopnaam in — daaraan zien we waar dit over gaat.',
    emailErr: 'Vul een volledig e-mailadres in, zoals jij@jouwmerk.nl — anders kunnen we niet antwoorden.',
    submit: 'Verstuur deze aanvraag',
    nextH: 'Wat er daarna gebeurt',
    next: [
      'Een schriftelijk antwoord van Lucas, geen automatisch bericht.',
      'Een offerte op schrift, of een gesprek als het werk daarom vraagt.',
      'We brengen niets in rekening en houden niets voor je vrij totdat je schriftelijk ja zegt.',
    ],
    back: 'Terug naar de keuze',
    readMore: 'Lees het hele verhaal',
  },
};
const ui = UI[lang];

// ── Per service ────────────────────────────────────────────────────────────
// `status` is the sentence that has to be true. It is written plainly and it
// is not hedged: "still being built" means still being built.
const KIND = {
  en: {
    video: {
      h1: 'Video clips',
      lead: 'Product clips for feed, story and paid social.',
      status: 'In build',
      statusBody: 'The video order flow is not finished. Clips are being produced today — they are ordered by hand, through this form or on an existing order, and the studio confirms what you are ordering and when, in writing, before anything runs.',
      facts: [
        ['Price', `${euro(AMOUNT.video, 'en')} a clip, ${vatLabel('excl', 'en')}. The same figure inside a larger order or on its own.`],
        ['What you get', 'One product, one look, one clip cut for vertical. Styles are the same four the lifestyle work runs on.'],
        ['Timing', `${turnaround('unattended', 'en')} once we know what you need. No date is named before the calendar clears it.`],
      ],
      askLabel: 'How many clips?',
      askHint: 'A rough number is fine — it is a request, not an order.',
      more: '/video',
      moreLabel: 'See the video work',
    },
    /*
     * ── DE CUSTOM LOOK, 18 augustus 2026 ────────────────────────────────────
     *
     * Lucas: *"Een custom stijl moet op aanvraag en er is geen standaard tarief
     * voor, dit wordt pas berekend wanneer de klant heeft aangegeven wat hij/zij
     * wil. Dit is een volledig andere optie dan de standaard predefined
     * stijlen."*
     *
     * Tot vandaag stond Custom als vijfde radio tussen de vier huisstijlen in
     * het bestelformulier, en de lopende telling rekende hem af tegen het gewone
     * lifestyle-tarief — € 109 per product bij 1 tot 4. De stijlpagina zei op
     * datzelfde moment "Op aanvraag". Eén van de twee loog, en het was de dure
     * kant: een klant kon een op maat ontworpen wereld bestellen tegen het
     * tarief van een bestaande, met een totaal op het bevestigingsscherm.
     *
     * Dus krijgt hij de behandeling die de andere twee "op aanvraag"-dingen al
     * hebben: een eigen pagina, een status, drie feiten en een verzoekformulier.
     * GEEN PRIJS IN DE FEITEN, en dat is hier het hele punt — de andere drie
     * noemen er wel een, want die hebben er een. Deze regel zegt daarom wat er
     * gebeurt in plaats van wat het kost.
     */
    'custom-look': {
      /* ── DEZE PAGINA DEKT NU OOK CATALOG — 21 augustus 2026 ────────────
         /catalog/custom stuurde je naar het gewone bestelformulier, en dat
         beloofde een tarief per product dat er pas is als de look ontworpen is
         (zie `cardPrice: 'Custom pricing'` in catalogStyles.js). Die knop komt
         nu hier uit, en dus mag de tekst niet langer alleen over lifestyle gaan:
         "één van de vier huisstijlen" waren de vier LIFESTYLE-stijlen. */
      h1: 'A look of your own',
      lead: 'A world designed around your product, instead of a house style — for a catalog set, a lifestyle scene, or both.',
      status: 'Priced per request',
      statusBody: 'A custom look has no standard rate, and it is not a fifth option next to the four styles — it is a different thing. What it costs depends on the world you want built, so it is worked out once you have told us what that is, and put in writing before anything runs.',
      facts: [
        ['Price', 'On request. There is no per-product rate for this until we know what the scene is — the house styles are the ones that have one. Once the look is designed, every product after it runs at the normal rate for its count.'],
        ['What you get', 'A setting, styling and light that only your brand would use, designed once with you and then held to on every order after it.'],
        ['How it starts', 'Send references and describe the world. We come back with a design direction and a price, in writing, before you commit to anything.'],
      ],
      askLabel: null,
      askHint: null,
      more: '/lifestyle/custom',
      moreLabel: 'See what a look of your own is',
    },
  },
  nl: {
    video: {
      h1: 'Videoclips',
      lead: 'Productclips voor feed, story en paid social.',
      status: 'In aanbouw',
      statusBody: 'Je kunt video hier nog niet zelf bestellen. Clips maken we wél — we plannen ze met de hand in, via dit formulier of op een bestelling die al loopt. Wat je krijgt en wanneer, zetten we op schrift voordat we beginnen.',
      facts: [
        ['Prijs', `${euro(AMOUNT.video, 'nl')} per clip, ${vatLabel('excl', 'nl')}. Hetzelfde bedrag binnen een grotere bestelling of los.`],
        ['Wat je krijgt', 'Eén product, één look, één clip gemonteerd voor verticaal. Dezelfde vier stijlen als het lifestyle-werk.'],
        ['Levertijd', `${turnaround('unattended', 'nl')} zodra we weten wat je nodig hebt. We noemen geen datum voordat we in de agenda hebben gekeken.`],
      ],
      askLabel: 'Hoeveel clips?',
      askHint: 'Een ruwe schatting is prima — het is een aanvraag, geen bestelling.',
      more: '/video',
      moreLabel: 'Bekijk het videowerk',
    },
    /* Zie de noot bij de Engelse tegenhanger. */
    'custom-look': {
      h1: 'Een eigen look',
      lead: 'Een wereld die om jouw product heen ontworpen is, in plaats van een huisstijl — voor een catalogset, een lifestylescène, of allebei.',
      status: 'Prijs op aanvraag',
      statusBody: 'Een look op maat heeft geen standaardtarief, en het is geen vijfde optie naast de vier stijlen — het is iets anders. Wat het kost, hangt af van de wereld die je gebouwd wilt hebben, dus dat rekenen we uit zodra je ons verteld hebt wat dat is. Op schrift, voordat er iets draait.',
      facts: [
        ['Prijs', 'Op aanvraag. Er is geen tarief per product zolang we de scène niet kennen — de huisstijlen zijn de enige die er wél een hebben. Zodra de look ontworpen is, loopt elk product daarna tegen het gewone tarief voor dat aantal.'],
        ['Wat je krijgt', 'Een setting, styling en licht die alleen jouw merk zou gebruiken, één keer met je ontworpen en daarna vastgehouden in elke bestelling erna.'],
        ['Hoe het begint', 'Stuur referenties en beschrijf de wereld. Wij komen terug met een richting en een prijs, op schrift, voordat je je ergens aan vastlegt.'],
      ],
      askLabel: null,
      askHint: null,
      more: '/lifestyle/custom',
      moreLabel: 'Bekijk wat een eigen look is',
    },
  },
};
const k = KIND[lang][kind];

// The wire name. `video` and `custom` are both in ORDER_SERVICES already; the
// two that share `custom` are told apart by `request`, which lands in
// details_json because it is not in TOP_FIELDS.
const wire = kind === 'video' ? 'video' : 'custom';

const clipCounts = [1, 2, 3, 4, 5, 6, 8, 10, 12];
const notSure = nl ? 'Weet ik nog niet' : 'Not sure yet';
---

<section class="page-hero"><div class="container">
  <span class="eyebrow-page">{ui.eyebrow}</span>
  <h1 class="display">{k.h1}</h1>
  <p class="lead" style="margin-top:1.2rem">{k.lead}</p>
</div></section>

<section class="section-tight"><div class="container">
  <div class="hold">
    <!-- THE STATUS. The same object on all three pages, so a visitor who has
         seen one of them knows what kind of page this is on sight. -->
    <div class="hold-status">
      <p class="hold-status-label">{ui.statusLabel}</p>
      <p class="hold-status-word">{k.status}</p>
      <p class="hold-status-body">{k.statusBody}</p>
    </div>

    <div class="hold-facts">
      <h2 class="hold-h">{ui.factsH}</h2>
      <dl class="hold-fact-list">
        {k.facts.map(([label, body]) => (
          <div class="hold-fact">
            <dt>{label}</dt>
            <dd>{body}</dd>
          </div>
        ))}
      </dl>
      {/* BRIEF-14: every figure above is net, and this is the one line that
          says once how VAT is handled. */}
      <p class="hold-vat">{vatLead(lang)} <Note lang={lang} term={nl ? 'btw' : 'VAT'} wide>{vatDetail(lang)}</Note></p>
      <p class="hold-more"><a href={lp(k.more)}>{k.moreLabel}</a></p>
    </div>

    <!-- THE REQUEST. A plain form, posting the way every non-pipeline form on
         this site posts: no JavaScript is involved at any point, so there is no
         degraded path to describe. -->
    <div class="hold-form">
      <h2 class="hold-h">{ui.formH}</h2>
      <p class="hold-lead">{ui.formLead}</p>

      <form method="post" action="/api/order" class="hold-fields">
        <input type="hidden" name="service" value={wire} />
        <input type="hidden" name="request" value={kind} />
        <input type="hidden" name="lang" value={lang} />
        <input type="hidden" name="redirect" value={lp('/thank-you')} />
        <input type="hidden" name="source" value={`start-${kind}`} />
        <input type="text" name="company_hp" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0" />

        <div class="row-2">
          <div class="field">
            <label for="h-name">{ui.name} <span class="req">*</span></label>
            <input class="input" type="text" id="h-name" name="name" autocomplete="name" required data-melding={ui.nameErr} />
          </div>
          <div class="field">
            <label for="h-brand">{ui.brand} <span class="req">*</span></label>
            <input class="input" type="text" id="h-brand" name="brand" autocomplete="organization" required data-melding={ui.brandErr} />
          </div>
        </div>

        <div class="row-2">
          <div class="field">
            <label for="h-email">{ui.email} <span class="req">*</span></label>
            <input class="input" type="email" id="h-email" name="email" autocomplete="email" required data-melding={ui.emailErr} />
          </div>
          <div class="field">
            <label for="h-phone">{ui.phone} <span class="hold-opt">{ui.optional}</span></label>
            <input class="input" type="tel" id="h-phone" name="phone" autocomplete="tel" placeholder="+31 6 …" />
          </div>
        </div>

        <div class="field">
          <label for="h-web">{ui.website} <span class="hold-opt">{ui.optional}</span></label>
          <input class="input" type="url" id="h-web" name="website" placeholder="https://" autocomplete="url" />
        </div>

        {kind === 'video' && (
          <div class="field">
            <label for="h-clips">{k.askLabel}</label>
            {/* ── name="clips" EN NIET name="products" — 13 augustus 2026 ──────
                Dit veld postte in `products`, "so the count lands in the orders
                table's own column rather than in details_json". Die kolom is
                `orders.product_count`, en die betekent overal in dit systeem
                ÉÉN ding: het aantal producten dat door de fotopijplijn gaat.
                Een aantal clips daarin schrijven laat twintig lezers hetzelfde
                getal verkeerd uitleggen. Drie daarvan waren echt fout:

                  · tierFor() gaf `attended` bij tien clips, en dan belooft de
                    bevestigingsmail een vastgezet leveringsvenster voor werk
                    dat met de hand wordt ingepland. Op 12 augustus in pricing.js
                    dichtgezet door de dienst mee te wegen — één lezer gerepareerd,
                    de oorzaak niet.

                  · claimUpgradePrompt() in /api/order telt `product_count` op
                    over een kwartaal en zegt bij twaalf: "je hebt twaalf losse
                    producten besteld, dit kost een Full Drop." Twaalf clips
                    zetten dus een verkoopregel in een mail met een getal dat de
                    klant weet dat het niet klopt.

                  · Het klantportaal en het adminoverzicht schrijven het getal
                    letterlijk als "12 producten" naast een aanvraag waarin geen
                    enkel product zit.

                Dus: `clips`. Het staat niet in TOP_FIELDS, dus het landt in
                details_json — precies zoals `plan` en `request` op deze zelfde
                pagina, en dan doet detailRows() in /api/order het automatisch in
                de studiomail. Geen migratie, en geen kolom die iets anders
                betekent dan hij zegt.

                De laatste optie is met opzet geen getal. Die tekst blijft nu
                gewoon staan zoals hij is ("Weet ik nog niet") in plaats van
                stil null te worden, en dat is een beter antwoord: het is wat de
                klant koos. */}
            <select class="select" id="h-clips" name="clips">
              {clipCounts.map((n) => <option value={String(n)}>{n}</option>)}
              <option value={notSure} selected>{notSure}</option>
            </select>
            <span class="hint">{k.askHint}</span>
          </div>
        )}

        <div class="field">
          <label for="h-msg">{ui.message} <span class="hold-opt">{ui.optional}</span></label>
          <textarea class="textarea" id="h-msg" name="message"></textarea>
        </div>

        <button type="submit" class="btn btn-primary btn-lg hold-submit">{ui.submit}</button>
      </form>
    </div>

    <div class="hold-next">
      <h2 class="hold-h">{ui.nextH}</h2>
      <ul class="hold-next-list">
        {ui.next.map((t) => <li>{t}</li>)}
      </ul>
      <p class="hold-more"><a href={lp('/start')}>{ui.back}</a></p>
    </div>
  </div>
</div></section>

<style>
  /* ═══════════════════════════════════════════════════════════════════════════
     The shared treatment. All three pages are this sheet, and that is the
     point: "unfinished" has to look like a deliberate category, not like three
     separate accidents. Nothing here is styled as an apology — the status strip
     uses the system colour the rest of the site uses for statements of process,
     the same one /start's capacity note carries.
     ═══════════════════════════════════════════════════════════════════════════ */
  .hold { display: grid; gap: clamp(2rem, 4vw, 3rem); max-width: 880px; }

  .hold-status {
    padding: clamp(1.2rem, 2.6vw, 1.8rem);
    border: 1px solid var(--signal);
    border-radius: var(--r-lg);
    background: var(--paper-2);
  }
  .hold-status-label {
    margin: 0;
    font-size: .72rem; font-weight: 700; letter-spacing: .09em;
    text-transform: uppercase; color: var(--ink-3);
  }
  .hold-status-word {
    margin: .35rem 0 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.5rem, 3.4vw, 2rem);
    line-height: 1.1;
    color: var(--signal-ink);
  }
  .hold-status-body {
    margin: .8rem 0 0;
    color: var(--ink-2);
    font-size: .98rem;
    line-height: 1.65;
    max-width: 66ch;
  }

  .hold-h { font-size: var(--t-h4, 1.3rem); line-height: 1.25; }
  .hold-lead { margin-top: .6rem; color: var(--ink-3); max-width: 62ch; }

  .hold-fact-list { margin: 1.1rem 0 0; border-top: 1px solid var(--line-strong); }
  .hold-fact {
    display: grid;
    grid-template-columns: minmax(9rem, max-content) 1fr;
    gap: 1rem;
    padding: .9rem 0;
    border-bottom: 1px solid var(--line);
  }
  .hold-fact dt {
    font-size: .72rem; font-weight: 700; letter-spacing: .08em;
    text-transform: uppercase; color: var(--ink-3);
  }
  .hold-fact dd { margin: 0; color: var(--ink-2); font-size: .95rem; line-height: 1.6; }

  .hold-vat { margin-top: .9rem; font-size: .78rem; color: var(--ink-3); line-height: 1.55; max-width: 62ch; }
  .hold-more { margin-top: .9rem; font-size: .9rem; }
  .hold-more a { color: var(--accent-bright); text-decoration: underline; text-underline-offset: 3px; }

  .hold-form {
    padding: clamp(1.3rem, 3vw, 2rem);
    border: 1px solid var(--line-strong);
    border-radius: var(--r-lg);
    background: var(--surface);
  }
  .hold-fields { margin-top: 1.4rem; }
  .hold-opt { font-weight: 500; font-size: .78rem; color: var(--ink-3); text-transform: lowercase; }
  .hold-submit { margin-top: .6rem; }

  .hold-next-list { list-style: none; margin: 1.1rem 0 0; padding: 0; border-top: 1px solid var(--line); }
  .hold-next-list li {
    padding: .85rem 0;
    border-bottom: 1px solid var(--line);
    color: var(--ink-2);
    font-size: .95rem;
    line-height: 1.6;
  }

  @media (max-width: 560px) {
    .hold-fact { grid-template-columns: 1fr; gap: .25rem; }
  }
</style>
