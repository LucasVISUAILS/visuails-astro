---
import { waHref } from '../../data/whatsapp.js';
// VISUAILS — the order pipeline, shared by every service that has a real flow.
//
// WHY THIS IS A COMPONENT AND NOT A PAGE
// /start used to be one page holding one form that asked, as its first
// question, which of three things you wanted made. That question was already
// answered everywhere it was asked FROM: /catalog links to "order catalog
// sets", and the visitor arriving from it had to answer it again. So /start is
// now a chooser (StartPage.astro) and each service has its own route:
//
//   /start/catalog     · catalog sets           · background picker
//   /start/lifestyle   · lifestyle carousels    · style picker, no background
//   /start/complete    · both                   · background picker
//
// Only step 1 differs between them, and inside step 1 only ONE block does: the
// question that is specific to the work. That block is the default <slot> of
// this component; everything else — the count, the outfit surcharge, the
// running total, the upload, the brief, the capacity gate, the confirm screen —
// is here, once, in one language pair. A per-service page is ~40 lines.
//
// Everything the old file's header said still applies and is not repeated:
// src/scripts/pipeline.js drives this markup through the [data-pl-*] hooks, no
// price is typed anywhere, and the whole thing posts to /api/order with
// JavaScript switched off. Two things ARE new and are worth stating:
//
//   · THE SERVICE IS A HIDDEN INPUT, NOT A RADIO. Its value is still the wire
//     name /api/order already accepts (ORDER_SERVICES: `drop` is a catalog set
//     plus a lifestyle carousel), and the ladder kind now travels in the config
//     blob as `service` rather than on a radio's data attribute — pipeline.js's
//     kindOf() reads the blob when there is no radio to read. The URL is never
//     parsed; the page tells the script what it is.
//   · THE COUNT STARTS UNANSWERED. It used to default to "1 product", which
//     meant the copy that says "choose how many and the total appears here" was
//     never once on screen, and a distracted visitor could order one product by
//     not answering. It is now an explicit choice, and it is the first thing
//     the new error state has to say something about.
import { countryOptions } from '../../data/vat.js';
import {
  TIERS, reviewClaim, euro, TEST_SAMPLE, CATALOG_IMAGES, LIFESTYLE_IMAGES,
  TIER_ROWS, tierRow, tierRowLabels, turnaround,
  ladderRate, ladderFloor, LADDER, vatLabel, vatNote,
  WINDOW_THRESHOLD,
  OUTFIT_SURCHARGE, MAX_OUTFIT_PRODUCTS, OUTFIT_COPY,
  EXTRA_PHOTO_LADDER, MAX_EXTRA_PER_PRODUCT, EXTRA_PHOTO_COPY, extraPhotoRate,
} from '../../data/pricing.js';
import { ATTENDED_PER_WINDOW } from '../../data/capacity.js';
import { MAX_BATCH_FILES, MAX_FILE_BYTES, UPLOAD_TYPES } from '../../lib/uploads.js';
import { SHOTS, SHOT_IDS, copy as shotCopy } from '../../data/shots.js';
import {
  PRODUCT_QUESTIONS, ORDER_QUESTIONS, copy as attrCopy,
} from '../../data/attributes.js';
import ProductUploader from './ProductUploader.astro';
import { localizedPath } from '../../i18n/ui.js';
import {
  RECOMMENDED as BACKGROUNDS, CUSTOM_ID, LIGHT_THRESHOLD, copy as bgCopy,
} from '../../data/backgrounds.js';

import Disclose from '../Disclose.astro';

import { CONSENT_VERSION, currentConsent } from '../../data/consent.js';

interface Props {
  lang: 'en' | 'nl';
  /** The ladder kind. Also what the config blob calls the service. */
  service: 'complete' | 'catalog' | 'lifestyle';
}
const { lang, service } = Astro.props;
const lp = (p: string) => localizedPath(lang, p);

/*
 * WAT CATALOG NIET VRAAGT, augustus 2026.
 *
 * Lucas: *"deze vragen mogen weg en full outfit is niet mogelijk bij catalog,
 * omdat dit per product gaat."* Drie velden vervallen op deze ene dienst, elk
 * om zijn eigen reden:
 *
 *  · Full outfit — een catalogset is per product geprijsd en per product
 *    geleverd. De vraag stelt een keuze voor die niet bestaat, en een keuze die
 *    niet bestaat kost een klant nog steeds een moment nadenken. Wie het toch
 *    wil, kan het apart aanvragen; dat staat er nu in plaats van het veld.
 *  · "Wie draagt dit?" — het model kies je op deze dienst al in de modelkiezer
 *    hierboven. Twee keer dezelfde vraag in één formulier leest als een fout.
 *  · "Nog iets wat we moeten weten" — op catalog staan de per-productvelden er
 *    al; een open vak eronder is de plek waar niemand iets invult en waar jij
 *    toch elke keer even moet kijken.
 *
 * Lifestyle en video houden alle drie: daar bepaalt "wie draagt dit?" hoe de
 * scène gestyled wordt, en dáár kán een look wél een volledige outfit zijn.
 */
const isCatalog = service === 'catalog';

if (!LADDER[service]) {
  throw new Error(`OrderFlow.astro: "${service}" is not a kind on the ladder in src/data/pricing.js.`);
}

// The wire format, which is NOT the ladder's vocabulary. `drop` is what
// /api/order's ORDER_SERVICES and the D1 `service` column call a catalog set
// plus a lifestyle carousel; renaming it is a migration, not a form change.
const WIRE = { complete: 'drop', catalog: 'catalog', lifestyle: 'lifestyle' } as const;

// The country select's options, grouped, built once. In frontmatter rather than
// inline for this file's standing reason: an arrow function in a JSX attribute
// puts a `>` inside the opening tag and the tag scanners close the element on it.
const COUNTRIES = countryOptions(lang);
const wire = WIRE[service];

// A lifestyle carousel is a styled scene, not a product on a ground, so it has
// no background to choose. The picker is simply not rendered for it — the old
// page hid AND disabled the fieldset at runtime, which was the right fix while
// one page served all three services and is dead weight now that it does not.
const bgApplies = service !== 'lifestyle';

const unattended = TIERS.unattended;
const sample = TEST_SAMPLE[lang];

// ── What each service IS, in one line ──────────────────────────────────────
// The three-option radio grid with seven photographs in it is gone: the
// chooser at /start showed the pictures, and repeating them here would ask a
// visitor to re-decide something they decided one click ago. What survives is
// the one sentence a confirmation needs — what you picked, and what it buys —
// plus a way back to the chooser for someone who picked wrong.
const SERVICE = {
  en: {
    complete: {
      title: 'Catalog sets and lifestyle carousels',
      gets: '7 images per product — 4 catalog, 3 lifestyle',
      lead: `The rate falls as the count rises, from ${euro(ladderRate('complete', 1), 'en')} to ${euro(ladderFloor('complete'), 'en')} a product.`,
    },
    catalog: {
      title: 'Catalog sets',
      gets: 'From 4 images per product — front, back, detail, on model',
      lead: `The rate falls as the count rises, from ${euro(ladderRate('catalog', 1), 'en')} to ${euro(ladderFloor('catalog'), 'en')} a product.`,
    },
    lifestyle: {
      title: 'Lifestyle carousels',
      gets: '3 images per product — one styled look, ready to post',
      lead: `The rate falls as the count rises, from ${euro(ladderRate('lifestyle', 1), 'en')} to ${euro(ladderFloor('lifestyle'), 'en')} a product.`,
    },
    change: 'Order something else',
  },
  nl: {
    complete: {
      title: 'Catalogsets en lifestyle-carousels',
      gets: '7 beelden per product — 4 catalog, 3 lifestyle',
      lead: `Het tarief daalt naarmate het aantal stijgt, van ${euro(ladderRate('complete', 1), 'nl')} naar ${euro(ladderFloor('complete'), 'nl')} per product.`,
    },
    catalog: {
      title: 'Catalogsets',
      gets: 'Vanaf 4 beelden per product — voor, achter, detail, op model',
      lead: `Het tarief daalt naarmate het aantal stijgt, van ${euro(ladderRate('catalog', 1), 'nl')} naar ${euro(ladderFloor('catalog'), 'nl')} per product.`,
    },
    lifestyle: {
      title: 'Lifestyle-carousels',
      gets: '3 beelden per product — één gestylede look, klaar om te posten',
      lead: `Het tarief daalt naarmate het aantal stijgt, van ${euro(ladderRate('lifestyle', 1), 'nl')} naar ${euro(ladderFloor('lifestyle'), 'nl')} per product.`,
    },
    change: 'Iets anders bestellen',
  },
};
const svc = SERVICE[lang][service];

// ── The copy pipeline.js reads ─────────────────────────────────────────────
// Serialised into the config blob and reached by dotted path from the script.
// Unchanged from the single-page version except for `err`, which is new: the
// form had no rendered error state at all, so pressing Continue with nothing
// answered left the step looking exactly as it had a moment before.
const PIPE = {
  en: {
    total: {
      each: `{rate} per product × {n}, ${vatLabel('excl', 'en')}.`,
      more: 'That is more than one reserved delivery date holds, so it is planned with you rather than priced by a form.',
      quote: 'Choose how many products and the total appears here.',
      onRequest: '—',
      outfit: ' Plus {price} × {n} for a complete look — trousers, top and shoes in one shot.',
      extra: ' Plus {price} × {n} for extra photos.',
    },
    // NOT "{then} instead of {now}" — see the note this line kept in the old
    // file: what falls is the per-product rate, so that is what is compared.
    rung: {
      one: `One more product and every product drops from {now} to {rate} — {count} for {then}, ${vatLabel('excl', 'en')}.`,
      many: `{add} more products and every product drops from {now} to {rate} — {count} for {then}, ${vatLabel('excl', 'en')}.`,
    },
    level: {
      attended: `${WINDOW_THRESHOLD} products or more, so this order goes in the calendar. ${turnaround('attended', 'en')}.`,
      unattended: `${TIERS.unattended.queue.en}. From ${WINDOW_THRESHOLD} products we hold a delivery date for you instead.`,
    },
    kind: {
      complete: 'Catalog set and lifestyle carousel',
      catalog: 'Catalog set',
      lifestyle: 'Lifestyle carousel',
    },
    // The last resort when a field carries no message of its own. Every field
    // that can actually fail has one in [data-pl-err-msg]; this is what a
    // future field gets before anybody writes it one.
    err: { generic: 'This still needs an answer before you can continue.' },
    sum: {
      kind: 'What we make',
      count: 'Products',
      bg: 'Background',
      style: 'Look',
      outfit: 'Complete look',
      outfitN: '{price} extra × {n}',
      net: `Order value (${vatLabel('excl', 'en')})`,
      files: 'Reference material',
      noFiles: 'Nothing sent yet — we will come to you',
      window: 'Delivery',
      windowLater: 'Delivery date still to be reserved',
      queue: TIERS.unattended.queue.en,
      email: 'Email',
    },
    upload: {
      sending: 'Sending…',
      done: 'Sent',
      retry: 'Try again',
      remove: 'Remove',
      count: '{n} of {max} uploaded',
      err: {
        'too-large': 'Too large — {max} per file is the ceiling. Pick a smaller photo, or send it to us by email afterwards.',
        'batch-full': 'That is {max} files, the ceiling for one order. Remove one before you add another.',
        rate: 'Too many at once. Wait a moment, then try again.',
        unavailable: 'Our upload server did not answer. Wait a minute and try again — or send the order now and email the photos after.',
        network: 'The connection dropped before this one arrived.',
        generic: 'We could not read this file. Try it again, or pick another photo of the same product.',
        'bad-type': 'Not an image we can read. JPG, PNG, WebP, AVIF, HEIC, GIF or TIFF.',
        empty: 'This file is empty — 0 bytes. Pick the photo again from your camera roll.',
        'no-file': 'Nothing arrived with that one. Select the photo again — sometimes the file picker hands over an empty slot.',
        'bad-batch': 'This upload session lost its place. Reload the page and pick the files again.',
        'bad-request': 'This upload was refused. Reload the page and add the file again — the order itself is still here.',
        // The client only ever sends one of the four ids in shots.js, so this
        // is a bug in the page rather than something a customer did. It still
        // gets a sentence: a slot that fails silently is a photograph the
        // studio never receives and nobody ever missed.
        'bad-shot': 'We could not tell which photo this was meant to be. Try that slot again.',
      },
    },
    s3: {
      prefillNote: "Filled in from your account ({email}) — change anything that's out of date.",
    },
    gate: { windowSub: 'Dates we can hold' },
    submit: {
      sending: 'Sending…',
      email: 'That does not look like a complete email address — it needs an @ and a domain, like naam@merk.nl. Check it and send again.',
      network: 'The request did not finish, and we cannot tell whether it reached us. Rather than send it twice, email hello@visuails.com and we will confirm what arrived.',
      generic: 'Your order did not reach our server. Nothing has been charged and nothing was created. Try again, or email hello@visuails.com and we will enter it by hand.',
    },
  },
  nl: {
    total: {
      each: `{rate} per product × {n}, ${vatLabel('excl', 'nl')}.`,
      more: 'Dat is meer dan één vastgezette leverdatum aankan, dus dat plannen we samen in plaats van het door een formulier te laten prijzen.',
      quote: 'Kies hoeveel producten en het totaal verschijnt hier.',
      onRequest: '—',
      outfit: ' Plus {price} × {n} voor een compleet setje — broek, top en schoenen in één foto.',
      extra: ' Plus {price} × {n} voor extra foto’s.',
    },
    rung: {
      one: `Nog één product en elk product zakt van {now} naar {rate} — {count} voor {then}, ${vatLabel('excl', 'nl')}.`,
      many: `Nog {add} producten en elk product zakt van {now} naar {rate} — {count} voor {then}, ${vatLabel('excl', 'nl')}.`,
    },
    level: {
      attended: `${WINDOW_THRESHOLD} producten of meer, dus we zetten voor deze bestelling een leverdatum vast. ${turnaround('attended', 'nl')}.`,
      unattended: `${TIERS.unattended.queue.nl}. Vanaf ${WINDOW_THRESHOLD} producten krijgt een bestelling in plaats daarvan een vastgezette leverdatum.`,
    },
    kind: {
      complete: 'Catalogset en lifestyle-carousel',
      catalog: 'Catalogset',
      lifestyle: 'Lifestyle-carousel',
    },
    err: { generic: 'Hier moet nog een antwoord staan voordat je verder kunt.' },
    sum: {
      kind: 'Wat we maken',
      count: 'Producten',
      bg: 'Achtergrond',
      style: 'Look',
      outfit: 'Compleet setje',
      outfitN: '{price} extra × {n}',
      net: `Orderbedrag (${vatLabel('excl', 'nl')})`,
      files: 'Referentiemateriaal',
      noFiles: 'Nog niets gestuurd — we nemen contact met je op',
      window: 'Levering',
      windowLater: 'Leverdatum wordt nog vastgezet',
      queue: TIERS.unattended.queue.nl,
      email: 'E-mail',
    },
    upload: {
      sending: 'Versturen…',
      done: 'Verstuurd',
      retry: 'Opnieuw',
      remove: 'Verwijderen',
      count: '{n} van {max} geüpload',
      err: {
        'too-large': 'Te groot — {max} per bestand is het maximum. Kies een kleinere foto, of mail hem ons na.',
        'batch-full': 'Dat zijn {max} bestanden, het maximum voor één bestelling. Haal er één weg voordat je een nieuwe toevoegt.',
        rate: 'Te veel tegelijk. Wacht even en probeer het opnieuw.',
        unavailable: 'Onze uploadserver gaf geen antwoord. Wacht een minuut en probeer opnieuw — of verstuur de bestelling nu en mail de foto\'s erna.',
        network: 'De verbinding viel weg voordat deze binnen was.',
        generic: 'We konden dit bestand niet lezen. Probeer het nog eens, of kies een andere foto van hetzelfde product.',
        'bad-type': 'Geen beeld dat we kunnen lezen. JPG, PNG, WebP, AVIF, HEIC, GIF of TIFF.',
        empty: 'Dit bestand is leeg — 0 bytes. Kies de foto opnieuw uit je fotolijst.',
        'no-file': 'Er kwam niets mee. Kies de foto opnieuw — soms geeft de bestandskiezer een leeg vakje door.',
        'bad-batch': 'Deze uploadsessie is zijn plek kwijt. Herlaad de pagina en kies de bestanden opnieuw.',
        'bad-request': 'Deze upload werd geweigerd. Herlaad de pagina en voeg het bestand opnieuw toe — je bestelling staat er nog.',
        'bad-shot': 'We konden niet zien welke foto dit moest zijn. Probeer dat vakje opnieuw.',
      },
    },
    s3: {
      prefillNote: 'Ingevuld vanuit je account ({email}) — pas aan wat niet meer klopt.',
    },
    gate: { windowSub: 'Data die we kunnen vrijhouden' },
    submit: {
      sending: 'Versturen…',
      email: 'Dat lijkt geen volledig e-mailadres — er moet een @ en een domein in, zoals naam@merk.nl. Kijk het na en verstuur opnieuw.',
      network: 'Het verzoek is niet afgerond en we kunnen niet zien of het is aangekomen. Verstuur het niet twee keer maar mail hello@visuails.com, dan bevestigen wij wat er binnen is.',
      generic: 'Je bestelling kwam niet aan op onze server. Er is niets in rekening gebracht en er is niets aangemaakt. Probeer het opnieuw, of mail hello@visuails.com — dan zetten we hem met de hand in.',
    },
  },
};

// ── The background picker's live half ──────────────────────────────────────
// One note per swatch, and only ever the selected one is on screen — which is
// how four paragraphs of rationale became a single line that changes as you
// click. Every word comes from src/data/backgrounds.js. Added to the blob only
// for the services that HAVE a background: a lifestyle order downloading four
// notes about grounds it will never show is copy nobody can ever read.
if (bgApplies) {
  for (const l of ['en', 'nl'] as const) {
    (PIPE[l] as Record<string, unknown>).bg = {
      warn: bgCopy(l).warn,
      note: Object.fromEntries([
        ...BACKGROUNDS.map((b) => [b.id, b.note[l]]),
        [CUSTOM_ID, bgCopy(l).customHint],
      ]),
    };
  }
}

// ── Step 2's live half ─────────────────────────────────────────────────────
// The per-product uploader builds up to thirty cards × four slots in the
// browser, so every label in them has to travel in the config blob. All but
// four come STRAIGHT OUT of src/data/shots.js and are not retyped here — that
// module owns the words for the four shots the same way backgrounds.js owns the
// words for the four grounds, and a second copy of "Skip this one" in this file
// is a second copy a translator will not find.
//
// The four that are written here are about the CONTROL rather than about the
// photographs: what a card is called before it is named, how to add one, what
// the disclosure does, and what the tray's menu is for. shots.js has no opinion
// on any of that and should not be given one.
for (const l of ['en', 'nl'] as const) {
  const s = shotCopy(l);
  (PIPE[l] as Record<string, unknown>).pu = {
    required: s.required,
    optional: s.optional,
    skipShot: s.skipShot,
    undoSkip: s.undoSkip,
    replace: s.replace,
    remove: s.remove,
    productName: s.productName,
    ready: s.ready,
    needsShots: s.needsShots,
    listAnd: s.listAnd,
    extraH: s.extraH,
    extraCount: s.extraCount,
    extraNote: s.extraNote,
    extraPlaceholder: s.extraPlaceholder,
    extraRate: s.extraRate,
    extraSlot: s.extraSlot,
    extraNoteLabel: s.extraNoteLabel,
    extraNoteErr: s.extraNoteErr,
    extraShotHint: s.extraShotHint,
    ownModel: s.ownModel,
    trayAssign: s.trayAssign,
    progress: s.progress,
    progressOne: s.progressOne,
    allDoneOne: s.allDoneOne,
    progressExtra: s.progressExtra,
    progressExtraOne: s.progressExtraOne,
    allDone: s.allDone,
    product: l === 'nl' ? 'Product {n}' : 'Product {n}',
    add: l === 'nl' ? 'Nog een product toevoegen' : 'Add another product',
    // The disclosure opens the photos AND the question, so it says so. A
    // control whose label names half of what it does is a control a customer
    // learns to distrust.
    toggle: l === 'nl' ? 'Toon de foto’s en de vraag' : 'Show the photos and the question',
    placeIn: l === 'nl' ? 'Plaats bij' : 'Place in',
    shot: Object.fromEntries(SHOTS.map((x) => [x.id, x.name[l]])),

    // ── The per-product questions ────────────────────────────────────────
    // Words only. src/data/attributes.js owns them the way shots.js owns the
    // four angles, and none of them is retyped here. pipeline.js imports the
    // same module for the IDS, the types and the option ids — behaviour — and
    // reads every string it paints out of this blob, which is the split the
    // script's own header sets out.
    //
    // The `buys` lines are in the blob because a card repeats them in `title`
    // for a pointer; they are PRINTED once, by ProductUploader.astro, in the
    // guide the cards point at with aria-describedby.
    about: attrCopy(l).aboutH,
    sameForAll: attrCopy(l).sameForAll,
    sameForAllHint: attrCopy(l).sameForAllHint,
    copyDown: attrCopy(l).copyDown,
    copied: attrCopy(l).copied,
    copiedOne: attrCopy(l).copiedOne,
    q: Object.fromEntries(PRODUCT_QUESTIONS.map((x) => [x.id, {
      name: x.name[l],
      buys: x.buys[l],
      ...(x.placeholder ? { placeholder: x.placeholder[l] } : {}),
    }])),
    // Keyed by option id, with a blank first option under '_' — a dotted copy
    // path cannot address an empty key, and inventing a wire value for it
    // would put a value in the database that attributes.js does not have.
    // Empty today: no question declares options. It stays because the day one
    // does, this is what stops its labels being typed a second time.
    qopt: Object.fromEntries(
      PRODUCT_QUESTIONS.filter((x) => x.options).map((x) => [
        x.id,
        Object.fromEntries(x.options.map((o) => [o.id || '_', o.name[l]])),
      ])
    ),
  };
}

// ── The contract, enforced at build time ───────────────────────────────────
// Every dotted path src/scripts/pipeline.js passes to c(), in both languages.
// A key that is missing or empty fails the build here rather than reaching a
// visitor as an empty string. Adding a c() call to pipeline.js means adding
// its path to this list; that is the point.
//
// bg.* is on this list only when the flow has a background — the note keys are
// generated from the data rather than typed, so adding a recommended value to
// backgrounds.js adds its own build-time check instead of shipping a swatch
// with no line under it.
const REQUIRED_COPY = [
  'total.each', 'total.more', 'total.quote', 'total.onRequest', 'total.outfit', 'total.extra',
  'rung.one', 'rung.many',
  'level.attended', 'level.unattended',
  'kind.complete', 'kind.catalog', 'kind.lifestyle',
  'err.generic',
  'sum.kind', 'sum.count', 'sum.bg', 'sum.style', 'sum.outfit', 'sum.outfitN',
  // sum.net and NOTHING ELSE about money — VAT is charged at the rate of the
  // customer's own country, so a gross figure here would be a Dutch rate shown
  // to whoever reads. vatNote() says once how VAT is handled.
  'sum.net',
  'sum.files', 'sum.noFiles', 'sum.window', 'sum.windowLater', 'sum.queue', 'sum.email',
  'upload.sending', 'upload.done', 'upload.retry', 'upload.remove', 'upload.count',
  'upload.err.too-large', 'upload.err.batch-full', 'upload.err.rate',
  'upload.err.unavailable', 'upload.err.network', 'upload.err.generic',
  'upload.err.bad-type', 'upload.err.empty', 'upload.err.no-file',
  'upload.err.bad-batch', 'upload.err.bad-request', 'upload.err.bad-shot',
  // Step 2's uploader. The shot names are generated from SHOTS rather than
  // typed, so a fifth angle added to shots.js brings its own build-time check
  // instead of shipping a slot with no word under the drawing.
  'pu.required', 'pu.optional', 'pu.skipShot', 'pu.undoSkip', 'pu.replace', 'pu.remove',
  'pu.productName', 'pu.ready', 'pu.needsShots', 'pu.listAnd', 'pu.trayAssign',
  'pu.extraH', 'pu.extraCount', 'pu.extraNote', 'pu.extraPlaceholder', 'pu.extraRate', 'pu.ownModel',
  'pu.extraSlot', 'pu.extraNoteLabel', 'pu.extraNoteErr', 'pu.extraShotHint',
  'pu.progress', 'pu.progressOne', 'pu.progressExtra', 'pu.progressExtraOne',
  'pu.allDone', 'pu.allDoneOne',
  'pu.product', 'pu.add', 'pu.toggle', 'pu.placeIn',
  ...SHOT_IDS.map((id) => `pu.shot.${id}`),
  // The product questions, generated from src/data/attributes.js rather than
  // typed, for the reason the shot names are: a second question added there
  // brings its own build-time check instead of shipping a card with a blank
  // label. Every option of every select is checked the same way.
  'pu.about', 'pu.sameForAll', 'pu.sameForAllHint', 'pu.copyDown', 'pu.copied', 'pu.copiedOne',
  ...PRODUCT_QUESTIONS.flatMap((x) => [
    `pu.q.${x.id}.name`,
    `pu.q.${x.id}.buys`,
    ...(x.placeholder ? [`pu.q.${x.id}.placeholder`] : []),
    ...(x.options ? x.options.map((o) => `pu.qopt.${x.id}.${o.id || '_'}`) : []),
  ]),
  's3.prefillNote',
  'gate.windowSub',
  'submit.sending', 'submit.email', 'submit.network', 'submit.generic',
  ...(bgApplies
    ? ['bg.warn', `bg.note.${CUSTOM_ID}`, ...BACKGROUNDS.map((b) => `bg.note.${b.id}`)]
    : []),
];

for (const l of ['en', 'nl'] as const) {
  for (const path of REQUIRED_COPY) {
    let node: unknown = PIPE[l];
    for (const key of path.split('.')) {
      node = node && typeof node === 'object' ? (node as Record<string, unknown>)[key] : undefined;
    }
    if (typeof node !== 'string' || !node.trim()) {
      throw new Error(
        `OrderFlow.astro: PIPE.${l}.${path} is missing or empty, and src/scripts/pipeline.js reads it.`
      );
    }
  }
}

