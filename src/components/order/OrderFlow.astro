const f = FORM[lang];

const countLabel = (n: number) => `${n} ${n === 1 ? 'product' : lang === 'nl' ? 'producten' : 'products'}`;

const rowLabels = tierRowLabels(lang);
const levels = [
  {
    tier: 'unattended',
    heading: f.s1.levelUnattended[0],
    band: f.s1.levelUnattended[1],
    values: TIER_ROWS.map((r) => tierRow('unattended', r.key, lang)),
  },
  {
    tier: 'attended',
    heading: f.s1.levelAttended[0],
    band: f.s1.levelAttended[1],
    values: TIER_ROWS.map((r) => tierRow('attended', r.key, lang)),
  },
];

// ── The config blob ────────────────────────────────────────────────────────
// Every number the script needs, from the module that owns it. Nothing here is
// authoritative: the server re-derives every price and every limit.
//
// `service` is the one addition. pipeline.js used to read the ladder kind off
// whichever radio was checked; there is no radio any more, so the page tells
// the script what it is. The URL is never parsed — a route rename would
// otherwise silently reprice every order placed through it.
const config = {
  lang,
  service,
  ladder: LADDER,
  windowThreshold: WINDOW_THRESHOLD,
  maxProducts: ATTENDED_PER_WINDOW,
  maxFileBytes: MAX_FILE_BYTES,
  maxBatchFiles: MAX_BATCH_FILES,
  uploadExt: Object.keys(UPLOAD_TYPES),
  outfitSurcharge: OUTFIT_SURCHARGE,
  // The extra-photo ladder travels whole rather than as one rate: the rate
  // depends on the product count, which changes in the browser, so resolving
  // it here would freeze the wrong rung into the page.
  extraPhotoLadder: EXTRA_PHOTO_LADDER,
  maxExtraPerProduct: MAX_EXTRA_PER_PRODUCT,
  maxOutfit: MAX_OUTFIT_PRODUCTS,
  bg: { customId: CUSTOM_ID, lightThreshold: LIGHT_THRESHOLD },
  copy: PIPE[lang],
};

// JSON inside a <script> ends at the first literal "</script>", and a stray "<"
// is the only character that can start one. Escaping it is what makes this blob
// safe to write with set:html.
const configJson = JSON.stringify(config).replace(/</g, '\\u003c');

const counts = Array.from({ length: ATTENDED_PER_WINDOW }, (_, i) => i + 1);
const outfitCounts = Array.from({ length: MAX_OUTFIT_PRODUCTS + 1 }, (_, i) => i);
