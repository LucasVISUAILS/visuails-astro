<!-- HERO -->
<section class="page-hero"><div class="container">
  <span class="eyebrow-page">{lang === 'nl' ? 'Bestellen' : 'Order'}</span>
  <h1 class="display">{svc.title}</h1>
  <p class="lead" style="margin-top:1.2rem">{svc.gets}. {svc.lead}</p>
</div></section>

<!-- THE PIPELINE -->
<section class="section-tight"><div class="container">
  <form
    id="pl-form"
    class="pl-form"
    data-pipeline
    method="post"
    action="/api/order"
    enctype="multipart/form-data"
  >
    <script type="application/json" data-pipeline-config is:inline set:html={configJson}></script>

    {/* `service` is a hidden input again — but for the opposite reason it used
        to be one. It was hidden because the form did not ask; it is hidden now
        because the URL already asked, and the answer is the route. Its value is
        still the wire name /api/order accepts, so a no-JS post carries the real
        answer either way.

        `tier` stays hidden and stays written by the script, because it is
        derived (tierFor(count)) rather than answered. Its default is the tier
        that reserves nothing: a no-JS order arrives in the queue and the window
        is agreed by email, which is what the <noscript> promises. */}
    <input type="hidden" name="service" value={wire} />
    <input type="hidden" name="tier" value="unattended" />
    <input type="hidden" name="redirect" value={lp('/thank-you')} />
    <input type="hidden" name="lang" value={lang} />
    <input type="hidden" name="window_start" value="" />
    <input type="hidden" name="window_end" value="" />
    <input type="hidden" name="upload_batch" value="" />
    <input type="hidden" name="source" value={`start-${service}`} />
    <input type="text" name="company_hp" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0" />

    {/* SIGN IN FIRST, IF THERE IS ANYTHING TO SIGN IN TO. August 2026. Lucas:
        *"misschien ook bovenaan het begin van een order een knop inloggen laten
        verschijnen voor als iemand nog niet heeft ingelogd — op deze manier
        wordt het bestellen sneller en krijg je persoonlijke voorkeuren gelijk
        automatisch ingevuld. Wanneer een klant al is ingelogd dit niet laten
        zien."*

        The machinery to prefill has existed for a while: bindPrefill() in
        pipeline.js asks /account/me, fills six fields, restores the saved
        background, injects the customer's own Brand Models and collapses the
        briefing step when it has everything. All of it is silent, and all of it
        does nothing for a returning customer who simply did not think to sign
        in — which is most of them, because nothing on this page mentioned it.

        WHY IT IS AT THE TOP AND NOT BESIDE THE EMAIL FIELD. The saving is only
        real if it happens before the work does. Offered at step 3, next to the
        name and email it would have filled, it arrives after the customer has
        already typed them — at which point it is not a shortcut, it is a note
        saying they wasted a minute.

        data-acct="out" is the site's existing mechanism (Layout.astro): one
        memoised /account/me per page load, every [data-acct] node toggled in a
        single pass, painted from a sessionStorage snapshot so a signed-in
        customer usually never sees this at all rather than watching it vanish.
        The static HTML ships the signed-out state, which is correct for a
        crawler, for a browser with no JavaScript, and for most visitors. */}
    <aside class="pl-signin" data-acct="out">
      <div>
        <p class="pl-signin-h">{f.signInH}</p>
        <p class="pl-signin-body">{f.signInBody}</p>
      </div>
      <a href={lp('/account')} class="btn btn-primary pl-signin-cta">{f.signInCta}</a>
    </aside>

    <ol class="pl-rail" aria-label={f.railLabel}>
      {f.rail.map((t, i) => (
        <li>
          <button type="button" class="pl-rail-item" data-pl-rail-item={String(i + 1)}>
            <span class="pl-rail-n">{String(i + 1).padStart(2, '0')}</span>
            <span class="pl-rail-t">{t}</span>
          </button>
        </li>
      ))}
    </ol>

    <noscript><p class="pl-noscript">{f.noscript}</p></noscript>

    <!-- STEP 1 · THE ORDER -->
    <section class="pl-step" data-pl-step="1">
      <h2 class="pl-h" data-pl-head>{f.s1.h}</h2>

      {/* What was picked, and a way back. Seven photographs and three
          paragraphs of comparison used to live here; the chooser at /start is
          where that comparison belongs, and repeating it asks a visitor to
          re-decide something they decided one click ago. */}
      <p class="pl-svc">
        <span class="pl-svc-name">{svc.title}</span>
        <span class="pl-svc-gets">{svc.gets}</span>
        <a class="pl-svc-change" href={lp('/start')}>{SERVICE[lang].change}</a>
      </p>

      {/* One select, one name. Every option is a real count and the last one
          deliberately is not — countOf() in /api/order would read "30+" as
          thirty and record a number nobody chose.

          NOTHING IS PRESELECTED. It used to open on "1 product", which meant
          the line that says "choose how many and the total appears here" was
          never on screen, and an inattentive visitor could order one product by
          not answering. */}
      <div class="field">
        <label for="pl-products">{f.s1.countLabel} <span class="req">*</span></label>
        <select id="pl-products" class="select" name="products" required data-pl-req="1" data-pl-err-msg={f.s1.countErr}>
          <option value="" disabled selected>{f.s1.countPick}</option>
          {counts.map((n) => <option value={String(n)}>{countLabel(n)}</option>)}
          <option value={f.s1.more}>{f.s1.more}</option>
        </select>
        <span class="hint">{f.s1.countHint}</span>
      </div>

      {/* Task #271f — Single Product/Full outfit. Not [data-pl-req]: 0 is
          always a valid answer, so this field is never required. */}
      {!isCatalog && (
      <div class="field" data-pl-outfit>
        <label for="pl-outfit">{f.s1.outfitLabel}</label>
        <select id="pl-outfit" class="select" name="outfit_count">
          <option value="0">{f.s1.outfitNone}</option>
          {outfitCounts.slice(1).map((n) => <option value={String(n)}>{f.s1.outfitCount(n)}</option>)}
        </select>
        <span class="hint">{f.s1.outfitHint}</span>
        {/* OUTFIT_COPY, verbatim — pricing.js requires it wherever the outfit
            choice is offered. Folded rather than dropped. */}
        <Disclose summary={f.s1.outfitWhy} tone="plain">
          <p>{f.s1.outfitWhyBody}</p>
        </Disclose>
      </div>
      )}

      {isCatalog && (
        <p class="hint pl-outfit-note">{f.s1.outfitCatalogNote}</p>
      )}

      {/* THE RUNNING TOTAL.
          Three things about this block are answers to an accessibility audit
          rather than to a design brief.

          IT IS A LIVE REGION. The figure changed when the count changed and a
          screen reader said nothing at all, because nothing here was announced.
          [aria-live=polite] on the label-plus-figure-plus-rate-line, atomic so
          the three are read as one sentence rather than as a bare number.

          IT IS NEAR THE TOP. It sat 2,042px down on desktop and 2,683px on
          mobile — below a photograph grid, a background picker and a
          two-column table — so the number the whole proposition rests on was
          off-screen at the moment it changed. It now follows the two fields
          that decide it.

          IT STICKS ON MOBILE. Below 780px .pl-total-bar is fixed to the bottom
          of the viewport for as long as step 1 is the step on screen. The
          explanatory lines stay in the flow where they were.

          None of it is authoritative: a preview computed in the browser from
          the ladder in the config blob, and no amount is ever posted. */}
      <div class="pl-total">
        <div class="pl-total-live" aria-live="polite" aria-atomic="true">
          <div class="pl-total-bar">
            <span class="pl-total-label">{f.s1.totalLabel}</span>
            <span class="pl-total-figure">
              <span class="pl-total-net" data-pl-total></span>
              <span class="pl-total-excl">{f.s1.netLabel}</span>
            </span>
          </div>
          <p class="pl-total-note" data-pl-total-note></p>
        </div>
        <p class="pl-total-rung" data-pl-rung hidden></p>
        <p class="pl-total-vatnote">{f.s1.vatNote}</p>
        <p class="pl-total-display">{f.s1.displayNote}</p>
      </div>

      {/* THE ONE BLOCK THAT DIFFERS PER SERVICE. Catalog and complete slot in
          the background picker; lifestyle slots in the style picker, because a
          styled scene has no flat ground to choose. Nothing else on this page
          knows which one it got. */}
      <slot />

      {/* What the count earns. Not a control: the level FOLLOWS the count
          (tierFor(), WINDOW_THRESHOLD), so this is a statement, and the
          statement is one line that pipeline.js keeps current.

          The two-column table under it was 120 words copied verbatim from
          /pricing and it was in front of every visitor. It is the same table,
          behind a disclosure, with a link to the page that owns it. Section 13
          forbids styling Tier 0 as the lesser option, and equal columns still
          hold that up wherever the reader chooses to open it. */}
      <div class="pl-levels">
        <p class="pl-level-note" data-pl-level-note></p>
        <Disclose summary={f.s1.levelsH} tone="plain" class="pl-levels-why">
          <div class="levels">
            {levels.map((d) => (
              <div class="level" data-pl-level={d.tier}>
                <h4 class="level-h">{d.heading}</h4>
                <p class="level-band">{d.band}</p>
                <dl class="level-facts">
                  {rowLabels.map((k, j) => (
                    <div class="level-row">
                      <dt>{k}</dt>
                      <dd>{d.values[j]}</dd>
                    </div>
                  ))}
                </dl>
              </div>
            ))}
          </div>
          <p class="pl-panel-note"><a href={lp('/pricing')}>{f.s1.ladderLink}</a></p>
        </Disclose>
      </div>

      {/* THE ERROR STATE, which did not exist. Pressing Continue with nothing
          chosen left the step visually unchanged: no [aria-invalid] anywhere on
          the page, no [aria-describedby], and reportValidity()'s own bubble is
          gone in a blink and unreadable to a screen reader that has moved on.
          One box per step, filled by pipeline.js with the offending field's own
          message, and tied to that field by aria-describedby. */}
      <p class="pl-step-err" id="pl-err-1" data-pl-step-error hidden></p>

      <div class="pl-nav">
        <span></span>
        <button type="button" class="btn btn-primary" data-pl-next>{f.next}</button>
      </div>
    </section>

    <!-- STEP 2 · MATERIAL -->
    {/* ONE DROPZONE BECAME A CARD PER PRODUCT. The whole of it — the guide, the
        two ways in, the cards, the tray — is ProductUploader.astro; this step
        keeps only its heading, its error slot and its navigation, because those
        are the wizard's furniture and belong to the wizard.

        THE STEP IS STILL NEVER A GATE. Nothing on it is [data-pl-req], nothing
        validates, and Continue does not so much as look at what was uploaded. A
        missing front photo is told, not enforced: the progress line says how
        many products are ready and each card says which one is not, and then
        the customer goes on. A client who would rather send files afterwards is
        a client, not an error state — shots.js's header says so and this is the
        code that has to mean it. */}
    <section class="pl-step" data-pl-step="2">
      <h2 class="pl-h" data-pl-head>{f.s2.h}</h2>

      <ProductUploader lang={lang} />

      <p class="hint pl-skip">{f.s2.skip}</p>

      <p class="pl-step-err" id="pl-err-2" data-pl-step-error hidden></p>

      <div class="pl-nav">
        <button type="button" class="btn btn-ghost" data-pl-back>{f.back}</button>
        <button type="button" class="btn btn-primary" data-pl-next>{f.next}</button>
      </div>
    </section>

    <!-- STEP 3 · BRIEF -->
    <section class="pl-step" data-pl-step="3">
      <h2 class="pl-h" data-pl-head>{f.s3.h}</h2>
      <p class="pl-lead">{f.s3.lead}</p>
      <p class="pl-lead pl-prefill-note" data-pl-prefill-note hidden></p>

      <div class="pl-saved" data-pl-saved hidden>
        <p class="pl-saved-h">{f.s3.savedH}</p>
        <ul class="pl-saved-list" data-pl-saved-list></ul>
        <button type="button" class="btn btn-ghost pl-saved-edit" data-pl-saved-edit>{f.s3.savedEdit}</button>
        <p class="hint pl-saved-hint">{f.s3.savedHint}</p>
      </div>

      {/* One wrapper around the six fields so the collapse has a single thing
          to hide. Hidden, never disabled — a hidden input still posts. */}
      <div data-pl-s3-fields>
      {/* ── VOORNAAM EN ACHTERNAAM ────────────────────────────────────────
          Lucas, 7 augustus 2026: *"Aanpassen naar naam en achternaam."* Eén
          veld met "Je naam" erboven levert "Mara" op — genoeg voor een aanhef
          in een mail, te weinig voor de tenaamstelling op een factuur.

          `name` bestaat nog steeds in de database en wordt nog steeds gevuld,
          maar als de SAMENGESTELDE weergave; het samenvoegen gebeurt op de
          server, in src/data/address.js. Zie migrations/0016. */}
      <div class="row-2">
        <div class="field">
          <label for="pl-first">{f.s3.firstName} <span class="req">*</span></label>
          <input class="input" type="text" id="pl-first" name="first_name" autocomplete="given-name" required data-pl-req="1" data-pl-err-msg={f.s3.firstErr} />
        </div>
        <div class="field">
          <label for="pl-last">{f.s3.lastName} <span class="req">*</span></label>
          <input class="input" type="text" id="pl-last" name="last_name" autocomplete="family-name" required data-pl-req="1" data-pl-err-msg={f.s3.lastErr} />
        </div>
      </div>

      {/* ELKE RIJ TWEE VELDEN. Lucas: *"sommige invul velden staan heel random
          geplaatst en niet op een rij."* Het merkveld stond alleen met een lege
          rechterhelft ernaast, en de website hing helemaal onderaan bij het
          btw-nummer. Nu staat wat bij elkaar hoort naast elkaar — wie je bent,
          hoe we je bereiken, waar je zit — en blijft er precies één rij met een
          enkel veld over, de laatste. */}
      <div class="row-2">
        <div class="field">
          <label for="pl-brand">{f.s3.brand} <span class="req">*</span></label>
          <input class="input" type="text" id="pl-brand" name="brand" autocomplete="organization" required data-pl-req="1" data-pl-err-msg={f.s3.brandErr} />
        </div>
        <div class="field">
          <label for="pl-web">{f.s3.website} <span class="pl-opt">{f.optional}</span></label>
          <input class="input" type="url" id="pl-web" name="website" placeholder="https://" autocomplete="url" />
        </div>
      </div>

      <div class="row-2">
        <div class="field">
          <label for="pl-email">{f.s3.email} <span class="req">*</span></label>
          <input class="input" type="email" id="pl-email" name="email" autocomplete="email" required data-pl-req="1" data-pl-err-msg={f.s3.emailErr} />
          <span class="hint">{f.s3.emailHint}</span>
        </div>
        <div class="field">
          <label for="pl-phone">{f.s3.phone} <span class="pl-opt">{f.optional}</span></label>
          <input class="input" type="tel" id="pl-phone" name="phone" autocomplete="tel" placeholder="+31 6 …" />
        </div>
      </div>

      {/* ── WAAR DE KLANT ZIT, EN HET FACTUURADRES ────────────────────────
          Allebei VERPLICHT, en allebei nieuw in augustus 2026.

          Het adres was er simpelweg niet, terwijl het een formele factuureis
          is — elke factuur die dit studio ooit heeft gestuurd miste hem.

          Het LAND is het veld dat de btw bepaalt. Niet de taal, niet het
          IP-adres, en niet de twee letters die iemand voor zijn btw-nummer
          typt: een <select> met waarden die wij bepalen, omdat dit ene veld
          het verschil is tussen 21% rekenen en niets rekenen. Een vrij
          tekstveld daar is een vrij tekstveld dat belasting beslist.

          Nederland staat los bovenaan omdat het de meeste bestellingen zijn en
          omdat het het enige antwoord is dat zich anders gedraagt dan alle
          andere — zie vatDecision() in src/data/vat.js. */}
      <div class="row-2">
        <div class="field">
          <label for="pl-street">{f.s3.street} <span class="req">*</span></label>
          <input class="input" type="text" id="pl-street" name="address_line1" autocomplete="address-line1" required data-pl-req="1" data-pl-err-msg={f.s3.streetErr} placeholder={f.s3.streetPh} />
        </div>
        <div class="field">
          <label for="pl-street2">{f.s3.street2} <span class="pl-opt">{f.optional}</span></label>
          <input class="input" type="text" id="pl-street2" name="address_line2" autocomplete="address-line2" placeholder={f.s3.street2Ph} />
        </div>
      </div>

      {/* ── VIER VELDEN IN PLAATS VAN ÉÉN ─────────────────────────────────
          Lucas: *"Is factuuradres in 1 regel wel handig, dit doen ze toch vaak
          apart."* Drie redenen, in migrations/0016 uitgeschreven; de zwaarste
          is dat een factuur de regels onder elkaar moet zetten en dat uit één
          vrij ingetypt veld niet te halen is.

          De tweede is hier zichtbaar aan de autocomplete-waarden:
          address-line1, postal-code en address-level2 worden door browsers
          herkend en ingevuld. `street-address` op één input is de slechtst
          ondersteunde van het stel, en dit is een formulier dat iemand bij elke
          bestelling opnieuw invult.

          Toevoeging en provincie blijven optioneel: die ontbreken op een echt
          adres ook echt, en in het grootste deel van Europa staat er geen
          provincie op. */}
      <div class="row-2">
        <div class="field">
          <label for="pl-postal">{f.s3.postal} <span class="req">*</span></label>
          <input class="input" type="text" id="pl-postal" name="postal_code" autocomplete="postal-code" required data-pl-req="1" data-pl-err-msg={f.s3.postalErr} placeholder={f.s3.postalPh} />
        </div>
        <div class="field">
          <label for="pl-city">{f.s3.city} <span class="req">*</span></label>
          <input class="input" type="text" id="pl-city" name="city" autocomplete="address-level2" required data-pl-req="1" data-pl-err-msg={f.s3.cityErr} />
        </div>
      </div>

      <div class="row-2">
        <div class="field">
          <label for="pl-country">{f.s3.country} <span class="req">*</span></label>
          <select class="input" id="pl-country" name="country" autocomplete="country" required data-pl-req="1" data-pl-err-msg={f.s3.countryErr}>
            <option value="">{f.s3.countryPick}</option>
            {COUNTRIES.home.map((ct) => (<option value={ct.id}>{ct.name}</option>))}
            <optgroup label={f.s3.countryEu}>
              {COUNTRIES.eu.map((ct) => (<option value={ct.id}>{ct.name}</option>))}
            </optgroup>
            <optgroup label={f.s3.countryOther}>
              {COUNTRIES.other.map((ct) => (<option value={ct.id}>{ct.name}</option>))}
            </optgroup>
          </select>
        </div>
        <div class="field">
          <label for="pl-region">{f.s3.region} <span class="pl-opt">{f.optional}</span></label>
          <input class="input" type="text" id="pl-region" name="region" autocomplete="address-level1" />
          <span class="hint">{f.s3.regionHint}</span>
        </div>
      </div>

      <div class="row-2">
        {/* ── HET BTW-NUMMER IS VERPLICHT, TENZIJ JE ZEGT DAT JE ER GEEN HEBT
            Lucas: *"inclusief btw-nummer met een checkbox bij btw-nummer toch
            te skippen als de klant geen btw-nummer heeft of buiten de eu
            komt."*

            Een leeg veld is dubbelzinnig — "nog niet ingevuld" of "die heb ik
            niet" — en dat verschil is precies wat je wilt weten. Een
            particulier en een Amerikaans bedrijf hebben er geen. Een Duits
            bedrijf dat het vergeet hoort het wél te merken: zonder nummer
            betaalt het 21% dat het had kunnen laten verleggen.

            HET VINKJE KOOPT GEEN 0%. vatDecision() in src/data/vat.js kijkt
            naar het land en naar een bij VIES BEVESTIGD nummer, en verder naar
            niets. Dit gaat alleen over of het veld ingevuld moet zijn.

            `required` staat er NIET op: dit formulier heeft wel script, maar
            een required-attribuut dat door een vinkje aan en uit gaat is een
            tweede plek waar de regel staat. data-pl-req-unless wijst naar het
            vinkje, en validate() in pipeline.js leest die ene bron. */}
        <div class="field">
          <label for="pl-vat">{f.s3.vat} <span class="req">*</span></label>
          <input class="input" type="text" id="pl-vat" name="vat" autocomplete="off" placeholder="NL000000000B00" data-pl-req="1" data-pl-req-unless="no_vat" data-pl-err-msg={f.s3.vatErr} />
          <label class="pl-check" for="pl-no-vat">
            <input type="checkbox" id="pl-no-vat" name="no_vat" value="1" />
            <span>{f.s3.noVat}</span>
          </label>
          <span class="hint">{f.s3.vatHint}</span>

          {/* ── DE VERKLARING BIJ 0% ────────────────────────────────────────
              Uit btwverleggingspecificatie.md §4. Verborgen tot er werkelijk 0%
              uit de beslissing komt, en dan verplicht.

              WAAROM HIJ ER STAAT. Bij een verlegging schuift de btw-plicht naar
              de afnemer, en bij een verlegging die onjuist blijkt komt de
              naheffing bij de leverancier — bij VISUAILS. Dit vinkje is het
              enige bewijs dat de claim van de klant komt en niet van ons.

              WAAROM ER GEEN NIEUWE REGEL VOOR NODIG WAS. syncRequired() in
              pipeline.js zet `required` al op elk veld met `data-pl-req="1"`
              dat ZICHTBAAR is. Dit blok is `hidden` tot 0% van toepassing is,
              dus is het vinkje dan niet zichtbaar en niet verplicht, en zodra
              het verschijnt is het dat wel. Eén bron, geen tweede attribuut.

              Zonder JavaScript blijft het blok verborgen en blokkeert het niets.
              Dan is er ook geen 0% zonder verklaring: de poort in
              functions/api/order.js houdt de betaling tegen en de order komt op
              de beoordelingslijst. Degraderen naar veilig, niet naar gratis. */}
          <div class="field pl-vatconfirm" data-pl-vatconfirm hidden>
            <label class="pl-check" for="pl-vat-confirmed">
              <input type="checkbox" id="pl-vat-confirmed" name="vat_confirmed" value="yes"
                     data-pl-req="1" data-pl-err-msg={f.s3.vatConfirm} />
              <span>{f.s3.vatConfirm}</span>
            </label>
            <span class="hint">{f.s3.vatConfirmHint}</span>
          </div>
        </div>
      </div>
      </div>{/* /[data-pl-s3-fields] */}

      {/* OUTSIDE the collapsible block, deliberately: these two are the things
          on this step that are about THIS order rather than about the
          customer, so a saved record cannot answer either of them.

          ONE NEW FIELD, NOT FOUR. src/data/attributes.js's ORDER_QUESTIONS
          comment is the argument and it has to survive: the research put three
          things at order level — who it is for, references, and what the brand
          never does — and the textarea below already takes two of them, now by
          name in its hint. So only the one it genuinely cannot prompt gets a
          box of its own. Do not add fields for the other two.

          Optional like everything attributes.js asks: no `required`, no
          data-pl-req, nothing that stops Continue. Its `buys` line is the hint,
          which costs one line ONCE for the whole order — the reason the
          per-product question cannot do the same thing and points at a guide
          instead. */}
      {(isCatalog ? [] : ORDER_QUESTIONS).map((qn) => (
        <div class="field">
          <label for={`pl-${qn.id}`}>{qn.name[lang]} <span class="pl-opt">{f.optional}</span></label>
          <input
            class="input"
            type="text"
            id={`pl-${qn.id}`}
            name={qn.id}
            maxlength={qn.maxLength}
            autocomplete="off"
            placeholder={qn.placeholder ? qn.placeholder[lang] : undefined}
          />
          <span class="hint">{qn.buys[lang]}</span>
        </div>
      ))}

      {!isCatalog && (
      <div class="field">
        <label for="pl-msg">{f.s3.message} <span class="pl-opt">{f.optional}</span></label>
        <textarea class="textarea" id="pl-msg" name="message"></textarea>
        <span class="hint">{f.s3.messageHint}</span>
      </div>
      )}

      <p class="pl-step-err" id="pl-err-3" data-pl-step-error hidden></p>

      <div class="pl-nav">
        <button type="button" class="btn btn-ghost" data-pl-back>{f.back}</button>
        <button type="button" class="btn btn-primary" data-pl-next>{f.next}</button>
      </div>
    </section>

    <!-- STEP 4 · TIMING -->
    <section class="pl-step" data-pl-step="4">
      <h2 class="pl-h" data-pl-head>{f.s4.h}</h2>
      <p class="pl-lead">{f.s4.lead}</p>

      {/* Every panel ships hidden and gateShow() reveals exactly one. The six
          answers /api/capacity can give are six different sentences here, on
          purpose — three of them are empty results meaning different things. */}
      <div class="pl-gate">
        <div class="pl-gate-lost" data-pl-gate-lost hidden role="alert">
          <h3 class="pl-gate-h">{f.s4.lostH}</h3>
          <p class="pl-gate-body">{f.s4.lostBody}</p>
        </div>

        <p class="pl-gate-checking" data-pl-gate="checking" hidden aria-live="polite">{f.s4.checking}</p>

        <div class="pl-gate-panel is-queue" data-pl-gate="queue" hidden>
          <h3 class="pl-gate-h">{f.s4.queueH}</h3>
          <p class="pl-gate-claim">{unattended.queue[lang]}</p>
          <p class="pl-gate-body">{f.s4.queueBody}</p>
        </div>

        <div class="pl-gate-panel" data-pl-gate="ok" hidden>
          <h3 class="pl-gate-h">{f.s4.okH}</h3>
          <p class="pl-gate-body">{f.s4.okBody}</p>
          <div class="pl-windows" data-pl-windows></div>
          <p class="pl-gate-foot">{f.s4.okMax} <span data-max>{ATTENDED_PER_WINDOW}</span> {f.s4.okMaxTail}</p>
        </div>

        <div class="pl-gate-panel" data-pl-gate="full" hidden>
          <h3 class="pl-gate-h">{f.s4.fullH}</h3>
          <p class="pl-gate-body">{f.s4.fullBody}</p>
        </div>

        <div class="pl-gate-panel" data-pl-gate="too-large" hidden>
          <h3 class="pl-gate-h">{f.s4.tooLargeH}</h3>
          <p class="pl-gate-body">{f.s4.tooLargeBody} <span data-max>{ATTENDED_PER_WINDOW}</span> {f.s4.tooLargeTail}</p>
        </div>

        <div class="pl-gate-panel" data-pl-gate="invalid" hidden>
          <h3 class="pl-gate-h">{f.s4.invalidH}</h3>
          <p class="pl-gate-body">{f.s4.invalidBody}</p>
        </div>

        <div class="pl-gate-panel" data-pl-gate="unavailable" hidden>
          <h3 class="pl-gate-h">{f.s4.unavailableH}</h3>
          <p class="pl-gate-body">{f.s4.unavailableBody}</p>
          <button type="button" class="btn btn-ghost" data-pl-gate-retry>{f.s4.retry}</button>
        </div>
      </div>

      <noscript><p class="pl-noscript">{f.s4.nojs}</p></noscript>

      <p class="pl-step-err" id="pl-err-4" data-pl-step-error hidden></p>

      <div class="pl-nav">
        <button type="button" class="btn btn-ghost" data-pl-back>{f.back}</button>
        <button type="button" class="btn btn-primary" data-pl-next>{f.next}</button>
      </div>
    </section>

    <!-- STEP 5 · CONFIRM -->
    <section class="pl-step" data-pl-step="5">
      <h2 class="pl-h" data-pl-head>{f.s5.h}</h2>
      <p class="pl-lead">{f.s5.lead}</p>

      <dl class="pl-summary" data-pl-summary></dl>

      <p class="pl-error" data-pl-error hidden role="alert"></p>
      <p class="pl-step-err" id="pl-err-5" data-pl-step-error hidden></p>

      <div class="pl-lost" data-pl-lost hidden role="alert">
        <h3 class="pl-lost-h">{f.s5.lostH}</h3>
        <p class="pl-lost-body">{f.s5.lostBody}</p>
        <button type="button" class="btn btn-primary" data-pl-lost-go>{f.s5.lostGo}</button>
      </div>

      <div class="pl-after">
        <h3 class="pl-sub-h">{f.s5.afterH}</h3>
        <ul class="pl-after-list">
          {f.s5.after.map((t) => <li>{t}</li>)}
        </ul>
        <p class="pl-pay-note">{f.s5.payNote}</p>

        {/* THE WITHDRAWAL WAIVER. See src/data/consent.js for the two statutory
            conditions it satisfies and why the VERSION rather than a boolean is
            what gets stored.

            `required`, and placed immediately above the submit rather than in a
            block of small print further up: a consent nobody read is a consent
            nobody gave, and the last thing before the button is the one thing
            everybody looks at.

            The version rides in a hidden field beside it. If the box is somehow
            absent — scripts off does not affect it, but a hand-built POST would
            — /api/order records that fact rather than refusing the order, which
            is this file's standing rule: never lose an order to protect a
            secondary step. What it must never do is record consent that was not
            given, which is why the hidden field carries only the version and the
            checkbox carries the agreement. */}
        <input type="hidden" name="consent_version" value={CONSENT_VERSION} />
        <label class="pl-consent">
          <input type="checkbox" name="withdrawal_consent" value="yes" required
                 data-pl-err-msg={lang === 'nl' ? "Vink dit aan om te bevestigen dat we mogen beginnen voordat je bedenktijd voorbij is." : "Please tick this to confirm you agree production may start before the withdrawal period ends."} />
          <span>{currentConsent(lang)}</span>
        </label>
      </div>

      {/* Shown by pipeline.js to a signed-in customer who has NOT saved before,
          and to nobody else. UNCHECKED IN THE MARKUP AND NEVER TICKED BY CODE.
          No name attribute — it is read by JS and posted to /account/details
          afterwards, and a name would file a UI preference in the order. */}
      <div class="pl-save-offer" data-pl-save-offer hidden>
        <label class="pl-save-row">
          <input type="checkbox" data-pl-save-check />
          <span class="pl-save-label">{f.s5.saveLabel}</span>
        </label>
        {/* Twee hints, waarvan er altijd precies één zichtbaar is. Wie is
            ingelogd krijgt het opgeslagen zodra de bestelling doorkomt; wie niet
            is ingelogd krijgt het opgeslagen zodra hij voor het eerst inlogt, en
            dat verschil hoort hij te lezen voordat hij het vinkje zet. */}
        <p class="hint pl-save-hint" data-pl-save-hint="in">{f.s5.saveHint}</p>
        <p class="hint pl-save-hint" data-pl-save-hint="out" hidden>{f.s5.saveHintOut}</p>
        {/* Zonder naam kan het vinkje zelf niets in de bestelling filen — zie
            hierboven. Dit veld draagt alleen de UITKOMST, en alleen voor een
            bezoeker die niet is ingelogd: die kan zijn gegevens niet via
            /account/details opslaan, want daar is een sessie voor nodig. */}
        <input type="hidden" name="save_details" value="" data-pl-save-flag />
      </div>

      <div class="pl-submit-row">
        <button type="button" class="btn btn-ghost pl-back-inline" data-pl-back>{f.back}</button>
        <button type="submit" class="btn btn-primary btn-lg" data-pl-submit>{f.s5.submit}</button>
      </div>

      {/* THE TERMS, AT THE MOMENT THE CONTRACT IS FORMED.
          Until August 2026 no form on this site linked to the terms or the
          privacy policy at all — not this one, not the contact form, not the
          Brand Model brief. The footer carried them, which is not the same
          thing: for general terms to bind, the other party has to be given a
          reasonable opportunity to read them BEFORE or AT the moment of
          agreeing, and a link in the footer of a different page is not that
          moment. This is that moment.

          A LINE, NOT A SECOND CHECKBOX, and that is deliberate. The waiver
          above has to be an explicit act because the statute requires an
          express declaration; accepting terms does not, as long as they are
          presented where the agreement happens. Stacking two mandatory ticks
          would add friction to protect something that a link already protects,
          and a form that asks twice gets read half as carefully.

          The confirmation email carries the same two links, because that is the
          durable copy the customer keeps. */}
      <p class="pl-legal">
        {f.s5.legal[0]}<a href={lp('/terms')}>{f.s5.legalTerms}</a>{f.s5.legal[1]}
        <a href={lp('/privacy')}>{f.s5.legalPrivacy}</a>{f.s5.legal[2]}
      </p>
    </section>
  </form>
</div></section>

<!-- WHAT IS THE SAME IN BOTH -->
<section class="section-tight on-ink"><div class="container">
  <h2>{f.sharedH}</h2>
  <div class="shared-grid reveal-group">
    {f.shared.map(([k, v]) => (
      <div class="shared-item reveal pending">
        <h3>{k}</h3>
        <p>{v}</p>
      </div>
    ))}
  </div>
</div></section>

<!-- NOT SURE YET -->
<section class="section-tight"><div class="container">
  <div class="start-foot">
    <div>
      <h2>{f.footH}</h2>
      <p class="start-foot-body">{f.footBody}</p>
    </div>
    <div class="start-foot-cta">
      <a href={lp('/test-sample')} class="btn btn-primary btn-lg">{f.footCta}</a>
      <a href={waHref(f.footWaText)} target="_blank" rel="noopener" class="btn btn-ghost btn-lg">{f.footWa}</a>
    </div>
  </div>
</div></section>

<script>
  // Page-local, deliberately. pipeline.js is 30 kB of order-form machinery and
  // Layout.astro must not carry it to every page on the site to serve one.
  import '../../scripts/pipeline.js';
</script>
<style>
  /* ═══════════════════════════════════════════════════════════════════════════
     /start — the order pipeline.

     Two things about this sheet are not obvious and are load-bearing.

     FIRST: Astro scopes every selector here to this component by rewriting it to
     :where(.astro-HASH). Elements pipeline.js builds with document.createElement
     never receive that attribute, so a bare `.pl-window` rule would match
     nothing at all. Every rule for a generated element is therefore written as a
     scoped ancestor with a :global() descendant — `.pl-windows :global(.pl-window)`.
     The generated elements this sheet still owns are the window buttons
     (.pl-window and its two spans) and the summary's own dt/dd pairs. Nothing
     else: step 2's generated cards, slots and tray rows moved to
     ProductUploader.astro along with the markup around them, and a rule for
     them here would be unreachable in both directions — wrong hash on the
     ancestor, no hash at all on the child.

     SECOND: this form works with JavaScript switched off, and almost every
     display rule below exists to make that true. Without JS all five steps are
     the page, stacked and separated by a rule, and the browser's own validation
     posts them in one go. pipeline.js adds .is-live to the form as its first
     act, and .is-live is what turns the stack into a wizard. Anything that only
     works live — the rail, the step navigation, the uploader, the running total
     — is hidden until that class lands, because a control that silently does
     nothing is worse than a control that is not there.
     ═══════════════════════════════════════════════════════════════════════════ */

  /* pipeline.js hides things by setting el.hidden, and the UA's own
     `[hidden] { display: none }` sits in the user-agent origin, where it loses
     to ANY author rule. .btn is display:inline-flex and .field is display:flex,
     so without this the hidden gate panels, the closed sub-panel and the two
     count presentations would all render at once. global.css has no [hidden]
     rule to inherit. The :global() twin covers generated elements. */
  [hidden] { display: none !important; }
  .pl-form :global([hidden]) { display: none !important; }

  /* The signed-out sign-in prompt. Deliberately not a .mail-note clone: this
     one is asking for an action rather than offering reassurance, so it gets a
     real primary button and a heading, and it sits on the raised surface with
     an accent edge so it reads as an offer at the top of the form rather than
     as a warning about it. */
  .pl-signin {
    display: flex; align-items: center; gap: clamp(1rem, 2.5vw, 2rem); flex-wrap: wrap;
    margin: 0 0 clamp(1.4rem, 3vw, 2rem);
    padding: clamp(1rem, 2vw, 1.3rem) clamp(1.1rem, 2.2vw, 1.5rem);
    border-radius: var(--r-lg);
    background: var(--surface);
    box-shadow: inset 3px 0 0 var(--accent), inset 0 1px 0 rgb(255 255 255 / 0.05);
  }
  .pl-signin > div { flex: 1 1 22rem; }
  .pl-signin-h { margin: 0; font-weight: 700; color: var(--ink); font-size: .98rem; }
  .pl-signin-body { margin: .3rem 0 0; font-size: .88rem; line-height: 1.55; color: var(--ink-3); }
  .pl-signin-cta { flex: 0 0 auto; }
  @media (max-width: 560px) { .pl-signin-cta { width: 100%; } }

  /* No .sr-only or .visually-hidden exists sitewide; the fieldset legend needs
     one. Clipped rather than display:none, so it stays in the a11y tree. */
  .pl-sr {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  /* ── Form primitives ──────────────────────────────────────────────────────
     .field / .req / .hint / .input / .textarea / .select / .row-2 / .opt* /
     .dropzone now live in global.css, under "form primitives". The block that
     used to sit here said they would move "when those pages retire in the
     redirect pass"; they have.

     The three kind options are a plain .opt-stack now, which is the global
     rule and needs nothing here. The override that used to live at this spot
     (.pl-panel > .opt) belonged to the sub-panels the scope door opened, and
     went with them. */

  /* ── Step frame ───────────────────────────────────────────────────────────
     global.css puts clamp(4.5rem, 9vw, 9rem) of padding on every <section>,
     including these five nested ones. Left alone that is nine rems of nothing
     between a heading and its own fields. */
  .pl-step { padding-block: 0; }

  /* No-JS reading order: five stacked steps with a rule between them, so the
     page reads as one long form rather than five headings running together.
     Cancelled the moment the wizard takes over, where only one is ever shown
     and a top border would be a line under nothing. */
  .pl-step + .pl-step {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    padding-top: clamp(2.5rem, 5vw, 4rem);
    border-top: 1px solid var(--line);
  }
  .pl-form.is-live .pl-step + .pl-step { margin-top: 0; padding-top: 0; border-top: 0; }

  .pl-form.is-live .pl-step { display: none; }
  .pl-form.is-live .pl-step.is-current { display: block; }

  /* Measure. One number for the whole form, declared once, so the heading, the
     fields, the summary rules and the submit button all stop at the same x.
     That is what makes five steps read as one object instead of five pages that
     happen to follow each other. Step 4 is wider because it is a two-up upload
     grid rather than prose.

     Step 1 is the exception, and it is an exception about the doors ONLY: the
     two service models are compared side by side, and squeezing that comparison
     is the one thing section 13 forbids. So the step uncaps and every child
     except the doors' fieldset takes the measure back. Capping the step and
     letting .pl-fieldset break out would say the same thing, but only through
     negative margins keyed to the container's own padding — a number that would
     then have to track clamp(1.2rem, 4vw, 2.6rem) by hand, in two places,
     forever. Done this way the measure is the default and full-bleed is the
     opt-out, so a child added to step 1 later inherits the safe behaviour
     rather than the escape hatch.

     Specificity is (0,3,0) — :not() contributes its argument's weight — against
     Astro's zero-weight :where(.astro-HASH). Nothing in this block competes. */
  .pl-form { --pl-measure: 880px; }
  .pl-step { max-width: var(--pl-measure); }
  .pl-step[data-pl-step="4"] { max-width: 980px; }
  .pl-step[data-pl-step="1"] { max-width: none; }
  .pl-step[data-pl-step="1"] > :not(.pl-fieldset) { max-width: var(--pl-measure); }

  .pl-h { font-size: var(--t-h3); line-height: 1.2; text-wrap: balance; }
  /* show() calls .focus() on the heading so the step change is announced. A
     programmatic focus on tabindex="-1" does not satisfy :focus-visible, so the
     ring appears for keyboard users and never as a stray outline after a click. */
  .pl-h:focus { outline: none; }
  .pl-h:focus-visible { outline: 2px solid var(--focus-ring); outline-offset: 4px; }
  .pl-lead { margin-top: .7rem; color: var(--ink-3); max-width: 62ch; }
  /* Task #271e, 2026-07-29: distinct from .pl-lead only in weight and size —
     smaller and italic, the way a caption reads next to a heading, not a
     second sentence of the same lead. It says what pipeline.js's
     bindPrefill() did (see that file), not a claim from the design system's
     Verify/Flag pair (DESIGN.md's dated addendum, task #271c): "your details
     were filled in" is neither a review claim nor a delivery window, so it
     gets no rule/colour from that system — reaching for it here would be the
     decorative use colorize.md explicitly bans. */
  .pl-prefill-note { font-size: .82rem; font-style: italic; margin-top: .35rem; }

  /* ---- the collapsed brief step (August 2026) ------------------------------
     A returning customer who saved their details gets this instead of six
     filled boxes. It is a PANEL and not a card: --r-lg, a hairline, the lift
     ground — the same vocabulary .pl-gate-panel uses two hundred lines down for
     the other place this form answers a question on the visitor's behalf.

     The values are set in a monospace-ish tabular rhythm rather than as prose,
     because they are being READ BACK for checking, not read. Nothing here is
     an input: the real fields are still in the DOM, still posting, just
     hidden — see collapseBrief() in pipeline.js. */
  .pl-saved {
    margin: 1.2rem 0 1.8rem; padding: clamp(1rem, 2.5vw, 1.4rem);
    border: 1px solid var(--line); background: var(--surface-2, var(--surface));
    border-radius: var(--r-lg); max-width: 62ch;
  }
  .pl-saved-h { margin: 0; font-size: .78rem; font-weight: 700; letter-spacing: .09em; text-transform: uppercase; color: var(--ink-3); }
  .pl-saved-list { list-style: none; margin: .6rem 0 0; padding: 0; display: grid; gap: .2rem; }
  .pl-saved-list li { font-size: .96rem; color: var(--ink); overflow-wrap: anywhere; }
  .pl-saved-edit { margin-top: .9rem; }
  .pl-saved-hint { margin-top: .6rem; }

  /* ---- the offer to save, on the confirm step -----------------------------
     Quiet on purpose. It sits a paragraph above the send button and it is not
     the decision being made on this screen — an opt-in that competes with the
     submit is an opt-in people tick to get past it. --r-md, one step down from
     the panel above, because it is a control and not a surface. */
  .pl-save-offer {
    margin: 1.4rem 0 0; padding: .9rem 1rem;
    border: 1px solid var(--line); border-radius: var(--r-md);
    max-width: 62ch;
  }
  .pl-save-row { display: flex; align-items: flex-start; gap: .6rem; cursor: pointer; }
  /* Same 22px as .cc-check in CookieConsent.astro, the only other checkbox on
     the site, and for the same reason it is 22px there rather than the 18px
     global.css draws: every input on this site takes --r-md (8px) and 8px on
     an 18px box is a circle, i.e. a checkbox that reads as a radio button.
     The box grows so the token still reads as a rounded square. The radius
     itself is not touched here — it comes off the scale, as everything does. */
  .pl-save-row input { flex: 0 0 auto; width: 22px; height: 22px; margin-top: .05rem; accent-color: var(--accent); }
  .pl-save-label { font-size: .94rem; color: var(--ink); }
  .pl-save-hint { margin-top: .5rem; }

  .pl-sub-h { font-size: 1.05rem; line-height: 1.3; }
  .pl-opt { font-weight: 500; font-size: .78rem; color: var(--ink-3); text-transform: lowercase; }

  /* Het vinkje onder het btw-veld. ONDER en niet ernaast: het is geen tweede
     vraag maar het antwoord "niet van toepassing" op de vraag erboven, en
     ernaast zou het op een telefoon een kolom worden die nergens past. */
  .pl-check {
    display: flex; align-items: center; gap: .5rem;
    margin-top: .45rem; font-size: .86rem; font-weight: 400; color: var(--ink-2);
    text-transform: none; letter-spacing: 0; cursor: pointer;
  }
  /* Geen eigen maat: global.css tekent het vakje al (18px, vierkant, met een
     vinkje in de accentkleur). Een tweede maat hier zou het uit de pas laten
     lopen met elke andere checkbox op de site. */
  .pl-check input { flex: 0 0 auto; }
  @media (pointer: coarse) { .pl-check { min-height: 44px; } }

  /* Aangevinkt: het veld erboven is niet meer aan de beurt. Gedempt, niet
     uitgeschakeld — een uitgeschakeld veld post niets, en wie zich bedenkt en
     tóch een nummer intikt hoort dat gewoon te kunnen. syncRequired() haalt de
     eis eraf; zie waived() in pipeline.js. */
  .field:has(.pl-check input:checked) input[name="vat"] { opacity: .45; }
  /* Alléén het veldlabel, niet het label van het vinkje zelf — `> label` raakte
     ook `<label class="pl-check">`, zodat het vinkje dat je net aanzette
     zichzelf dimde. */
  .field:has(.pl-check input:checked) > label[for="pl-vat"] { opacity: .6; }

  .pl-fieldset { border: 0; padding: 0; margin: 0; min-width: 0; }

  .pl-noscript,
  .pl-note {
    margin: 0 0 clamp(1.6rem, 3vw, 2.2rem);
    padding: 1.05rem 1.25rem;
    font-size: .95rem;
    line-height: 1.55;
    max-width: 78ch;
  }
  .pl-noscript { border: 1px solid var(--signal); background: var(--paper-2); color: var(--signal-ink); }
  .pl-note { margin: .9rem 0 0; border: 1px solid var(--warn); background: var(--paper-2); color: var(--warn-ink); }

  /* ── The rail ─────────────────────────────────────────────────────────────
     Backwards only. A step you have not reached is not a link, and styling it
     as one invites a click that bindNav() then refuses. */
  .pl-rail {
    display: none;
    grid-template-columns: repeat(5, 1fr);
    list-style: none;
    margin: 0 0 clamp(2rem, 4vw, 3rem);
    padding: 0;
    border: 1px solid var(--line-strong);
  }
  .pl-form.is-live .pl-rail { display: grid; }
  .pl-rail > li { display: flex; }
  .pl-rail > li + li { border-left: 1px solid var(--line-strong); }
  .pl-rail-item {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: .3rem;
    align-items: flex-start;
    padding: .85rem 1rem;
    background: none;
    border: 0;
    cursor: default;
    font: inherit;
    text-align: left;
    color: var(--ink-3);
    transition: background var(--dur-1) var(--ease), color var(--dur-1) var(--ease);
  }
  .pl-rail-item.is-done { cursor: pointer; color: var(--ink-2); }
  .pl-rail-item.is-current { background: var(--accent-soft); color: var(--ink); }
  .pl-rail-n { font-family: var(--font-display); font-weight: 800; font-size: .8rem; }
  .pl-rail-t { font-size: .78rem; letter-spacing: .06em; text-transform: uppercase; font-weight: 600; }

  /* Prose under a control: an aside for someone still deciding, not another
     thing to answer. Some of it arrives through set:html and so carries no
     scope attribute — :global() on the descendant is what reaches the anchors. */
  .pl-panel-note { margin-top: .55rem; font-size: .86rem; color: var(--ink-3); line-height: 1.55; }
  .pl-panel-note :global(a) { color: var(--accent-bright); text-decoration: underline; text-underline-offset: 3px; }
  .pl-fieldset .pl-sub-h { margin-bottom: .9rem; }


  /* Folded rationale. OUTFIT_COPY has to be on this page (pricing.js says so);
     it does not have to be in front of the ninety per cent who are ordering
     single products. */
  .pl-why { margin-top: .2rem; }
  .pl-why > summary {
    width: max-content;
    cursor: pointer;
    font-size: .8rem;
    color: var(--accent-bright);
    text-decoration: underline;
    text-underline-offset: 3px;
    border-radius: var(--r-sm);
  }
  .pl-why > summary:focus-visible { outline: 2px solid var(--focus-ring); outline-offset: 3px; }
  .pl-why > p { margin-top: .5rem; font-size: .82rem; color: var(--ink-3); line-height: 1.55; max-width: 70ch; }

  /* Every block in step 1 moves in one interval, so the count field, the
     outfit field, the total and the levels table read as one column of
     answers rather than four things that happen to follow each other. */
  .pl-step[data-pl-step="1"] > .field,
  .pl-levels { margin-top: clamp(1.6rem, 3vw, 2.2rem); }

  /* Live-only: nothing fills it without JS, and a box labelled "running total"
     showing nothing is worse than no box. */
  .pl-total {
    display: none;
    margin-top: clamp(1.6rem, 3vw, 2.2rem);
    padding-top: 1.2rem;
    border-top: 1px solid var(--line-strong);
  }
  .pl-form.is-live .pl-total { display: block; }
  .pl-total-label { display: block; font-size: .72rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--ink-3); }

  /* Three rows, and the third is the one a client reads as the total — so it
     is the one that gets the display face. The first two are the same size as
     each other on purpose: net and VAT are two halves of one statement, and
     setting the net figure large would be the "big number, asterisk, plus VAT
     in small type" trick with better typography. */
  .pl-total-lines { margin: .8rem 0 0; }
  .pl-total-vatnote { margin: .8rem 0 0; font-size: .78rem; line-height: 1.55; color: var(--ink-3); max-width: 62ch; }
  .pl-total-row {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 1rem;
    align-items: baseline;
    padding: .45rem 0;
  }
  .pl-total-row dt { font-size: .9rem; color: var(--ink-3); }
  .pl-total-row dd { margin: 0; font-size: .95rem; color: var(--ink-2); font-variant-numeric: tabular-nums; }
  .pl-total-row.is-gross { border-top: 1px solid var(--line); padding-top: .8rem; margin-top: .3rem; }
  .pl-total-row.is-gross dt { color: var(--ink); font-weight: 500; }
  .pl-total-row.is-gross dd {
    font-family: var(--font-display); font-weight: 800;
    font-size: clamp(1.5rem, 2.6vw, 2rem); line-height: 1; letter-spacing: -0.03em;
    color: var(--ink);
  }

  .pl-total-note { margin-top: .8rem; font-size: .85rem; color: var(--ink-3); line-height: 1.5; }
  /* The one line on this step that is an offer rather than a fact, so it is
     the one line that carries the system colour — the same treatment the gate
     note gets, for the same reason: it is a statement of how the ladder works,
     not a scarcity badge. */
  .pl-total-rung {
    margin-top: .8rem;
    padding: .75rem .95rem;
    border: 1px solid var(--signal);
    background: var(--paper-2);
    color: var(--signal-ink);
    font-size: .9rem;
    line-height: 1.5;
  }
  .pl-total-first,
  .pl-total-display { margin-top: .6rem; font-size: .82rem; color: var(--ink-3); line-height: 1.5; max-width: 62ch; }
  .pl-total-display { font-style: italic; }

  /* The two service levels. One rule between them: no floating cards, no
     shadow, no elevation difference. Equal column widths are load-bearing.
     Section 13 forbids styling Tier 0 as the lesser option, and a narrower,
     lighter or shorter column would say exactly that without using any of the
     words it bans — which matters more now that the reader is not choosing
     between them but being told which one their count landed on. */
  .levels {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border: 1px solid var(--line-strong);
    margin-top: .9rem;
  }
  .level {
    display: flex;
    flex-direction: column;
    padding: clamp(1.2rem, 2.4vw, 2rem);
    transition: background var(--dur-1) var(--ease), box-shadow var(--dur-1) var(--ease);
  }
  .level + .level { border-left: 1px solid var(--line-strong); }
  /* Written by pipeline.js from the count. Identical treatment on either
     column — which one is marked is the only difference the two are allowed
     to have. */
  .level.is-current { background: var(--accent-soft); box-shadow: inset 0 0 0 2px var(--accent); }

  .level-h { font-size: 1.15rem; line-height: 1.25; text-wrap: balance; }
  .level-band { margin-top: .3rem; font-size: .72rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--ink-3); }
  .level-facts { margin-top: 1.2rem; border-top: 1px solid var(--line); }
  /* min-height is the same class of problem it solved on the doors this block
     replaced: the two fact lists sit either side of a vertical rule and the
     reader compares them ROW BY ROW — turnaround against turnaround, queue
     against queue. One value wrapping to two lines while its opposite number
     fits on one pushes every row below it out of step.

     Two lines is the ceiling, measured rather than assumed: the longest value
     in either language is 72 characters (NL queue) and dd fits ~44 characters
     per line at the narrowest two-up width. The arithmetic, term by term, from
     declarations in this rule and the dd rule below: 2 lines × line-height 1.5
     × font-size .9rem, + .75rem padding top and bottom, + the 1px bottom rule.
     box-sizing is border-box sitewide (global.css:247), so min-height has to
     carry the last two. */
  .level-row {
    display: grid;
    grid-template-columns: 6.5rem 1fr;
    gap: .9rem;
    padding: .75rem 0;
    border-bottom: 1px solid var(--line);
    min-height: calc(2 * 1.5 * .9rem + 1.5rem + 1px);
  }
  .level-row dt {
    font-size: .68rem; font-weight: 700; letter-spacing: .08em;
    text-transform: uppercase; color: var(--ink-3); padding-top: .18rem;
  }
  .level-row dd { margin: 0; font-size: .9rem; color: var(--ink-2); line-height: 1.5; }

  /* Written by pipeline.js, so it is empty without JS — where both columns
     already say everything and a sentence naming one of them would be a claim
     about a count nothing has read. */
  .pl-level-note { margin-top: .9rem; font-size: .9rem; color: var(--ink-2); line-height: 1.6; max-width: 70ch; }
  .pl-level-note:empty { display: none; }

  /* ── Step 2 · material ────────────────────────────────────────────────────
     Everything that was here is in ProductUploader.astro now, with the markup
     it paints — the dropzone, the file rows, the drag state and the count line
     all belonged to a control this file no longer renders, and a scoped rule
     here could not reach that component's elements anyway (Astro scopes to the
     component, and ProductUploader's nodes carry ITS hash, not this one's).

     What stays is the one line that is about the step rather than the
     uploader: the promise underneath it that this can be skipped. */
  .pl-skip { margin-top: 1rem; }

  /* ── Step 4 · the capacity gate ───────────────────────────────────────────
     Six panels, one shown. They are deliberately the same object at the same
     weight: the answer "we have a window" and the answer "we do not" are both
     the studio telling the truth about its own calendar, and dressing one as
     good news and the other as an apology would make the gate a sales device. */
  .pl-gate { margin-top: clamp(1.4rem, 3vw, 2rem); }
  .pl-gate-panel {
    border: 1px solid var(--line-strong);
    padding: clamp(1.2rem, 2.6vw, 1.8rem);
    background: var(--surface);
  }
  /* The one exception, and it is not emphasis: the queue panel is the tier that
     names no date, so it carries the system colour the rest of the site uses
     for statements of process. */
  .pl-gate-panel.is-queue { border-color: var(--signal); background: var(--paper-2); }
  .pl-gate-h { font-size: 1.15rem; line-height: 1.3; text-wrap: balance; }
  .pl-gate-claim { margin-top: .6rem; font-weight: 700; color: var(--signal-ink); font-size: .95rem; }
  .pl-gate-body { margin-top: .7rem; color: var(--ink-3); font-size: .95rem; line-height: 1.6; max-width: 64ch; }
  .pl-gate-foot { margin-top: 1rem; font-size: .85rem; color: var(--ink-3); }
  .pl-gate-panel .btn { margin-top: 1.2rem; }
  .pl-gate-checking {
    margin: 0;
    padding: 1.1rem 1.25rem;
    border: 1px dashed var(--line-strong);
    color: var(--ink-3);
  }
  .pl-gate-lost {
    border: 1px solid var(--warn);
    background: var(--paper-2);
    padding: clamp(1.2rem, 2.6vw, 1.8rem);
    margin-bottom: 1rem;
  }
  .pl-gate-lost .pl-gate-h { color: var(--warn-ink); }

  .pl-windows {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: .8rem;
    margin-top: 1.2rem;
  }
  .pl-windows :global(.pl-window) {
    display: flex;
    flex-direction: column;
    gap: .3rem;
    align-items: flex-start;
    padding: .95rem 1.1rem;
    border: 1px solid var(--line-strong);
    background: var(--surface);
    color: var(--ink);
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition: border-color var(--dur-1) var(--ease), background var(--dur-1) var(--ease);
  }
  .pl-windows :global(.pl-window:hover) { border-color: var(--accent-line); }
  .pl-windows :global(.pl-window.is-picked) { border-color: var(--accent); background: var(--accent-soft); box-shadow: inset 0 0 0 1px var(--accent); }
  .pl-windows :global(.pl-window-days) { font-family: var(--font-display); font-weight: 700; font-size: 1rem; }
  .pl-windows :global(.pl-window-sub) { font-size: .72rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--ink-3); }

  /* ── Step 5 · confirm ─────────────────────────────────────────────────────
     :empty is not defensive tidying. renderSummary() fills this on arrival; on
     the no-JS path it is never filled, and an empty <dl> would still draw its
     top rule under a heading with nothing beneath it. */
  /* minmax rather than a flat 9.5rem: the label track was sized on the English
     words and Dutch does not fit them. REFERENTIEMATERIAAL is 18 characters at
     .72rem/700 with .08em tracking and overruns the fixed track, so the label
     collided with its own value. max-content lets the track ask the longest
     label in whatever language is rendering, and the 9.5rem floor keeps
     English exactly where it is today rather than letting short labels pull the
     values leftward. dt's padding-right is the gutter and is inside
     max-content, so the two never touch. */
  .pl-summary {
    display: grid;
    grid-template-columns: minmax(9.5rem, max-content) 1fr;
    margin: clamp(1.4rem, 3vw, 2rem) 0 0;
    border-top: 1px solid var(--line-strong);
  }
  .pl-summary:empty { display: none; }
  .pl-summary :global(dt) {
    padding: .8rem 1rem .8rem 0;
    border-bottom: 1px solid var(--line);
    font-size: .72rem; font-weight: 700; letter-spacing: .08em;
    text-transform: uppercase; color: var(--ink-3);
  }
  .pl-summary :global(dd) {
    margin: 0;
    padding: .8rem 0;
    border-bottom: 1px solid var(--line);
    font-size: .95rem; color: var(--ink); line-height: 1.5;
  }

  .pl-error {
    margin-top: 1.2rem;
    padding: .95rem 1.15rem;
    border: 1px solid var(--warn);
    background: var(--paper-2);
    color: var(--warn-ink);
    font-size: .95rem;
    line-height: 1.55;
  }

  .pl-lost {
    margin-top: 1.2rem;
    padding: clamp(1.2rem, 2.6vw, 1.8rem);
    border: 1px solid var(--signal);
    background: var(--paper-2);
  }
  .pl-lost-h { font-size: 1.1rem; line-height: 1.3; color: var(--signal-ink); }
  .pl-lost-body { margin-top: .7rem; color: var(--ink-2); font-size: .95rem; line-height: 1.6; max-width: 64ch; }
  .pl-lost .btn { margin-top: 1.2rem; }

  .pl-after { margin-top: clamp(1.8rem, 3.5vw, 2.6rem); }
  /* Rules, not numerals. What happens after an order is a list of facts, and
     numbering them would imply the client has four things left to do. */
  .pl-after-list { list-style: none; margin: .9rem 0 0; padding: 0; border-top: 1px solid var(--line); }
  .pl-after-list li { padding: .85rem 0; border-bottom: 1px solid var(--line); color: var(--ink-2); font-size: .95rem; line-height: 1.6; }
  /* Under the button, at the size a legal line is read rather than skimmed:
     small, but not the 11px grey that says "we would rather you did not". */
  .pl-legal { margin-top: .9rem; font-size: .8rem; color: var(--ink-3); line-height: 1.6; max-width: 64ch; }
  .pl-legal a { color: var(--accent-bright); text-decoration: underline; text-underline-offset: 2px; }

  .pl-pay-note { margin-top: 1.1rem; font-size: .9rem; color: var(--ink-3); max-width: 64ch; line-height: 1.6; }

  /* The waiver. Bordered, because it is the one thing on this step that is a
     declaration rather than a description, and it has to be findable again in a
     screenshot. Not a warning colour: it is a normal part of ordering, and
     dressing it as an alert would make a routine sentence look like a catch. */
  .pl-consent {
    display: flex;
    align-items: flex-start;
    gap: .7rem;
    margin-top: 1.2rem;
    padding: .9rem 1.05rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--r-md);
    background: var(--surface);
    max-width: 64ch;
    cursor: pointer;
  }
  .pl-consent input { accent-color: var(--accent); width: 17px; height: 17px; flex: none; margin-top: .15rem; }
  .pl-consent span { font-size: .86rem; line-height: 1.6; color: var(--ink-2); }
  .pl-consent:focus-within { outline: 2px solid var(--focus-ring); outline-offset: 2px; }

  /* ── Navigation ───────────────────────────────────────────────────────────
     .pl-nav is the wizard's own control strip and does not exist without JS.
     The submit row is the opposite: it is the control that posts the form on
     every path through this page, so it is never hidden and never lives inside
     .pl-nav. Only the back button beside it is live-only. */
  .pl-nav {
    display: none;
    gap: .9rem;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    margin-top: clamp(1.8rem, 3.5vw, 2.6rem);
    padding-top: clamp(1.4rem, 2.5vw, 2rem);
    border-top: 1px solid var(--line-strong);
  }
  .pl-form.is-live .pl-nav { display: flex; }

  .pl-submit-row {
    display: flex;
    flex-wrap: wrap;
    gap: .9rem;
    align-items: center;
    justify-content: space-between;
    margin-top: clamp(1.8rem, 3.5vw, 2.6rem);
    padding-top: clamp(1.4rem, 2.5vw, 2rem);
    border-top: 1px solid var(--line-strong);
  }
  /* Routed through .pl-form so it outranks .btn's own display:inline-flex,
     which sits at the same specificity and would otherwise win on order. */
  .pl-form .pl-submit-row .pl-back-inline { display: none; }
  .pl-form.is-live .pl-submit-row .pl-back-inline { display: inline-flex; }
  /* Dim the row, not the form. pointer-events:none on the whole form would stop
     the client selecting the error text they are about to send us. */
  .pl-form.is-sending .pl-submit-row { opacity: .6; }

  /* ── Below the form ───────────────────────────────────────────────────────
     The capacity gate, stated before anyone commits. */
  .gate-note {
    margin-top: 1.6rem;
    padding: 1.05rem 1.25rem;
    border: 1px solid var(--signal);
    background: var(--paper-2);
    color: var(--signal-ink);
    font-size: .95rem;
    line-height: 1.55;
    max-width: 78ch;
  }
  .gate-note strong { color: var(--signal-ink); font-weight: 700; }

  .shared-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: clamp(1.5rem, 3vw, 3rem);
    margin-top: clamp(1.8rem, 3vw, 2.6rem);
  }
  .shared-item { border-top: 1px solid var(--line-strong); padding-top: 1.2rem; }
  .shared-item h3 { font-size: 1.1rem; }
  .shared-item p { margin-top: .55rem; font-size: .95rem; color: var(--ink-3); line-height: 1.6; }

  .start-foot {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: clamp(1.6rem, 4vw, 3.5rem);
    align-items: center;
    border-top: 1px solid var(--line-strong);
    padding-top: clamp(2rem, 4vw, 3rem);
  }
  .start-foot-body { margin-top: .9rem; color: var(--ink-3); max-width: 52ch; }
  .start-foot-cta { display: flex; flex-wrap: wrap; gap: .8rem; }
  /* The Dutch labels are longer than the English ones and wrap this row onto two
     lines, where two differently-sized pills stack into a ragged left-aligned
     column. Grow, never shrink — .btn is white-space: nowrap, so allowing shrink
     would push the label out of the button rather than wrap it. One row and both
     buttons grow to share it; two rows and each fills its own. Either way the
     edges line up. Same principle global.css:386–391 applies sitewide at ≤560px,
     applied here at the width where this particular row actually breaks. */
  .start-foot-cta > .btn { flex: 1 0 auto; }

  /* ── Breakpoints ─────────────────────────────────────────────────────────*/
  @media (max-width: 900px) {
    .levels { grid-template-columns: 1fr; }
    .level + .level { border-left: 0; border-top: 1px solid var(--line-strong); }
    /* One column, so there is no second fact list beside this one. Stacked,
       the rows are read in sequence rather than compared across a rule, so
       holding them to a two-line height would be pure whitespace with nothing
       to line up against. */
    .level-row { min-height: 0; }
    .start-foot { grid-template-columns: 1fr; }
  }

  /* The rail keeps all five numerals at every width — dropping steps would hide
     how long the form is, which is the one thing it exists to say. The labels
     go instead, and the current step keeps its own. */
  @media (max-width: 680px) {
    .pl-form.is-live .pl-rail { grid-template-columns: repeat(5, auto); }
    .pl-rail-item { padding: .7rem .8rem; }
    .pl-rail-item .pl-rail-t { display: none; }
    .pl-rail-item.is-current .pl-rail-t { display: block; }
  }

  /* .row-2's 620px collapse is in global.css with the rule it collapses. */

  @media (max-width: 560px) {
    .level-row { grid-template-columns: 1fr; gap: .25rem; }
    .pl-summary { grid-template-columns: 1fr; }
    .pl-summary :global(dt) { border-bottom: 0; padding: .8rem 0 0; }
    .pl-summary :global(dd) { padding-top: .25rem; }
  }

  /* ── Reduced motion ──────────────────────────────────────────────────────
     Everything here is decorative except one: the upload progress bar's width
     transition is the only signal a client has that a 20 MB photograph is
     moving, and removing it would leave a static bar and a silent wait. It is
     informational, not vestibular, so it stays. */
  @media (prefers-reduced-motion: reduce) {
    .level,
    .pl-rail-item { transition: none; }
    .pl-windows :global(.pl-window) { transition: none; }
    /* .input, .textarea, .select, .opt and .dropzone are opted out in
       global.css now, alongside the transitions they cancel — which is also
       how test-sample and contact stopped animating through the setting. */
  }

  /* ═══════════════════════════════════════════════════════════════════════════
     AUGUST 2026 — what the split and the audit added.
     ═══════════════════════════════════════════════════════════════════════════ */

  /* ── The service line ─────────────────────────────────────────────────────
     What was picked and a way back out of it. It replaces a three-column grid
     of seven photographs: the chooser at /start is where that comparison
     belongs, and a flow that reopens it is a flow that does not trust the click
     that got you here. */
  .pl-svc {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: .3rem .9rem;
    margin-top: .9rem;
    padding: .75rem 1rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--r-md);
    background: var(--surface);
  }
  .pl-svc-name { font-weight: 600; color: var(--ink); }
  .pl-svc-gets { font-size: .86rem; color: var(--ink-3); }
  .pl-svc-change {
    margin-left: auto;
    font-size: .82rem;
    color: var(--accent-bright);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* ── The error state ──────────────────────────────────────────────────────
     There was none. Pressing Continue with nothing chosen left the step
     visually identical — no [aria-invalid] on the page, no [aria-describedby],
     and reportValidity()'s native bubble gone in a blink and unavailable to a
     screen reader that has moved on. pipeline.js fills one of these per step
     with the offending field's own message and points the field's
     aria-describedby at it. */
  .pl-step-err {
    margin-top: 1.2rem;
    padding: .85rem 1.05rem;
    border: 1px solid var(--warn);
    border-radius: var(--r-md);
    background: var(--paper-2);
    color: var(--warn-ink);
    font-size: .92rem;
    line-height: 1.55;
  }
  /* The field itself, so the message and the control agree about which one is
     wrong. Colour is never the only signal — the message names the field. */
  .pl-form [aria-invalid='true'] { border-color: var(--warn); }

  /* ── The running total ────────────────────────────────────────────────────
     A LIVE REGION, which it was not. The figure moved when the count moved and
     nothing announced it, so a screen-reader user had no way to hear the number
     the whole proposition rests on. aria-live/aria-atomic sit on the wrapper so
     the label, the figure and the rate line are read as one sentence.

     STICKY ON MOBILE, below. The audit measured it 2,683px down a phone
     screen — past the fold by a factor of four at the moment it changes. */
  .pl-total-live { display: block; }
  .pl-total-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: .4rem 1rem;
  }
  .pl-total-label {
    display: block;
    font-size: .72rem; font-weight: 700; letter-spacing: .08em;
    text-transform: uppercase; color: var(--ink-3);
  }
  .pl-total-figure { display: flex; align-items: baseline; gap: .55rem; flex-wrap: wrap; }
  .pl-total-net {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.5rem, 3vw, 1.9rem);
    line-height: 1.1;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }
  /* BRIEF-14: no price is printed without saying which side of VAT it is on.
     Small, but never absent, and never further away than this. */
  .pl-total-excl { font-size: .76rem; color: var(--ink-3); }

  /* ── The levels table, folded ─────────────────────────────────────────────
     120 words copied verbatim from /pricing, in front of every visitor. The
     line that pipeline.js writes says which level THIS count earns, which is
     the only part that is about the order in hand; the table stays for whoever
     wants it, and /pricing is linked because it owns it. */
  /* The child combinator moved a level down when this became a Disclose:
     the component wraps its slot in .dc-body, so `> .levels` no longer
     matched and the table lost its spacing entirely. */
  .pl-levels-why :global(.levels) { margin-top: 1rem; }
  .pl-levels-why :global(.pl-panel-note) { margin-top: .8rem; }

  /* ── Mobile: the total follows you ────────────────────────────────────────
     Fixed rather than sticky, because the step it belongs to is taller than the
     scroll container it sits in and a sticky bottom edge would let it leave the
     screen halfway down. It exists only while step 1 is the step on screen —
     step 2 hides its own subtree, and no other step has a total. */
  @media (max-width: 780px) {
    .pl-form.is-live .pl-step.is-current .pl-total-bar {
      position: fixed;
