---
// VISUAILS — the background picker, step 1 of the catalog and complete flows.
//
// It was a block inside a 2,300-line page. It is a component because the split
// gave it a condition: a catalog set and a complete order have a ground the
// product sits on; a lifestyle carousel is a styled scene and does not. That
// used to be a runtime hide-AND-disable on one shared fieldset — hidden alone
// would still have posted a background nobody chose — and the honest version of
// that is simply not to render it. OrderFlow.astro leaves the choice to the
// page: catalog and complete slot this in, lifestyle slots in StylePicker.
//
// Everything a colour MEANS is in src/data/backgrounds.js — the values, the
// recommendation, the reason it is light, and every string here. This file lays
// them out and posts what was chosen.
//
// WHAT THIS POSTS. `background` is the id (white / light-grey / beige /
// custom), which is the studio's own vocabulary. `background_hex` is written by
// pipeline.js and is the RESOLVED value, so the studio never has to look one
// up. Neither is in TOP_FIELDS, so both land in details_json
// (functions/api/order.js). Without JS, `background` still carries the answer
// and `background_custom` still carries a typed hex; only the resolved field is
// empty, and /api/order drops empty values rather than storing a stale one.
import {
  RECOMMENDED as BACKGROUNDS, CUSTOM_ID, DEFAULT_ID, background,
  isLight, LIGHT_THRESHOLD, copy as bgCopy,
} from '../../data/backgrounds.js';

import Disclose from '../Disclose.astro';
import { ANGLES, ANGLE_GROUPS, EIGEN_ANGLE_PREFIX } from '../../data/angles.js';
import { beeldBgVeld, beeldHexVeld, BEELD_BG_EIGEN } from '../../data/beeldachtergrond.js';

interface Props { lang: 'en' | 'nl'; }
const { lang } = Astro.props;

/* ── EEN ANDERE ACHTERGROND PER BEELD — 15 oktober 2026 (werklijst 27) ──────
   De vier beelden van een catalogset, en elke hoek die bijbesteld kan worden
   (verborgen en uit tot hij is aangevinkt: pipeline.js, syncBeeldBg). Zie
   src/data/beeldachtergrond.js voor wat het dossier ermee doet. */
const PF = lang === 'nl' ? {
  h: 'Een foto een andere achtergrond geven (optioneel)',
  lede: 'Elk beeld krijgt de achtergrond hierboven. Wil je er één anders, bijvoorbeeld de foto op een model op beige? Kies het hier.',
  zoals: 'Zoals de rest',
  lock: 'De voorkant blijft wit: dat eist de marktplaats die je koos.',
  eigen: 'Eigen kleur…',
  kies: (n) => `Kies een eigen kleur voor ${n}`,
  hex: (n) => `Hexwaarde voor ${n}`,
  donker: 'Donkerder dan we zouden aanraden: de schaduw valt minder op. We maken het gewoon zo.',
  fout: 'Vul een hexwaarde in, zoals #E8F0EA — of kies de kleur met het kleurvak ernaast.',
  tip: 'Tip: je kunt ook één foto een andere achtergrond geven, hieronder of door op een beeld in “Wat je krijgt” te klikken. Helemaal optioneel.',
  begrepen: 'Begrepen', sluit: 'Tip sluiten',
} : {
  h: 'Give one photo a different background (optional)',
  lede: 'Every image gets the background above. Want one different, for example the on-model photo on beige? Choose it here.',
  zoals: 'Same as the rest',
  lock: 'The front stays white: the marketplace you chose requires it.',
  eigen: 'Your own colour…',
  kies: (n) => `Pick your own colour for ${n}`,
  hex: (n) => `Hex value for ${n}`,
  donker: 'Darker than we would recommend: the shadow shows less. We will make it this way anyway.',
  fout: 'Enter a hex value such as #E8F0EA — or pick the colour with the swatch next to it.',
  tip: 'Tip: you can also give one photo a different background, below or by clicking an image in “What you get”. Entirely optional.',
  begrepen: 'Got it', sluit: 'Close tip',
};
const BEELDEN = [
  { id: 'front', naam: lang === 'nl' ? 'Voorkant' : 'Front', schets: '/img/schets/catalog-voorkant.svg' },
  { id: 'back', naam: lang === 'nl' ? 'Achterkant' : 'Back', schets: '/img/schets/catalog-achterkant.svg' },
  { id: 'detail', naam: 'Detail', schets: '/img/schets/catalog-detail.svg' },
  { id: 'worn', naam: lang === 'nl' ? 'Op model' : 'On model', schets: '/img/schets/catalog-model.svg' },
  ...ANGLES.map((a) => ({ id: a.id, naam: a.name[lang], hoek: true, schets: `/img/schets/hoek-${a.id}.svg` })),
  ...ANGLE_GROUPS.map((g) => ({ id: `${EIGEN_ANGLE_PREFIX}${g}`, naam: lang === 'nl' ? 'Eigen hoek' : 'Your own angle', hoek: true, eigen: true, schets: `/img/schets/hoek-eigen-${g}.svg` })),
];

// The recommendation is "light", and the claim is checked rather than trusted:
// a value added to RECOMMENDED darker than LIGHT_THRESHOLD would make the
// picker recommend the thing its own warning warns about, so the build stops.
for (const b of BACKGROUNDS) {
  if (!isLight(b.hex)) {
    throw new Error(
      `BackgroundPicker.astro: background "${b.id}" (${b.hex}) is darker than LIGHT_THRESHOLD `
      + `(${LIGHT_THRESHOLD}), so it cannot sit under "what we recommend" — see src/data/backgrounds.js.`
    );
  }
}

const bgc = bgCopy(lang);
// The colour input needs a valid value to open on, and it is the default
// swatch's own hex rather than a colour typed here — backgrounds.js's header is
// explicit that the hex values are the contract and live only there.
const bgDefaultHex = background(DEFAULT_ID).hex;

// bgc.hint is the reason the picker exists and it is 40 words long. It was in
// front of everyone; it is now behind a summary, because the swatches answer
// the question for most people without it and the note under the selected one
// (written by pipeline.js from backgrounds.js) answers the rest.
const WHY = { en: 'Why this matters', nl: 'Waarom dit uitmaakt' };
const FIELD = {
  en: { pick: 'Pick a colour', hex: 'Hex value' },
  nl: { pick: 'Kies een kleur', hex: 'Hexwaarde' },
};
const fl = FIELD[lang];
---

{/* ── DE NAAM STOND ER TWEE KEER ───────────────────────────────────────────
    Hier stond een verborgen <legend> met dezelfde tekst als de <h3> eronder.
    Een schermlezer kondigt de groep aan met de legend en leest daarna de kop:
    "Achtergrond, groep — Achtergrond, kop niveau 3". Twee keer hetzelfde woord
    achter elkaar, in een formulier waar juist duidelijkheid telt.

    De zichtbare kop IS de naam, dus wordt de fieldset daaraan gehangen met
    aria-labelledby. Een <legend> is niet verplicht; een toegankelijke naam wel,
    en die is er nu precies één keer. */}
<fieldset class="pl-fieldset pl-bg" data-pl-bg aria-labelledby="pl-bg-h">
  <h3 class="pl-sub-h" id="pl-bg-h">{bgc.label}</h3>

  {/* Ronde 9, F20: met bol of Amazon aangevinkt staan de andere kleuren uit,
      maar de uitleg stond alleen bij "Waar ga je deze verkopen?" — dicht, en
      boven deze vouw. Hier staat waarom, op de plek waar je klikt. */}
  <p class="bg-lock" data-pl-bg-lock hidden>{lang === 'nl'
    ? 'Wit staat vast: je verkoopt op een marktplaats die een witte hoofdafbeelding eist. Wil je een andere kleur, haal die marktplaats dan weg bij “Waar ga je deze verkopen?”.'
    : 'White is fixed: you sell on a marketplace that requires a white main image. For another colour, untick that marketplace under “Where will you sell these?”.'}</p>

  <div class="bg-grid" role="radiogroup" aria-labelledby="pl-bg-h">
    {BACKGROUNDS.map((b) => (
      <label class="bg-opt">
        {/* Het product op de kleur, niet alleen de kleur — 3 september 2026. Hetzelfde
            catalogusbeeld, met een doorzichtige grond over de swatch: de grond wordt de
            kleur, het kledingstuk blijft zoals het is (sinds 12 oktober zonder multiply,
            zie de stijl). Eén klein bestand voor alle tegels. */}
        <span class="bg-swatch" style={`--swatch:${b.hex}`}><img class="bg-eg" src="/img/bg-staal-vrij.webp" alt="" width="420" height="420" loading="lazy" decoding="async" /></span>
        <span class="bg-row">
          <input type="radio" name="background" value={b.id} data-pl-bg-hex={b.hex} data-pl-bg-name={b.name[lang]} checked={b.id === DEFAULT_ID} />
          <span class="bg-name">{b.name[lang]}</span>
        </span>
        <span class="bg-hex">{b.hex}</span>
      </label>
    ))}
    {/* The fourth option. Its swatch is the live preview of whatever is in the
        two fields below — pipeline.js writes --swatch on it — so the customer
        sees their colour on the same row as the three we put forward, at the
        same size, and can compare them. */}
    <label class="bg-opt is-custom">
      <span class="bg-swatch is-empty" data-pl-bg-preview><img class="bg-eg" src="/img/bg-staal-vrij.webp" alt="" width="420" height="420" loading="lazy" decoding="async" /></span>
      <span class="bg-row">
        <input type="radio" name="background" value={CUSTOM_ID} data-pl-bg-custom data-pl-bg-name={bgc.customH} />
        <span class="bg-name">{bgc.customH}</span>
      </span>
      <span class="bg-hex" data-pl-bg-shown></span>
    </label>
  </div>

  {/* Written by pipeline.js for whichever option is selected — one line at a
      time, where four notes side by side would be four paragraphs. */}
  <p class="pl-bg-note" data-pl-bg-note></p>

  {/* Hidden and disabled by pipeline.js until the custom option is selected;
      visible without JS, where there is nothing to reveal it. The colour input
      carries NO name attribute on purpose — a type="color" control posts
      #000000 whether or not it was ever touched, and the text field beside it
      is the one that carries the answer. */}
  <div class="bg-custom" data-pl-bg-panel>
    <div class="bg-custom-fields">
      <div class="field bg-field-pick">
        <label for="pl-bg-color">{fl.pick}</label>
        <input type="color" id="pl-bg-color" class="bg-color" value={bgDefaultHex} data-pl-bg-color />
      </div>
      <div class="field bg-field-hex">
        <label for="pl-bg-hex">{fl.hex}</label>
        {/* pattern is the no-JS guard and the typo guard. Never `required` — an
            empty custom field is a customer who has not decided yet. */}
        <input
          class="input bg-hexinput"
          type="text"
          id="pl-bg-hex"
          name="background_custom"
          data-pl-bg-text
          placeholder="#RRGGBB"
          pattern="#?([0-9a-fA-F]{3}|[0-9a-fA-F]{6})"
          data-pl-err-msg={lang === 'nl' ? 'Vul een hexwaarde in, zoals #E8F0EA — of kies de kleur met het kleurvak ernaast.' : 'Enter a hex value such as #E8F0EA — or pick the colour with the swatch next to it.'}
          maxlength="7"
          autocomplete="off"
          autocapitalize="off"
          spellcheck="false"
        />
      </div>
    </div>
    {/* Information, never a refusal. isLight() decides when it appears;
        nothing anywhere rejects the colour. */}
    <p class="pl-note bg-warn" data-pl-bg-warn hidden>{bgc.warn}</p>
  </div>

  <Disclose summary={WHY[lang]} tone="plain">
    <p>{bgc.hint}</p>
    <p>{bgc.matchNote}</p>
  </Disclose>

  {/* Tip 1 (afvinklijst 28, v28-tips = a): één keer, na de eerste kleurkeuze;
      weg te klikken, Esc sluit hem, en wat je wegklikt komt niet terug
      (pipeline.js, toonTip). Een regel in de stroom: hij dekt nooit iets af. */}
  <p class="pl-tip" data-pl-tip="bgfoto" role="note" hidden>
    <span class="pl-tip-tekst">{PF.tip}</span>
    <button type="button" class="pl-tip-ok" data-pl-tip-weg>{PF.begrepen}</button>
    <button type="button" class="pl-tip-x" data-pl-tip-weg aria-label={PF.sluit}>×</button>
  </p>

  {/* Werklijst 27: per beeld een andere achtergrond. Zonder script staan de vier
      vaste beelden er gewoon (een <select> per beeld); de hoeken komen erbij
      zodra ze zijn aangevinkt. */}
  <details class="bg-perfoto" data-pl-bgfoto>
    <summary class="bg-perfoto-h">{PF.h}</summary>
    <p class="bg-perfoto-lede">{PF.lede}</p>
    <p class="bg-perfoto-lock" data-pl-bgfoto-lock hidden>{PF.lock}</p>
    {/* v29-hex = b (15 oktober 2026): naast de drie aanbevolen kleuren ook een
        eigen kleur per beeld. "Eigen kleur…" in de keuzelijst opent een kleurvak
        en een veld voor de hexcode, zoals bij de hele bestelling. Het kleurvak
        draagt geen name (het zou #000000 posten als niemand het aanraakt); het
        tekstveld draagt het antwoord. Geen <label> meer om het hele vak: er staan
        nu drie velden in, en een label hoort bij één. */}
    <div class="bg-perfoto-rij">
      {BEELDEN.map((b) => (
        <div class="bg-perfoto-veld" data-pl-bgfoto-beeld={b.id} data-pl-bgfoto-hoek={b.hoek ? '1' : undefined} hidden={b.hoek}>
          <span class="bg-perfoto-staal" data-pl-bgfoto-staal aria-hidden="true"><img src={b.schets} alt="" width="40" height="40" loading="lazy" decoding="async" /></span>
          <label class="bg-perfoto-naam" for={`pl-bgfoto-${b.id}`} data-pl-bgfoto-naam={b.eigen ? b.naam : undefined}>{b.naam}</label>
          <select class="select bg-perfoto-kies" id={`pl-bgfoto-${b.id}`} name={beeldBgVeld(b.id)} disabled={b.hoek} data-pl-bgfoto-select>
            <option value="">{PF.zoals}</option>
            {BACKGROUNDS.map((x) => <option value={x.hex}>{x.name[lang]}</option>)}
            <option value={BEELD_BG_EIGEN}>{PF.eigen}</option>
          </select>
          <span class="bg-perfoto-eigen" data-pl-bgfoto-eigen>
            <input type="color" class="bg-perfoto-kleur" value={bgDefaultHex} aria-label={PF.kies(b.naam)} data-pl-bgfoto-kleur />
            <input class="input bg-perfoto-hex" type="text" name={beeldHexVeld(b.id)} aria-label={PF.hex(b.naam)} placeholder="#RRGGBB" pattern="#?([0-9a-fA-F]{3}|[0-9a-fA-F]{6})" maxlength="7" autocomplete="off" autocapitalize="off" spellcheck="false" data-pl-err-msg={PF.fout} data-pl-bgfoto-hex />
          </span>
          <span class="bg-perfoto-donker" data-pl-bgfoto-donker hidden>{PF.donker}</span>
        </div>
      ))}
    </div>
  </details>

  {/* Written by pipeline.js. Empty without JS, where `background` and
      `background_custom` already carry the answer. */}
  <input type="hidden" name="background_hex" value="" data-pl-bg-value />
</fieldset>
<style>
  /* pipeline.js hides things by setting el.hidden, and the UA's own
     [hidden] rule loses to ANY author rule — .field is display:flex in
     global.css. Same guard the form's own sheet keeps. */
  [hidden] { display: none !important; }

  /* ── The background ───────────────────────────────────────────────────────
     Five swatches, one of them the customer's own. Capped at the measure like
     every other block on this step — it is a .pl-fieldset, and the full-bleed
     rule above is meant for the three-column comparison, not for a row of
     colour chips that would be 90px tall and 300px wide each at 1600px. */
  .pl-bg { margin-top: clamp(1.6rem, 3vw, 2.2rem); max-width: var(--pl-measure); }
  .pl-bg .pl-sub-h { margin-bottom: .35rem; }
  .pl-bg-hint { display: block; max-width: 66ch; }
  .pl-bg-cap {
    margin-top: 1rem;
    font-size: .72rem; font-weight: 700; letter-spacing: .08em;
    text-transform: uppercase; color: var(--ink-3);
  }
  .bg-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: .6rem; margin-top: .5rem; }
  .bg-opt {
    display: flex;
    flex-direction: column;
    gap: .45rem;
    padding: .55rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--r-md) 3px 3px 3px;
    background: var(--surface);
    cursor: pointer;
    transition: border-color var(--dur-1) var(--ease), background var(--dur-1) var(--ease);
  }
  .bg-opt:hover { border-color: var(--accent-line); }
  /* Ronde 9, F20: een uitgeschakelde kleur moet er ook zo uitzien. */
  .bg-opt:has(input:disabled) { opacity: .45; cursor: not-allowed; }
  .bg-opt:has(input:disabled):hover { border-color: var(--line-strong); }
  .bg-lock { margin: .2rem 0 .6rem; max-width: 66ch; font-size: .9rem; line-height: 1.5; color: var(--ink-2); }
  /* ── Per beeld een andere achtergrond (werklijst 27, 15 oktober 2026) ── */
  .bg-perfoto { margin-top: 1rem; border-top: 1px solid var(--line); padding-top: .8rem; }
  .bg-perfoto-h { cursor: pointer; font-size: .95rem; font-weight: 600; color: var(--ink); min-height: 32px; display: flex; align-items: center; }
  .bg-perfoto-lede { margin: .4rem 0 .7rem; max-width: 52ch; font-size: .9rem; line-height: 1.5; color: var(--ink-2); }
  .bg-perfoto-lock { margin: 0 0 .6rem; font-size: .875rem; color: var(--ink-2); }
  .bg-perfoto-rij { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 13rem), 1fr)); gap: .6rem; }
  .bg-perfoto-veld { display: grid; grid-template-columns: auto minmax(0, 1fr); grid-template-rows: auto auto; column-gap: .55rem; row-gap: .3rem; align-items: center; padding: .55rem .6rem; border: 1px solid var(--line); border-radius: var(--r-md) 3px 3px 3px; background: var(--surface); }
  /* De schets van het beeld op zijn kleur, zoals de tegels in "Wat je krijgt". */
  .bg-perfoto-staal { grid-row: 1; width: 44px; height: 44px; border-radius: 10px 3px 3px 3px; overflow: hidden; box-shadow: inset 0 0 0 1px var(--line-strong); background: var(--bgfoto, #FFFFFF); }
  .bg-perfoto-staal img { display: block; width: 100%; height: 100%; object-fit: contain; }
  .bg-perfoto-naam { font-size: .875rem; font-weight: 600; color: var(--ink); }
  .bg-perfoto-kies { grid-column: 1 / -1; width: 100%; }
  .bg-perfoto-veld.is-anders { border-color: var(--accent-line); }
  /* De eigen kleur: een kleurvak van 44 px (de maat van de schets erboven) en het
     veld met de code ernaast. Zonder script staan ze er gewoon; pipeline.js
     verbergt ze tot "Eigen kleur…" gekozen is. */
  .bg-perfoto-eigen { grid-column: 1 / -1; display: grid; grid-template-columns: 44px minmax(0, 1fr); gap: .45rem; align-items: center; }
  .bg-perfoto-kleur { width: 44px; height: 44px; padding: 0; border: 1px solid var(--line-strong); border-radius: 10px 3px 3px 3px; background: none; cursor: pointer; }
  .bg-perfoto-hex { width: 100%; min-width: 0; font-variant-numeric: tabular-nums; }
  .bg-perfoto-donker { grid-column: 1 / -1; font-size: .8rem; line-height: 1.45; color: var(--ink-2); }
  .bg-opt:has(input:checked) { border-color: var(--kies, var(--accent)); background: var(--accent-soft); box-shadow: inset 0 0 0 1px var(--kies, var(--accent)); }
  .bg-opt:focus-within { outline: 2px solid var(--focus-ring); outline-offset: 2px; }
  /* The swatch IS the value, so it gets the largest area on the tile and a
     hairline of its own — white on a white card is otherwise an empty box.
     --swatch is written by the markup for the four we recommend and by
     pipeline.js for the fifth. */
  /* ── DE KLEUR MOET DE TEGEL DRAGEN — 10 september 2026 ─────────────────
     Lucas: *"Fix ook de kleuren kies foto's die zijn nu niet goed zichtbaar."*
     Dat klopte, en er waren drie oorzaken tegelijk:

       1. HET SHIRT BEDEKTE DE KLEUR. Het catalogusbeeld stond op `object-fit:
          cover` over de volle 84px, dus van de achtergrondkleur — het enige
          waar deze tegel over gaat — bleef een randje over.
       2. DE VERSCHILLEN ZIJN KLEIN. #FFFFFF, #F7F5F1 en #EDE4D8 liggen dicht bij
          elkaar; op een strookje van een paar pixels zijn ze niet te scheiden.
       3. DE PAGINA ZELF IS #F5F5F5. Gebroken wit lag daar zó dichtbij dat de
          tegel eruitzag als een gat in het papier in plaats van als een staal.

     Wat er nu gebeurt: de tegel is een KLEURVLAK met het product er klein in.
     Het beeld staat op ongeveer twee derde van de breedte, onderaan uitgelijnd,
     zodat er aan drie kanten kleur omheen staat. Hoger dan eerst, want een groter
     vlak maakt een klein kleurverschil zichtbaar en een strook niet. En de
     haarlijn is donkerder, zodat wit tegen het papier alsnog een rand houdt. */
  /* ── HET BEELD MOET ZUIVER WIT ZIJN — 10 september 2026 ────────────────
     `multiply` werkt alleen als de grond van de foto #FFFFFF is: elke tint
     eronder VERMENIGVULDIGT met de swatch en maakt hem donkerder. Het beeld dat
     hier stond (catalog-after-w420) heeft een grond van (245,245,240), en dat
     tekende een zichtbare rechthoek in elk staal — een lap die vier procent
     donkerder was dan de kleur eromheen. Vandaar bg-staal.webp: hetzelfde beeld
     met alles boven de drempel op zuiver wit gezet. Het kledingstuk is donker en
     blijft ongemoeid. */
  /* ── EN NU ZONDER MULTIPLY — 12 oktober 2026 ─────────────────────────────
     Lucas, afvinklijst 9: *"wanneer je een custom kleur kiest verandert niet
     alleen de achtergrond van de foto met het tshirt maar ook het tshirt van
     kleur, terwijl het puur en alleen om de achtergrond gaat."* Klopt: multiply
     vermenigvuldigt ÉLK pixel met de swatch, dus ook het grijze shirt (45,45,45)
     werd bij een felle kleur donkerrood of donkerblauw. bg-staal-vrij.webp is
     hetzelfde beeld met een doorzichtige achtergrond (de witte grond die aan de
     rand van het beeld vastzit; het witte labeltje in de kraag blijft). Nu kleurt
     alleen wat achter het shirt ligt, en het shirt blijft het shirt. */
  .bg-swatch {
    display: grid;
    align-items: end;
    justify-items: center;
    height: 104px;
    padding: 0 12% 0;
    border-radius: var(--r-md) 3px 3px 3px;
    background: var(--swatch, var(--surface-2));
    box-shadow: inset 0 0 0 1px rgb(0 0 0 / .22);
    overflow: hidden;
  }
  .bg-eg {
    display: block;
    width: 100%; height: 84%;
    object-fit: contain; object-position: bottom;
  }
  .bg-swatch.is-empty .bg-eg { display: none; }
  /* Before a custom colour exists there is no value to show, and showing a
     grey would be showing a fifth recommendation. Levering 61 (afvinklijst 39,
     a-regen): no spectrum any more (the only rainbow on the site). An empty
     swatch with #RRGGBB in the fixed-width letter, like the hex under the
     swatches next to it: the language of a studio colour card. The placeholder
     is CSS content, so it is no hex and no part of backgrounds.js's contract. */
  .bg-swatch.is-empty {
    display: grid; place-items: center;
    background: #FFFFFF; box-shadow: inset 0 0 0 1px var(--h-lijn, #DDDDDD);
  }
  .bg-swatch.is-empty::before {
    content: "#RRGGBB"; font: 600 15px/1 var(--h-mono, 'IBM Plex Mono', ui-monospace, monospace);
    letter-spacing: .08em; color: var(--h-inkt-3, #616161); white-space: nowrap;
  }
  .bg-row { display: flex; align-items: center; gap: .45rem; }
