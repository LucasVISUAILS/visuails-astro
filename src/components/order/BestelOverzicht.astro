---
/*
 * VISUAILS — HET MEELOPENDE OVERZICHT
 * 12 september 2026
 * ═══════════════════════════════════════════════════════════════════════════
 *
 * Lucas: *"ook bij het bestelformulier is het gewoon super onduidelijk en niet
 * visueel genoeg wat mensen krijgen voor hun geld waardoor het erg duur lijkt
 * allemaal."*
 *
 * Uit vier voorgelegde vormrichtingen koos hij B: twee kolommen, links de
 * vragen, rechts een overzicht dat meeloopt. Dit is die rechterkolom.
 *
 * ── WAAROM DIT HET ANTWOORD IS OP "HET LIJKT DUUR" ──────────────────────────
 *
 * Een bedrag is nooit duur of goedkoop op zichzelf; het is duur tegenóver wat
 * je ervoor krijgt. Op dit formulier stond het bedrag in stap 1 en stond wat je
 * ervoor krijgt verspreid over stap 1 tot en met 5 — en de helft ervan stond er
 * als zin en niet als beeld. De klant zag dus een getal en moest zelf de rest
 * bij elkaar lezen. Dan wint het getal.
 *
 * Hier staan ze bij elkaar en blijven ze staan: vier beelden die tonen wat één
 * product oplevert, het aantal, het totaal aantal beelden, elke keuze zodra hij
 * gemaakt is, en pas daarna het bedrag. In die volgorde, want dat is de
 * volgorde waarin het bedrag betekenis krijgt.
 *
 * ── HET REKENT NIETS ZELF UIT, EN DAT IS EEN EIS ────────────────────────────
 *
 * Elk getal en elke regel hier komt uit een `data-pl-*`-haak die pipeline.js al
 * vulde voor de samenvatting op stap 5. Er staat geen enkele som in dit bestand.
 * Een tweede som zou een tweede waarheid zijn, en dan kan dit overzicht een
 * ander aantal tonen dan het totaal waar het onder staat — op precies het
 * scherm waar de klant besluit of hij het vertrouwt.
 *
 * Dat werkte niet meteen: setSummary() en setText() in pipeline.js schreven naar
 * de EERSTE treffer, en dat was tot vandaag altijd de samenvatting op stap 5.
 * Ze schrijven nu naar alle treffers. Zie de noot daar.
 *
 * ── EN HET STAAT ER ALLEEN ALS ER RUIMTE IS ─────────────────────────────────
 *
 * Onder 1100 pixels is er geen tweede kolom, en dan zou dit blok het formulier
 * verdubbelen in plaats van verhelderen: dezelfde antwoorden nog een keer, onder
 * de vragen waar ze net gegeven zijn. Daar staat het totaal al onderaan het
 * scherm vastgeplakt (.pl-total-bar), en dat is genoeg. Het blok blijft wel in
 * de HTML — `display: none` en geen conditie in de opmaak — zodat een
 * schermlezer op smal niets mist wat op breed wel wordt aangeboden... nee: het
 * gaat er met `hidden` uit, want de gegevens staan dan letterlijk twee keer in
 * de leesvolgorde. Zie de media query onderaan.
 */
import { beeldenVoor } from '../../data/pricing.js';
/* De strook staat sinds vandaag ook op de plaat van /start/plan; de lijst
   staat daarom in data/ en niet hier. Zie de kop van dat bestand. */
import { tegelsVoor, ECHTE_BESTELLING } from '../../data/overzichtbeelden.js';
/* De bijbestelde hoeken als tegel (15 oktober 2026, Lucas: *"Wanneer iemand een
   extra angle toevoegt komt deze hierbij te staan zodat de klant precies weet wat
   hij krijgt."*). Alleen bij catalog: daar staat de hoekenkiezer. pipeline.js
   (paintAngles) zet de tegel aan zodra de hoek is aangevinkt. */
import { ANGLES, ANGLE_GROUPS, EIGEN_ANGLE_PREFIX } from '../../data/angles.js';
import { ikoon } from '../../data/iconen.js';

interface Props {
  lang: 'en' | 'nl';
  /** De dienst zoals /api/order hem kent: catalog, lifestyle, complete, video, … */
  service: string;
  /** De proefvisual heeft één product en één beeld; daar is een overzicht ruis. */
  isSample?: boolean;
  /** ── DE WERKPLAATS — levering 59, 17 oktober 2026 (afvinklijst 36, b-werkplaats en b-kleur) ──
   *  "Rechts Wat je krijgt met het totaal en de knop, altijd in beeld." Met `wk` (de teksten
   *  uit OrderFlow.astro) krijgt elk catalogbeeld een vierkantje voor zijn achtergrond, staan
   *  "Een hoek erbij" en de vorm hier, en eindigt het blok met Verder en de inlogregel. */
  wk?: any;
  vormen?: Array<{ id: string; label: string }>;
  standaardVorm?: string;
  kleuren?: Array<{ id: string; hex: string; naam: string }>;
  inlogHref?: string;
}
const { lang, service, isSample = false, wk = null, vormen = [], standaardVorm = 'square', kleuren = [], inlogHref = '/account/login' } = Astro.props;
const catalog = service === 'catalog';
const nl = lang === 'nl';
const perProduct = beeldenVoor(service);

const tegels = tegelsVoor(service, lang);
const hoekTegels = service === 'catalog' ? [
  ...ANGLES.map((a) => ({ id: a.id, src: `/img/schets/hoek-${a.id}.svg`, label: a.name[lang] })),
  ...ANGLE_GROUPS.map((g) => ({ id: `${EIGEN_ANGLE_PREFIX}${g}`, src: `/img/schets/hoek-eigen-${g}.svg`, label: lang === 'nl' ? 'Eigen hoek' : 'Your own angle', eigen: true })),
] : [];

const c = nl ? {
  h: 'Wat je krijgt',
  perProduct: (n: number) => `${n} beelden per product`,
  aantal: 'Producten',
  beelden: 'Beelden in totaal',
  model: 'Gezicht',
  bg: 'Achtergrond',
  ratio: 'Formaat',
  leeg: '—',
  totaal: 'Totaal',
  excl: 'excl. btw',
  noot: ECHTE_BESTELLING.nl,
} : {
  h: 'What you get',
  perProduct: (n: number) => `${n} images per product`,
  aantal: 'Products',
  beelden: 'Images in total',
  model: 'Face',
  bg: 'Background',
  ratio: 'Aspect ratio',
  leeg: '—',
  totaal: 'Total',
  excl: 'excl. VAT',
  noot: ECHTE_BESTELLING.en,
};
---

{!isSample && wk && (
<aside class="bo wk-krijg" data-pl-overzicht aria-labelledby="bo-h">
  <h2 id="bo-h" class="bo-h wk-krijg-h">{wk.krijgKop}</h2>

  {tegels.length > 0 && (
    <div class="bo-set">
      <ul class="bo-tegels" role="list">
        {tegels.map((t) => (
          <li data-bo-beeld={t.id || undefined}>
            <span class="bo-tegel">
              <img src={t.src} width="120" height="120" alt={t.alt} loading="lazy" decoding="async" />
              {catalog && t.id && <button type="button" class="wk-kleur" data-wk-kleur={t.id} data-wk-hoek-naam={t.label} aria-haspopup="dialog" aria-expanded="false" aria-label={wk.kleurVoor(t.label, '#FFFFFF')}></button>}
            </span>
            <span class="bo-tegel-naam" aria-hidden="true">{t.label}</span>
          </li>
        ))}
        {hoekTegels.map((h) => (
          <li class="bo-tegel-extra" data-bo-hoek={h.id} hidden>
            <span class="bo-tegel">
              <img src={h.src} width="120" height="120" alt="" loading="lazy" decoding="async" /><span class="bo-plus" aria-hidden="true">+</span>
              <button type="button" class="wk-kleur" data-wk-kleur={h.id} data-wk-hoek-naam={h.label} aria-haspopup="dialog" aria-expanded="false" aria-label={wk.kleurVoor(h.label, '#FFFFFF')}></button>
            </span>
            <span class="bo-tegel-naam" data-bo-hoek-naam={h.eigen ? h.label : undefined}>{h.label}</span>
          </li>
        ))}
      </ul>
      {catalog && <p class="wk-kleur-noot"><b>{wk.hoekNoot[0]}</b> {wk.hoekNoot[1]}</p>}
      {perProduct && <p class="bo-set-noot" data-bo-per={c.perProduct(999).replace('999', '{n}')} hidden>{c.perProduct(perProduct)}</p>}
    </div>
  )}

  {catalog && (
    <button type="button" class="wk-erbij" data-wk-hoek-open aria-haspopup="dialog"><span class="wk-erbij-i" set:html={ikoon('plus')} />{wk.hoekErbij}<em data-wk-hoek-prijs>{wk.hoekVanaf}</em></button>
  )}

  {vormen.length > 0 && (
    <div class="wk-vormen" role="group" aria-label={wk.vorm} data-wk-vormen>
      {vormen.map((v) => (
        <button type="button" data-wk-vorm={v.id} aria-pressed={v.id === standaardVorm ? 'true' : 'false'}>{v.label}</button>
      ))}
    </div>
  )}

  {/* De regels. `data-pl-*` vult pipeline.js zoals altijd; `data-wk-*` zijn de regels van de
      werkplaats (wkOverzicht in pipeline.js). De tekst tussen de tags is wat er staat zolang
      er nog niets gekozen is. */}
  {/* De complete looks (levering 60, c-look): een regel per look, door pipeline.js
      (wkLooksPaint) gevuld zodra de klant in stap 2 stukken aan elkaar koppelt. */}
  {!catalog && <div class="wk-looks" data-wk-looks hidden></div>}
  <dl class="bo-regels wk-rijen">
    {!catalog && <div class="bo-regel"><dt>{wk.rLook}</dt><dd data-wk-sum-look>{wk.nogKiezen}</dd></div>}
    <div class="bo-regel"><dt>{wk.rProducten}</dt><dd><span data-wk-sum-producten>{c.leeg}</span><span data-pl-bo-aantal hidden>{c.leeg}</span></dd></div>
    {!catalog && <div class="bo-regel" data-wk-rij-looks hidden><dt>{wk.rLooks}</dt><dd data-wk-sum-looks></dd></div>}
    {perProduct && <div class="bo-regel"><dt>{wk.rBeelden}</dt><dd data-pl-bo-beelden>{c.leeg}</dd></div>}
    <div class="bo-regel"><dt>{wk.rGezicht}</dt><dd data-pl-sum-model>{wk.nogKiezen}</dd></div>
    <div class="bo-regel" data-wk-rij-voorrang><dt>{wk.rVoorrang}</dt><dd data-wk-sum-voorrang>{wk.nee}</dd></div>
  </dl>

  <div class="bo-geld" aria-live="polite" aria-atomic="true">
    <p class="bo-totaal">
      <span class="bo-totaal-l">{wk.totaal}</span>
      <b class="bo-totaal-b" data-pl-total>{c.leeg}</b>
      <small class="bo-totaal-s">{c.excl}</small>
    </p>
    <p class="bo-noot" data-pl-total-note></p>
  </div>

  {/* Verder, altijd in beeld. pipeline.js (paintWkVerder) zet de tekst per stap en
      verbergt hem op de laatste stap, waar Bestellen en betalen staat. */}
  <button type="button" class="wk-verder" data-pl-next data-wk-verder><span data-wk-verder-t>{wk.verder[0]}</span><span class="wk-verder-i" set:html={ikoon('pijl')} /></button>
  <p class="wk-inloggen" data-acct="out">{wk.inloggen[0]} <a href={inlogHref}>{wk.inloggen[1]}</a>{wk.inloggen[2]}</p>

  {catalog && (
    <div class="wk-paneel" data-wk-paneel hidden role="dialog" aria-labelledby="wk-paneel-h">
      <p class="wk-paneel-h" id="wk-paneel-h">{wk.paneelKop} · <span data-wk-paneel-hoek></span></p>
      {kleuren.map((k) => (
        <button type="button" class="wk-paneel-k" data-wk-c={k.hex} aria-pressed="false" style={`--c:${k.hex}`}><s></s>{k.naam}<em>{k.hex}</em></button>
      ))}
      <button type="button" class="wk-paneel-k wk-paneel-eigen-k" data-wk-c="eigen" aria-pressed="false"><s></s>{wk.eigenKleur}<em>#…</em></button>
      <div class="wk-paneel-eigen" data-wk-eigen hidden>
        <span aria-hidden="true">#</span>
        <input type="text" data-wk-eigen-hex maxlength="7" inputmode="text" autocomplete="off" spellcheck="false" aria-label={wk.eigenVeld} placeholder="E7E1F7" />
        <button type="button" data-wk-eigen-zet>{wk.eigenGebruik}</button>
      </div>
      <p class="wk-paneel-fout" data-wk-eigen-fout hidden>{wk.eigenFout}</p>
      <p class="wk-paneel-wit" data-wk-paneel-wit hidden>{wk.wit}</p>
      <p class="wk-paneel-amazon">{wk.amazon}</p>
    </div>
  )}
</aside>
)}

<style>
  /* ── HET BLOK ────────────────────────────────────────────────────────────
     Haarlijnen en geen kaart: dit is de taal van de rest van dit formulier.
     `position: sticky` zodat het meeloopt terwijl de stappen langsgaan — dat
     is het woord "meelopend" in richting B, en zonder dat is het gewoon een
     kolom die na twee schermen uit beeld is. */
  .bo {
    position: sticky;
    top: calc(var(--nav-h, 4rem) + 1rem);
    align-self: start;
    display: grid;
    gap: 1.1rem;
    padding: 1.2rem;
    border: 1px solid var(--line);
    background: var(--paper-2);
  }
  /* ── DIT BLOK STOND ONDER DE LEESGRENS — 17 september 2026 ───────────────
     Gemeten: de kop op 11,2 px en elk label op 10,6 px, allemaal in kapitalen,
     mono en lichtgrijs — de zwaarste combinatie om te lezen die er is. En dit
     is nou juist het blok waarin iemand NAKIJKT wat hij koopt voordat hij
     betaalt: aantal producten, aantal beelden, gezicht, achtergrond, totaal.
     De ondergrens van dit project is 11,5 px; labels staan nu op .72rem en de
     kop op .74rem. De verhouding met het antwoord ernaast (.88rem) en met het
     bedrag (1.5rem) blijft dezelfde, dus de rangorde verandert niet. */
  .bo-h {
    margin: 0;
    font-family: var(--font-mono);
    font-size: .74rem; font-weight: 400; letter-spacing: .06em; text-transform: uppercase;
    color: var(--ink-3);
  }

  /* ── DE BEELDEN ──────────────────────────────────────────────────────────
     Vierkant, want dat is wat er geleverd wordt, en klein genoeg om samen één
     ding te zijn in plaats van vier plaatjes.

     `grid-auto-flow: column` en niet `repeat(4, …)`: lifestyle heeft er drie en
     catalog vier. Met een vast viertal hield lifestyle een lege vierde kolom
     over, en de drie beelden stonden dus smaller dan de strook waar ze in
     zaten — een gat aan de rechterkant dat er als een ontbrekend beeld uitzag. */
  /* Vier per rij: een bijbestelde hoek komt op een tweede rij (15 oktober 2026). */
  .bo-tegels {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 8px 4px;
  }
  .bo-tegel { position: relative; }
  .bo-plus { position: absolute; top: 4px; right: 4px; width: 18px; height: 18px; border-radius: 50%; display: grid; place-items: center; background: var(--h-inkt, #0B0F17); color: #fff; font: 600 13px/1 var(--h-letter, sans-serif); }
  /* Schetsen sinds 15 oktober 2026 (overzichtbeelden.js): een licht vlak met de
     tekening erin en de naam van het beeld eronder, in de maat van de noten. */
  .bo-tegels li { display: grid; gap: .35rem; min-width: 0; }
  .bo-tegel { display: block; aspect-ratio: 1; overflow: hidden; border-radius: var(--r-klein); background: var(--bo-bg, var(--h-nevel, #F4F5F7)); }
  /* Werklijst 27 (15 oktober 2026): bij catalog draagt elke tegel de achtergrond
     van dat beeld (pipeline.js zet --bo-bg), met een haarlijn zodat wit op de
     witte kaart een vak blijft, en een tegel is te kiezen: dan opent "Een foto
     een andere achtergrond geven" in stap 1 op dat beeld. */
  .bo-tegel.is-kiesbaar { cursor: pointer; box-shadow: inset 0 0 0 1px var(--h-lijn, #E6E8EC); }
  .bo-tegel.is-kiesbaar:hover { box-shadow: inset 0 0 0 1px var(--h-inkt, #0B0F17); }
  .bo-tegel.is-kiesbaar:focus-visible { outline: 2px solid var(--h-inkt, #0B0F17); outline-offset: 2px; }
  .bo-tegel.is-anders { box-shadow: inset 0 0 0 2px var(--kies, #0B0F17); } /* een gekozen andere achtergrond: wat je kiest, violet (schema A) */
  .bo-tegels img { width: 100%; height: 100%; object-fit: contain; display: block; }
  .bo-tegel-naam { font-size: .75rem; line-height: 1.25; color: var(--ink-2); text-align: center; overflow-wrap: anywhere; }
  .bo-set-noot { margin: .55rem 0 0; font-size: .8rem; line-height: 1.45; color: var(--ink-2); }
  .bo-set-klein { color: var(--ink-3); font-size: .74rem; }

  /* ── DE REGELS ───────────────────────────────────────────────────────────
     Eén haarlijn per regel, label links en antwoord rechts. Zelfde vorm als
     het contactblad elders op de site. */
  .bo-regels { margin: 0; display: grid; gap: 0; border-top: 1px solid var(--line); }
  .bo-regel {
    display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: .8rem;
    align-items: baseline; padding: .5rem 0; border-bottom: 1px solid var(--line);
  }
  .bo-regel dt {
    font-family: var(--font-mono);
    font-size: .72rem; letter-spacing: .04em; text-transform: uppercase; color: var(--ink-3);
  }
  .bo-regel dd {
    margin: 0; text-align: end; font-size: .88rem; line-height: 1.4; color: var(--ink);
    /* Een lang antwoord (een achtergrond met een eigen naam) mag afbreken in
       plaats van de kolom uit elkaar te duwen. */
    overflow-wrap: anywhere;
  }

  .bo-totaal {
    margin: 0;
    display: flex; align-items: baseline; flex-wrap: wrap; gap: .1rem .6rem;
  }
  .bo-totaal-l {
    font-family: var(--font-mono);
    font-size: .72rem; letter-spacing: .04em; text-transform: uppercase; color: var(--ink-3);
    flex: 1 1 auto;
  }
  .bo-totaal-b {
    font-family: var(--font-display, var(--font-heading));
    font-size: 1.5rem; font-weight: 500; letter-spacing: -.02em; color: var(--ink);
    font-variant-numeric: tabular-nums lining-nums;
  }
  .bo-totaal-s { flex: 0 0 100%; text-align: end; font-size: .72rem; color: var(--ink-3); }
  .bo-geld { display: grid; gap: .5rem; }
  .bo-noot { margin: 0; font-size: .78rem; line-height: 1.5; color: var(--ink-3); }

  /* ── EN ONDER 1100 PIXELS STAAT HET ER NIET ──────────────────────────────
     Daar is geen tweede kolom, en dan komt dit blok ONDER de vragen te staan —
     dezelfde antwoorden nog een keer, vlak nadat ze gegeven zijn. Dat is geen
     overzicht meer maar herhaling, ook voor een schermlezer, die alles dan
     twee keer in de leesvolgorde tegenkomt.

     Het totaal is daar niet weg: .pl-total-bar plakt op smal onderaan het
     scherm zolang stap 1 in beeld is. Zie de noot daarbij in OrderFlow.astro. */
  /* In de werkplaats staat het blok ook op smal: onder de keuzes (werkplaats.css). */
</style>
