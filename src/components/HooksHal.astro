    ],
    prijsH: 'Wat het kost',
    prijsVanaf: `<strong>Vanaf ${vanaf} per hook</strong>, ${vatLabel('excl', 'nl')}. Eén hook is één korte clip. Met een abonnement kost een hook ${SERVICE_CREDITS.hooks} credits.`,
    prijsVariant: `<strong>Vanaf ${variant} voor een extra variant</strong> op hetzelfde product: hetzelfde format, een andere invulling.`,
    prijsNietH: 'Waarom de prijs niet per aantal zakt',
    prijsNiet: 'Elke hook is een eigen opzet, dus het bedrag is een ondergrens en zakt niet als je er meer bestelt.',
    prijsCta: 'Praat met ons over Hooks',
    formatH: 'Hoe een hook eruitziet.',
    formatSub: 'Hier staat niets nagemaakt van andermans werk. Dit zijn de plekken waar onze eigen eerste hooks komen te staan.',
    tierNote: `De twee kolommen hieronder beschrijven de prijs per aantal voor catalog- en lifestyleproducten. Een hook staat niet op die ladder en telt er niet in mee, dus met hooks bereik je geen van beide kolommen — ze staan hier omdat de meeste merken die naar een hook vragen ook foto’s bestellen.`,
    faqs: serviceFaqs('hooks', 'nl'),
    ctaH: 'Stuur de foto’s <br>die je al hebt.',
    ctaP: `Vanaf ${vanaf} per hook, ${vatLabel('excl', 'nl')}.`,
    beloofte: 'Wij beloven geen views, likes of volgers. Wij beloven het format, de uitvoering en de controle vóór levering. Of een post ergens terechtkomt, hangt af van het platform en van timing, en die twee zijn niet aan ons om te beloven.',
  },
};
const c = COPY[lang];

/* ── DE HAL ────────────────────────────────────────────────────────────── */
/* Een kop met een <br> wordt de kop in twee tonen: eerst het lichte deel. */
const tonen = (h: string) => h.split(/<br\s*\/?>/).map((d) => d.replace(/<[^>]+>/g, '').trim());
const pil = (s: string) => s.replace(/^\(\s*|\s*\)$/g, '');
const ICOON = {
  rechts: '<path d="M2.5 8h11M9 3.5L13.5 8 9 12.5"/>',
  pijl: '<path d="M4.5 11.5l7-7M5.5 4.5h6v6"/>',
  check: '<path d="M3 8.5l3.2 3L13 4.5"/>',
  klok: '<circle cx="8" cy="8" r="5.5"/><path d="M8 5v3.2l2 1.3"/>',
};
const ik = (n: keyof typeof ICOON) => `<svg viewBox="0 0 16 16" aria-hidden="true">${ICOON[n]}</svg>`;
const H = nl ? {
  krijg: ['Wat er in je map', 'komt te staan.'], clean: ['Waar je op', 'kunt rekenen.'],
  krijgPil: 'Wat je krijgt', prijsPil: 'Wat het kost', slotPil: 'Hooks', hoe: 'Hoe een hook loopt',
} : {
  krijg: ['What lands', 'in your folder.'], clean: ['What you', 'can count on.'],
  krijgPil: 'What you get', prijsPil: 'What it costs', slotPil: 'Hooks', hoe: 'How a hook runs',
};
const feiten = [...c.trust, (nl ? ['In de offerte', 'levertijd'] : ['In the quote', 'delivery time'])];
/* Het beeld in de opening: afvinklijst 20 (v20-opening a), live sinds afvinklijst 21. Zolang het eigen
   beeld er niet is, staat er de getalkaart; staat het er, dan wint het eigen beeld (v21-beelden a). */
const kaartBeeld = !kopBeeld;
const BEELD = {
  soort: 'getal' as const,
  label: 'Hook · 9:16',
  voor: lang === 'nl' ? 'vanaf' : 'from', getal: euro(AMOUNT.hooks, lang), eenheid: 'per hook',
  voet: lang === 'nl' ? `${vatLabel('excl', 'nl')}. Op aanvraag: je krijgt eerst schriftelijk een prijs.` : `${vatLabel('excl', 'en')}. On request: you get a written price first.`,
};
---
<div class="h-pagina h-hk">

  {/* ── 1 · DE KOP ─────────────────────────────────────────────────────────── */}
  <header class:list={['h-paginakop', 'h-hk-kop', kopBeeld && 'met-beeld', kaartBeeld && 'met-kopbeeld']}>
    <div class="h-hk-kop-tekst">
      <p class="h-pil h-op" style="--d:0"><span>{pil(c.eyebrow)}</span></p>
      <h1 class="h-kop h-h1 h-op" style="--d:1"><span class="l">{tonen(c.h1)[0]}</span> <span>{tonen(c.h1)[1]}</span></h1>
      <p class="h-lede h-op" style="--d:2">{c.lead}</p>
      <p class="h-acties h-op" style="--d:3">
        <a class="h-knop h-knop-inkt" href={lp('/contact')}>{c.ctaPrimary}<span class="o" set:html={ik('rechts')} /></a>
        <a class="h-knop h-knop-lijn" href={lp('/pricing')}>{c.ctaPrices}</a>
      </p>
      <ul class="h-feiten h-vd-feiten h-op" style="--d:4" role="list">
        {feiten.map(([sterk, rest]) => <li><i set:html={ik('check')} /><span><b>{sterk}</b> {rest}</span></li>)}
      </ul>
      <div class="h-vd-wacht h-op" style="--d:5">
        <p><span class="h-chip h-pl-tag">{c.soonTag}</span> {c.queueKort}</p>
        <Disclose summary={H.hoe} tone="plain"><p>{c.queueNote}</p></Disclose>
      </div>
    </div>
    {kaartBeeld && <KopBeeld {...BEELD} />}
    {kopBeeld && (
      <figure class="h-hk-kop-beeld h-op" style={`--d:2; aspect-ratio: ${r('hero')}`}>
        <img src={kopBeeld.src} alt={p('hero', 'subject')} width={kopBeeld.w} height={kopBeeld.h} decoding="async" fetchpriority="high" />
      </figure>
    )}
  </header>

  {/* ── 2 · WAT ERIN ZIT ─────────────────────────────────────────────────── */}
  <section class="h-sec h-hk-krijg-sec" aria-labelledby="hk-krijg">
    <header class="h-sec-kop h-in">
      <div>
        <p class="h-pil"><span>{H.krijgPil}</span></p>
        <h2 id="hk-krijg" class="h-kop h-h2"><span class="l">{H.krijg[0]}</span> {H.krijg[1]}</h2>
      </div>
      <p class="h-vs-kopzin">{c.whatP[0]}</p>
    </header>
    <ul class="h-vs-kaarten" role="list">
      {c.krijg.map(([titel, regel], i) => <li class="h-in" style={`--d:${i}`}><b>{titel}</b><span>{regel}</span></li>)}
    </ul>
    <p class="h-hk-voet h-in">{c.krijgFoot}</p>
    <p class="h-ls-waar h-in"><span>{c.formatsH.replace(/\.$/, '')}</span> <span class="h-chip h-chip-nevel"><b>{c.formatNuNaam}</b>&nbsp;· {c.formatNu.toLowerCase()}</span>{komendeStijlen('hooks', lang).map((k) => <span class="h-chip h-chip-wit h-hk-straks">{k.naam} · {c.formatStraks.toLowerCase()}</span>)}</p>
  </section>

  {/* ── 3 · WAAR JE OP KUNT REKENEN, EN WAT HET KOST ─────────────────────── */}
  <section class="h-sec h-vd-koop-sec" aria-labelledby="hk-schoon">
    <header class="h-sec-kop h-in">
      <div>
        <p class="h-pil"><span>{H.prijsPil}</span></p>
        <h2 id="hk-schoon" class="h-kop h-h2"><span class="l">{H.clean[0]}</span> {H.clean[1]}</h2>
      </div>
    </header>
    <div class="h-vd-twee">
      <div class="h-vd-krijg h-in">
        <ul class="h-bm-vink" role="list">
          {c.clean.map((li) => <li><i set:html={ik('check')} /><span>{li}</span></li>)}
        </ul>
      </div>
      <div class="h-vd-kopen h-in" style="--d:1">
        <h3 class="h-kop h-h3">{c.prijsH}</h3>
        <p set:html={c.prijsVanaf} />
        <p set:html={c.prijsVariant} />
        <p class="h-vd-vast"><b>{c.prijsNietH}</b> {c.prijsNiet}</p>
        <p class="h-acties">
          <a class="h-knop h-knop-inkt" href={lp('/contact')}>{c.prijsCta}<span class="o" set:html={ik('rechts')} /></a>
        </p>
      </div>
    </div>
  </section>

  {/* ── 4 · VRAGEN ─────────────────────────────────────────────────────────── */}
  <HalVragen lang={lang} id="hk-faq" dienst="hooks" faqs={c.faqs} />

  {/* ── 5 · HET SLOT ───────────────────────────────────────────────────────── */}
  <section class="h-sec h-lk-slot-sec" aria-labelledby="hk-slot">
    <div class="h-lk-slot h-in">
      <span class="h-korrel" aria-hidden="true"></span>
      <p class="h-pil h-pil-wit"><span>{H.slotPil}</span></p>
      <h2 id="hk-slot" class="h-kop h-h2"><span class="l">{tonen(c.ctaH)[0]}</span> {tonen(c.ctaH)[1]}</h2>
      <p class="h-vd-slot-zin">{c.ctaP}</p>
      <p class="h-acties">
        <a class="h-knop h-knop-inkt" href={lp('/contact')}>{c.ctaPrimary}<span class="o" set:html={ik('rechts')} /></a>
        <a class="h-knop h-knop-lijn" href={lp('/pricing')}>{c.ctaPrices}</a>
      </p>
      <p class="h-vd-belofte">{c.beloofte}</p>
    </div>
  </section>
</div>
<HalBeweging />
