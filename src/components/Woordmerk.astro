---
/* VISUAILS — het woordmerk (de merkletter), als één vast onderdeel.
   ═══════════════════════════════════════════════════════════════════════════

   12 oktober 2026. Het V-merk is de eerste letter van dit woord, dus dit is de
   ENIGE plek waar het merk naast letters staat — en dan als één vorm, uit één
   symbool (#woordmerk in Layout.astro, het pad uit src/data/woordmerk.js).
   scripts/brand-lockup-guard.mjs telt #woordmerk als woordmerk: het losse
   V-teken mag er dus nog steeds niet naast staan.

   DE <svg> STAAT HIER, EN DE MAAT BIJ DE AANROEPER via `klasse` + hal.css
   (globaal, onder body.hal). Niet in een scoped <style> hier: een class die de
   ouder meegeeft, krijgt geen scope-attribuut van dit onderdeel — zie de noot
   bovenaan BrandMark.astro voor waar dat eerder misging.

   glitch  twee echolagen (violet en lila) die bij het laden één keer en onder de
           muis kort in banden zijwaarts schieten. Lucas (afvinklijst 5, bij
           d-diensten): *"een soortgelijke animatie was bijvoorbeeld op het logo
           links bovenaan de website met een soort glitch effect om de website
           simpelweg meer gevoel te geven."* De beweging staat in hal.css; bij
           "minder beweging" staan de lagen uit.
   verloop het woordmerk groot onderaan de footer, in een zacht verloop dat van
           lila naar de kleur van de kaart loopt (plan §08, sectie 07).
   electro dezelfde elektrische lijn als het V-merk in de balk (VMerk electro),
           op alle logo's van de site (levering 54; Lucas, afvinklijst 34: *"Ik wil
           dit effect op alle logo's die zichtbaar zijn op elke pagina, dus top bar
           en footer logo's."*). De lijn gebruikt #woordmerk-lijn: dezelfde omtrek,
           maar per deel een eigen pad, zodat elke letter intekent. */
import { WOORDMERK } from '../data/woordmerk.js';

interface Props { klasse?: string; glitch?: boolean; verloop?: boolean; electro?: boolean }
const { klasse = '', glitch = false, verloop = false, electro = false } = Astro.props as Props;
const B = WOORDMERK.breed, H = WOORDMERK.hoog;
---
<svg class:list={['wm', klasse, glitch && 'wm-glitch', electro && 'mk']} viewBox={`0 0 ${B} ${H}`} aria-hidden="true" focusable="false">
  {verloop && (
    <defs>
      <linearGradient id="hal-wm-verloop" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#C7C7C7" />
        <stop offset=".9" stop-color="#F2F2F2" />
      </linearGradient>
    </defs>
  )}
  {glitch && <use class="wm-echo wm-echo-1" href="#woordmerk" width={B} height={H} />}
  {glitch && <use class="wm-echo wm-echo-2" href="#woordmerk" width={B} height={H} />}
  {electro && <use class="mk-line mk-line-a" href="#woordmerk-lijn" width={B} height={H} />}
  <use class:list={['wm-vorm', electro && 'mk-fill']} href="#woordmerk" width={B} height={H} fill={verloop ? 'url(#hal-wm-verloop)' : undefined} />
</svg>
