---
import { waHref } from '../data/whatsapp.js';
/*
 * VISUAILS — /hooks en /nl/hooks delen dit lichaam.
 *
 * ════════════════════════════════════════════════════════════════════════════
 * DEZE PAGINA HEEFT AL EEN KEER BESTAAN, EN IS TOEN VERWIJDERD
 * ════════════════════════════════════════════════════════════════════════════
 *
 * Er stond een `HooksPage.astro` op de schijf. Die is op 18 augustus 2026
 * weggegaan omdat de tekst de toonregels op acht punten overtrad — hij beloofde
 * bereik, hij noemde een doorlooptijd als getal, en hij verkocht iets wat nog
 * niet te bestellen was alsof het dat wel was. De gecorrigeerde tekst is toen
 * naar `src/data/binnenkort.js` gegaan en wordt sindsdien op /plans#binnenkort
 * getoond. Zie HOOKS-COPY-CONCEPT.md voor de volledige lijst.
 *
 * Lucas, 2 september 2026: *"Ik wil dat je de hooks pagina gaat maken, uiterlijk
 * consistent met de andere services en plaats bij elke foto op de pagina een
 * placeholder voor nu."*
 *
 * Wat daarmee terugkomt is de PAGINA, niet de oude tekst. Elke regel hieronder
 * is opnieuw geschreven tegen dezelfde drie regels die de vorige versie brak:
 *
 *   1 · GEEN DOORLOOPTIJD ALS GETAL. Het concept schreef "24 tot 48 uur" — vier
 *       keer. Dat is een belofte die het systeem niet kan waarmaken en die
 *       tests/promises.test.mjs sitebreed verbiedt. Wat er staat komt uit
 *       `turnaround('unattended')`, net als op elke andere dienstpagina.
 *   2 · GEEN BEREIK BELOVEN. Waar een woord als "volgers" of "betrokkenheid"
 *       valt, staat er een woord als "kans" naast — en de pagina zegt zelf,
 *       tweemaal, dat het format en de uitvoering zijn wat we verkopen.
 *   3 · GEEN BESTELKNOP. Hooks is nog niet bestelbaar en dat blijft zo tot
 *       `KIND_IMAGES.hooks` een gewicht heeft; zonder gewicht kan de agenda
 *       geen venster geven. Zie de noot daar. De knoppen gaan dus naar een
 *       gesprek, en het label zegt dat ook.
 *
 * ── EN DE PRIJS STAAT ER WÉL ──────────────────────────────────────────────
 *
 * Lucas heeft op 2 september het bedrag uit het concept bevestigd: vanaf € 119
 * per product, en vanaf € 49 voor een extra variant. Die twee staan sindsdien
 * in `AMOUNT.hooks` en `AMOUNT.hooksVariant` — niet in deze pagina, want een
 * bedrag dat in copy staat verandert op één plek en blijft op vier andere.
 *
 * ÉÉN CLAIM UIT HET CONCEPT IS NIET OVERGENOMEN. Daar stond: *"Meerdere
 * producten in één keer brengt het tarief per product omlaag, op dezelfde schaal
 * als de rest van de prijslijst."* Dat is niet waar: `isLadderService()` laat
 * hooks er niet in, precies zoals bij video, en er is geen ladder om op te
 * zakken. De pagina zegt nu wat er wél gebeurt — wat het bedrag beweegt is het
 * werk, niet het aantal.
 *
 * ── ELKE FOTO IS EEN PLACEHOLDER ──────────────────────────────────────────
 *
 * Er bestaat nog geen enkele hookvideo, dus er is niets te tonen. Een bestaande
 * productfoto lenen zou hier het ergst mogelijke zijn: dit is de pagina die
 * moet laten zien wat een format DOET, en een stilstaand beeld dat als voorbeeld
 * gepresenteerd wordt, bewijst het tegenovergestelde. Elke beeldplek is dus een
 * <Placeholder> met de opdracht erbij — `npm run placeholders` telt ze.
 *
 * ── DE VOLGORDE VAN DE BANDEN IS NIET VRIJ ────────────────────────────────
 *
 * Lucas, 31 augustus 2026: *"Zorg dat elke pagina goed op elkaar aansluit."*
 * /catalog, /lifestyle en /video vertellen het verhaal in dezelfde volgorde, en
 * deze pagina volgt hem regel voor regel: hero → wat je krijgt → wat het is en
 * waar het staat → de stappen → checklist met het prijsblok ernaast → een band
 * met het format → de tierregel → de vragen → de slotband. Dezelfde gedeelde
 * componenten ook: ServiceSwitch, HeroFacts, TierCompare, Disclose.
 */
import {
  AMOUNT, euro, vatLabel, reviewClaim, turnaround, clause,
} from '../data/pricing.js';
/* De vragen staan in faq.js en niet hier — schema.js bouwt zijn FAQPage-knoop
   uit het pad en kan de frontmatter van een component niet lezen. Zie de kop
   boven serviceFaqs(). */
import { serviceFaqs } from '../data/faq.js';
import { doorCta, doorHref } from '../data/orderDoors.js';
import { localizedPath } from '../i18n/ui.js';
import Disclose from './Disclose.astro';
import TierCompare from './TierCompare.astro';
import ServiceSwitch from './ServiceSwitch.astro';
import HeroFacts from './HeroFacts.astro';
import Placeholder from './Placeholder.astro';

interface Props { lang: 'en' | 'nl'; }
const { lang } = Astro.props;
const nl = lang === 'nl';
const lp = (p: string) => localizedPath(lang, p);

/* Eén keer geformatteerd, zodat het bedrag en zijn btw-label niet door een
   bewerking van elkaar gescheiden kunnen raken. */
const vanaf = euro(AMOUNT.hooks, lang);
const variant = euro(AMOUNT.hooksVariant, lang);

/* ── DE KNOP ONDER DE TIERBAND WIJST NAAR CATALOG EN NIET NAAR /start ──────
 *
 * TierCompare valt zonder `href0` terug op de keuzepagina met het generieke
 * label "Start an order". Op elke andere dienstpagina geeft de pagina daar zijn
 * EIGEN bestelroute mee, precies zodat die knop zegt wat erachter gebeurt —
 * tests/nav.test.mjs bewaakt dat sitebreed.
 *
 * Hooks heeft geen eigen bestelroute, en de verleiding is dan om de standaard te
 * laten staan. Dat zou hier de ergste variant zijn: een grote primaire knop op
 * een pagina die twee alinea's hoger zegt dat je dit nog niet kunt bestellen.
 *
 * De twee kolommen gaan over catalog en lifestyle — dat staat in c.tierNote — dus
 * wijst de knop daarheen, met het label dat catalog zelf ook draagt. Uit
 * orderDoors.js en niet ingetypt, zodat er geen tweede formulering ontstaat. */
const catalogHref = doorHref('catalog');
const catalogCta = doorCta('catalog', lang);

/* ── DE BEELDPLEKKEN, MET HUN OPDRACHT ────────────────────────────────────
 *
 * Ze staan hier bij elkaar en niet verspreid door de markup, om dezelfde reden
 * als elke andere lijst in dit project: `npm run placeholders` leest de
 * attributen uit de gebouwde html, maar een MENS die wil weten wat er nog
 * geschoten moet worden, leest de bron. Eén blok is dan een lijstje; tien
 * plekken door de pagina heen is zoeken.
 *
 * `ratio` is de verhouding die het echte bestand krijgt, en die is per plek
 * anders: de hero staat in een `.photo-band tall` (4/5), de formatvoorbeelden
 * zijn verticale video (9/16), en de brede band tussen de tekstkolommen is
 * 21/9 — dezelfde maat als de band op /catalog.
 */
const PLEKKEN = {
  hero: {
    ratio: '4 / 5',
    subject: {
      nl: 'Eén hookvideo, stilgezet op het frame waar de naad zit: bovenin het einde van de video, eronder het beeld uit de feed dat er precies op aansluit',
      en: 'One hook video, frozen on the frame where the join sits: the end of the video above, and below it the feed image that lines up with it exactly',
    },
    message: {
      nl: 'Moet in één blik het hele idee overbrengen: twee beelden die je los verwacht en die als één beeld lezen. Als een bezoeker na dit beeld nog moet lezen wat een hook is, doet het beeld zijn werk niet.',
      en: 'Must carry the whole idea at a glance: two images you expect to be separate, reading as one. If a visitor still has to read what a hook is after seeing this, the image is not doing its job.',
    },
  },
  video: {
    ratio: '9 / 16',
    subject: {
      nl: 'De verticale video zelf, op zijn volle hoogte, zoals hij in een feed staat',
      en: 'The vertical video itself, at full height, as it sits in a feed',
    },
    message: {
      nl: 'Moet laten zien dat dit een VIDEO is en geen foto in een telefoonlijstje: beweging, een productvorm die kantelt, en genoeg leesbaarheid zonder geluid.',
      en: 'Must show that this is a VIDEO and not a photo in a phone frame: movement, a product form turning, and enough legibility without sound.',
    },
  },
  stills: {
    ratio: '9 / 16',
    subject: {
      nl: 'De losse beelden uit dezelfde montage — de frames waar de naad zit, naast elkaar',
      en: 'The separate stills from the same edit — the frames where the join happens, side by side',
    },
    message: {
      nl: 'Moet duidelijk maken dat je er meer aan overhoudt dan één bestand: dit zijn bruikbare beelden op zichzelf, in dezelfde mappen als elke andere bestelling.',
      en: 'Must make clear that you keep more than one file: these are usable images in their own right, in the same folders as any other order.',
    },
  },
  snit: {
    ratio: '9 / 16',
    subject: {
      nl: 'Dezelfde montage in drie uitsneden naast elkaar: verticaal, 4:5 en 1:1',
      en: 'The same edit in three crops side by side: vertical, 4:5 and 1:1',
    },
    message: {
      nl: 'Moet laten zien dat het product in elke uitsnede heel blijft — het is één montage en geen drie keer bijsnijden waarbij er telkens iets afvalt.',
      en: 'Must show the product stays whole in every crop — it is one edit, not three trims that each lose something.',
    },
  },
  naad: {
    ratio: '21 / 9',
    subject: {
      nl: 'Een feed van bovenaf gezien, waarin één post uit twee delen bestaat die op elkaar aansluiten, met de naad zichtbaar aangewezen',
      en: 'A feed seen from above, in which one post is two parts that meet, with the join pointed out',
    },
    message: {
      nl: 'Moet de werking van het format uitleggen zonder tekst: waar de video ophoudt en het beeld eronder begint, en waarom je dat als kijker niet meteen ziet.',
      en: 'Must explain how the format works without words: where the video ends and the image below begins, and why a viewer does not notice the moment it happens.',
    },
  },
  stappen: {
    ratio: '4 / 5',
    subject: {
      nl: 'De vier telefoonfoto’s die een klant instuurt, naast het scherm waarop de montage gebouwd wordt',
      en: 'The four phone photos a client sends, beside the screen where the edit is being built',
    },
    message: {
      nl: 'Moet bewijzen dat het werk aan onze kant zit en niet aan die van de klant: links iets wat iedereen kan maken, rechts iets wat niemand er zelf van bouwt.',
      en: 'Must prove the work sits on our side and not the client’s: on the left something anyone can make, on the right something nobody builds from it themselves.',
    },
  },
};
/* `p(plek, veld)` — de tekst in de goede taal, zonder overal een ternary. */
const p = (sleutel: string, veld: 'subject' | 'message') => PLEKKEN[sleutel][veld][lang];
const r = (sleutel: string) => PLEKKEN[sleutel].ratio;

const COPY = {
  en: {
    eyebrow: '( Hooks )',
    /* Het accentwoord is "one" en niet "video": wat deze dienst verkoopt is de
       naad — twee beelden die als één lezen — en dat is het woord dat de kop
       moet dragen. Zie de noot bij .hk-h1 em onderaan. */
    h1: 'Two frames that read<br />as <em>one</em>.',
    lead: `A short vertical video of your product, built on a format we have used before. From ${vanaf} per product, ${vatLabel('excl', 'en')}.`,
    /* GEEN BESTELKNOP. Zie punt 3 in de kop van dit bestand. Het label zegt wat
       er achter de knop gebeurt: een gesprek, geen bestelling. */
