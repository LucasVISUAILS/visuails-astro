const c = COPY[lang];
---

<!-- ── 1 · DE HERO ─────────────────────────────────────────────────────────
     Dezelfde vorm als /catalog, /lifestyle en /video: linkerkolom met eyebrow,
     kop, lead, drie knoppen, de dienstenregel, de feitenrij en de wachtrijnoot;
     rechterkolom het werk. Dat laatste is hier een Placeholder in dezelfde
     verhouding als de `.photo-band tall` die de zusterpagina's gebruiken, zodat
     de kolom precies zo hoog is als hij straks met beeld wordt. -->
<section class="page-hero">
  <div class="container two-col hero-split">
    <div class="reveal pending">
      <span class="eyebrow-page">{c.eyebrow}</span>
      <h1 class="display hk-h1" style="margin-top:1rem" set:html={c.h1} />
      <p class="lead" style="margin-top:1.2rem">{c.lead}</p>
      <div class="flex" style="margin-top:1.8rem">
        <span class="magnet-wrap"><span class="magnet-inner"><a href={lp('/contact')} class="btn btn-primary btn-lg">{c.ctaPrimary}</a></span></span>
        <a href={lp('/pricing')} class="btn btn-ghost btn-lg">{c.ctaPrices}</a>
        <a href={c.wa} class="btn btn-wa" target="_blank" rel="noopener">{c.waLabel}</a>
      </div>
      {/* `current={['complete']}` — "Allebei" gaat over catalog en lifestyle
          samen en niet over video, dus die valt weg; Hooks staat zelf niet in
          DOORS en hoeft er dus niet uit gefilterd te worden. Zie
          andereDeuren() in src/data/orderDoors.js. */}
      <ServiceSwitch current={['complete']} lang={lang} />
      <HeroFacts eigen={c.trust} lang={lang} />
      <p class="queue-note"><em class="hk-soon">{c.soonTag}</em> {c.queueNote}</p>
    </div>
    <div class="reveal pending">
      {/* ── GEEN BIJSCHRIFT IN DE HERO ──────────────────────────────────
          Op elke andere plek op deze pagina staat de opdracht onder het vlak,
          want daar is het een lijstje voor wie de beelden gaat maken. Hier
          niet: dit is het eerste wat een bezoeker ziet, en "Moet in één blik
          het hele idee overbrengen" is intern werkoverleg. Zelfde besluit als
          Lucas nam bij het portret op /studio — *"Boodschap is duidelijk zonder
          alle extra tekst."*

          De opdracht VERDWIJNT NIET: `data-subject` en `data-message` blijven
          op de figure staan, dus `npm run placeholders` noemt deze plek met
          opdracht en al. Zie de noot onderaan Placeholder.astro. */}
      <Placeholder lang={lang} ratio={r('hero')} caption={false} kind="video" subject={p('hero', 'subject')} message={p('hero', 'message')} />
    </div>
  </div>
</section>

<!-- ── 2 · WAT ER GELEVERD WORDT ───────────────────────────────────────────
     De plek waar /video zijn vier soorten toont en /lifestyle zijn moods: het
     eerste blok onder de hero waarin je ziet waar het over gaat. Hooks heeft
     geen soorten om uit te kiezen, dus staat hier wat je krijgt — drie
     verticale vlakken naast elkaar, in de verhouding van het bestand zelf. -->
<section>
  <div class="container">
    <h2 class="section-h">{c.krijgH}</h2>
    <div class="grid hk-krijg reveal-group">
      {c.krijg.map(([titel, regel, plek]) => (
        <div class="reveal pending">
          <Placeholder lang={lang} ratio={r(plek)} caption={false} kind="video" subject={p(plek, 'subject')} message={p(plek, 'message')} />
          <h3 class="hk-krijg-h">{titel}</h3>
          <p class="hk-krijg-p">{regel}</p>
        </div>
      ))}
    </div>
    <p class="hk-krijg-foot">{c.krijgFoot}</p>
  </div>
</section>

<!-- ── 3 · WAT HET IS EN WAAR HET STAAT ────────────────────────────────────
     Dezelfde `ed-head` + `svc-explain` als de drie zusterpagina's, met de brede
     band ertussen zoals /catalog die heeft. -->
<section class="section-tight">
  <div class="container">
    <div class="ed-head">
      <span class="ed-meta">{c.edMeta}</span>
      <div>
        <h2>{c.edH}</h2>
        <p class="ed-sub">{c.edSub}</p>
      </div>
    </div>
    <Placeholder lang={lang} space ratio={r('naad')} subject={p('naad', 'subject')} message={p('naad', 'message')} />
    <div class="svc-explain">
      <div class="svc-explain-main">
        <h3>{c.whatH}</h3>
        {c.whatP.map((alinea) => <p>{alinea}</p>)}
        <p class="model-note" set:html={c.modelNote} />
      </div>
      <aside class="svc-explain-side">
        <h3>{c.whereH}</h3>
        <ul class="svc-where-list">
          {c.where.map(([sterk, rest]) => (
            <li><strong>{sterk}</strong> — {rest}</li>
          ))}
        </ul>
      </aside>
    </div>
  </div>
</section>

<!-- ── 4 · DE STAPPEN ──────────────────────────────────────────────────────
     `photo-split` met het beeld links en de stappen rechts, precies zoals op
     /video en /catalog. Vier stappen in plaats van drie, want dat is wat er
     gebeurt — een stap verzwijgen om de vorm te laten kloppen zou de controle
     door een specialist zijn, en dat is juist de stap die het verschil maakt. -->
<section class="section-tight">
  <div class="container">
    <div class="photo-split reveal pending">
      <div class="photo-split-media">
        <Placeholder lang={lang} ratio={r('stappen')} caption={false} subject={p('stappen', 'subject')} message={p('stappen', 'message')} />
      </div>
      <div>
        <h2>{c.stepsH}</h2>
        <div class="steps steps-stacked" style="margin-top:1.6rem">
          {c.steps.map(([kop, tekst], i) => (
            <div class="step"><span class="step-n">{String(i + 1).padStart(2, '0')}</span><h3>{kop}</h3><p>{tekst}</p></div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ── 5 · DE CHECKLIST EN HET PRIJSBLOK ───────────────────────────────────
     Zelfde tweekolomsband als /video's checklist + `.buy-note`. De knop in het
     rechterblok gaat naar het gesprek en niet naar een bestelling — zie punt 3
     in de kop van dit bestand. -->
<section class="section-tight">
  <div class="container two-col">
    <div class="reveal pending">
      <h2>{c.cleanH}</h2>
      <ul class="checklist" style="margin-top:1.4rem">
        {c.clean.map((li) => (
          <li><svg viewBox="0 0 24 24" class="i" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg><span>{li}</span></li>
        ))}
      </ul>
    </div>
    <div class="reveal pending hk-prijs">
      <h3>{c.prijsH}</h3>
      <p set:html={c.prijsVanaf} />
      <p set:html={c.prijsVariant} />
      {/* Dezelfde functie als `.buy-flat` op /video: een lezer die van /pricing
          komt heeft net een dalend tarief gezien en neemt anders aan dat dit er
          ook een is. Afgestreept en niet omkaderd — het is een noot OP de twee
          regels erboven en geen derde manier om te kopen. */}
      <p class="hk-prijs-vlak"><strong>{c.prijsNietH}</strong> {c.prijsNiet}</p>
      <div class="flex" style="margin-top:1.4rem">
        <a href={lp('/contact')} class="btn btn-primary">{c.prijsCta}</a>
        <a href={c.wa} class="btn btn-wa" target="_blank" rel="noopener">{c.waLabel}</a>
      </div>
    </div>
  </div>
</section>

<!-- ── 6 · DE TIERBAND ─────────────────────────────────────────────────────
     Met dezelfde kwalificerende regel erboven als /video: TierCompare toont de
     twee serviceniveaus van de prijs per aantal, en geen van beide is met hooks
     te bereiken. `href0`/`label0` wijzen naar catalog en niet naar de
     keuzepagina — zie de noot bij catalogHref hierboven. -->
<section class="section-tight">
  <div class="container">
    <p class="queue-note" style="margin-bottom:1.4rem">{c.tierNote}</p>
    <TierCompare lang={lang} href0={catalogHref} label0={catalogCta} />
  </div>
</section>

<section>
  <div class="container" style="max-width:760px">
    <h2 class="section-h">{c.faqH}</h2>
    <div class="faq-stack">
      {c.faqs.map((f) => (
        <Disclose summary={f.q} tone="panel">
          <p>{f.a}</p>
        </Disclose>
      ))}
    </div>
  </div>
</section>

<section class="section-tight">
  <div class="container">
    <div class="cta-band reveal pending">
      <h2 class="display" style="font-size:var(--t-page-h2)" set:html={c.ctaH} />
      <p class="lead" style="margin:1.2rem auto 0;text-align:center">{c.ctaP}</p>
      <div class="flex" style="justify-content:center;margin-top:2rem">
        <span class="magnet-wrap"><span class="magnet-inner"><a href={lp('/contact')} class="btn btn-primary btn-lg">{c.ctaPrimary}</a></span></span>
        <a href={lp('/pricing')} class="btn btn-ghost btn-lg">{c.ctaPrices}</a>
        <a href={c.wa} class="btn btn-wa" target="_blank" rel="noopener">{c.waLabel}</a>
      </div>
      {/* De laatste zin van de pagina, en met opzet de laatste: het is de enige
          claim die we over bereik doen, en die is dat we er geen doen. */}
      <p class="hk-belofte">{c.beloofte}</p>
    </div>
  </div>
</section>

<style>
  /* Het accentwoord in de kop, zelfde behandeling als op elke andere
     dienstpagina — zie de noot bij --font-editorial in global.css. */
  .hk-h1 em { font-family: var(--font-editorial); font-style: italic; font-weight: 700; }

  /* De wachtrijnoot. Zichtbaar en op leesbare grootte, niet als grijze
     voetnoot: dat "je kunt dit nog niet bestellen" is het eerste wat een
     bezoeker moet weten en niet het laatste. */
  .queue-note { margin-top: .9rem; font-size: .88rem; color: var(--ink-3); }

  /* ── HET "BINNENKORT"-MERKJE ─────────────────────────────────────────────
     Dezelfde vorm als `.mi-soon` in de navigatie, want het zegt hetzelfde
     ding op een tweede plek en twee vormen voor één betekenis is er één te
     veel. Niet cursief zoals een <em> standaard is: dit is een etiket en geen
     nadruk, en de betekenis zit in het kader eromheen. */
  .hk-soon {
    display: inline-block;
    margin-right: .45rem;
    padding: .12rem .45rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--r-sm);
    font-style: normal;
    font-size: .72rem;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--ink-3);
    vertical-align: .08em;
  }

  /* ── DRIE VERTICALE VLAKKEN ──────────────────────────────────────────────
     Drie items, drie kolommen. Eén stap eerder terug naar één kolom dan
     `.vid-kinds` doet, omdat deze vlakken 9/16 zijn: op 38rem zou een derde
     kolom 180px breed en 320px hoog worden, en dan staat er een strook in
     plaats van een video. */
  .hk-krijg { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  @media (max-width: 56rem) { .hk-krijg { grid-template-columns: minmax(0, 1fr); } }

  /* ── EN HET VLAK IS SMALLER DAN ZIJN KOLOM ───────────────────────────────
     Gemeten op 1440px: drie kolommen over de volle containerbreedte maken elk
     vlak 430 bij 765 pixels, en drie van die vlakken naast elkaar zijn 765px
     hoog aan bijna niets. Verticaal is de goede VORM — dat is wat het bestand
     wordt — maar niet op die schaal.

     DE EERSTE POGING ZETTE DE GRENS OP DE RIJ (`max-width` plus `margin-inline:
     auto`), en die was fout op een manier die je pas op de schermafdruk ziet: de
     rij kwam los te staan van de kop erboven en de voetregel eronder, die
     allebei aan de linkerrand van de container beginnen. Een gecentreerde rij
     tussen twee links uitgelijnde blokken leest als een fout, ook als de maten
     kloppen.

     De grens hoort dus op het VLAK. De kolommen houden het ritme van de
     container — kop, rij en voetregel delen één linkerrand — en het beeld wordt
     300 bij 533: onmiskenbaar verticaal, en geen muur. `:global()` omdat de
     doos in Placeholder.astro staat en het scope-attribuut van deze pagina daar
     niet komt; zie de noot bij de `space`-prop in dat bestand. */
  .hk-krijg :global(.ph-box) { max-width: 300px; }

  /* Kop en regel onder een vlak: dezelfde afstand als elk ander label-met-regel
     op de site, uit --gap-label-note. */
  .hk-krijg-h { margin-top: 1rem; font-size: 1rem; font-weight: 700; color: var(--ink); }
  .hk-krijg-p { margin-top: var(--gap-label-note); font-size: .92rem; color: var(--ink-2); }
  .hk-krijg-foot { margin-top: clamp(1.6rem, 3vw, 2.2rem); font-size: .9rem; color: var(--ink-3); max-width: var(--measure-note, 68ch); }

  /* De link naar het merkmodel komt via set:html binnen en draagt dus geen
     scope-attribuut; :global() op de afstammeling is wat hem bereikt. Zelfde
     behandeling als elke andere link in lopende tekst. */
  .model-note :global(a) { color: var(--accent-bright); text-decoration: underline; text-underline-offset: 3px; }

  /* Het prijsblok. Zelfde vorm als `.buy-note` op /video: volle rand, geen
     nesting, geen accenttint — een kader binnen een kolom die al kadert, leest
     als twee kaders. */
  .hk-prijs { border: 1px solid var(--line-strong); padding: clamp(1.4rem, 3vw, 2rem); }
  .hk-prijs h3 { font-family: var(--font-display); font-weight: 800; font-size: 1.15rem; letter-spacing: -0.01em; }
  .hk-prijs p { margin-top: var(--gap-label-note); color: var(--ink-2); }
  .hk-prijs p :global(strong) { color: var(--ink); font-weight: 600; }
  .hk-prijs .hk-prijs-vlak {
    margin-top: 1.1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
    font-size: .9rem;
    line-height: 1.55;
    color: var(--ink-3);
  }
  .hk-prijs .hk-prijs-vlak strong { color: var(--ink); font-weight: 700; }

  /* De vragenlijst. `Disclose` doet de panelen; dit zet alleen de tussenruimte,
     precies zoals op /catalog, /lifestyle en /video. */
  .faq-stack { display: flex; flex-direction: column; gap: .7rem; }

  /* De slotregel in de cta-band. Gecentreerd zoals alles in die band, een stap
     zwakker dan de lead erboven, en met een lijn erboven die hem scheidt van de
     knoppen zonder er een tweede blok van te maken. */
  .hk-belofte {
    max-width: 68ch;
    margin: clamp(2rem, 4vw, 2.8rem) auto 0;
    padding-top: clamp(1.2rem, 2.4vw, 1.6rem);
    border-top: 1px solid var(--line);
    text-align: center;
    font-size: .88rem;
    line-height: 1.6;
    color: var(--ink-3);
  }
</style>
