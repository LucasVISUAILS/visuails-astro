    beloofte: 'We do not promise views, likes or followers. We promise the format, the execution and the check by a specialist. Whether a post travels depends on the platform and on timing, and neither of those is ours to promise.',
  },
  nl: {
    eyebrow: '( Hooks )',
    h1: 'Twee beelden die als<br /><em>één</em> lezen.',
