---
/*
 * VISUAILS — twee videovoorbeelden per stijl, plus wat er geleverd wordt.
 *
 * ── POSTER MET KLIK-OM-TE-SPELEN, ZONDER ÉÉN REGEL JAVASCRIPT ───────────────
 *
 * Lucas koos "poster met klik-om-te-spelen". Dat is precies wat een `<video>` met
 * `poster` en `preload="none"` doet: de browser tekent de still, haalt nul bytes
 * video op, en begint pas te laden als er op play wordt gedrukt. `controls` geeft
 * de knop, de balk en het volume — allemaal al toegankelijk, allemaal al vertaald
 * door de browser zelf.
 *
 * Een eigen speler eromheen zou een script toevoegen aan pagina's die er nergens
 * anders een nodig hebben, en zou de vier dingen die de native speler gratis doet
 * (toetsenbord, schermlezer, volledig scherm, ondertitelknop) opnieuw moeten
 * bouwen. Dat is de verkeerde ruil voor een play-knop.
 *
 * GEEN AUTOPLAY, en dat is een bedrag en niet een smaak: vier stijlen × twee
 * voorbeelden is acht clips. Automatisch spelen laadt ze alle acht voor een
 * bezoeker die er misschien één bekijkt.
 *
 * ── EN DE LEGE STAAT IS EEN ONDERDEEL, GEEN GEBREK ─────────────────────────
 *
 * Het materiaal moet nog gemaakt worden. De lege staat heeft daarom de JUISTE
 * beeldverhouding, zodat de bladspiegel nu al is wat hij straks is en het invullen
 * van één pad niets verschuift. Hij zegt ook wat er komt, want een grijs vlak met
 * "binnenkort" is een gat; een grijs vlak dat vertelt wat je gaat zien, is een
 * aankondiging.
 *
 * IN DE HAL SINDS DE RONDGANG (13 oktober 2026). Dit blok was het laatste stuk van
 * de site in de oude vorm (een kop zonder pil, gestreepte vakken, een tabel met
 * hoofdletters). Nu zoals elke sectie in de hal: pil, kop in twee tonen, en per clip
 * een nevelvlak als studiogrond met de vorm van de clip er wit in, het rondje met de
 * speelknop in het midden. De leverlijst is een kaart met rijen en haarlijnen. Wat er
 * staat en wat er geladen wordt, is niet veranderd.
 *
 * Wat hij NIET doet, is een bestaande lifestyle-still als poster gebruiken. Een
 * poster is de eerste frame van de clip. Een foto die er alleen op lijkt, is een
 * voorbeeld van werk dat niet bestaat — dezelfde soort belofte die vandaag van
 * /video is afgehaald.
 *
 * ── LEVERING 117 (17 november 2026, proefronde P4-01): GEEN LEGE VAKKEN MEER ──
 *
 * De proefronde las de lege staat anders dan hij bedoeld was: voor de videoklant is
 * deze pagina het beslismoment, en een lege speler met "Nog niet opgenomen" zegt
 * "bestaat nog niet". Lucas koos het advies: zolang er geen eigen clips zijn, staan
 * er geen lege vakken. Er komen alleen voorbeelden in beeld die klaar zijn
 * (isReady: clip én poster). Is er bij een stijl nog geen enkele, dan blijft van
 * deze sectie alleen de leverlijst over, onder een eigen kop ("De bestanden").
 * Zodra Lucas een clip en een poster invult in src/data/videoExamples.js, komt het
 * vak met de speler vanzelf terug; er hoeft hier dan niets te veranderen.
 */
import { examplesFor, isReady, VIDEO_RATIOS, VIDEO_FORMAT, videoFilename } from '../data/videoExamples.js';

interface Props {
  lang: 'en' | 'nl';
  slug: string;
  name: string;
}
const { lang, slug, name } = Astro.props;
const nl = lang === 'nl';
const items = examplesFor(slug);
/* levering 117 (P4-01): alleen wat klaar is, komt in beeld; geen lege vakken. */
const klaar = items.filter((e) => isReady(e));

const T = nl ? {
  pil: 'Clips',
  /* "Motion in motion" (doorloop 90, S7): bij de stijl Motion alleen "In beweging". */
  h: /motion|beweging/i.test(name) ? 'In beweging' : `${name} in beweging`,
  lead: 'Klik om af te spelen.',
  /* levering 117 (P4-01): zonder clips is de leverlijst de sectie; pil en kop voor die stand. */
  leverPil: 'Bestanden',
  deliverH: 'De bestanden',
  deliverLead: `Standaard verticaal 9:16, als ${VIDEO_FORMAT.name}. Een andere verhouding kan op aanvraag en spreken we af in de offerte; bestel je die, dan heet het bestand zoals hieronder.`,
  fileH: 'Bestand',
  forH: 'Waarvoor',
  formatNote: VIDEO_FORMAT.why.nl,
  folderNote: 'Ze zitten in de map van je bestelling, naast de foto’s, met een nummer vooraan zodat je verkenner ze in deze volgorde zet. De LEESMIJ in die map legt de rest uit.',
} : {
  pil: 'Clips',
  h: /motion/i.test(name) ? 'See it move' : `${name} in motion`,
  lead: 'Click to play.',
  leverPil: 'Files',
  deliverH: 'The files',
  deliverLead: `Vertical 9:16 as standard, as ${VIDEO_FORMAT.name}. Another ratio is on request and agreed in the quote; if you order one, the file is named as below.`,
  fileH: 'File',
  forH: 'For',
  formatNote: VIDEO_FORMAT.why.en,
  folderNote: 'They sit in your order’s folder beside the photographs, with a number in front so your file browser puts them in this order. The README in that folder explains the rest.',
};

const ratioOf = (id: string) => VIDEO_RATIOS.find((r) => r.id === id) || VIDEO_RATIOS[0];
const ratioCss = (id: string) => ratioOf(id).css;
/* De verhouding als getal (breedte / hoogte), voor de maat van het kader in de hal. */
const ratioNum = (id: string) => { const [a, b] = ratioCss(id).split('/').map((x) => Number(x.trim())); return +(a / b).toFixed(4); };

/** "8 seconden · Verticaal" — zie de noot bij de figcaption voor waarom hier. */
const metaLine = (e: { seconds: number; ratio: string }) =>
  `${e.seconds} ${nl ? 'seconden' : 'seconds'} · ${ratioOf(e.ratio).name[lang]}`;
/* "Klik om af te spelen" staat er alleen als er iets te spelen valt. */
const ietsTeSpelen = klaar.length > 0;
const kopId = `vx-${slug}`;
---

{items.length > 0 && (
  <section class="h-sec h-vx-sec" aria-labelledby={kopId}>
    {/* levering 117 (P4-01): de kop met "in beweging" alleen als er iets beweegt; anders is de leverlijst de sectie. */}
    <header class="h-sec-kop h-in">
      <div>
        <p class="h-pil"><span>{ietsTeSpelen ? T.pil : T.leverPil}</span></p>
        {ietsTeSpelen
          ? <h2 id={kopId} class="h-kop h-h2">{T.h.startsWith(name) ? <><span class="l">{name}</span> {T.h.slice(name.length).trim()}.</> : <><span class="l">{T.h}</span>.</>}</h2>
          : <h2 id={kopId} class="h-kop h-h2"><span class="l">{T.deliverH}</span>.</h2>}
      </div>
      {ietsTeSpelen && <p class="h-vs-kopzin">{T.lead}</p>}
    </header>

    {ietsTeSpelen && <div class="h-vx-rij">
      {klaar.map((e, n) => (
        <figure class="vx h-vx h-in" style={`--vx-ratio:${ratioCss(e.ratio)};--vx-r:${ratioNum(e.ratio)};--d:${n}`}>
          <div class="h-vx-grond">
            {/* preload="none" is het hele punt — zie de kop. playsinline zodat een
                 iPhone hem in de pagina speelt in plaats van het scherm over te nemen. */}
            <video
              class="vx-media"
              controls
              preload="none"
              playsinline
              poster={e.poster}
              aria-label={e.alt[lang]}
            >
              <source src={e.file} type={`video/${VIDEO_FORMAT.ext}`} />
            </video>
          </div>
          {/* De omschrijving staat onder het kader en niet erin: in een verticaal kader
               van 250 px wordt een zin van dertig woorden een kolom van vier letters, en
               onder het kader staat straks de titel van de échte clip. Eén string in de
               frontmatter (metaLine): Astro vouwt de witruimte tussen {…}-blokken weg. */}
          <figcaption class="vx-cap">
            <strong>{e.title[lang]}</strong>
            <span class="vx-meta">{metaLine(e)}</span>
            <span class="vx-alt">{e.alt[lang]}</span>
          </figcaption>
        </figure>
      ))}
    </div>}

    {/* ── DE LEVERLIJST ────────────────────────────────────────────────────
         Exacte bestandsnamen, uit videoFilename() en niet hier getypt: dan kan
         deze lijst niet iets anders beloven dan de levering aanlevert. */}
    <div class="vx-deliver h-vx-lever h-in">
      <div class="h-vx-lever-kop">
        {/* zonder clips staat "De bestanden" al als h2 boven deze kaart */}
        {ietsTeSpelen && <h3>{T.deliverH}</h3>}
        <p class="vx-deliver-lead">{T.deliverLead}</p>
      </div>
      <table class="vx-table">
        <thead>
          <tr><th>{T.fileH}</th><th>{T.forH}</th></tr>
        </thead>
        <tbody>
          {VIDEO_RATIOS.map((r, i) => (
            <tr>
              <td><code>{videoFilename(i, r.id)}</code></td>
              <td>{r.what[lang]}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <p class="vx-note">{T.formatNote}</p>
    </div>
  </section>
)}
