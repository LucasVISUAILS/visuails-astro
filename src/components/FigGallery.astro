---
/*
 * FigGallery — beoordelen, en waarom de map het eindresultaat is.
 *
 * ── WAAROM DIT BESTAAT ──────────────────────────────────────────────────────
 *
 * Lucas, 9 augustus 2026, over /portal: *"deze is nu nog wat saai en inconsistent
 * met de rest van de website. Op de eerste sectie gelijk weer een grote dashboard
 * mock-up laten zien die ook op de homepage staat en bij de image by image sectie
 * ook een eigen unieke mock-up maken voor het specifieke idee."*
 *
 * Wat er stond was een grijs vlak met "CLIENT PORTAL · DELIVERY GALLERY" erin,
 * naast de tekst die uitlegt dat je beeld voor beeld goedkeurt. Een placeholder op
 * de plek van het bewijs.
 *
 * ── WAT DEZE FIGUUR MOET UITLEGGEN, EN DAT IS SINDS VANDAAG MEER ────────────
 *
 * Deze band ging over goedkeuren. Diezelfde dag veranderde het portaal zelf:
 *
 *   *"Ik wil dat klanten de foto’s apart kunnen zien en een revisie per foto
 *   kunnen aanvragen maar het echte wat ze krijgen is een map met alle bestanden
 *   erin, de zichtbare foto’s zijn dus niet downloadbaar in het portaal."*
 *
 * Dat is een onderscheid dat een bezoeker niet zelf verzint, en het is precies het
 * soort ding dat als een BEPERKING leest als je het in een zin uitlegt en als een
 * OPRUIMING als je het laat zien. Vandaar de vorm van deze figuur: links de tegels
 * met twee knoppen en geen downloadknop, rechtsonder de map met wat erin zit. Het
 * scherm zegt zelf waarom die twee dingen niet hetzelfde zijn.
 *
 * ── DE STATEN ZIJN DE HELE COMPOSITIE ──────────────────────────────────────
 *
 * Vier tegels: één goedgekeurd, één met een revisie erop (met de notitie van de
 * klant eronder, in zijn eigen woorden), één open met het notitieveld erin, en één
 * die nog niets is. Dat is geen willekeurige greep — het is de bewering van deze
 * band in beeld: de rest van de bestelling loopt door terwijl er één terug is. Een
 * lijstje met vier keer "wacht op je" zou het omgekeerde tekenen.
 *
 * De teller bovenaan (2 van 4 goedgekeurd · 1 terug) is het enige stukje UI dat
 * bewijst dat die staten iets DOEN.
 *
 * ── HET IS EEN MOCK-UP EN DAT MOET ERBIJ STAAN ─────────────────────────────
 *
 * Zelfde afspraak als FigDash en FigGate: verzonnen gegevens, geen echte
 * handeling, geen link naar een portaal, en het woord "voorbeeld" in beeld. Merk
 * VOLT en referentie VIS-2608-4471, dezelfde als in de andere twee figuren, zodat
 * de drie over dezelfde bestelling gaan.
 *
 * NOOIT EEN ECHT ADRES OF EEN ECHTE NAAM. Zie de langere noot in FigDash.astro.
 *
 * ── GEEN JAVASCRIPT ────────────────────────────────────────────────────────
 *
 * Er is niets interactief nodig: dit is één toestand van één scherm. Het
 * notitieveld is een <textarea readonly> met tekst erin en geen formulier — een
 * formulier op een marketingpagina dat nergens naartoe post, is een knop die
 * niets doet.
 */
import { DEMO_ORDER } from '../data/figdemo.js';
/* Het woordmerk in de balk van het voorbeeldscherm (14 oktober 2026): het echte merk, niet het woord in een letter. */
import Woordmerk from './Woordmerk.astro';
import { CATALOG_IMAGES } from '../data/pricing.js';
import { geleverd, MODEL_EERST } from '../data/voorbeeldset.js';
import { deliveryEntries } from '../lib/delivery.js';
import UitlegBalk from './UitlegBalk.astro';

/* `uitleg` (14 oktober 2026): een cursor keurt twee beelden goed, vraagt bij het
   modelbeeld om grijs in plaats van wit (sinds 15 oktober 2026; daarvoor andersom),
   en opent de map. Zie UitlegBalk.astro.
   Afvinklijst 24 (Lucas): de roze jeans uit de voorbeeldset ("ook hier mag je de roze
   broek gebruiken"), en de map zoals hij echt is: elk beeld als JPG, PNG en WebP op
   aanvraag (k401, 11 oktober). Hier stond "als PNG, JPG en WebP" en drie formaten per beeld. */
interface Props { lang?: 'en' | 'nl'; uitleg?: boolean }
const { lang = 'en', uitleg = false } = Astro.props;
const nl = lang === 'nl';

/* ── DEZELFDE BESTELLING ALS IN FIGDASH, FIGOVERZICHT EN FIGBOARD — 30 sep 2026
   De referentie stond hier uitgetypt, de goedkeuringen op 8 aug terwijl het
   venster van die bestelling 10 – 11 aug is, en "24 bestanden" bij twintig
   producten. Nu komt alles uit dezelfde fixture: catalog, de dag na het venster,
   en het aantal bestanden uit producten × beelden × drie formaten. */
/* De datum bij "Goedgekeurd" is weg (14 oktober 2026): het echte scherm zegt alleen
   "Goedgekeurd" (stApproved in account.js), en zo staat het ook in FigDash. */
const TOTAAL = DEMO_ORDER.products * CATALOG_IMAGES;
/* Eén bestand per beeld: JPG is de standaard. */
const BESTANDEN = TOTAAL;

/* De vier beelden van product 1: de roze jeans, op lichtgrijs. Het modelbeeld is het
   beeld waarvoor de klant om grijs vraagt, "zoals de rest", dus hier staat het nog op
   wit (MODEL_EERST). Lucas, 15 oktober 2026: *"bij de revisie de modelfoto van witte
   achtergrond naar grijze achtergrond"*. */
const UIT = geleverd(lang);
const PHOTOS = [UIT[0].src, UIT[1].src, UIT[2].src, MODEL_EERST];
/* Na de revisie (stap 4): hetzelfde modelbeeld op grijs, zoals in FigDash. */
const MODEL_NA = UIT[3].src;
const PRODUCT = nl ? 'Wijde jeans' : 'Wide leg jeans';
/* Het boompje uit dezelfde functie als de echte zip (delivery.js), met alleen JPG. */
const SHOTS = ['front', 'back', 'detail', 'worn'];
const entries = deliveryEntries(SHOTS.map((shot, i) => ({
  id: i + 1, product_key: 'p1', shot, r2_key: `x/${i}`, bytes: 0, filename: `${shot}.jpg`,
  assets: [{ format: 'jpg', r2_key: `x/${i}.jpg`, bytes: 0 }],
})), lang, { ref: DEMO_ORDER.ref, productNames: { p1: PRODUCT } });
const productMap = entries[0]?.name.split('/')[1] || `01 - ${PRODUCT}`;
const BOOM = [[`${productMap}/`, 'dir'], ...entries.map((e) => [e.name.split('/').slice(2).join('/'), 'file'])];

const C = nl
  ? {
      badge: 'Voorbeeld met verzonnen gegevens',
      ref: `${DEMO_ORDER.ref} · ${DEMO_ORDER.brand}`,
      h: 'Wat wij leverden',
      tally: `2 van ${TOTAAL} goedgekeurd · 1 in je ronde`,
      tallyStap: [`0 van ${TOTAAL} goedgekeurd`, `1 van ${TOTAAL} goedgekeurd`, `2 van ${TOTAAL} goedgekeurd`],
      zinnen: [
        'Je keurt per beeld goed: één klik, en dat beeld is klaar.',
        'De rest van je bestelling wacht niet op de beelden die je nog niet bekeek.',
        'Wil je iets anders? Zeg het in je eigen woorden. Alleen dat beeld gaat terug.',
        'Wij passen het aan en leveren het opnieuw: nu op grijs, net als de rest.',
        'Je bestanden staan in één map, per product, als JPG. PNG of WebP vraag je erbij aan.',
      ],
      tallyNa: `2 van ${TOTAAL} goedgekeurd · 1 aangepast`,
      opnieuw: 'Opnieuw geleverd',
      tiles: [
        /* De woorden van het echte scherm (stApproved, stRevision in account.js), 14 oktober 2026. */
        { cap: 'Product 1 · voorkant', state: 'ok', label: 'Goedgekeurd' },
        { cap: 'Product 1 · achterkant', state: 'ok', label: 'Goedgekeurd' },
        { cap: 'Product 1 · detail', state: 'open' },
        { cap: 'Product 1 · op model', state: 'rev', label: 'Revisie aangevraagd', said: 'Toch liever op grijs dan wit, zoals de rest.' },
      ],
      bApprove: 'Goedkeuren',
      /* 14 oktober 2026: de woorden van het echte scherm (rdTick en rdHint in account.js), en
         een revisie als wens in plaats van fout (Lucas, afvinklijst 24). */
      bAsk: 'Deze aanmerken',
      /* Letterlijk de vraag van het echte scherm (rdNote, levering 40). */
      noteLabel: 'Wat wil je anders aan dit beeld?',
      notePlaceholder: 'In je eigen woorden — hoe specifieker, hoe sneller het goed is.',
      bSend: 'Revisieronde versturen',
      reviewNote: 'Deze beelden zijn op schermformaat. Ze staan er om te beoordelen.',
      folderH: 'Jouw bestanden',
      folderBody: 'Eén map per product, en daarin elk beeld als JPG. PNG of WebP erbij? Eén klik op de bestelling.',
      folderMeta: `${BESTANDEN} bestanden · JPG`,
      /* De knop van het echte scherm (bDownloadAll). */
      bFolder: 'Downloaden (zip)',
      meerMappen: `en nog ${DEMO_ORDER.products - 1} productmappen`,
    }
  : {
      badge: 'Example with made-up data',
      ref: `${DEMO_ORDER.ref} · ${DEMO_ORDER.brand}`,
      h: 'What we delivered',
      tally: `2 of ${TOTAAL} approved · 1 in your round`,
      tallyStap: [`0 of ${TOTAAL} approved`, `1 of ${TOTAAL} approved`, `2 of ${TOTAAL} approved`],
      zinnen: [
        'You approve image by image: one click and that image is done.',
        'The rest of your order does not wait for the images you have not looked at yet.',
        'Want something different? Say it in your own words. Only that image goes back.',
        'We change it and deliver it again: on grey now, like the rest.',
        'Your files sit in one folder, per product, as JPG. PNG or WebP you request on top.',
      ],
      tallyNa: `2 of ${TOTAAL} approved · 1 changed`,
      opnieuw: 'Delivered again',
      tiles: [
        { cap: 'Product 1 · front', state: 'ok', label: 'Approved' },
        { cap: 'Product 1 · back', state: 'ok', label: 'Approved' },
        { cap: 'Product 1 · detail', state: 'open' },
        { cap: 'Product 1 · on model', state: 'rev', label: 'Revision requested', said: 'On grey rather than white after all, like the rest.' },
      ],
      bApprove: 'Approve',
      bAsk: 'Mark this one',
      noteLabel: 'What would you like different about this image?',
      notePlaceholder: 'In your own words — the more specific, the faster we get it right.',
      bSend: 'Send revision round',
      reviewNote: 'These are at screen size. They are here to be judged.',
      folderH: 'Your files',
      folderBody: 'One folder per product, and in it every image as JPG. Need PNG or WebP too? One click on the order.',
      folderMeta: `${BESTANDEN} files · JPG`,
      bFolder: 'Download (zip)',
      meerMappen: `and ${DEMO_ORDER.products - 1} more product folders`,
    };
---

<figure class="fg" data-uitleg={uitleg ? '' : undefined} data-uitleg-maat="2600 2400 4800 2800 3400" data-uitleg-start="500">
  <div class="fg-frame">
    <div class="fg-bar">
      <span class="fg-mark"><Woordmerk klasse="fg-wm" /><span class="fg-sr">VISUAILS</span></span>
      <span class="fg-ref">{C.ref}</span>
      <span class="fg-badge">{C.badge}</span>
    </div>

    <div class="fg-body">
      <div class="fg-head">
        <p class="fg-h">{C.h}</p>
        <p class="fg-tally">
          {uitleg && C.tallyStap.map((t, k) => <span class="fg-tally-u" data-k={k}>{t}</span>)}
          <span class="fg-tally-eind">{C.tally}</span>
          {uitleg && <span class="fg-tally-na">{C.tallyNa}</span>}
        </p>
      </div>

      <ul class="fg-tiles">
        {C.tiles.map((tile, i) => (
          <li class={`fg-tile is-${tile.state}`} data-u={uitleg ? ['1', '2', '', '3'][i] : undefined}>
            <span class="fg-foto">
              <img src={PHOTOS[i]} alt="" loading="lazy" decoding="async" width="200" height="250" />
              {uitleg && tile.state === 'rev' && <img class="fg-foto-na" src={MODEL_NA} alt="" loading="lazy" decoding="async" width="200" height="250" />}
            </span>
            <div class="fg-tile-body">
              <span class="fg-cap">{tile.cap}</span>
              {/* Met uitleg: ook de beelden die straks goedgekeurd of teruggestuurd zijn,
                  beginnen met de twee knoppen. */}
              {uitleg && tile.state !== 'open' ? (
                <div class="fg-acts fg-acts-u">
                  <span class="fg-btn is-primary" data-uitleg-klik={tile.state === 'ok' ? (i === 0 ? '1' : '2') : undefined}>{C.bApprove}</span>
                  <span class="fg-pick" data-uitleg-klik={tile.state === 'rev' ? '3' : undefined}><span class="fg-box" aria-hidden="true"></span>{C.bAsk}</span>
                </div>
              ) : null}
              {tile.state === 'ok' ? <span class="fg-state is-ok"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8.5l3.2 3L13 4.5" /></svg>{tile.label}</span> : null}
              {tile.state === 'rev' ? (
                <>
                  <span class="fg-state is-rev">{tile.label}</span>
                  {uitleg && <span class="fg-state is-ok fg-opnieuw"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8.5l3.2 3L13 4.5" /></svg>{C.opnieuw}</span>}
                  <p class="fg-said">{tile.said}</p>
                </>
              ) : null}
              {tile.state === 'open' ? (
                <div class="fg-acts">
                  <span class="fg-btn is-primary">{C.bApprove}</span>
                  <span class="fg-pick"><span class="fg-box" aria-hidden="true"></span>{C.bAsk}</span>
                </div>
              ) : null}
            </div>
          </li>
        ))}
      </ul>

      {/* Het geopende notitieveld. Eén keer, onder het rooster, want in een tegel
          van tweehonderd pixels breed is een tekstvak van drie regels niet te
          lezen — en het is juist de zin van de klant die deze band verkoopt. */}
      <div class="fg-ask">
        <p class="fg-ask-l">{C.noteLabel}</p>
        <p class="fg-ask-field"><span class="fg-ask-tekst">{uitleg ? C.tiles[3].said : C.notePlaceholder}</span></p>
        <span class="fg-btn is-primary" data-uitleg-klik={uitleg ? '3' : undefined} data-uitleg-wacht={uitleg ? '2700' : undefined}>{C.bSend}</span>
      </div>

      <p class="fg-fine">{C.reviewNote}</p>

      {/* ── DE MAP, EN DAAROM STAAT HIJ IN DEZE FIGUUR ──────────────────────
          Dit hoort niet bij "beeld voor beeld goedkeuren" en het staat er toch,
          omdat het de vraag beantwoordt die de tegels hierboven oproepen: als er
          bij geen enkele foto een downloadknop staat, waar krijg ik mijn
          bestanden dan? Het boompje ernaast zegt wat erin zit — per product een map,
          elk beeld als JPG — en dat is sneller gelezen dan de zin die het uitlegt. */}
      <section class="fg-folder">
        <div>
          <p class="fg-folder-h">{C.folderH}</p>
          <p class="fg-folder-n">{C.folderBody}</p>
          <p class="fg-folder-m">{C.folderMeta}</p>
        </div>
        {/* ── HET BOOMPJE, ZONDER LABELS ERNAAST ─────────────────────────────
            Hier stonden gekleurde PNG/JPG/WEBP-chips vóór elk pad, en dat las
            dubbel: "PNG · PNG/voorkant.png". Het pad zegt het formaat al twee
            keer (de map en de extensie). Wat overblijft is de vorm zelf, en die
            is het enige dat deze figuur hier moet bewijzen. */}
        <ul class="fg-tree">
          {BOOM.map(([name, kind], i) => (
            <li class={`fg-tree-${kind === 'dir' ? 'dir' : 'file'}`} style={uitleg ? `--i:${i}` : undefined}>{name}</li>
          ))}
          <li class="fg-tree-meer" style={uitleg ? `--i:${BOOM.length}` : undefined}>{C.meerMappen}</li>
        </ul>
        <span class="fg-btn is-primary fg-folder-btn" data-uitleg-klik={uitleg ? '5' : undefined} data-uitleg-wacht={uitleg ? '1600' : undefined}>{C.bFolder}</span>
      </section>
    </div>
  </div>
  {uitleg && <UitlegBalk zinnen={C.zinnen} lang={lang} />}
</figure>

<style>
  /* ── DE MAATVOERING IS OMHOOG — 7 september 2026 ─────────────────────────
   *
   * Deze tekening stond vol labels tussen 9,6 en 10,6px, onder de ondergrens
   * van 11,5px die de leesbaarheidskeuring hanteert. Dat is precies de val van
   * een figuur: hij is een TEKENING, dus je kijkt naar de vorm en leest de
   * bijschriften niet — en dan valt niemand op dat ze te klein zijn om te
   * lezen. Ze staan er alleen wél om gelezen te worden; het is de tekst die
   * uitlegt wat je ziet.
   *
   * Dezelfde ronde die FigGate, FigBoard en FigConverge al hebben gehad. De
   * ondergrens hier is .72rem (11,52px), en waar het label een reeks tekens is
   * zonder woordbeeld (een hexwaarde, een bestandsnaam) .75rem. */
  /* De maat wordt met een container query gemeten en niet met het venster: deze
     figuur staat in een halve kolom, dus wat hij moet weten is hoe breed die kolom
     is. Zelfde reden als in FigDash — zie de langere noot daar. */
  .fg { container-type: inline-size; margin: 0; }

  .fg-frame {
    border: 1px solid var(--line-strong);
    border-radius: var(--r-lg) 3px 3px 3px;
    background: var(--surface);
    overflow: hidden;
  }

  .fg-bar {
    display: flex; align-items: center; gap: .7rem; flex-wrap: wrap;
    padding: .7rem .9rem;
    background: var(--surface-2);
    box-shadow: inset 0 -1px 0 var(--line);
  }
  .fg-mark { font-family: var(--font-display); font-weight: 900; font-size: .78rem; letter-spacing: .16em; color: var(--ink); }
  .fg-ref { font-size: .75rem; color: var(--ink-2); font-variant-numeric: tabular-nums; }
  /* Het woord "voorbeeld" hoort in beeld te staan en niet alleen in de tekst
     ernaast: een schermafdruk wordt gedeeld zonder zijn pagina. */
  .fg-badge {
    margin-left: auto;
    font-size: .72rem; letter-spacing: .04em;
    color: var(--ink-3);
    padding: .18rem .5rem;
    border: 1px solid var(--line); border-radius: 3px;
  }

  .fg-body { padding: .9rem; display: grid; gap: .8rem; }
  .fg-head { display: flex; align-items: baseline; gap: .6rem; flex-wrap: wrap; }
  .fg-h { margin: 0; font-size: .9rem; font-weight: 700; color: var(--ink); }
  .fg-tally { margin: 0; font-size: .74rem; color: var(--ink-3); }

  /* Vier tegels op één rij zodra het past, en anders twee. Onder de 22rem één,
     want een foto van tachtig pixels breed bewijst niets. */
  .fg-tiles { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: .55rem; }
  @container (max-width: 34rem) { .fg-tiles { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @container (max-width: 20rem) { .fg-tiles { grid-template-columns: 1fr; } }

  .fg-tile { display: grid; gap: .3rem; align-content: start; }
  .fg-tile img {
    width: 100%; aspect-ratio: 4 / 5; object-fit: cover;
    border-radius: var(--r-sm, 6px) 3px 3px 3px;
    /* De rand zegt de staat mee. Niet ALLEEN de rand: de woorden eronder doen het
       werk, want een staat die alleen een kleur is, is voor niemand te lezen die
       de twee tinten niet kan scheiden — en dit is de staat die beslist of een
       foto weggaat. */
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .fg-tile.is-ok img { box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--accent) 55%, var(--line)); }
  .fg-tile.is-rev img { box-shadow: inset 0 0 0 2px var(--warn-ink, #C9A227); }
  .fg-tile.is-open img { box-shadow: inset 0 0 0 1px var(--line-strong); }
  .fg-tile-body { display: grid; gap: .18rem; }
  .fg-cap { font-size: .74rem; color: var(--ink-2); }
  .fg-state { font-size: .72rem; font-weight: 600; letter-spacing: .04em; text-transform: uppercase; }
  /* Goedgekeurd als dezelfde pil als in FigDash (.fd-ok-u) en het echte scherm — 14 oktober 2026,
     Lucas: "De Goedkeuren knoppen zijn niet consistent." */
  .fg-state.is-ok {
    display: inline-flex; align-items: center; justify-content: center; gap: .3rem; justify-self: stretch;
    padding: .26rem .5rem; border-radius: 8px 3px 3px 3px;
    background: color-mix(in srgb, var(--accent) 10%, var(--surface)); color: var(--accent-text); white-space: nowrap;
  }
  .fg-state.is-ok svg { width: 11px; height: 11px; flex: none; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  /* ── DE LETTER IS DONKER, DE RAND BLIJFT HELDER — 7 september 2026 ──────
     `--warn-ink` is de klei-kleur en meet als TEKST op wit 2,36:1. De noot bij
     dezelfde reparatie in FigBoard zegt het al: `--clay-text` bestaat precies
     hiervoor — dezelfde kleur, donker genoeg om te lezen (5,7:1). De rand om de
     tegel hoeft niet leesbaar te zijn en houdt dus de heldere waarde. */
  .fg-state.is-rev { color: var(--flag-ink, #25508B); }
  .fg-said {
    margin: .15rem 0 0; padding-left: .45rem;
    box-shadow: inset 2px 0 0 var(--line-strong);
    font-size: .74rem; line-height: 1.5; font-style: italic; color: var(--ink-3);
  }

  /* Goedkeuren boven, het vinkje "Deze aanmerken" eronder: zo staat het in FigDash en op het echte scherm. */
  .fg-acts { display: grid; gap: .3rem; margin-top: .15rem; }
  .fg-acts .fg-btn { text-align: center; }
  .fg-pick { display: inline-flex; align-items: center; gap: .35rem; padding: .1rem 0; font-size: .72rem; font-weight: 600; color: var(--ink-2); white-space: nowrap; }
  .fg-box { inline-size: .68rem; block-size: .68rem; flex: none; border-radius: 2px; box-shadow: inset 0 0 0 1px var(--line-strong); background-repeat: no-repeat; background-position: center; background-size: 80%; }
  /* Geen echte knoppen — zie de kop. Een <span> die eruitziet als een knop is hier
     het eerlijke element: er is niets om aan te klikken. */
  .fg-btn {
    display: inline-block;
    font-size: .72rem; font-weight: 600; letter-spacing: .02em;
    padding: .26rem .5rem;
    border: 1px solid var(--line-strong); border-radius: 14px 3px 3px 3px;
    color: var(--ink-2); white-space: nowrap;
  }
  .fg-btn.is-primary { background: var(--accent); border-color: var(--accent); color: var(--accent-on); }

  .fg-ask {
    display: grid; gap: .35rem; justify-items: start;
    padding: .65rem .7rem;
    background: var(--surface-2);
    border: 1px solid var(--line);
    border-radius: var(--r-md) 3px 3px 3px;
  }
  .fg-ask-l { margin: 0; font-size: .74rem; color: var(--ink-3); }
  .fg-ask-field {
    margin: 0; width: 100%;
    padding: .45rem .55rem;
    font-size: .74rem; line-height: 1.55; color: var(--ink-2);
    background: var(--surface);
    border: 1px solid var(--line-strong); border-radius: 3px;
  }
  /* De knop in het vak ligt langs zijn rechte onderrand: lichte hoeken (levering 61). */
  .fg-ask .fg-btn { border-radius: 3px; }

  .fg-fine { margin: 0; font-size: .74rem; line-height: 1.55; color: var(--ink-3); }

  /* ── DE MAP ──────────────────────────────────────────────────────────────
     Drie kolommen: waarom, wat erin zit, en de knop. Onder de 30rem worden het er
     één, met de knop over de volle breedte — dan leest het als het echte scherm op
     een telefoon. */
  .fg-folder {
    display: grid; grid-template-columns: minmax(0, 1fr) auto auto;
    gap: .8rem 1rem; align-items: center;
    padding: .8rem .85rem;
    background: var(--surface-2);
    border: 1px solid var(--line-strong);
    border-radius: var(--r-md) 3px 3px 3px;
  }
  @container (max-width: 30rem) {
    .fg-folder { grid-template-columns: 1fr; }
    .fg-folder-btn { text-align: center; }
  }
  .fg-folder-h { margin: 0 0 .15rem; font-size: .78rem; font-weight: 700; color: var(--ink); }
  .fg-folder-n { margin: 0; font-size: .75rem; line-height: 1.55; color: var(--ink-2); }
  .fg-folder-m { margin: .25rem 0 0; font-size: .74rem; color: var(--ink-3); font-variant-numeric: tabular-nums; }

  /* Monospace, want dit zijn paden en geen woorden — dan is uitlijning informatie
     en niet toeval. */
  .fg-tree {
    list-style: none; margin: 0; padding: 0; display: grid; gap: .2rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: .72rem; line-height: 1.45; color: var(--ink-3);
    white-space: nowrap;
  }
  .fg-tree-dir { color: var(--ink-2); font-weight: 600; }
  /* De bestanden springen in onder hun map, want dat is wat een map is. */
  .fg-tree-file { padding-left: .8rem; }
  .fg-tree-meer { color: var(--ink-2); }

  /* ── DE UITLEG (alleen met data-uitleg-staat) ────────────────────────────
     Tegel 1 wordt goedgekeurd in stap 1, tegel 4 in stap 2, tegel 2 krijgt in
     stap 3 een melding, en in stap 4 opent de map. De knoppen bij een tegel
     staan er tot zijn stap; daarna zijn staat. Na stap 4 is alles de figuur zoals
     hij altijd stond. */
  .fg-acts-u { display: none; }
  .fg[data-uitleg-staat] .fg-acts-u { display: grid; }
  /* Knoppen en staat in dezelfde cel: geen verspringende tegel als ze wisselen. */
  .fg[data-uitleg-staat] .fg-tile-body { grid-template-areas: "cap" "s" "zei"; }
  .fg[data-uitleg-staat] .fg-cap { grid-area: cap; }
  .fg[data-uitleg-staat] :is(.fg-acts-u, .fg-state) { grid-area: s; align-self: start; }
  .fg[data-uitleg-staat] .fg-said { grid-area: zei; }
  /* Twee regels en niet één lijst: op 14 oktober stond de 3,2 s van het modelbeeld
     ook achter de eerste twee, en dan bleef "Goedkeuren" staan nadat "Goedgekeurd" er al
     was (Lucas, afvinklijst 25: "glitchen de goedgekeurd knoppen"). */
  .fg[data-uitleg-staat].u-s1 .fg-tile[data-u="1"] .fg-acts-u,
  .fg[data-uitleg-staat].u-s2 .fg-tile[data-u="2"] .fg-acts-u { animation: fg-weg .3s ease .8s forwards; }
  .fg[data-uitleg-staat].u-s3 .fg-tile[data-u="3"] .fg-acts-u { animation: fg-weg .35s ease 3.2s forwards; }
  /* Het vinkje bij "Deze aanmerken" gaat aan zodra de cursor klikt, en blijft staan tot de ronde weg is. */
  .fg[data-uitleg] .fg-box { transition: background-color .25s, box-shadow .25s; }
  .fg.u-s3 .fg-tile[data-u="3"] .fg-box {
    background-color: var(--ink); box-shadow: inset 0 0 0 1px var(--ink); transition-delay: .62s;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'><path d='M3 8.5l3.2 3L13 4.5' fill='none' stroke='white' stroke-width='2.4' stroke-linecap='round' stroke-linejoin='round'/></svg>");
  }
  .fg[data-uitleg-staat="klaar"] .fg-acts-u { visibility: hidden; }
  @keyframes fg-weg { to { opacity: 0; transform: scale(.9); } }

  .fg[data-uitleg-staat] :is(.fg-state, .fg-said) { transition: opacity .45s, transform .6s cubic-bezier(.34, 1.4, .5, 1); }
  .fg[data-uitleg-staat]:not(.u-s1) .fg-tile[data-u="1"] :is(.fg-state, .fg-said),
  .fg[data-uitleg-staat]:not(.u-s2) .fg-tile[data-u="2"] :is(.fg-state, .fg-said),
  .fg[data-uitleg-staat]:not(.u-s3) .fg-tile[data-u="3"] :is(.fg-state, .fg-said) { opacity: 0; transform: translateY(6px); }
  .fg.u-s1 .fg-tile[data-u="1"] .fg-state, .fg.u-s2 .fg-tile[data-u="2"] .fg-state { transition-delay: 1.1s; }
  .fg.u-s3 .fg-tile[data-u="3"] :is(.fg-state, .fg-said) { transition-delay: 3.5s; }
  .fg[data-uitleg-staat] .fg-tile img { transition: box-shadow .5s; }
  .fg[data-uitleg-staat]:not(.u-s1) .fg-tile[data-u="1"] img,
  .fg[data-uitleg-staat]:not(.u-s2) .fg-tile[data-u="2"] img,
  .fg[data-uitleg-staat]:not(.u-s3) .fg-tile[data-u="3"] img { box-shadow: inset 0 0 0 1px var(--line-strong); }
  .fg.u-s1 .fg-tile[data-u="1"] img, .fg.u-s2 .fg-tile[data-u="2"] img { transition-delay: 1.05s; }
  .fg.u-s3 .fg-tile[data-u="3"] img { transition-delay: 3.5s; }
  /* ── STAP 4: OPNIEUW GELEVERD, NU OP GRIJS — 14 en 15 oktober 2026 ──────────
     Lucas (afvinklijst 25): "mag de grijze on model foto ook veranderen na de revisie
     naar witte achtergrond foto." Op 15 oktober omgedraaid: van wit naar grijs, zoals
     de rest van de set. Het nieuwe beeld ligt in dezelfde cel als het eerste
     (ook als de bouw er een <picture> omheen zet: daarom :global) en komt er overheen;
     "Revisie aangevraagd" wordt "Opnieuw geleverd". */
  .fg-foto { display: grid; }
  /* De <picture> van de bouw staat op display: contents, dus de beelden zelf zijn de
     rasteritems: allebei in cel 1/1. */
  .fg-foto > :global(*), .fg-foto img { grid-area: 1 / 1; min-width: 0; }
  .fg-foto-na { opacity: 0; transition: opacity .7s ease, box-shadow .5s; }
  .fg.u-s4 .fg-foto-na { opacity: 1; transition-delay: .4s; }
  .fg.u-s4 .fg-tile[data-u="3"] img { box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--accent) 55%, var(--line)); transition-delay: .4s; }
  .fg[data-uitleg-staat]:not(.u-s4) .fg-tile[data-u="3"] .fg-opnieuw { opacity: 0; transform: translateY(6px); }
  .fg.u-s3.u-s4 .fg-tile[data-u="3"] .fg-state.is-rev { opacity: 0; transform: translateY(-4px); transition-delay: .6s; }
  .fg.u-s4 .fg-tile[data-u="3"] .fg-opnieuw { transition-delay: 1s; }

  /* De teller loopt mee: 0, 1, 2, en dan "2 · 1 terug". */
  .fg-tally { display: grid; }
  .fg-tally > span { grid-area: 1 / 1; }
  .fg[data-uitleg-staat] .fg-tally > span { opacity: 0; transition: opacity .3s; }
  .fg[data-uitleg-staat]:not(.u-s1) .fg-tally-u[data-k="0"],
  .fg.u-s1:not(.u-s2) .fg-tally-u[data-k="1"],
  .fg.u-s2:not(.u-s3) .fg-tally-u[data-k="2"],
  .fg.u-s3 .fg-tally > .fg-tally-eind { opacity: 1; }
  .fg.u-s1:not(.u-s2) .fg-tally-u[data-k="1"], .fg.u-s2:not(.u-s3) .fg-tally-u[data-k="2"] { transition-delay: 1.05s; }
  /* `.fg-tally >` erbij: anders won `.fg[data-uitleg-staat] .fg-tally > span` (opacity 0) en
     bleef de teller na stap 2 leeg (14 oktober 2026 gevonden). */
  .fg.u-s3 .fg-tally > .fg-tally-eind { transition-delay: 3.5s; }
  /* Stap 4: opnieuw geleverd — de teller zegt "1 aangepast", zoals in FigDash. */
  .fg.u-s4 .fg-tally > .fg-tally-eind { opacity: 0; transition-delay: .6s; }
  .fg.u-s4 .fg-tally > .fg-tally-na { opacity: 1; transition-delay: 1s; }
  .fg.u-s1:not(.u-s2) .fg-tally-u[data-k="0"] { opacity: 1; transition-delay: 0s; animation: fg-uit .3s linear 1.05s forwards; }
  @keyframes fg-uit { to { opacity: 0; } }

  /* De melding: het veld licht op en de zin verschijnt terwijl hij geschreven wordt. */
  .fg[data-uitleg-staat] .fg-ask { transition: box-shadow .4s, opacity .4s; }
  .fg[data-uitleg-staat]:not(.u-s3) .fg-ask { opacity: .45; }
  .fg.u-s3:not(.u-s4) .fg-ask { box-shadow: 0 0 0 2px var(--accent); transition-delay: .8s; }
  .fg[data-uitleg-staat]:not(.u-s3) .fg-ask-tekst { clip-path: inset(0 100% 0 0); }
  .fg.u-s3 .fg-ask-tekst { animation: fg-typ 1.5s steps(28, end) 1s both; }
  @keyframes fg-typ { from { clip-path: inset(0 100% 0 0); } to { clip-path: inset(0 0 0 0); } }

  /* De map: de regels een voor een, dan de knop. */
  .fg[data-uitleg-staat] .fg-tree li { transition: opacity .35s, transform .45s cubic-bezier(.22, .8, .2, 1); }
  .fg[data-uitleg-staat]:not(.u-s5) .fg-tree li { opacity: 0; transform: translateX(-6px); }
  .fg.u-s5 .fg-tree li { transition-delay: calc(var(--i, 0) * .22s + .2s); }
  .fg[data-uitleg-staat]:not(.u-s5) .fg-folder { opacity: .45; }
  .fg[data-uitleg-staat] .fg-folder { transition: opacity .4s; }

  .fg[data-uitleg-staat="pauze"] * { animation-play-state: paused !important; }
  @media (prefers-reduced-motion: reduce) {
    .fg-acts-u { display: none !important; }
  }
</style>
