   toegevoegd."* Catalog houdt zijn verhaal: één jeans van foto tot geleverd beeld, met in
   stap 2 de lagen uit elkaar. Het tempo per dienst staat op de tabs (data-maat). */
const DIENSTEN_HOE = ['catalog', 'lifestyle', 'video'] as const;
type Dienst = (typeof DIENSTEN_HOE)[number];
const STAP_TEKST: Record<Dienst, [string, string][]> = {
  catalog: c.stappen.map(([n, r]: string[]) => [n, r] as [string, string]),
  lifestyle: c.stappenLifestyle as [string, string][],
  video: c.stappenVideo as [string, string][],
};
const UITLEG_ZINNEN: Record<Dienst, string[]> = { catalog: c.uitlegZinnen, lifestyle: c.uitlegLifestyle, video: c.uitlegVideo };
/* Catalog, stap 2: de drie lagen van het geleverde beeld, voorop eerst (het product, de schaduw, de grond). */
const ONT_LAGEN = (['los', 'schaduw', 'vlak'] as const).map((soort, k) => ({ soort, src: k < 2 ? '/img/ba2-na-front-uitgeknipt.webp' : '' }));
/* Lifestyle, stap 1: drie looks uit de collectie (styles.js) en de eigen look; Flash gekozen. */
const KIES_LOOKS = [
  ...['dunes', 'flash', 'glow'].map((slug) => lifestyle.find((s: any) => s.slug === slug)).filter(Boolean)
    .map((s: any) => ({ naam: s.name, beeld: String(s.cardPhoto).replace(/\.webp$/, '-w380.webp'), gekozen: s.slug === FLASH.slug })),
  { naam: (lifestyle.find((s: any) => s.slug === 'custom') as any)?.name ?? (nl ? 'Eigen look' : 'Your own look'), beeld: '', gekozen: false },
];
/* Video, stap 1: de stijlen uit videoStyles (Motion voorop). */
const VIDEO_STIJLEN = (nl ? videoNl : videoEn).map((s: any) => s.name);
/* Lifestyle, stap 3: vier beelden van de look Flash (zoals op /lifestyle/flash). */
const LIFESTYLE_SET = [
  { src: '/img/lifestyle-flash-01-w380.webp', w: 380, h: 472 },
  { src: '/img/lifestyle-flash-02-w380.webp', w: 380, h: 681 },
  { src: '/img/lifestyle-flash-03-w380.webp', w: 380, h: 681 },
  { src: '/img/lifestyle-flash-04-w380.webp', w: 380, h: 284 },
];
const kop = TAGLINE[lang];
/* De iconen uit het kit (levering 54, afvinklijst 34): links de naam in dit
   onderdeel, rechts het icoon in src/data/iconen.js. */
const ICOON = { label: 'prijs', klok: 'klok', doos: 'doos', check: 'vink', pijl: 'pijl-schuin', rechts: 'pijl', links: 'pijl-links', speel: 'afspelen', info: 'info', maken: 'kader', bewerken: 'bewerken', kenmerk: 'bestand', controle: 'schild', opnieuw: 'vernieuwen' } as const;
const ik = (n: keyof typeof ICOON) => ikoon(ICOON[n]);
const REST_ICOON: (keyof typeof ICOON)[] = ['maken', 'bewerken', 'kenmerk', 'controle'];
/* Drie van de telefoonfoto's die ook in de laptop staan (laptopSlides.js): wat
   een klant echt instuurt, geen voorbeeld dat er beter uitziet. */
const JIJ_FOTOS = ['/img/ba2-voor-front.webp', '/img/ba2-voor-achter.webp', '/img/ba2-voor-detail.webp'];
/* "Goedkeuren, revisies, levertijd, rechten." — de zin en de belletjes op de
   FAQ-kaart komen uit dezelfde lijst, dus ze kunnen niet uit elkaar lopen. */
const [faqTitel, faqOnderwerpen] = c.faq as [string, string[]];
/* De AI-markering op de AI Act-kaart: de waarde die écht in elk bestand komt
   (src/lib/iptc.js, LEVERTAG), met wat die zegt in gewone woorden. */
const IPTC_WAARDE = tagNaam(LEVERTAG);
const IPTC_WOORD = TAG_WOORD[LEVERTAG][lang];
---
<div class="h-pagina h-voor">

  {/* ── 01 · DE OPENING EN HOE HET WERKT — 25 oktober 2026 ──────────────────────
      Lucas: *"Ik wil de begin sectie pagina een andere indeling geven zoals het
      bijgevoegde voorbeeld"*, met zijn video als scrollanimatie, en daarna "Hoe het
      werkt" in hetzelfde scherm, per dienst te kiezen. Alles in HalOpening.astro (het
      waarom staat daar). Wat hier stond: de opening met de laptopfoto (HalLaptop, nu nog
      op /catalog, /lifestyle en /video). De drie stappen staan nu in Hoe het werkt, als
      drie inktblokken onder de tabs (Lucas, 14:39). De band "Wij doen de rest" is
      vervallen: blok 02 en de uitlegzin zeggen het al, en in één scherm past hij niet. De
      knoppen en de feiten staan onder de blokken (vraag 1a: in het eerste scherm alleen de
      kop en één zin). Het wisselwoord in de kop staat stil: één beweging in de kop (het
      ademende accentwoord) is genoeg. */}
  {/* ── DE OPENING: DE ZWARTE TABLET — levering 78 (lijst 61 en 62, Lucas 16:03 en 16:50) ──────
      Het enige scrolleffect van de pagina (HalTablet.astro): de foto uit het winkelscherm vliegt
      naar de foto van Wat we maken, daarna scrolt de pagina gewoon. */}
  <HalTablet lang={lang} kop={kop} lede={c.lede} />

  {/* ── WAT WE MAKEN — levering 78 (Lucas, 16:50) ────────────────────────────────
      Sectie A (docs/RUIMTE-EN-RUST.md): het beeld links over 6 kolommen, één kolom lucht, de tekst rechts in het
      optische midden van het beeld (R2), de kop hangt een stap S buiten de rest (R1). Hier landt de
      foto uit de tablet (data-t-doel, HalTablet.astro). Geen label en geen nummer meer. De kop zegt
      niet meer "drie soorten": wat er verder is, staat eronder als "Ook voor jouw merk". */}
  <section class="h-sec h-maken v-maken t-na" id="maken" aria-labelledby="h-maken" data-h-pv>
    <div class="h-pv-beeld v-maken-beeld" data-h-pv-vak data-t-doel>
      {c.diensten.map((_d, i) => (
        <figure class:list={['h-pv-laag', `h-pv-${DIENSTEN_HOE[i]}`, i === 0 && 'is-nu']} data-h-pv-laag={i} style={i === 0 ? `--grond:${GROND}` : undefined}>
          {i === 0 && <img src={GELEVERD[0].src} width={GELEVERD[0].w} height={GELEVERD[0].h} alt={GELEVERD[0].alt} decoding="async" />}
          {i === 1 && <img src="/img/hal/sfeer-4x5.webp" width="921" height="1152" alt={c.dienstAlt[1]} loading="lazy" decoding="async" />}
          {i === 2 && <span class="h-pv-klip"><img src="/img/hal/sfeer-bewogen.webp" width="1600" height="900" alt={c.dienstAlt[2]} loading="lazy" decoding="async" /><span class="h-cirkel h-cirkel-glas h-speel" aria-hidden="true" set:html={ik('speel')} /></span>}
        </figure>
      ))}
      <span class="h-pv-mes" data-h-pv-mes aria-hidden="true" hidden></span>
    </div>
    <div class="v-maken-tekst v-kopgroep">
      <h2 id="h-maken" class="h-kop h-h2 v-kop">{c.makenKop[0]} <span class="l">{c.makenKop[1]}</span></h2>
      <div class="h-pv-rest v-na-kop">
        <div class="h-pv-keus" role="group" aria-label={c.kiesSoort}>
          {c.diensten.map(([naam], i) => <button type="button" data-h-pv-kies={i} aria-pressed={i === 0 ? 'true' : 'false'}>{naam}</button>)}
        </div>
        {c.diensten.map(([, prijs, href, , knop], i) => (
          <div class="h-pv-per" data-h-pv-per={i} hidden={i !== 0}>
            <p class="h-pv-prijs">{prijs}</p>
            <p class="h-acties"><a class="h-knop h-knop-inkt" href={lp(href)}>{knop}<span class="o" set:html={ik('pijl')} /></a></p>
          </div>
        ))}
        <p class="h-onderregel">{c.eenProduct}</p>
      </div>
      <div class="v-ook v-na-kop">
        <p class="v-ook-kop">{c.ookKop}</p>
        <ul class="v-ook-rij" role="list">
          {c.ook.map(([naam, href]: string[]) => <li><a href={lp(href)}>{naam}<span class="o" aria-hidden="true" set:html={ik('pijl')} /></a></li>)}
        </ul>
        <p class="v-ook-anders">{c.ookAnders[0]} <a class="h-link" href={lp(c.ookAnders[2])}>{c.ookAnders[1]}</a></p>
      </div>
    </div>
  </section>

  {/* ── HOE HET WERKT — levering 78: een gewone sectie na Wat we maken (lijst 61, v61-volgorde a) ── */}
  <HalHoe lang={lang} hoeKop={c.hoeKop as [string, string]} uitleg={uitleg}>
    {/* De drie stappen van vroeger (Lucas, 14:39), in drie witte kaarten (16:28: "De donkere
        achtergrond maakt het ook wat heftiger dan dat het zou moeten dus deze mag wit zijn").
        Per dienst een eigen verhaal (data-v): catalog stuurt, wij maken (de lagen uit elkaar),
        keurt goed; lifestyle en video kiezen een look, uploaden, ontvangen (16:28). */}
    <ol class="h-stappen" role="list" data-uitleg-zicht slot="stappen">
      {c.stappen.map(([naam, regel, bij], i) => (
        <li class="h-stap h-in" style={`--d:${i}`}>
          <p class="h-nr" aria-hidden="true"><b>{DRIE(i + 1)}</b><i></i><span>/{DRIE(c.stappen.length)}</span></p>
          {/* per dienst een eigen naam; opening.css laat er één zien (data-v). De regel eronder is weg
              (16:56: "De teksten mogen weg onder de stappen … ik ga echt voor een minimale visuele
              uitleg"). */}
          <h3 class="h-stap-naam">{DIENSTEN_HOE.map((d) => <span data-v={d}>{STAP_TEKST[d][i][0]}</span>)}</h3>
          <div class="h-stap-beeld">
            {/* STAP 3: GOEDKEUREN. Hier stonden drie vormen (1:1, 4:5, 9:16) van
                 één catalogbeeld, en dat las als "je krijgt alle drie" — dezelfde
                 fout die ronde 8 al uit voorbeeldset.js haalde: de klant kiest
                 één formaat per bestelling (ratios.js), en 9:16 bestaat voor
                 catalog niet eens. Nu de set die een proef oplevert (voorkant,
                 achterkant, detail, draagfoto), elk beeld met een eigen vinkje,
                 zoals de stap zegt: per beeld goedkeuren. */}
            {/* AFVINKLIJST 24 (14 oktober 2026). Lucas: *"De foto's kunnen iets logischer op
                 elkaar aansluiten en de middelste foto bij 'Wij maken' mag … echt een soort
                 proces (een soort van digitaal handmatig zoals we ook echt doen) … Het geeft
                 nu het gevoel dat het een AI tool is en dit is het ZEKER NIET."* Dus één
                 product door alle drie de stappen (de roze jeans, voorbeeldset.js), en in
                 stap 2 de lagen waaruit een catalogbeeld bestaat: uitgeknipt, de achtergrond
                 eronder, de schaduw erbij — met elke laag in het lijstje rechtsboven. */}
            {i === 0 ? (
              <>
              <figure class="h-well h-stuur" data-v="catalog">
                <ul class="h-stuur-rij" role="list">
                  {ingestuurd(lang).slice(0, REQUIRED_SHOT_IDS.length).map((b, k) => (
                    <li style={`--d:${k}`}><img src={b.src} width={b.w} height={b.h} alt={b.alt} loading="lazy" decoding="async" /></li>
                  ))}
                </ul>
                {/* AFVINKLIJST 29 (v29-stap1 = a): een lijstje zoals in stap 2. Per
                    verplichte foto een vinkje zodra hij binnen is, en dan "Compleet" —
                    wat het formulier ook doet: het kijkt of voorkant, achterkant en
                    detail er zijn. */}
                <span class="h-stuur-lijst h-glas" aria-hidden="true">
                  {REQUIRED_SHOT_IDS.map((id: string, k: number) => (
                    <span class="h-stuur-v" style={`--d:${k}`}><i set:html={ik('check')} />{SHOTS.find((x: any) => x.id === id)!.name[lang]}</span>
                  ))}
                  <b class="h-stuur-compleet">{c.compleet}</b>
                </span>
                <figcaption class="h-chip h-glas">{bij}</figcaption>
              </figure>
              {/* LIFESTYLE · KIES JE LOOK (Lucas, 16:28: "Klant kiest eerst de style die hij wilt of
                  zelf een style laat ontwerpen door ons"). Drie looks uit de collectie en de eigen
                  look; Flash wordt gekozen, en Flash komt in stap 3 terug. */}
              <figure class="h-well o-kies" data-v="lifestyle">
                <ul class="o-kies-rij" role="list">
                  {KIES_LOOKS.map((l, k) => (
                    <li class:list={[l.gekozen && 'is-gekozen']} style={`--d:${k}`}>
                      <span class="o-kies-beeld">{l.beeld ? <img src={l.beeld} width="380" height="680" alt="" loading="lazy" decoding="async" /> : <i aria-hidden="true">+</i>}</span>
                      <b>{l.naam}</b>
                      {l.gekozen && <span class="o-kies-vink" aria-hidden="true" set:html={ik('check')} />}
                    </li>
                  ))}
                </ul>
                <figcaption class="h-chip h-glas">{c.lookGekozen}</figcaption>
              </figure>
              {/* VIDEO · KIES JE STIJL: de stijlen uit videoStyles, Motion gekozen; de voorbeelden
                  volgen (Lucas: "deze content nog niet … binnenkort toegevoegd"). */}
              <figure class="h-well o-kies o-kies-lijst" data-v="video">
                <ul class="o-stijl-rij" role="list">
                  {VIDEO_STIJLEN.map((s, k) => (
                    <li class:list={[k === 0 && 'is-gekozen']} style={`--d:${k}`}><b>{s}</b>{k === 0 && <span class="o-kies-vink" aria-hidden="true" set:html={ik('check')} />}</li>
                  ))}
                </ul>
                <figcaption class="o-binnenkort-zin">{c.binnenkort}</figcaption>
              </figure>
              </>
            ) : i === 1 ? (
              <>
              {/* CATALOG · DE LAGEN UIT ELKAAR, IN 3D — 25 oktober 2026, 16:40. Lucas: *"Ik wil dat hij
                  eerst vlak is dan uit elkaar springt en in 3d word weergeven met die lagen en de
                  broek word aangeduid op een manier als 'Gemaakt en bewerkt door middel van ai en
                  nauwkeurig gecontroleerd op of alle details kloppen' … en dan weer in elkaar word
                  gezogen en vlak is en door gaat naar de andere stap."* En om 16:57: geen labels
                  "met de hand" ("voelt veel te verdedigend"), alleen kort een zachte gloed om het
                  product met "Gemaakt met AI". Aan het eind van stap 2 ligt deze figuur precies over
                  het geleverde beeld (de grond, de schaduw, de uitgeknipte broek), kantelt open,
                  zweeft even, en klapt weer dicht (opening.css, "de lagen in 3D"). Zonder uitleg en
                  bij minder beweging staat hij open. */}
              {/* levering 75: in de opening is dit het enige beeld van stap 2 bij catalog (het handwerk
                  ervoor staat er niet meer, opening.css), dus hij draagt nu de beschrijving, met
                  "Gemaakt met AI" erbij (dat staat in het beeld, maar niet voor een schermlezer) */}
              <figure class="h-well o-ontleed" data-v="catalog" role="img" aria-label={`${c.stapAlt[1]}. ${c.gemaaktMetAI}.`}>
                <span class="o-ont-ruimte">
                  <span class="o-ont-stapel">
                    {ONT_LAGEN.map((l, k) => k).reverse().map((k) => {
                      const l = ONT_LAGEN[k];
                      return (
                        <span class:list={['o-ont-laag', `o-ont-${l.soort}`, k === 0 && 'is-gekozen']} style={`--i:${k}`}>
                          {l.src && <img src={l.src} width="760" height="760" alt="" loading="lazy" decoding="async" class:list={[l.soort === 'schaduw' && 'o-ont-donker']} />}
                        </span>
                      );
                    })}
                  </span>
                </span>
                <span class="o-ont-ai">{c.gemaaktMetAI}</span>
              </figure>
              {/* LIFESTYLE EN VIDEO · UPLOAD JE FOTO'S (16:28: "Hou dit gewoon 'upload de foto's van je
                  product'"). De verplichte foto's (shots.js) als bestanden, zonder beeld: zo past het
                  bij elk product, ook bij de look die in stap 3 terugkomt. */}
              <figure class="h-well o-upload" data-v="lifestyle video">
                <ul class="o-upload-rij h-glas" role="list">
                  {REQUIRED_SHOT_IDS.map((id: string, k: number) => (
                    <li style={`--d:${k}`}><i class="o-upload-ik" aria-hidden="true" set:html={ik('kenmerk')} /><b>{SHOTS.find((x: any) => x.id === id)!.name[lang]}</b><span class="o-upload-balk" aria-hidden="true"><s></s></span><i class="o-upload-vink" aria-hidden="true" set:html={ik('check')} /></li>
                  ))}
                  <li class="o-upload-klaar">{c.compleet}</li>
                </ul>
              </figure>
              </>
            ) : (
              <>
              <figure class="h-well h-keur o-fmt-vak" data-v="catalog" style={fmtStijl('catalog')}>
                <ul class="h-keur-rij" role="list">
                  {/* Voorkant en achterkant staan op wit en blijven heel (h-heel:
                      passend in het vak); het detail en de draagfoto vullen hun vak. */}
                  {/* ALLEEN GOEDKEUREN — Lucas, 15 oktober 2026, 20:42: "Het revisie
                      gedeelte hoeft daar niet, alleen laten zien dat de klant de beelden
                      simpelweg goedkeurde." (Dat verving v29-stap3 = a.) Vier beelden, vier
                      tikken, in het tempo van iemand die elk beeld even bekijkt: niet
                      gelijk verdeeld, want zo keurt niemand. `--kt` is het moment van het
                      vinkje vanaf het begin van stap 3 (zie hal.css). */}
                  {geleverd(lang).map((b, k) => (
                    <li class:list={[k < 2 && 'h-heel']} style={`--d:${k};--kt:${KEUR_TIK[k]}s`}><img src={b.src} width={b.w} height={b.h} alt="" loading="lazy" decoding="async" /><span class="h-vink" aria-hidden="true" set:html={ik('check')} /></li>
                  ))}
                </ul>
                <figcaption class="h-chip h-glas">{c.goedgekeurd(geleverd(lang).length)}<span class="sr-only"> {c.inFormaat(FMT.catalog.lijst.map((x: any) => x.label))}</span></figcaption>
                <span class="o-fmt h-glas" aria-hidden="true">{FMT.catalog.lijst.map((x: any, k: number) => <b class:list={[k === FMT.catalog.begin && 'is-begin', k === FMT.catalog.eind && 'is-eind']}>{x.label}</b>)}</span>
              </figure>
              {/* LIFESTYLE · ONTVANG JE BEELDEN: vier beelden in de look van stap 1 (Flash). */}
              <figure class="h-well h-keur o-fmt-vak" data-v="lifestyle" style={fmtStijl('lifestyle')}>
                <ul class="h-keur-rij" role="list">
                  {LIFESTYLE_SET.map((b, k) => (
                    <li style={`--d:${k};--kt:${KEUR_TIK[k]}s`}><img src={b.src} width={b.w} height={b.h} alt="" loading="lazy" decoding="async" /><span class="h-vink" aria-hidden="true" set:html={ik('check')} /></li>
                  ))}
                </ul>
                <figcaption class="h-chip h-glas">{c.inDeLook(LIFESTYLE_SET.length, FLASH.name)}<span class="sr-only"> {c.inFormaat(FMT.lifestyle.lijst.map((x: any) => x.label))}</span></figcaption>
                <span class="o-fmt h-glas" aria-hidden="true">{FMT.lifestyle.lijst.map((x: any, k: number) => <b class:list={[k === FMT.lifestyle.begin && 'is-begin', k === FMT.lifestyle.eind && 'is-eind']}>{x.label}</b>)}</span>
              </figure>
              {/* VIDEO · ONTVANG JE CLIP: de plek voor een verticale clip; de voorbeelden volgen. */}
              <figure class="h-well o-binnenkort" data-v="video">
                <span class="o-klip-plek" aria-hidden="true"><i set:html={ik('speel')} /></span>
                <figcaption class="o-binnenkort-zin">{c.binnenkortKlip}</figcaption>
              </figure>
              </>
            )}
          </div>
          {i < 2 && <span class="h-brug" aria-hidden="true" set:html={ik('rechts')} />}
        </li>
      ))}
    </ol>
    {uitleg && <UitlegBalk slot="balk" zinnen={c.uitlegZinnen} lang={lang} varianten={DIENSTEN_HOE.map((d) => ({ v: d, zinnen: UITLEG_ZINNEN[d] }))} />}
    <Fragment slot="acties">
      <p class="h-acties">
        <a class="h-knop h-knop-inkt" href={lp('/start')} {...startKnop(lang)}><span data-vis-label>{c.ctaStart}</span><span class="o" set:html={ik('rechts')} /></a>
        <a class="h-knop h-knop-lijn" href={lp('/test-sample')} data-vis-uit>{sample.cta}</a>
        <a class="h-knop h-knop-lijn" href={lp('/start/plan')} {...planKnop(lang, lp)}><span data-vis-label>{c.planCta}</span></a>
      </p>
      <ul class="h-feiten" role="list">
        {c.feiten.map((f, i) => <li><i set:html={ik((['label', 'klok', 'doos'] as const)[i])} /><span set:html={f} /></li>)}
      </ul>
    </Fragment>
  </HalHoe>

  {/* Formaten (FormatenHal) stond hier als eigen sectie; sinds levering 76 klein in stap 3 van Hoe
      het werkt (Lucas, 26 oktober, 12:29: "De format sectie mag wel subtiel/klein toegevoegd worden
      aan how it works animatie om de homepage wat kleiner en compacter te houden"). */}

  {/* ── 03 · WAT WE MAKEN ────────────────────────────────────────────────────
      Drie beelden: het middelste recht en vooraan, de zijkanten gedraaid. Komt
      de sectie in beeld, dan vouwen ze open (60° → 46°). De pijlen draaien de
      rij één plek. Zonder JavaScript: drie beelden naast elkaar, en op een
      telefoon een rij om opzij te vegen. */}
  {/* ── 03 · WAT WE MAKEN — 15 oktober 2026 (v28-maken = a) ───────────────────
      Lucas, 05:21: de sectie paste niet bij de rest van de site. Het waren drie
      schuine kaarten die in 3D draaiden (60° naar 46°), de enige plek op de site
      die zo bewoog, met de prijs klein in de gedraaide kaart. Nu drie platte
      kaarten in de stijl van /start: beeld (4:3), naam, één zin, "vanaf" en een
      knop. Op een telefoon een veegrij. */}
  {/* 25 oktober 2026, 16:56. Lucas: "De teksten mogen weg onder de stappen … ik ga echt voor een
      minimale visuele uitleg dus dit soort onnodige tekst, ook op andere plekken op de homepage
      kunnen weg." Weg op de voorpagina: de zin in elke kaart hier (de zinnen staan nog in
      COPY.diensten), de zinnen onder Veelgestelde vragen en AI en de AI Act, de lange zin bij
      de shootdag (nu "per shootdag, alles meegerekend") en de tekst links van Formaten
      (FormatenHal kaal). De regel over één product blijft: zonder hem lijkt "vanaf €39" de prijs
      van één product. */}
  {/* Levering 76, 13:00. Lucas: "de editorial rust in de foto op het computerscherm wil ik op elke
      sectie terug zien". Het scherm in de opening toont een productpagina: één groot beeld op
      lichtgrijs, ernaast een smalle kolom met de naam, de prijs, de maten als knopjes, één inktknop
      en een kleine regel. Zo staat Wat we maken nu ook (het productvel, voorpagina-rust.css): de
      drie soorten zijn de knopjes; het beeld, de prijs en de knop wisselen mee. Was: drie gelijke
      kaarten. Zonder JavaScript staan productfoto's er, met hun link; de knopjes doen dan niets,
      het menu bovenin heeft alle drie. */}
  {/* Wat we maken staat sinds levering 78 direct na de opening (hierboven). */}

  {/* ── 04 · LOOKS EN HET GEZICHT ──────────────────────────────────────────── */}
  {/* Levering 76. Eerst (10:52) één paneel zoals de laptop in de opening: links de look groot,
      rechts de naam, de proef en de vijf looks als kleine beelden om te kiezen (uit zijn voorbeeld
      "Complete o look"); wisselen gaat met de snede van de opening (het nieuwe beeld komt langs 53°
      over het oude). Daarna (13:00) ook een productvel: zonder kader, het beeld rechts (om en om
      met Wat we maken), de naam bovenaan in de kolom, en de gezichten als de kleurbolletjes van
      een productpagina in de kolom (was een losse rij eronder). Niets beweegt vanzelf. Zonder
      JavaScript staat de eerste look er, met de link ernaar. */}
  {/* levering 78: sectie A omgekeerd (docs/RUIMTE-EN-RUST.md): de tekst links in het optische midden
      van het beeld (R2), het beeld rechts op een vlak dat aan de buitenkant een stap doorsteekt (R3).
      Geen label meer. */}
  <section class="h-sec h-looks h-lp v-looks" aria-labelledby="h-looks" data-h-lp>
    <div class="v-looks-tekst v-kopgroep">
      <h2 id="h-looks" class="h-kop h-h2 v-kop">{c.looksKop[0]} <span class="l">{c.looksKop[1]}</span></h2>
    <div class="h-lp-info v-na-kop">
        <p class="h-lp-boven"><span class="h-pil h-pil-nr h-lp-soort" data-h-lp-soort>{LOOKS[0]?.soort}</span><span class="h-lp-van" data-h-lp-van data-vorm={c.lookVan('{n}', LOOKS.length)} aria-live="polite">{c.lookVan(1, LOOKS.length)}</span></p>
        {/* Per look de naam en de proefknop, één tegelijk zichtbaar: zo staat elke proef in de HTML
            (ook zonder script te bereiken) en wisselt het script alleen welke er staat. De klantstand
            (interactions.js) zet "hidden" op de knoppen zelf, het script op het omhulsel. */}
        {LOOKS.map((k, i) => <p class="h-lp-naam" data-h-lp-per={i} hidden={i !== 0}>{k.naam}</p>)}
        <ul class="h-lp-keus" role="list" aria-label={c.kiesLook}>
          {LOOKS.map((k, i) => (
            <li><button type="button" class="h-lp-mini" data-h-lp-kies={i} aria-pressed={i === 0 ? 'true' : 'false'}
                        data-naam={k.naam} data-soort={k.soort} data-beeld={k.beeld} data-href={k.href}>
              <img src={k.beeld} sizes="(max-width: 900px) 125vw, 560px" alt="" width="800" height="1000" loading="lazy" decoding="async" /><span class="sr-only">{k.naam} · {k.soort}</span>
            </button></li>
          ))}
        </ul>
        <div class="h-gezicht">
          <span class="h-koppen">
            {GEZICHTEN_RIJ.map((m: any) => <a href={`${lp('/models')}#${modelId(m.name)}`} aria-label={m.name}><img src={m.thumb} width={m.tw} height={m.th} alt="" loading="lazy" decoding="async" /></a>)}
          </span>
          <p class="h-gezicht-zin"><b>{c.gezicht[0]}</b> {c.gezicht[1]} <a href={lp('/models')}>{c.alleGezichten}</a></p>
        </div>
        {LOOKS.map((k, i) => (
          <p class="h-acties h-lp-acties" data-h-lp-per={i} hidden={i !== 0}>
            <a class="h-knop h-knop-inkt" href={k.proef} data-vis-uit>{c.probeer}<span class="o" set:html={ik('pijl')} /></a>
            <a class="h-knop h-knop-inkt" href={k.bestel} data-vis-klant-in hidden>{c.bestelLook}<span class="o" set:html={ik('pijl')} /></a>
            <a class="h-link h-lp-meer" href={k.href}>{c.bekijkLook}</a>
          </p>
        ))}
      </div>
    </div>
    <div class="v-looks-beeld">
    <a class="h-lp-podium v-looks-podium" href={LOOKS[0]?.href} data-h-lp-link data-bekijk={c.bekijkLook} aria-label={`${c.bekijkLook}: ${LOOKS[0]?.naam}`}>
        <img class="h-lp-nu" data-h-lp-nu src={LOOKS[0]?.beeld} sizes="(max-width: 900px) 125vw, 560px" alt="" width="800" height="1000" loading="lazy" decoding="async" />
        <img class="h-lp-nieuw" data-h-lp-nieuw alt="" width="800" height="1000" decoding="async" hidden />
        <span class="h-lp-mes" data-h-lp-mes aria-hidden="true" hidden></span>
      </a>
    </div>
  </section>

  {/* ── 05 · MEER WETEN ──────────────────────────────────────────────────── */}
  {/* Levering 76 (13:00): geen kaarten meer, maar de regels onder de knop van een productpagina:
      links de kop groot (het ene grote element van deze sectie), rechts drie regels met een
      haarlijn. Bewust geen foto: een gezicht naast "Nog vragen?" leest als een medewerker die er
      niet is. Was (10:52): drie gelijke kaarten met een grijs vlak. */}
  {/* levering 78: sectie C, een kop en een lijst, zonder beeld en zonder label */}
  <section class="h-sec h-weten v-weten" aria-labelledby="h-weten">
    <h2 id="h-weten" class="h-kop h-h2 v-kop v-weten-kop"><span class="l">{c.wetenKop[0]}</span> {c.wetenKop[1]}</h2>
    <ul class="h-wt-rijen v-weten-rijen" role="list">
      <li>
        <a href={lp('/compare')}>
          <b>{c.shootLabel}</b>
          <span class="h-wt-detail"><span class="h-wt-getal">{SHOOT_DAY[lang].range}</span> {c.shootZin}</span>
          <span class="h-cirkel h-cirkel-klein" aria-hidden="true" set:html={ik('pijl')} />
        </a>
      </li>
      <li>
        <a href={lp('/faq')}>
          <b>{faqTitel}</b>
          <span class="h-wt-detail">{faqOnderwerpen.join(' · ')}</span>
          <span class="h-cirkel h-cirkel-klein" aria-hidden="true" set:html={ik('pijl')} />
        </a>
      </li>
      <li>
        <a href={lp('/ai-act')}>
          <b>{c.aiact[0]}</b>
          <span class="h-wt-detail"><i>IPTC</i>{IPTC_WAARDE}</span>
          <span class="h-cirkel h-cirkel-klein" aria-hidden="true" set:html={ik('pijl')} />
        </a>
      </li>
    </ul>
  </section>

  {/* ── 05b · AANBEVELINGEN (G3, 8 oktober 2026) ─────────────────────────────
      Lucas: *"Graag wel bouwen maar onzichtbaar houden tot ik er 1 echt accepteer
      en erin zet."* Zolang er geen enkele gepubliceerd is, rendert dit letterlijk
      niets (Aanbevelingen.astro). Op de oude voorpagina stond hij op dezelfde
      plek: vlak voor de proef. huid="hal": de kop als de andere hal-secties. */}
  <Aanbevelingen lang={lang} huid="hal" />

  {/* ── 06 · HET SLOTBEELD: €1 ──────────────────────────────────────────────
      Het enige donkere vlak (d-donker): diep violet met korrel, de reuzen-€1 in
      Urbanist 300. De vier beelden zijn wat de proef oplevert. */}
  {/* Sinds 14 oktober 2026 hetzelfde slotbeeld als op de andere pagina's
      (HalProef.astro), want daar staat de versie voor een klant die al
      bestelde: zijn eigen look en zijn eigen beelden, geen €1 (v26-proefblok a). */}
  <HalProef lang={lang} id="h-proef" label={c.proefLabel} kop={c.proefKop} zin={c.proefZin} alt={{ label: c.proefAlt, href: '/start' }} />

  <ul class="h-vertrouwen" role="list">
    {c.vertrouwen.map((t, i) => <li style={`--d:${i}`}><i set:html={ik('check')} />{Array.isArray(t) ? <a href={lp(t[1])}>{t[0]}</a> : t}</li>)}
  </ul>
</div>

<script>
  import { slaOmIn } from '../scripts/omslag.js';
  import { knoppenNaastElkaar } from '../scripts/knoppaar.js';
  import { gloed, stopGloed } from '../scripts/gloed.js';
  /* ── BEWEGING OP HET VOORBEELD — 12 oktober 2026 ───────────────────────────
     Drie dingen, allemaal zonder luisteraar op window (tests/zachte-navigatie):
     1. BINNENKOMEN: elk .h-in krijgt .is-in zodra het voor een vijfde in beeld
        is, één keer. De beweging zelf (16 px omhoog, zichtbaar worden, met een
        kleine vertraging per kaart) staat in hal.css. Zonder JavaScript, of bij
        "minder beweging", staat alles er meteen (hal.css zet .h-in pas op
        onzichtbaar als <html> de klasse h-js heeft).
     2. DE DRIE DIENSTEN: in beeld vouwen de zijkanten open; de pijlen draaien de
        rij één plek (de klassen links/midden/rechts schuiven door).
     3. DE LOOKS: de pijlen schuiven de strook een kaart verder, en het lijntje
        boven de pijlen laat zien hoe ver je bent. */
  const zet = () => {
    const html = document.documentElement;
    html.classList.add('h-js');
    const rustig = matchMedia('(prefers-reduced-motion: reduce)').matches;
    knoppenNaastElkaar();
    gloed();   // levering 78: af en toe de gloed op de tweede toon van een kop

    const io = new IntersectionObserver((rijen) => {
      for (const r of rijen) if (r.isIntersecting) {
        /* levering 55: de hoogte voor de helling van de wis, en de getallen slaan om */
        (r.target as HTMLElement).style.setProperty('--h-hoog', `${Math.round(r.boundingClientRect.height)}px`);
        r.target.classList.add('is-in');
        slaOmIn(r.target as HTMLElement);
        io.unobserve(r.target);
      }
    }, { threshold: 0.2, rootMargin: '0px 0px -6% 0px' });
    for (const el of document.querySelectorAll('.h-pagina .h-in:not(.is-in)')) {
      if (rustig) el.classList.add('is-in'); else io.observe(el);
    }

    for (const st of document.querySelectorAll<HTMLElement>('[data-h-strook]')) {
      if (st.dataset.hKlaar) continue;
      st.dataset.hKlaar = '1';
      const rij = st.querySelector<HTMLElement>('[data-h-strook-rij]');
      const stand = st.querySelector<HTMLElement>('[data-h-strook-stand]');
      if (!rij) continue;
      const meet = () => {
        const max = rij.scrollWidth - rij.clientWidth;
        const deel = max > 0 ? rij.scrollLeft / max : 0;
        const zicht = rij.scrollWidth > 0 ? rij.clientWidth / rij.scrollWidth : 1;
        stand?.style.setProperty('--w', String(Math.max(0.12, Math.min(1, zicht))));
        stand?.style.setProperty('--x', String(deel));
      };
      rij.addEventListener('scroll', meet, { passive: true });
      new ResizeObserver(meet).observe(rij);
      for (const b of st.querySelectorAll<HTMLButtonElement>('[data-h-strook-stap]')) {
        b.addEventListener('click', () => {
          const kaart = rij.querySelector<HTMLElement>('.h-look');
          const stap = kaart ? kaart.offsetWidth + 16 : rij.clientWidth * 0.8;
          rij.scrollBy({ left: stap * Number(b.dataset.hStrookStap), behavior: rustig ? 'auto' : 'smooth' });
        });
      }
    }

    /* 4. HET LOOKPANEEL (levering 76). Een klik op een klein beeld of een pijl kiest een look:
       de naam, de soort, de teller en de links wisselen meteen; het grote beeld komt langs de
       snede van de opening (53°, horizontaal 0,75 × de hoogte) over het oude, met een witte kier
       op de snijrand. 0,56 s, één keer per klik; bij minder beweging meteen. */
    for (const lp of document.querySelectorAll<HTMLElement>('[data-h-lp]')) {
      if (lp.dataset.hKlaar) continue;
      lp.dataset.hKlaar = '1';
      const q = <T extends Element = HTMLElement>(s: string) => lp.querySelector<T>(s);
      const keus = [...lp.querySelectorAll<HTMLButtonElement>('[data-h-lp-kies]')];
      const podium = q<HTMLAnchorElement>('[data-h-lp-link]'), nu = q<HTMLImageElement>('[data-h-lp-nu]'), nieuw = q<HTMLImageElement>('[data-h-lp-nieuw]');
      const mes = q('[data-h-lp-mes]'), soort = q('[data-h-lp-soort]'), van = q('[data-h-lp-van]'), nr = q('[data-h-lp-nr]');
      const per = [...lp.querySelectorAll<HTMLElement>('[data-h-lp-per]')];
      if (keus.length < 2 || !podium || !nu || !nieuw || !mes || !soort || !van) continue;
      const vorm = van.dataset.vorm || '{n}', bekijk = podium.dataset.bekijk || '';
      /* De bouwstap (scripts/avif-naast-webp.mjs) zet elke <img> in een <picture> met een AVIF-bron;
         die wint van img.src. Voor het wisselen gaat de bron eruit, met het beeld dat er al stond. */
      const los = (img: HTMLImageElement) => {
        const pic = img.parentElement;
        if (pic?.tagName !== 'PICTURE' || !pic.querySelector('source')) return;
        const was = img.currentSrc || img.src;
        pic.querySelectorAll('source').forEach((s) => s.remove());
        img.removeAttribute('srcset'); img.removeAttribute('sizes');
        if (was) img.src = was;
      };
      /* het beeld dat het kleine knopje al heeft (AVIF of webp, wat de browser koos) */
      const bron = (j: number) => keus[j].querySelector('img')?.currentSrc || keus[j].dataset.beeld || '';
      let k = 0, bezig = false, wacht: number | null = null;
      const tekst = (j: number) => {
        const d = keus[j].dataset;
        soort.textContent = d.soort || '';
        van.textContent = vorm.replace('{n}', String(j + 1));
        if (nr) nr.textContent = String(j + 1).padStart(2, '0');
        podium.href = d.href || podium.href; podium.setAttribute('aria-label', `${bekijk}: ${d.naam || ''}`);
        per.forEach((x) => { x.hidden = Number(x.dataset.hLpPer) !== j; });
        keus.forEach((x, i) => x.setAttribute('aria-pressed', String(i === j)));
      };
      const ga = async (j: number) => {
        j = (j + keus.length) % keus.length;
        if (bezig) { wacht = j; return; }
        if (j === k) return;
        k = j; tekst(j); los(nu); los(nieuw);
        const src = bron(j);
        if (matchMedia('(prefers-reduced-motion: reduce)').matches || typeof nieuw.animate !== 'function') { nu.src = src; return; }
        bezig = true;
        nieuw.src = src;
        try { await nieuw.decode(); } catch { /* dan zonder te wachten */ }
        const W = podium.clientWidth, H = podium.clientHeight, T = 0.75 * H, kier = Math.max(4, Math.round(H * 0.012));
        const vorm1 = (c: number) => `polygon(-2px -2px, ${(c + T).toFixed(1)}px -2px, ${c.toFixed(1)}px ${H + 2}px, -2px ${H + 2}px)`;
        nieuw.style.clipPath = vorm1(-T - kier - 2); nieuw.hidden = false;
        mes.style.width = `${T + kier}px`; mes.style.setProperty('--kier', `${kier}px`); mes.hidden = false;
        const opties = { duration: 560, easing: 'cubic-bezier(.65, 0, .25, 1)', fill: 'forwards' as FillMode };
        const a = nieuw.animate([{ clipPath: vorm1(-T - kier - 2) }, { clipPath: vorm1(W + 2) }], opties);
        const b = mes.animate([{ transform: `translateX(${-T - kier - 2}px)` }, { transform: `translateX(${W + 2}px)` }], opties);
        await a.finished.catch(() => {});
        nu.src = src;
        try { await nu.decode(); } catch { /* prima */ }
        nieuw.hidden = true; mes.hidden = true; a.cancel(); b.cancel(); nieuw.style.clipPath = '';
        bezig = false;
        if (wacht !== null) { const w = wacht; wacht = null; ga(w); }
      };
      keus.forEach((x, i) => x.addEventListener('click', () => ga(i)));
      for (const b of lp.querySelectorAll<HTMLButtonElement>('[data-h-lp-stap]')) b.addEventListener('click', () => ga((wacht ?? k) + Number(b.dataset.hLpStap)));
    }

    /* 5. WAT WE MAKEN ALS PRODUCTVEL (levering 76, 13:00). De drie soorten zijn knopjes, zoals de
       maten op een productpagina: de prijs en de knop wisselen meteen; het grote beeld komt langs
       dezelfde snede als bij de looks (53°, een witte kier op de snijrand) over het oude. 0,56 s,
       één keer per klik; bij minder beweging meteen. */
    for (const pv of document.querySelectorAll<HTMLElement>('[data-h-pv]')) {
      if (pv.dataset.hKlaar) continue;
      pv.dataset.hKlaar = '1';
      const vak = pv.querySelector<HTMLElement>('[data-h-pv-vak]'), mes = pv.querySelector<HTMLElement>('[data-h-pv-mes]');
      const keus = [...pv.querySelectorAll<HTMLButtonElement>('[data-h-pv-kies]')];
      const lagen = [...pv.querySelectorAll<HTMLElement>('[data-h-pv-laag]')];
      const per = [...pv.querySelectorAll<HTMLElement>('[data-h-pv-per]')];
      if (!vak || !mes || keus.length < 2 || lagen.length !== keus.length) continue;
      let k = 0, bezig = false, wacht: number | null = null;
      const ga = async (j: number) => {
        if (bezig) { wacht = j; return; }
        if (j === k) return;
        const oud = lagen[k], nieuw = lagen[j];
        k = j;
        keus.forEach((x, i) => x.setAttribute('aria-pressed', String(i === j)));
        per.forEach((x) => { x.hidden = Number(x.dataset.hPvPer) !== j; });
        if (matchMedia('(prefers-reduced-motion: reduce)').matches || typeof nieuw.animate !== 'function') {
          oud.classList.remove('is-nu'); nieuw.classList.add('is-nu'); return;
        }
        bezig = true;
        try { await nieuw.querySelector('img')?.decode(); } catch { /* dan zonder te wachten */ }
        const W = vak.clientWidth, H = vak.clientHeight, T = 0.75 * H, kier = Math.max(4, Math.round(H * 0.012));
        const vorm = (c: number) => `polygon(-2px -2px, ${(c + T).toFixed(1)}px -2px, ${c.toFixed(1)}px ${H + 2}px, -2px ${H + 2}px)`;
        nieuw.style.clipPath = vorm(-T - kier - 2); nieuw.classList.add('is-komt');
        mes.style.width = `${T + kier}px`; mes.style.setProperty('--kier', `${kier}px`); mes.hidden = false;
        const opties = { duration: 560, easing: 'cubic-bezier(.65, 0, .25, 1)', fill: 'forwards' as FillMode };
        const a = nieuw.animate([{ clipPath: vorm(-T - kier - 2) }, { clipPath: vorm(W + 2) }], opties);
        const b = mes.animate([{ transform: `translateX(${-T - kier - 2}px)` }, { transform: `translateX(${W + 2}px)` }], opties);
        await a.finished.catch(() => {});
        oud.classList.remove('is-nu'); nieuw.classList.add('is-nu'); nieuw.classList.remove('is-komt');
        a.cancel(); b.cancel(); nieuw.style.clipPath = ''; mes.hidden = true;
        bezig = false;
        if (wacht !== null) { const w = wacht; wacht = null; ga(w); }
      };
      keus.forEach((x, i) => x.addEventListener('click', () => ga(i)));
      /* de opening (HalTablet) zet de soort van zijn scherm meteen, zonder beweging: de foto vliegt
         dan naar dezelfde soort (de sectie is op dat moment nog onzichtbaar) */
      pv.addEventListener('h-pv-zet', (e) => {
        const j = lagen.findIndex((l) => l.classList.contains(`h-pv-${(e as CustomEvent<string>).detail}`));
        if (j < 0 || j === k || bezig) return;
        lagen[k].classList.remove('is-nu'); lagen[j].classList.add('is-nu');
        k = j; wacht = null;
        keus.forEach((x, i) => x.setAttribute('aria-pressed', String(i === j)));
        per.forEach((x) => { x.hidden = Number(x.dataset.hPvPer) !== j; });
      });
    }
  };
  zet();
  document.addEventListener('astro:page-load', zet);
  document.addEventListener('astro:before-swap', stopGloed);
</script>
