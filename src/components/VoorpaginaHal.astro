/* levering 76: de secties na de opening in de stijl van de opening en Hoe het werkt; als laatste,
   na hal.css en opening.css (HalOpening), anders verschuift de volgorde van de stijlbladen */
import '../styles/voorpagina-rust.css';
import '../styles/voorpagina-78.css';
import '../styles/voorpagina-80.css';
/* Levering 75 (Lucas, 25 oktober, 23:35): stap 2 van catalog is alleen nog de lagen in 3D
   ("veel korter en simpeler, wel met de 3 lagen erin"). Het handwerk ervoor (rechtzetten,
   opbouwen, nakijken, de pen; scripts/maak-recht.py en maak-pad.py) staat niet meer op de pagina. */
import { planKnop, startKnop, waKlant, KLANT } from '../data/klant.js';
import { hoeHetWerkt } from '../data/hoeHetWerkt.js';

/* `uitleg` (14 oktober 2026, voorbeeld op /voorbeeld/voorpagina): "Hoe het werkt"
   speelt zich af in drie stappen, en onder die sectie komt het formatenblok. */
const { lang, uitleg = false } = Astro.props as { lang: 'en' | 'nl'; uitleg?: boolean };
const nl = lang === 'nl';
const lp = (p: string) => localizedPath(lang, p);
const sample = TEST_SAMPLE[lang];
const e = (n: number) => euro(n, lang);
const GEZICHTEN = telwoord(ROSTER.length, lang);
const [snel, traag] = levertijdDelen('unattended', lang);
const LEVERTIJD = traag ? `${snel}, ${traag}` : snel;

/* De looks: dezelfde bron als Stijlstrook.astro, zonder "op maat" en zonder de
   binnenkort-kaarten (die gaan naar /lifestyle, plan §01). Elke proefknop houdt
   zijn link: /test-sample?style=<look> (tests/proef-look). */
const lifestyle = nl ? lifestyleNl : lifestyleEn;
const catalog = nl ? catalogNl : catalogEn;
const CATALOG_BEELD: Record<string, string> = { classic: '/img/catalog-after.webp' };
const proef = (slug: string) => `${lp('/test-sample')}?style=${encodeURIComponent(slug)}`;
const LOOKS = [
  ...catalog.filter((s: any) => s.slug !== 'custom').map((s: any) => ({ soort: 'Catalog', naam: s.name, beeld: CATALOG_BEELD[s.slug], href: lp(`/catalog/${s.slug}`), proef: proef(s.slug), bestel: `${lp('/start/catalog')}?style=${encodeURIComponent(s.slug)}` })),
  ...lifestyle.filter((s: any) => s.slug !== 'custom').map((s: any) => ({ soort: 'Lifestyle', naam: s.name, beeld: s.cardPhoto, href: lp(`/lifestyle/${s.slug}`), proef: proef(s.slug), bestel: `${lp('/start/lifestyle')}?style=${encodeURIComponent(s.slug)}` })),
].filter((k) => k.beeld);
const GEZICHTEN_RIJ = ROSTER.slice(0, 5);
/* Levering 76 (13:00): het beeld bij Productfoto's in Wat we maken is de jeans zoals hij geleverd
   wordt (voorbeeldset.js), dezelfde als op het laptopscherm in de opening. */
const GELEVERD = geleverd(lang);

/* De punten van de loep (stap 2). */
const PUNTEN = { nl: ['Knoop', 'Stiksel', 'Kleur'], en: ['Button', 'Seams', 'Colour'] };
const COPY = {
