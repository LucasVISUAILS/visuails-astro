    </header>
    <ul class="h-weten-rij" role="list">
      <li class="h-in h-groot" style="--d:0">
        <a href={lp('/compare')}>
          <span class="h-korrel" aria-hidden="true"></span>
          <span class="h-weten-boven"><span class="h-pil h-pil-wit"><span>{c.shootLabel}</span></span><span class="h-cirkel h-cirkel-wit" aria-hidden="true" set:html={ik('pijl')} /></span>
          <span class="h-weten-onder"><span class="h-getal">{SHOOT_DAY[lang].range}</span><span class="h-weten-zin">{c.shootZin}</span></span>
        </a>
      </li>
      {/* Twee kaarten met een klein, stil beeld erin, zodat ze niet leeg ogen naast
