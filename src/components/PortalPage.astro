---
// VISUAILS — /portal, the public page for the client portal. Section 17.
//
// WHY THIS PAGE EXISTS. A drop is bought partly on what happens after it is
// ordered, and nothing on the site said what that was. OPP gives every part of
// its product a page that shows the screen and explains what you can do on it;
// this is that, for the one screen a client actually gets.
//
// WHAT IT IS CAREFUL NOT TO CLAIM. Two of the capabilities described here are
// real in the portal's code and are NOT yet reachable in production — see
// REPORT-SECTION-15.md flags 15h (nothing can create a kind='delivery' file
// row, so the gallery has nothing to show) and 15i (no notification of any
// kind fires on a status change). So: the delivery gallery and the downloads
// are described in the present tense because the screens exist and a row
// inserted by hand renders them, but NOTHING on this page says a message will
// be sent to you, because none is. The status timeline in the portal is real
// and is what the copy points at instead. If flag 15h is closed before this
// ships, nothing here needs rewriting. If it is not, the two placeholder slots
// are the honest state of it anyway.
import { localizedPath } from '../i18n/ui.js';
import { WINDOW_THRESHOLD, TEST_SAMPLE } from '../data/pricing.js';
/* De 90 dagen in de statusregel hieronder is de levensduur van de privélink, en
   die staat in token.js. Hij stond hier twee keer als tekst — één keer per taal —
   wat betekent dat een wijziging aan de token de pagina stil onwaar maakt. */
import { PORTAL_TTL_DAYS } from '../lib/token.js';
/*
 * TWEE ECHTE FIGUREN, WAAR TWEE GRIJZE VLAKKEN STONDEN — 9 augustus 2026.
 *
 * Lucas: *"deze is nu nog wat saai en inconsistent met de rest van de website. Op
 * de eerste sectie gelijk weer een grote dashboard mock-up laten zien die ook op
 * de homepage staat en bij de image by image sectie ook een eigen unieke mock-up
 * maken voor het specifieke idee."*
 *
 * FigDash is letterlijk dezelfde figuur als op de homepage, en dat is het punt:
 * deze pagina verkoopt hetzelfde scherm, dus hoort er hetzelfde beeld bij. Een
 * tweede tekening van hetzelfde scherm is een tweede versie die kan gaan afwijken.
 *
 * FigGallery is nieuw en staat alleen hier, omdat het over deze ene band gaat:
 * beoordelen per beeld, en waarom de map het eindresultaat is.
 */
import FigDash from './FigDash.astro';
import FigGallery from './FigGallery.astro';
import Note from './Note.astro';
import '../styles/stijl22.css';

interface Props { lang: 'en' | 'nl'; }
const { lang } = Astro.props;
const lp = (p: string) => localizedPath(lang, p);

const COPY = {
  en: {
    h1: ['One link.', 'Your whole order.'],
    lede: `Every order comes with a private link. No account to make, no password to lose. Everything about that order lives behind it: where it stands, the visuals the moment they are finished, and a button on each one to approve it or say what is wrong. From ${WINDOW_THRESHOLD} products up there is a delivery date beside it that we hold for you.`,
    ctaStart: 'Start an order',
    ctaHow: 'How an order is run',

    stateH: 'Where it is, without asking.',
    /* ── ZES DINGEN, MAAR GEEN ZES STATUSSEN — 23 AUGUSTUS 2026 ───────────────
     *
     * Hier stond *"There are six"*, en de kolom heeft er vijf: received,
     * in_production, human_check, delivered, cancelled (schema.sql:103, en
     * dezelfde vijf in portal.js:273 en admin.js:98). "Revision" en "Closed"
     * stonden ertussen alsof ze in datzelfde rijtje zaten.
     *
     * ZE ZIJN WEL ECHT, en dat is waarom ze blijven staan. Ze komen alleen
     * ergens anders vandaan: een revisie is een toestand van één BEELD
     * (files.review_state = 'revision_requested'), en afgesloten is
     * orders.closed_at — het veld waar canReviewOrder() op kijkt. Twee dingen
     * die de klant ziet en die geen orderstatus zijn.
     *
     * Dat verschil is niet cosmetisch. Een klant die "zes statussen" leest en er
     * vijf ziet, denkt dat er iets mist; een klant die leest dat een revisie
     * per beeld loopt, snapt meteen waarom de rest van zijn bestelling ondertussen
     * doorgaat. En "In review" heette hier anders dan in het portaal zelf, waar
     * human_check als "Being checked" op het scherm komt.
     *
     * 'Cancelled' staat er bewust niet bij: dat is een status, maar het is niet
     * iets waar een bestelling doorheen LOOPT, en hem in dit rijtje zetten leest
     * als een stap die iedereen passeert.
     */
    stateLede: 'The portal opens on the state of your order. Four steps it moves through, plus two things that can happen along the way — and where you are is the first thing on the page.',
    states: [
      ['Received', 'The order is in and the delivery date is held.'],
      ['In production', 'The studio is working through the folder.'],
      ['Being checked', 'A person is looking at every visual before it goes out.'],
      ['Delivered', 'The gallery is open and the downloads are live.'],
      ['Revision — per image', 'You asked for a change on one visual and it is being made. It is a state of that image, not of the order: the rest keeps moving.'],
      ['Closed', `Every image approved. Nothing left to decide, and the files stay available for ${PORTAL_TTL_DAYS} days.`],
    ],
    stateNote: 'Each change is written into a timeline you can read, with the date it happened. Nothing about your order is only in our heads.',

    galleryH: 'Approve it image by image.',
    galleryLede: 'On delivery the whole order opens as a gallery. Every visual has two buttons and there is no accept-all — an order you approved in one click is an order nobody looked at. Ask for a revision on one image and the rest of the order keeps moving.',
    galleryList: [
      ['Approve', 'Marks that image done. The count at the top moves.'],
      ['Request a revision', 'Opens a note field. Say what is wrong in your own words — it goes straight to the person who made it.'],
      // Nieuw op 9 augustus 2026, en het hoort hier omdat de figuur ernaast het
      // laat zien: bij de foto’s staat geen downloadknop meer. Dat verzint een
      // bezoeker niet zelf, en ongezegd leest het als een scherm dat stuk is.
      ['The images here are review size', 'They exist to be judged, not to be used. What you take away is one folder — the next section is what is in it.'],
    ],

    dlH: 'One folder, and everything is in it.',
    dlLede: 'When the order is approved you download one folder. Inside it is a folder per product, and in each of those the same image three times: PNG, JPG and WebP. So a print shop, a product page and a feed each get the file they want, and nobody has to convert anything.',
    dl: [
      ['PNG', 'Lossless, the biggest file. This is the one for print and for anything that gets edited again.'],
      ['JPG', 'The format every system accepts. For a product page, a lookbook, an email.'],
      ['WebP', 'A third of the size at the same quality. For your site, so a page loads fast.'],
    ],
    dlTree: 'product-1/PNG/front.png  ·  product-1/JPG/front.jpg  ·  product-1/WEBP/front.webp',
    // GESPLITST, 21 augustus 2026. Was 96 woorden, de langste alinea van
    // /portal. Wat je moet DOEN staat er nog voluit — plaats zelf de zichtbare
    // vermelding, reken niet op het bestand. Waaróm je er niet op kunt rekenen
    // (de WebP-omzetting, de overgangstermijn tot 2 december 2026) is techniek
    // en staat achter het vraagteken.
    dlManifest: 'Every delivered file carries a machine-readable IPTC provenance tag that we write ourselves. We add that line and we remove nothing — but do not rely on a file identifying itself. The disclosure that counts is the visible one you place, and the AI Act page has the line to use.',
    dlManifestNoteTerm: 'the provenance tag',
    dlManifestNote: 'We write it into the WebP too, where the conversion discarded whatever the model provider had put there. Even so: any tool that re-saves an image can strip it again, and providers of systems already on the market have until 2 December 2026 to mark at all.',

    logH: 'Every approval and revision stays readable afterwards.',
    logLede: 'Every approval and every revision is stamped with a time and kept against the individual image, and you can read the sequence back at any time from your own link. Ask, and we will write it out for you as a summary. There is no button here that generates a document, and we are not going to imply there is.',
    logCta: 'Read the AI Act page',

    secH: 'Why there is no password.',
    secLede: 'A password is one more thing to lose, and for a link you open three times it buys nothing. The link itself is the key, so it is built like one.',
    sec: [
      ['256 bits of randomness', 'Generated by the browser-grade crypto in the runtime, not by a counter. It cannot be guessed and it cannot be walked.'],
      ['Never stored in the clear', 'Only a hash of it is kept, so the link cannot be read back out of the database.'],
      ['Rate-limited', 'Repeated attempts against the endpoint are refused before they reach the record.'],
      ['It expires', 'Ninety days after the order closes the link stops working, and the source files you sent are deleted on the same clock.'],
    ],
    secNote: 'Treat the link the way you would treat a key: anyone who has it can see the order. Send it on if a colleague needs it, and ask us for a new one if it goes somewhere it should not.',

    closeH: 'One of your own products, as a catalog set or a carousel, first.',
    closeLede: `${TEST_SAMPLE.en.deliverable}, made from your own photo and checked by a specialist. The portal comes with every paid order.`,
    closeCta: TEST_SAMPLE.en.cta,
    closeAlt: 'Start an order',
  },

  nl: {
    h1: ['Eén link.', 'Je hele bestelling.'],
    lede: `Bij elke bestelling krijg je een privélink. Geen account om aan te maken, geen wachtwoord om kwijt te raken. Alles over die bestelling zit erachter: waar hij staat, de beelden zodra ze klaar zijn, en bij elk beeld een knop om hem goed te keuren of te zeggen wat er niet klopt. Vanaf ${WINDOW_THRESHOLD} producten staat er een leverdatum naast die we voor je vrijhouden.`,
    ctaStart: 'Start een bestelling',
    ctaHow: 'Hoe een bestelling loopt',

    stateH: 'Waar hij staat, zonder te vragen.',
    // Zie de noot bij de Engelse stateLede.
    stateLede: 'Het portaal begint bij de status van je bestelling. Vier stappen die hij doorloopt, plus twee dingen die onderweg kunnen gebeuren — en waar jij staat is het eerste dat je ziet.',
    states: [
      ['Ontvangen', 'Je bestelling is binnen en de leverdatum staat vast.'],
      ['In productie', 'De studio werkt de map door.'],
      ['Wordt nagekeken', 'Een mens bekijkt elk beeld voordat het weggaat.'],
      ['Geleverd', 'De galerij is open en de downloads staan klaar.'],
      ['Revisie — per beeld', 'Je vroeg op één beeld om een wijziging en die wordt gemaakt. Het is een toestand van dat beeld en niet van de bestelling: de rest loopt gewoon door.'],
      ['Afgesloten', `Elk beeld goedgekeurd. Er valt niets meer te beslissen, en de bestanden blijven ${PORTAL_TTL_DAYS} dagen beschikbaar.`],
    ],
    stateNote: 'Elke wijziging wordt in een tijdlijn geschreven die je kunt lezen, met de datum erbij. Niets over je order zit alleen in ons hoofd.',

    galleryH: 'Beeld voor beeld goedkeuren.',
    galleryLede: 'Bij levering opent de hele bestelling als galerij. Elk beeld heeft twee knoppen en er is geen alles-accepteren — een bestelling die je in één klik goedkeurde, is een bestelling waar niemand naar gekeken heeft. Vraag je op één beeld een revisie aan, dan loopt de rest van de bestelling gewoon door.',
    galleryList: [
      ['Goedkeuren', 'Daarmee staat dat beeld op afgerond. De teller bovenaan loopt mee.'],
      ['Revisie aanvragen', 'Opent een notitieveld. Zeg in je eigen woorden wat er niet klopt — het gaat rechtstreeks naar degene die het gemaakt heeft.'],
      ['De beelden hier zijn op schermformaat', 'Ze staan er om te beoordelen, niet om te gebruiken. Wat je meeneemt is één map — de volgende sectie is wat daarin zit.'],
    ],

    dlH: 'Eén map, en alles zit erin.',
    dlLede: 'Is de bestelling goedgekeurd, dan download je één map. Daarin zit een map per product, en in elk daarvan dezelfde foto drie keer: PNG, JPG en WebP. Zo krijgen een drukker, een productpagina en een feed elk het bestand dat ze willen, en hoeft niemand nog iets om te zetten.',
    dl: [
      ['PNG', 'Lossless, het grootste bestand. Dit is degene voor druk en voor alles wat nog bewerkt wordt.'],
      ['JPG', 'Het formaat dat elk systeem aanneemt. Voor een productpagina, een lookbook, een mail.'],
      ['WebP', 'Een derde van de grootte bij dezelfde kwaliteit. Voor je eigen site, zodat een pagina snel laadt.'],
    ],
    dlTree: 'product-1/PNG/voorkant.png  ·  product-1/JPG/voorkant.jpg  ·  product-1/WEBP/voorkant.webp',
    dlManifest: 'Elk geleverd bestand draagt een machineleesbare IPTC-herkomsttag die wij er zelf in zetten. Die regel voegen we toe en we halen niets weg — maar reken er niet op dat een bestand zichzelf kan aanwijzen. De vermelding die telt is de zichtbare die jij plaatst, en op de AI Act-pagina staat de regel die je daarvoor gebruikt.',
    dlManifestNoteTerm: 'de herkomsttag',
    dlManifestNote: 'We zetten hem ook in de WebP, waar de omzetting weggooide wat de modelaanbieder erin had gezet. Toch: elk programma dat een beeld opnieuw opslaat kan hem er weer uit halen, en aanbieders van systemen die al op de markt waren hebben tot 2 december 2026 om überhaupt te markeren.',

    logH: 'Elke goedkeuring en revisie blijft terug te lezen.',
    logLede: 'Elke goedkeuring en elke revisie krijgt een tijdstempel en wordt bewaard bij het betreffende beeld, en je kunt de reeks op elk moment teruglezen via je eigen link. Vraag ernaar en we schrijven het voor je uit als overzicht. Er zit hier geen knop die een document genereert, en we doen ook niet alsof.',
    logCta: 'Lees de AI Act-pagina',

    secH: 'Waarom er geen wachtwoord is.',
    secLede: 'Een wachtwoord is nog iets om kwijt te raken, en voor een link die je drie keer opent levert het niets op. Daarom hebben we de link zelf zo gemaakt dat niemand hem kan raden.',
    sec: [
      ['Niet te raden', 'De link bestaat uit 256 willekeurige bits — geen volgnummer dat je kunt ophogen om bij de bestelling van iemand anders te komen.'],
      ['Nooit leesbaar opgeslagen', 'Alleen een hash wordt bewaard, dus de link is niet uit de database terug te lezen.'],
      ['Snelheidsbegrensd', 'Herhaalde pogingen op het endpoint worden geweigerd voordat ze het record bereiken.'],
      ['Hij verloopt', 'Negentig dagen nadat de order sluit werkt de link niet meer, en op dezelfde klok worden de bronbestanden die je stuurde verwijderd.'],
    ],
    secNote: 'Behandel de link zoals je een sleutel behandelt: wie hem heeft, kan de bestelling zien. Stuur hem gerust door als een collega hem nodig heeft, en vraag ons om een nieuwe als hij ergens belandt waar hij niet hoort.',

    closeH: 'Eerst één product van jezelf, als catalogset of carousel.',
    closeLede: `${TEST_SAMPLE.nl.deliverable}, gemaakt van je eigen foto en door een specialist nagekeken. Het portaal krijg je bij elke betaalde bestelling.`,
    closeCta: TEST_SAMPLE.nl.cta,
    closeAlt: 'Start een bestelling',
  },
};

const c = COPY[lang];
---

{/* ═══ /portal IN DE STIJL VAN SECTIE 22 — 7 september 2026 ═════════════════
    Zeventiende pagina in de stijl. De inhoud is onaangeraakt: dezelfde COPY in
    beide talen, dezelfde <FigDash> en <FigGallery>, dezelfde <Note> bij het
    manifest, dezelfde getallen uit pricing.js en token.js.

    DE ZES TOESTANDEN ZIJN DE DONKERE KAMER. Dat is waar de pagina zegt wat een
    bestelling ACHTEREENVOLGENS is, en dat is het hoofdstuk waar hij om draait —
    de rest is wat je op elk van die momenten kunt doen.

    DE KOP EN HET SCHERM NAAST ELKAAR, nog steeds: hier stond ooit alleen tekst,
    en dan is de eerste schermvulling van een pagina over een SCHERM een pagina
    zonder scherm. */}
<div class="s22">

  {/* ── 1 · DE OPENING ───────────────────────────────────────────────────── */}
  <section class="paneel" aria-labelledby="pp-h1">
    <div class="pp-open">
      <div class="paneel-kop">
        <h1 id="pp-h1" class="hoog">{c.h1[0]} <em>{c.h1[1]}</em></h1>
        <p class="lopend">{c.lede}</p>
        <p class="acties">
          <a class="knop knop-inkt" href={lp('/start')}>{c.ctaStart}</a>
          <a class="knop knop-lijn" href={lp('/how-it-works')}>{c.ctaHow}</a>
        </p>
      </div>
      <FigDash lang={lang} />
    </div>
  </section>

  {/* ── 2 · DE ZES TOESTANDEN ───────────────────────────────────────────────
      Zes genoemde dingen en geen tekening: het IS een volgorde, dus staat er
      een genummerde lijst. */}
  <section class="kamer pp-kamer" aria-labelledby="pp-staat">
    <p class="spook spook-links" aria-hidden="true"><span>Studio</span><span>Studio</span></p>
    <header class="kamer-kop">
      <h2 id="pp-staat" class="hoog hoog-2">{c.stateH}</h2>
      <p class="lopend">{c.stateLede}</p>
    </header>
    <ol class="pp-staten">
      {c.states.map(([k, v], i) => (
        <li>
          <span class="mono nr">{String(i + 1).padStart(2, '0')}</span>
          <b>{k}</b>
          <span class="lopend">{v}</span>
        </li>
      ))}
    </ol>
    <p class="lopend pp-noot">{c.stateNote}</p>
  </section>

  {/* ── 3 · DE GALERIJ VAN EEN BESTELLING ────────────────────────────────── */}
  <section class="paneel" aria-labelledby="pp-galerij">
    <div class="pp-twee">
      <div class="pp-tekst">
        <h2 id="pp-galerij" class="hoog hoog-2">{c.galleryH}</h2>
        <p class="lopend">{c.galleryLede}</p>
        <dl class="pp-def">
          {c.galleryList.map(([k, v]) => (<Fragment><dt>{k}</dt><dd class="lopend">{v}</dd></Fragment>))}
        </dl>
      </div>
      <FigGallery lang={lang} />
    </div>
  </section>

  {/* ── 4 · WAT JE DOWNLOADT ────────────────────────────────────────────────
      Het pad zelf staat erbij. De drie regels zeggen WELKE formaten er zijn;
      die ene regel zegt hoe het in de map staat, en dat is de vraag die iemand
      overhoudt. */}
  <section class="paneel" aria-labelledby="pp-dl">
    <header class="paneel-kop">
      <h2 id="pp-dl" class="hoog hoog-2">{c.dlH}</h2>
      <p class="lopend">{c.dlLede}</p>
    </header>
    <ul class="pp-kanalen" role="list">
      {c.dl.map(([k, v]) => (<li><b>{k}</b><span class="lopend">{v}</span></li>))}
    </ul>
    <p class="mono pp-boom">{c.dlTree}</p>
    <p class="lopend pp-manifest">{c.dlManifest} <Note lang={lang} term={c.dlManifestNoteTerm}>{c.dlManifestNote}</Note></p>
  </section>

  {/* ── 5 · HET LOGBOEK ─────────────────────────────────────────────────── */}
  <section class="paneel pp-log" aria-labelledby="pp-logboek">
    <h2 id="pp-logboek" class="hoog hoog-3">{c.logH}</h2>
    <p class="lopend">{c.logLede}</p>
    <p class="acties"><a class="knop knop-lijn" href={lp('/ai-act')}>{c.logCta}</a></p>
  </section>

  {/* ── 6 · WAT ER DICHT ZIT ────────────────────────────────────────────── */}
  <section class="paneel" aria-labelledby="pp-sec">
    <header class="paneel-kop">
      <h2 id="pp-sec" class="hoog hoog-2">{c.secH}</h2>
      <p class="lopend">{c.secLede}</p>
    </header>
    <ul class="pp-sec" role="list">
      {c.sec.map(([k, v]) => (<li><b>{k}</b><span class="lopend">{v}</span></li>))}
    </ul>
    <p class="lopend pp-noot-licht">{c.secNote}</p>
  </section>

  {/* ── 7 · HET SLOT ─────────────────────────────────────────────────────── */}
  <section class="paneel paneel-slot" aria-labelledby="pp-slot">
    <h2 id="pp-slot" class="hoog">{c.closeH}</h2>
    <p class="lopend">{c.closeLede}</p>
    <p class="acties">
      <a class="knop knop-inkt" href={lp('/test-sample')}>{c.closeCta}</a>
      <a class="knop knop-lijn" href={lp('/start')}>{c.closeAlt}</a>
    </p>
  </section>
</div>

<style>
  .pp-open { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: clamp(1.5rem, 5vw, 4rem); align-items: center; }
  .pp-open .paneel-kop { margin-bottom: 0; gap: 1.1rem; }

  /* De zes toestanden: nummer, naam, uitleg. Eén rij per toestand met een lijn
     erboven — het is een VOLGORDE en geen zes losse kaarten. */
  .pp-staten { display: grid; }
  .pp-staten li { display: grid; grid-template-columns: auto minmax(0, 16rem) minmax(0, 34rem); align-items: baseline; gap: clamp(1rem, 3vw, 2.5rem); padding: clamp(1rem, 2.2vw, 1.5rem) 0; border-top: 1px solid rgb(245 245 245 / .18); }
  .pp-staten li:last-child { border-bottom: 1px solid rgb(245 245 245 / .18); }
  .pp-staten .nr { color: rgb(245 245 245 / .5); }
  .pp-staten b { font-family: var(--kop2); font-weight: 500; font-stretch: 125%; font-size: clamp(1.05rem, 1.8vw, 1.35rem); text-transform: uppercase; letter-spacing: -.01em; }
  .pp-staten .lopend { font-size: .92rem; }
  .pp-noot { margin-top: clamp(1.6rem, 3vw, 2.4rem); font-size: .92rem; }
  .pp-noot-licht { margin-top: clamp(1.6rem, 3vw, 2.4rem); font-size: .92rem; }

  .pp-twee { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: clamp(1.5rem, 4vw, 3.5rem); align-items: center; }
  .pp-tekst { display: grid; gap: 1rem; }
  .pp-def { display: grid; gap: .8rem; margin-top: .4rem; }
  .pp-def dt { font-family: var(--kop2); font-weight: 500; font-stretch: 125%; font-size: clamp(1rem, 1.6vw, 1.2rem); text-transform: uppercase; letter-spacing: -.01em; }
  .pp-def dd { margin: 0 0 .6rem; font-size: .92rem; }

  .pp-kanalen { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(1.2rem, 3vw, 2.5rem); }
  .pp-kanalen li { display: grid; gap: .5rem; align-content: start; padding-top: 1rem; border-top: 1px solid var(--lijn); }
  .pp-kanalen b { font-family: var(--kop2); font-weight: 500; font-stretch: 125%; font-size: clamp(1.05rem, 1.8vw, 1.3rem); text-transform: uppercase; letter-spacing: -.01em; }
  .pp-kanalen .lopend { font-size: .92rem; }
  /* Het pad naar het bestand, als pad: één regel, en hij mag schuiven in plaats
     van af te breken — een pad met een regelovergang erin is geen pad meer. */
  .pp-boom { margin-top: clamp(1.6rem, 3vw, 2.4rem); padding: .9rem 1.1rem; border: 1px solid var(--lijn); border-radius: calc(var(--ronding) - 12px); color: var(--inkt-2); text-transform: none; letter-spacing: 0; overflow-x: auto; white-space: nowrap; }
  .pp-manifest { margin-top: 1rem; font-size: .92rem; }

  .pp-log { display: grid; gap: .8rem; justify-items: start; }

  .pp-sec { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(1.2rem, 3vw, 2.5rem); }
  .pp-sec li { display: grid; gap: .5rem; align-content: start; padding-top: 1rem; border-top: 1px solid var(--lijn); }
