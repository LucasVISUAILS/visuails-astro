---
/*
 * FigHook — de kaderbreuk, getekend.
 *
 * ── WAT DIT MOET DOEN ───────────────────────────────────────────────────────
 *
 * Lucas' idee, 9 augustus 2026: *"Een video met een Instagram bar ertussen dat
 * overloopt naar de foto eronder. Valt ontzettend op (Guerilla marketing). Ipv
 * een burger kan ik bijvoorbeeld de schoen van een klant pakken en de veters van
 * de klant zwaaiend laten hangen over de instagram bar waardoor mensen even
 * stoppen om te kijken wat er nou precies gebeurd."*
 *
 * Deze figuur is de hele dienst in één beeld: drie lagen, waarvan de middelste
 * de interface is en de veter eroverheen valt. De laag die bovenop hoort te
 * liggen, ligt eronder. Dat is de halve seconde twijfel die verkocht wordt.
 *
 * ── WAAROM CSS EN SVG, EN GEEN PLAATJE ─────────────────────────────────────
 *
 * Een png van dit idee is niet aan te passen en niet te hergebruiken; deze wel.
 * Zet er straks een echte productfoto in de plaats van het getekende vlak en het
 * staat er — en tot die tijd staat er niets dat doet alsof het een echte post is.
 *
 * ── DE BALK IS NAGETEKEND EN GEEN IMITATIE ─────────────────────────────────
 *
 * Geen logo, geen merknaam, geen ingebedde post. Wat een feedbalk als feedbalk
 * laat lezen zijn de vormen: een rondje, drie iconen links, één rechts, een regel
 * tekst. Dat is genoeg. Een echte embed zou het merk van iemand anders op onze
 * verkooppagina zetten, en zou bovendien een extern script binnenhalen op een
 * site die op nul externe scripts staat.
 *
 * ── GEEN ANIMATIE, EN DAT IS EEN KEUZE ─────────────────────────────────────
 *
 * Overwogen: de veter laten zwaaien. Dat maakt de figuur mooier en het argument
 * zwakker — beweging trekt de aandacht naar de beweging, terwijl het punt de
 * DOORBROKEN LAAG is. Een echte post is een video; deze pagina is de uitleg.
 */
interface Props { lang?: 'en' | 'nl'; }
const { lang = 'en' } = Astro.props;
const nl = lang === 'nl';

const C = nl
  ? {
      alt: 'Voorbeeld: een nagetekende feedbalk waar een veter over hangt en op het beeld eronder doorloopt.',
      product: 'jouw product',
      handle: 'jouwmerk',
      caption: 'De veters zitten los. Wacht even —',
      floor: 'en hij loopt gewoon door',
    }
  : {
      alt: 'Example: a drawn feed bar with a lace hanging over it, continuing onto the image below.',
      product: 'your product',
      handle: 'yourbrand',
      caption: 'The laces are undone. Hang on —',
      floor: 'and it just keeps going',
    };
---

<figure class="fh" aria-label={C.alt}>
  <div class="fh-top">
    {/* Een schoen, getekend. Geen klantfoto in een figuur die op elke bezoeker
        staat te wachten — en een getekende schoen kan geen merk verraden. */}
    <svg class="fh-shoe" viewBox="0 0 200 120" fill="none" aria-hidden="true">
      <path d="M18 92c0-10 4-18 12-24l30-22c6-4 12-6 19-6h14c8 0 15 4 19 11l10 17c3 5 8 8 14 9l31 5c8 1 14 8 14 16v6c0 5-4 9-9 9H27c-5 0-9-4-9-9z" fill="#E8E8E4"/>
      <path d="M18 92c0-4 1-7 2-10h163c2 3 3 6 3 10v6c0 5-4 9-9 9H27c-5 0-9-4-9-9z" fill="#C9C9C4"/>
      <path d="M62 46l22 14M74 36l22 14M86 27l22 14" stroke="#9A9A95" stroke-width="3" stroke-linecap="round"/>
    </svg>
    <span class="fh-hint">{C.product}</span>
  </div>

  <div class="fh-bar">
    <div class="fh-icons">
      <svg class="fh-ic is-liked" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 21s-8.4-5.2-9.7-10.2C1.2 6.9 3.8 4 7.1 4c2 0 3.6 1.1 4.9 2.9C13.3 5.1 14.9 4 16.9 4c3.3 0 5.9 2.9 4.8 6.8C20.4 15.8 12 21 12 21z"/></svg>
      <svg class="fh-ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M21 12a8.5 8.5 0 0 1-12.3 7.6L3 21l1.5-5.4A8.5 8.5 0 1 1 21 12z" stroke-linejoin="round"/></svg>
      <svg class="fh-ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M22 3 11 14M22 3l-7 19-4-8-8-4z" stroke-linejoin="round"/></svg>
      <span class="fh-spacer"></span>
      <svg class="fh-ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M19 21l-7-5-7 5V4h14z" stroke-linejoin="round"/></svg>
    </div>
    <div class="fh-handle">
      <span class="fh-dot"></span>
      <span class="fh-name">{C.handle}</span>
    </div>
    <p class="fh-caption"><b>{C.handle}</b> {C.caption}</p>
  </div>

  <div class="fh-bottom">
    <span class="fh-floor">{C.floor}</span>
  </div>

  {/* DE VETER. Over alle drie de lagen heen, en dat is de hele figuur. */}
  <div class="fh-lace" aria-hidden="true">
    <svg viewBox="0 0 400 300" preserveAspectRatio="none" fill="none" aria-hidden="true">
      {/* Een schaduw eerst, anders lijkt de veter op de balk geplakt in plaats
          van erboven te hangen — dan leest het als een streep. */}
      <path d="M186 2 C186 46, 150 88, 168 138 C188 194, 258 206, 272 264"
            stroke="rgb(0 0 0 / .55)" stroke-width="16" stroke-linecap="round" transform="translate(6 8)"/>
      <path d="M186 2 C186 46, 150 88, 168 138 C188 194, 258 206, 272 264"
            stroke="#E8E8E4" stroke-width="11" stroke-linecap="round"/>
      {/* Het metalen uiteinde. Eén detail is genoeg om er een veter van te maken. */}
      <rect x="262" y="254" width="20" height="34" rx="5" fill="var(--accent)" transform="rotate(14 272 271)"/>
    </svg>
  </div>
</figure>

<style>
  .fh {
    position: relative;
    margin: 0;
    max-width: 27rem;
    border-radius: var(--r-lg);
    overflow: hidden;
    background: var(--surface);
    box-shadow: 0 30px 70px -30px rgb(0 0 0 / .9), inset 0 0 0 1px var(--line);
  }

  /* ── VIERKANT EN NIET 4:5, EN DE SCHOEN GROTER ────────────────────────────
     Eerste versie had 4:5 (de verhouding van een feedpost) met de schoen op 62%.
     Gerenderd was dat een figuur van bijna achthonderd pixels hoog waarin het
     product klein in een groot leeg vlak stond — de verhouding was juist en het
     BEELD was fout. Wat deze figuur moet laten zien is de balk en de veter, niet
     hoe hoog een post is.

     Vierkant scheelt honderd pixels hoogte, en op 74% vult de schoen het vlak
     zonder de rand te raken. De onderste helft is om dezelfde reden 21:9 in plaats
     van 16:9: er hoeft alleen te blijken dat de veter dóórloopt. */
  .fh-top {
    position: relative;
    aspect-ratio: 1 / 1;
    background: radial-gradient(120% 100% at 50% 18%, #30353F 0%, #1A1D23 58%, #101216 100%);
    display: grid; place-items: center;
  }
  .fh-shoe { width: 74%; height: auto; }

  /* De labels staan LINKS en niet gecentreerd. Gecentreerd liepen ze precies
     onder de veter door en was geen van de twee nog te lezen. */
  .fh-hint, .fh-floor {
    position: absolute; left: 1rem; bottom: .8rem;
    font-size: .62rem; letter-spacing: .1em; text-transform: uppercase;
    color: var(--ink-3);
  }

  .fh-bar {
    position: relative; z-index: 1;
    background: #0B0C0E;
    box-shadow: inset 0 1px 0 var(--line), inset 0 -1px 0 var(--line);
    padding: .7rem .9rem;
    display: grid; gap: .5rem;
  }
  .fh-icons { display: flex; align-items: center; gap: .75rem; }
  .fh-ic { width: 20px; height: 20px; color: var(--ink); flex: 0 0 auto; }
  .fh-ic.is-liked { color: #FF3B5C; }
  .fh-spacer { flex: 1 1 auto; }
  .fh-handle { display: flex; align-items: center; gap: .5rem; }
  .fh-dot { width: 22px; height: 22px; border-radius: 50%; background: var(--surface-2); box-shadow: inset 0 0 0 1px var(--line-strong); flex: 0 0 auto; }
  .fh-name { font-size: .74rem; font-weight: 700; color: var(--ink); }
  .fh-caption { margin: 0; font-size: .74rem; line-height: 1.45; color: var(--ink-2); }
  .fh-caption b { color: var(--ink); font-weight: 700; }

  .fh-bottom {
    position: relative;
    aspect-ratio: 21 / 9;
    background: radial-gradient(110% 130% at 50% 0%, #23272F 0%, #14171B 70%);
  }

  /* De veter begint BIJ DE SCHOEN en niet in de lucht. Eerste versie begon net
     boven de balk, en dan komt er een streep uit het niets: het oog ziet geen
     veter maar een lijn die door de interface loopt. Op 26% start hij tussen de
     vetergaten, en dan is het hetzelfde beeld met een oorzaak erin.

     z-index 2, dus over de balk. pointer-events: none, want het is een tekening
     en geen bediening. */
  .fh-lace {
    position: absolute; z-index: 2;
    left: 0; right: 0; top: 30%; height: 70%;
    pointer-events: none;
  }
  .fh-lace svg { width: 100%; height: 100%; display: block; }
</style>
