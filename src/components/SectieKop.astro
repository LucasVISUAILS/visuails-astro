---
/* ═══════════════════════════════════════════════════════════════════════════════════════════════════════════
   DE SECTIEKOP — levering 96, 13 november 2026 (lijst 96, A1 a)
   Lucas, 01:47: "de VISUAILS homepage mist voor mijn gevoel wat structuur". Gemeten op de voorpagina: koppen van 81,
   64, 64, 48, 42, 64 en 32 px, de ene in het midden, de andere links, lucht van 0 tot 213 px. Nu begint elke sectie
   van de voorpagina met dezelfde kop: links de kop (64 px op 1440, de 4 : 3-schaal), rechts op dezelfde lijn het label
   in mono met de schuine streep (het vlagje van de V) en het nummer, eronder een haarlijn. Het nummer telt mee met een
   CSS-teller (sectiekop-96.css), dus nooit met de hand. Alleen op de voorpagina.
   ═══════════════════════════════════════════════════════════════════════════════════════════════════════════ */
interface Props { id: string; label: string; kop: string | string[]; zin?: string; class?: string }
const { id, label, kop, zin, class: klasse } = Astro.props;
const regels = Array.isArray(kop) ? kop : [kop];
---
<header class:list={['sk', klasse]}>
  <div class="sk-tekst">
    <h2 id={id} class="h-kop sk-kop">{regels.map((r, i) => <>{i > 0 && ' '}<span class="sk-r">{r}</span></>)}</h2>
    {zin && <p class="sk-zin">{zin}</p>}
  </div>
  <p class="sk-lbl"><i aria-hidden="true"></i><span class="sk-nr" aria-hidden="true"></span>{label}</p>
</header>
