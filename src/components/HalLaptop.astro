---
/**
 * VISUAILS — de opening van het voorbeeld: Lucas' laptopbeeld met losse schermen.
 * ═══════════════════════════════════════════════════════════════════════════
 *
 * Ontwerpplan §00 (gekozen in afvinklijst 5): N1 op de computer, N2 op de
 * telefoon, met de wissel bij 900 px. Hetzelfde onderdeel in allebei; alleen
 * hoe de fotodoos in de opening ligt verschilt (hal.css).
 *
 * HOE HET WERKT. De fotodoos heeft de verhouding van de foto (4:3). Daarin:
 *   1. de foto, met de schermen al ingezet (het eerste beeld) — dit is wat je
 *      ziet zonder JavaScript, en wat er staat tot het script klaar is;
 *   2. een laag van 2304 × 1296 "fotopixels" (sinds 20 oktober 2026, de POV-foto) met de twee schermen erin, elk op
 *      zijn eigen maat opgebouwd (1600 × 1034 en 540 × 1170) en met matrix3d in
 *      het perspectief van de foto gezet (src/data/halLaptop.js). Het script zet
 *      alleen de schaal (--hl-k) en wisselt de beelden; het masker per scherm laat
 *      de vingers van de foto staan;
 *   3. de twee belletjes en hun lijntjes, op punten die op de rand van het scherm
 *      liggen (uitgerekend, niet gemikt).
 *
 * WAT ER TE ZIEN IS komt uit src/data/laptopSlides.js (dezelfde reeks als de
 * huidige voorpagina): de catalogset (4), de lifestylecarrousel en de videoclip.
 * De videodia toont het sfeerbeeld in 9:16 (plan §07), tot de echte clip er is.
 * Een beeld dat er nog niet is (isEcht), valt weg in plaats van grijs te staan.
 *
 * DE BELLETJES (Lucas bij d-bellen): *"Bedenk hoe het voor de klant nog
 * logischer word en niet voelt als een ai tool maar dat het duidelijk word dat
 * het een service is waarbij de klant simpelweg alleen een paar foto's … hoeft
 * te sturen en wij de rest … uitvoeren."* Daarom zegt de telefoon "Een paar
 * telefoonfoto's" en de laptop wat er terugkomt; wat wij ertussen doen staat in
 * "Hoe het werkt" (VoorpaginaHal.astro), niet op de foto.
 *
 * Het nagemaakte webshopscherm noemt een VERZONNEN prijs van een verzonnen merk
 * ("JOUWMERK"), geen tarief van ons — net als in LaptopCarousel.astro, en om
 * dezelfde reden staat hij hier per taal genoteerd (tests/hardgetypt.test.mjs
 * kent de uitzondering).
 */
import { laptopReeks } from '../data/laptopSlides.js';
import { ikoon, IKOON } from '../data/iconen.js';
import { FOTO, SCHERMEN, inFoto } from '../data/halLaptop.js';
import { RESOLUTIE } from '../data/pricing.js';
import { standenVoor, standPad, standSrcset } from '../data/halStanden.js';

/* sets (12 oktober 2026, afvinklijst 7): welke reeksen de laptop toont. De
   voorpagina toont ze alle drie; /catalog alleen de webshop met de catalogset,
   /lifestyle alleen de carrousel ("consistent bij elke categorie", Lucas, 17 sep). */
type SetNaam = 'catalog' | 'lifestyle' | 'video';
interface Props { lang: 'en' | 'nl'; sets?: SetNaam[] }
const { lang, sets = ['catalog', 'lifestyle', 'video'] } = Astro.props as Props;
const nl = lang === 'nl';

const [catalog, lifestyle, video] = laptopReeks(lang);
/* De standen, elk als kant-en-klare foto (src/data/halStanden.js). Een stand
   zonder foto valt weg; zonder een enkele staat er alleen de foto. */
const standen = standenVoor(lang, sets);

const SET = {
  catalog: { naam: catalog.naam, wat: nl ? `Je catalogbeeld · ${RESOLUTIE.standaard} px` : `Your catalog image · ${RESOLUTIE.standaard} px` },
  lifestyle: { naam: lifestyle.naam, wat: nl ? `Je lifestylebeeld · ${RESOLUTIE.standaard} px` : `Your lifestyle image · ${RESOLUTIE.standaard} px` },
  video: { naam: video.naam, wat: nl ? 'Je productvideo · 9:16' : 'Your product video · 9:16' },
};

const T = nl
  ? { stuur: 'Wat jij stuurt', stuurWat: 'Een paar telefoonfoto’s', krijg: 'Wat je terugkrijgt',
      vorige: 'Vorig beeld', volgende: 'Volgend beeld', pauze: 'Zet de beelden stil', speel: 'Laat de beelden lopen',
      van: (a: number, b: number) => `${a} / ${b}`,
      uitleg: 'Een voorbeeld. Je krijgt de losse bestanden en gebruikt ze waar je wilt.',
      fotoAlt: 'Een laptop op schoot met een webshoppagina, en een telefoon in de hand met de foto die je instuurt' }
  : { stuur: 'What you send', stuurWat: 'A few phone photos', krijg: 'What you get back',
      vorige: 'Previous image', volgende: 'Next image', pauze: 'Pause the images', speel: 'Play the images',
      van: (a: number, b: number) => `${a} / ${b}`,
      uitleg: 'An example. You get the files and use them wherever you like.',
      fotoAlt: 'A laptop on a lap showing a shop page, and a phone in hand with the photo you send in' };

/* De belletjes wijzen naar een punt OP de bovenrand van elk scherm (in fotopixels,
   dus als fractie van de fotodoos). Laptop: op een tiende van de breedte, het belletje
   hangt rechts van zijn punt. Telefoon (sinds 20 oktober links in de foto): op 80 %,
   rechts van het eiland en nog op het rechte stuk van de rand; het belletje hangt
   links van zijn punt, boven het witte deel met de schets. */
const L = SCHERMEN.laptop, F = SCHERMEN.fon;
const [lx, ly] = inFoto(L, L.w * 0.1, 0);
const [fx, fy] = inFoto(F, F.w * 0.8, 0);
const punt = (x: number, y: number) => `--px:${(x / FOTO.w).toFixed(5)};--py:${(y / FOTO.h).toFixed(5)}`;
/* Het telefoonbelletje staat op dezelfde hoogte als dat van de laptop (--pyb), met een
   langer lijntje naar zijn scherm: zo blijven ze allebei boven de tekst en de foto, op
   één lijn, ook op een smal scherm waar het label van de opening er anders tegenaan
   kwam (op 901 px 6 px overlap). */
const lijn = `;--pyb:${(ly / FOTO.h).toFixed(5)}`;
const eerst = standen[0] ?? { set: sets[0] ?? 'catalog', i: 0, duur: 0 };
/* Op een telefoon ligt de foto 1,59 × zo breed als het scherm, maar je ziet er
   alleen het midden van. 120vw kiest daar de foto van 1600 px (DPR 2 tot 3) in
   plaats van die van 2304: twee van die foto's tegelijk in het geheugen is wat
   een telefoon aankan, twee van 2304 × 1728 vraagt het dubbele. */
const SIZES = '(max-width: 900px) 120vw, 75vw';
---
<div class="hl" data-hl data-sets={standen.map((s) => s.set).join(' ')}>
  {/* HET RAAM. Op een breed scherm is het precies zo groot als de fotodoos, dus
      de belletjes (in procenten van het raam) staan op de goede plek in de foto.
      Op een telefoon (N2) is het het ronde paneel dat de foto uitsnijdt, en
      staan de belletjes in de hoeken van het paneel, niet in de foto. */}
  <div class="hl-raam">
  <div class="hl-doos" data-hl-doos>
    {/* De standen: elk een foto van 2304 × 1296 met de schermen er al in. De eerste
        staat er meteen (ook zonder JavaScript); de rest ligt klaar met display:none
        en laadt pas als het script hem vraagt. Er tekent per wissel niets dan twee
        foto's die in elkaar overvloeien. */}
    {standen.length
      ? standen.map((s, k) => (
          <img class:list={['hl-stand', k === 0 && 'is-nu is-klaar']} src={standPad(lang, s, 1600)} srcset={standSrcset(lang, s)} sizes={SIZES}
               width={FOTO.w} height={FOTO.h} alt={k === 0 ? T.fotoAlt : ''} loading={k === 0 ? 'eager' : 'lazy'} fetchpriority={k === 0 ? 'high' : undefined}
               decoding="async" data-hl-stand={k} />
        ))
      : <img class="hl-stand is-nu is-klaar" src="/img/hal/laptop-1600.webp" srcset="/img/hal/laptop-1000.webp 1000w, /img/hal/laptop-1600.webp 1600w, /img/hal/laptop-2304.webp 2304w"
             sizes={SIZES} width={FOTO.w} height={FOTO.h} alt={T.fotoAlt} fetchpriority="high" decoding="async" />}
  </div>

    {/* De belletjes. De tekst is echte tekst (geen aria-hidden): hij zegt wat je ziet. */}
    <p class="hl-bel hl-bel-lap" style={punt(lx, ly)}><span class="hl-stip" aria-hidden="true"></span><span><em>{T.krijg}</em><b data-hl-wat>{SET[eerst.set as SetNaam].wat}</b></span></p>
    <p class="hl-bel hl-bel-fon" style={punt(fx, fy) + lijn}><span class="hl-stip" aria-hidden="true"></span><span><em>{T.stuur}</em><b>{T.stuurWat}</b></span></p>
    <span class="hl-draad hl-draad-lap" style={punt(lx, ly)} aria-hidden="true"></span>
    <span class="hl-draad hl-draad-fon" style={punt(fx, fy) + lijn} aria-hidden="true"></span>
  </div>

  {/* De bediening: naam van de set, de streep, terug en verder. Eronder de ene
      regel die zegt dat dit een voorbeeld is (Lucas, 20 september 2026). */}
  {standen.length > 1 && (
    <div class="hl-bediening" data-hl-bediening>
      <p class="hl-naam"><b data-hl-naam>{SET[eerst.set as SetNaam].naam}</b><span class="hl-teller" data-hl-teller>{T.van(1, standen.length)}</span></p>
      <span class="hl-streep" aria-hidden="true"><i data-hl-streep></i></span>
      <span class="h-paar"><button type="button" class="h-cirkel h-cirkel-klein" data-hl-stap="-1" aria-label={T.vorige}><Fragment set:html={ikoon('pijl-links')} /></button>
      <button type="button" class="h-cirkel h-cirkel-klein" data-hl-stap="1" aria-label={T.volgende}><Fragment set:html={ikoon('pijl')} /></button></span>
      <button type="button" class="h-cirkel h-cirkel-klein hl-pauze" data-hl-pauze aria-pressed="false" aria-label={T.pauze} data-uit={T.pauze} data-aan={T.speel} hidden><svg class="ik" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path class="hl-p-uit" fill-rule="evenodd" d={IKOON.pauze} /><path class="hl-p-aan" fill-rule="evenodd" d={IKOON.afspelen} /></svg></button>
    </div>
  )}
  <p class="hl-uitleg">{T.uitleg}</p>
  {standen.length > 1 && (
    <script type="application/json" data-hl-standen set:html={JSON.stringify({
      standen: standen.map((s) => ({ set: s.set, duur: s.duur })),
      sets: { catalog: SET.catalog, lifestyle: SET.lifestyle, video: SET.video },
    })} />
  )}
</div>

<script>
  /* ── DE WISSEL — 15 oktober 2026 ────────────────────────────────────────────
     Elke stand is één foto (src/data/halStanden.js). Het script doet drie dingen:
     1. DE KLOK. Elke stand heeft een duur uit laptopSlides.js. De klok is de
        streep: een CSS-animatie van precies die duur, en als hij af is gaat de
        wissel een stand verder. Pauzeren is de animatie stilzetten.
     2. PAS WISSELEN ALS DE VOLGENDE FOTO ER HELEMAAL IS: geladen én
        gedecodeerd. Komt hij niet, dan blijft de huidige stand gewoon staan.
        (Lucas, 14 oktober 21:17: "laden heel erg buggy en glitchy".)
     3. DE OVERVLOEI: de nieuwe foto krijgt is-nu (opacity), de oude verliest
        hem. Dat is het enige dat beweegt, en het is iets wat de browser zonder
        tekenen kan.
     Stil bij "minder beweging", buiten beeld, onder de muis of de focus, en
     voorgoed zodra iemand zelf op een pijl drukt of op pauze. */
  type Stand = { set: string; duur: number };
  const zet = () => {
    for (const root of document.querySelectorAll<HTMLElement>('[data-hl]')) {
      if (root.dataset.hlKlaar) continue;
      root.dataset.hlKlaar = '1';
      const json = root.querySelector('[data-hl-standen]');
      const doos = root.querySelector<HTMLElement>('[data-hl-doos]');
      const streep = root.querySelector<HTMLElement>('[data-hl-streep]');
      const naam = root.querySelector<HTMLElement>('[data-hl-naam]');
      const teller = root.querySelector<HTMLElement>('[data-hl-teller]');
      const wat = root.querySelector<HTMLElement>('[data-hl-wat]');
      const pauze = root.querySelector<HTMLButtonElement>('[data-hl-pauze]');
      const fotos = [...root.querySelectorAll<HTMLImageElement>('[data-hl-stand]')];
      root.classList.add('hl-leeft');
      if (!json || !doos || !streep || !naam || !teller || !wat || !pauze || fotos.length < 2) continue;
      const data = JSON.parse(json.textContent || '{}') as { standen: Stand[]; sets: Record<string, { naam: string; wat: string }> };
      const standen = data.standen;
      if (!standen?.length) continue;

      const rustig = matchMedia('(prefers-reduced-motion: reduce)').matches;
      let nu = 0, loopt = !rustig, zicht = false, erboven = false;

      const stand = () => {
        root.classList.toggle('hl-loopt', loopt && zicht && !erboven);
        pauze.setAttribute('aria-pressed', String(!loopt));
        pauze.setAttribute('aria-label', (loopt ? pauze.dataset.uit : pauze.dataset.aan) || '');
      };
      /* Geen `void el.offsetWidth` meer om iets opnieuw te laten beginnen: dat dwingt
         de browser de hele pagina op te meten, en op de lange voorpagina kostte dat
         per wissel tientallen milliseconden (gemeten met CPU 4× trager: een taak van
         104 ms, waarvan 33 ms opmeten). De tekst krijgt een eigen korte overgang via
         de Web Animations API, en de streep wordt teruggezet op 0. Ook de klasse
         h-wissel is weg: die hoort bij het wisselwoord in de kop (violet, inline-grid)
         en maakte de naam na de eerste wissel per ongeluk violet. */
      const wissel = (el: HTMLElement) => {
        if (typeof el.animate === 'function') el.animate([{ opacity: 0, transform: 'translateY(4px)' }, { opacity: 1, transform: 'none' }], { duration: 360, easing: 'cubic-bezier(.2, .7, .2, 1)' });
      };
      const herstartStreep = (ms: number) => {
        streep.style.animationDuration = `${ms}ms`;
        if (!streep.classList.contains('is-aan')) { streep.classList.add('is-aan'); return; }
        const a = typeof streep.getAnimations === 'function' ? streep.getAnimations()[0] : undefined;
        if (a) a.currentTime = 0;
        else { streep.classList.remove('is-aan'); requestAnimationFrame(() => streep.classList.add('is-aan')); }
      };
      const toon = (k: number) => {
        nu = (k + standen.length) % standen.length;
        const s = standen[nu];
        root.dataset.set = s.set;
        fotos.forEach((f, j) => f.classList.toggle('is-nu', j === nu));
        const set = data.sets[s.set];
        if (naam.textContent !== set.naam) { naam.textContent = set.naam; wissel(naam); }
        if (wat.textContent !== set.wat) { wat.textContent = set.wat; wissel(wat); }
        teller.textContent = `${nu + 1} / ${standen.length}`;
        /* De streep opnieuw laten beginnen, met de duur van deze stand. */
        herstartStreep(s.duur);
      };

      /* Een foto klaarzetten: hij doet mee in de opmaak (is-klaar, nog onzichtbaar),
         laadt, en wordt gedecodeerd voor hij in beeld komt. */
      const klaar = new Map<number, Promise<void>>();
      const klaarVoor = (k: number) => {
        if (klaar.has(k)) return klaar.get(k)!;
        const img = fotos[k];
        img.classList.add('is-klaar');
        img.loading = 'eager';
        const binnen = img.complete && img.naturalWidth > 0
          ? Promise.resolve()
          : new Promise<void>((r) => { img.addEventListener('load', () => r(), { once: true }); img.addEventListener('error', () => r(), { once: true }); });
        const p = binnen.then(() => (typeof img.decode === 'function' ? img.decode().catch(() => {}) : undefined)).then(() => {});
        klaar.set(k, p);
        return p;
      };
      let beurt = 0;
      let onderweg: number | null = null;
      const ga = (stap: number) => {
        /* Twee keer snel op de pijl: de tweede telt vanaf waar de eerste heen ging. */
        const doel = ((onderweg ?? nu) + stap + standen.length) % standen.length;
        onderweg = doel;
        const deze = ++beurt;
        klaarVoor(doel).then(() => { if (deze === beurt) { onderweg = null; toon(doel); klaarVoor((doel + 1) % standen.length); } });
      };
      streep.addEventListener('animationend', () => { if (loopt) ga(1); });

      for (const knop of root.querySelectorAll<HTMLButtonElement>('[data-hl-stap]')) {
        knop.addEventListener('click', () => { loopt = false; stand(); ga(Number(knop.dataset.hlStap)); });
      }
      pauze.hidden = rustig;
      pauze.addEventListener('click', () => { loopt = !loopt; stand(); });
      doos.addEventListener('pointerenter', () => { erboven = true; stand(); });
      doos.addEventListener('pointerleave', () => { erboven = false; stand(); });
      root.addEventListener('focusin', () => { erboven = true; stand(); });
      root.addEventListener('focusout', () => { erboven = false; stand(); });
      new IntersectionObserver(([e]) => { zicht = e.isIntersecting; stand(); }, { threshold: 0.35 }).observe(doos);

      toon(0);
      stand();
      /* De volgende stand meteen klaarzetten; de rest pas als de pagina rust, één
         tegelijk. Niet bij "databesparing": dan alleen steeds de volgende. */
      klaarVoor(0).then(() => klaarVoor(1));
      const zuinig = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData === true;
      if (!zuinig) {
        const vooruit = async () => { for (let k = 0; k < standen.length; k++) await klaarVoor(k); };
        const rust = (window as Window & { requestIdleCallback?: (f: () => void, o?: { timeout: number }) => number }).requestIdleCallback;
        const start = () => (rust ? rust(() => { vooruit(); }, { timeout: 4000 }) : window.setTimeout(() => { vooruit(); }, 1500));
        if (document.readyState === 'complete') start(); else window.addEventListener('load', start, { once: true });
      }
    }
  };
  zet();
  document.addEventListener('astro:page-load', zet);
</script>
