---
import { waHref } from '../data/whatsapp.js';
// VISUAILS — /models, "The standard library".
//
// One component for both languages, same reason as every other paired page:
// the brief requires EN and NL to change together, and one source file is the
// only way to guarantee that rather than merely intend it.
//
// WHY THIS FILE EXISTS AGAIN. /models used to be its own page, then
// AUDIT-TASK-0.md §H·8 folded it into /custom-models as a #standard block and
// 301'd this URL there (task, pre-#268) — the standard roster and the
// exclusive Brand Model were "one story told twice" (§D) and /custom-models
// told it better. That reasoning still holds for the STORY. It stopped
// holding for the PAGE: /custom-models' hero, H1 and eyebrow all argue the
// exclusive case, so a visitor who only wants the ten shared models has to
// read past an upsell to reach them, and the only way back to them is a
// fragment link nobody types from a search result. Lucas asked the entry
// point back (task #268/#270, 2026-07-29 — see §H·8's own addendum for the
// full account). This page is that entry point.
//
// NOT A DUPLICATE OF /custom-models#standard. Two pages indexing the same ten
// portraits under the same argument would be exactly the duplicate-content
// problem §D named. So the roster itself moved to src/data/models.js as a
// shared source (both pages import ROSTER; neither types a name or a photo
// path twice), and the two pages now argue different things: /custom-models
// makes the case FOR paying once for an exclusive face; this page makes the
// case that you do not have to — the ten here are already paid for, in every
// drop, by everyone. /custom-models keeps a four-model taste of the roster
// under #standard with a link here for the rest; this page closes with a link
// the other way, to /custom-models, for the visitor who reads all ten and
// wants one nobody else can have.
//
// EVERY EURO ON THIS PAGE, IF ANY EVER LANDS HERE, COMES FROM
// src/data/pricing.js. As shipped this page states that the roster carries no
// separate fee rather than stating a number — Section 13 of the brief keeps
// per-product tier pricing off pages that are not /pricing, /catalog,
// /lifestyle or /video, and this is not one of those four.
import '../styles/stijl22.css';
import { localizedPath } from '../i18n/ui.js';
import { ROSTER, TRAITS, modelId } from '../data/models.js';
// Het aantal in de lopende tekst komt uit de roster hierboven en wordt niet
// ingetypt — zie de noot bij ROSTER_COUNT in src/data/models.js.
import { rosterWoord } from '../data/models.js';

interface Props { lang: 'en' | 'nl'; }
const { lang } = Astro.props;
const lp = (p: string) => localizedPath(lang, p);

const COPY = {
  en: {
    eyebrow: 'The standard library',
    h1a: `${rosterWoord('en', true)} faces.`,
    h1b: 'Already included.',
    lead: 'Shared across every brand we work with, and included in every order at no extra cost. Pick one yourself, or tell us the product and the customer and we match one for you.',
    ctaPrimary: 'Start an order',
    ctaWa: 'Discuss it on WhatsApp',
    waText: 'Hi VISUAILS, I\'d like to ask about the standard models.',
    heroAlt: 'A VISUAILS standard model',
    trust: [
      ['No fee', 'per model, ever'],
      [`${rosterWoord('en', true)} faces`, 'shared across brands'],
      // Was 'drop to drop'. See PricingPage.astro's header: a drop is a
      // collection going live, which is the CLIENT's word for their own
      // launch, not the name of anything we sell.
      ['Swap freely', 'order to order'],
    ],

    rosterMeta: `( All ${rosterWoord('en')} )`,
    rosterH: 'The full roster',
    rosterSub: 'At a size you can actually judge a face at — square plates, not sixty-pixel thumbnails.',
    modelAlt: 'a VISUAILS standard model',
    chooseH: 'Let us match one',
    chooseBody: 'Tell us the product and the customer when you start an order, and we pick the model that fits — then keep using it.',

    incMeta: '( What it costs )',
    incH: 'Included, not upsold.',
    incBody: 'Every order already includes a model from this roster. There is no per-model fee and no upgrade to unlock one — the price on /pricing is the whole price.',
    /* De Engelse tegenhanger van "Bekijk alle prijzen per aantal". Tot 24
       augustus 2026 stond hier hetzelfde als bij `ctaPricing` verderop — twee knoppen
       met dezelfde tekst naar dezelfde pagina — terwijl het Nederlands die twee
       al uit elkaar hield. Dat was geen smaakverschil maar een halve ronde: de
       tekstronde raakte de Nederlandse regel wel en de Engelse niet. */
    incCta: 'See all prices by quantity',

    doorH: 'Want a face that’s only yours?',
    doorBody: `A Brand Model is designed once, exclusively for your brand, and never appears anywhere else — the ${rosterWoord('en')} above are shared; that one would not be.`,
    doorCta: 'Explore Your Brand Model',

    ctaH1: 'Pick a face,',
    ctaEm: 'start an order.',
    ctaStart: 'Start an order',
    ctaPricing: 'See pricing per product',
    ctaWaShort: 'WhatsApp',
  },
  nl: {
    eyebrow: 'De standaardbibliotheek',
    h1a: `${rosterWoord('nl', true)} gezichten.`,
    h1b: 'Al inbegrepen.',
    lead: `Deze ${rosterWoord('nl')} gebruiken we voor elk merk waarmee we werken, en ze zitten in elke bestelling zonder extra kosten. Kies er zelf een, of vertel ons wat je verkoopt en wie je klant is, dan kiezen wij er een dat past.`,
    ctaPrimary: 'Start een bestelling',
    ctaWa: 'Bespreek het op WhatsApp',
    waText: 'Hoi VISUAILS, ik wil graag iets vragen over de standaardmodellen.',
    heroAlt: 'Een VISUAILS-standaardmodel',
    trust: [
      ['Geen kosten', 'per model, nooit'],
      [`${rosterWoord('nl', true)} gezichten`, 'die we voor alle merken gebruiken'],
      ['Vrij wisselen', 'van bestelling tot bestelling'],
    ],

    rosterMeta: `( Alle ${rosterWoord('nl')} )`,
    rosterH: 'De volledige bibliotheek',
    rosterSub: 'Op een formaat waarop je een gezicht echt kunt beoordelen — grote vierkante foto’s, geen miniatuurtjes van zestig pixels.',
    modelAlt: 'een VISUAILS-standaardmodel',
    chooseH: 'Laat ons matchen',
    chooseBody: 'Vertel ons het product en de klant wanneer je een bestelling start, dan kiezen wij het model dat past — en blijven we dat gebruiken.',

    incMeta: '( Wat het kost )',
    incH: 'Inbegrepen, niet iets wat je erbij moet kopen.',
    incBody: 'Elke bestelling bevat al een model uit deze bibliotheek. Er zijn geen kosten per model en je hoeft niets bij te kopen om er een te mogen gebruiken — de prijs op de prijzenpagina is de hele prijs.',
    incCta: 'Bekijk alle prijzen per aantal',

    doorH: 'Wil je een gezicht dat alleen van jou is?',
    doorBody: `Een merkmodel wordt één keer ontworpen, exclusief voor jouw merk, en verschijnt nergens anders — de ${rosterWoord('nl')} hierboven zijn gedeeld; dat model zou dat niet zijn.`,
    doorCta: 'Ontdek jouw merkmodel',

    ctaH1: 'Kies een gezicht,',
    ctaEm: 'start een bestelling.',
    ctaStart: 'Start een bestelling',
    ctaPricing: 'Bekijk de prijs per product',
    ctaWaShort: 'WhatsApp',
  },
};

const c = COPY[lang];
const traits = TRAITS[lang];
const wa = waHref(c.waText);
const nn = (i: number) => String(i).padStart(2, '0');
---

{/* ═══ /models IN DE STIJL VAN SECTIE 22 — 7 september 2026 ═══════════════════
    Lucas: *"Ik wil dat je deze website gaat bouwen met deze style."* De
    voorpagina ging eerst; dit is de tweede pagina, en de eerste die de stijl
    uit src/styles/stijl22.css leest in plaats van hem over te typen. De inhoud
    is niet aangeraakt: dezelfde COPY, dezelfde roster uit models.js, dezelfde
    links. Alleen de vorm is nieuw — panelen op inkt, één donkere kamer met een
    spookwoord, en het gele paneel als slot. */}
<div class="s22">

  {/* ── 1 · DE OPENING ───────────────────────────────────────────────────────
      Geen tweede VEXO-hero: dat blijft van de voorpagina. Hier één licht
      paneel, tekst links, één portret rechts als kaart. */}
  <section class="paneel mp-open" aria-labelledby="mp-h1">
    <div class="mp-open-in">
      <div class="paneel-kop">
        <p class="etiket">{c.eyebrow}</p>
        <h1 id="mp-h1" class="hoog">{c.h1a} <em>{c.h1b}</em></h1>
        <p class="lopend">{c.lead}</p>
        <p class="acties">
          <a class="knop knop-inkt" href={lp('/start')}>{c.ctaPrimary}</a>
          <a class="knop knop-lijn" href={wa} target="_blank" rel="noopener">{c.ctaWa}</a>
        </p>
      </div>
      <figure class="kaart kaart-stil mp-portret">
        <img src="/img/model-01.webp" alt={c.heroAlt} width="800" height="1071" decoding="sync" fetchpriority="high" />
      </figure>
    </div>
    <ul class="maatlijn mp-maatlijn" role="list">
      {c.trust.map((t) => <li><span><b>{t[0]}</b> — {t[1]}</span></li>)}
    </ul>
  </section>

  {/* ── 2 · DE VOLLEDIGE BIBLIOTHEEK ─────────────────────────────────────────
      Tien portretten op ware grootte — de belofte van de kop hierboven is dat
      je een gezicht kunt beoordelen, dus geen miniaturen. De elfde tegel is
      geen gezicht maar het aanbod om er een te kiezen. */}
  <section class="paneel" aria-labelledby="mp-roster">
    <header class="paneel-kop">
      <p class="etiket">{c.rosterMeta}</p>
      <h2 id="mp-roster" class="hoog hoog-2">{c.rosterH}</h2>
      <p class="lopend">{c.rosterSub}</p>
    </header>
    <ul class="rooster" role="list">
      {ROSTER.map((m, i) => (
        <li>
          <a class="kaart kaart-stil" href={`${lp('/models')}#${modelId(m.name)}`} id={modelId(m.name)}>
            <img src={m.thumb} alt={`${m.name} — ${c.modelAlt}`} loading="lazy" decoding="async" width={m.tw} height={m.th} transition:name={`face-${modelId(m.name)}`} />
          </a>
          <p class="mp-naam"><b>{m.name}</b><span class="mono">{m.traits.map((t) => traits[t]).join(' · ')}</span></p>
        </li>
      ))}
      <li class="mp-kies">
        <div class="mp-kies-in">
          <h3 class="hoog hoog-3">{c.chooseH}</h3>
          <p class="lopend">{c.chooseBody}</p>
          <a class="pijl" href={lp('/start')}>{c.ctaPrimary}</a>
        </div>
      </li>
    </ul>
  </section>

  {/* ── 3 · WAT HET KOST ─────────────────────────────────────────────────────
      De donkere kamer van deze pagina. Links de zin die het argument draagt,
      rechts de deur naar het merkmodel — twee blokken, geen derde raster. */}
  <section class="kamer mp-kamer" aria-labelledby="mp-inc">
    <header class="kamer-kop">
      <p class="etiket">{c.incMeta}</p>
      <h2 id="mp-inc" class="hoog hoog-2">{c.incH}</h2>
    </header>
    <div class="mp-twee">
      <div class="mp-inc">
        <p class="lopend">{c.incBody}</p>
        <p class="acties"><a class="pijl" href={lp('/pricing')}>{c.incCta}</a></p>
      </div>
      <div class="mp-deur">
        <h3 class="hoog hoog-3">{c.doorH}</h3>
        <p class="lopend">{c.doorBody}</p>
        <p class="acties"><a class="pijl" href={lp('/custom-models')}>{c.doorCta}</a></p>
      </div>
    </div>
  </section>

  {/* ── 4 · HET SLOT ─────────────────────────────────────────────────────────*/}
  <section class="paneel paneel-slot" aria-labelledby="mp-slot">
    <h2 id="mp-slot" class="hoog">{c.ctaH1} <em>{c.ctaEm}</em></h2>
    <p class="acties">
      <a class="knop knop-inkt" href={lp('/start')}>{c.ctaStart}</a>
      <a class="knop knop-lijn" href={lp('/pricing')}>{c.ctaPricing}</a>
      <a class="knop knop-lijn" href={wa} target="_blank" rel="noopener">{c.ctaWaShort}</a>
    </p>
  </section>
</div>

<style>
  /* Alleen wat deze pagina eigen is; de rest komt uit stijl22.css. */
  .mp-open-in { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, .85fr); gap: clamp(1.5rem, 5vw, 4.5rem); align-items: center; }
  .mp-open .paneel-kop { margin-bottom: 0; }
  /* ── HORIZONTAAL, NIET VERTICAAL — 9 september 2026 ───────────────────────
     Lucas: *"Ik wou ook dat de afbeeldingen in 1 scherm paste maar dat is nog
     steeds niet zo. Dit soort afbeeldingen werken niet zo fijn op een website.
     Maak al dit soort afbeeldingen horizontaal lang en niet verticaal."*

     Gemeten op 1440 breed: dit beeld stond op 532×710. Een staand beeld naast een
     kolom tekst duwt de sectie hoger dan het scherm, en dan lees je de tekst
     ernaast nooit in één blik. 3/2 is liggend zonder een filmstrook te worden;
     `object-position` houdt het onderwerp in beeld nu er van boven en onder
     wordt bijgesneden.

     DE KLEINE TEGELS BLIJVEN STAAND. Een producttegel in een raster (de
     galerij, de modellen, de voorbeelden) is een FOTO die je bekijkt, geen
     sectiebeeld dat naast tekst moet passen — en staand is de vorm waarin die
     beelden gemaakt zijn. */
  .mp-portret { aspect-ratio: 3 / 2; }
  .mp-portret img { object-position: 50% 32%; }
  .mp-maatlijn { margin: clamp(2.5rem, 5vw, 4rem) 0 0; padding-inline: 0; background: none; }
  .mp-maatlijn b { font-weight: 500; }

  /* Vier portretten op een rij, groot genoeg om een gezicht te beoordelen. */
  /* ── VIJF PER RIJ IN PLAATS VAN VIER — 8 september 2026 ────────────────────
     Lucas: *"Modellen pagina kan ook wat compacter."*

     Gemeten: het rooster was 1345px hoog en de pagina 4931, voor een pagina die
     tien gezichten laat zien. Met vier kolommen vielen elf tegels (tien
     modellen plus de kies-kaart) in drie rijen van 4-4-3, met een gat rechts
     onderin dat er als een ontbrekend model uitzag.

     Vijf kolommen is precies 5-5-1 — nog steeds een gat. Zes is 6-5, en dat
     klopt: elf items, twee rijen, geen gat. De tegels worden smaller maar
     blijven op 4/5 staan, en dat is nog altijd ruim boven wat de kop van deze
     sectie belooft ("geen miniatuurtjes van zestig pixels") — op 1440 is een
     tegel 210px breed.

     `auto-fit` met een ondergrens en niet een vast getal: dan schuift het
     vanzelf naar vijf, vier, drie en twee als het scherm smaller wordt, en
     hoeven de twee breekpunten hieronder alleen nog de telefoon te regelen. */
  .rooster { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(11.5rem, 100%), 1fr)); gap: clamp(.7rem, 1.6vw, 1.2rem); }
  .rooster li { display: grid; gap: .7rem; align-content: start; }
  .mp-naam { display: grid; gap: .15rem; }
  .mp-naam b { font-weight: 500; font-size: .95rem; }
  .mp-naam .mono { color: var(--inkt-2); }
  .mp-kies { grid-column: span 2; }
  .mp-kies-in { display: grid; gap: .8rem; justify-items: start; height: 100%; align-content: center; padding: clamp(1.25rem, 3vw, 2rem); border: 1px solid var(--lijn-sterk); border-radius: calc(var(--ronding) - 8px); }

  .mp-twee { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: clamp(1.5rem, 4vw, 3.5rem); align-items: start; }
  .mp-deur { padding: clamp(1.25rem, 3vw, 2rem); border: 1px solid rgb(245 245 245 / .22); border-radius: calc(var(--ronding) - 8px); display: grid; gap: .8rem; }

  @media (max-width: 900px) {
    .mp-open-in, .mp-twee { grid-template-columns: 1fr; }
    /* Het rooster staat hier NIET meer op twee kolommen. Met `auto-fit`
       hierboven regelt het zichzelf — op 768px worden dat er drie, en die
       regel dwong ze terug naar twee: gemeten 2584px rooster waar 1700 kon.
       Alleen de telefoon heeft nog een eigen regel, hieronder. */
    .mp-kies { grid-column: span 2; }
  }
  /* ── OOK OP EEN TELEFOON TWEE PER RIJ — 8 september 2026 ──────────────────
     Hier stond `1fr` onder 560px: elf portretten over de volle breedte onder
     elkaar. Gemeten op 390px was het rooster daarmee 4955px hoog — bijna zes
     schermen aan gezichten, op een pagina die "compacter" moest.

     Twee per rij maakt een tegel 145px breed, en dat is precies waar de kop van
     deze sectie over gaat: groot genoeg om een gezicht op te beoordelen, en niet
     de miniatuurtjes van zestig pixels waar hij zich tegen afzet. De kies-kaart
     loopt over allebei de kolommen, want daar staat tekst in. */
  @media (max-width: 560px) {
    .rooster { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .mp-kies { grid-column: span 2; }
  }
</style>
