---
/*
 * VISUAILS — DE ABONNEMENTSKAMER — 3 september 2026, herbouwd 9 september
 * ═══════════════════════════════════════════════════════════════════════════
 *
 * Lucas, 3 september: *"Ook hebben we af en toe van dit soort Subscription
 * secties die heel klein worden geplaatst tussen secties. Dit slaat nergens op
 * want het abonnementsmodel is misschien wel het handigste wat een klant kan
 * kopen (…). Dit moet veel mooier gemaakt worden dan dit en wellicht een
 * sfeerbeeld toevoegen als achtergrond."*
 *
 * ── WAAROM HIJ OP 9 SEPTEMBER OPNIEUW IS GEBOUWD ────────────────────────────
 *
 * Lucas: *"Deze sectie voelt ook heel erg random en kan beter in de website
 * geïntegreerd worden."*
 *
 * Hij voelde random omdat hij van een ANDERE website was. Wat hier stond, was
 * een `.band` uit het oude ontwerpsysteem — een donkere rechthoek die op
 * /pricing in een licht `.paneel` werd gelegd, dus een donker vlak in een witte
 * kaart op een donkere ondergrond: drie kaders om elkaar heen. En hij sprak een
 * andere taal dan de rest van de pagina:
 *
 *     de pagina             deze band
 *     ─────────────────────────────────────────────────────────────
 *     .etiket erboven       geen etiket
 *     .hoog — kapitaal,     Satoshi in zinsvorm, 4,6rem
 *       smal, strak
 *     .lopend              een eigen `font-size` en `max-width`
 *     .knop — pilvorm,      .btn uit global.css
 *       mono, kapitaal
 *     .kamer — donker,      een eigen `.band` met eigen padding
 *       van de paginagrond
 *
 * Nu is hij een KAMER: hetzelfde blok dat /pricing en /plans al gebruiken voor
 * hun donkere hoofdstuk, met dezelfde kop, dezelfde etiketten, dezelfde
 * knoppen. Wat hij extra houdt is de foto als grond — dat was Lucas' vraag van
 * 3 september en die staat nog — en dat hij van rand tot rand loopt. Dat
 * laatste is precies wat hem van de kamer erboven onderscheidt: die is een
 * ingekaderde kaart, deze vult het scherm. Zo is het verschil tussen de twee
 * donkere stukken een BEDOELING en niet een toeval.
 *
 * Wat het NIET is: een prijsblok. De drie plannen staan op /plans met de uitleg
 * die ze nodig hebben; deze kamer zegt dat het bestaat, waarom het handig is en
 * dat je het zelf kunt inrichten — en stuurt door.
 */
import { localizedPath } from '../i18n/ui.js';
import { euro, PLAN_AMOUNT, CUSTOM_MONTH_MIN_PRODUCTS } from '../data/pricing.js';
import { planName } from '../data/planNames.js';

interface Props { lang: 'en' | 'nl'; id?: string }
const { lang, id } = Astro.props;
const lp = (p: string) => localizedPath(lang, p);
const nl = lang === 'nl';
const laagste = Math.min(...Object.values(PLAN_AMOUNT));

/* De kop is gesplitst. Hij stond als één zin van twee delen in de h2 — in
   kapitalen op de koplettergrootte werden dat vijf regels, waar elke andere kop
   op deze pagina er twee heeft. Het eerste deel is nu de kop, het tweede de
   eerste zin van de lead: dezelfde belofte, in het ritme van de pagina. */
const c = nl ? {
  etiket: 'Abonnement',
  h: 'Elke maand nieuwe beelden',
  lede: 'Zonder elke maand te bestellen. Een abonnement is de rustigste manier om te blijven posten: een vast aantal producten per maand, een lager tarief dan per bestelling, en een week in onze agenda die van jou is. En je richt de maand zelf in — precies wat je nodig hebt, niet meer.',
  facts: [
    [`Vanaf ${euro(laagste, 'nl')} per maand`, `${planName('starter', 'nl')}, ${planName('studio', 'nl')} of ${planName('brand', 'nl')} — een vast aantal producten, elke maand.`],
    [`Of jouw ${planName('maat', 'nl').toLowerCase()}`, `Vanaf ${CUSTOM_MONTH_MIN_PRODUCTS} producten: jij kiest per maand exact hoeveel catalogsets, carrousels en clips.`],
    ['Een week die van jou is', 'Je leverweek staat elke maand vast in onze agenda. Geen wachtrij, geen agendacheck.'],
  ],
  cta: 'Bekijk de abonnementen',
  cta2: 'Stel je maand zelf samen',
  vat: 'Alle bedragen excl. btw.',
} : {
  etiket: 'Plan',
  h: 'New images every month',
  lede: 'Without ordering every month. A plan is the calmest way to keep posting: a fixed number of products a month, a lower rate than order by order, and a week in our calendar that is yours. And you shape the month yourself — exactly what you need, nothing more.',
  facts: [
    [`From ${euro(laagste, 'en')} a month`, `${planName('starter', 'en')}, ${planName('studio', 'en')} or ${planName('brand', 'en')} — a fixed number of products, every month.`],
    [`Or your ${planName('maat', 'en').toLowerCase()}`, `From ${CUSTOM_MONTH_MIN_PRODUCTS} products: you decide each month exactly how many catalog sets, carousels and clips.`],
    ['A week that is yours', 'Your delivery week is held in our calendar every month. No queue, no calendar check.'],
  ],
  cta: 'See the plans',
  cta2: 'Build your own month',
  vat: 'All amounts excl. VAT.',
};
---

<section class="kamer plan-band" id={id} aria-labelledby="plan-band-h">
  <img
    class="plan-band-bg"
    src="/img/brand-stair-w1560.webp"
    alt=""
    width="1560"
    height="1040"
    loading="lazy"
    decoding="async"
  />
  <div class="plan-band-scrim" aria-hidden="true"></div>

  <header class="kamer-kop">
    <p class="etiket">{c.etiket}</p>
    <h2 class="hoog hoog-2" id="plan-band-h">{c.h}</h2>
    <p class="lopend">{c.lede}</p>
  </header>

  <dl class="plan-band-facts">
    {c.facts.map(([k, v]) => (
      <div class="plan-band-fact">
        <dt class="mono">{k}</dt>
        <dd class="lopend">{v}</dd>
      </div>
    ))}
  </dl>

  <p class="acties plan-band-acties">
    <a class="knop knop-wit" href={lp('/plans')}>{c.cta}</a>
    <a class="knop plan-band-lijn" href={`${lp('/start/plan')}?plan=maat`}>{c.cta2}</a>
  </p>
  <p class="mono plan-band-vat">{c.vat}</p>
</section>

<style>
  /* ── VAN RAND TOT RAND ────────────────────────────────────────────────────
     Elke kamer en elk paneel op een pagina van sectie 22 is een kaart: marge
     aan alle kanten, ronding aan alle hoeken. Deze niet — hij draagt een foto,
     en dan is de marge geen ademruimte maar een streep die het beeld afknipt.
     Dat is dezelfde afweging als bij `.vol` in stijl22.css; alleen de zijkanten
     en de hoeken, want de marge BOVEN en ONDER houdt hem los van zijn buren.

     Astro hangt hier een `data-astro-cid`-attribuut aan, en dat weegt zwaarder
     dan `.s22 :is(.paneel, .kamer)` in het stijlblad. Vandaar dat deze twee
     regels winnen zonder dat er `.s22.s22` voor hoeft. */
  .plan-band {
    margin-inline: 0;
    border-radius: 0;
    isolation: isolate;
    overflow: clip;
  }

  /* Drie lagen: foto op -2, sluier op -1, inhoud erboven. De sluier is aan de
     boven- en onderkant het donkerst, zodat de kamer uit de paginagrond komt in
     plaats van er als een blok op te beginnen. */
  .plan-band-bg {
    position: absolute; inset: 0; z-index: -2;
    width: 100%; height: 100%; object-fit: cover; object-position: 60% 40%;
    opacity: .62;
    pointer-events: none;
  }
  .plan-band-scrim {
    position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background:
      linear-gradient(to bottom, rgb(27 28 30 / 0.94) 0%, rgb(27 28 30 / 0.58) 22%, rgb(27 28 30 / 0.58) 78%, rgb(27 28 30 / 0.94) 100%),
      linear-gradient(to right, rgb(27 28 30 / 0.80) 0%, rgb(27 28 30 / 0.46) 55%, rgb(27 28 30 / 0.18) 100%);
  }

  /* De kop houdt de breedte van elke andere kamerkop (46rem); alleen de lead
     mag hier iets breder omdat er drie zinnen in staan. */
  .plan-band .lopend { max-width: 52ch; }

  /* Geen kaarten: een lichtlijn bovenlangs en tekst eronder — dezelfde vorm als
     de feitenrij onder de homepagehero en als `.pr-regels` op deze pagina. */
  .plan-band-facts {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr));
    gap: clamp(1rem, 2.4vw, 2rem);
    max-width: 62rem;
  }
  .plan-band-fact { padding-top: .9rem; border-top: 1px solid rgb(245 245 245 / .3); }
  .plan-band-fact dt { margin: 0; color: var(--vel); }
  .plan-band-fact dd { margin: .5rem 0 0; font-size: .92rem; line-height: 1.55; max-width: 34ch; }

  .plan-band-acties { margin: clamp(1.8rem, 3.4vw, 2.6rem) 0 0; }
  /* Een lijnknop op een donkere grond: `.knop-lijn` zet inkt op inkt, want die
     is voor de lichte panelen gemaakt. Hier is de lijn en de letter het vel.
     Dezelfde zet als `.pl-knop-lijn` op /plans. */
  .plan-band-lijn { color: var(--vel); }
  .plan-band-lijn:hover { background: var(--vel); color: var(--inkt); }
  /* 1,4rem en niet .9: de meter zag 14px tussen de knoppenrij en deze regel,
     en dat is krapper dan de ondergrens die de rest van de site aanhoudt. */
  .plan-band-vat { margin: 1.4rem 0 0; color: rgb(245 245 245 / .6); }
</style>
