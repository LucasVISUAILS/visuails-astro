---
/**
 * VISUAILS — de voorpagina. Van de grond af opnieuw, 23 september 2026.
 * ═══════════════════════════════════════════════════════════════════════════
 *
 * Lucas: *"bedenk hoe de VISUAILS homepagina verbeterd kan worden met name door
 * het zo te maken dat klanten snel begrijpen wat ze kunnen verwachten en hoe het
 * systeem werkt"* — en bij het bouwen: *"Veel witruimte, rust en weinig maar
 * directe en logische tekst."*
 *
 * Het plan staat in kladblok/VOORPAGINA-OPBOUW.md en de blauwdruk in
 * kladblok/voorpagina-opbouw.html. De kern: de oude pagina was opgebouwd als
 * catalogus van wat wij hebben (diensten, sets, tarieven, gezichten). Deze volgt
 * de vragen van de bezoeker, in de volgorde waarin hij ze stelt:
 *
 *    0  Opening          wat is het
 *    1  Maatlijn         in één blik
 *    2  Voor en na       is het goed
 *    3  De band          hoe werkt het
 *    4  Wat we maken     wat kan ik kiezen
 *    5  De looks         past het bij mijn merk
 *    6  Gezichten        wat zit er nog meer in
 *    7  Editions         en daarna
 *    8  Voor wie         is dit voor mij
 *    9  Direct antwoord  wat als
 *   10  Proef            hoe begin ik
 *
 * WEG, en waarom: "De catalogset. De carrousel. Of allebei." en "Eén tarief per
 * product. Daalt met het aantal." herhaalden wat de tegels en de maatlijn al
 * zeiden; de staffel is /pricing. De vierde tegel ("alle diensten") was een deur
 * die op een dienst leek. De etiketten boven elke kop zijn weg: "WAT WE MAKEN"
 * boven "Wat we maken." zegt twee keer hetzelfde.
 *
 * GEEN ENKEL GETAL IS GETYPT. Prijzen uit euro()/AMOUNT, aantallen uit
 * pricing.js en lexicon.js, het aantal verplichte foto's uit shots.js, de grens
 * van de eigen week uit WINDOW_THRESHOLD, het aantal gezichten uit ROSTER.
 *
 * BEELDEN DIE NOG NIET BESTAAN krijgen in de build een plaatshouder met naam en
 * maat (scripts/plaatshouders.mjs): `editions-breed` (21:9, blok 7) en
 * `editions-staand` (4:5, de Editions-kaart in de looks). Lucas zet het bestand
 * onder die naam in public/img en het staat er.
 */
/* De letters: Anybody (koppen), Figtree (tekst), Martian Mono (labels). Zelf
   gehost, geen externe verbinding. */
import '@fontsource-variable/anybody/standard.css';
import '@fontsource-variable/figtree/index.css';
import '@fontsource-variable/martian-mono/standard.css';
import {
  AMOUNT, euro, TEST_SAMPLE, reviewClaim, WINDOW_THRESHOLD,
  CATALOG_IMAGES, LIFESTYLE_IMAGES, videoPrijsLabel,
} from '../data/pricing.js';
import { countedShort, setSize } from '../data/lexicon.js';
import { MERK, TAGLINE } from '../data/brand.js';
import { binnenkortNamen } from '../data/binnenkort.js';
import { localizedPath } from '../i18n/ui.js';
import { ROSTER, modelId, telwoord } from '../data/models.js';
import { REQUIRED_SHOT_IDS } from '../data/shots.js';
import { geleverd } from '../data/voorbeeldset.js';
import '../styles/stijl22.css';
import LaptopCarousel from './LaptopCarousel.astro';
import LopendeBand from './LopendeBand.astro';
import Compare from './Compare.astro';
import Stijlstrook from './Stijlstrook.astro';

const { lang } = Astro.props as { lang: 'en' | 'nl' };
const nl = lang === 'nl';
const lp = (p: string) => localizedPath(lang, p);
const sample = TEST_SAMPLE[lang];
const e = (n: number) => euro(n, lang);

/* "Drie telefoonfoto's zijn genoeg om te beginnen." Het getal komt uit de
   verplichte hoeken in shots.js — tests/uploadbelofte.test.mjs leest deze zin. */
const FOTOS = telwoord(REQUIRED_SHOT_IDS.length, lang, true);
const GEZICHTEN = telwoord(ROSTER.length, lang);

/* De beelden op de drie diensttegels. Catalog: het raster van twaalf stukken op
   wit — dat is wat de dienst IS. De andere twee: een sfeerbeeld, want dat is het
   verschil met catalog. */
const CATALOG_BANNER = { klein: '/img/catalog-raster-w760.webp', w: 1600, h: 1207 };
const sfeer = (n: number, w: number, h: number) => ({ klein: `/img/concept/sfeer-0${n}-w1000.webp`, w, h });
const DIENST_BEELD = [CATALOG_BANNER, sfeer(2, 1248, 1872), sfeer(3, 2000, 1125)];

const COPY = {
  en: {
    plek: 'Enschede, NL',
    h1: TAGLINE.en.lines, h1plain: TAGLINE.en.plain, wissel: TAGLINE.en.wissel,
    lede: 'Send your product photos. Get back catalog, lifestyle and video — no shoot, no minimum.',
    ctaStart: 'Start an order',
    planCta: 'Start a plan',
    facts: [
      'One product is enough, no shoot',
      `From ${e(AMOUNT.catalog)} per product`,
      `As soon as possible · from ${WINDOW_THRESHOLD}: your own week`,
      'Full commercial rights included',
    ],

    vnH: 'What you send. What you get back.',
    vnZin: `${FOTOS} phone photos are all you need to start: front, back and a detail.`,
    vnSpec: [
      ['You get', `${setSize('catalog', CATALOG_IMAGES, 'en')} per product · 2048 px`],
      ['Formats', 'jpg · png · webp'],
    ],
    vnVoorAlt: 'Sent in: a phone photo of a T-shirt on a wooden table',
    vnNaAlt: 'Delivered: the same T-shirt, finished on off-white',
    vnLink: 'More work in the gallery',

    svcH: 'What we make.',
    svcLede: 'Three kinds of image, priced per product.',
    svc: [
      ['Product photos', `${setSize('catalog', CATALOG_IMAGES, 'en')} · front, back, detail, on model`, `from ${e(AMOUNT.catalog)} per product`, '/start/?zie=foto'],
      ['Lifestyle imagery', `${countedShort('lifestyle', LIFESTYLE_IMAGES, 'en')} in one styled scene, ready to post`, `from ${e(AMOUNT.lifestyle)} per product`, '/start/?zie=sfeer'],
      ['Product video', 'One clip per product — eight seconds, one clean move', videoPrijsLabel('en'), '/start/?zie=video'],
    ],
    svcOok: 'Also',
    svcOokRest: 'made to order',

    looksH: 'Pick a look.',
    looksLede: 'Fixed light, place and pose, so your whole collection looks like one shoot.',

    facesH: 'A face comes with it.',
    facesLede: `From a library of ${GEZICHTEN}, at no extra cost. Or a brand model that is yours alone.`,
    facesAll: `All ${GEZICHTEN}`, facesMerk: 'Your brand model',

    edEtiket: 'Coming soon',
    edH: 'Editions. New imagery every month.',
    edZin: 'For the weeks between two collections.',
    edLink: 'How Editions works',
    edAlt: 'An Editions image: a scene in the style of one brand',

    vwH: 'Who it is for.',
    vw: [
      ['You are starting a brand.', `One product is fine, from ${e(AMOUNT.catalog)}.`, 'Catalog', '/catalog'],
      ['You run a shop full of products.', `From ${WINDOW_THRESHOLD} products: your own week, a lower price.`, 'Pricing', '/pricing'],
      ['You order for clients.', 'One account, a different brand per order.', 'How that works', '/faq#getting-started'],
    ],

    qH: 'Straight answers.',
    qs: [
      ['What if the visuals are not right?', 'See Studio', '/portal'],
      ['Will a customer see it is AI?', 'Read the AI Act page', '/ai-act'],
      ['Are my photos good enough?', 'What makes a photo usable', '/upload-guidelines'],
      ['Why not do it myself?', 'The honest comparison', '/compare'],
    ],
    qAll: 'All questions',

    proef: 'Test sample',
    closeH: `See it first. One product for ${sample.price}.`,
    closeLede: `${sample.deliverable} · made from your own photo · ${sample.unit}.`,
    closeAlt: 'Or start an order',
    trust: [['Made by Lucas, in Enschede', '/about'], 'Registered with the KVK', reviewClaim('attended', 'en'), 'Direct line on WhatsApp'],
  },
  nl: {
    plek: 'Enschede, NL',
    h1: TAGLINE.nl.lines, h1plain: TAGLINE.nl.plain, wissel: TAGLINE.nl.wissel,
    lede: 'Stuur je productfoto’s. Krijg catalog, lifestyle en video terug — geen shoot, geen minimum.',
    ctaStart: 'Start een bestelling',
    planCta: 'Sluit een abonnement af',
    facts: [
      'Eén product mag, geen shoot nodig',
      `Vanaf ${e(AMOUNT.catalog)} per product`,
      `Zo snel mogelijk · vanaf ${WINDOW_THRESHOLD}: je eigen week`,
      'Volledige commerciële rechten inbegrepen',
    ],

    vnH: 'Dit stuur jij. Dit krijg je terug.',
    vnZin: `${FOTOS} telefoonfoto’s zijn genoeg om te beginnen: voorkant, achterkant en een detail.`,
    vnSpec: [
      ['Je krijgt', `${setSize('catalog', CATALOG_IMAGES, 'nl')} per product · 2048 px`],
      ['Formaten', 'jpg · png · webp'],
    ],
    vnVoorAlt: 'Ingestuurd: een telefoonfoto van een T-shirt op een houten tafel',
    vnNaAlt: 'Geleverd: hetzelfde T-shirt, afgewerkt op gebroken wit',
    vnLink: 'Meer werk in de galerij',

    svcH: 'Wat we maken.',
    svcLede: 'Drie soorten beeld, per product geprijsd.',
    svc: [
      ['Productfoto’s', `${setSize('catalog', CATALOG_IMAGES, 'nl')} · voor, achter, detail, op model`, `vanaf ${e(AMOUNT.catalog)} per product`, '/start/?zie=foto'],
      ['Lifestyle beelden', `${countedShort('lifestyle', LIFESTYLE_IMAGES, 'nl')} in één gestylede scène, klaar om te posten`, `vanaf ${e(AMOUNT.lifestyle)} per product`, '/start/?zie=sfeer'],
      ['Productvideo’s', 'Eén clip per product — acht seconden, één rustige beweging', videoPrijsLabel('nl'), '/start/?zie=video'],
    ],
    svcOok: 'Ook',
    svcOokRest: 'werk op maat',

    looksH: 'Kies een look.',
    looksLede: 'Vast licht, vaste plek en pose: je hele collectie oogt als één shoot.',

    facesH: 'Een gezicht zit erbij.',
    facesLede: `Uit een bibliotheek van ${GEZICHTEN}, zonder meerprijs. Of een merkmodel dat alleen van jou is.`,
    facesAll: `Alle ${GEZICHTEN}`, facesMerk: 'Jouw merkmodel',

    edEtiket: 'Binnenkort',
    edH: 'Editions. Elke maand nieuw beeld.',
    edZin: 'Voor de weken tussen twee collecties.',
    edLink: 'Hoe Editions werkt',
    edAlt: 'Een Editions-beeld: een scène in de stijl van één merk',

    vwH: 'Voor wie.',
    vw: [
      ['Je begint een merk.', `Eén product mag, vanaf ${e(AMOUNT.catalog)}.`, 'Catalog', '/catalog'],
      ['Je hebt een webshop vol producten.', `Vanaf ${WINDOW_THRESHOLD} producten: je eigen week, een lagere prijs.`, 'Prijzen', '/pricing'],
      ['Je bestelt voor klanten.', 'Eén account, per bestelling een ander merk.', 'Hoe dat werkt', '/faq#getting-started'],
    ],

    qH: 'Direct antwoord.',
    qs: [
      ['Wat als ze niet goed zijn?', 'Bekijk Studio', '/portal'],
      ['Ziet een klant dat het AI is?', 'Lees de AI Act-pagina', '/ai-act'],
      ['Zijn mijn foto’s goed genoeg?', 'Wat maakt een foto bruikbaar', '/upload-guidelines'],
      ['Waarom niet zelf?', 'De eerlijke vergelijking', '/compare'],
    ],
    qAll: 'Alle vragen',

    proef: 'Proef',
    closeH: `Eerst zien? Eén product voor ${sample.price}.`,
    closeLede: `${sample.deliverable} · gemaakt van jouw eigen foto · ${sample.unit}.`,
    closeAlt: 'Of start een bestelling',
    trust: [['Gemaakt door Lucas, in Enschede', '/about'], 'Ingeschreven bij de KVK', reviewClaim('attended', 'nl'), 'Directe lijn via WhatsApp'],
  },
};
const c = COPY[lang];
/* "Ook: Hooks · Editions · werk op maat" — de namen uit binnenkort.js, zodat
   een dienst die erbij komt of verdwijnt hier vanzelf meegaat. */
const ook = [...binnenkortNamen(lang), c.svcOokRest].join(' · ');
const GEZICHTEN_RIJ = ROSTER.slice(0, 5);
---
<div class="s22 thuis">

  {/* ── 0 · OPENING ──────────────────────────────────────────────────────────
      Eén middenas: etiket, kop met het wisselende accentwoord, één zin, twee
      knoppen, en de laptop eronder. Zie .hero-stapel in stijl22.css. */}
  <section class="hero hero-split hero-stapel" aria-labelledby="vp-h1">
    <div class="stralen" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
    <div class="hero-kop">
      <p class="etiket">{MERK} · {c.plek}</p>
      <h1 id="vp-h1" class="hoog hero-h1" aria-label={c.h1plain}>
        {c.h1.map((line, i) => (
          <span class="kop-regel" style={`--i:${i}`} aria-hidden="true">
            {line.includes('<em>') ? (
              <em class="wissel" style={`--n:${c.wissel.length}`}>
                {c.wissel.map((w, j) => <span class="wissel-woord" style={`--j:${j}`}>{w}.</span>)}
              </em>
            ) : <span set:html={line} />}
          </span>
        ))}
      </h1>
      <p class="lopend hero-zin">{c.lede}</p>
      {/* De tweede knop hangt af van wie er staat: een bestaande klant krijgt het
          abonnement in plaats van de proef — zie pasKlantstandToe() in
          interactions.js. Zonder JavaScript blijft de proefknop staan. */}
      <p class="acties hero-acties">
        <a class="knop knop-inkt" href={lp('/start')}>{c.ctaStart}</a>
        <a class="knop knop-lijn" href={lp('/test-sample')} data-vis-uit>{sample.cta}</a>
        <a class="knop knop-lijn" href={lp('/start/plan')} data-vis-in hidden>{c.planCta}</a>
      </p>
    </div>
    <div class="hero-beeld">
      <LaptopCarousel lang={lang} vorm="onder" titel={c.h1plain} />
    </div>
  </section>

  {/* ── 1 · MAATLIJN ───────────────────────────────────────────────────────── */}
  <ul class="maatlijn" role="list">
    {c.facts.map((f) => <li><span>{f}</span></li>)}
  </ul>

  {/* ── 2 · VOOR EN NA ───────────────────────────────────────────────────────
      Bewijs vóór uitleg: wie hier gelooft dat het echt is, leest de rest. Eén
      echt paar — het T-shirt dat een klant op een houten tafel fotografeerde,
      en wat eruit kwam. Links de woorden, rechts de schuifknop. */}
  <section class="paneel vn" aria-labelledby="vp-vn">
    <div class="vn-woord">
      <h2 id="vp-vn" class="hoog hoog-2">{c.vnH}</h2>
      <p class="lopend">{c.vnZin}</p>
      <dl class="vn-spec">
        {c.vnSpec.map(([k, v]) => <div><dt class="mono">{k}</dt><dd>{v}</dd></div>)}
      </dl>
      <p><a class="pijl" href={lp('/gallery')}>{c.vnLink}</a></p>
    </div>
    <div class="vn-beeld">
      <Compare
        ratio="1 / 1"
        before="/img/catalog-before-1x1.webp"
        after="/img/catalog-after.webp"
        beforeAlt={c.vnVoorAlt}
        afterAlt={c.vnNaAlt}
      />
    </div>
  </section>

  {/* ── 3 · DE BAND ──────────────────────────────────────────────────────────
      Van jouw foto naar je shop: vier stations, de tekening in Stations.astro. */}
  <LopendeBand lang={lang} />

  {/* ── 4 · WAT WE MAKEN ─────────────────────────────────────────────────────
      Drie tegels, drie soorten beeld. De rest in één regel eronder. */}
  <section id="maken" class="paneel kiezer" aria-labelledby="vp-sv">
    <header class="paneel-kop">
      <h2 id="vp-sv" class="hoog hoog-2">{c.svcH}</h2>
      <p class="lopend">{c.svcLede}</p>
    </header>
    <ul class="kaarten" role="list">
      {c.svc.map(([naam, wat, prijs, href], i) => (
        <li>
          <a class="kaart" href={lp(href)}>
            <img src={DIENST_BEELD[i].klein} width={DIENST_BEELD[i].w} height={DIENST_BEELD[i].h} alt="" loading="lazy" decoding="async">
            <span class="kaart-pil">
              <span class="kaart-tekst"><b>{naam}</b><span class="mono">{prijs}</span></span>
              <span class="rond" aria-hidden="true">→</span>
            </span>
          </a>
          <p class="kaart-wat">{wat}</p>
        </li>
      ))}
    </ul>
    <p class="voetregel"><span class="mono">{c.svcOok}:</span> <a class="pijl" href={lp('/start')}>{ook}</a></p>
  </section>

  {/* ── 5 · DE LOOKS ─────────────────────────────────────────────────────────
      Wat een modemerk als eerste wil weten: past dit bij mij. Elke kaart gaat
      naar de pagina van die look — zie Stijlstrook.astro. */}
  <section class="paneel" aria-labelledby="vp-lk">
    <header class="paneel-kop">
      <h2 id="vp-lk" class="hoog hoog-2">{c.looksH}</h2>
      <p class="lopend">{c.looksLede}</p>
    </header>
    <Stijlstrook lang={lang} />
  </section>

  {/* ── 6 · EEN GEZICHT ZIT ERBIJ ────────────────────────────────────────────
      De helft van wat hier stond: vijf gezichten in plaats van tien, en twee
      deuren naar de rest. */}
  <section id="gezichten" class="paneel gz" aria-labelledby="vp-gz">
    <div class="gz-woord">
      <h2 id="vp-gz" class="hoog hoog-2">{c.facesH}</h2>
      <p class="lopend">{c.facesLede}</p>
      <p class="gz-links">
        <a class="pijl" href={lp('/models')}>{c.facesAll}</a>
        <a class="pijl" href={lp('/custom-models')}>{c.facesMerk}</a>
      </p>
    </div>
    <ul class="gz-rij" role="list">
      {GEZICHTEN_RIJ.map((m) => (
        <li>
          <a href={`${lp('/models')}#${modelId(m.name)}`}>
            <span class="gz-foto"><img src={m.thumb} width={m.tw} height={m.th} alt={m.name} loading="lazy" decoding="async"></span>
            <span class="mono">{m.name}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  {/* ── 7 · EDITIONS ─────────────────────────────────────────────────────────
      De ene plek waar één groot beeld de pagina lucht geeft — en het is geen
      decoratie: het is de dienst. Banner `editions-breed` (21:9); tot Lucas hem
      maakt, staat er een plaatshouder met die naam en maat. Het violet zit in
      het beeld als licht, niet als vlak (KLEURENSCHEMA.md). */}
  <section class="kamer ed" aria-labelledby="vp-ed">
    <figure class="ed-beeld">
      <img src="/img/editions-breed.webp" width="2400" height="1030" alt={c.edAlt} loading="lazy" decoding="async" data-plaatshouder="donker" />
    </figure>
    <div class="ed-woord">
      <div>
        <p class="etiket">{c.edEtiket}</p>
        <h2 id="vp-ed" class="hoog hoog-2">{c.edH}</h2>
      </div>
      <div class="ed-zin">
        <p class="lopend">{c.edZin}</p>
        <p><a class="pijl" href={lp('/plans#binnenkort')}>{c.edLink}</a></p>
      </div>
    </div>
  </section>

  {/* ── 8 · VOOR WIE ─────────────────────────────────────────────────────────
      Drie situaties, drie antwoorden, drie deuren. Geen kaarten. */}
  <section class="paneel vw" aria-labelledby="vp-vw">
    <h2 id="vp-vw" class="hoog hoog-2">{c.vwH}</h2>
    <ul class="vw-lijst" role="list">
      {c.vw.map(([wie, wat, link, href]) => (
        <li>
          <span class="vw-wie">{wie}</span>
          <span class="lopend vw-wat">{wat}</span>
          <a class="pijl vw-link" href={lp(href)}>{link}</a>
        </li>
      ))}
    </ul>
  </section>

  {/* ── 9 · DIRECT ANTWOORD ──────────────────────────────────────────────── */}
  <section class="paneel" aria-labelledby="vp-q">
    <header class="paneel-kop">
      <h2 id="vp-q" class="hoog hoog-2">{c.qH}</h2>
    </header>
    <ul class="vragen" role="list">
      {c.qs.map(([q, l, href]) => <li><span>{q}</span><a class="pijl" href={lp(href)}>{l}</a></li>)}
      <li><span></span><a class="pijl" href={lp('/faq')}>{c.qAll}</a></li>
    </ul>
  </section>

  {/* ── 10 · DE PROEF ────────────────────────────────────────────────────────
      Woorden links, de vier beelden die de proef oplevert rechts. Dezelfde
      omwisseling als in de opening: een bestaande klant ziet het abonnement. */}
  <section class="paneel paneel-slot slot-proef" aria-labelledby="vp-sl">
    <div class="slot-woord">
      <p class="etiket">{c.proef}</p>
      <h2 id="vp-sl" class="hoog">{c.closeH}</h2>
      <p class="lopend">{c.closeLede}</p>
      <p class="acties">
        <a class="knop knop-inkt" href={lp('/test-sample')} data-vis-uit>{sample.cta}</a>
        <a class="knop knop-inkt" href={lp('/start/plan')} data-vis-in hidden>{c.planCta}</a>
        <a class="knop knop-lijn" href={lp('/start')}>{c.closeAlt}</a>
      </p>
    </div>
    <ul class="slot-beelden" role="list" aria-hidden="true">
      {geleverd(lang).map((b) => <li><img src={b.src} width={b.w} height={b.h} alt="" loading="lazy" decoding="async" /></li>)}
    </ul>
  </section>

  {/* ── 11 · VERTROUWEN ──────────────────────────────────────────────────── */}
  {/* De eerste regel heeft sinds 23 september 2026 een naam en een deur: wie
      "wie zit hierachter?" denkt, komt op /about bij een gezicht uit. */}
  <ul class="trustlijn" role="list">{c.trust.map((t) => <li>{Array.isArray(t) ? <a href={lp(t[1])}>{t[0]}</a> : t}</li>)}</ul>
</div>
