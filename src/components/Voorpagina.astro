    studioLink: 'Bekijk Studio', studioLink2: 'Hoe een bestelling draait',
    beloften: [
      ['Geen definitieve oplevering zonder jouw check', 'Klopt er iets niet? Dan gaan we er samen doorheen tot het klopt.'],
      [RECHTEN.nl, 'Webshop, marktplaatsen, ads en social — zonder extra licentiekosten.'],
    ],
    facesH: 'Kies een gezicht — of claim er een.',
    facesLede: 'Een model uit de roster, of een merkmodel dat niemand anders krijgt. Het gezicht, de achtergrond en het formaat die je goedkeurt blijven bij je merk, dus een volgende bestelling begint waar de vorige ophield.',
    facesLink: 'Hoe een merkmodel werkt', facesLink2: 'De roster',
    qH: 'Direct antwoord.',
    qs: [
      ['Wat als ze niet goed zijn?', 'Bekijk Studio', '/portal'],
      ['Ziet een klant dat het AI is?', 'Lees de AI Act-pagina', '/ai-act'],
      ['Zijn mijn foto’s goed genoeg?', 'Wat maakt een foto bruikbaar', '/upload-guidelines'],
      ['Waarom niet zelf?', 'De eerlijke vergelijking', '/compare'],
    ],
    qAll: 'Alle vragen',
    closeH: `Eerst zien? Eén product voor ${sample.price}.`,
    closeLede: `${sample.deliverable} · gemaakt van jouw eigen foto · ${sample.unit}.`,
    closeAlt: 'Of start een bestelling',
    trust: ['Gemaakt in Enschede, NL', 'Ingeschreven bij de KVK', reviewClaim('attended', 'nl'), 'Directe lijn via WhatsApp'],
  },
};
/* ── HET AANTAL DEUREN KOMT UIT DE LIJST — 10 september 2026 ───────────────
   In de vierde tegel stond "negen deuren", getypt, terwijl de lijst zelf in
   StartPage.astro staat. Toen daar de negende weg ging, klopte dit getal niet
   meer — en niets zou dat gemeld hebben.

   ALLE_DEUREN in eigenproduct.js is de plek waar dat wél opvalt: die lijst
   wordt door tests/eigenproduct.test.mjs regel voor regel vergeleken met de
   deuren die StartPage echt rendert. Een deur erbij of eraf en die toets valt
   om; het getal hier volgt vanzelf. */
const c = { ...COPY[lang] };
c.svcAllPrijs = c.svcAllPrijs.replace('{n}', String(ALLE_DEUREN.length));
const nn = (i: number) => String(i).padStart(2, '0');
/* ── DE BEELDEN ───────────────────────────────────────────────────────────────
   De hero is de echte foto, vrijstaand gemaakt: de studiowand en de olijfgroene
   slagschaduw zijn eruit, zodat de grond van de pagina er doorheen valt en er
   nergens een rand van een foto te zien is. De rest zijn voorlopig de negen
   sfeerbeelden met het groene licht uit Lucas' map — plaatshouders tot de echte
   voorpagina-foto's er zijn, maar wel echte beelden en geen grijs vlak. */
/* ── DE HERO IS EEN FOTO GEWORDEN — 8 september 2026 ────────────────────────
   Lucas stuurde de foto en koos ervoor hem de hele hero te laten vullen. Wat
   hier stond was `hero-model.webp`: één vrijstaande figuur, in zeven banden
   uitgesneden met clip-path, die op zijn plaats schoof. Mooi gemaakt, maar het
   was een SILHOUET op een verloop — de hero liet zien dat er iets bewoog, niet
   wat de studio maakt.

   Deze foto doet dat wel: kleding, licht, huid, een echte scène.

   ── DE TWEEDE FOTO, 8 september 2026 's middags ──────────────────────────
   Lucas stuurde er later op de dag een andere: twee modellen in een witte
   capsule, zwarte kleding, en limoen op de nagels en op de bril. Dat laatste
   is de reden dat hij hier hoort en niet alleen dat hij mooi is — het accent
   van de site zit ín het beeld en niet eromheen, dus de hero draagt de kleur
   in plaats van hem op te leggen. Bovendien: de bovenste veertig procent is
   leeg wit, en dat is precies waar de kop en de knoppen staan.

   2048×1152, en dus 16:9 — de vorm van een hero. Vier maten, want een hero is
   het eerste wat laadt: 640, 960, 1560 en 2048. Niet opgeschaald naar 2560:
   een groter bestand met dezelfde informatie erin is alleen maar trager. */
/* De heropagina-foto is op 17 september uit de opening gehaald; zie de noot bij
   <section class="hero hero-split">. De constante blijft staan omdat het bestand
   er nog is en de galerij hem gebruikt — weghalen zou hier een dood pad zijn,
   maar hem hier nog gebruiken zou een tweede beeld naast de laptop zetten. */
const HERO = '/img/voorpagina/hero-moment.webp';
const b = (n: number, w: number, h: number) => ({
  src: `/img/concept/sfeer-0${n}.webp`, klein: `/img/concept/sfeer-0${n}-w1000.webp`, w, h,
});
const BEELD = [b(1, 2000, 1125), b(2, 1248, 1872), b(3, 2000, 1125), b(4, 1536, 1536), b(5, 2000, 1125), b(6, 1536, 1536), b(7, 1872, 1248), b(8, 2000, 1125), b(9, 2000, 1125)];
const B = (n: number) => BEELD[n - 1];
/* Welk beeld bij welke dienst hoort, en de zeven beelden van één set. */
/* ── VIER TEGELS, EN SINDS 10 SEPTEMBER 2026 DE VIER JUISTE ────────────────
   Lucas: *"Moet 'What we make.' sectie nog rechtgetrokken worden met wat er op
   /start nu staat?"* Ja — de sectie zei "vier diensten" terwijl /start er negen
   opent, hij noemde het merkmodel een dienst terwijl dat een toevoeging bínnen
   een bestelling is (en drie blokken lager al in "Bij hetzelfde product" staat),
   en de bundel — de deur met de laagste prijs per beeld — stond er niet op.

   Wat er NIET gebeurt is alle negen erop zetten. Deze sectie en /start doen
   ander werk: hier staat iemand die nog niet weet wat VISUAILS is, en negen
   tegels is dan een muur. Vier is goed; het waren de verkeerde vier. De link
   eronder brengt wie meer wil zien naar /start, waar ze alle negen staan.

   De beelden: 1 en 2 blijven bij catalog en lifestyle, en de bundel krijgt 3 (de
   trui van dichtbij — een kledingstuk, niet weer een auto-interieur zoals 4, dat
   naast 1 als dezelfde foto zou lezen).

   DRIE EN NIET VIER sinds 10 september 2026: de vierde tegel is de deur naar
   /start geworden en draagt geen foto (zie de noot bij `kaart-deur` verderop).
   De 9 die hier stond was die van de clip en hing nergens meer aan. */
/* ── HET EERSTE BEELD IS EEN CATALOGUS EN GEEN SFEERFOTO — 10 september 2026
   Lucas: *"Pas ook de product- en catalogfoto's foto aan naar de catalog banner
   in de map."*

   Op de tegel "Productfoto's" stond een sfeerbeeld: een model in groen licht.
   Mooi, en het zegt het tegenovergestelde van wat eronder staat — een
   catalogfoto is juist niet moody, hij is schoon, vlak en overal hetzelfde. De
   tegel verkocht daarmee de buurdienst.

   Wat er nu staat is het raster uit /img: twaalf kledingstukken op wit, in
   hetzelfde kader en hetzelfde licht. Dat is letterlijk het product van deze
   dienst, en het is meteen het argument — je ziet in één blik dat een hele
   reeks als één lijn leest.

   De andere twee houden hun sfeerbeeld, en dat is nu geen inconsistentie meer
   maar het verschil zelf: platte productfoto's naast twee beelden met een
   wereld eromheen. De rij toont drie soorten werk in plaats van drie keer
   dezelfde toon. */
const CATALOG_BANNER = {
  src: '/img/catalog-raster.webp',
  klein: '/img/catalog-raster-w760.webp',
  w: 1600, h: 1207,
};
const DIENST_BEELD = [CATALOG_BANNER, B(2), B(3)];
const SET = [1, 5, 4, 2, 3, 7, 6];
---

{/* ═══ DE VOORPAGINA IN DE NIEUWE STIJL ══════════════════════════════════════
    Het document is inkt; de lichte secties liggen erop als panelen met een
    flinke ronding en een rand inkt eromheen. Elke overgang licht → donker is
    een hoofdstukwissel, en in het donker staat altijd een spookwoord: een kop
    in dezelfde bijna-zwarte toon als de grond, schermvullend.

    De koptekst van dit bestand legt uit waar het vandaan komt. */}
<div class="s22 thuis">

  {/* ── 1 · DE OPENING ───────────────────────────────────────────────────────
      De opbouw van VEXO: kop gecentreerd met één accentwoord, twee pillen, het
      model dat over de onderrand heen loopt, links drie gezichten met één zin,
      rechts een donkere clipkaart. De animatie is teruggebracht tot zeven
      banden — het aantal beelden van één complete set — die met 70 ms verschil
      veertien pixels op hun plaats schuiven, en een kop die per regel opkomt.
      Binnen één seconde staat alles stil. */}
  {/* ── DE OPENING TOONT NU WAT ERUIT KOMT — 17 september 2026 ───────────────
      Lucas: *"Ik wil de laptop op de voorpagina hebben omdat een klant dan in
      1x kan zien wat we maken en leveren met de diaslides naar instagram slide
      etc. Op dit moment is het gewoon een mode foto en is het nog best
      onduidelijk waar visuails voor staat en wat ze doen."*

      Dat klopte. De kop zei in woorden wat we doen, en eronder stond een
      modefoto — mooi, maar het BEWIJS ontbrak: een klant zag nergens het ding
      dat hij koopt. De laptop is dat ding: een echte productpagina met de
      geleverde beelden erin, en de telefoonfoto ernaast waar ze uit komen. De
      reeks draait door van catalogset naar de instagram-carrousel naar de
      video, dus de drie diensten staan er in één blik.

      ── DE FOTO IS UIT DE HERO ────────────────────────────────────────────────
      Niet uit zuinigheid maar omdat twee beelden om dezelfde aandacht vechten:
      een schermvullende foto ACHTER een laptop maakt allebei minder leesbaar, en
      de sluiers die de kop op die foto leesbaar hielden (.hero::before, ::after)
      zijn dan een waas over de plaat. De grond die eronder lag — het verloop en
      de stralen — blijft staan; dat was altijd al de echte achtergrond.

      Het merk verdwijnt er niet mee: de mode zit nu IN de laptop (de jeans, de
      carrousel met het model) en verder op de pagina in de lopende band. */}
  <section class="hero hero-split" aria-labelledby="vp-h1">
    <div class="stralen" aria-hidden="true"><span></span><span></span><span></span><span></span></div>

    <div class="hero-kop">
      <p class="etiket">{c.labels[0]} · {c.labels[2]}</p>
      <h1 id="vp-h1" class="hoog hero-h1">
        {c.h1.map((line, i) => <span class="kop-regel" style={`--i:${i}`}><span set:html={line} /></span>)}
      </h1>
      <p class="acties hero-acties">
        <a class="knop knop-inkt" href={lp('/start')}>{c.ctaStart}</a>
        {/* ── DE TWEEDE KNOP HANGT AF VAN WIE ER STAAT — 17 september 2026 ──
            Lucas: *"Ik wil wanneer iemand is ingelogd en dus al een order heeft
            geplaatst de test sample niet meer dominant maken en die
            knoppen/secties veranderen naar iets anders dat dan belangrijker is
            en meer conversiegericht is."*

            "Probeer VISUAILS voor € 1" naast iemand die er al honderden euro's
            heeft uitgegeven, leest als een site die niet weet wie er staat — en
            het geeft de op één na duurste plek van de voorpagina weg aan het
            goedkoopste aanbod.

            Wat er voor een bestaande klant voor in de plaats komt is het
            ABONNEMENT en niet "bestel opnieuw". Opnieuw bestellen kan hij al met
            de knop ernaast; het abonnement is het enige wat hij nog niet heeft
            en het is het enige dat terugkerend is.

            `data-vis-uit` / `data-vis-in`: zie pasKlantstandToe() in
            interactions.js. Zonder JavaScript blijft de proefknop gewoon staan,
            wat precies de oude situatie is. */}
        <a class="knop knop-wit" href={lp('/test-sample')} data-vis-uit>{sample.cta}</a>
        <a class="knop knop-wit" href={lp('/start/plan')} data-vis-in hidden>{c.planCta}</a>
      </p>
    </div>

    {/* De laptop, met alle drie de reeksen: catalogset, de instagram-carrousel
        en de videoclip. `laptopReeks()` levert ze in die volgorde en de
        carrousel draait er vanzelf doorheen — dat is de "diaslides" waar Lucas
        om vroeg. `vorm="naast"` haalt de sectiepadding eraan weg en laat hem
        rechts de pagina uitlopen met een verloop; zie LaptopCarousel.astro. */}
    <div class="hero-beeld">
      <LaptopCarousel lang={lang} vorm="naast" titel={c.h1.join(' ')} />
    </div>

    {/* ── DE ZIN STAAT OP DE TELEFOON BOVEN HET BEELD — 8 september 2026 ──
        Gemeten op 390px: de kop stond op 153px, de knoppen op 254px, en daarna
        kwam 460 pixels beeld. Deze zin — de enige plek waar staat WAT er
        verkocht wordt — begon op 900px, net onder de vouw. Wie de site op zijn
        telefoon opende, zag een kop, twee knoppen en een foto van een hoodie,
        en nergens het woord productfoto.

        Op breed staat dit blok linksonder in de hero en is het gewoon in beeld;
        daar verandert niets. Alleen in de stapel op smal schuift hij naar
        boven — met `order` in stijl22.css, en dat mag hier omdat er niets in
        dit blok is dat focus krijgt: drie <img> en een <p>. De tabvolgorde
        verandert dus niet, alleen wat je ziet. */}
    <div class="hero-links">
      <ul class="koppen" role="list">
        {ROSTER.slice(0, 3).map((m) => <li><img src={m.thumb} width={m.tw} height={m.th} alt={m.name} loading="lazy" decoding="async"></li>)}
      </ul>
      <p class="hero-zin">{c.lede}</p>
    </div>

    {/* HIER STOND DE CLIPKAART — een miniatuur rechtsonder die naar /video
        linkte. Sinds de laptop er staat, is dat dubbelop: de derde slide ÍS de
        videoclip, groter en in context. Twee dingen die hetzelfde beloven
        naast elkaar maakt de opening drukker zonder één weg extra te openen —
        dezelfde afweging als bij de WhatsApp-knop op de dienstpagina's. */}

  </section>

  {/* De maatlijn: een haarlijn, een streepje per waarde, het nummer erboven. */}
  {/* Vier punten, en ze komen alle vier uit `facts`. Hier stond er een vijfde
      los onder: `trust[0]`, "Made in Enschede, NL". Die staat nog steeds op de
      pagina — onderaan, in de trustlijn, waar de rest van dat rijtje ook staat —
      maar hij hoorde niet als losse regel in de opmaak te hangen terwijl de
      andere vier uit één lijst komen. */}
  <ul class="maatlijn" role="list">
    {c.facts.map((f) => <li><span>{f}</span></li>)}
  </ul>

  {/* ── 2 · DE LOPENDE BAND ──────────────────────────────────────────────────
      12 september 2026, en het is de grootste ingreep op deze pagina sinds hij
      bestaat. Lucas: *"Uiteindelijk moet het gewoon heel duidelijk worden voor
      de klant dat hij of zij productfoto's opstuurt naar mij, ik de foto's/
      videos maak die ze willen en ze het allemaal kunnen downloaden in hun
      dashboard. Dat is het concept, en het voelt op de website wat rommelig
      waardoor je dat niet snel eruit kan halen."*

      Uit vier gebouwde richtingen koos hij deze: vier stations — jij, wij, je
      dashboard, je shop — met de beelden van één echte klus.

      ── WAT HIERVOOR IS WEGGEHAALD, EN WAAROM DAT GEEN VERLIES IS ──────────
      Drie secties en een poster, samen ruim een derde van deze pagina:

        · "Jij stuurt een telefoonfoto. Wij maken er een studioproductie van"
          — één voorbeeld, één nabeeld en een draad met vier termen ertussen.
          Precies wat station 01 en 02 doen, met vijf foto's in plaats van één.
        · "Van map tot lancering" — vier genummerde stappen als tekst. Dat is
          de band, in woorden, zonder beeld.
        · "Daarna: VISUAILS Studio" — het portaal uitgelegd naast een tekening.
          Dat is station 03, en daar staan goedkeuren en revisie nu als twee
          knoppen van gelijk gewicht — het tweede punt van Lucas' bezoeker.
        · De posterkamer — een schermvullend vlak zonder inhoud.

      De twee links die aan die secties hingen (de galerij en het portaal) zijn
      meeverhuisd naar het station waar hun onderwerp staat. */}
  <LopendeBand lang={lang} />

  {/* ── 2 · WAT WE MAKEN ─────────────────────────────────────────────────────
      De pillenrij is echt: vier radioknoppen, nul regels JavaScript. De gekozen
      dienst blijft vol, de andere drie zakken terug. */}
  <section id="maken" class="paneel kiezer" aria-labelledby="vp-sv">
    <header class="paneel-kop">
      <p class="etiket">{c.secties[0]}</p>
      <h2 id="vp-sv" class="hoog hoog-2">{c.svcH}</h2>
      <p class="lopend">{c.svcLede}</p>
    </header>
    {/* ── DE FILTERRIJ IS WEG, EN DAT WAS MEER DAN EEN KNOPPENRIJ ─────────
        8 september 2026. Lucas: *"De knoppen boven de services zijn overbodig
        en mogen weg."*

        Overbodig waren ze — vier pillen met dezelfde vier namen die twee
        centimeter lager als kaart staan. Maar ze deden iets, en dat iets was
        het echte probleem: elke pil was een <input type="radio">, en de regel
        `.kiezer .kaarten .kaart { opacity: .42 }` zette DRIE VAN DE VIER
        KAARTEN op 42 procent tot je er een aanklikte.

        Netto: wie de voorpagina opende zag één dienst scherp en drie als
        schimmen. Op een pagina waarvan de kop "Wat we maken" is, en waar die
        vier de hele etalage zijn. Het is te zien op elke schermafdruk van de
        live site — de catalogset staat er vol, de andere drie liggen eronder
        in grijs.

        Alles gaat weg: de radio's, de pillen, en de dimming. Vier kaarten,
        alle vier even scherp, en de bezoeker kiest door te klikken in plaats
        van eerst te moeten aanwijzen wat hij mag zien. */}
    <ul class="kaarten" role="list">
      {c.svc.map(([naam, wat, prijs, href], i) => (
        <li>
          <a class="kaart" href={lp(href)}>
            {/* De maten komen van het bestand en niet uit de lucht: er stond
                1000×1250 op elke tegel terwijl geen van de drie beelden die
                verhouding heeft. De kaart snijdt toch bij (aspect-ratio 4/5 met
                object-fit: cover), dus je zag er niets van — maar een browser
                die een verkeerde verhouding krijgt, reserveert de verkeerde
                ruimte en schuift de pagina op zodra het beeld binnen is. */}
            <img src={DIENST_BEELD[i].klein} width={DIENST_BEELD[i].w} height={DIENST_BEELD[i].h} alt="" loading="lazy" decoding="async">
            <span class="kaart-pil">
              <span class="kaart-tekst"><b>{naam}</b><span class="mono">{prijs}</span></span>
              <span class="rond" aria-hidden="true">→</span>
            </span>
          </a>
          <p class="kaart-wat">{wat}</p>
        </li>
      ))}
      {/* ── DE VIERDE TEGEL IS EEN DEUR EN GEEN DIENST — 10 september 2026 ───
          Lucas: *"de what we make op de homepage zou 3 blokken moeten zijn en 4e
          blok see all services."*

          Waarom dat beter is dan vier diensten: wat er ook in die vierde tegel
          staat, hij is de laatste van de rij en leest als "en dit is de rest".
          Dat wás hij niet — er stond een dienst in, en dan belooft de rij
          stilzwijgend dat dit alles is. Er zijn er negen.

          Hij draagt daarom GEEN foto. Een foto zou hem tot een vierde dienst
          maken en de vraag oproepen welke dienst dat dan is. Wat er staat is de
          kleur van de site, één zin en dezelfde pijl als de drie ernaast — zelfde
          vorm, andere belofte. */}
      <li>
        <a class="kaart kaart-deur" href={lp('/start')}>
          <span class="deur-binnen">
            <span class="deur-kop">{c.svcAllKop}</span>
            <span class="deur-lijst">
              {c.svcAllLijst.map((naam) => <span class="deur-item">{naam}</span>)}
            </span>
          </span>
          <span class="kaart-pil">
            <span class="kaart-tekst"><b>{c.svcAll}</b><span class="mono">{c.svcAllPrijs}</span></span>
            <span class="rond" aria-hidden="true">→</span>
          </span>
        </a>
      </li>
    </ul>
    <p class="voetregel"><span class="mono">{c.svcSoon[0]}</span> <a class="pijl" href={lp('/plans#binnenkort')}>{c.svcSoon[1]}</a></p>
  </section>


  {/* ── 4 · DE SET ───────────────────────────────────────────────────────────
      Zeven kaarten op een rij; de splitsing tussen catalog en lifestyle is een
      balk erboven in dezelfde verhouding als de beelden eronder. */}
  <section class="paneel" aria-labelledby="vp-set">
    <header class="paneel-kop">
      <p class="etiket">{c.secties[2]}</p>
      <h2 id="vp-set" class="hoog hoog-2">{c.setH}</h2>
      <p class="lopend">{c.setLede}</p>
    </header>
    <p class="groepen" style={`--a:${CATALOG_IMAGES}fr;--b:${SET.length - CATALOG_IMAGES}fr`}>
      <a class="groep" href={lp(c.setGroups[0][1])}>{c.setGroups[0][0]}</a>
      <a class="groep" href={lp(c.setGroups[1][1])}>{c.setGroups[1][0]}</a>
    </p>
    <ol class="rij">
      {c.frames.map((naam, i) => (
        <li class={i < CATALOG_IMAGES ? 'is-catalog' : 'is-lifestyle'}>
          <span class="kaart kaart-stil">
            <img src={B(SET[i]).klein} width="800" height="1000" alt="" loading="lazy" decoding="async">
          </span>
          <span class="mono">{naam}</span>
        </li>
      ))}
    </ol>
    <p class="etiket set-extras-kop">{c.extrasLabel}</p>
    <ul class="extras" role="list">
      {c.extras.map(([k, v, href]) => <li><a class="pijl" href={lp(href)}>{k}</a><span>{v}</span></li>)}
    </ul>
  </section>


  {/* ── 6 · TARIEVEN, IN HET KORT — 19 september 2026 ───────────────────────
      Hier stonden twee tabellen naast elkaar: de hele prijsladder (vier treden
      × drie soorten) en de drie abonnementen met kolommen — samen ruim 600 px,
      en letterlijk dezelfde tabellen als op /pricing en /plans. Op een voorpagina
      is de vraag niet "wat kost 10–19 lifestyle" maar "in welke orde ligt het".
      Dus per soort één regel: vanaf-prijs, en tot waar hij zakt; en één regel
      voor het abonnement. De tabellen blijven waar ze horen: /pricing en /plans.
      Alle bedragen uit pricing.js. */}
  <section id="tarieven" class="paneel" aria-labelledby="vp-pr">
    <header class="paneel-kop">
      <p class="etiket">{c.secties[4]}</p>
      <h2 id="vp-pr" class="hoog hoog-2">{c.priceH}</h2>
    </header>
    <ul class="tarief-strip" role="list">
      {KINDS.map((id) => (
        <li>
          {KIND_PAGE[id] ? <a class="tarief-soort" href={lp(KIND_PAGE[id])}>{c.priceKinds[id]}</a> : <span class="tarief-soort">{c.priceKinds[id]}</span>}
          <p class="tarief-van"><span class="mono">{c.vanaf}</span> <b class="tarief">{e(ladderRate(id, 1))}</b> <span class="mono">{c.perProduct}</span></p>
          <p class="mono tarief-tot">{c.totVanaf(e(ladderFloor(id)), TOP_AT)}</p>
        </li>
      ))}
    </ul>
    <p class="tarief-abo">
      <span class="tarief-abo-kop">{c.planH}</span>
      <span class="lopend">{c.planLede}</span>
      <span class="tarief-abo-rij">{PLANS.map((pl) => <a href={`${lp('/plans')}#${pl.id}`}><b>{pl.name}</b> <span class="mono">{pl.price} {c.perMaand}</span></a>)}</span>
    </p>
    <p class="acties">
      <a class="knop knop-inkt" href={lp('/start')}>{c.priceCta}</a>
      <a class="knop knop-lijn" href={lp('/pricing')}>{c.priceCta2}</a>
      <a class="pijl" href={lp('/plans')}>{c.planLink}</a>
    </p>
  </section>

  {/* ── 5 · GEZICHTEN ────────────────────────────────────────────────────────*/}
  <section id="gezichten" class="paneel" aria-labelledby="vp-gz">
    <header class="paneel-kop">
      <p class="etiket">{c.secties[6]}</p>
      <h2 id="vp-gz" class="hoog hoog-2">{c.facesH}</h2>
      <p class="lopend">{c.facesLede}</p>
    </header>
    <ul class="cast" role="list">
      {ROSTER.map((m) => (
        <li>
          <a href={`${lp('/models')}#${modelId(m.name)}`}>
            <span class="kaart kaart-stil"><img src={m.thumb} width={m.tw} height={m.th} alt={m.name} loading="lazy" decoding="async"></span>
            <span class="mono">{m.name}</span>
          </a>
        </li>
      ))}
    </ul>
    <p class="acties"><a class="knop knop-lijn" href={lp('/custom-models')}>{c.facesLink}</a><a class="pijl" href={lp('/models')}>{c.facesLink2}</a></p>
  </section>

  {/* ── 6 · DIRECT ANTWOORD ──────────────────────────────────────────────────*/}
  <section class="paneel" aria-labelledby="vp-q">
    <header class="paneel-kop">
            <h2 id="vp-q" class="hoog hoog-2">{c.qH}</h2>
    </header>
    <ul class="vragen" role="list">
      {c.qs.map(([q, l, href]) => <li><span>{q}</span><a class="pijl" href={lp(href)}>{l}</a></li>)}
      <li><span></span><a class="pijl" href={lp('/faq')}>{c.qAll}</a></li>
    </ul>
  </section>

  {/* ── 7 · HET SLUITSTUK ────────────────────────────────────────────────────
      De posterkamer die hier vóór stond — een schermvullend donker vlak met een
      woord erin — is op 12 september weggehaald met de andere drie secties die
      in de lopende band zijn opgegaan. Hij droeg geen inhoud en kostte een heel
      scherm vlak vóór de enige vraag die deze pagina stelt.

      Wat er nu gebeurt is beter: het slotpaneel IS het donker. Het is het enige
      donkere blok in de onderste helft van de pagina, en daarmee is de
      hoofdstukwissel er nog steeds — alleen draagt hij nu de knop in plaats van
      een decor. */}
  <section class="paneel paneel-slot" aria-labelledby="vp-sl">
    <p class="etiket">{c.secties[7]}</p>
    <h2 id="vp-sl" class="hoog">{c.closeH}</h2>
    <p class="lopend">{c.closeLede}</p>
    {/* Het slot van de pagina, met dezelfde omwisseling als in de opening: wie
        al klant is krijgt het abonnement als eerste knop in plaats van de proef
        van € 1. Zie de noot bij de heroknoppen hierboven. */}
    <p class="acties">
      <a class="knop knop-inkt" href={lp('/test-sample')} data-vis-uit>{sample.cta}</a>
      <a class="knop knop-inkt" href={lp('/start/plan')} data-vis-in hidden>{c.planCta}</a>
      <a class="knop knop-lijn" href={lp('/start')}>{c.closeAlt}</a>
    </p>
  </section>

  <ul class="trustlijn" role="list">{c.trust.map((t) => <li>{t}</li>)}</ul>
</div>
