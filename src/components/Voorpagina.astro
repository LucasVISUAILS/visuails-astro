/**
 * VISUAILS — de voorpagina. Sectie 21, 5 september 2026.
 *
 * WAT DIT VERVANGT. HomeV2.astro: 5.150 regels, elf secties, een hero-carrousel
 * met zeven dia's en een copytabel van duizend regels. Lucas, na de eerste ronde
 * van het lichte palet: *"hoe het nu wordt voelt zo vriendelijk nog"* en, met
 * ovyonlabs.com/works/komma en de Lue-site als voorbeeld: *"Ik wil hetzelfde
 * strakke voelen."* En over de tekst: *"je mag tekst schrappen zolang de kern van
 * de boodschap helder blijft, ik wil voornamelijk visueel uitleggen wat visuails
 * doet."*
 *
 * WAT "STRAK" HIER CONCREET IS, nagemeten op die twee sites:
 *   · panelen van rand tot rand, voornamelijk wit, twee in Komma's donkergrijs
 *     (#212121 — Lucas: "de donkere kleur wordt donkergrijs … voornamelijk wit"),
 *     zonder ruimte ertussen;
 *   · een gesplitste hero: beeld links, wit paneel rechts, mono-labels erboven;
 *   · haarlijnen in plaats van kaarten en schaduwen;
 *   · kleinere, lichtere koppen met veel lucht eromheen;
 *   · kleine mono-labels in kapitalen als tweede stem naast de kop;
 *   · het geel alleen als vlak — knoppen, één woord in de kop, de voettekst —
 *     nooit als tekstkleur op wit (1,5:1).
 *
 * DE PAGINA LEGT UIT MET BEELD. Acht panelen, en in zes daarvan is het beeld
 * het argument: de telefoonfoto naast de studioproductie, de zeven beelden die
 * één product oplevert, de vier stappen, de prijstabel, het beoordeelscherm, de
 * gezichten. Tekst is één kop en één regel per paneel.
 *
 * GEEN ENKEL GETAL IS GETYPT. Aantallen komen uit pricing.js en lexicon.js,
 * prijzen uit euro()/ladderRate(), de proef uit TEST_SAMPLE, de belofte van één
 * revisieronde staat op slot tegen AFTERCARE — precies zoals HomeV2 dat deed.
 *
 * DE FOTO'S ZIJN NIEUW EN BESTAAN NOG NIET. Elk beeld hier heet voorpagina-*
 * en ligt niet in public/img; scripts/plaatshouders.mjs maakt er in de build een
 * plaatshouder van in de maat die het <img> vraagt (width/height). Lucas zet de
 * echte foto onder die naam in public/img en hij verschijnt vanzelf — zie
 * src/data/beeld.js.
 */
/* DE LETTERS VAN DE NIEUWE STIJL. Drie variabele, open source families, alle
   drie met een breedte-as zodat "nadruk is breedte" overal werkt: Anybody voor
   de koppen (technischer dan Hubot Sans), Instrument Sans voor de lopende
   tekst, Martian Mono voor de labels. Zelf gehost, geen externe verbinding.
   Ze staan hier en niet in Layout.astro: zolang alleen de voorpagina in deze
   stijl staat, hoeft de rest van de site ze niet te laden. */
import '@fontsource-variable/anybody/standard.css';
import '@fontsource-variable/instrument-sans/standard.css';
import '@fontsource-variable/martian-mono/standard.css';
import {
  AMOUNT, euro, TEST_SAMPLE, reviewClaim, aftercare,
  LADDER, ladderRate, ladderFloor, vatLabel, PLAN_AMOUNT, PLAN_PRODUCTS, PLAN_CLIPS, plans,
  CATALOG_IMAGES, LIFESTYLE_IMAGES, COMPLETE_IMAGES, videoPrijsLabel,
} from '../data/pricing.js';
import { countedShort, setSize } from '../data/lexicon.js';
import { ALLE_DEUREN } from '../data/eigenproduct.js';
import { MERK } from '../data/brand.js';
import { binnenkortNamen } from '../data/binnenkort.js';
import { localizedPath } from '../i18n/ui.js';
import { TAGLINE } from '../data/brand.js';
import { ROSTER, modelId, telwoord } from '../data/models.js';
import { REQUIRED_SHOT_IDS } from '../data/shots.js';
import '../styles/stijl22.css';
import LaptopCarousel from './LaptopCarousel.astro';
import LopendeBand from './LopendeBand.astro';

const { lang } = Astro.props as { lang: 'en' | 'nl' };
const nl = lang === 'nl';
const lp = (p: string) => localizedPath(lang, p);
const sample = TEST_SAMPLE[lang];
const e = (n: number) => euro(n, lang);
/* Hoeveel telefoonfoto's er nodig zijn komt uit shots.js, niet uit een getypt
   woord — tests/uploadbelofte.test.mjs leest deze zin. */
const FOTOS = telwoord(REQUIRED_SHOT_IDS.length, lang, true);

/* De ladder als tabel: dezelfde drie kolommen en vijf treden als /pricing. De
   rijlabels komen van één soort en gelden voor alle drie — dat klopt alleen als
   ze op dezelfde aantallen breken, en dat wordt hier nagekeken zoals /pricing
   dat doet. */
/* ── DE INSTAP STAAT VOORAAN, OOK HIER — 8 september 2026 ──────────────────
   /pricing kreeg deze volgorde op 8 september ('catalog', 'lifestyle',
   'complete') met de reden dat het verhaal van de site bij €89 begint en de
   prijzenpagina met €149 opende — drie framings op één pagina, en precies de
   verwarring waar Lucas het over had. Zie de lange noot in PricingPage.astro.

   DEZE TABEL BLEEF ACHTER. De noot hierboven zegt "dezelfde drie kolommen als
   /pricing" en dat was sinds die ingreep niet meer waar: de voorpagina zette
   nog steeds de bundel vooraan. Wie op de voorpagina naar beneden scrolde, las
   dus €149 als eerste tarief, klikte door naar /pricing en zag daar €89.
   Gevonden doordat Lucas de live pagina naast de nieuwe legde. */
const KINDS = ['catalog', 'lifestyle', 'complete'] as const;
const KIND_PAGE: Record<string, string | null> = { complete: null, catalog: '/catalog', lifestyle: '/lifestyle' };
const vorm = (id: string) => LADDER[id].map(([lo, hi]) => `${lo}:${hi}`).join(',');
for (const id of KINDS) if (vorm(id) !== vorm('complete')) throw new Error(`Voorpagina: staffel "${id}" breekt op andere aantallen dan "complete".`);
const RUNGS = LADDER.complete.map(([lo, hi]) => ({ at: lo, label: hi === null ? `${lo}+` : `${lo}–${hi}` }));
/* De bovenste trede: vanaf dit aantal geldt de laagste prijs. Uit de ladder
   zelf, niet getypt — dezelfde afleiding als TOP_RUNG_AT in faq.js. */
const TOP_AT = LADDER.complete[LADDER.complete.length - 1][0];

const PLAN_CHEAPEST = Object.keys(PLAN_AMOUNT).reduce((a, b) => (PLAN_AMOUNT[b] < PLAN_AMOUNT[a] ? b : a));
const PLAN_FROM = PLAN_AMOUNT[PLAN_CHEAPEST];
const PLAN_FROM_PRODUCTS = PLAN_PRODUCTS[PLAN_CHEAPEST];
/* De drie abonnementen als rijen: naam, producten, clips, prijs — uit plans(). */
const PLANS = plans(lang);

/* Het slot op "één revisieronde" — zie de noot in HomeV2 van 27 augustus: de
   belofte staat op de pagina, dus de controle blijft. */
if (!/\b1 revision round\b/i.test(aftercare('attended', 'en'))) {
  throw new Error(`Voorpagina: de Studio-regel belooft één revisieronde, AFTERCARE zegt nu: "${aftercare('attended', 'en')}"`);
}

/* De zeven beelden van één product: vier catalog, drie lifestyle. De namen van de
   frames komen uit dezelfde zinnen als TEST_SAMPLE.catalogLine / lifestyleLine. */
const FRAMES = {
  en: ['Front', 'Back', 'Detail', 'On model', 'Scene', 'On model', 'Close-up'],
  nl: ['Voor', 'Achter', 'Detail', 'Op model', 'Scène', 'Op model', 'Close-up'],
};
if (FRAMES.en.length !== COMPLETE_IMAGES) throw new Error(`Voorpagina: ${FRAMES.en.length} frames voor ${COMPLETE_IMAGES} beelden.`);

/*
 * ── DE VIER PUNTEN ONDER DE HERO — 9 september 2026 ─────────────────────────
 *
 * Lucas: *"hier staat trouwens ook 4 catalog + 3 lifestyle maar dat is heel vaag
 * en is niet het enige wat wij verkopen en dat lijkt nu wel zo."*
 *
 * Dat klopte, en het was de eerste regel van de maatlijn: `4 catalog + 3
 * lifestyle per product`. Die zin beschrijft ÉÉN bundel — de complete-bestelling
 * — en stond op de plek waar een bezoeker leest wat VISUAILS is. Wie daar stopt,
 * denkt dat het aanbod één setje van zeven beelden is en niet vier diensten met
 * een eigen tarief. Bovendien is het een getal zonder eenheid: "4 + 3" zegt niets
 * over wat je ervoor betaalt of hoe snel het er is.
 *
 * Wat er nu staat zijn vier ANTWOORDEN op de twijfel van iemand die dit nog nooit
 * zo besteld heeft: mag het klein beginnen, wat kost het, wanneer is het er, en
 * van wie zijn de beelden daarna. Geen van vieren noemt een bundel, en geen van
 * vieren staat in de weg van de dienstenrij eronder.
 *
 * DE RECHTEN STAAN OP ÉÉN PLEK. `RECHTEN` wordt hieronder óók in `beloften`
 * gebruikt. Zonder die ene bron zouden er twee zinnen over dezelfde belofte op
 * dezelfde pagina staan, en dan verandert er op een dag één van de twee.
 */
