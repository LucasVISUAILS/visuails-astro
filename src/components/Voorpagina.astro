      ))}
    </ul>
    <p class="voetregel"><span class="mono">{c.svcOok}:</span> <a class="pijl" href={lp('/start')}>{ook}</a></p>
  </section>

  {/* ── 5 · DE LOOKS ─────────────────────────────────────────────────────────
      Wat een modemerk als eerste wil weten: past dit bij mij. Elke kaart gaat
      naar de pagina van die look — zie Stijlstrook.astro. */}
  <section class="paneel vervolg" aria-labelledby="vp-lk">
    <header class="paneel-kop">
      <h2 id="vp-lk" class="hoog hoog-2">{c.looksH}</h2>
      <p class="lopend">{c.looksLede}</p>
    </header>
    <Stijlstrook lang={lang} />
  </section>

  {/* ── 6 · EEN GEZICHT ZIT ERBIJ ────────────────────────────────────────────
      De helft van wat hier stond: vijf gezichten in plaats van tien, en twee
      deuren naar de rest. */}
  <section id="gezichten" class="paneel gz vervolg" aria-labelledby="vp-gz">
    <div class="gz-woord">
      <h2 id="vp-gz" class="hoog hoog-2">{c.facesH}</h2>
      <p class="lopend">{c.facesLede}</p>
      <p class="gz-links">
        <a class="pijl" href={lp('/models')}>{c.facesAll}</a>
        <a class="pijl" href={lp('/custom-models')}>{c.facesMerk}</a>
      </p>
    </div>
    <ul class="gz-rij" role="list">
      {GEZICHTEN_RIJ.map((m) => (
        <li>
          <a href={`${lp('/models')}#${modelId(m.name)}`}>
            <span class="gz-foto"><img src={m.thumb} width={m.tw} height={m.th} alt={m.name} loading="lazy" decoding="async"></span>
            <span class="mono">{m.name}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  {/* ── 7 · EDITIONS ─────────────────────────────────────────────────────────
      De ene plek waar één groot beeld de pagina lucht geeft — en het is geen
      decoratie: het is de dienst. Banner `editions-breed` (21:9); tot Lucas hem
      maakt, staat er een plaatshouder met die naam en maat. Het violet zit in
      het beeld als licht, niet als vlak (KLEURENSCHEMA.md). */}
  <section class="kamer ed" aria-labelledby="vp-ed">
    <figure class="ed-beeld">
      <img src="/img/editions-breed.webp" width="2400" height="1030" alt={c.edAlt} loading="lazy" decoding="async" data-plaatshouder="donker" />
    </figure>
    <div class="ed-woord">
      <div>
        <p class="etiket">{c.edEtiket}</p>
        <h2 id="vp-ed" class="hoog hoog-2">{c.edH}</h2>
      </div>
      <div class="ed-zin">
        <p class="lopend">{c.edZin}</p>
        <p><a class="pijl" href={lp('/plans#binnenkort')}>{c.edLink}</a></p>
      </div>
    </div>
  </section>

  {/* ── 8 · VOOR WIE ─────────────────────────────────────────────────────────
      Drie situaties, drie antwoorden, drie deuren. Geen kaarten. */}
  <section class="paneel vw" aria-labelledby="vp-vw">
    <h2 id="vp-vw" class="hoog hoog-2">{c.vwH}</h2>
    <ul class="vw-lijst" role="list">
      {c.vw.map(([wie, wat, link, href]) => (
        <li>
          <span class="vw-wie">{wie}</span>
          <span class="lopend vw-wat">{wat}</span>
          <a class="pijl vw-link" href={lp(href)}>{link}</a>
        </li>
      ))}
    </ul>
  </section>

  {/* ── 9 · DIRECT ANTWOORD ──────────────────────────────────────────────── */}
  <section class="paneel vervolg" aria-labelledby="vp-q">
    <header class="paneel-kop">
      <h2 id="vp-q" class="hoog hoog-2">{c.qH}</h2>
    </header>
    <ul class="vragen" role="list">
      {c.qs.map(([q, a, l, href]) => <li><span>{q}</span><p class="vraag-antwoord">{a}</p><a class="pijl" href={lp(href)}>{l}</a></li>)}
      <li><span></span><a class="pijl" href={lp('/faq')}>{c.qAll}</a></li>
    </ul>
  </section>

  {/* ── 10 · DE PROEF ────────────────────────────────────────────────────────
      Woorden links, de vier beelden die de proef oplevert rechts. Dezelfde
      omwisseling als in de opening: een bestaande klant ziet het abonnement. */}
  <section class="paneel paneel-slot slot-proef" aria-labelledby="vp-sl">
    <div class="slot-woord">
      <p class="etiket">{c.proef}</p>
      <h2 id="vp-sl" class="hoog">{c.closeH}</h2>
      <p class="lopend">{c.closeLede}</p>
      <p class="acties">
        <a class="knop knop-inkt" href={lp('/test-sample')} data-vis-uit>{sample.cta}</a>
        <a class="knop knop-inkt" href={lp('/start/plan')} data-vis-in hidden>{c.planCta}</a>
        <a class="knop knop-lijn" href={lp('/start')}>{c.closeAlt}</a>
      </p>
    </div>
    <ul class="slot-beelden" role="list" aria-hidden="true">
      {geleverd(lang).map((b) => <li><img src={b.src} width={b.w} height={b.h} alt="" loading="lazy" decoding="async" /></li>)}
    </ul>
  </section>

  {/* ── 11 · VERTROUWEN ──────────────────────────────────────────────────── */}
  {/* De eerste regel heeft sinds 23 september 2026 een naam en een deur: wie
      "wie zit hierachter?" denkt, komt op /about bij een gezicht uit. */}
  <ul class="trustlijn" role="list">{c.trust.map((t) => <li>{Array.isArray(t) ? <a href={lp(t[1])}>{t[0]}</a> : t}</li>)}</ul>
</div>

<script>
  /* ── DE DIENSTWISSEL — 1 oktober 2026 ───────────────────────────────────────
     Zonder dit script is de wissel een rij die je opzij veegt en zijn de
     tabbladen ankers. Dit maakt er echte tabbladen van (pijltjestoetsen,
     aria-selected), houdt het actieve tabblad bij terwijl iemand veegt, en laat
     de dia's vanzelf doorlopen zolang het blok in beeld is.

     DE KLOK IS DE STREEP. Er loopt geen timer: de streep onder het actieve
     tabblad is een CSS-animatie, en als die af is gaat de wissel een dia
     verder. Pauzeren is dus de animatie stilzetten (animation-play-state), en
     de streep laat precies zien hoeveel er nog over was. Eén bron voor wat je
     ziet en wat er gebeurt.

     WANNEER HIJ STILSTAAT: buiten beeld, onder de muis of de focus, als de
     bezoeker minder beweging vraagt, en voorgoed zodra iemand zelf kiest of
     veegt — of op de pauzeknop drukt. Geen luisteraar op window: die blijft na
     een zachte navigatie hangen (zie tests/zachte-navigatie.test.mjs). */
  const zet = () => {
    for (const root of document.querySelectorAll<HTMLElement>('[data-dd]')) {
      if (root.dataset.ddKlaar) continue;
      root.dataset.ddKlaar = '1';
      const spoor = root.querySelector<HTMLElement>('[data-dd-spoor]');
      const lijst = root.querySelector<HTMLElement>('[data-dd-tabs]');
      const pauze = root.querySelector<HTMLButtonElement>('[data-dd-pauze]');
      const tabs = [...root.querySelectorAll<HTMLAnchorElement>('[data-dd-tab]')];
      const dias = [...root.querySelectorAll<HTMLElement>('[data-dd-dia]')];
      if (!spoor || !lijst || !pauze || tabs.length !== dias.length || !tabs.length) continue;

      const rustig = matchMedia('(prefers-reduced-motion: reduce)').matches;
      lijst.setAttribute('role', 'tablist');
      for (const [i, t] of tabs.entries()) {
        t.setAttribute('role', 'tab');
        t.setAttribute('aria-controls', dias[i].id);
        dias[i].setAttribute('role', 'tabpanel');
        dias[i].setAttribute('aria-labelledby', t.id);
      }

      let nu = 0;
      let loopt = !rustig;      // de keuze van de bezoeker (of van de pauzeknop)
      let zicht = false;        // staat het blok in beeld
      let erboven = false;      // muis of focus in de dia's
      let zelf = false;         // het script schuift, niet de bezoeker

      const stand = () => {
        root.classList.toggle('dd-auto', loopt);
        root.classList.toggle('dd-loopt', loopt && zicht && !erboven);
        pauze.setAttribute('aria-pressed', String(!loopt));
        pauze.setAttribute('aria-label', (loopt ? pauze.dataset.uit : pauze.dataset.aan) || '');
        const clip = dias[nu].querySelector('video');
        for (const v of root.querySelectorAll('video')) if (v !== clip) v.pause();
        if (clip) { if (zicht) clip.play().catch(() => {}); else clip.pause(); }
      };
      const kies = (i: number) => {
        nu = i;
        for (const [j, t] of tabs.entries()) {
          const aan = j === i;
          t.setAttribute('aria-selected', String(aan));
          t.tabIndex = aan ? 0 : -1;
          /* De streep opnieuw laten beginnen: klasse eraf, één keer layout, erop. */
          t.classList.remove('is-nu');
          if (aan) { void t.offsetWidth; t.classList.add('is-nu'); }
        }
        for (const [j, d] of dias.entries()) d.inert = j !== i;
        stand();
      };
      const ga = (i: number) => {
        const doel = (i + dias.length) % dias.length;
        zelf = true;
        spoor.scrollTo({ left: dias[doel].offsetLeft - dias[0].offsetLeft, behavior: rustig ? 'auto' : 'smooth' });
        kies(doel);
        /* Klaar met schuiven: `scrollend` waar de browser hem kent, anders na
           een ruime seconde. Tot dan telt geen enkele scroll als een veeg. */
        window.clearTimeout(los);
        los = window.setTimeout(() => { zelf = false; }, 1200);
      };
      let los = 0;
      spoor.addEventListener('scrollend', () => { window.clearTimeout(los); los = window.setTimeout(() => { zelf = false; }, 60); });
      const stop = () => { loopt = false; stand(); };

      /* `for … of` en niet de arraymethode: tests/promises.test.mjs zoekt in dit
         bestand naar het Engelse woord voor bereik, en vond het in die naam. */
      for (const [i, t] of tabs.entries()) {
        t.addEventListener('click', (ev) => { ev.preventDefault(); stop(); ga(i); });
        t.addEventListener('keydown', (ev) => {
          const stap = ev.key === 'ArrowRight' ? 1 : ev.key === 'ArrowLeft' ? -1 : 0;
          if (!stap) return;
          ev.preventDefault(); stop();
          const doel = (i + stap + tabs.length) % tabs.length;
          ga(doel); tabs[doel].focus();
        });
        t.querySelector('.dd-tab-loop')?.addEventListener('animationend', () => {
          if (loopt && i === nu) ga(nu + 1);
        });
      }

      /* Vegen: het tabblad volgt de dia die het meest in beeld staat. Een veeg
         van de bezoeker zet de wissel stil; een schuif van het script niet. */
      let wacht = 0;
      spoor.addEventListener('scroll', () => {
        window.clearTimeout(wacht);
        wacht = window.setTimeout(() => {
          if (zelf) return;
          /* De dia waarvan het begin het dichtst bij de schuifstand ligt. */
          let doel = 0, best = Infinity;
          for (const [j, d] of dias.entries()) {
            const af = Math.abs(d.offsetLeft - dias[0].offsetLeft - spoor.scrollLeft);
            if (af < best) { best = af; doel = j; }
          }
          if (doel !== nu) { stop(); kies(doel); }
        }, 120);
      }, { passive: true });

      const uit = root.querySelector<HTMLElement>('.dd-uit');
      uit?.addEventListener('pointerenter', () => { erboven = true; stand(); });
      uit?.addEventListener('pointerleave', () => { erboven = false; stand(); });
      uit?.addEventListener('focusin', () => { erboven = true; stand(); });
      uit?.addEventListener('focusout', () => { erboven = false; stand(); });

      pauze.hidden = rustig;
      pauze.addEventListener('click', () => { loopt = !loopt; stand(); });

      /* In beeld is: de dia's zelf, voor de helft. Niet het hele blok — dat is
         op een telefoon hoger dan het scherm en haalt dan nooit 40%. */
      if (uit) new IntersectionObserver(([e]) => { zicht = e.isIntersecting; stand(); }, { threshold: 0.5 }).observe(uit);
      /* Verandert de breedte (draaien, venster), dan blijft dezelfde dia staan
         en telt het verspringen niet als een veeg. */
      new ResizeObserver(() => {
        zelf = true;
        spoor.scrollTo({ left: dias[nu].offsetLeft - dias[0].offsetLeft, behavior: 'auto' });
        window.clearTimeout(los);
        los = window.setTimeout(() => { zelf = false; }, 500);
      }).observe(spoor);
      /* Een anker in de adresbalk (#dd-video) opent die dia. */
      const vooraf = dias.findIndex((d) => `#${d.id}` === location.hash);
      kies(vooraf > 0 ? vooraf : 0);
      if (vooraf > 0) { loopt = false; ga(vooraf); }
    }
  };
  zet();
  document.addEventListener('astro:page-load', zet);
</script>
