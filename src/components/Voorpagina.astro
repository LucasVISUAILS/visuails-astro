const c = COPY[lang];
/* "Ook: Hooks · Editions · werk op maat" — de namen uit binnenkort.js, zodat
   een dienst die erbij komt of verdwijnt hier vanzelf meegaat. */
const ook = [...binnenkortNamen(lang), c.svcOokRest].join(' · ');
const GEZICHTEN_RIJ = ROSTER.slice(0, 5);
---
<div class="s22 thuis">

  {/* ── 0 · OPENING ──────────────────────────────────────────────────────────
      Eén middenas: etiket, kop met het wisselende accentwoord, één zin, twee
      knoppen, en de laptop eronder. Zie .hero-stapel in stijl22.css. */}
  <section class="hero hero-split hero-stapel" aria-labelledby="vp-h1">
    <div class="hero-kop">
      <p class="etiket">{MERK} · {c.plek}</p>
      <h1 id="vp-h1" class="hoog hero-h1" aria-label={c.h1plain}>
        {c.h1.map((line, i) => (
          <span class="kop-regel" style={`--i:${i}`} aria-hidden="true">
            {line.includes('<em>') ? (
              <em class="wissel" style={`--n:${c.wissel.length}`}>
                {c.wissel.map((w, j) => <span class="wissel-woord" style={`--j:${j}`}>{w}.</span>)}
              </em>
            ) : <span set:html={line} />}
          </span>
        ))}
      </h1>
      <p class="lopend hero-zin">{c.lede}</p>
      {/* De tweede knop hangt af van wie er staat: een bestaande klant krijgt het
          abonnement in plaats van de proef — zie pasKlantstandToe() in
          interactions.js. Zonder JavaScript blijft de proefknop staan. */}
      <p class="acties hero-acties">
        <a class="knop knop-inkt" href={lp('/start')}>{c.ctaStart}</a>
        <a class="knop knop-lijn" href={lp('/test-sample')} data-vis-uit>{sample.cta}</a>
        <a class="knop knop-lijn" href={lp('/start/plan')} data-vis-in hidden>{c.planCta}</a>
      </p>
    </div>
    <div class="hero-beeld">
      <LaptopCarousel lang={lang} vorm="onder" titel={c.h1plain} />
    </div>
  </section>

  {/* ── 1 · MAATLIJN ───────────────────────────────────────────────────────── */}
  <ul class="maatlijn" role="list">
    {c.facts.map((f) => <li><span>{f}</span></li>)}
  </ul>

  {/* ── 2 · DIT STUUR JIJ, DIT KRIJG JE TERUG ───────────────────────────────
      Eén hoofdstuk met wat hiervoor twee panelen waren ("voor en na" en de
      band van vier stations). Links de woorden en de foto die de klant stuurt,
      rechts per dienst wat eruit komt — een dia per dienst, met de namen als
      tabbladen erboven. Onder de streep de vier stappen, zonder beelden: het
      verloop is voor elke dienst hetzelfde. Zonder script is het een rij die
      je opzij veegt; het script maakt er tabbladen van en laat hem wisselen. */}
  <section class="paneel dd" aria-labelledby="vp-vn" data-dd>
    {/* ── DE PIJPLIJN — ronde 9, 2 oktober 2026 ─────────────────────────────
        Lucas: *"de foto's zijn veel te groot en de sectie mag een stuk mooier en
        overzichtelijker, als de product pipeline op gallery maar dan voor de
        homepage."* Dus drie rijen zoals Levering.astro: links het nummer, het
        woord en één zin; rechts wat er op dat moment ligt. 01 de telefoonfoto,
        02 wat we ervan maken (de dienstwissel met tabbladen), 03 waar het
        heengaat. De vier losse stappen die hieronder stonden, zitten nu in deze
        drie rijen; twee keer hetzelfde verloop is één keer te veel. */}
    <header class="dd-kop">
      <h2 id="vp-vn" class="hoog hoog-2">{c.vnH}</h2>
      <p class="lopend">{c.vnZin}</p>
    </header>
    <ol class="dd-rijen" role="list">
      {/* 01 · Jij stuurt */}
      <li class="dd-rij">
        <div class="dd-uitleg">
          <p class="mono dd-nr">{c.vnRijen[0][0]}</p>
          <h3 class="dd-woord">{c.vnRijen[0][1]}</h3>
          <p class="dd-zin">{c.vnRijen[0][2]}</p>
        </div>
        <figure class="dd-in">
          <img src={VN_IN.src} width={VN_IN.w} height={VN_IN.h} alt={c.vnVoorAlt} loading="lazy" decoding="async" />
          <figcaption class="mono">{c.vnInNoot}</figcaption>
        </figure>
      </li>
      {/* 02 · Wij maken — de dienstwissel */}
      <li class="dd-rij">
        <div class="dd-uitleg">
          <p class="mono dd-nr">{c.vnRijen[1][0]}</p>
          <h3 class="dd-woord">{c.vnRijen[1][1]}</h3>
          <p class="dd-zin">{c.vnRijen[1][2]}</p>
          {c.vnRijen[1][3] && <a class="pijl" href={lp(c.vnRijen[1][3][1])}>{c.vnRijen[1][3][0]}</a>}
        </div>
        <div class="dd-uit">
          <div class="dd-balk">
            <nav class="dd-tabs" aria-label={c.vnTabs} data-dd-tabs>
              {c.vnDia.map((d, i) => (
                <a class={`dd-tab${i === 0 ? ' is-nu' : ''}`} id={`dd-tab-${d.id}`} href={`#dd-${d.id}`} data-dd-tab>
                  <span class="dd-tab-naam">{d.naam}</span>
                  <span class="dd-tab-prijs">{d.prijs}</span>
                  <span class="dd-tab-loop" aria-hidden="true"></span>
                </a>
              ))}
            </nav>
            <button type="button" class="dd-pauze" data-dd-pauze hidden aria-pressed="false" aria-label={c.vnPauze} data-uit={c.vnPauze} data-aan={c.vnSpeel}><span aria-hidden="true"></span></button>
          </div>
          <div class="dd-spoor" data-dd-spoor>
            {c.vnDia.map((d) => (
              <article class={`dd-dia dd-dia-${d.id}`} id={`dd-${d.id}`} data-dd-dia>
                <div class="dd-beeld">
                  {d.id === 'video' && VN_CLIP
                    ? <video src={VN_CLIP} poster={VN_BEELD.video[0].src} muted loop playsinline preload="none" aria-label={d.alt[0]}></video>
                    : VN_BEELD[d.id].map((b, j) => (
                      <img src={b.src} srcset={b.srcset} sizes="(max-width: 760px) 40vw, 18rem" width={b.w} height={b.h} alt={d.alt[j]} loading="lazy" decoding="async" data-plaatshouder={d.id === 'video' ? 'donker' : undefined} />
                    ))}
                </div>
                <p class="dd-krijg"><span class="etiket">{c.vnKrijg}</span> {d.krijg}</p>
                <p class="dd-link"><a class="pijl" href={lp(d.href)}>{d.link}</a></p>
              </article>
            ))}
          </div>
        </div>
      </li>
      {/* 03 · Jij keurt goed — waar het heengaat */}
      <li class="dd-rij">
        <div class="dd-uitleg">
          <p class="mono dd-nr">{c.vnRijen[2][0]}</p>
          <h3 class="dd-woord">{c.vnRijen[2][1]}</h3>
          <p class="dd-zin">{c.vnRijen[2][2]}</p>
          {c.vnRijen[2][3] && <a class="pijl" href={lp(c.vnRijen[2][3][1])}>{c.vnRijen[2][3][0]}</a>}
        </div>
        <ul class="dd-vormen" role="list">
          {c.vnVormen.map(([maat, waar]) => (
            <li style={`--dd-flex:${(Number(maat.split(':')[0]) / Number(maat.split(':')[1])).toFixed(3)}`}>
              <span class="dd-vorm" style={`--dd-ratio:${maat.replace(':', ' / ')}`}>
                <img src="/img/catalog-after-w420.webp" width="420" height="420" alt="" loading="lazy" decoding="async" />
              </span>
              <span class="mono dd-vorm-maat">{maat} · {waar}</span>
            </li>
          ))}
        </ul>
      </li>
    </ol>
  </section>

  {/* ── 4 · WAT WE MAKEN ─────────────────────────────────────────────────────
      Drie tegels, drie soorten beeld. De rest in één regel eronder. */}
  <section id="maken" class="paneel kiezer" aria-labelledby="vp-sv">
    <header class="paneel-kop">
      <h2 id="vp-sv" class="hoog hoog-2">{c.svcH}</h2>
      <p class="lopend">{c.svcLede}</p>
    </header>
    <ul class="kaarten" role="list">
      {c.svc.map(([naam, wat, prijs, href], i) => (
        <li>
          <a class="kaart" href={lp(href)}>
            <img src={DIENST_BEELD[i].klein} width={DIENST_BEELD[i].w} height={DIENST_BEELD[i].h} alt="" loading="lazy" decoding="async">
            <span class="kaart-pil">
              <span class="kaart-tekst"><b>{naam}</b><span class="mono">{prijs}</span></span>
              <span class="rond" aria-hidden="true">→</span>
            </span>
          </a>
          <p class="kaart-wat">{wat}</p>
