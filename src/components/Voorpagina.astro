{/* ═══ DE VOORPAGINA IN DE NIEUWE STIJL ══════════════════════════════════════
    Het document is inkt; de lichte secties liggen erop als panelen met een
    flinke ronding en een rand inkt eromheen. Elke overgang licht → donker is
    een hoofdstukwissel, en in het donker staat altijd een spookwoord: een kop
    in dezelfde bijna-zwarte toon als de grond, schermvullend.

    De koptekst van dit bestand legt uit waar het vandaan komt. */}
<div class="s22 thuis">

  {/* ── 1 · DE OPENING ───────────────────────────────────────────────────────
      De opbouw van VEXO: kop gecentreerd met één accentwoord, twee pillen, het
      model dat over de onderrand heen loopt, links drie gezichten met één zin,
      rechts een donkere clipkaart. De animatie is teruggebracht tot zeven
      banden — het aantal beelden van één complete set — die met 70 ms verschil
      veertien pixels op hun plaats schuiven, en een kop die per regel opkomt.
      Binnen één seconde staat alles stil. */}
  <section class="hero" aria-labelledby="vp-h1">
    <div class="stralen" aria-hidden="true"><span></span><span></span><span></span><span></span></div>

    <div class="hero-kop">
      <p class="etiket">{c.labels[0]} · {c.labels[2]}</p>
      <h1 id="vp-h1" class="hoog hero-h1">
        {c.h1.map((line, i) => <span class="kop-regel" style={`--i:${i}`}><span set:html={line} /></span>)}
      </h1>
      <p class="acties hero-acties">
        <a class="knop knop-inkt" href={lp('/start')}>{c.ctaStart}</a>
        <a class="knop knop-wit" href={lp('/test-sample')}>{sample.cta}</a>
      </p>
    </div>

    {/* Een <img> en geen achtergrond: een achtergrondafbeelding wordt pas
        gevonden als de stylesheet er is, en dit is het element dat de LCP van
        de voorpagina bepaalt. `fetchpriority="high"` en geen lazy, om dezelfde
        reden. De `sizes` is 100vw want hij vult de hele hero. */}
    <img
      class="hero-foto"
      src={HERO}
      srcset={`/img/voorpagina/hero-moment-w640.webp 640w, /img/voorpagina/hero-moment-w960.webp 960w, /img/voorpagina/hero-moment-w1560.webp 1560w, ${HERO} 2048w`}
      sizes="100vw"
      width="2048" height="1152"
      alt={c.heroFotoAlt}
      fetchpriority="high" decoding="async" />

    {/* ── DE ZIN STAAT OP DE TELEFOON BOVEN HET BEELD — 8 september 2026 ──
        Gemeten op 390px: de kop stond op 153px, de knoppen op 254px, en daarna
        kwam 460 pixels beeld. Deze zin — de enige plek waar staat WAT er
        verkocht wordt — begon op 900px, net onder de vouw. Wie de site op zijn
        telefoon opende, zag een kop, twee knoppen en een foto van een hoodie,
        en nergens het woord productfoto.

        Op breed staat dit blok linksonder in de hero en is het gewoon in beeld;
        daar verandert niets. Alleen in de stapel op smal schuift hij naar
        boven — met `order` in stijl22.css, en dat mag hier omdat er niets in
        dit blok is dat focus krijgt: drie <img> en een <p>. De tabvolgorde
        verandert dus niet, alleen wat je ziet. */}
    <div class="hero-links">
      <ul class="koppen" role="list">
        {ROSTER.slice(0, 3).map((m) => <li><img src={m.thumb} width={m.tw} height={m.th} alt={m.name} loading="lazy" decoding="async"></li>)}
      </ul>
      <p class="hero-zin">{c.lede}</p>
    </div>

    <a class="hero-clip" href={lp('/video')}>
      <img src={B(9).klein} width="1000" height="563" alt="" loading="lazy" decoding="async">
      <span class="rond" aria-hidden="true">▶</span>
      <span class="mono">{c.extras[0][0]}</span>
    </a>
  </section>

  {/* De maatlijn: een haarlijn, een streepje per waarde, het nummer erboven. */}
  <ul class="maatlijn" role="list">
    {c.facts.map((f) => <li><span>{f}</span></li>)}
    <li><span>{c.trust[0]}</span></li>
  </ul>

  {/* ── 2 · WAT WE MAKEN ─────────────────────────────────────────────────────
      De pillenrij is echt: vier radioknoppen, nul regels JavaScript. De gekozen
      dienst blijft vol, de andere drie zakken terug. */}
  <section id="maken" class="paneel kiezer" aria-labelledby="vp-sv">
    <header class="paneel-kop">
      <p class="etiket">{c.secties[0]}</p>
      <h2 id="vp-sv" class="hoog hoog-2">{c.svcH}</h2>
      <p class="lopend">{c.svcLede}</p>
    </header>
    {/* ── DE FILTERRIJ IS WEG, EN DAT WAS MEER DAN EEN KNOPPENRIJ ─────────
        8 september 2026. Lucas: *"De knoppen boven de services zijn overbodig
        en mogen weg."*

        Overbodig waren ze — vier pillen met dezelfde vier namen die twee
        centimeter lager als kaart staan. Maar ze deden iets, en dat iets was
        het echte probleem: elke pil was een <input type="radio">, en de regel
        `.kiezer .kaarten .kaart { opacity: .42 }` zette DRIE VAN DE VIER
        KAARTEN op 42 procent tot je er een aanklikte.

        Netto: wie de voorpagina opende zag één dienst scherp en drie als
        schimmen. Op een pagina waarvan de kop "Wat we maken" is, en waar die
        vier de hele etalage zijn. Het is te zien op elke schermafdruk van de
        live site — de catalogset staat er vol, de andere drie liggen eronder
        in grijs.

        Alles gaat weg: de radio's, de pillen, en de dimming. Vier kaarten,
        alle vier even scherp, en de bezoeker kiest door te klikken in plaats
        van eerst te moeten aanwijzen wat hij mag zien. */}
    <ul class="kaarten" role="list">
      {c.svc.map(([naam, wat, prijs, href], i) => (
        <li>
          <a class="kaart" href={lp(href)}>
            <img src={B(DIENST_BEELD[i]).klein} width="1000" height="1250" alt="" loading="lazy" decoding="async">
            <span class="kaart-pil">
              <span class="kaart-tekst"><b>{naam}</b><span class="mono">{prijs}</span></span>
              <span class="rond" aria-hidden="true">→</span>
            </span>
          </a>
          <p class="kaart-wat">{wat}</p>
        </li>
      ))}
    </ul>
    <p class="voetregel"><span class="mono">{c.svcSoon[0]}</span> <a class="pijl" href={lp('/plans#binnenkort')}>{c.svcSoon[1]}</a></p>
  </section>

  {/* ── 3 · STUDIOPRODUCTIE ──────────────────────────────────────────────────
      Het donker in. Links wat erin gaat, rechts wat eruit komt, ertussen één
      gele draad met de vier termen die wij eromheen bouwen. */}
  <section class="kamer kamer-draad" aria-labelledby="vp-vn">
    <header class="kamer-kop op-inkt">
      <p class="etiket">{c.secties[1]}</p>
      <h2 id="vp-vn" class="hoog hoog-2">{c.vnH}</h2>
      <p class="lopend">{c.vnLede}</p>
    </header>
    <div class="draad-blok">
      <figure class="werk werk-in">
        <img src="/img/catalog-before.webp" width="1350" height="1800" alt={c.vnInAlt} loading="lazy" decoding="async">
        <figcaption class="etiket">{c.vnIn[0]} · {c.vnIn[1]}</figcaption>
      </figure>
      <ol class="draad" aria-label={c.vnNotenLabel}>
        {c.vnNoten.map(([naam], i) => <li><b class="mono">{nn(i + 1)}</b>{naam}</li>)}
      </ol>
      <figure class="werk werk-uit">
        <img src={B(7).src} width={B(7).w} height={B(7).h} alt={c.vnOutAlt} loading="lazy" decoding="async">
        <figcaption class="etiket">{c.vnOut[0]} · {c.vnOut[1]}</figcaption>
      </figure>
    </div>
    <p class="voetregel"><a class="pijl" href={lp('/gallery')}>{c.vnLink}</a></p>
  </section>

  {/* ── 4 · DE SET ───────────────────────────────────────────────────────────
      Zeven kaarten op een rij; de splitsing tussen catalog en lifestyle is een
      balk erboven in dezelfde verhouding als de beelden eronder. */}
  <section class="paneel" aria-labelledby="vp-set">
    <header class="paneel-kop">
      <p class="etiket">{c.secties[2]}</p>
      <h2 id="vp-set" class="hoog hoog-2">{c.setH}</h2>
      <p class="lopend">{c.setLede}</p>
    </header>
    <p class="groepen" style={`--a:${CATALOG_IMAGES}fr;--b:${SET.length - CATALOG_IMAGES}fr`}>
      <a class="groep" href={lp(c.setGroups[0][1])}>{c.setGroups[0][0]}</a>
      <a class="groep" href={lp(c.setGroups[1][1])}>{c.setGroups[1][0]}</a>
    </p>
    <ol class="rij">
      {c.frames.map((naam, i) => (
        <li class={i < CATALOG_IMAGES ? 'is-catalog' : 'is-lifestyle'}>
          <span class="kaart kaart-stil">
            <img src={B(SET[i]).klein} width="800" height="1000" alt="" loading="lazy" decoding="async">
          </span>
          <span class="mono">{naam}</span>
        </li>
      ))}
    </ol>
    <ul class="extras" role="list">
      {c.extras.map(([k, v, href]) => <li><a class="pijl" href={lp(href)}>{k}</a><span>{v}</span></li>)}
    </ul>
  </section>

  {/* ── 5 · HET PROCES ───────────────────────────────────────────────────────*/}
  <section class="kamer kamer-stappen" aria-labelledby="vp-st">
    <header class="kamer-kop op-inkt">
      <p class="etiket">{c.secties[3]}</p>
      <h2 id="vp-st" class="hoog hoog-2">{c.stepsH}</h2>
      <p class="lopend">{c.stepsLede}</p>
    </header>
    <ol class="stappen">
      {c.steps.map(([k, v], i) => (
        <li><span class="stap-nr" aria-hidden="true">{nn(i + 1)}</span><b>{k}</b><span class="lopend">{v}</span></li>
      ))}
    </ol>
  </section>

  {/* ── 6 · TARIEVEN ─────────────────────────────────────────────────────────*/}
  <section id="tarieven" class="paneel" aria-labelledby="vp-pr">
    <header class="paneel-kop">
      <p class="etiket">{c.secties[4]}</p>
      <h2 id="vp-pr" class="hoog hoog-2">{c.priceH}</h2>
    </header>
    <div class="tabellen">
      <div class="blad">
        <div class="tabel-schuif">
        <table class="lijst">
          <thead><tr><th scope="col" class="mono">{c.priceCount}</th>{KINDS.map((id) => <th scope="col" class="mono">{KIND_PAGE[id] ? <a href={lp(KIND_PAGE[id])}>{c.priceKinds[id]}</a> : c.priceKinds[id]}</th>)}</tr></thead>
          <tbody>{RUNGS.map((r) => <tr><th scope="row" class="mono">{r.label}</th>{KINDS.map((id) => <td class="tarief">{e(ladderRate(id, r.at))}</td>)}</tr>)}</tbody>
        </table>
        </div>
        <p class="mono">{c.priceVat}</p>
        <p class="acties"><a class="knop knop-inkt" href={lp('/start')}>{c.priceCta}</a><a class="knop knop-lijn" href={lp('/pricing')}>{c.priceCta2}</a></p>
      </div>
      <div class="blad">
        <h3 class="hoog hoog-3">{c.planH}</h3>
        <p class="lopend">{c.planLede}</p>
        <div class="tabel-schuif">
        <table class="lijst">
          <thead><tr>{c.planCols.map((k) => <th scope="col" class="mono">{k}</th>)}</tr></thead>
          <tbody>{PLANS.map((pl) => <tr><th scope="row"><a href={`${lp('/plans')}#${pl.id}`}>{pl.name}</a><span class="abo-regel">{pl.line}</span></th><td class="tarief">{pl.products}</td><td class="tarief">{PLAN_CLIPS[pl.id] || '—'}</td><td class="tarief">{pl.price}</td></tr>)}</tbody>
        </table>
        </div>
        <p class="mono">{c.planVat}</p>
        <p class="acties"><a class="knop knop-lijn" href={lp('/start/plan')}>{c.planCta}</a><a class="pijl" href={lp('/plans')}>{c.planLink}</a></p>
      </div>
    </div>
  </section>

  {/* ── 7 · STUDIO ───────────────────────────────────────────────────────────
      Het beoordeelscherm blijft een tekening en geen nagemaakte schermafdruk —
      zie de noot in FigApproval.astro. Daarom staat deze sectie op licht: de
      haarlijnen van die tekening hebben een lichte grond nodig. */}
  {/* ── HET SCHERM STAAT NAAST DE TEKST — 8 september 2026 ──────────────────
      Lucas: *"Ook de VISUAILS Studio sectie op de homepage naast de tekst
      zetten omdat het mock up scherm onnodig veel ruimte in beslag neemt."*

      Gemeten: de sectie was 1523px hoog, waarvan 881px de figuur en 213px de
      tekst. Vier staande tegels over de volle breedte, om te laten zien dat je
      per beeld goedkeurt — een boodschap van één zin, in een scherm van bijna
      duizend pixels.

      Naast elkaar is de figuur ongeveer de helft breed, valt hij op zijn eigen
      breekpunt terug naar twee bij twee (FigApproval doet dat zelf op 520px, en
      een kolom van 1440/2 is smal genoeg om dat te halen), en staat de tekst
      ernaast in plaats van erboven. Op een telefoon stapelen ze zoals ze deden. */}
  <section id="studio" class="paneel" aria-labelledby="vp-sd">
    <div class="vp-studio">
      <div class="vp-studio-tekst">
        <header class="paneel-kop">
          <p class="etiket">{c.secties[5]}</p>
          <h2 id="vp-sd" class="hoog hoog-2">{c.studioH}</h2>
          <p class="lopend">{c.studioLede}</p>
        </header>
        <ul class="beloften" role="list">{c.beloften.map(([k, v]) => <li><b>{k}</b><span class="lopend">{v}</span></li>)}</ul>
        <p class="acties"><a class="knop knop-lijn" href={lp('/portal')}>{c.studioLink}</a><a class="pijl" href={lp('/studio')}>{c.studioLink2}</a></p>
      </div>
      <FigApproval head={c.studioFig.head} okLabel={c.studioFig.ok} revLabel={c.studioFig.rev} waitLabel={c.studioFig.wait} />
    </div>
  </section>

  {/* ── 8 · GEZICHTEN ────────────────────────────────────────────────────────*/}
  <section id="gezichten" class="paneel" aria-labelledby="vp-gz">
    <header class="paneel-kop">
      <p class="etiket">{c.secties[6]}</p>
      <h2 id="vp-gz" class="hoog hoog-2">{c.facesH}</h2>
      <p class="lopend">{c.facesLede}</p>
    </header>
    <ul class="cast" role="list">
      {ROSTER.map((m) => (
        <li>
          <a href={`${lp('/models')}#${modelId(m.name)}`}>
            <span class="kaart kaart-stil"><img src={m.thumb} width={m.tw} height={m.th} alt={m.name} loading="lazy" decoding="async"></span>
            <span class="mono">{m.name}</span>
          </a>
        </li>
      ))}
    </ul>
    <p class="acties"><a class="knop knop-lijn" href={lp('/custom-models')}>{c.facesLink}</a><a class="pijl" href={lp('/models')}>{c.facesLink2}</a></p>
  </section>

  {/* ── 9 · DIRECT ANTWOORD ──────────────────────────────────────────────────*/}
  <section class="paneel" aria-labelledby="vp-q">
    <header class="paneel-kop">
            <h2 id="vp-q" class="hoog hoog-2">{c.qH}</h2>
    </header>
    <ul class="vragen" role="list">
      {c.qs.map(([q, l, href]) => <li><span>{q}</span><a class="pijl" href={lp(href)}>{l}</a></li>)}
      <li><span></span><a class="pijl" href={lp('/faq')}>{c.qAll}</a></li>
    </ul>
  </section>

  {/* ── 10 · HET SLUITSTUK ───────────────────────────────────────────────────
      Eén donkere kaart precies in het midden van het donker, met het
      spookwoord erachter langs — en daarna het gele paneel met de proef. */}
  <section class="kamer kamer-poster" aria-hidden="false">
    <article class="poster">
      <img src={B(5).src} width={B(5).w} height={B(5).h} alt={c.heroAlt} loading="lazy" decoding="async">
      <div class="poster-tekst op-inkt">
        <p class="etiket">{c.labels[0]} · {c.heroChip}</p>
        <p class="hoog hoog-3">{c.setH}</p>
      </div>
    </article>
  </section>

  <section class="paneel paneel-slot" aria-labelledby="vp-sl">
    <p class="etiket">{c.secties[7]}</p>
    <h2 id="vp-sl" class="hoog">{c.closeH}</h2>
    <p class="lopend">{c.closeLede}</p>
    <p class="acties"><a class="knop knop-inkt" href={lp('/test-sample')}>{sample.cta}</a><a class="knop knop-lijn" href={lp('/start')}>{c.closeAlt}</a></p>
  </section>

  <ul class="trustlijn" role="list">{c.trust.map((t) => <li>{t}</li>)}</ul>
</div>
