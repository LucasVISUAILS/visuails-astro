  }

  .wk-step-n { margin: 0 0 .5rem; font-size: .7rem; letter-spacing: .16em; text-transform: uppercase; color: var(--accent); }
  .wk-step-h { margin: 0; font-size: clamp(1.35rem, 3vw, 2rem); line-height: 1.2; letter-spacing: -.01em; }
  .wk-step-b { margin: 1rem 0 0; color: var(--ink-3); font-size: 1rem; line-height: 1.75; }
  .wk-note { margin: 1rem 0 0; font-size: .82rem; color: var(--ink-4); line-height: 1.6; }
  .wk-note a { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }

  .wk-looks { display: flex; flex-wrap: wrap; gap: .45rem; margin-top: 1.4rem; }
  .wk-look { cursor: pointer; }
  .wk-look-box {
    display: flex;
    align-items: center;
    gap: .55rem;
    padding: .35rem .85rem .35rem .35rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    transition: border-color var(--dur-1) var(--ease);
