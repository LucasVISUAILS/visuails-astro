  .wk-out-t {
    position: absolute;
    left: .35rem;
    bottom: .35rem;
    padding: .12rem .4rem;
    border-radius: 4px;
    background: color-mix(in srgb, #08090B 74%, transparent);
    font-size: .64rem;
    color: var(--ink-2);
