  .wk-layer.is-shots { display: block; }
  .wk-src { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: .5rem; }
  .wk-src li { display: flex; flex-direction: column; align-items: center; gap: .45rem; }
