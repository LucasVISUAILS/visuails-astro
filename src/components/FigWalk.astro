  .wk-look input:focus-visible + .wk-look-box { outline: 2px solid var(--accent); outline-offset: 3px; }

  .wk-models { margin-top: 1.4rem; }
  .wk-roster { list-style: none; margin: 0; padding: 0; display: flex; gap: .45rem; }
  .wk-face { display: flex; flex-direction: column; align-items: center; gap: .3rem; font-size: .68rem; color: var(--ink-4); }
  .wk-face img { width: clamp(2.4rem, 6vw, 3rem); aspect-ratio: 4 / 5; object-fit: cover; border-radius: var(--r-sm); filter: grayscale(1); opacity: .4; }
  .wk-face.is-on { color: var(--ink-2); }
  .wk-face.is-on img { filter: none; opacity: 1; outline: 2px solid var(--accent); outline-offset: 2px; }

  .wk-cta { display: flex; flex-wrap: wrap; gap: .6rem; margin-top: 1.8rem; }

  .wk-honest { margin: clamp(3rem, 6vw, 4.5rem) auto 0; max-width: 34rem; font-size: .76rem; color: var(--ink-4); line-height: 1.65; }

  /* ── narrow ───────────────────────────────────────────────────────────── */
  @media (max-width: 720px) {
    .wk-pick-row { grid-template-columns: 1fr; }
    /* Stage plus step has to come to less than one screen, or the step the
       reader is on can never be fully visible under it. */
    :global(.js) .wk-stage { padding-top: 4.4rem; padding-bottom: 1.2rem; }
    .wk-frame { min-height: min(17rem, 32svh); }
    .wk-layer > img, .wk-layer > picture > img { max-height: 30svh; }
    .wk-layer.is-panel { min-height: min(15rem, 28svh); }
    .wk-out[data-walk-count="1"] .wk-out-frame img { max-height: 26svh; }
    :global(.js) .wk-step { min-height: 58svh; justify-content: flex-start; padding-top: 1.2rem; }
    .wk-step-b { font-size: .95rem; line-height: 1.7; }
    /* Smaller than the container's own side padding, so a step at the far
