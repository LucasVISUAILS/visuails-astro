  /* the portal */
  .wk-tiles { list-style: none; margin: 0 auto; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .45rem; max-width: 17rem; }
  .wk-tile { aspect-ratio: 4 / 5; border-radius: var(--r-sm); border: 1px solid var(--line); }
  .wk-tile.is-ok { border-color: var(--accent); background: color-mix(in srgb, var(--accent) 13%, transparent); }
  .wk-tile.is-rev { border-color: #E0A33A; background: color-mix(in srgb, #E0A33A 13%, transparent); }
  .wk-tile.is-wait { background: repeating-linear-gradient(-45deg, transparent 0 5px, var(--line) 5px 6px); }
  .wk-legend { list-style: none; margin: .9rem 0 0; padding: 0; display: grid; gap: .35rem; font-size: .76rem; color: var(--ink-4); justify-items: start; }
  .wk-legend li { display: flex; align-items: center; gap: .45rem; }
  .wk-key { width: .65rem; height: .65rem; border-radius: 3px; border: 1px solid var(--line); }
  .wk-key.is-ok { border-color: var(--accent); background: color-mix(in srgb, var(--accent) 30%, transparent); }
  .wk-key.is-rev { border-color: #E0A33A; background: color-mix(in srgb, #E0A33A 30%, transparent); }

  /* the result */
  .wk-layer.is-out { display: flex; flex-direction: column; justify-content: center; }
  /* CAPPED, so the frame does not grow at the last step. A 34rem-wide 4-up of
     square crops is 536px tall — a hundred and fifty more than every other
     layer — and a sticky box that changes height as you reach the payoff is
     the thing that makes this pattern feel broken. 27rem keeps the two rows
     inside the frame's own minimum — measured: at 27rem the last step still
     grew the stage by 49px, at 24rem it does not grow at all. */
  .wk-out { list-style: none; margin: 0 auto; padding: 0; display: grid; gap: .45rem; width: 100%; max-width: 24rem; }
  .wk-out[data-walk-count="4"] { grid-template-columns: 1fr 1fr; }
  .wk-out[data-walk-count="3"] { grid-template-columns: repeat(3, minmax(0, 1fr)); }
