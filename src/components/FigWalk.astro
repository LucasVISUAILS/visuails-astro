---
/*
 * VISUAILS — FigWalk: één bestelling van formulier tot download.
 * Augustus 2026, volledig herbouwd op 9 september 2026.
 * ═══════════════════════════════════════════════════════════════════════════
 *
 * ── WAT ER WEG IS, EN WAAROM ────────────────────────────────────────────────
 *
 * Lucas, 9 september 2026: *"Je mag pick one to follow ook volledig opnieuw
 * gaan maken omdat ik het niet prettig en onoverzichtelijk vind hoe het op dit
 * moment werkt. Maak het simpeler en logischer, zonder de effecten die nu
 * gebruikt worden."*
 *
 * Wat hier stond was een plakkend kader onder de navigatie met tweeëndertig
 * lagen erin, en zes stappen die er scrollgebonden onderdoor schoven — van
 * links binnen, stil terwijl je leest, naar rechts weg, met de doorzichtigheid
 * gekoppeld aan hoe ver je gescrold was. 3.913 pixels hoog. Gemeten op de
 * schermafdruk van vandaag: op elk moment stond er ÉÉN stap leesbaar en zes als
 * spookjes eronder, en het kader zelf was een zwarte band van 450 pixels met
 * één foto en drie gearceerde vakjes erin, want die foto's zijn nog niet
 * geschoten.
 *
 * Drie dingen daarvan waren fout, en het derde is het ergste:
 *
 *   1 · DE DOORZICHTIGHEID. Tekst die pas leesbaar wordt als je er precies bij
 *       staat, is tekst die je niet kunt overslaan, niet kunt terugzoeken en
 *       niet kunt scannen. Een uitleg over hoe bestellen werkt, is juist iets
 *       waar iemand doorheen bladert tot hij de stap vindt waar hij over
 *       twijfelt.
 *
 *   2 · HET KADER. Het beloofde te tonen "wat er op dat moment bestaat", en wat
 *       er bestaat zijn plaatshouders. Een zwarte band van een halve
 *       schermhoogte die vier keer per doorloop van arcering wisselt, kost
 *       leeshoogte en geeft er niets voor terug.
 *
 *   3 · HET WAS EEN DEMO GEWORDEN IN PLAATS VAN EEN UITLEG. Je moest hem
 *       BEDIENEN — kiezen, scrollen, wachten tot de laag omsloeg — om te lezen
 *       wat er in zes alinea's staat.
 *
 * ── WAT ERVOOR IN DE PLAATS KOMT ────────────────────────────────────────────
 *
 * Een genummerde lijst. Alle zes de stappen staan er tegelijk, alle zes even
 * leesbaar, in dezelfde vorm als de vijf stappen op /start (zie `.st-stappen`
 * in StartPage.astro): een nummer, wie het doet, een kop en een alinea.
 *
 * De keuze BLIJFT, want die is de vraag van de pagina: catalog, lifestyle en
 * video delen geen proces, en een tekening die ze over elkaar heen legt heeft
 * het over alle drie mis. Wat verandert is dat kiezen nu alleen de TEKST
 * wisselt en geen animatie start — drie radio's en een zusterselector, zonder
 * een regel JavaScript. `src/scripts/walk.js` is daarmee overbodig geworden.
 *
 * De twee inhoudelijke details die het kader wél droeg, staan nu in de stap
 * waar ze over gaan: de looks bij "je kiest de look", de gezichten bij "er komt
 * een gezicht bij". Daar zijn het feiten bij een alinea in plaats van lagen in
 * een diavoorstelling.
 *
 * ── DE TEKST IS ONVERANDERD ─────────────────────────────────────────────────
 *
 * WALK_STEPS, WALK_SERVICES en WALK_COPY in src/data/demo.js blijven precies
 * zoals ze waren, en elk getal daarin komt nog steeds uit pricing.js. Dit
 * bestand is alleen de vorm; wat er staat, is niet opnieuw geschreven.
 */
import {
  WALK_SERVICES, WALK_STEPS, WALK_COPY,
  DEMO_MODEL, DEMO_LOCKED_MODELS, DEMO_BACKGROUNDS, walkResult,
} from '../data/demo.js';
import { styles } from '../data/styles.js';
import { styles as stylesNl } from '../data/styles.nl.js';
import { videoStyles } from '../data/videoStyles.js';
import { videoStyles as videoStylesNl } from '../data/videoStyles.nl.js';
import { localizedPath } from '../i18n/ui.js';

interface Props { lang: 'en' | 'nl' }
const { lang } = Astro.props;
const lp = (p: string) => localizedPath(lang, p);

const t = WALK_COPY[lang] || WALK_COPY.en;
const startHref = lp('/start');
const rosterHref = lp('/custom-models');
const sampleHref = lp('/test-sample');

/* Stijlnamen komen uit de stijlmodules en nooit uit demo.js — een stijl kan
   hier niet "Dunes" heten en op /lifestyle iets anders. */
const lifeStyles = lang === 'nl' ? stylesNl : styles;
const vidStyles = lang === 'nl' ? videoStylesNl : videoStyles;
function nameOf(list: any[], slug: string) {
  const hit = list.filter(function match(s: any) { return s.slug === slug; })[0];
  return hit ? hit.name : slug;
}
const bgHex: Record<string, string> = {};
for (const b of DEMO_BACKGROUNDS) bgHex[b.id] = b.hex;

/* De hele boom in de frontmatter, zodat de markup eronder een geneste map is
   zonder logica erin. Dezelfde afspraak als in de vorige versie, en om dezelfde
   reden: dit is de enige manier waarop een sjabloon van deze omvang leesbaar
   blijft. GEEN pijlfuncties in JSX-attributen en geen geïnterpoleerde
   klassenamen — zie de kop van FigPipeline.astro. */
const SERVICES = WALK_SERVICES.map(function build(svc: any) {
  const looks = svc.lookIds.map(function look(id: string) {
    let name = id;
    if (svc.look === 'background') name = t.backgroundNames[id] || id;
    else if (svc.look === 'style') name = nameOf(lifeStyles, id);
    else if (svc.look === 'videoStyle') name = nameOf(vidStyles, id);
    const set = walkResult(svc.id, id);
    return { id: id, name: name, hex: bgHex[id] || null, preview: set[0] };
  });
  return {
    id: svc.id,
    look: svc.look,
    name: t.services[svc.id].name,
    line: t.services[svc.id].line,
    looks: looks,
  };
});

const START = SERVICES[0].id;

/* De nummers worden GEDRUKT, en dat is de uitzondering die DESIGN.md maakt op
   zijn eigen afwijzing van "01/02/03"-decoratie: dit ís een volgorde, en het is
   de echte volgorde — het venster wordt bevestigd vóór de betaling. Wie zich
   afvraagt of hij al betaald heeft voordat de datum vaststaat, leest dat hier
   af aan twee cijfers. */
const STAPPEN = WALK_STEPS.map(function nummer(id: string, i: number) {
  return { id: id, nr: String(i + 1).padStart(2, '0'), ...t.steps[id] };
});
---

<section class="wk" aria-label={t.label}>

  {/* ── DE KEUZE ──────────────────────────────────────────────────────────
      Radio's in labels: één van drie, wederzijds uitsluitend, met de
      pijltjestoetsen te bedienen, en het werkt zonder script. De radio's staan
      vóór de lijsten omdat een zusterselector alleen vooruit kijkt — dezelfde
      constructie als de dienstenkiezer op /start. */}
  <div class="wk-pick">
    <h2 class="wk-pick-h" id="wk-pick-h">{t.pickH}</h2>
    <div class="wk-pick-row" role="radiogroup" aria-labelledby="wk-pick-h">
      {SERVICES.map((svc) => (
        <label class="wk-svc">
          <input type="radio" name="wk-service" value={svc.id} checked={svc.id === START} />
          <span class="wk-svc-box">
            <span class="wk-svc-name">{svc.name}</span>
            <span class="wk-svc-line">{svc.line}</span>
          </span>
        </label>
      ))}
    </div>
    <p class="wk-pick-hint">{t.pickHint}</p>
  </div>

  {SERVICES.map((svc) => (
    <ol class="wk-steps" data-wk-body={svc.id}>
      {STAPPEN.map((stap) => (
        <li class="wk-step">
          <p class="wk-nr" aria-hidden="true">{stap.nr}</p>
          <div class="wk-step-in">
            <p class="wk-step-n">{stap.n}</p>
            <h3 class="wk-step-h">{stap.h}</h3>
            <p class="wk-step-b">{stap.b}</p>

            {/* ── DE LOOKS, BIJ DE STAP DIE EROVER GAAT ────────────────────
                Geen radio's meer. In de vorige versie stuurden ze een laag in
                het kader aan; zonder kader sturen ze niets, en een keuzeknop
                die niets doet is erger dan een plaatje. Het zijn nu wat ze
                altijd al waren: de lijst met looks die deze dienst kent. */}
            {stap.id === 'look' ? (
              <ul class="wk-looks" role="list">
                {svc.looks.map((look) => (
                  <li class="wk-look">
                    {look.hex
                      ? <span class="wk-look-swatch" style={`background:${look.hex}`} aria-hidden="true"></span>
                      : <img class="wk-look-thumb" src={look.preview.src} alt="" width="200" height="200" loading="lazy" decoding="async" />}
                    <span class="wk-look-name">{look.name}</span>
                  </li>
                ))}
              </ul>
            ) : null}
            {stap.id === 'look' && svc.look !== 'background'
              ? <p class="wk-note">{t.lookCustom}</p>
              : null}

            {stap.id === 'model' ? (
              <div class="wk-models">
                <ul class="wk-roster" role="list">
                  <li class="wk-face">
                    <img src={DEMO_MODEL.photo} alt={`Model ${DEMO_MODEL.name}`} width="200" height="250" loading="lazy" decoding="async" />
                    <span>{DEMO_MODEL.name}</span>
                  </li>
                  {DEMO_LOCKED_MODELS.map((m) => (
                    <li class="wk-face">
                      <img src={m.photo} alt={`Model ${m.name}`} width="200" height="250" loading="lazy" decoding="async" />
                      <span>{m.name}</span>
                    </li>
                  ))}
                </ul>
                <p class="wk-note"><a href={rosterHref}>{t.modelRoster}</a></p>
              </div>
            ) : null}

            {stap.id === 'result' ? (
              <p class="wk-cta">
                <a href={sampleHref} class="knop knop-inkt">{t.ctaPrimary}</a>
                <a href={startHref} class="knop knop-lijn">{t.ctaGhost}</a>
              </p>
            ) : null}
          </div>
        </li>
      ))}
    </ol>
  ))}

  <p class="wk-honest">{t.placeholderNote}</p>
</section>

<style>
  /* ═══════════════════════════════════════════════════════════════════════
     FigWalk — de vorm

     ÉÉN REGEL STUURT ALLES HIERONDER: er staat geen enkele stap verborgen,
     doorzichtig of verschoven. Wat je ziet als de pagina laadt, is de hele
     uitleg. `position: sticky`, `transform` en een doorzichtigheidsverloop
     komen hier niet meer voor; zie de kop van dit bestand.
     ═══════════════════════════════════════════════════════════════════════ */

  .wk { margin: 0; }

  /* ── de keuze ─────────────────────────────────────────────────────────── */
  .wk-pick { max-width: 40rem; margin: 0 0 clamp(2.2rem, 4.5vw, 3.4rem); }
  /* De broodletter en niet de koppenletter: op .78rem werd de smalle koplettter
     een streepje van zeven pixels hoog en was het label niet te lezen. */
  .wk-pick-h { font-family: var(--font-body); font-size: .78rem; letter-spacing: .12em; text-transform: uppercase; color: var(--ink-3); margin: 0 0 1rem; font-weight: 700; }
  .wk-pick-row { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .5rem; }
  .wk-pick-hint { margin: 1.1rem 0 0; max-width: 52ch; font-size: .84rem; color: var(--ink-3); line-height: 1.6; }

  /* Weggeknipt en niet `display: none` — dat haalt de radio uit de tabvolgorde
     en uit de toegankelijkheidsboom, en dat is de gebruikelijke manier waarop
     een "eigen radiogroep" stilletjes ophoudt er een te zijn. */
  .wk-svc input {
    position: absolute; width: 1px; height: 1px; opacity: 0;
    margin: 0; pointer-events: none;
  }
  .wk-svc-box {
    display: grid; gap: .2rem; cursor: pointer; height: 100%;
    padding: .8rem 1rem;
    border: 1px solid var(--line-strong); border-radius: var(--r-md, 12px);
    transition: background .25s var(--ease, ease), border-color .25s var(--ease, ease), color .25s var(--ease, ease);
  }
  .wk-svc-box:hover { border-color: var(--ink); }
  .wk-svc-name { font-weight: 700; font-size: .96rem; color: var(--ink); }
  .wk-svc-line { font-size: .8rem; line-height: 1.4; color: var(--ink-3); }
  .wk-svc input:focus-visible + .wk-svc-box { outline: 2px solid var(--ink); outline-offset: 3px; }
  .wk-svc input:checked + .wk-svc-box { background: var(--ink); border-color: var(--ink); }
  .wk-svc input:checked + .wk-svc-box .wk-svc-name { color: var(--bg, #F5F5F5); }
  .wk-svc input:checked + .wk-svc-box .wk-svc-line { color: rgb(245 245 245 / .72); }

  /* ── DE LIJST DIE BIJ DE KEUZE HOORT ──────────────────────────────────────
     Drie lijsten in de HTML, één zichtbaar. Eén regel per combinatie, want een
     zusterselector kan niet rekenen — dezelfde constructie en dezelfde noot als
     bij de bestemmingen op /start.

     `:has()` is met opzet NIET gebruikt: de radio's staan in .wk-pick en de
     lijsten zijn daar broers van, dus een gewone `~` volstaat en die werkt
     overal. */
  .wk-steps { display: none; }
  .wk-pick:has(input[value="catalog"]:checked) ~ [data-wk-body="catalog"],
  .wk-pick:has(input[value="lifestyle"]:checked) ~ [data-wk-body="lifestyle"],
  .wk-pick:has(input[value="video"]:checked) ~ [data-wk-body="video"] { display: grid; }

  /* ── de stappen ───────────────────────────────────────────────────────── */
  .wk-steps {
    grid-template-columns: 1fr;
    gap: clamp(2.2rem, 4.5vw, 3.4rem);
    margin: 0; padding: 0; list-style: none;
    counter-reset: none;
  }
  /* Het nummer in een eigen kolom, met een haarlijn tussen de stappen: dat is
     de vorm van een liniaal en niet van een kaart. Een kaart per stap zou zes
     losse dingen maken van wat één volgorde is. */
  .wk-step {
    display: grid;
    grid-template-columns: 3.2rem minmax(0, 1fr);
    gap: 0 clamp(1rem, 2.5vw, 1.8rem);
    padding-top: clamp(1.2rem, 2.4vw, 1.6rem);
    border-top: 1px solid var(--line);
  }
  .wk-step:first-child { border-top: 0; padding-top: 0; }
  .wk-nr {
    margin: 0;
    font-family: var(--font-mono); font-size: .8rem; font-variant-numeric: tabular-nums;
    color: var(--ink-3); letter-spacing: .04em;
    padding-top: .15rem;
  }
  .wk-step-in { max-width: 58ch; }
  .wk-step-n { margin: 0; font-size: .74rem; letter-spacing: .1em; text-transform: uppercase; color: var(--ink-3); font-weight: 600; }
  .wk-step-h {
    margin: .35rem 0 0;
    font-family: var(--font-heading, var(--font-body));
    font-size: clamp(1.25rem, 2.2vw, 1.7rem); line-height: 1.15; letter-spacing: -.01em;
    color: var(--ink); text-wrap: balance;
  }
  .wk-step-b { margin: .7rem 0 0; font-size: .98rem; line-height: 1.7; color: var(--ink-2); text-wrap: pretty; }

  /* ── de looks ─────────────────────────────────────────────────────────── */
  .wk-looks {
    display: flex; flex-wrap: wrap; gap: .8rem 1rem;
    margin: 1.2rem 0 0; padding: 0; list-style: none;
  }
  .wk-look { display: flex; align-items: center; gap: .5rem; font-size: .86rem; color: var(--ink-2); }
  /* VIERKANT EN NIET ROND, en dat is geen smaak: drie ronde vlakjes van 22px in
     een rij met een woord ernaast zijn niet te onderscheiden van drie radio's,
     en in de vorige versie wáren ze dat ook. Ze zijn nu een staal — de vorm
     waarin de achtergrondkiezer in het bestelformulier ze ook laat zien.
     De rand is de sterke lijn: wit op vel is anders een vlak zonder randen. */
  .wk-look-swatch { width: 34px; height: 26px; border-radius: var(--r-sm, 6px); border: 1px solid var(--line-strong); flex: 0 0 auto; }
  .wk-look-thumb { width: 44px; height: 34px; object-fit: cover; border-radius: var(--r-sm, 8px); flex: 0 0 auto; }
  .wk-look-name { white-space: nowrap; }
  .wk-note { margin: .9rem 0 0; font-size: .82rem; line-height: 1.6; color: var(--ink-3); }
  .wk-note a { color: var(--ink-2); text-decoration: underline; text-underline-offset: 3px; }

  /* ── de gezichten ─────────────────────────────────────────────────────── */
  .wk-models { margin-top: 1.2rem; }
  .wk-roster { display: flex; flex-wrap: wrap; gap: .7rem; margin: 0; padding: 0; list-style: none; }
  .wk-face { display: grid; gap: .3rem; justify-items: center; font-size: .74rem; color: var(--ink-3); }
  .wk-face img { width: 56px; height: 70px; object-fit: cover; border-radius: var(--r-sm, 8px); }

  .wk-cta { display: flex; flex-wrap: wrap; gap: .6rem; margin: 1.4rem 0 0; }

  .wk-honest { margin: clamp(2rem, 4vw, 3rem) 0 0; font-size: .78rem; line-height: 1.6; color: var(--ink-3); max-width: 62ch; }

  @media (max-width: 720px) {
    .wk-pick-row { grid-template-columns: 1fr; }
    /* Het nummer boven de stap in plaats van ernaast: een kolom van 3,2rem naast
       een tekstkolom van 300px kost tien procent van de leesbreedte. */
    .wk-step { grid-template-columns: 1fr; gap: .3rem; }
    .wk-step-b { font-size: .95rem; }
  }
</style>
