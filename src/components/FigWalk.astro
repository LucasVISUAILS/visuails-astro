  .wk-noclip { margin: .65rem 0 0; font-size: .74rem; color: var(--ink-4); text-align: center; }

  /* ── the steps ────────────────────────────────────────────────────────── */
  /* Centred, and wider than the frame it sits under. The first pass left the
     text hard against the container's left edge with the frame centred above
     it, which reads as two things that were laid out separately. A 46rem column
     centred under a 30rem frame is symmetric, and the text still starts on a
     left edge — centred prose at this length is unreadable. */
  .wk-steps { list-style: none; margin: 0 auto; padding: 0; max-width: 34rem; }
  .wk-step { padding: clamp(1.6rem, 4vw, 2.4rem) 0; }
  /* The scroll distance IS the pacing, and the request was for rest. Each step
     gets more than half a screen, so only one is ever near the middle. */
