    moreH: 'De kleinere posten',
    moreSub: 'Sommige zetten iets bij een bestelling die je plaatst, andere staan er los van. Elk heeft een eigen pagina voor de details.',
    moreRows: [
      ['Extra cataloghoek', `${euro(extraPhotoRate(1), 'nl')} tot ${euro(EXTRA_PHOTO_LADDER[EXTRA_PHOTO_LADDER.length - 1][2], 'nl')} per foto, dalend met je aantal`, 'Een zijkant, de binnenkant, een tweede detail — per product bij te zetten in het bestelformulier.', '/catalog'],
      ['Compleet setje', `${euro(OUTFIT_SURCHARGE, 'nl')} per zo gestyled product, tot ${MAX_OUTFIT_PRODUCTS} per bestelling`, 'Meerdere stukken samen gedragen in één lifestyleshot.', '/lifestyle'],
      ['Een eigen look', 'Op aanvraag', 'Eén ontwerpbedrag op schrift; daarna loopt elk product tegen het gewone tarief. Staat daarna als tegel in je account.', '/start/custom-look'],
      ['Hooks', `Vanaf ${euro(AMOUNT.hooks, 'nl')} per hook, op aanvraag`, 'Een korte verticale video die doorloopt in de post eronder. Nog geen bestelknop — jij vraagt, wij bevestigen op schrift.', '/hooks'],
      ['Editions', `${euro(AMOUNT.editions, 'nl')} per maand na een eenmalige ${euro(AMOUNT.editionsSetup, 'nl')} — nog niet te bestellen`, 'Merkbeeld zonder je product erin, maandelijks, bovenop een abonnement. De gedeelde set van de maand komt met elk abonnement zonder meerprijs.', '/editions'],
    ],

    inclH: 'In elke bestelling',
    svcLead: 'Hoe groot je bestelling is, bepaalt hoe we hem inplannen.',
    svcBody: `Vanaf ${WINDOW_THRESHOLD} producten gaat een bestelling in de agenda en krijgt hij een vastgezette leverdatum. Daaronder loopt hij in de normale doorlooptijd. Eén grens, en verder niets wat je hoeft te kiezen.`,
    svcFromTag: `Vanaf ${WINDOW_THRESHOLD} producten`,
    svcUnderTag: `Onder ${WINDOW_THRESHOLD} producten`,
    gateLead: 'We noemen geen datum voordat we in de agenda hebben gekeken.',
    gateBody: 'Je vastgezette leverdatum staat vast voordat je betaalt, nooit erna. Kunnen we de week die je nodig hebt niet vrijhouden, dan zeggen we dat meteen. Je krijgt geen optimistische gok.',

    toPlansH: 'Of hetzelfde werk elke maand',
    toPlansB: 'Heb je elke maand hetzelfde nodig, dan is per maand kopen goedkoper dan bestelling voor bestelling — mits het om diezelfde levering gaat: een catalogset én een lifestyle-carousel per product. Er wordt ook een week in de planning voor je vrijgehouden.',
    toPlansCta: 'Bekijk de abonnementen',

    sampleH: 'Voordat je een bestelling plaatst',
    sampleBody: `Eén product, ${sample.price} ${vatLabel('excl', 'nl')} — ${sample.unit}. Het loopt door dezelfde productie als een betaalde bestelling, dus wat terugkomt is wat je zou krijgen.`,
    // NO VAT LABEL ON A BUTTON. A CTA is a label, not a price quotation, and
    // the site's rule — every printed PRICE carries excl. VAT — is about the
    // figures a customer compares, not about the word on a button. It also
    // overflowed: the Dutch string ran to 363.6px in a 360px viewport. The
    // €1 keeps its label in sampleBody just above, where it sits among
    // other figures and the label means something.
    sampleCta: sample.cta,

    faqH: 'Vragen over prijzen',

    ctaH1: 'Eén product van jezelf,',
    ctaEm: 'als catalogset of carousel.',
    ctaSample: `${sample.cta} ${vatLabel('excl', 'nl')}`,
    ctaStart: 'Start een bestelling',
    ctaWa: 'WhatsApp',
    waText: 'Hoi VISUAILS, ik heb een vraag over de prijzen.',
  },
};

/* Voor de brieftekst op de placeholder hieronder — die is aan de fotograaf
   gericht en niet aan de bezoeker, dus staat hij niet in COPY. */
const nl = lang === 'nl';
const c = { ...COPY[lang], faqs: pricingFaqs(lang) };

// What is true of EVERY order, whatever its size — read from the tier rather
// than typed, and read from the SMALLER tier on purpose.
//
// Under the packages this list described an attended order, because an
// attended order was the only thing the top of the page sold. The ladder sells
// one product at a time upward, so a promise printed here has to hold for an
// order of one. reviewClaim() and aftercare() are identical on both tiers
// today — that is the point of them, section 13's "a different service model,
// not a worse product" — but reading them off `unattended` means this list
// stays true by construction if that ever stops being the case, instead of
// quietly over-promising to the smallest orders.
const included = [
  reviewClaim('unattended', lang),
  aftercare('unattended', lang),
  lang === 'nl'
    ? 'Hoge resolutie en klaar voor je webshop, zonder licentie per gebruik'
    : 'High-resolution and e-commerce-ready, with no per-use licence',
  lang === 'nl'
    ? 'Eén bestelling, één factuur, ongeacht het aantal'
    : 'One order, one invoice, whatever the count',
  lang === 'nl'
    ? 'Hetzelfde tarief op elk product in de bestelling'
    : 'The same rate on every product in the order',
];

// The three facts that DIFFER by order size, side by side.
//
// Not all five TIER_ROWS: `review` and `aftercare` are identical on both tiers
// and are stated once in `included` above instead. A comparison table exists to
// show a difference, and a row that reads the same on both sides invites the
// reader to hunt for the difference that is not there — worse here than
// elsewhere, because the two rows in question are the two the smaller order
// most needs to be believed about.
const SVC_KEYS = ['turnaround', 'queue', 'delivery'];
const svcLabels = tierRowLabels(lang, SVC_KEYS);
const svcRows = TIER_ROWS.filter((r) => SVC_KEYS.includes(r.key));

const nn = (i: number) => String(i).padStart(2, '0');
---

{/* ═══ /pricing IN DE STIJL VAN SECTIE 22 — 7 september 2026 ═════════════════
    Lucas: *"De style is goedgekeurd, bouw verder."* Derde pagina in de stijl,
    na de voorpagina en /models, en de tweede die src/styles/stijl22.css leest.

    De inhoud is niet aangeraakt. Dezelfde COPY in beide talen, dezelfde staffel
    uit pricing.js, dezelfde uitgerekende voorbeelden, dezelfde losse regels en
    dezelfde PlanBand met `id="plans"` voor de oude links. Wat weg is, is de
    oude vorm: de lichtbundel, de tegels, de kaarten met randen.

    DE TABEL BLIJFT EEN TABEL. Dit is een tarievenkaart en dat is tabellaire
    data: wie wil weten wat twaalf lifestyleproducten kosten, hoort de rij en de
    kolom te vinden en te stoppen met lezen. Hij schuift op een telefoon in zijn
    eigen bak, zodat de labels leesbaar blijven in plaats van te krimpen. */}
<div class="s22">

  {/* ── 1 · DE OPENING ───────────────────────────────────────────────────── */}
  <section class="paneel" aria-labelledby="pr-h1">
    <div class="paneel-kop pr-open">
      <p class="etiket">{c.eyebrow}</p>
      <h1 id="pr-h1" class="hoog">{c.h1}</h1>
      <p class="lopend">{c.lead}</p>
      <p class="acties">
        <a class="knop knop-inkt" href={lp('/start')}>{c.ctaStart}</a>
        <a class="knop knop-lijn" href={lp('/test-sample')}>{c.sampleCta}</a>
      </p>
    </div>
  </section>

  {/* ── 2 · DE STAFFEL ───────────────────────────────────────────────────── */}
  <section class="paneel" aria-labelledby="pr-ladder">
    <header class="paneel-kop">
      <p class="etiket">{c.ladderProductsCol}</p>
      <h2 id="pr-ladder" class="hoog hoog-2">{c.ladderH}</h2>
      <p class="lopend">{c.ladderSub}</p>
    </header>

    <div class="tabel-schuif">
      <table class="lijst pr-staffel">
        <thead>
          <tr>
            <th scope="col" class="mono">{c.ladderProductsCol}</th>
            {KIND_IDS.map((id) => (
              <th scope="col">
                <span class="mono pr-soort">{KIND_PAGE[id] ? <a href={lp(KIND_PAGE[id] as string)}>{c.kinds[id].name}</a> : c.kinds[id].name}</span>
                <span class="pr-soort-sub">{c.kinds[id].sub}</span>
                <span class="mono pr-soort-btw">{c.perProduct} · {vatLabel('excl', lang)}</span>
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          {rungs.map((r, ri) => (
            <tr>
              <th scope="row" class="mono">{r.label}</th>
              {KIND_IDS.map((id) => (
                <td class="tarief">
                  {euro(ladderRate(id, r.at), lang)}
                  {id === 'complete' && (
                    <span class="pr-besparing mono">−{euro(completeSaving(r.at).saved, lang)}{ri === 0 && <em> {c.kinds.saveUnit}</em>}</span>
                  )}
                </td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="mono pr-hint">{c.ladderScrollHint}</p>

    {/* De vermenigvuldiging, gedaan. Drie aantallen, helemaal uitgerekend. */}
    <div class="pr-uitgerekend">
      <header class="pr-uit-kop">
        <h3 class="hoog hoog-3">{c.workedH}</h3>
        <p class="lopend">{c.workedSub}</p>
      </header>
      <ul class="pr-som" role="list">
        {/* ── HET VOORBEELD REKENT MET DE CATALOGSET — 8 september 2026 ────
            Het rekende met `complete`, zonder dat ergens stond dat dat de
            bundel was: "5 producten · €545". Wie hier kwam op "vanaf €89"
            zag een bedrag dat bij een ander product hoort, en de Nederlandse
            ondertitel zei alleen "compleet uitgerekend" — waar "compleet" óók
            de naam van dat product is. Dat woord deed twee dingen tegelijk.

            Nu staat het instapproduct groot en de bundel eronder, met de naam
            erbij. Twee bedragen die zichzelf uitleggen in plaats van één dat
            uitleg nodig heeft. */}
        {WORKED.map((n) => {
          const q = quote('catalog', n);
          const qb = quote('complete', n);
          return (
            <li>
              <span class="mono">{n} {c.workedUnit}</span>
              <b class="hoog hoog-3">{euro(q.net, lang)}</b>
              <span class="mono pr-som-sub">{euro(q.rate, lang)} {c.perProduct} · {vatLabel('excl', lang)}</span>
              <span class="mono pr-som-bundel">{c.workedBundle} {euro(qb.net, lang)}</span>
            </li>
          );
        })}
      </ul>
    </div>

    <p class="pr-eerste lopend"><b>{c.firstLead}</b> {c.firstBody}</p>
    <p class="acties">
      <a class="knop knop-inkt" href={lp('/start')}>{c.ladderCta}</a>
      <a class="pijl" href={lp('/compare')}>{c.compareCta}</a>
    </p>
  </section>

  {/* ── 3 · TOE TE VOEGEN AAN EEN BESTELLING ─────────────────────────────────
      De donkere kamer van deze pagina: twee dingen die je bij een bestelling
      zet, en daaronder de kleine regels als haarlijnen. */}
  <section class="kamer pr-kamer" aria-labelledby="pr-add">
    <header class="kamer-kop">
      <p class="etiket">{c.eyebrow}</p>
      <h2 id="pr-add" class="hoog hoog-2">{c.addOnH}</h2>
      <p class="lopend">{c.addOnSub}</p>
    </header>

    <div class="pr-twee">
      <article class="pr-toevoeging">
        <h3 class="hoog hoog-3">{c.brandModelName}</h3>
        <p class="lopend">{c.brandModelLine}</p>
        {/* De zwevende notitie blijft: hij hangt met aria-describedby aan de
            prijs en legt uit dat het bedrag eenmalig is. tests/notitie.test.mjs
            eist er minstens één op deze pagina, en terecht — het verschil
            tussen "eenmalig" en "per bestelling" is hier het hele bedrag. */}
        <p class="pr-prijs">
          <b class="hoog hoog-3">{euro(AMOUNT.brandModel, lang)}</b>
          <span class="mono">{c.brandModelUnit} · {vatLabel('excl', lang)}</span>
          <Note lang={lang} term={c.brandModelName} wide>{c.brandModelNote}</Note>
        </p>
        <p class="acties"><a class="pijl" href={lp('/custom-models')}>{c.brandModelCta}</a></p>
      </article>
      <article class="pr-toevoeging">
        <h3 class="hoog hoog-3"><a href={lp('/video')}>{c.videoName}</a></h3>
        <p class="lopend">{c.videoLine}</p>
        <p class="pr-prijs"><b class="hoog hoog-3">{euro(AMOUNT.video, lang)}</b><span class="mono">{c.videoUnit} · {vatLabel('excl', lang)}</span></p>
        <p class="mono pr-lijst-kop">{c.videoIncH}</p>
        <ul class="pr-lijst" role="list">{c.videoList.map((f) => <li>{f}</li>)}</ul>
        <p class="acties"><a class="pijl" href={lp('/video')}>{c.videoCta}</a></p>
      </article>
    </div>

    <div class="pr-meer">
      <h3 class="hoog hoog-3">{c.moreH}</h3>
      <p class="lopend">{c.moreSub}</p>
      <dl class="pr-regels">
        {c.moreRows.map(([naam, prijs, uitleg, href]) => (
          <div class="pr-regel">
            <dt><a class="pijl" href={lp(href)}>{naam}</a></dt>
            <dd><b>{prijs}</b><span class="lopend">{uitleg}</span></dd>
          </div>
        ))}
      </dl>
      <p class="mono">{vatLabel('excl', lang)}</p>
    </div>
  </section>

  {/* ── 4 · OF ELKE MAAND ────────────────────────────────────────────────────
      Lucas, 9 september: *"Deze sectie voelt ook heel erg random en kan beter
      in de website geïntegreerd worden."*

      Hier stond `<section class="paneel pr-plan">` met de band erin: een
      donkere rechthoek in een witte kaart op een donkere ondergrond. Drie
      kaders om elkaar heen, en dat is waar "random" vandaan kwam. PlanBand IS
      nu de sectie — een kamer van deze pagina, in dezelfde taal als de kamer
      erboven — dus er hoort geen paneel meer omheen. Hij draagt `id="plans"`
      voor oude links. */}
  <PlanBand lang={lang} id="plans" />

  {/* ── 5 · DE PROEF ─────────────────────────────────────────────────────── */}
  <section class="paneel" aria-labelledby="pr-proef">
    <div class="pr-proef">
      <div class="paneel-kop">
        <p class="etiket">{c.sampleH}</p>
        <h2 id="pr-proef" class="hoog hoog-2">{c.sampleH}</h2>
        <p class="lopend">{c.sampleBody}</p>
        <p class="acties"><a class="knop knop-inkt" href={lp('/test-sample')}>{c.sampleCta}</a></p>
      </div>
      <div class="pr-scene"><ProductScene icon="bottle" width="42%" badge={sample.unit} wide /></div>
    </div>
  </section>

  {/* ── 6 · HET SLOT ─────────────────────────────────────────────────────── */}
  <section class="paneel paneel-slot" aria-labelledby="pr-slot">
    <h2 id="pr-slot" class="hoog">{c.ctaH1} <em>{c.ctaEm}</em></h2>
    <p class="acties">
      <a class="knop knop-inkt" href={lp('/test-sample')}>{c.ctaSample}</a>
      <a class="knop knop-lijn" href={lp('/start')}>{c.ctaStart}</a>
      <a class="knop knop-lijn" href={waHref(c.waText)} target="_blank" rel="noopener">{c.ctaWa}</a>
    </p>
  </section>
</div>

<style>
  /* Alleen wat deze pagina eigen is; de rest komt uit stijl22.css. */
  .pr-open { max-width: 52rem; margin-bottom: 0; }

  /* De staffel. Eén tabel, drie kolommen, en de bedragen in de brede snit —
     de enige plek op de pagina waar de letter opvalt. */
  .pr-staffel thead th { vertical-align: bottom; }
  .pr-soort { display: block; }
  .pr-soort-sub { display: block; margin-top: .35rem; font-size: .8rem; color: var(--inkt-2); text-transform: none; letter-spacing: 0; font-family: var(--tekst2); max-width: 22ch; margin-left: auto; }
  .pr-soort-btw { display: block; margin-top: .35rem; color: var(--inkt-2); }
  .pr-staffel td { padding-block: 1rem; }
  .pr-besparing { display: block; margin-top: .35rem; color: var(--inkt-2); font-size: .72rem; }
  .pr-besparing em { font-style: normal; background: none; padding: 0; }
  .pr-hint { margin-top: .8rem; color: var(--inkt-2); }
  @media (min-width: 561px) { .pr-hint { display: none; } }

  .pr-uitgerekend { margin-top: clamp(2.5rem, 6vw, 4.5rem); display: grid; gap: clamp(1.25rem, 3vw, 2rem); }
  .pr-uit-kop { display: grid; gap: .6rem; }
  .pr-som { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(.7rem, 2vw, 1.5rem); }
  .pr-som li { display: grid; gap: .35rem; padding-top: 1rem; border-top: 1px solid var(--inkt); }
  .pr-som-sub { color: var(--inkt-2); }
  /* De bundel als tweede regel: kleiner en lichter dan het hoofdbedrag, met een
     haarlijn erboven zodat het als een aparte mededeling leest en niet als een
     vervolg op de regel erboven. */
  .pr-som-bundel { margin-top: .6rem; padding-top: .5rem; border-top: 1px solid var(--lijn); color: var(--inkt-3); font-size: .74rem; }
  .pr-eerste { margin-top: clamp(2rem, 4vw, 3rem); max-width: 46em; }
  .pr-eerste b { font-weight: 500; }
  .pr-eerste + .acties { margin-top: 1.5rem; }

  /* De donkere kamer: twee toevoegingen naast elkaar, daaronder de regels. */
  .pr-twee { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(1.5rem, 4vw, 3.5rem); }
  .pr-toevoeging { display: grid; gap: .7rem; align-content: start; padding-top: 1.2rem; border-top: 1px solid rgb(245 245 245 / .22); }
  .pr-prijs { display: flex; flex-wrap: wrap; align-items: baseline; gap: .6rem; }
  .pr-prijs .mono { color: rgb(245 245 245 / .66); }
  .pr-lijst-kop { color: rgb(245 245 245 / .66); margin-top: .4rem; }
  .pr-lijst { display: grid; gap: .45rem; color: rgb(245 245 245 / .68); font-size: .95rem; }
  .pr-lijst li { padding-left: 1.1rem; position: relative; }
  .pr-lijst li::before { content: "—"; position: absolute; left: 0; color: var(--geel); }

  .pr-meer { margin-top: clamp(3rem, 7vw, 5rem); display: grid; gap: .8rem; }
  .pr-regels { margin-top: 1rem; display: grid; }
  .pr-regel { display: grid; grid-template-columns: minmax(0, 16rem) minmax(0, 1fr); gap: clamp(1rem, 3vw, 2.5rem); padding: 1.1rem 0; border-top: 1px solid rgb(245 245 245 / .14); }
  .pr-regel:last-child { border-bottom: 1px solid rgb(245 245 245 / .14); }
  .pr-regel dd { display: grid; gap: .35rem; margin: 0; }
  .pr-regel dd b { font-weight: 500; }

  /* PlanBand komt uit de oude opmaak; hij krijgt hier alleen lucht. */

  .pr-proef { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, .9fr); gap: clamp(1.5rem, 5vw, 4rem); align-items: center; }
  .pr-proef .paneel-kop { margin-bottom: 0; }
  .pr-scene { display: grid; place-items: center; }

  @media (max-width: 900px) {
    .pr-som { grid-template-columns: 1fr; }
    .pr-twee, .pr-proef { grid-template-columns: 1fr; }
    .pr-regel { grid-template-columns: 1fr; gap: .5rem; }
    .pr-soort-sub { display: none; }
  }
</style>
