    anchorPerProduct: `${euro(ladderRate('complete', ANCHOR_PRODUCTS), 'nl')} per product bij dat aantal · ${vatLabel('excl', 'nl')}`,
    anchorNowList: [
      'Niets opsturen, nergens naartoe, geen dag uit de zaak',
      'Wat je krijgt staat vast voordat je betaalt',
