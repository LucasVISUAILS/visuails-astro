  nl: {
    eyebrow: 'Prijzen',
    h1: 'Geprijsd per product. Het tarief daalt naarmate het aantal stijgt.',
    lead: `Eén eenheid: een product. Eén tarief, en dat gaat alleen maar een trede omlaag. Elk aantal heeft een prijs, dus geen bestelling kost per product meer dan een kleinere — en er is geen pakket waar je lijn in moet passen.`,

    ladderH: 'De staffel',
    ladderSub: 'Kies de scope, tel je producten, lees het tarief. Het tarief geldt voor elk product in de bestelling, niet alleen voor de producten voorbij de trede.',
    ladderProductsCol: 'Producten',
    kinds: {
      complete: { name: 'Compleet', sub: 'Catalogset en lifestyle-carousel — zeven beelden per product' },
      catalog: { name: 'Catalogset', sub: 'Vanaf vier beelden per product' },
      lifestyle: { name: 'Lifestyle-carousel', sub: 'Drie beelden per product' },
    },

    workedH: 'Wat dat wordt',
    workedSub: 'Drie aantallen op de complete scope, uitgerekend, zodat de tabel geen huiswerk is.',
    workedUnit: 'producten',
    perProduct: 'per product',

    firstLead: `Je eerste bestelling is ${firstPct} goedkoper.`,
    firstBody: `Eenmalig per merk, bij elke omvang. Het is wat het pilotpakket was, zonder het vaste aantal: ${WORKED[1]} complete producten is ${euro(firstEg.listTotal, 'nl')} ${vatLabel('excl', 'nl')}, en bij een eerste bestelling is dat ${euro(firstEg.net, 'nl')} ${vatLabel('excl', 'nl')}.`,
    ladderCta: 'Start een bestelling',

    anchorH: 'Wat dit vervangt',
    anchorWasTag: 'Een productiedag',
