---
// VISUAILS — /pricing, the page that decides what the studio sells.
//
// One component for both languages, same reason as StartPage.astro: the brief
// requires every change to land in EN and NL together, and one source file is
// the only way to guarantee that rather than merely intend it.
//
// EVERY EURO ON THIS PAGE IS READ FROM src/data/pricing.js. Nothing is typed
// into this markup — not a price, not a product count, not a turnaround. If a
// number here is wrong, it is wrong in pricing.js, and pricing.js fails the
// build before a broken ladder can ship.
//
// AND EVERY PRINTED PRICE SAYS WHETHER VAT IS IN IT, using vatLabel(). Never a
// typed "excl. VAT" — that string has to be translatable and it has to move if
// the rule moves, and BRIEF-14 calls this its hardest rule for the good reason
// that a page which prints one net figure and one gross figure without saying
// which is which has quoted two different prices for the same thing. The net
// figure leads everywhere on this page, because that is what a business pays;
// the gross figure sits beside it, because that is what leaves the account.
//
// WHAT THIS REPLACED, and why (see section 0 of src/data/pricing.js, which is
// the governing document for the new model):
//   · The two drop PACKAGES as the headline offer → THE LADDER. The packages
//     asked the buyer for a size and a service level at once, and left a hole
//     between 8 and 25 products where the à la carte route cost more than the
//     bigger package. A rate per product that only ever falls cannot open that
//     hole again: every count has a price, and no count is punished.
//   · The Drop Pilot → FIRST_ORDER_DISCOUNT. The Pilot was a discount with a
//     fixed size and a "once per brand" rule bolted on. A plain percentage off
//     a first order is the same incentive at every size, with nothing to
//     explain.
//   · The Tier 0 block at the bottom → THE PLANS. Tier 0 was a second price
//     list for the same work; the ladder already covers small counts, so what
//     the bottom of the page needed was the other axis — buying the same
//     output every month, cheaper, instead of order by order.
//   · The studio retainer → the top plan, which is the same offer with its
//     arithmetic shown.
//   · "Priority delivery, +€29.99", "Multi Format Export", "4K Export",
//     invented volume bands → all REMOVED in the previous pass, and none of
//     them come back with the ladder: the ladder IS the volume answer.
//   · "€1,000–2,000+ / day" shoot anchor → SHOOT_DAY, itemised (flag 2).
//   · Every CTA pointed at /order. That page is deleted; the CTAs point at
//     /start, and /order is a 301 to it in public/_redirects.
//
// THE WORD "DROP" IS NOT WHAT WE SELL ANY MORE, on this page or anywhere. It
// means a collection going live — that is what it means to the people we sell
// to, and using it for a work order made one word carry two meanings in the
// same sentence. What we sell is an order, or a batch; in Dutch, een
// bestelling. The word survives only where the CLIENT's launch is meant.
//
// The ThreeWay comparison block was dropped from this page rather than ported:
// it still carries the retired 24-hour claim (task #190) and /compare is the
// page that argument belongs on. The shoot-day anchor does that job here.
import {
  LADDER, ladderRate, quote, FIRST_ORDER_DISCOUNT,
  plans, PLAN_AMOUNT, PLAN_CLIPS,
  SHOOT_DAY, TEST_SAMPLE,
  reviewClaim, aftercare, euro, AMOUNT,
  TIER_ROWS, tierRow, tierRowLabels,
  WINDOW_THRESHOLD, vatLabel, vatNote,
  BRAND_MODEL_CREDIT_DROPS,
} from '../data/pricing.js';
// The six pricing questions are NOT in this file. They live in
// src/data/faq.js, because src/data/schema.js emits them a second time as this
// page's FAQPage JSON-LD, and an answer written twice is an answer that will
// eventually be updated once. `faqH` — the heading above them — stays here: it
// is page furniture, not a question.
import { pricingFaqs } from '../data/faq.js';
import Disclose from './Disclose.astro';
import { localizedPath } from '../i18n/ui.js';
import ProductScene from './ProductScene.astro';
import FigPayback from './FigPayback.astro';

interface Props { lang: 'en' | 'nl'; }
const { lang } = Astro.props;
const lp = (p: string) => localizedPath(lang, p);

// The two tiers are no longer read as objects here. Everything this page says
// about either of them goes through the accessors — reviewClaim(), aftercare(),
// tierRow() — which is what pricing.js asks for ("pages use this, never a
// literal"), and what lets a promise be tightened in one place.
const sample = TEST_SAMPLE[lang];
const shoot = SHOOT_DAY[lang];

// ── The ladder table ───────────────────────────────────────────────────────
// The three kinds, in the order the table reads them. Complete first because
// it is the scope everything else on the page quotes — the two singles are
// what you buy when you want half of it, not the default.
const KIND_IDS = ['complete', 'catalog', 'lifestyle'] as const;

// Two of the three kinds are a pillar page under another name, so the column
// heading is the link — the brief's internal-linking rule (§1) without a row
// of "learn more" chips underneath. `complete` has no page of its own: it is
// both of the others bought together, so linking it anywhere would send a
// reader to half of what the column describes.
const KIND_PAGE: Record<string, string | null> = {
  complete: null,
  catalog: '/catalog',
  lifestyle: '/lifestyle',
};

// The rung bounds are read off ONE kind and reused for all three columns,
// which is only honest if all three kinds break at the same counts. They do —
// see LADDER in pricing.js, where the three lists are deliberately parallel —
// but a table whose row labels come from one column and whose rates come from
// three is exactly the kind of quiet lie that survives a price change. So it
// is checked here rather than trusted, and the build stops if a future edit
// gives one kind its own bands.
const rungs = LADDER.complete.map(([lo, hi]) => ({
  lo,
  hi,
  // The count to ask ladderRate() for. The bottom of the band, because that is
  // the count the label promises the rate from.
  at: lo,
  label: hi === null ? `${lo}+` : `${lo}–${hi}`,
}));
for (const id of KIND_IDS) {
  const shape = LADDER[id].map(([lo, hi]) => `${lo}:${hi}`).join(',');
  const expected = LADDER.complete.map(([lo, hi]) => `${lo}:${hi}`).join(',');
  if (shape !== expected) {
    throw new Error(
      `PricingPage.astro: the "${id}" ladder does not break at the same counts ` +
      `as "complete" (${shape} vs ${expected}). The rate table prints one set ` +
      `of row labels across all three columns, so it would be quoting ${id} ` +
      `rates against the wrong product counts. Give the table its own labels ` +
      `per column, or put the ladders back in step.`
    );
  }
}

// Three worked totals, so the reader does not have to multiply.
//
// THE THREE COUNTS ARE A CHOICE, and this is the reasoning, because the next
// editor will want to change them: 5 is the first count off the entry rung —
// the smallest order that is already cheaper per product than a single one;
// the middle count is the one the old package model had no answer for, where a
// brand paid à la carte because it fell between the Pilot and the Full Drop,
// and it is the count this whole model exists to price properly; the last is a
// full collection, and it is also what the anchor below compares against a
// production day, so the two sections cannot quote different sizes.
const WORKED = [5, 14, 30];
const ANCHOR_PRODUCTS = WORKED[WORKED.length - 1];

// The first-order discount as a percentage, computed rather than written. A
// typed "20%" beside a constant of 0.20 is two sources of truth for one
// number, and the typed one is the one that gets missed.
const firstPct = `${Math.round(FIRST_ORDER_DISCOUNT * 100)}%`;
// The worked example under the discount — the same middle count as the tiles,
// list price and first-order price, both from quote() so the subtraction is
// the module's and not this page's.
const firstEg = quote('complete', WORKED[1], { firstOrder: true });

// The plans, and the one card that needs to be named in another section's copy.
const planList = plans(lang);
const planById = Object.fromEntries(planList.map((p) => [p.id, p]));

// ── Copy ───────────────────────────────────────────────────────────────────
// Prose only. Every promise — timing, queue, delivery, review level, every
// euro, every VAT label — is interpolated from pricing.js, in both languages,
// out of the same objects.
const COPY = {
  en: {
    eyebrow: 'Pricing',
    h1: 'Priced per product. The rate falls as the count rises.',
    lead: `One unit: a product. One rate, and it only ever moves down a rung. Every count has a price, so no order costs more per product than a smaller one — and there is no package to squeeze your line into.`,

    ladderH: 'The ladder',
    ladderSub: 'Pick the scope, count your products, read the rate. The rate applies to every product in the order, not only the ones past the rung.',
    ladderProductsCol: 'Products',
    kinds: {
      complete: { name: 'Complete', sub: 'Catalog set and lifestyle carousel — seven images per product' },
      catalog: { name: 'Catalog set', sub: 'From four images per product' },
      lifestyle: { name: 'Lifestyle carousel', sub: 'Three images per product' },
    },

