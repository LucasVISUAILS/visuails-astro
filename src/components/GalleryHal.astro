<div class="h-pagina h-gl-pagina">

  {/* ── 1 · DE KOP ─────────────────────────────────────────────────────────── */}
  <header class="h-paginakop met-kopbeeld">
    <div class="h-paginakop-tekst">
      <p class="h-pil h-op" style="--d:0"><span>{c.eyebrow}</span></p>
      <h1 class="h-kop h-h1 h-op" style="--d:1"><span class="l">{H.h1[0]}</span> <span>{H.h1[1]}</span></h1>
      <p class="h-lede h-op" style="--d:2">{c.lead}</p>
      <p class="h-acties h-op" style="--d:3">
        <a class="h-knop h-knop-inkt" href={lp('/start')}>{c.ctaStart}<span class="o" set:html={ik('rechts')} /></a>
        <a class="h-knop h-knop-lijn" href={lp('/test-sample')}>{c.ctaSample}</a>
      </p>
    </div>
    <KopBeeld {...BEELD} />
  </header>

  {/* ── 2 · LEVERINGEN, OF ALLE BEELDEN ──────────────────────────────────────
      De schakelaar is twee radioknoppen en geen script (zoals in GalleryPage): de keuze
      werkt zonder JavaScript, met :has() in hal.css. Het script onderaan zet #alle-beelden
      in de adresbalk en opent het raster als de link dat anker heeft. */}
  <section class="h-sec h-gl" aria-labelledby="gal-werk">
    <h2 id="gal-werk" class="sr-only">{c.h1}</h2>
    <div class="h-gl-wissel h-in" role="radiogroup" aria-label={c.weergave}>
      <input class="h-gl-radio" type="radio" name="gal-weergave" id="gw-levering" value="levering" checked />
      <label class="h-gl-seg" for="gw-levering">{c.wLevering}</label>
      <input class="h-gl-radio" type="radio" name="gal-weergave" id="gw-alles" value="alles" />
      <label class="h-gl-seg" for="gw-alles">{c.wAlles} <span class="h-gl-tal">{photos.length}</span></label>
    </div>

    <div class="h-gl-levering">
      <div class="h-gl-filters" data-gl-filters hidden>
        <div class="h-gl-pillen" role="group" aria-label={c.dienstLabel}>
          <button type="button" class="h-gl-pil" data-gl-dienst="all" aria-pressed="true">{c.alleDiensten}</button>
          {dienstKnoppen.map((d) => (
            <button type="button" class="h-gl-pil" data-gl-dienst={d} aria-pressed="false">{DIENSTEN[d][T]}</button>
          ))}
        </div>
        <label class="h-gl-soort">
          <span class="sr-only">{c.soortLabel}</span>
          <select data-gl-soort>
            <option value="all">{c.alleSoorten}</option>
            {soortKeuzes.map((s) => <option value={s}>{SOORTEN[s][T]}</option>)}
          </select>
        </label>
      </div>

      <ul class="h-gl-lijst" role="list" data-gl-lijst>
        {leveringen.map((l, i) => (
          <li class={`h-gl-item${l.plaatshouder || l.video ? ' is-volgt' : ''}`} data-dienst={l.dienst} data-soort={l.soort}>
            {l.plaatshouder || l.video ? (
              <div class="h-gl-kaart h-gl-volgt">
                <span class="h-gl-volgt-vlak" aria-hidden="true">
                  <span class="h-cirkel h-cirkel-wit" set:html={ik(l.video ? 'speel' : 'beeld')} />
                  <span class="h-gl-volgt-t">{l.video ? c.clipVolgt : c.volgt}</span>
                  <span class="h-gl-volgt-m">{l.video ? c.clipSpec : `${l.n} ${c.beelden}`}</span>
                </span>
                <p class="h-gl-naam">{l.naam}</p>
                <p class="h-gl-meta">{l.video ? `${l.dienstNaam} · ${l.soortNaam} · ${l.n} ${c.clip}` : `${l.dienstNaam} · ${l.soortNaam} · ${l.n} ${c.beelden}`}</p>
              </div>
            ) : (
              <details class="h-gl-kaart h-gl-echt" open={i === 0}>
                <summary class="h-gl-kop">
                  <span class="h-gl-duimen" aria-hidden="true">
                    <span class="h-gl-duim is-in"><img src={duimIn.src} width={duimIn.w} height={duimIn.h} alt="" loading="lazy" decoding="async" /></span>
                    <span class="h-gl-pijl" set:html={ik('rechts')} />
                    {duimUit.map((b) => <span class="h-gl-duim"><img src={b.src} width={b.w} height={b.h} alt="" loading="lazy" decoding="async" /></span>)}
                  </span>
                  <span class="h-gl-tekst">
                    <span class="h-gl-naam">{l.naam}</span>
                    <span class="h-gl-meta">{l.dienstNaam} · {l.soortNaam} · {l.n} {c.beelden}</span>
                  </span>
                  <span class="h-gl-open" aria-hidden="true"><span class="h-gl-open-dicht">{c.bekijk}</span><span class="h-gl-open-open">{c.sluit}</span><span class="h-cirkel h-cirkel-klein" set:html={ik('plus')} /></span>
                </summary>
                <div class="h-gl-vol">
                  <LeveringHal lang={lang} nummer={l.ref} product={l.naam} dienst={l.dienst as 'catalog' | 'lifestyle'} plaatshouder={false} id={`lv-${l.id}`} uitleg />
                </div>
              </details>
            )}
          </li>
        ))}
      </ul>
      <p class="h-gl-geen" data-gl-geen hidden>{c.geen}</p>
    </div>

    <div class="h-gl-alles" id="alle-beelden">
      <header class="h-sec-kop">
        <div>
          <h2 class="h-kop h-h2"><span class="l">{H.alles[0]}</span> {H.alles[1]}</h2>
        </div>
        <p class="h-pr-kopzin">{c.allesLead}</p>
      </header>
      <div class="h-gl-pillen h-gl-stijlen" role="group" aria-label={c.filterLabel}>
        {filters.map((f) => (
          <button type="button" class="h-gl-pil" data-filter-key={f.key} aria-pressed={f.key === 'all' ? 'true' : 'false'}>{f.label}</button>
        ))}
      </div>
      <div class="h-gl-raster" data-filterable>
        {photos.map((p) => (
          <img
            src={p.src}
            srcset={srcset(p.src, p.wide, p.w) || undefined}
            sizes={srcset(p.src, p.wide, p.w) ? (p.wide ? SIZES_BREED : SIZES_GEWOON) : undefined}
            alt={p.alt}
            loading="lazy"
            decoding="async"
            width={p.w}
            height={p.h}
            class={p.wide ? 'is-breed' : ''}
            data-tag={p.tag}
          />
        ))}
      </div>
    </div>
  </section>

  {/* ── 3 · HET SLOT: de proef ─────────────────────────────────────────────── */}
  <HalProef lang={lang} id="gal-slot" kop={H.slot} zin={H.slotZin} alt={{ label: c.ctaStart, href: '/start' }} />
</div>
<HalBeweging />

<script>
  import '../scripts/galerij-filter.js';

  /* ── DE FILTERS VAN DE LEVERINGEN — 23 september 2026 ────────────────────
     Dienst (pillen) en productsoort (keuzemenu). Pas zichtbaar als dit script
     draait; zonder script staan alle kaarten er. */
  const zetLeveringen = () => {
    const balk = document.querySelector<HTMLElement>('[data-gl-filters]');
    const lijst = document.querySelector<HTMLElement>('[data-gl-lijst]');
    if (!balk || !lijst || balk.dataset.klaar) return;
    balk.dataset.klaar = '1';
    balk.hidden = false;
    const knoppen = [...balk.querySelectorAll<HTMLButtonElement>('[data-gl-dienst]')];
    const soort = balk.querySelector<HTMLSelectElement>('[data-gl-soort]');
    const geen = document.querySelector<HTMLElement>('[data-gl-geen]');
    const items = [...lijst.querySelectorAll<HTMLElement>('li[data-dienst]')];
    let dienst = 'all';
    const werk = () => {
      const s = soort?.value || 'all';
      let zichtbaar = 0;
      for (const li of items) {
        const aan = (dienst === 'all' || li.dataset.dienst === dienst) && (s === 'all' || li.dataset.soort === s);
        li.hidden = !aan;
        if (aan) zichtbaar += 1;
      }
      if (geen) geen.hidden = zichtbaar > 0;
      for (const k of knoppen) k.setAttribute('aria-pressed', String(k.dataset.glDienst === dienst));
    };
    for (const k of knoppen) k.addEventListener('click', () => { dienst = k.dataset.glDienst || 'all'; werk(); });
    soort?.addEventListener('change', werk);
    werk();
  };
  zetLeveringen();
  document.addEventListener('astro:page-load', zetLeveringen);

  /* De schakelaar en het anker. Zie de noot boven de kamer. */
  const zet = () => {
    const alles = document.getElementById('gw-alles') as HTMLInputElement | null;
    const levering = document.getElementById('gw-levering') as HTMLInputElement | null;
    if (!alles || !levering || alles.dataset.klaar) return;
    alles.dataset.klaar = '1';
    if (location.hash === '#alle-beelden') alles.checked = true;
    const schrijf = () => {
      const url = new URL(location.href);
      url.hash = alles.checked ? 'alle-beelden' : '';
      history.replaceState(history.state, '', url.pathname + url.search + (alles.checked ? '#alle-beelden' : ''));
    };
    alles.addEventListener('change', schrijf);
    levering.addEventListener('change', schrijf);
  };
  zet();
  document.addEventListener('astro:page-load', zet);
</script>
