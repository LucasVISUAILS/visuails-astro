/* ── DE LEVERINGEN — 23 september 2026 ─────────────────────────────────────
   Zie src/data/leveringen.js. Per kaart: één ingestuurde foto, drie geleverde
   beelden als duim, en het hele verloop (Levering.astro) achter een <details>.
   De beelden zijn voorlopig de voorbeeldset; waar dat een plaatshouder is,
   staat het op de kaart. */
const T = nl ? 'nl' : 'en';
const duimIn = ingestuurd(lang)[0];
const duimUit = geleverd(lang).slice(0, 3);
const leveringenAlle = LEVERINGEN.map((l) => ({
  ...l,
  naam: l.product[T],
  dienstNaam: DIENSTEN[l.dienst][T],
  soortNaam: SOORTEN[l.soort][T],
  plaatshouder: l.beelden === 'volgt',
  /* Het aantal beelden van DE DIENST en niet van de plaatshouder (24 september
     2026): een lifestylekaart zei "4 beelden" omdat de voorbeeldset een
     catalogset is. Een carrousel is vier beelden (sinds 14 oktober 2026); een videorij is één clip. */
  video: l.dienst === 'video',
  n: l.dienst === 'video' ? 1
    : l.beelden === 'volgt'
      ? ({ catalog: CATALOG_IMAGES, lifestyle: LIFESTYLE_IMAGES } as Record<string, number>)[l.dienst] || geleverd(lang).length
      : geleverd(lang).length,
}));
/* De still van de clip. Het bestand bestaat nog niet; scripts/plaatshouders.mjs
   zet er in de build een donkere plaatshouder van 1080 × 1920 voor in de plaats,
   dezelfde als op de voorpagina. Zodra Lucas hem in public/img zet, staat hij er. */
const CLIP_STILL = { src: '/img/dienst-video-shirt.webp', w: 1080, h: 1920 };
/* ── GEEN GRIJS VLAK — 8 oktober 2026 (1.02, V13 = a) ──────────────────────
   Zolang de still er niet is, staat de videorij er niet: de galerij is geen
   pad naar betalen, en een donker vlak met een afspeelteken belooft een clip
   die er niet is. De filters tellen alleen wat er staat. */
const leveringen = leveringenAlle.filter((l) => !l.video || isEcht(CLIP_STILL.src));
const dienstKnoppen = gebruikteDiensten().filter((d) => leveringen.some((l) => l.dienst === d));
const soortKeuzes = gebruikteSoorten().filter((s) => leveringen.some((l) => l.soort === s));

/* ── DE HAL ─────────────────────────────────────────────────────────────── */
const ICOON = {
  rechts: '<path d="M2.5 8h11M9 3.5L13.5 8 9 12.5"/>',
  plus: '<path d="M8 3v10M3 8h10"/>',
  beeld: '<rect x="2.5" y="3" width="11" height="10" rx="2"/><path d="M2.5 10.5l3-3 3 3 2-2 3 3"/><circle cx="10.5" cy="6" r="1"/>',
  speel: '<path d="M5.5 3.8v8.4L12.5 8z"/>',
};
const ik = (n: keyof typeof ICOON) => `<svg viewBox="0 0 16 16" aria-hidden="true">${ICOON[n]}</svg>`;
const H = nl ? {
  h1: ['Zo ziet', 'een levering eruit.'],
  alles: ['Alle beelden', 'uit de studio.'],
  slot: ['Zie je eigen product', 'in deze reeks, voor'] as [string, string],
  slotZin: `Je levert aan zoals bij een gewone bestelling. Eén per bedrijf.`,
} : {
  h1: ['This is what', 'a delivery looks like.'],
  alles: ['Every image', 'from the studio.'],
  slot: ['See your own product', 'in this range, for'] as [string, string],
  slotZin: `You send what a normal order needs. One per business.`,
};
/* Het beeld in de opening: afvinklijst 20 (v20-opening a), live sinds afvinklijst 21. Zie KopBeeld.astro. */
const BEELD = {
  soort: 'foto' as const, verhouding: '4 / 3',
  foto: { src: '/img/lifestyle-glow-02.webp', positie: '50% 35%',
    alt: lang === 'nl' ? 'Een lifestylebeeld in de look Glow' : 'A lifestyle image in the Glow look',
    pil: 'Glow · lifestyle' },
};
