---
// VISUAILS — /studio, the public page for the studio side. Section 17.
//
// THE ARGUMENT THIS PAGE MAKES. Everywhere else on the site the studio says
// "a reserved window, confirmed before you pay". That is a promise, and a
// promise is only worth the mechanism behind it. This page is the mechanism:
// the capacity calendar, what it refuses, and why a date offered here is one
// the studio has already checked it can keep. It is the page a sceptical buyer
// reads when they have heard "48 hours" from someone before.
//
// WHAT IT DOES NOT CLAIM. Flag 15i: no notification of any kind fires on a
// status change — no WhatsApp, no email. So nothing here says you will be
// told. What is true, and what the copy points at instead, is that the change
// writes the client-visible timeline in the same move, so the portal is never
// behind the studio. If a notifier is built later, this page gains a sentence;
// it does not have to lose one.
//
// WHAT THE AUGUST 2026 PRICING MODEL CHANGED HERE, and what it did not. This
// page prints no price and it still prints none — the mechanism is the subject,
// so there is nothing on it to re-quote. One paragraph was load-bearing and had
// to move: the capacity rule used to read "drops outrank loose products", which
// described a PRIORITY BETWEEN TWO PRODUCTS the buyer chose between. Under the
// ladder (section 0 of src/data/pricing.js) there is no such choice — service
// level follows order size, and WINDOW_THRESHOLD is the whole of the rule. So
// the rule is stated as the threshold now, read from pricing.js rather than
// described in prose, which is also what stops this page and /pricing giving
// two different accounts of the same gate.
//
// The word "drop" is gone from the copy for the reason pricing.js gives: to the
// brands we sell to it means a collection going live, and using it for a work
// order made one word carry two meanings. What the studio runs is an order —
// een bestelling.
//
// ── DE TWEE GRIJZE VLAKKEN ZIJN WEG, 9 AUGUSTUS 2026 ────────────────────────
//
// Lucas: *"maak de mock ups voor deze 'Our side' pagina en houd het consistent."*
//
// Er stonden twee `.ph`-placeholders op deze pagina — "ADMINPORTAAL · DE AGENDA"
// en "ADMINPORTAAL · BESTELLINGENTABEL" — met eronder een noot die beschreef wat
// er te zien had moeten zijn. Op de pagina waarvan de hele functie is te bewijzen
// dat een leverdatum een mechanisme heeft. Beide noten zijn nu de opdracht van
// een echte figuur geworden: FigGate en FigBoard.
//
// EN ÉÉN DING KLOPTE NIET, wat pas opviel toen de figuur uit de echte cijfers
// getekend werd. Deze pagina zei "a week has room for a number of products",
// terwijl src/data/capacity.js per DAG telt: 18 producten per studiodag, 3 daarvan
// vrij voor kleine bestellingen, en een venster van twee open dagen. Weken bestaan
// nergens in dat bestand. De regel is daarom aangepast naar de eenheid die de
// poort werkelijk gebruikt — anders zou de figuur ernaast de tekst tegenspreken,
// en dan is een mock-up erger dan een grijs vlak.
import { WINDOW_THRESHOLD, aim48, TEST_SAMPLE } from '../data/pricing.js';
import { PRODUCTS_PER_DAY, QUEUE_FLOOR_PER_DAY, WINDOW_DAYS } from '../data/capacity.js';
import { localizedPath } from '../i18n/ui.js';
import FigGate from './FigGate.astro';
import Disclose from './Disclose.astro';
import FigBoard from './FigBoard.astro';
import FigOverzicht from './FigOverzicht.astro';
import '../styles/stijl22.css';

interface Props { lang: 'en' | 'nl'; }
const { lang } = Astro.props;
const lp = (p: string) => localizedPath(lang, p);

const COPY = {
  en: {
    h1: ['How we arrive at a delivery date.', 'This is the calendar we work in.'],
    lede: 'Every delivery date is checked against the calendar before you see it. This is how.',
    ctaStart: 'Start an order',
    ctaPortal: 'See a delivered order',

    gateH: 'We check the calendar before we offer you a date.',
    gateRegelsH: 'The four rules the planning runs on',
    gateLede: 'The order form only offers dates the studio can still hold.',
    gate: [
      // Zie de noot bovenaan dit bestand: dit zei "a week has room", en de poort
      // telt per dag. De cijfers komen nu uit capacity.js, dus de tekst kan niet
      // meer los gaan staan van het mechanisme dat hij beschrijft.
      ['Counted in products, not orders', `A studio day holds ${PRODUCTS_PER_DAY} products; a reserved window is ${WINDOW_DAYS} days.`],
      ['Room for small orders', `${QUEUE_FLOOR_PER_DAY} of every ${PRODUCTS_PER_DAY} stay free for small orders.`],
      // Size, not product type. See the header note: this used to say "drops
      // outrank loose products", which named two things a buyer picked between.
      [`Size decides, at ${WINDOW_THRESHOLD} products`, `From ${WINDOW_THRESHOLD} products an order holds a committed date. Smaller orders run in the normal turnaround.`],
      ['Nothing is promised twice', 'A window that is taken disappears from the picker at once.'],
    ],

    boardH: 'One table, every order.',
    boardRegelsH: 'What sits in that table',
    boardLede: 'Our side: a list of orders, the state each one is in, and the calendar.',
    board: [
      ['Every order, one row', 'Reference, brand, products, window and state.'],
      ['Revisions come to the top', 'With the note the client wrote.'],
      ['One move, both sides', 'The studio and your portal update together.'],
    ],

    humanH: 'The last step is a person.',
    humanLede: 'Nothing is delivered automatically. A specialist looks at every image before it goes out.',
    humanNote: 'Every approval and revision is logged with a date.',
    humanCta: 'Read the AI Act page',

    // ── TERUGREKENEN VANAF DE LANCEERDATUM ──────────────────────────────
    // Verhuisd van de homepage (sectie 14), augustus 2026. Dit is de enige
    // eerlijke schaarste-band die hier te maken valt: de krapte is echt — één
    // persoon en een capaciteitspoort die weken wéigert — en hij staat er als
    // capaciteit en niet als aftelklok. Geen "nog 3 plekken": dat is een getal
    // dat de pagina niet kan natrekken tegen de D1-kalender, en een
    // schaarsteclaim die een bezoeker kan ontkrachten is erger dan geen.
    plH: 'Work back from your launch date.',
    plLede: `From ${WINDOW_THRESHOLD} products we reserve your days in the calendar, so the date goes in writing.`,
    pl: [
      ['Your launch date', 'The day the collection goes live. We count back from here.'],
      ['Your reserved date', `Held from ${WINDOW_THRESHOLD} products; nothing moves it. ${aim48('en')} An aim, not a promise.`],
      ['Minus one folder', 'The day you send the photos. Your part is done.'],
    ],
    plNote: '',
    plCta: 'See which weeks are open',

    honestH: 'What this does not do.',
    honestLede: '',
    honest: [
      ['No date it has not cleared', 'A full calendar offers the next free window — never a yes and then a reschedule.'],
      ['No rushing past the review', 'An order that is not right does not ship on time; it ships right.'],
      ['No room that is not there', 'When the studio is full, it says so.'],
    ],

    closeH: 'Book a window the calendar has cleared.',
    closeLede: '',
    closeCta: 'Start an order',
    closeAlt: 'See it on your own product first',
  },

  nl: {
    h1: ['Zo komen we aan een leverdatum.', 'Dit is de agenda waar wij in werken.'],
    lede: 'Elke leverdatum wordt eerst in de agenda gecontroleerd voordat jij hem ziet. Zo werkt dat.',
    ctaStart: 'Start een bestelling',
    ctaPortal: 'Bekijk een geleverde bestelling',

    gateH: 'We kijken eerst in de agenda, en pas daarna noemen we een datum.',
    gateRegelsH: 'De vier regels waar de planning op draait',
    gateLede: 'Het bestelformulier biedt alleen datums aan die de studio nog kan vasthouden.',
    gate: [
      ['Geteld in producten, niet in orders', `Een studiodag houdt ${PRODUCTS_PER_DAY} producten; een vastgelegd venster is ${WINDOW_DAYS} dagen.`],
      ['Ruimte voor kleine bestellingen', `${QUEUE_FLOOR_PER_DAY} van elke ${PRODUCTS_PER_DAY} blijven vrij voor kleine bestellingen.`],
      // Zie de EN-tak: omvang beslist, niet het soort bestelling.
      [`Omvang beslist, bij ${WINDOW_THRESHOLD} producten`, `Vanaf ${WINDOW_THRESHOLD} producten houdt een bestelling een vastgelegde datum. Kleinere bestellingen volgen de normale doorlooptijd.`],
      ['Niets wordt twee keer beloofd', 'Een venster dat gepakt is, verdwijnt meteen uit de kiezer.'],
    ],

    boardH: 'Eén tabel, elke order.',
    boardRegelsH: 'Wat er in die tabel staat',
    boardLede: 'Onze kant: een lijst orders, de staat van elke order, en de agenda.',
    board: [
      ['Elke order, één regel', 'Kenmerk, merk, producten, venster en staat.'],
      ['Revisies komen bovenaan', 'Met de notitie die de klant schreef.'],
      ['Eén beweging, beide kanten', 'De studio en jouw portaal lopen gelijk.'],
    ],

    humanH: 'De laatste stap is een specialist.',
    humanLede: 'Er wordt niets automatisch geleverd. Een specialist bekijkt elk beeld voordat het weggaat.',
    humanNote: 'Elke goedkeuring en revisie wordt met een datum vastgelegd.',
    humanCta: 'Lees de AI Act-pagina',

    plH: 'Reken terug vanaf de dag dat je live gaat.',
    plLede: `Vanaf ${WINDOW_THRESHOLD} producten houden we je dagen vrij in de agenda, dus de datum staat op papier.`,
    pl: [
      ['De dag dat je live gaat', 'De dag dat de collectie online staat. Daar rekenen we vanaf terug.'],
      ['Je vastgezette datum', `Vanaf ${WINDOW_THRESHOLD} producten; niets schuift hem op. ${aim48('nl')} Een streven, geen belofte.`],
      ['Min één map', 'De dag dat jij de foto’s stuurt. Jouw deel is klaar.'],
    ],
    plNote: '',
    plCta: 'Kijk welke weken nog vrij zijn',

    honestH: 'Wat dit niet doet.',
    honestLede: '',
    honest: [
      ['Geen datum die niet is vrijgegeven', 'Zit de agenda vol, dan krijg je het eerstvolgende vrije venster — nooit een ja en daarna verzetten.'],
      ['Geen haast langs de controle', 'Een bestelling die niet klopt gaat niet op tijd weg; die gaat goed weg.'],
      ['Geen ruimte die er niet is', 'Zit de studio vol, dan zeggen we dat.'],
    ],

    closeH: 'Boek een venster dat de planning heeft vrijgegeven.',
    closeLede: '',
    closeCta: 'Start een bestelling',
    /* Het bedrag uit pricing.js en niet overgetypt — zelfde reden als overal:
       de dag dat de proef iets anders kost, is dit de regel die blijft staan. */
    closeAlt: `Probeer VISUAILS eerst voor ${TEST_SAMPLE.nl.price}`,
  },
};

const c = COPY[lang];
/* Voor de briefteksten op de placeholders hieronder — die staan niet in COPY
   omdat ze niet aan de bezoeker gericht zijn maar aan degene die de foto maakt. */
const nl = lang === 'nl';
---

{/* ═══ /studio IN DE STIJL VAN SECTIE 22 — 7 september 2026 ═════════════════
    Dertiende pagina in de stijl. De inhoud is onaangeraakt: dezelfde COPY in
    beide talen, dezelfde <FigGate> en <FigBoard>, dezelfde <Placeholder> met
    zijn opdracht erin, dezelfde getallen uit capacity.js.

    SINDS 8 SEPTEMBER STAAN ER NOG TWEE FIGUREN EN ÉÉN PLAATSHOUDER. Van de twee
    plaatshouders vroeg de bovenste om een SCHERMAFDRUK — en een scherm hoef je
    niet te fotograferen, dat teken je: <FigOverzicht>. Wat overblijft is de
    foto van iemand die zit te vergelijken, en dat is er één die echt gemaakt
    moet worden. Zie kladblok/PLAN-RONDE-23.md, blok E.

    DE POORT EN DE HANDCONTROLE ZIJN DE TWEE DONKERE KAMERS. Dat zijn ook de
    twee plekken waar de pagina van "hier is een scherm" naar "en dit is waarom
    het klopt" gaat, en een hoofdstukwissel is precies wat daar hoort.

    DE HERO DOET NIET MEE AAN DE INKOMEFFECTEN, en dat blijft zo: wat boven de
    vouw staat hoort er meteen te staan; een titel die eerst moet inkomen is een
    titel die je even niet kunt lezen. In deze stijl is dat geen keuze meer maar
    het gedrag van `.paneel` — er zit geen reveal op. */}
<div class="s22">

  {/* ── 1 · DE OPENING ───────────────────────────────────────────────────── */}
  <section class="paneel" aria-labelledby="sp-h1">
    <div class="sp-open">
      <div class="paneel-kop">
        {/* Etiket erbij, 23 september 2026 — zie /how-it-works. */}
        <p class="etiket">{lang === 'nl' ? 'Planning' : 'Schedule'}</p>
        <h1 id="sp-h1" class="hoog">{c.h1[0]} <em>{c.h1[1]}</em></h1>
        <p class="lopend">{c.lede}</p>
        <p class="acties">
          <a class="knop knop-inkt" href={lp('/start')}>{c.ctaStart}</a>
          <a class="knop knop-lijn" href={lp('/portal')}>{c.ctaPortal}</a>
        </p>
      </div>
      {/* ── HET OVERZICHT ZOALS DE KLANT HET ZIET ────────────────────────
          Hier stond een <Placeholder> met de opdracht "Schermafdruk van
          VISUAILS Studio — het overzicht met één lopende bestelling", en
          eronder wat hij moest bewijzen: statusregel, leverdatum, en beelden
          die op goedkeuring wachten, met een halfvolle bestelling omdat een
          leeg scherm niets bewijst.
          Dat is geen foto maar een SCHERM, en een scherm kun je tekenen — met
          dezelfde gegevens waar FigGate en FigBoard verderop uit lezen, zodat
          het overzicht van de klant niet een andere leverweek kan tonen dan de
          agenda ernaast. Zie de kop van FigOverzicht.astro. */}
      {/* Het scherm op zwart — zie `.op-nacht` in src/styles/global.css voor de
          regel: beeld en interface staan op donker, tekst staat op papier. */}
      <div class="op-nacht">
        <FigOverzicht lang={lang} />
      </div>
    </div>
  </section>

  {/* ── 2 · DE CAPACITEITSPOORT ─────────────────────────────────────────────
      De agenda zelf, met de dag erin die geweigerd wordt. Het venster dat hij
      "aangeboden" noemt komt uit offerableWindows() — zie FigGate.astro. */}
  <section class="kamer sp-kamer" aria-labelledby="sp-poort">

    {/* ── DE VIER REGELS ZIJN INGEKLAPT — 12 september 2026 ─────────────────
        Gemeten: deze sectie droeg 461 van de 1.363 zichtbare woorden op
        /studio, en 115 daarvan zaten in deze vier regels. Het zijn de REGELS
        van het planningssysteem — werkdruk boven beschikbaarheid, één plafond,
        de drempel, geen dubbele belofte — en ze zijn alle vier waar en het
        nalezen waard. Maar wie op deze pagina landt heeft één vraag: klopt de
        datum die ik krijg? De kop en de zin eronder beantwoorden die, en de
        tekening ernaast laat hem zien.

        De kop van de uitklap noemt daarom niet "meer informatie" maar wat er
        in staat: wie de regels wíl nalezen, weet aan één regel genoeg dat hij
        ze hier vindt. Dicht, want dit is de uitzondering niet. */}
    <div class="sp-twee">
      <div class="sp-regels-in">
        {/* De kop staat sinds 23 september 2026 in deze kolom, naast de agenda
            in plaats van erboven: hij stond op een eigen rij met een lege
            rechterhelft, en de tekening begon pas daaronder. */}
        <header class="kamer-kop">
          <h2 id="sp-poort" class="hoog hoog-2">{c.gateH}</h2>
          <p class="lopend">{c.gateLede}</p>
        </header>
        <Disclose summary={c.gateRegelsH} tone="panel">
          <ul class="sp-regels" role="list">
            {c.gate.map(([k, v]) => (
              <li><span class="mono">{k}</span><b>{v}</b></li>
            ))}
          </ul>
        </Disclose>
      </div>
      <FigGate lang={lang} />
    </div>
  </section>

  {/* ── 3 · TERUGREKENEN VANAF DE LANCEERDATUM — NAAR VOREN, 23 sep 2026 ──────────────────────────────
      Het leest als een dienst aan de lezer en niet als druk: een lanceerdatum
      is de ene datum die hij al in zijn hoofd heeft, en deze rij doet de
      aftrekking voor hem. Geen kleurladder over de drie stappen — zie de noot
      daarover in de voorpagina: drie stappen die van accent naar 40% wit liepen
      terwijl de derde de leverdatum is. */}
  <section class="paneel" aria-labelledby="sp-plan">
    <header class="paneel-kop">
      <h2 id="sp-plan" class="hoog hoog-2">{c.plH}</h2>
      <p class="lopend">{c.plLede}</p>
    </header>
    <ol class="sp-plan">
      {c.pl.map(([t, b], i) => (
        <li>
          <span class="mono nr">{String(i + 1).padStart(2, '0')}</span>
          <b>{t}</b>
          <span class="lopend">{b}</span>
        </li>
      ))}
    </ol>
    <div class="sp-plan-voet">
      {c.plNote && <p class="lopend">{c.plNote}</p>}
      <p class="acties"><a class="knop knop-lijn" href={lp('/start')}>{c.plCta}</a></p>
    </div>
  </section>

  {/* ── 4 · HET BESTELBORD, EN DE STAP MET DE HAND — 23 september 2026 ────
      De tabel, met het revisieverzoek open. "De laatste stap is een
      specialist" stond hieronder als donkere kamer van 1.344 px, waarvan het
      grootste deel een lege 16:9-plaatshouder was (PAGINA-OPBOUW.md). De
      tekst staat nu hier, onder het bord waar die stap in gebeurt. Komt de
      foto van iemand aan het werk, dan kan hij terug naast deze tekst. */}
  <section class="paneel" aria-labelledby="sp-bord">
    <div class="sp-twee-licht">
      <div class="sp-bord-t">
        <h2 id="sp-bord" class="hoog hoog-2">{c.boardH}</h2>
        <p class="lopend">{c.boardLede}</p>
        {/* Dezelfde zet als bij de vier planningsregels hierboven, en om
            dezelfde reden: dit zijn vijf definities over hoe ons eigen bord
            werkt, samen 170 woorden, naast een schermafdruk die datzelfde bord
            laat zien. Wie wil weten wat er in die tabel staat, kijkt ernaar;
            wie wil weten hoe hij werkt, klapt dit open. */}
        <Disclose summary={c.boardRegelsH} tone="panel">
          <dl class="sp-def">
            {c.board.map(([k, v]) => (<Fragment><dt>{k}</dt><dd class="lopend">{v}</dd></Fragment>))}
          </dl>
        </Disclose>
      </div>
      {/* Het scherm op zwart — zie `.op-nacht` in src/styles/global.css voor de
          regel: beeld en interface staan op donker, tekst staat op papier. */}
      <div class="op-nacht">
        <FigBoard lang={lang} />
      </div>
    </div>
    <div class="sp-hand">
      <h2 id="sp-hand" class="hoog hoog-3">{c.humanH}</h2>
      <div class="sp-hand-t">
        <p class="lopend">{c.humanLede} {c.humanNote}</p>
        <p><a class="pijl" href={lp('/ai-act')}>{c.humanCta}</a></p>
      </div>
    </div>
  </section>

  {/* ── 6 · WAT HET NIET DOET ────────────────────────────────────────────── */}
  <section class="paneel" aria-labelledby="sp-eerlijk">
    <header class="paneel-kop">
      <h2 id="sp-eerlijk" class="hoog hoog-2">{c.honestH}</h2>
      {c.honestLede && <p class="lopend">{c.honestLede}</p>}
    </header>
    <ul class="sp-eerlijk" role="list">
      {c.honest.map(([k, v]) => (
        <li><b>{k}</b><span class="lopend">{v}</span></li>
      ))}
    </ul>
  </section>

  {/* ── 7 · HET SLOT ─────────────────────────────────────────────────────── */}
  <section class="paneel paneel-slot" aria-labelledby="sp-slot">
    <h2 id="sp-slot" class="hoog">{c.closeH}</h2>
    {c.closeLede && <p class="lopend">{c.closeLede}</p>}
    <p class="acties">
      <a class="knop knop-inkt" href={lp('/start')}>{c.closeCta}</a>
      <a class="knop knop-lijn" href={lp('/test-sample')}>{c.closeAlt}</a>
    </p>
  </section>
</div>

<style>
  /* ── DE KOP BEGINT BOVENAAN, HET BEELD MAG ZWEVEN — 8 september 2026 ──────
     Lucas over /portal: *"bij deze pagina ook niet eerste sectie volledig
     gevuld."* Gemeten: de tekstkolom is daar 418 hoog naast een figuur van 954,
     en met `align-items: center` zweeft die tekst in het midden — 268 pixels
     wit bóven de kop. Een kop die op een derde van het paneel begint, leest als
     een fout en niet als lucht.
     Alle tien de openingsrasters op de site zijn nagemeten (kladblok/_open):
     vier stonden op 145 tot 268 pixels scheef. De regel is nu overal dezelfde:
     alles begint BOVEN. Daar begin je met lezen, daar staat de kop, en daar
     hoort het beeld ernaast te beginnen. Een uitzondering voor het beeld is
     geprobeerd en weer weggehaald: de plaatshouderfiguren komen uit een ander
     component en krijgen in Astro een eigen scope-attribuut, dus die regel
     raakte de helft van de gevallen niet — en een consistentieregel die op de
     helft van de pagina's iets anders doet, is geen regel. Eén uitlijning,
     tien pagina's, geen uitzonderingen. */
  .sp-open { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(1.5rem, 5vw, 4rem); align-items: start; }
  .sp-open .paneel-kop { margin-bottom: 0; gap: 1.1rem; }

  .sp-twee { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1fr); gap: clamp(1.5rem, 4vw, 3.5rem); align-items: start; }
  .sp-regels-in { display: grid; gap: clamp(1.2rem, 2.4vw, 1.8rem); align-content: start; }
  .sp-regels-in .kamer-kop { margin-bottom: 0; }
  /* De drie regels van de poort: het etiket klein, de uitleg als lopende tekst.
     Geen tegels met een rand eromheen — het zijn drie feiten over één ding.

     EN DE UITLEG IS GEEN GETAL. Hij stond hier eerst in de kopletter op
     clamp(1.3rem, 2.6vw, 2rem), want "etiket klein, cijfer groot" is de vorm
     die deze stijl elders gebruikt. Maar `c.gate` draagt hier geen cijfers: de
     waarde is een hele alinea ("A studio day holds 18 products, and a reserved
     window is 2 days…"). Drie alinea's op 32px in de kopletter is geen nadruk
     maar schreeuwen, en het duwt de tekening ernaast uit beeld. */
  .sp-regels { display: grid; gap: 1.4rem; }
  .sp-regels li { display: grid; gap: .4rem; padding-top: 1rem; border-top: 1px solid rgb(245 245 245 / .22); }
  .sp-regels .mono { color: rgb(245 245 245 / .66); }
  .sp-regels b { font-weight: 400; font-size: .95rem; line-height: 1.55; color: rgb(245 245 245 / .78); }

  .sp-twee-licht { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: clamp(1.5rem, 4vw, 3.5rem); align-items: center; }
  .sp-bord-t { display: grid; gap: 1rem; }
  .sp-def { display: grid; gap: .8rem; margin-top: .4rem; }
  .sp-def dt { font-family: var(--kop2); font-weight: 500; font-stretch: 125%; font-size: clamp(1rem, 1.6vw, 1.2rem); text-transform: uppercase; letter-spacing: -.01em; }
  .sp-def dd { margin: 0 0 .6rem; font-size: .92rem; }

