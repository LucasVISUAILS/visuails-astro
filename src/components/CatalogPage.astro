---
import { waHref } from '../data/whatsapp.js';
// VISUAILS — /catalog and /nl/catalog share this body.
//
// Before this rewrite the two locales were separate 256-line inline pages
// that happened to agree. They agreed because nobody had touched them since
// the port; the moment one locale got a price change the other would have
// silently kept the old figure. Every other rewritten page in this project
// now takes a `lang` prop for exactly that reason — /start, /pricing, the
// homepage, /custom-models, /compare, /how-it-works and /faq — so EN/NL
// parity is a property of the file layout rather than of anyone’s diligence.
//
// Every euro on this page comes from src/data/pricing.js and every timing
// string from turnaround(). Nothing here is typed by hand. The one thing a
// page rewrite cannot fix is a price sitting in a <meta> tag, so the two
// wrappers build their description from pricing.js too.
//
// THE PRICE ON THIS PAGE IS NO LONGER ONE NUMBER (August 2026 — section 0 of
// src/data/pricing.js is the governing document). A catalog set used to be a
// flat rate per product, quoted five times on this page as a single figure.
// It is a LADDER now: the rate starts at the entry rung and falls as the count
// rises, and a page that prints one figure for it is printing what ONE product
// costs while implying that is what fifty cost each. So the rung list below is
// rendered in full — this page has the room for it, and five rows say the
// thing a "from €x" would only gesture at — and every other mention names the
// entry rate AND the floor together.
//
// EVERY PRINTED PRICE CARRIES A VAT LABEL, from vatLabel(). Never a typed
// "excl. VAT": BRIEF-14's hardest rule, and this page prints rates in a hero,
// a rung list, a FAQ answer and a closing band, which is four chances to quote
// a net figure as if it were gross.
//
// "DROP" IS NOT WHAT WE SELL. It means a collection going live to the brands
// we sell to; using it for a work order made one word carry two meanings. What
// we sell is an order, or a batch — in Dutch, een bestelling.
//
// SERVICE LEVEL FOLLOWS SIZE now rather than being a second choice: from
// WINDOW_THRESHOLD products an order gets the reserved window, below it the
// standard queue. The timing strings still come from turnaround(); what
// changed is that this page has to say WHICH orders get which, instead of
// describing itself as a tier.
// This component is a page BODY, not a page. The two thin wrappers in
// src/pages own the <Layout> and the meta — importing Layout here would
// nest a second <html> inside the first.
import {
  TIERS, LADDER, ladderRate, ladderFloor, euro, vatLabel,
  WINDOW_THRESHOLD, reviewClaim, turnaround, CATALOG_IMAGES, LIFESTYLE_IMAGES,
  clause, FORM_MAX_PRODUCTS,
  RESOLUTIE,
} from '../data/pricing.js';
/* De vragen onderaan deze pagina staan in faq.js en niet meer hier. Reden:
   schema.js bouwt zijn FAQPage-knoop uit het pad en kan de frontmatter van
   een component niet lezen — zie de kop boven serviceFaqs(). */
import { serviceFaqs } from '../data/faq.js';
import { localizedPath } from '../i18n/ui.js';
import Disclose from './Disclose.astro';
import Compare from './Compare.astro';
import TierCompare from './TierCompare.astro';
import Placeholder from './Placeholder.astro';
import StyleRows from './StyleRows.astro';
import { catalogStyles as catalogStylesEn } from '../data/catalogStyles.js';
import { catalogStyles as catalogStylesNl } from '../data/catalogStyles.nl.js';

import ServiceSwitch from './ServiceSwitch.astro';
import '../styles/stijl22.css';
import HeroFacts from './HeroFacts.astro';
interface Props { lang: 'en' | 'nl'; }
const { lang } = Astro.props;
const lp = (p: string) => localizedPath(lang, p);

const styles = lang === 'nl' ? catalogStylesNl : catalogStylesEn;

// The ladder for this page's one kind, read rather than typed. `entry` is what
// a single product costs and `floor` is the lowest the rate ever reaches —
// both are needed wherever a rate is quoted in prose, because either one on
// its own is a half-truth: the entry rate alone makes a fifty-product order
// look four times more expensive than it is, and the floor alone quotes a
// price almost nobody's first order pays.
const KIND = 'catalog';
const entry = ladderRate(KIND, 1);
const floor = ladderFloor(KIND);
const rungs = LADDER[KIND];
const floorFrom = rungs[rungs.length - 1][0];
// The whole ladder, formatted once for the block that renders it.
const rungRows = rungs.map(([lo, hi, rate]) => ({
  label: hi === null ? `${lo}+` : `${lo}–${hi}`,
  rate: euro(rate, lang),
}));
const t0 = TIERS.unattended;

// The first-order discount as a percentage, computed rather than written. A

// The four photos, named. This used to be prose in three different places
// with three slightly different orderings; it is one list now.
// w/h are the intrinsic pixel size of the file in public/img, EN and NL alike
// — a photo's size is not copy, but repeating it here keeps the two branches
// structurally identical, which is what check_lang_parity reads. The
// .photo-band box crops them, so nothing moves; they just stop the row
// reflowing as each file arrives (§12).
/* ═══════════════════════════════════════════════════════════════════════════
 * DE VIER SHOTS — EN WAAROM ER MAAR ÉÉN EEN FOTO IS
 * ═══════════════════════════════════════════════════════════════════════════
 *
 * 30 augustus 2026. Deze rij is het EERSTE bewijs dat een bezoeker op /catalog
 * ziet, en het is de sectie die belooft dat één product vier beelden oplevert.
 * Wat er stond, met een schermafdruk ernaast gelegd:
 *
 *   1 · "Front"       catalog-after.webp
 *   2 · "Back"        catalog-after.webp   ← hetzelfde bestand als 1
 *   3 · "Detail"      catalog-before.webp  ← de TELEFOONFOTO van de klant,
 *                                            bureaustoelen en al
 *   4 · "On a model"  custom-models-02.webp ← een portret. Geen product in beeld.
 *
 * Eén beeld twee keer onder twee namen, de bronfoto gepresenteerd als geleverd
 * werk, en een gezicht waar het product hoort te staan. Dat is drie keer bewijs
 * verzinnen in de sectie die het bewijs IS, en het staat er tot vandaag.
 *
 * ── WAT ERVOOR IN DE PLAATS KOMT ───────────────────────────────────────────
 *
 * Wat waar is: er is één echte geleverde catalogfoto op schijf. Die staat op
 * plek 1. De andere drie zijn <Placeholder> — de vorm die deze site al gebruikt
 * voor beeld dat nog geschoten moet worden, met de opdracht erbij en met
 * `npm run placeholders` die ze telt. Dezelfde oplossing die FigWalk voor
 * exact dezelfde vraag koos: "Only the first slot has a photograph; the other
 * three are hatched, and the caption under the figure says why."
 *
 * Dit maakt de sectie zwakker om naar te kijken, en dat is de bedoeling: de
 * sectie WAS zwakker, je zag het alleen niet. Drie foto's schieten van één
 * product lost het op, en tot die tijd staat er wat er is.
 */
const SHOTS = {
  en: [
    { n: '1', label: 'Front', img: '/img/catalog-after.webp', w: 1800, h: 1800, alt: 'Front catalog shot of the product' },
    { n: '2', label: 'Back', brief: 'The same garment photographed from the back, on the same white ground, same light, same framing as shot 1 — so the two sit next to each other on a product page without a jump.' },
    { n: '3', label: 'Detail', brief: 'A close-up of the logo or the fabric of that same garment, cut out on the same ground. Close enough to read the stitching; the point is texture, not the whole product.' },
    { n: '4', label: 'On a model', brief: 'That same garment worn by one of the roster models, full or three-quarter length, so a shopper can judge fit and scale. The PRODUCT is the subject — a portrait with no product in it is not this shot.' },
  ],
  nl: [
    { n: '1', label: 'Voorkant', img: '/img/catalog-after.webp', w: 1800, h: 1800, alt: 'Voorkant-shot van het product voor de catalogus' },
    { n: '2', label: 'Achterkant', brief: 'Hetzelfde kledingstuk van achteren, op dezelfde witte ondergrond, met hetzelfde licht en dezelfde kadrering als shot 1 — zodat ze op een productpagina naast elkaar staan zonder sprong.' },
    { n: '3', label: 'Detail', brief: 'Een close-up van het logo of de stof van datzelfde kledingstuk, uitgesneden op dezelfde ondergrond. Dichtbij genoeg om het stiksel te zien; het gaat om de textuur, niet om het hele product.' },
    { n: '4', label: 'Op een model', brief: 'Datzelfde kledingstuk gedragen door een model uit de bibliotheek, ten voeten uit of driekwart, zodat een bezoeker de pasvorm en de maatverhouding kan zien. Het PRODUCT is het onderwerp — een portret zonder product erin is dit shot niet.' },
  ],
};

// No `as const`. COPY[lang] on a const-asserted object gives a union of
// readonly tuples, and .map() on that union is a TS error — the same footgun
// every other page component in this project deliberately avoids.
const COPY = {
  en: {
    eyebrow: 'Catalog',
    // <em> added task #271b (Lucas's own request, editorial accent) — same
    // closing-word-emphasis convention already used on the other hero H1s
    // (homepage's "visualized.", custom-models' "Only yours.").
    h1: `Product-page images, ${CATALOG_IMAGES} per product — <em>the same on every product.</em>`,
    /* ── DE PRIJSZIN IS ERUIT — 8 september 2026 ──────────────────────────
       Hier stond het bedrag óók: "€89 per product excl. VAT, falling to €39
       from 20 products up." Twee regels lager staat in de specificatiestrook
       "€89 – €39 · per product · excl. VAT". Twee keer hetzelfde getal binnen
       één blok, één keer in een zin en één keer als getal — en de zin is de
       zwakkere van de twee, want een bedrag lees je niet in lopende tekst.

       Wat de lead nog doet is het enige wat de strook niet kan: zeggen WAT er
       in die set zit. Dat is waar hij voor is. */
    lead: `A full set per product, from 4 photos — front, back, a fabric or logo close-up and one on-model shot, with more available per product.`,
    // SECTION 13: Tier 0 "must NOT appear ... in any hero." This button used to
    // read the tier label verbatim ("Order individual products"), which put the
    // Tier 0 offer in the hero of all three service pages. It was also slightly
    // untrue: it named one of two routes the buyer was being asked to choose
    // between, before the page had explained either. There is no choice left
    // to prejudge — size decides the service level now — so the neutral verb
    // is simply correct rather than diplomatic, and where the line falls is
    // stated further down, on the queue note and in the TierCompare block.
    ctaPrimary: 'Order catalog images',
    ctaSecondary: 'See the price per product',
    wa: waHref("Hi VISUAILS, I'd like to order catalog images for my products."),
    waLabel: 'WhatsApp',
    // Two figures, not one. A single rate in a trust row is the exact claim
    // the ladder retired — see the note at the top of this file.
    trust: [
      [`${euro(entry, 'en')} – ${euro(floor, 'en')}`, `per product · ${vatLabel('excl', 'en')}`],
      ['From 4 photos', 'per product'],
    ],
    // The queue line is deliberately in the trust row rather than buried in
    // small print. Section 13: the difference between the two service models
    // must be VISIBLE, and it is a bigger difference now that size decides it
    // — so this line names the count as well as the promise. A visitor should
    // not be able to leave this page believing a date was promised.
    queueNote: `Under ${WINDOW_THRESHOLD} products: ${clause(t0.queue.en).toLowerCase()}. From ${WINDOW_THRESHOLD}, we hold a delivery date for the order and confirm it in writing.`,
    kiesCta: 'Pick your look',
    levert: 'four photos per product.',
    packH: 'One product. Four images, or more. The rate falls as the count rises.',
    ladderH: 'What a catalog set costs',
    ladderProductsCol: 'Products',
    ladderRateCol: `Per product · ${vatLabel('excl', 'en')}`,
    ladderNote: `The rate applies to every product in the order, not only the ones above that count — so ${floorFrom} products are ${euro(floor, 'en')} each, all of them. More than ${FORM_MAX_PRODUCTS} at once is fine too: we split those over delivery dates, at the same rate per product.`,
    // The on-model shot is the one line on this page where the Brand Model is
    // the obvious next question, so the upsell is woven into the sentence that
    // already raises it rather than parked in a block of its own. §1 of the
    // brief: every service page links to /custom-models.
    packOpen: 'One delivered image, three still being shot. The set is real; the photographs of it are not all here yet, and we would rather show you that than fill the gaps with something else.',
    packP: `Every product comes back as a complete set — including a real on-model shot, not just flat-lays. That shot can use a face from the standard roster, or <a href="${lp('/custom-models')}">a Brand Model made only for you</a>, so the same person carries your whole range.`,
    // The button used to carry the tier label and one flat rate — "Order
    // individual products · €89 / product". Both halves are retired: the tier
    // is a consequence of size now rather than a thing you pick, and one rate
    // is not what a catalog set costs. The rung list sits directly above this
    // button, so the button only has to be a verb.
    packCta: 'Order catalog images',
    edMeta: '( Where it fits )',
    edH: 'Catalog photography: clarity that closes the sale.',
    edSub: 'The clean product pages your shop and marketplaces run on.',
    whatH: 'What it is',
    whatP: [
      "Catalog photography is the straight, clean product imagery a shopper judges the product by — front, back, a detail close-up and one on-model shot, all on a consistent background. It isn’t there to set a mood; it’s there to show exactly what someone is buying, with nothing left to guess.",
      // Was drie zinnen. Het beeld erboven laat nu zien wat ze uitlegden.
      'The picture above is the whole argument: shot the same way end to end, a range reads as one considered line instead of a pile of separate photos. That is what makes a small brand look established.',
    ],
    whereH: 'Where it lives',
    where: [
      ['Your webshop', 'the product pages people decide on.'],
      ['Marketplaces', 'bol, Amazon and listings that demand clean, consistent shots.'],
      ['Shopping feeds', 'Google Shopping and comparison sites.'],
      ['Wholesale & linesheets', 'where buyers need to see the product plainly.'],
    ],
    stylesH: 'Pick your catalog style.',
    exploreLabel: (n: string) => `Explore ${n}`,
    stepsH: 'Three steps to a clean grid.',
    steps: [
      ['Upload a photo', 'We take it from there.'],
      ['We make it consistent', 'Same lighting, angle, background — every time.'],
      // Timing comes from the tier, never from a literal. This step used to
      // read "Delivered in ~24h" — a promise the capacity gate never cleared.
      [turnaround('unattended', 'en'), 'Ready for your site, ads and social.'],
    ],
    checkH: 'Everything a listing needs.',
    check: [
      'Consistent lighting & angles',
      'Neutral or your chosen background',
      'Marketplace-ready framing',
      'High-res export',
      reviewClaim('unattended', 'en'),
    ],
    chipsBg: ['White — standard', 'Custom colour — any hex code'],
    baH: 'One photo in. A clean catalog image out.',
    baP: 'The exact raw phone photo a customer sent — and what came back.',
    baBefore: 'Your photo',
    baBeforeAlt: 'A raw phone photo of a t-shirt on a table before VISUAILS',
    baAfterAlt: 'The same t-shirt as a clean catalog image after VISUAILS',
    reviewH: "Fast means nothing if it isn’t right.",
    reviewP: 'Every catalog image is generated, then reviewed by a person before it reaches you — colour and detail held true, not left to chance.',
    reviewChips: ['Consistent lighting & framing', 'Marketplace-ready', reviewClaim('unattended', 'en')],
    // The trust row carried the turnaround flag but not the review claim, while
    // /lifestyle and /video carried both. Three service pages making two
    // different promises above the fold is the inconsistency, not the wording.
    reviewNote: reviewClaim('unattended', 'en'),
    heroAlt: 'A finished VISUAILS catalog image: a product cut out and lit on white',
    stepsAlt: 'The raw phone photo a client sent in: a washed tee flat on an office table',
    /* Het bijschrift is hier geen versiering maar een eis: zonder het label
       leest een telefoonfoto op een verkooppagina als slecht werk in plaats van
       als het beginpunt. Zie de noot bij de sectie. */
    stepsCap: 'What a client sent in — step 01',
    heroCap: 'Catalog · a delivered image',
    faqH: 'Catalog questions, answered',
    faqs: serviceFaqs('catalog', 'en'),
    ctaH: 'Build a catalog that <br>looks like one brand.',
    ctaP: `${euro(entry, 'en')} per product, down to ${euro(floor, 'en')} from ${floorFrom} up — ${vatLabel('excl', 'en')}.`,
  },
  nl: {
    eyebrow: 'Catalog',
    h1: 'Strakke, consistente catalogfoto’s — <em>ook bij dertig producten.</em>',
    lead: `Een complete set per product, vanaf 4 foto’s — voorkant, achterkant, een close-up van de stof of het logo, en één foto op een model. Meer catalogfoto’s per product kan altijd.`,
    ctaPrimary: 'Bestel catalogfoto’s',
    ctaSecondary: 'Bekijk de prijs per product',
    wa: waHref("Hoi VISUAILS, ik wil graag catalogfoto’s bestellen voor mijn producten."),
    waLabel: 'WhatsApp',
    trust: [
      [`${euro(entry, 'nl')} – ${euro(floor, 'nl')}`, `per product · ${vatLabel('excl', 'nl')}`],
      ['Vanaf 4 foto’s', 'per product'],
    ],
    queueNote: `Onder ${WINDOW_THRESHOLD} producten: ${clause(t0.queue.nl).toLowerCase()}. Vanaf ${WINDOW_THRESHOLD} producten houden we een leverdatum voor je vrij en zetten we die vast.`,
    kiesCta: 'Kies je look',
    levert: 'vier foto’s per product.',
    packH: 'Eén product. Vier foto’s of meer. Het tarief daalt naarmate het aantal stijgt.',
    ladderH: 'Wat een catalogset kost',
    ladderProductsCol: 'Producten',
    ladderRateCol: `Per product · ${vatLabel('excl', 'nl')}`,
    ladderNote: `Het tarief geldt voor elk product in de bestelling, niet alleen voor de producten boven die grens — ${floorFrom} producten kosten dus allemaal ${euro(floor, 'nl')}. Meer dan ${FORM_MAX_PRODUCTS} in één keer kan ook: die verdelen we over leverdata, tegen hetzelfde tarief per product.`,
    packOpen: 'Eén geleverd beeld, drie die nog geschoten worden. De set bestaat; de foto\u2019s ervan staan er nog niet allemaal, en we laten dat liever zien dan dat we de gaten met iets anders vullen.',
    packP: `Elk product komt terug als een complete set — met een echte foto op een model, niet alleen het product plat op een ondergrond. Op die foto staat een gezicht uit de standaardbibliotheek, of <a href="${lp('/custom-models')}">een merkmodel dat alleen voor jou gemaakt is</a>, zodat dezelfde persoon je hele assortiment draagt.`,
    packCta: 'Bestel catalogfoto’s',
    edMeta: '( Waar het past )',
    edH: 'Catalogfotografie: zo duidelijk dat er niets te vragen overblijft.',
    edSub: 'De strakke productpagina’s waar je shop en marktplaatsen op draaien.',
    whatH: 'Wat het is',
    whatP: [
      'Catalogfotografie is de strakke, rechttoe rechtaan foto waar een klant het product op beoordeelt — voorkant, achterkant, een close-up van een detail en één foto op een model, allemaal op dezelfde achtergrond. Het is er niet om sfeer te maken, maar om precies te laten zien wat iemand koopt. Niemand hoeft iets te raden.',
      // Was drie zinnen. Het beeld erboven laat nu zien wat ze uitlegden.
      'De foto hierboven is het hele argument: staat alles op dezelfde manier op de foto, dan leest je collectie als één geheel in plaats van als een stapel losse telefoonfoto’s. Dat is wat een klein merk gevestigd laat lijken.',
    ],
    whereH: 'Waar je het gebruikt',
    where: [
      ['Je webshop', 'de productpagina’s waar mensen beslissen.'],
      ['Marktplaatsen', 'bol, Amazon en andere platforms die strakke, consistente foto’s eisen.'],
      ['Shopping-feeds', 'Google Shopping en vergelijkingssites.'],
      ['Wholesale & linesheets', 'waar inkopers het product helder moeten zien.'],
    ],
    stylesH: 'Kies je Catalog-stijl.',
    exploreLabel: (n: string) => `Ontdek ${n}`,
    stepsH: 'Drie stappen naar een strakke catalogus.',
    steps: [
      ['Stuur een foto', 'Daarna nemen wij het over.'],
      ['Wij maken het consistent', 'Zelfde belichting, hoek, achtergrond — elke keer.'],
      [turnaround('unattended', 'nl'), 'Klaar voor je site, advertenties en social.'],
    ],
    checkH: 'Alles wat een listing nodig heeft.',
    check: [
      'Consistente belichting & hoeken',
      'Neutrale of je gekozen achtergrond',
      'Bijgesneden zoals marktplaatsen het willen',
      `Bestanden op ${RESOLUTIE.standaard} px`,
      reviewClaim('unattended', 'nl'),
    ],
    chipsBg: ['Wit — standaard', 'Je eigen kleur — elke hexcode'],
    baH: 'Dit is een telefoonfoto. Dit is wat eruit kwam.',
    baP: 'Precies de ruwe telefoonfoto die een klant stuurde — en wat er terugkwam.',
    baBefore: 'Jouw foto',
    baBeforeAlt: 'Een ruwe telefoonfoto van een t-shirt op een tafel vóór VISUAILS',
    baAfterAlt: 'Hetzelfde t-shirt als een strakke catalogfoto na VISUAILS',
    reviewH: 'Snel betekent niets als het niet klopt.',
    reviewP: 'We maken elke catalogfoto, en daarna controleert een specialist hem voordat je hem krijgt — kleur en detail moeten kloppen, en dat laten we niet aan het toeval over.',
    reviewChips: ['Consistente belichting & uitsnede', 'Klaar voor marktplaatsen', reviewClaim('unattended', 'nl')],
    reviewNote: reviewClaim('unattended', 'nl'),
    heroAlt: 'Een afgewerkte VISUAILS-catalogfoto: een product uitgesneden en belicht op wit',
    stepsAlt: 'De ruwe telefoonfoto die een klant instuurde: een gewassen shirt plat op een kantoortafel',
    stepsCap: 'Wat een klant instuurde — stap 01',
    heroCap: 'Catalog · een geleverd beeld',
    faqH: 'Catalog-vragen, beantwoord',
    faqs: serviceFaqs('catalog', 'nl'),
    ctaH: 'Bouw een catalogus die <br>eruitziet als één merk.',
    ctaP: `${euro(entry, 'nl')} per product, tot ${euro(floor, 'nl')} vanaf ${floorFrom} — ${vatLabel('excl', 'nl')}.`,
  },
};

const c = COPY[lang];
const shots = SHOTS[lang];
const nl = lang === 'nl';

/* ── ELKE STIJL ZIJN EIGEN REGEL, DE EIGEN LOOK BOVENAAN — 4 september 2026 ──
   Zie de kop van StyleRows.astro. De foto's voor Classic komen morgen; tot
   dan de getekende scène. */
const naarRij = (s: (typeof styles)[number]) => ({
  slug: s.slug,
  name: s.name,
  tagline: s.tagline,
  desc: s.cardDesc,
  price: s.cardPrice,
  bestFor: s.bestFor || [],
  media: { icon: s.cardIcon, width: s.cardWidth, badge: `Catalog · ${s.name}` },
  /* Tot de foto's er zijn (morgen): Classic het ene geleverde beeld, de rest
     als "foto volgt"-kaart; Eigen merk de getekende scène. */
  /* Classic is een set van vier: de voorkant staat er; achterkant, detail en
     op-model komen als foto en staan tot dan met hun naam als "foto volgt". */
  photos: s.slug === 'classic'
    ? [{ src: '/img/catalog-after.webp', w: 1800, h: 1800, alt: c.exploreLabel(s.name) },
       { label: nl ? 'Achterkant' : 'Back' }, { label: 'Detail' }, { label: nl ? 'Op een model' : 'On a model' }]
    : [{ icon: s.cardIcon, width: s.cardWidth, badge: `Catalog · ${s.name}` }],
  before: s.slug === 'classic' ? { src: '/img/catalog-before-1x1.webp', alt: '' } : undefined,
  tint: s.slug === 'classic' ? '#d9d9d2' : '#D2E04A',
  detailHref: lp(`/catalog/${s.slug}`),
  detailLabel: c.exploreLabel(s.name),
  orderHref: s.orderHref,
  /* Zie LifestylePage: een vaste look heet "Kies deze look", want de knop is de
     keuze. Alleen de look op maat houdt zijn eigen tekst. */
  orderLabel: s.orderLabel || undefined,
});
const eigenLook = naarRij(styles.find((s) => s.slug === 'custom')!);
const vasteLooks = styles.filter((s) => s.slug !== 'custom').map(naarRij);
---

{/* ═══ /catalog IN DE STIJL VAN SECTIE 22 — 7 september 2026 ════════════════
    Zevende pagina in de stijl, en de tweede van de drie dienstpagina's. Alles
    wat hierboven staat is onaangeraakt: dezelfde COPY in beide talen, dezelfde
    ladder uit pricing.js, dezelfde SHOTS met hun drie <Placeholder>s, dezelfde
    looks uit catalogStyles.js. Wat verandert is uitsluitend de opmaak.

    De gedeelde componenten — ServiceSwitch, HeroFacts, StyleRows, Compare,
    TierCompare, Disclose en Placeholder — staan er ongewijzigd in. Hun
    uiterlijk volgt de stijl via het `.s22.s22`-blok onderaan stijl22.css, dus
    hun toetsenbordgedrag en hun aria blijven wat de toetsen al bewijzen.

    DE PRIJSLADDER BLIJFT EEN TABEL. Vijf rijen, twee kolommen, met de
    btw-vermelding als kolomkop — precies zoals hij stond. Hij staat nu in een
    `.tabel-schuif` zodat hij op een telefoon schuift in plaats van de pagina
    breder te maken; dat was op /pricing dezelfde ingreep. */}
<div class="s22">

  {/* ── 1 · DE OPENING ───────────────────────────────────────────────────── */}
  <section class="paneel" aria-labelledby="cat-h1">
    <div class="cat-open">
      {/* ── DE OPBOUW VAN HET OPENINGSBLOK — 8 september 2026 ─────────────
          Lucas plakte de hele opening in de chat en schreef eronder: *"Kan
          gewoon een stuk schoner, ook bij andere services, fix dit dan ook en
          maak dit consistent bij alle pagina's."*

          Er stonden zes dingen onder elkaar, en drie ervan zeiden hetzelfde:
          de lead noemde de prijs, de specificatiestrook noemde de prijs, en
          de tweede knop ging naar de prijzenpagina. Daaronder vijf pillen die
          net zo hard riepen als de bestelknop, en pas onderaan de zin die
          uitlegt of je een datum krijgt.

          De volgorde is nu de volgorde van de vragen die iemand stelt:

            1  wat is het        kop en lead
            2  wat kost het      de strook, met alle vier de getallen
            3  wat is de haak    de wachtregel, direct onder die getallen
            4  wat doe ik nu     twee knoppen
            5  en anders         de dienstenrij, rustig, onderaan

          DE WHATSAPP-KNOP IS WEG en dat is geen bezuiniging: er zweeft op elke
          pagina van de site een WhatsApp-knop rechtsonder. Een derde knop
          ernaast voor hetzelfde gesprek maakt de rij van drie zwaarder zonder
          één weg extra te openen. */}
      <div class="paneel-kop">
        <p class="etiket">{c.eyebrow}</p>
        <h1 id="cat-h1" class="hoog" set:html={c.h1} />
        <p class="lopend" set:html={c.lead} />
        <HeroFacts eigen={c.trust} lang={lang} />
        <p class="cat-wacht">{c.queueNote}</p>
        <p class="acties">
          <a class="knop knop-inkt" href="#looks">{c.kiesCta}</a>
          <a class="knop knop-lijn" href={lp('/pricing')}>{c.ctaSecondary}</a>
        </p>
        <ServiceSwitch current="catalog" lang={lang} />
      </div>
      {/* Dezelfde foto als voorheen: `catalog-after.webp`, het shirt uit het
          voor/na-paar verderop. Zie de noot bij SHOTS — het is het enige echt
          geleverde catalogbeeld dat er is, en dus ook het enige dat hier hoort. */}
      <figure class="kaart kaart-stil kaart-breed kaart-product cat-beeld">
        <img src="/img/catalog-after.webp" alt={c.heroAlt} loading="eager" fetchpriority="high" decoding="async" width="1800" height="1800" />
        <figcaption class="mono foto-pil">{c.heroCap}</figcaption>
      </figure>
    </div>
  </section>

  {/* ── 2 · DE LOOKS ─────────────────────────────────────────────────────── */}
  <section class="paneel" id="looks">
    <StyleRows
      lang={lang}
      dienst="catalog"
      h={c.stylesH}
      lead={eigenLook}
      items={vasteLooks}
      levert={c.levert}
      bestelBasis={lp('/start/catalog/')}
    />
  </section>

  {/* ── 3 · DE SET, EN WAT HIJ KOST ──────────────────────────────────────────
      Eén product, vier beelden, en de hele ladder eronder. De vier plekken
      staan er nog precies zo: één foto en drie <Placeholder>s met de opdracht
      in de bron. Zie de kop bij SHOTS voor waarom dat zo blijft. */}
  <section class="paneel" aria-labelledby="cat-set">
    <header class="paneel-kop">
      <h2 id="cat-set" class="hoog hoog-2">{c.packH}</h2>
      <p class="lopend cat-pack-p" set:html={c.packP} />
    </header>

    <ul class="cat-shots" role="list">
      {shots.map((s) => (
        <li>
          <div class="kaart kaart-stil cat-shot">
            {s.img
              ? <img src={s.img} alt={s.alt} loading="lazy" decoding="async" width={s.w} height={s.h} />
              : <Placeholder lang={lang} ratio="4 / 5" caption={false} subject={`${c.eyebrow} · ${s.label}`} message={s.brief} />}
            <span class="cat-shot-pil mono">{s.n} · {s.label}</span>
          </div>
        </li>
      ))}
    </ul>
    <p class="cat-open-noot">{c.packOpen}</p>

    <div class="cat-ladder">
      <p class="etiket">{c.ladderH}</p>
      <div class="tabel-schuif">
        <table class="lijst">
          <thead>
            <tr>
              <th scope="col">{c.ladderProductsCol}</th>
              <th scope="col">{c.ladderRateCol}</th>
            </tr>
          </thead>
          <tbody>
            {rungRows.map((r) => (
              <tr><th scope="row">{r.label}</th><td><span class="tarief">{r.rate}</span></td></tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="lopend cat-ladder-noot">{c.ladderNote}</p>
      <p class="acties">
        <a class="knop knop-inkt" href={lp('/start/catalog')}>{c.packCta}</a>
      </p>
    </div>
  </section>

  {/* ── 4 · WAT HET IS, EN WAAR HET STAAT ────────────────────────────────────
      De donkere kamer van deze pagina. Het brede beeld van het productraster
      staat erin: het is het argument van deze sectie, en een lichte kader op
      donkere grond zet het apart zonder dat er een kop bij hoeft. */}
  <section class="kamer cat-kamer" aria-labelledby="cat-wat">
    <header class="kamer-kop">
      <p class="etiket">{c.edMeta}</p>
      <h2 id="cat-wat" class="hoog hoog-2">{c.edH}</h2>
      <p class="lopend">{c.edSub}</p>
    </header>

    <Placeholder
      lang={lang}
      space
      ratio="21 / 9"
      subject={nl ? 'Een productraster zoals een bezoeker het in een webshop ziet — twaalf verschillende producten, allemaal op dezelfde manier gefotografeerd'
                  : 'A product grid as a shopper sees it in a webshop — twelve different products, every one shot the same way'}
      message={nl
        ? 'Moet in één blik het verschil laten zien tussen "losse foto’s" en "één collectie": gelijk kader, gelijk licht, gelijke achtergrond, gelijke schaduw. De producten mogen juist onderling verschillen — een tas naast een fles naast een trui — want dan is het de fotografie die het geheel maakt en niet het assortiment. Geen enkele foto mag eruit springen; staat er één anders, dan is het beeld mislukt.'
        : 'Must show at a glance the difference between "separate photos" and "one collection": same framing, same light, same background, same shadow. The products themselves should differ — a bag beside a bottle beside a jumper — so it is the photography that makes it whole, not the range. No single shot may stand out; if one sits differently, the image has failed.'}
    />

    <div class="cat-twee">
      <div class="cat-uitleg">
        <h3 class="hoog hoog-3">{c.whatH}</h3>
        {c.whatP.map((p) => <p class="lopend">{p}</p>)}
      </div>
      <aside class="cat-waar">
        <h3 class="hoog hoog-3">{c.whereH}</h3>
        <ul class="cat-waar-lijst" role="list">
          {c.where.map(([strong, rest]) => <li><b>{strong}</b><span class="lopend">{rest}</span></li>)}
        </ul>
      </aside>
    </div>
  </section>

  {/* ── 5 · DE DRIE STAPPEN ──────────────────────────────────────────────── */}
  <section class="paneel" aria-labelledby="cat-stappen">
    <header class="paneel-kop">
      <h2 id="cat-stappen" class="hoog hoog-2">{c.stepsH}</h2>
    </header>
    <ol class="cat-stappen">
      {c.steps.map(([h, p], i) => (
        <li><span class="mono nr">{String(i + 1).padStart(2, '0')}</span><b>{h}</b><span class="lopend">{p}</span></li>
      ))}
    </ol>
  </section>

  {/* ── 6 · WAT EEN LISTING NODIG HEEFT ──────────────────────────────────── */}
  <section class="paneel" aria-labelledby="cat-check">
    <div class="cat-twee-licht">
      <div>
        <h2 id="cat-check" class="hoog hoog-2">{c.checkH}</h2>
        <ul class="cat-check" role="list">
          {c.check.map((li) => <li>{li}</li>)}
        </ul>
      </div>
      <div class="cat-grond">
        <p class="etiket">{nl ? 'Achtergrond' : 'Background'}</p>
        <ul class="cat-grond-lijst" role="list">
          {c.chipsBg.map((chip) => <li>{chip}</li>)}
        </ul>
      </div>
    </div>
  </section>

  {/* ── 7 · HET BEWIJS ───────────────────────────────────────────────────────
      Het voor/na-paar en wat de specialist eraan doet, naast elkaar. Zie de
      noot die hier stond: dit waren twee secties met hetzelfde beeld erin. */}
  <section class="paneel" aria-labelledby="cat-bewijs">
    <header class="paneel-kop">
      <h2 id="cat-bewijs" class="hoog hoog-2">{c.baH}</h2>
      <p class="lopend">{c.baP}</p>
    </header>
    <div class="cat-bewijs">
      <Compare
        before="/img/catalog-before-1x1.webp"
        after="/img/catalog-after.webp"
        ratio="1/1"
        beforeLabel={c.baBefore}
        afterLabel="VISUAILS"
        beforeAlt={c.baBeforeAlt}
        afterAlt={c.baAfterAlt}
      />
      <div class="cat-review">
        <h3 class="hoog hoog-3">{c.reviewH}</h3>
        <p class="lopend">{c.reviewP}</p>
        <ul class="cat-review-lijst" role="list">
          {c.reviewChips.map((chip) => <li>{chip}</li>)}
        </ul>
      </div>
    </div>
  </section>

  {/* ── 8 · WAT ER VERANDERT BIJ EEN GROTERE BESTELLING ──────────────────── */}
  <section class="paneel">
    <TierCompare lang={lang} href0="/start/catalog/" label0={c.ctaPrimary} />
  </section>

  {/* ── 9 · VRAGEN ───────────────────────────────────────────────────────── */}
  <section class="paneel" aria-labelledby="cat-faq">
    <header class="paneel-kop">
      <h2 id="cat-faq" class="hoog hoog-2">{c.faqH}</h2>
    </header>
    <div class="cat-vragen">
      {c.faqs.map((f) => <Disclose summary={f.q} tone="panel"><p>{f.a}</p></Disclose>)}
    </div>
  </section>

  {/* ── 10 · HET SLOT ────────────────────────────────────────────────────── */}
  <section class="paneel paneel-slot" aria-labelledby="cat-slot">
    <h2 id="cat-slot" class="hoog" set:html={c.ctaH} />
    <p class="lopend">{c.ctaP}</p>
    <p class="acties">
      <a class="knop knop-inkt" href={lp('/start/catalog')}>{c.ctaPrimary}</a>
      <a class="knop knop-lijn" href={lp('/pricing')}>{c.ctaSecondary}</a>
      <a class="knop knop-lijn" href={c.wa} target="_blank" rel="noopener">{c.waLabel}</a>
    </p>
  </section>
</div>

<style>
  /* ── DE KOP BEGINT BOVENAAN, HET BEELD MAG ZWEVEN — 8 september 2026 ──────
     Lucas over /portal: *"bij deze pagina ook niet eerste sectie volledig
     gevuld."* Gemeten: de tekstkolom is daar 418 hoog naast een figuur van 954,
     en met `align-items: center` zweeft die tekst in het midden — 268 pixels
     wit bóven de kop. Een kop die op een derde van het paneel begint, leest als
     een fout en niet als lucht.
     Alle tien de openingsrasters op de site zijn nagemeten (kladblok/_open):
     vier stonden op 145 tot 268 pixels scheef. De regel is nu overal dezelfde:
     alles begint BOVEN. Daar begin je met lezen, daar staat de kop, en daar
     hoort het beeld ernaast te beginnen. Een uitzondering voor het beeld is
     geprobeerd en weer weggehaald: de plaatshouderfiguren komen uit een ander
     component en krijgen in Astro een eigen scope-attribuut, dus die regel
     raakte de helft van de gevallen niet — en een consistentieregel die op de
     helft van de pagina's iets anders doet, is geen regel. Eén uitlijning,
     tien pagina's, geen uitzonderingen. */
  .cat-open { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, .95fr); gap: clamp(1.5rem, 5vw, 4rem); align-items: start; }
  .cat-open .paneel-kop { margin-bottom: 0; gap: 1.1rem; }
  .cat-beeld { position: relative; }
  .cat-wacht { font-size: .92rem; color: var(--inkt-2); max-width: 40em; }
  /* De link naar het merkmodel komt via set:html binnen en draagt dus geen
     scope-attribuut; vandaar :global() op de afstammeling. Zelfde behandeling
     als elke andere inline prozalink op de site. */
  .cat-pack-p :global(a) { color: var(--inkt); text-decoration: underline; text-underline-offset: 3px; text-decoration-color: var(--geel); text-decoration-thickness: 2px; }

  /* De vier plekken van de set. Vier op een rij, 2×2 op een telefoon. De
     <Placeholder> vult de kaart net zo als een foto zou doen. */
  .cat-shots { display: grid; grid-template-columns: repeat(4, 1fr); gap: clamp(.7rem, 1.6vw, 1.1rem); }
  .cat-shot { background: var(--wit); }
  .cat-shot img { width: 100%; height: 100%; object-fit: cover; }
  .cat-shot :global([data-placeholder]) { position: absolute; inset: 0; margin: 0; }
  .cat-shot :global([data-placeholder] > *) { width: 100%; height: 100%; border-radius: 0; }
  .cat-shot-pil { position: absolute; z-index: 1; left: .6rem; bottom: .6rem; background: var(--wit); color: var(--inkt); padding: .3rem .65rem; border-radius: 999px; }
  .cat-open-noot { margin-top: 1rem; font-size: .84rem; color: var(--inkt-2); max-width: 52ch; }

  /* De ladder. Smal en niet over de volle breedte: twee kolommen over 1400px
     zet een meter wit tussen het aantal en het tarief, en dat is precies de
     enige relatie die de tabel te tonen heeft. */
  .cat-ladder { display: grid; gap: .9rem; justify-items: start; max-width: 34rem; margin-top: clamp(2.5rem, 5vw, 4rem); }
  .cat-ladder .tabel-schuif { width: 100%; }
  .cat-ladder-noot { font-size: .92rem; }

  .cat-twee { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: clamp(1.5rem, 4vw, 3.5rem); align-items: start; margin-top: clamp(2.5rem, 5vw, 4rem); }
  .cat-uitleg { display: grid; gap: .9rem; }
  .cat-waar { padding-top: 1.2rem; border-top: 1px solid rgb(245 245 245 / .22); display: grid; gap: .9rem; }
  .cat-waar-lijst { display: grid; gap: .7rem; }
  .cat-waar-lijst li { display: grid; gap: .2rem; }
  .cat-waar-lijst b { font-weight: 500; }

  .cat-stappen { display: grid; }
  .cat-stappen li { display: grid; grid-template-columns: auto minmax(0, 22rem) minmax(0, 30rem); align-items: baseline; gap: clamp(1rem, 3vw, 2.5rem); padding: clamp(1.1rem, 2.4vw, 1.8rem) 0; border-top: 1px solid var(--lijn); }
  .cat-stappen li:last-child { border-bottom: 1px solid var(--lijn); }
  .cat-stappen .nr { color: var(--inkt-2); }
  .cat-stappen b { font-family: var(--kop2); font-weight: 500; font-stretch: 125%; font-size: clamp(1.05rem, 1.8vw, 1.45rem); text-transform: uppercase; letter-spacing: -.01em; }

  .cat-twee-licht { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(1.5rem, 4vw, 3.5rem); align-items: start; }
  .cat-check { display: grid; gap: .6rem; margin-top: 1.4rem; }
  .cat-check li { position: relative; padding-left: 1.4rem; color: var(--inkt-2); }
  .cat-check li::before { content: "✓"; position: absolute; left: 0; color: var(--gloed, #9EB42F); }
  .cat-grond { display: grid; gap: .8rem; padding: clamp(1.4rem, 3vw, 2rem); border: 1px solid var(--lijn-sterk); border-radius: calc(var(--ronding) - 8px); }
  .cat-grond-lijst { display: grid; gap: .6rem; }
  .cat-grond-lijst li { display: flex; align-items: baseline; gap: .6rem; color: var(--inkt-2); }
  .cat-grond-lijst li::before { content: ""; width: 7px; height: 7px; flex: 0 0 auto; border-radius: 50%; background: var(--geel); translate: 0 -.15em; }

  .cat-bewijs { display: grid; grid-template-columns: minmax(0, 520px) minmax(0, 1fr); gap: clamp(1.6rem, 4vw, 3rem); align-items: center; }
  .cat-review { display: grid; gap: .8rem; }
  .cat-review-lijst { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: .4rem; }
  .cat-review-lijst li { font-family: var(--mono2); font-size: .72rem; font-stretch: 82%; letter-spacing: .04em; text-transform: uppercase; color: var(--inkt-2); border: 1px solid var(--lijn); border-radius: 999px; padding: .4rem .85rem; }

  .cat-vragen { display: grid; gap: .7rem; }

  @media (max-width: 900px) {
    .cat-open, .cat-twee, .cat-twee-licht, .cat-bewijs { grid-template-columns: 1fr; }
    .cat-bewijs { max-width: 520px; }
    .cat-shots { grid-template-columns: 1fr 1fr; }
    .cat-stappen li { grid-template-columns: auto 1fr; }
    .cat-stappen li .lopend { grid-column: 2; }
  }
</style>
