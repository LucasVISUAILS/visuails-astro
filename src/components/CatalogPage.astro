const c = COPY[lang];
const shots = SHOTS[lang];
const nl = lang === 'nl';
---

<section class="page-hero">
  <div class="container two-col hero-split">
    <div class="reveal pending">
      <!-- `.eyebrow-page` is the site's standing convention — /pricing,
           /compare, /models, /custom-models, /start, /ai-act and /lifestyle all
           open with it. This page and /video were the two that did not, so a
           visitor moving between the three service pages lost the label exactly
           where the pages are meant to feel like siblings. The ProductScene
           badge beside it names the IMAGE; this names the page. -->
      <span class="eyebrow-page">{c.eyebrow}</span>
      <h1 class="display cat-h1" set:html={c.h1} />
      <p class="lead" style="margin-top:1.2rem" set:html={c.lead} />
      <div class="flex" style="margin-top:1.8rem">
        <span class="magnet-wrap"><span class="magnet-inner"><a href={lp('/start/catalog')} class="btn btn-primary btn-lg">{c.ctaPrimary}</a></span></span>
        <a href={lp('/pricing')} class="btn btn-ghost btn-lg">{c.ctaSecondary}</a>
        <a href={c.wa} class="btn btn-wa" target="_blank" rel="noopener">{c.waLabel}
        </a>
      </div>
      <ServiceSwitch current="catalog" lang={lang} />
      <div class="trust-row" style="margin-top:2.4rem">
        {c.trust.map(([strong, rest]) => (
          <span class="trust-item"><strong>{strong}</strong> {rest}</span>
        ))}
        <span class="trust-item tf-flag"><strong>{turnaround('unattended', lang)}</strong></span>
        <span class="trust-item tf-verify"><strong>{c.reviewNote}</strong></span>
      </div>
      <p class="queue-note">{c.queueNote}</p>
    </div>
    <div class="reveal pending">
      <ProductScene icon="bottle" width="42%" badge={c.eyebrow} wide />
    </div>
  </div>
</section>

<!-- One product = a full 4-photo set. Spelled out so the price and the
     included on-model shot are never a surprise. The per-photo maths that
     used to sit here ("about €10 a photo") is gone: it invited a comparison
     with stock rates the rest of the site is deliberately not competing on. -->
<section class="section-tight">
  <div class="container">
    <div class="section-head" style="text-align:center;margin-inline:auto">
      <h2>{c.packH}</h2>
      <p class="pack-p" style="margin-inline:auto" set:html={c.packP} />
    </div>
    <div class="pack-row reveal-group" style="margin-top:2rem">
      {shots.map((s) => (
        <div class="pack-card reveal pending">
          <div class="photo-band"><img src={s.img} alt={s.alt} loading="lazy" decoding="async" width={s.w} height={s.h} /><span class="pack-badge">{s.n} · {s.label}</span></div>
        </div>
      ))}
    </div>
    <!-- THE RUNG LIST. Five rows, not a "from €x": this page sells one kind
         of thing, so it has the room to print the whole ladder, and a reader
         who wants to know what twelve products cost each should be able to
         find the row and stop reading. The VAT label is a column heading
         rather than a repeat on every cell — one column, one kind of number,
         so the label belongs to the column. -->
    <div class="rungs reveal pending">
      <span class="rungs-h">{c.ladderH}</span>
      <table class="rung-table">
        <thead>
          <tr>
            <th scope="col">{c.ladderProductsCol}</th>
            <th scope="col">{c.ladderRateCol}</th>
          </tr>
        </thead>
        <tbody>
          {rungRows.map((r) => (
            <tr><th scope="row">{r.label}</th><td>{r.rate}</td></tr>
          ))}
        </tbody>
      </table>
      <p class="rungs-note">{c.ladderNote}</p>
    </div>

    <div class="flex" style="justify-content:center;margin-top:1.8rem">
      <a href={lp('/start/catalog')} class="btn btn-primary">{c.packCta}</a>
    </div>
  </div>
</section>

<section class="section-tight">
  <div class="container">
    <div class="ed-head">
      <span class="ed-meta">{c.edMeta}</span>
      <div>
        <h2>{c.edH}</h2>
        <p class="ed-sub">{c.edSub}</p>
      </div>
    </div>
    <!-- Het tweede argument van dit blok — "één stijl door je hele assortiment
         heen laat je collectie als één merk lezen" — is een argument dat je
         ZIET of niet gelooft. Het stond hier als de tweede alinea van `whatP`
         en is daar ingekort: het beeld hieronder doet het werk, de tekst wijst
         er alleen nog naar. Lucas, 19 augustus 2026: *"check waar tekst minder
         kan worden en er visuele uitleg in de plaats kan komen."*
         Breed en laag (21/9), omdat het rastereffect alleen te zien is als er
         genoeg producten náást elkaar passen. -->
    <Placeholder
      lang={lang}
      space
      ratio="21 / 9"
      subject={nl ? 'Een productraster zoals een bezoeker het in een webshop ziet — twaalf verschillende producten, allemaal op dezelfde manier gefotografeerd'
                  : 'A product grid as a shopper sees it in a webshop — twelve different products, every one shot the same way'}
      message={nl
        ? 'Moet in één blik het verschil laten zien tussen "losse foto’s" en "één collectie": gelijk kader, gelijk licht, gelijke achtergrond, gelijke schaduw. De producten mogen juist onderling verschillen — een tas naast een fles naast een trui — want dan is het de fotografie die het geheel maakt en niet het assortiment. Geen enkele foto mag eruit springen; staat er één anders, dan is het beeld mislukt.'
        : 'Must show at a glance the difference between "separate photos" and "one collection": same framing, same light, same background, same shadow. The products themselves should differ — a bag beside a bottle beside a jumper — so it is the photography that makes it whole, not the range. No single shot may stand out; if one sits differently, the image has failed.'}
    />

    <div class="svc-explain">
      <div class="svc-explain-main">
        <h3>{c.whatH}</h3>
        {c.whatP.map((p) => <p>{p}</p>)}
      </div>
      <aside class="svc-explain-side">
        <h3>{c.whereH}</h3>
        <ul class="svc-where-list">
          {c.where.map(([strong, rest]) => (
            <li><strong>{strong}</strong> — {rest}</li>
          ))}
        </ul>
      </aside>
    </div>
  </div>
</section>

<section>
  <div class="container">
    <h2 style="margin-bottom:2rem">{c.stylesH}</h2>
    <div class="grid grid-2">
      {styles.map((s) => (
        <div class="card card-hover reveal pending">
          <div class="svc-media">
            <ProductScene icon={s.cardIcon} width={s.cardWidth} badge={`Catalog · ${s.name}`} wide />
          </div>
          <div class="svc-body">
            <h3>{s.name}</h3>
            <span class="svc-price">{s.cardPrice}</span>
            <p>{s.cardDesc}</p>
            <div class="flex" style="margin-top:1.2rem">
              <a href={lp(`/catalog/${s.slug}`)} class="btn btn-primary">{c.exploreLabel(s.name)}</a>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="section-tight">
  <div class="container">
    <div class="photo-split reveal pending">
      <div class="photo-split-media"><ProductScene icon="jar" width="40%" badge={c.baH} /></div>
      <div>
        <h2>{c.stepsH}</h2>
        <div class="steps steps-stacked" style="margin-top:1.6rem">
          {c.steps.map(([h, p], i) => (
            <div class="step"><span class="step-n">{String(i + 1).padStart(2, '0')}</span><h3>{h}</h3><p>{p}</p></div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<section class="section-tight">
  <div class="container two-col">
    <div class="reveal pending">
      <h2>{c.checkH}</h2>
      <ul class="checklist" style="margin-top:1.4rem">
        {c.check.map((li) => (
          <li><svg viewBox="0 0 24 24" class="i" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg><span>{li}</span></li>
        ))}
      </ul>
    </div>
    <div class="reveal pending">
      <ProductScene icon="bag" width="40%" badge={c.eyebrow} wide />
      <div class="chip-row" style="margin-top:1.2rem">
        {c.chipsBg.map((chip) => (
          <span class="chip"><span class="dot"></span>{chip}</span>
        ))}
      </div>
    </div>
  </div>
</section>

<section class="section-tight">
  <div class="container">
    <div class="section-head" style="text-align:center;margin-inline:auto"><h2>{c.baH}</h2><p style="margin-inline:auto">{c.baP}</p></div>
    <div style="max-width:520px;margin:2rem auto 0">
      <Compare
        before="/img/catalog-before.webp"
        after="/img/catalog-after.webp"
        ratio="1/1"
        objectPosition="50% 62%"
        beforeLabel={c.baBefore}
        afterLabel="VISUAILS"
        beforeAlt={c.baBeforeAlt}
        afterAlt={c.baAfterAlt}
      />
    </div>
  </div>
</section>

<section class="section-tight">
  <div class="container two-col">
    <div class="reveal pending">
      <div class="photo-split-media"><img src="/img/catalog-after.webp" alt={c.reviewAlt} loading="lazy" decoding="async" width="1800" height="1800" /></div>
    </div>
    <div class="reveal pending">
      <h2>{c.reviewH}</h2>
      <p class="lead" style="margin-top:1.2rem">{c.reviewP}</p>
      <div class="chip-row" style="margin-top:1.6rem">
        {c.reviewChips.map((chip) => (
          <span class="chip"><span class="dot"></span>{chip}</span>
        ))}
      </div>
    </div>
  </div>
</section>

<!-- WHAT CHANGES AT WINDOW_THRESHOLD PRODUCTS. This block used to be section
     13's two doors — "order individual products" against "run a whole drop" —
     a choice the buyer made. Size makes it now, so the component states a line
     rather than offering a fork; see TierCompare.astro's own header.
     One shared component, not a paragraph pasted into each service page: the
     tier facts it prints all come from pricing.js accessors, so /catalog,
     /lifestyle, /video and /pricing cannot drift apart in either language.
     See TierCompare.astro for why both columns are styled identically. -->
<section class="section-tight">
  <div class="container">
    <TierCompare lang={lang} href0="/start/catalog" label0={c.ctaPrimary} />
  </div>
</section>

<section>
  <div class="container" style="max-width:760px">
    <h2 style="margin-bottom:1.8rem">{c.faqH}</h2>
    <div class="faq-stack">
      {c.faqs.map((f) => (
        <Disclose summary={f.q} tone="panel">
          <p>{f.a}</p>
        </Disclose>
      ))}
    </div>
  </div>
</section>

<section class="section-tight">
  <div class="container">
    <div class="cta-band reveal pending">
      <h2 class="display cat-cta-h" set:html={c.ctaH} />
      <p class="lead" style="margin:1.2rem auto 0;text-align:center">{c.ctaP}</p>
      <div class="flex" style="justify-content:center;margin-top:2rem">
        <span class="magnet-wrap"><span class="magnet-inner"><a href={lp('/start/catalog')} class="btn btn-primary btn-lg">{c.ctaPrimary}</a></span></span>
        <a href={lp('/pricing')} class="btn btn-ghost btn-lg">{c.ctaSecondary}</a>
        <a href={c.wa} class="btn btn-wa" target="_blank" rel="noopener">{c.waLabel}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  /* Editorial accent (task #271b, Lucas's own request) — see global.css's
     --font-editorial comment. Same closing-word treatment as the other hero
     H1s on the homepage and the model pages. */
  .cat-h1 em { font-family: var(--font-editorial); font-style: italic; font-weight: 700; }

  /* De maten stonden hier als met de hand ingetypte clamps in een style-
     attribuut, en waren op het teken na gelijk aan de tokens. Dat is precies
     hoe deze site aan acht verschillende H1-maten kwam: "paginatitel" had geen
     token, dus werd hij overal opnieuw ingetypt en dreven de kopieën uit
     elkaar. Nu staat de maat op één plek, in global.css. */
  .cat-h1 { font-size: var(--t-page-h1); margin-top: 1rem; }
  .cat-cta-h { font-size: var(--t-page-h2); }

  /* The queue disclosure. Section 13 requires the "no fixed delivery date"
     half of the promise to be visible, not hidden — so it is set at body
     weight directly under the trust row rather than as footnote-sized grey. */
  .queue-note { margin-top: .9rem; font-size: .88rem; color: var(--ink-3); }

  /* ── The rung list ────────────────────────────────────────────────────────
     A real table, for the same reason /pricing's ladder is one: a rate card is
     tabular data. It is narrow and centred because it has two columns rather
     than four — a full-width two-column table puts a metre of white space
     between the count and its rate, which is the one relationship it exists to
     show. Tabular figures so the rates line up in the column. */
  .rungs { max-width: 460px; margin: 2.4rem auto 0; }
  .rungs-h { display: block; font-size: .72rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--ink-3); }
  .rung-table {
    width: 100%;
    margin-top: .8rem;
    border-collapse: collapse;
    font-variant-numeric: tabular-nums lining-nums;
  }
  .rung-table th, .rung-table td { padding: .7rem .2rem; text-align: right; }
  .rung-table thead th {
    font-size: .68rem;
    font-weight: 700;
    letter-spacing: .07em;
    text-transform: uppercase;
    color: var(--ink-3);
    border-bottom: 1px solid var(--line-strong);
  }
  .rung-table thead th:first-child, .rung-table tbody th { text-align: left; }
  .rung-table tbody tr + tr th, .rung-table tbody tr + tr td { border-top: 1px solid var(--line); }
  .rung-table tbody th { font-family: var(--font-display); font-weight: 700; font-size: .98rem; color: var(--ink); white-space: nowrap; }
  .rung-table tbody td { font-family: var(--font-display); font-weight: 800; font-size: 1.05rem; letter-spacing: -0.02em; color: var(--ink); }
  .rungs-note { margin-top: 1rem; font-size: .88rem; line-height: 1.55; color: var(--ink-3); }

  .chip-row { display: flex; flex-wrap: wrap; gap: .6rem; }
  .chip { display: inline-flex; align-items: center; gap: .5rem; font-size: .84rem; color: var(--ink-2); background: var(--surface-2); border: 1px solid var(--line); padding: .45rem .9rem; }
  .chip .dot { width: 6px; height: 6px; background: var(--accent); flex: 0 0 auto; }

  /* `.drop-note` lived here, and identically in LifestylePage.astro and
     VideoPage.astro. Three copies of one block is what TierCompare.astro
     replaced; its styles are scoped to that component now. */

  .faq-stack { display: flex; flex-direction: column; gap: .7rem; }
  .faq-item { background: var(--surface); border: 1px solid var(--line); padding: 1.1rem 1.3rem; }
  .faq-item summary { cursor: pointer; list-style: none; font-weight: 600; color: var(--ink); font-size: .98rem; }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary::marker { content: ''; }
  .faq-item summary::after { content: '+'; float: right; color: var(--ink-3); font-family: var(--font-display); font-size: 1.2rem; }
  .faq-item[open] summary::after { content: '\2212'; }
  .faq-item p { margin-top: .8rem; color: var(--ink-3); font-size: .92rem; line-height: 1.6; }

  /* The scoped `.step` override that used to sit here is `.steps-stacked` in
     global.css now — /lifestyle and /video use the same stacked row, and three
     copies of five declarations is how the last four duplications started. */

  /* The Brand Model link inside packP. It arrives through set:html, so it
     carries no scope attribute and a plain `.pack-p a` rule would not reach
     it — hence :global() on the descendant. Same treatment every other inline
     prose link on the site gets (see .legal a, .pl-panel-link a). */
  .pack-p :global(a) { color: var(--accent-bright); text-decoration: underline; text-underline-offset: 3px; }

  /* The 4-photo product set. Four tiles on desktop, 2×2 on phones. */
  .pack-row { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; }
  @media (max-width: 720px) { .pack-row { grid-template-columns: 1fr 1fr; } }
  .pack-card .photo-band { position: relative; aspect-ratio: 3 / 4; overflow: hidden; border: 1px solid var(--line); }
  .pack-card .photo-band img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .pack-badge { position: absolute; left: 10px; bottom: 10px; padding: .35rem .7rem; border-radius: var(--r-pill); background: rgb(var(--scrim) / 0.86); color: var(--paper-on-dark); font-size: .78rem; font-weight: 600; }
</style>
