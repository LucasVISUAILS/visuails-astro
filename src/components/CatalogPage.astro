      },
    ],
    ctaH: 'Build a catalog that<br>looks like one brand.',
    ctaP: `${euro(entry, 'en')} per product, down to ${euro(floor, 'en')} from ${floorFrom} up — ${vatLabel('excl', 'en')}.`,
  },
  nl: {
    eyebrow: 'Catalog',
    h1: 'Strakke, consistente productvisuals — <em>ook bij dertig producten.</em>',
    lead: `Een complete set per product, vanaf 4 foto’s — voorkant, achterkant, een close-up van de stof of het logo, en één foto op een model. Meer beelden per product kan altijd. <strong>${euro(entry, 'nl')} per product</strong> ${vatLabel('excl', 'nl')}, en dat daalt naar ${euro(floor, 'nl')} vanaf ${floorFrom} producten.`,
    ctaPrimary: 'Bestel catalogusbeelden',
    ctaSecondary: 'Bekijk de prijs per product',
    wa: waHref("Hoi VISUAILS, ik wil graag Catalog-visuals bestellen voor mijn producten."),
    waLabel: 'WhatsApp',
