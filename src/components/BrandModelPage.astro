    ['W', 'Warm and approachable', 'Open expression, natural light, everyday ease.'],
    ['H', 'High-fashion editorial', 'Sculptural pose, hard shadow, magazine intensity.'],
    ['R', 'Retro Americana', 'Warm film tones, nostalgic styling.'],
    ['C', 'Coastal and sun-worn', 'Sun-bleached warmth, golden-hour ease.'],
    ['M', 'Monochrome studio', 'Single-tone wardrobe, graphic shadow.'],
    ['B', 'Bold colour-block', 'Saturated wardrobe, unmistakable at thumbnail size.'],
  ],
  nl: [
    ['E', 'Editorial minimal', 'Ingetogen studiolicht, rustige houding, neutrale garderobe.'],
    ['S', 'Streetwear energy', 'Directe blik, gedurfde houding, hard licht met veel contrast — voor een lancering die opvalt.'],
    ['Q', 'Quiet luxury', 'Zachte neutrale tinten, ontspannen houding, verfijnd detail.'],
    ['W', 'Warm en toegankelijk', 'Open uitdrukking, natuurlijk licht, alledaags gemak.'],
    ['H', 'High-fashion editorial', 'Sculpturale pose, harde schaduw, magazine-intensiteit.'],
    ['R', 'Retro Americana', 'Warme filmtinten, nostalgische styling.'],
    ['C', 'Coastal en sun-worn', 'Zonverbleekte warmte, het licht van het gouden uur.'],
    ['M', 'Monochrome studio', 'Garderobe in één tint, grafische schaduw.'],
    ['B', 'Bold colour-block', 'Verzadigde garderobe, ook klein in een feed nog onmiskenbaar.'],
  ],
};

// The five steps. Numbers are positional, so they are generated rather than
// typed: a hand-typed '03' that survives a deleted step is a classic stale
// artefact.
const STEPS = {
  en: [
    ['You send', 'You send references and tell us the look you want.'],
    ['Directions', 'We design two or three directions for you to react to.'],
    ['You choose', 'Pick the face that fits, with one round of refinement.'],
    ['Locked', 'The model is fixed so it cannot drift between orders.'],
    ['In every order', 'From then on your model carries every visual we make.'],
  ],
  nl: [
    ['Jij stuurt', 'Je stuurt referenties en vertelt welke look je wilt.'],
    ['Richtingen', 'We ontwerpen twee of drie richtingen waarop je kunt reageren.'],
    ['Jij kiest', 'Kies het gezicht dat past, met één ronde verfijning.'],
    ['Vastgezet', 'We leggen het model vast, zodat het niet per bestelling gaat verschuiven.'],
    ['In elke bestelling', 'Vanaf dan draagt jouw model elke visual die we maken.'],
  ],
};

const c = COPY[lang];
const nl = lang === 'nl';
const directions = DIRECTIONS[lang];
const steps = STEPS[lang];
const wa = waHref(c.waText);
---

<!-- HERO -->
<section class="page-hero"><div class="container two-col bm-hero">
  <div>
    <p class="eyebrow-page">{c.eyebrow}</p>
    <h1 class="display bm-h1">{c.h1a}<br /><em>{c.h1b}</em></h1>
    <p class="lead bm-lead">{c.lead}</p>
    <div class="flex bm-actions">
      <span class="magnet-wrap"><span class="magnet-inner"><a href={lp('/start/brand-model')} class="btn btn-primary btn-lg">{c.ctaPrimary}</a></span></span>
      <a href={wa} class="btn btn-wa" target="_blank" rel="noopener">{c.ctaWa}
      </a>
    </div>
    <ServiceSwitch current={['brand-model', 'complete']} lang={lang} />
    <div class="trust-row bm-trust">
      {c.trust.map((t) => (
        <span class="trust-item"><strong>{t[0]}</strong> {t[1]}</span>
      ))}
    </div>
  </div>
  <div class="photo-split-media"><img src="/img/custom-models-03.webp" alt={c.heroAlt} decoding="sync" width="800" height="1071" fetchpriority="high" /></div>
</div></section>

<!-- YOUR MODEL, NOT A MODEL -->
<section class="section-tight"><div class="container">
  <div class="photo-split reverse reveal pending">
    <div class="photo-split-media"><img src="/img/model-03.webp" alt={c.notAAlt} loading="lazy" decoding="async" width="800" height="1071" /></div>
    <div>
      <h2 set:html={c.notAH} />
      <p class="lead bm-lead">{c.notALead}</p>
    </div>
  </div>

  <div class="arrow-rows reveal-group bm-props">
    {c.props.map((p) => (
      <div class="arow reveal pending"><h3>{p[0]}</h3><p>{p[1]}</p></div>
    ))}
  </div>
</div></section>

<!-- WHAT IT COSTS.
     The number is stated before the argument for it, not after. A brand about
     to spend four figures on exclusivity finds the price eventually; making
     them hunt for it is the only thing that turns it into a shock. -->
<section class="section-tight"><div class="container">
  <div class="section-head"><h2>{c.costH}</h2></div>

  <div class="bmcost reveal pending">
    <div class="bmcost-figures">
      <div class="bmcost-fig">
        <span class="bmcost-key">{c.costSetupLabel}</span>
        <span class="bmcost-amount">{brandModel.price}</span>
        <span class="bmcost-unit">{brandModel.unit}</span>
        <span class="bmcost-vat">{c.costSetupVat}</span>
      </div>
      <div class="bmcost-rule" aria-hidden="true"></div>
      <div class="bmcost-fig">
        <span class="bmcost-key">{c.costCreditLabel}</span>
        <span class="bmcost-amount">&minus;{euro(AMOUNT.brandModelCredit, lang)}</span>
        <span class="bmcost-unit">{c.costCreditUnit}</span>
        <span class="bmcost-vat">{c.costCreditVat}</span>
      </div>
    </div>

    <div class="bmcost-body">
      <span class="bmcost-inc-h">{c.costIncludes}</span>
      <ul class="checklist bmcost-inc">
        {brandModel.includes.map((f) => (
          <li><svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>{f}</li>
        ))}
      </ul>
      <p class="bmcost-seq">{c.costSequence}</p>
    </div>
  </div>

  <div class="bmcost-notes reveal-group">
    <div class="bmcost-note reveal pending">
      <h3>{c.costMathH}</h3>
      <p>{c.costMath}</p>
    </div>
    <div class="bmcost-note reveal pending">
      <p class="bmcost-free">{c.costFree}</p>
      <a href={lp('/pricing')} class="link-arrow">{c.costCta}
        <svg viewBox="0 0 24 24" class="i" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>
    </div>
  </div>
</div></section>

<!-- WHERE IT FITS -->
<section class="section-tight"><div class="container">
  <div class="ed-head">
    <span class="ed-meta">{c.fitMeta}</span>
    <div>
      <h2>{c.fitH}</h2>
      <p class="ed-sub">{c.fitSub}</p>
    </div>
  </div>
  <!-- Deze pagina verkoopt één ding: hetzelfde gezicht, overal. Dat is een
       claim die je in twee alinea's kunt uitleggen of in één beeld kunt
       bewijzen — en de tweede alinea van `fitWhat` deed het eerste. Die is
       ingekort tot één regel; dit vlak doet nu het bewijs. -->
  <Placeholder
    lang={lang}
    space
    ratio="21 / 9"
    subject={nl ? 'Zes beelden naast elkaar met hetzelfde merkmodel: twee producten uit de webshop, een advertentie, een e-mailheader, een socialpost en een campagnebeeld'
                : 'Six frames side by side with the same brand model: two webshop products, an ad, an email header, a social post and a campaign image'}
    message={nl
      ? 'Moet bewijzen dat het om één persoon gaat en niet om zes modellen die op elkaar lijken — hetzelfde gezicht moet zó herkenbaar zijn dat je het al ziet voordat je de kaders los bekijkt. Product, kader en kleur mogen per beeld verschillen; alleen het gezicht ligt vast. Dat verschil is de hele boodschap: het merk komt van het gezicht, niet van de set.'
      : 'Must prove this is one person and not six lookalikes — the same face has to be recognisable before you even look at the frames separately. Product, framing and colour may differ per frame; only the face is fixed. That contrast is the whole message: the brand comes from the face, not from the set.'}
  />

  <div class="svc-explain">
    <div class="svc-explain-main">
      <h3>{c.fitWhatH}</h3>
      {c.fitWhat.map((p) => <p>{p}</p>)}
    </div>
    <aside class="svc-explain-side">
      <h3>{c.fitWhereH}</h3>
      <ul class="svc-where-list">
        {c.fitWhere.map((w) => (
          <li><strong>{w[0]}</strong> — {w[1]}</li>
        ))}
      </ul>
    </aside>
  </div>
</div></section>

<!-- DIRECTIONS -->
<section class="section-tight"><div class="container">
  <div class="section-head"><h2>{c.dirH}</h2><p>{c.dirLead}</p></div>
  <div class="grid bm-dirs reveal-group">
    {directions.map((d) => (
      <div class="card bm-dir reveal pending">
        <div class="monogram" aria-hidden="true">{d[0]}</div>
        <h3>{d[1]}</h3>
        <p>{d[2]}</p>
      </div>
    ))}
  </div>
</div></section>

<!-- REAL OUTPUT -->
<section class="section-tight"><div class="container">
  <div class="section-head"><h2>{c.outH}</h2></div>
  <div class="grid grid-3 reveal-group">
    {EXAMPLES.map((photo, i) => (
      <div class="reveal pending">
        <div class="photo-band square"><img src={photo.src} alt={`${c.outAlt} ${i + 1}`} loading="lazy" decoding="async" width={photo.w} height={photo.h} /></div>
      </div>
    ))}
  </div>
</div></section>

<!-- HOW IT COMES TOGETHER -->
<section class="section-tight"><div class="container">
  <div class="section-head"><h2>{c.procH}</h2></div>
  <!-- Vijf stappen als tekst vertellen WAT er gebeurt; dit vlak laat zien hoe
       het eruitziet terwijl het gebeurt. Het staat vóór de stappen en niet
       erna: wie het proces al herkent hoeft de vijf regels niet meer te
       lezen. -->
  <Placeholder
    lang={lang}
    space
    ratio="16 / 9"
    subject={nl ? 'Een richtingenblad: drie voorgestelde gezichten naast elkaar, met aantekeningen van de klant erbij en één ervan aangekruist'
                : 'A directions sheet: three proposed faces side by side, the client’s notes beside them and one of them ticked'}
    message={nl
      ? 'Moet laten zien dat dit een gesprek is en geen bestelknop — er wordt iets voorgelegd, er wordt op gereageerd, er wordt gekozen. De drie gezichten moeten duidelijk verschillen (leeftijd, houding, styling), anders lijkt het een keuze zonder keuze. De aantekeningen mogen onleesbaar zijn; dat er óp het werk geschreven is, is het punt.'
      : 'Must show this is a conversation, not a buy button — something is proposed, responded to, chosen. The three faces have to differ clearly (age, posture, styling), or it reads as a choice without a choice. The notes may be illegible; that someone wrote on the work is the point.'}
  />
  <div class="steps reveal-group">
    {steps.map((s, i) => (
      <div class="step reveal pending">
        <span class="step-n">{String(i + 1).padStart(2, '0')}</span>
        <h3>{s[0]}</h3>
        <p>{s[1]}</p>
      </div>
    ))}
  </div>
</div></section>

<!-- WHAT YOU SEND / WHAT YOU GET -->
<section class="section-tight"><div class="container two-col bm-exchange">
  <div class="card reveal pending">
    <h3>{c.giveH}</h3>
    <ul class="checklist bm-exchange-list">
      {c.give.map((g) => (
        <li><svg viewBox="0 0 24 24" class="i" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg><span set:html={g[1]} /></li>
      ))}
    </ul>
  </div>
  <div class="card bm-get reveal pending">
    <h3>{c.getH}</h3>
    <ul class="checklist bm-exchange-list">
      {c.get.map((g) => (
        <li><svg viewBox="0 0 24 24" class="i" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg><span set:html={g[1]} /></li>
      ))}
    </ul>
  </div>
</div></section>

<!-- THE STANDARD LIBRARY — a taste, not the full roster (task #268; see the
     file header for why). It sits below the Brand Model argument rather than
     above it because this page's job is the exclusive face; the library is
     the alternative you already have, and saying so plainly is what makes
     the Brand Model an honest upsell rather than a gate. Four of the ten,
     not all ten: the full roster now has its own page at /models, and
     showing all ten here again would put the same ten portraits on two
     pages for search engines to index as duplicate content. -->
<section class="section-tight" id="standard"><div class="container">
  <div class="ed-head">
    <span class="ed-meta">{c.libMeta}</span>
    <div>
      <h2>{c.libH}</h2>
      <p class="ed-sub">{c.libLead}</p>
    </div>
  </div>

  <div class="bm-roster reveal-group">
    {ROSTER.slice(0, 4).map((m) => (
      <figure class="bm-model reveal pending">
        <img src={m.photo} alt={`${m.name} — ${c.libAlt}`} loading="lazy" decoding="async" width={m.w} height={m.h} />
        <figcaption>
          <span class="bm-model-name">{m.name}</span>
          <span class="bm-model-traits">{m.traits.map((t) => c.traits[t]).join(' · ')}</span>
        </figcaption>
      </figure>
    ))}
    <div class="bm-model bm-model-choose reveal pending">
      <div class="bm-choose-inner">
        <h3>{c.libChooseH}</h3>
        <p>{c.libChooseBody}</p>
        <a href={lp('/start/brand-model')} class="link-arrow">{c.ctaPrimary}
          <svg viewBox="0 0 24 24" class="i" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
      </div>
    </div>
  </div>

  <p class="bm-lib-note">{c.libNote} <a class="link-arrow" href={lp('/models')}>{c.libAllCta} &rarr;</a></p>
</div></section>

<!-- WHY NOT A GENERATOR.
     This replaces the two-panel "Generic AI tool vs VISUAILS" comparison. That
     block put one of our own renders under a competitor's label and attached
     three failings to it that no one measured — an invented result under the
     brief's own rule, and unnecessary: the argument is stronger without a
     strawman to knock over. /compare carries the tool comparison (§H·5). -->
<section class="section-tight"><div class="container narrow">
  <div class="section-head"><h2>{c.genH}</h2></div>
  <div class="bm-gen reveal pending">
    {c.genBody.map((p) => <p>{p}</p>)}
    <a href={lp('/compare#ai-tools')} class="link-arrow">{c.genCta}
      <svg viewBox="0 0 24 24" class="i" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
    </a>
  </div>
</div></section>

<!-- CLOSING -->
<section class="section-tight"><div class="container">
  <div class="cta-band reveal pending">
    <h2 class="display bm-cta-h">{c.ctaH1}<br /><em>{c.ctaEm}</em></h2>
    <div class="flex bm-cta-actions">
      <a href={lp('/start/brand-model')} class="btn btn-primary btn-lg">{c.ctaStart}</a>
      <a href={lp('/pricing')} class="btn btn-ghost btn-lg">{c.ctaPricing}</a>
      <a href={wa} class="btn btn-wa" target="_blank" rel="noopener">{c.ctaWaShort}
      </a>
    </div>
  </div>
</div></section>

<style>
  /* Hard edges, hairlines, two ramps. No radius anywhere on this page — the
     roster is the one place a radius would have crept back in, because round
     avatars are the web's default for faces. Squares read as plates in a
     lookbook, which is what they are. */
  .container.narrow { max-width: 760px; }

  .bm-hero { align-items: center; }
  /* Was een met de hand ingetypte clamp, teken voor teken gelijk aan het
     token. Zie de noot bij --t-page-h1 in global.css: "paginatitel" had geen
     token en werd daarom 53 keer opnieuw ingetypt, met acht verschillende
     maten als resultaat. */
  .bm-h1 { font-size: var(--t-page-h1); max-width: 16ch; }
  /* Editorial accent (task #271b, Lucas's own request) — see global.css's
     --font-editorial comment. Scoped to this page's own h1 em, same reasoning
     as HomePage.astro's equivalent override. */
  .bm-h1 em { font-family: var(--font-editorial); font-style: italic; font-weight: 700; }
  .bm-lead { margin-top: 1.2rem; }
  .bm-actions { margin-top: 1.8rem; }
  .bm-trust { margin-top: 2.4rem; }
  .bm-props { grid-template-columns: repeat(2, 1fr); margin-top: clamp(2.5rem, 5vw, 4rem); }

  @media (max-width: 720px) { .bm-props { grid-template-columns: 1fr; } }

  /* COST — the figures band. Two numbers, a hairline between them, then the
     inclusions. The credit is shown as a negative so the pair reads as one
     sum rather than as two unrelated prices. */
  .bmcost { display: grid; grid-template-columns: minmax(280px, 26rem) 1fr; border: 1px solid var(--line-strong); }
  .bmcost-figures { display: grid; grid-template-rows: 1fr auto 1fr; border-right: 1px solid var(--line-strong); }
  .bmcost-fig { display: flex; flex-direction: column; gap: .35rem; padding: clamp(1.4rem, 3vw, 2.2rem); }
  .bmcost-rule { height: 1px; background: var(--line-strong); }
  .bmcost-key { font-size: .76rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--ink-3); }
  .bmcost-amount { font-family: var(--font-display); font-weight: 900; font-size: clamp(2rem, 4.4vw, 3rem); line-height: 1; letter-spacing: -0.03em; color: var(--ink); }
  .bmcost-unit { font-size: .92rem; color: var(--ink-3); }
  /* Under the figure, not beside it: at this type size a trailing "excl. VAT"
     either shrinks the price or wraps, and an unreadable VAT label is the same
     failure as no VAT label. Same call /pricing's .anchor-vat makes. */
  .bmcost-vat { display: block; margin-top: .45rem; font-size: .78rem; color: var(--ink-3); }
  .bmcost-body { padding: clamp(1.4rem, 3vw, 2.2rem); display: flex; flex-direction: column; gap: 1rem; }
  .bmcost-inc-h { font-size: .76rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--ink-3); }
  .bmcost-inc { margin: 0; }
  .bmcost-seq { font-size: .9rem; color: var(--ink-3); border-top: 1px solid var(--line); padding-top: 1rem; margin: auto 0 0; }
  @media (max-width: 860px) {
    .bmcost { grid-template-columns: 1fr; }
    .bmcost-figures { grid-template-rows: none; border-right: 0; border-bottom: 1px solid var(--line-strong); }
  }

  .bmcost-notes { display: grid; grid-template-columns: repeat(2, 1fr); gap: clamp(1.2rem, 3vw, 2.4rem); margin-top: clamp(1.6rem, 3vw, 2.4rem); }
  .bmcost-note h3 { font-size: 1.05rem; margin: 0 0 .5rem; }
  .bmcost-note p { color: var(--ink-2); font-size: .96rem; line-height: 1.65; margin: 0; }
  .bmcost-free { color: var(--ink-3); }
  .bmcost-note .link-arrow { margin-top: .9rem; }
  @media (max-width: 860px) { .bmcost-notes { grid-template-columns: 1fr; } }

  /* DIRECTIONS */
  .bm-dirs { grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); }
  .bm-dir { display: flex; flex-direction: column; gap: .9rem; }
  .bm-dir h3 { font-size: 1.05rem; margin: 0; }
  .bm-dir p { font-size: .9rem; color: var(--ink-3); margin: 0; }
  .monogram { width: 56px; height: 56px; display: grid; place-items: center; font-family: var(--font-display); font-weight: 900; font-size: 1.3rem; color: var(--ink); background: var(--surface-2); border: 1px solid var(--line-strong); }

  /* EXCHANGE */
  .bm-exchange { align-items: start; }
  .bm-exchange-list { margin-top: var(--gap-head-block); }
  .bm-get { border-color: var(--line-strong); }

  /* THE ROSTER — .bm-roster/.bm-model/etc. moved to global.css (task #268):
     /models now renders the same roster grid, so the rules live where both
     pages can reach them instead of only here. */

  /* THE GENERATOR ANSWER — prose, deliberately. The block it replaced was two
     image panels; the whole point of removing it was that the argument does
     not need a picture of a strawman. */
  .bm-gen p { color: var(--ink-2); font-size: 1.02rem; line-height: 1.7; margin: 0 0 1rem; }
  .bm-gen p:last-of-type { margin-bottom: 1.2rem; }

  .bm-cta-h { font-size: var(--t-page-h2); }
  .bm-cta-actions { justify-content: center; margin-top: 2rem; }
</style>
