      ['credit', `<strong>${euro(AMOUNT.brandModel, 'nl')} eenmalig</strong> ${vatLabel('excl', 'nl')}, en daarna niets meer.`],
    ],

    libMeta: '( Of begin hier )',
    libH: 'De standaardbibliotheek',
    libAlt: 'een VISUAILS-standaardmodel',
    /* Zie de noot bij de Engelse tabel. */
    libLead: `${rosterWoord('nl', true)} modellen die we voor alle merken gebruiken, inbegrepen in elke bestelling zonder extra kosten. Kies er zelf een, of vertel ons bij het bestellen wat je verkoopt en wie je klant is — dan kiezen wij er een dat past en blijven we dat gebruiken.`,
    libNote: `${telwoord(TOONBAAR, 'nl', true)} van de ${rosterWoord('nl')} staan hier. Ze kosten niets extra, en later overstappen op een eigen merkmodel betekent niet dat je iets over moet doen.`,
    libAllCta: `Bekijk alle ${rosterWoord('nl')}`,
    libOwnCta: 'Of laat er een voor je maken',
    traits: {
      warm: 'Warm', approachable: 'Toegankelijk', editorial: 'Editorial', elegant: 'Elegant',
      refined: 'Verfijnd', classic: 'Klassiek', sporty: 'Sportief', energetic: 'Energiek',
      confident: 'Zelfverzekerd', modern: 'Modern', natural: 'Natuurlijk', bold: 'Gedurfd',
      statement: 'Statement', soft: 'Zacht', understated: 'Ingetogen', clean: 'Clean',
      contemporary: 'Eigentijds', sharp: 'Scherp',
    },

    genH: 'Waarom niet gewoon zelf iets met een AI-generator maken?',
    genBody: [
      'Dat kan, en voor één beeld kun je dat waarschijnlijk beter doen. Wat een prompt je niet geeft, is twee keer dezelfde persoon. Vraag een algemene generator om hetzelfde gezicht voor dertig producten en je krijgt dertig familieleden — steeds net iemand anders, en dat ziet een klant als slordigheid, lang voordat hij kan zeggen waarom.',
      'Wij verkopen niet het maken van een beeld. Wij verkopen dat het vastligt: één identiteit die één keer wordt vastgezet, gestuurd door je eigen productfoto’s, en door een specialist bekeken voordat er iets naar je toe gaat. Dat is het deel dat een hele collectie meegaat.',
    ],
    genCta: 'De hele vergelijking, ook met AI-tools',

    ctaH1: 'Ontwerp het gezicht van',
    ctaEm: 'jouw merk.',
    ctaStart: 'Start je merkmodel',
    ctaPricing: 'Bekijk de prijs per product',
    ctaWaShort: 'WhatsApp',
  },
};

// The nine directions. Kept out of COPY because the initial is shared across
// languages and only the body is translated — duplicating the letters would be
// two places for one fact.
const DIRECTIONS = {
  en: [
    ['E', 'Editorial minimal', 'Restrained studio light, quiet posture, neutral wardrobe.'],
    ['S', 'Streetwear energy', 'Direct gaze, bold stance, contrast light — for drops with noise.'],
    ['Q', 'Quiet luxury', 'Soft neutrals, unhurried posture, refined detail.'],
    ['W', 'Warm and approachable', 'Open expression, natural light, everyday ease.'],
    ['H', 'High-fashion editorial', 'Sculptural pose, hard shadow, magazine intensity.'],
    ['R', 'Retro Americana', 'Warm film tones, nostalgic styling.'],
    ['C', 'Coastal and sun-worn', 'Sun-bleached warmth, golden-hour ease.'],
    ['M', 'Monochrome studio', 'Single-tone wardrobe, graphic shadow.'],
    ['B', 'Bold colour-block', 'Saturated wardrobe, unmistakable at thumbnail size.'],
  ],
  nl: [
    ['E', 'Editorial minimal', 'Ingetogen studiolicht, rustige houding, neutrale garderobe.'],
    ['S', 'Streetwear energy', 'Directe blik, gedurfde houding, hard licht met veel contrast — voor een lancering die opvalt.'],
    ['Q', 'Quiet luxury', 'Zachte neutrale tinten, ontspannen houding, verfijnd detail.'],
    ['W', 'Warm en toegankelijk', 'Open uitdrukking, natuurlijk licht, alledaags gemak.'],
    ['H', 'High-fashion editorial', 'Sculpturale pose, harde schaduw, magazine-intensiteit.'],
    ['R', 'Retro Americana', 'Warme filmtinten, nostalgische styling.'],
    ['C', 'Coastal en sun-worn', 'Zonverbleekte warmte, het licht van het gouden uur.'],
    ['M', 'Monochrome studio', 'Garderobe in één tint, grafische schaduw.'],
    ['B', 'Bold colour-block', 'Verzadigde garderobe, ook klein in een feed nog onmiskenbaar.'],
  ],
};

// The five steps. Numbers are positional, so they are generated rather than
// typed: a hand-typed '03' that survives a deleted step is a classic stale
// artefact.
const STEPS = {
  en: [
    ['You send', 'You send references and tell us the look you want.'],
    ['Directions', 'We design two or three directions for you to react to.'],
    ['You choose', 'Pick the face that fits, with one round of refinement.'],
    ['Locked', 'The model is fixed so it cannot drift between orders.'],
    ['In every order', 'From then on your model carries every visual we make.'],
  ],
  nl: [
    ['Jij stuurt', 'Je stuurt referenties en vertelt welke look je wilt.'],
    ['Richtingen', 'We ontwerpen twee of drie richtingen waarop je kunt reageren.'],
    ['Jij kiest', 'Kies het gezicht dat past, met één ronde verfijning.'],
    ['Vastgezet', 'We leggen het model vast, zodat het niet per bestelling gaat verschuiven.'],
    ['In elke bestelling', 'Vanaf dan draagt jouw model elke visual die we maken.'],
  ],
};

const c = COPY[lang];
const nl = lang === 'nl';
const directions = DIRECTIONS[lang];
const steps = STEPS[lang];
const wa = waHref(c.waText);
---

{/* ═══ /custom-models IN DE STIJL VAN SECTIE 22 — 7 september 2026 ══════════
    Negende pagina in de stijl. Alles boven deze regel is onaangeraakt: dezelfde
    COPY in beide talen, dezelfde ROSTER uit models.js, hetzelfde bedrag uit
    pricing.js met zijn btw-label, dezelfde WALL en EXAMPLES, dezelfde
    <Placeholder>s met hun opdracht erin. Alleen de opmaak verandert.

    ELF SECTIES ZIJN ER TIEN GEWORDEN, en dat is de enige inhoudelijke ingreep:
    "de richtingen" en "echt geleverd werk" stonden als twee losse secties onder
    elkaar terwijl ze dezelfde vraag beantwoorden — hoe ziet zo'n gezicht eruit.
    Ze delen nu één paneel, met elk hun eigen kop. Niets is geschrapt.

    TWEE DONKERE KAMERS: waar het past, en waarom geen generator. Dat zijn de
    twee plekken waar de pagina van tonen naar betogen gaat, en een
    hoofdstukwissel is precies wat daar hoort. */}
<div class="s22">

  {/* ── 1 · DE OPENING ───────────────────────────────────────────────────── */}
  <section class="paneel" aria-labelledby="bm-h1">
    <div class="bm-open">
      <div class="paneel-kop">
        <p class="etiket">{c.eyebrow}</p>
        <h1 id="bm-h1" class="hoog">{c.h1a}<br /><em>{c.h1b}</em></h1>
        <p class="lopend">{c.lead}</p>
        <p class="acties">
          <a class="knop knop-inkt" href={lp('/start/brand-model')}>{c.ctaPrimary}</a>
          <a class="knop knop-lijn" href={wa} target="_blank" rel="noopener">{c.ctaWa}</a>
        </p>
        <ServiceSwitch current={['brand-model', 'complete']} lang={lang} />
        <div class="trust-row bm-trust">
          {c.trust.map((t) => (
            <span class="trust-item"><strong>{t[0]}</strong> <span class="trust-label">{t[1]}</span></span>
          ))}
        </div>
      </div>

      {/* ── ZES GEDEELDE GEZICHTEN, ÉÉN VAN JOU ────────────────────────────
          De muur is `aria-hidden`: hij zegt niets wat de tekst niet zegt, en
          zes lege alt-teksten zijn zes keer niets voor wie voorleest. Het
          portret ernaast draagt de alt-tekst en het onderschrift, en dat
          onderschrift zegt er meteen bij dat het een voorbeeld is — geen echt
          merkmodel van een echte klant. */}
      <figure class="bm-cast">
        <div class="bm-muur" aria-hidden="true">
          {WALL.map((m) => (
            <span class="kaart kaart-stil bm-muur-vak">
              <img src={m.src} alt="" width={m.w} height={m.h} loading="lazy" decoding="async" />
            </span>
          ))}
          <span class="mono bm-muur-etiket">{c.castShared}</span>
        </div>
        <div class="bm-een">
          <span class="kaart kaart-stil">
            <img src="/img/custom-models-02.webp" alt={c.heroAlt} decoding="sync" width="800" height="1071" fetchpriority="high" />
          </span>
          <span class="mono bm-een-etiket">{c.castYours}</span>
        </div>
        <figcaption class="mono bm-cast-onder">{c.castNote}</figcaption>
      </figure>
    </div>
  </section>

  {/* ── 2 · JOUW MODEL, GEEN MODEL ───────────────────────────────────────── */}
  <section class="paneel" aria-labelledby="bm-nota">
    <header class="paneel-kop">
      <h2 id="bm-nota" class="hoog hoog-2" set:html={c.notAH} />
      <p class="lopend">{c.notALead}</p>
    </header>
    <ul class="bm-props" role="list">
      {c.props.map((p) => (
        <li><b>{p[0]}</b><span class="lopend">{p[1]}</span></li>
      ))}
    </ul>
  </section>

  {/* ── 3 · WAT HET KOST ─────────────────────────────────────────────────────
      Het getal staat vóór het argument ervoor en niet erna. Een merk dat op het
      punt staat vier cijfers aan exclusiviteit uit te geven vindt de prijs
      uiteindelijk toch; ze laten zoeken is het enige dat er een schrik van
      maakt. */}
  <section class="paneel" aria-labelledby="bm-kost">
    <header class="paneel-kop">
      <h2 id="bm-kost" class="hoog hoog-2">{c.costH}</h2>
    </header>
    <div class="bm-kost">
      <p class="bm-bedrag">
        <span class="etiket">{c.costSetupLabel}</span>
        <span class="tarief bm-cijfer">{brandModel.price}</span>
        <span class="mono">{brandModel.unit} · {c.costSetupVat}</span>
      </p>
      <div class="bm-inbegrepen">
        <p class="etiket">{c.costIncludes}</p>
        <ul class="bm-vink" role="list">
          {brandModel.includes.map((f) => <li>{f}</li>)}
        </ul>
        <p class="lopend bm-volgorde">{c.costSequence}</p>
      </div>
    </div>
    <div class="bm-kost-noten">
      <div>
        <h3 class="hoog hoog-3">{c.costMathH}</h3>
        <p class="lopend">{c.costMath}</p>
      </div>
      <div>
        <p class="lopend">{c.costFree}</p>
        <p class="acties"><a class="pijl" href={lp('/pricing')}>{c.costCta}</a></p>
      </div>
    </div>
  </section>

  {/* ── 4 · WAAR HET PAST ────────────────────────────────────────────────── */}
  <section class="kamer bm-kamer" aria-labelledby="bm-past">
    <p class="spook spook-links" aria-hidden="true"><span>{c.eyebrow}</span><span>{c.eyebrow}</span></p>
    <header class="kamer-kop">
      <p class="etiket">{c.fitMeta}</p>
      <h2 id="bm-past" class="hoog hoog-2">{c.fitH}</h2>
      <p class="lopend">{c.fitSub}</p>
    </header>

    <Placeholder
      lang={lang}
      space
      ratio="9 / 2"
      subject={nl ? 'Zes beelden naast elkaar met hetzelfde merkmodel: twee producten uit de webshop, een advertentie, een e-mailheader, een socialpost en een campagnebeeld'
                  : 'Six frames side by side with the same brand model: two webshop products, an ad, an email header, a social post and a campaign image'}
      message={nl
        ? 'Moet bewijzen dat het om één persoon gaat en niet om zes modellen die op elkaar lijken — hetzelfde gezicht moet zó herkenbaar zijn dat je het al ziet voordat je de kaders los bekijkt. Product, kader en kleur mogen per beeld verschillen; alleen het gezicht ligt vast. Dat verschil is de hele boodschap: het merk komt van het gezicht, niet van de set.'
        : 'Must prove this is one person and not six lookalikes — the same face has to be recognisable before you even look at the frames separately. Product, framing and colour may differ per frame; only the face is fixed. That contrast is the whole message: the brand comes from the face, not from the set.'}
    />

    <div class="bm-twee">
      <div class="bm-uitleg">
        <h3 class="hoog hoog-3">{c.fitWhatH}</h3>
        {c.fitWhat.map((p) => <p class="lopend">{p}</p>)}
      </div>
      <aside class="bm-waar">
        <h3 class="hoog hoog-3">{c.fitWhereH}</h3>
        <ul class="bm-waar-lijst" role="list">
          {c.fitWhere.map((w) => <li><b>{w[0]}</b><span class="lopend">{w[1]}</span></li>)}
        </ul>
      </aside>
    </div>
  </section>

  {/* ── 5 · DE RICHTINGEN, EN WAT ERUIT KOMT ────────────────────────────────
      Dit waren twee secties onder elkaar. Ze beantwoorden dezelfde vraag — hoe
      ziet zo'n gezicht eruit — dus delen ze één paneel: eerst waaruit je kunt
      kiezen, dan wat er in het echt uit kwam. */}
  <section class="paneel" aria-labelledby="bm-richting">
    <header class="paneel-kop">
      <h2 id="bm-richting" class="hoog hoog-2">{c.dirH}</h2>
      <p class="lopend">{c.dirLead}</p>
    </header>
    <ul class="bm-richtingen" role="list">
      {directions.map((d) => (
        <li>
          <span class="bm-letter" aria-hidden="true">{d[0]}</span>
          <b>{d[1]}</b>
          <span class="lopend">{d[2]}</span>
        </li>
      ))}
    </ul>

    <h3 class="hoog hoog-3 bm-uit-kop">{c.outH}</h3>
    <ul class="bm-uit" role="list">
      {EXAMPLES.map((photo, i) => (
        <li>
          <span class="kaart kaart-stil">
            <img src={photo.src} alt={`${c.outAlt} ${i + 1}`} loading="lazy" decoding="async" width={photo.w} height={photo.h} />
          </span>
        </li>
      ))}
    </ul>
  </section>

  {/* ── 6 · HOE HET TOT STAND KOMT ───────────────────────────────────────── */}
  <section class="paneel" aria-labelledby="bm-proces">
    <header class="paneel-kop">
      <h2 id="bm-proces" class="hoog hoog-2">{c.procH}</h2>
    </header>
    {/* Vijf stappen als tekst vertellen WAT er gebeurt; dit vlak laat zien hoe
        het eruitziet terwijl het gebeurt. Het staat vóór de stappen: wie het
        proces al herkent hoeft de vijf regels niet meer te lezen. */}
    <Placeholder
      lang={lang}
      ratio="3 / 1"
      subject={nl ? 'Een richtingenblad: drie voorgestelde gezichten naast elkaar, met aantekeningen van de klant erbij en één ervan aangekruist'
                  : 'A directions sheet: three proposed faces side by side, the client’s notes beside them and one of them ticked'}
      message={nl
        ? 'Moet laten zien dat dit een gesprek is en geen bestelknop — er wordt iets voorgelegd, er wordt op gereageerd, er wordt gekozen. De drie gezichten moeten duidelijk verschillen (leeftijd, houding, styling), anders lijkt het een keuze zonder keuze. De aantekeningen mogen onleesbaar zijn; dat er óp het werk geschreven is, is het punt.'
        : 'Must show this is a conversation, not a buy button — something is proposed, responded to, chosen. The three faces have to differ clearly (age, posture, styling), or it reads as a choice without a choice. The notes may be illegible; that someone wrote on the work is the point.'}
    />
    <ol class="bm-stappen">
      {steps.map((s, i) => (
        <li><span class="mono nr">{String(i + 1).padStart(2, '0')}</span><b>{s[0]}</b><span class="lopend">{s[1]}</span></li>
      ))}
    </ol>
  </section>

  {/* ── 7 · WAT JE STUURT, WAT JE KRIJGT ─────────────────────────────────── */}
  <section class="paneel" aria-labelledby="bm-ruil">
    <div class="bm-ruil">
      <div>
        <h2 id="bm-ruil" class="hoog hoog-3">{c.giveH}</h2>
        <ul class="bm-vink" role="list">
          {c.give.map((g) => <li set:html={g[1]} />)}
        </ul>
      </div>
      <div class="bm-krijgt">
        <h2 class="hoog hoog-3">{c.getH}</h2>
        <ul class="bm-vink" role="list">
          {c.get.map((g) => <li set:html={g[1]} />)}
        </ul>
      </div>
    </div>
  </section>

  {/* ── 8 · DE STANDAARDBIBLIOTHEEK ──────────────────────────────────────────
      Een voorproefje van de tien en niet de tien: de volledige lijst staat op
      /models, en ze hier nog een keer zetten geeft twee pagina's met dezelfde
      tien portretten. Deze sectie staat ONDER het betoog over het eigen gezicht
      en niet erboven: de bibliotheek is het alternatief dat je al hebt, en dat
      hardop zeggen is wat het merkmodel een eerlijke upsell maakt.

      Het aanbod "laat ons er een kiezen" is geen eigen tegel maar een regel in
      de noot ernaast — het is een tweede antwoord op dezelfde vraag. */}
  <section class="paneel" id="standard" aria-labelledby="bm-bieb">
    <header class="paneel-kop">
      <p class="etiket">{c.libMeta}</p>
      <h2 id="bm-bieb" class="hoog hoog-2">{c.libH}</h2>
      <p class="lopend">{c.libLead}</p>
    </header>
    <div class="bm-bieb">
      <ul class="bm-rooster" role="list">
        {ROSTER.slice(0, TOONBAAR).map((m) => (
          <li>
            <span class="kaart kaart-stil">
              <img src={m.photo} alt={`${m.name} — ${c.libAlt}`} loading="lazy" decoding="async" width={m.w} height={m.h} />
            </span>
            <b>{m.name}</b>
            <span class="mono">{m.traits.map((t) => c.traits[t]).join(' · ')}</span>
          </li>
        ))}
      </ul>
      <div class="bm-bieb-noot">
        <p class="lopend">{c.libNote}</p>
        <p class="bm-wegen">
          <a class="pijl" href={lp('/models')}>{c.libAllCta}</a>
          <a class="pijl" href={lp('/start/brand-model')}>{c.libOwnCta}</a>
        </p>
      </div>
    </div>
  </section>

  {/* ── 9 · WAAROM GEEN GENERATOR ───────────────────────────────────────────
      Hier stond een vergelijking van twee panelen — "Generieke AI-tool" tegen
      VISUAILS — met een van onze eigen renders onder het label van een
      concurrent en drie tekortkomingen eraan gehangen die niemand gemeten had.
      Dat is een verzonnen resultaat onder de eigen regel van de brief, en
      overbodig: het argument is sterker zonder stropop. /compare draagt de
      toolvergelijking. */}
  <section class="kamer bm-kamer-gen" aria-labelledby="bm-gen">
    <p class="spook spook-rechts" aria-hidden="true"><span>{c.eyebrow}</span><span>{c.eyebrow}</span></p>
    <header class="kamer-kop">
      <h2 id="bm-gen" class="hoog hoog-2">{c.genH}</h2>
    </header>
    <div class="bm-gen">
      {c.genBody.map((p) => <p class="lopend">{p}</p>)}
      <p class="acties"><a class="pijl bm-gen-link" href={lp('/compare#ai-tools')}>{c.genCta}</a></p>
    </div>
  </section>

  {/* ── 10 · HET SLOT ────────────────────────────────────────────────────── */}
  <section class="paneel paneel-slot" aria-labelledby="bm-slot">
    <h2 id="bm-slot" class="hoog">{c.ctaH1}<br /><em>{c.ctaEm}</em></h2>
    <p class="acties">
      <a class="knop knop-inkt" href={lp('/start/brand-model')}>{c.ctaStart}</a>
      <a class="knop knop-lijn" href={lp('/pricing')}>{c.ctaPricing}</a>
      <a class="knop knop-lijn" href={wa} target="_blank" rel="noopener">{c.ctaWaShort}</a>
    </p>
  </section>
</div>

<style>
  .bm-open { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, .92fr); gap: clamp(1.5rem, 5vw, 4rem); align-items: center; }
  .bm-open .paneel-kop { margin-bottom: 0; gap: 1.1rem; }

  /* Zes gedeelde gezichten in een raster van drie bij twee, en ernaast het ene
     dat van jou is — groter, en met het gele etiket. Het verschil in MAAT is
     het argument; de kleur bevestigt het alleen. */
  .bm-cast { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1fr); gap: clamp(.7rem, 2vw, 1.2rem); align-items: end; }
  .bm-muur { display: grid; grid-template-columns: repeat(2, 1fr); gap: .4rem; align-content: end; }
  .bm-muur-vak { border-radius: calc(var(--ronding) - 16px); }
  .bm-muur-vak img { width: 100%; height: 100%; object-fit: cover; opacity: .55; filter: grayscale(1); }
  .bm-muur-etiket, .bm-een-etiket { grid-column: 1 / -1; color: var(--inkt-2); }
  .bm-een { display: grid; gap: .5rem; }
  .bm-een .kaart { aspect-ratio: 3 / 4; }
  .bm-een img { width: 100%; height: 100%; object-fit: cover; }
  .bm-een-etiket { color: var(--inkt); }
  .bm-een-etiket::before { content: ""; display: inline-block; width: 7px; height: 7px; border-radius: 50%; background: var(--geel); margin-right: .5em; translate: 0 -.15em; }
  .bm-cast-onder { grid-column: 1 / -1; margin-top: .4rem; color: var(--inkt-2); text-transform: none; letter-spacing: 0; font-size: .78rem; }

  /* De vier beloften onder elkaar, elk op een eigen regel met een lijn ertussen
     — geen kaartjes. Zie de noot bij `.paneel` in stijl22.css: rand, vulling en
     ronding zeggen "los ding", en dit zijn vier zinnen over één ding. */
  .bm-props { display: grid; }
  .bm-props li { display: grid; grid-template-columns: minmax(0, 20rem) minmax(0, 34rem); align-items: baseline; gap: clamp(1rem, 3vw, 2.5rem); padding: clamp(1.1rem, 2.4vw, 1.8rem) 0; border-top: 1px solid var(--lijn); }
  .bm-props li:last-child { border-bottom: 1px solid var(--lijn); }
  .bm-props b { font-family: var(--kop2); font-weight: 500; font-stretch: 125%; font-size: clamp(1.05rem, 1.8vw, 1.45rem); text-transform: uppercase; letter-spacing: -.01em; }

  .bm-kost { display: grid; grid-template-columns: minmax(0, .7fr) minmax(0, 1fr); gap: clamp(1.5rem, 4vw, 3.5rem); align-items: start; }
  .bm-bedrag { display: grid; gap: .4rem; justify-items: start; }
  .bm-bedrag .mono { color: var(--inkt-2); }
  .bm-cijfer { font-size: clamp(2.4rem, 6vw, 4rem); line-height: .95; }
  .bm-inbegrepen { display: grid; gap: .9rem; }
  .bm-vink { display: grid; gap: .7rem; }
