      ['credit', `<strong>${euro(AMOUNT.brandModel, 'en')} once</strong> ${vatLabel('excl', 'en')}, and nothing after that.`],
    ],

    // STANDARD LIBRARY
    libMeta: '( Or start here )',
    libH: 'The standard library',
    libAlt: 'a VISUAILS standard model',
    /* Drie regels waar er vijf stonden. "Laat ons matchen" was een eigen tegel
       met een eigen kop; het is nu de tweede helft van deze zin, want het is een
