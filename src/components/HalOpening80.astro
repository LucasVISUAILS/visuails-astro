      rustig(() => { if (aan) maakTerug(); });
    }
    /* terug aangekomen: de foto, de pagina los, het podium onder de balk */
    function naarRust() {
      fase = 'rust'; stap = ''; snel = 1; pos = 0; pauzeer(); stopRit();
      naarStil();
      o8.classList.remove('o8-onderweg', 'o8-wit'); standVast(false);
      los(); scrollNaar(top(baan) - balk());
      /* de heen-video alvast terug op 0, nu het rustig is: dan zoekt hij niet als hij weer speelt */
      rustig(() => { if (fase === 'rust' && heen && heen.kan && videoBeeld(heen) !== 0) heen.v.currentTime = 0; });
    }
    /* een sprong (een link naar #maken, de schuifbalk, End): meteen de eindstand, zonder animatie */
    function klaarDirect() {
      clearTimeout(makenTimer); clearTimeout(wachtTimer); pauzeer(); stopRit();
      rit.u = 1; rit.doel = 1; tekenRit(1);
      fase = 'klaar'; stap = ''; snel = 1; los();
      o8.classList.add('o8-onderweg'); standVast(true);
      const ideaal = isMaken ? Math.round(window.scrollY + maken!.getBoundingClientRect().top - balk()) : window.scrollY;
      sKlaar = Math.min(ideaal, window.scrollY);
      openMaken(false);
    }
    function rustDirect() {
      clearTimeout(makenTimer); clearTimeout(wachtTimer); pauzeer(); stopRit();
      naarStil();
      fase = 'rust'; stap = ''; snel = 1; pos = 0; los();
      o8.classList.remove('o8-onderweg', 'o8-wit', 'o8-rijdt'); standVast(false);
      sluitMaken();
    }
    function afmaken() { if (richting === 1) klaarDirect(); else rustDirect(); }

    /* ── het wiel, de toetsen en een vinger ── */
    let laatsteWiel = -1e9;
    function opWiel(e: WheelEvent) {
      if (!aan || e.ctrlKey || e.metaKey) return;
      const dy = e.deltaY * (e.deltaMode === 1 ? 40 : e.deltaMode === 2 ? window.innerHeight : 1);
      const nieuw = e.timeStamp - laatsteWiel > GEBAAR; laatsteWiel = e.timeStamp;
      if (fase === 'speelt') { e.preventDefault(); if (nieuw && Math.abs(dy) >= 1 && Math.abs(dy) >= Math.abs(e.deltaX)) speel(dy > 0 ? 1 : -1); return; }
      if (Math.abs(dy) < 1 || Math.abs(e.deltaX) > Math.abs(dy)) return;
      /* in rust, met het podium al (bijna) onder de balk: deze scroll start hem */
      if (fase === 'rust' && dy > 0) { const s = sNu(); if (s >= -2 && s <= lengte() * 0.5) { e.preventDefault(); speel(1); } return; }
      /* klaar, op de plek van Wat we maken: deze scroll omhoog speelt hem terug */
      if (fase === 'klaar' && dy < 0 && window.scrollY <= sKlaar + 2 && sNu() >= -2) { e.preventDefault(); speel(-1); }
    }
    function opToets(e: KeyboardEvent) {
      if (!aan || fase !== 'speelt' || e.altKey || e.ctrlKey || e.metaKey) return;
      const el = e.target as HTMLElement | null;
      if (el && (el.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(el.tagName))) return;
      const omhoog = TOETS_OMHOOG.has(e.key) || (e.key === ' ' && e.shiftKey), omlaag = !omhoog && TOETS_OMLAAG.has(e.key);
      if (!omhoog && !omlaag) return;
      e.preventDefault(); if (!e.repeat) speel(omlaag ? 1 : -1);
    }
    function opVinger(e: TouchEvent) { if (aan && fase === 'speelt' && e.cancelable) e.preventDefault(); }

    /* de baan: waar sta je, en wat hoort daarbij */
    let raf = 0;
    function bij() {
      raf = 0;
      if (!aan) return;
      const s = sNu();
      if (eerste) { eerste = false; if (s > DREMPEL) { klaarDirect(); return; } }
      if (fase === 'speelt') {
        /* vast: alleen de schuifbalk kan nog scrollen; een klein stukje zetten we terug, een grote sleep maakt hem af */
        if (vastY >= 0) { const d = window.scrollY - vastY; if (Math.abs(d) > SLEEP) afmaken(); else if (Math.abs(d) > 1) scrollNaar(vastY); }
        return;
      }
      if (fase === 'rust') { if (s > lengte() * 0.5) klaarDirect(); else if (s > DREMPEL) speel(1); return; }
      if (fase === 'klaar') { if (s < -2) rustDirect(); else if (window.scrollY < sKlaar - DREMPEL) speel(-1); }
    }
    const opScroll = () => { if (!raf) raf = requestAnimationFrame(bij); };
    /* voor de toetsen (tests/opening-89-browser.test.mjs): waar de animatie staat */
    (window as any).__o8Stand = () => ({ fase, richting, stap, pos, snel, rit: rit.u, getekend, metro: soort, sKlaar, vast: vastY,
      schuif: (schuifBij(getekend) || [0])[0], ritBeeld: ritBeeld(), ritVeeg, beeld: videoBeeld(heen), zoekTel,
      zoekt: !!(speler()?.v.seeking), kanSpelen: !!heen?.kan, terugKlaar: !!terug?.kan, gepauzeerd: heen ? heen.v.paused : null, snelheid: heen ? heen.v.playbackRate : null,
      klaar: heen ? heen.v.readyState : null, src: heen ? heen.v.currentSrc : '', tempo: tempo.slice(0, METRO_BEELD) });

    function meet() {
      aan = kanHet();
      html.classList.toggle('o8-aan', aan);
      zetSchermen();
      if (aan) { opScroll(); return; }
      clearTimeout(makenTimer); clearTimeout(wachtTimer); pauzeer(); stopRit(); naarStil(); laden.hidden = true; los();
      fase = 'rust'; stap = '';
      o8.classList.remove('o8-onderweg', 'o8-wit', 'o8-rijdt'); standVast(false);
      if (isMaken && maken!.classList.contains('m8-dicht') && !onderHetScherm()) openMaken(false);
    }
    let rt = 0;
    const opResize = () => { clearTimeout(rt); rt = window.setTimeout(meet, 120); };
    const opMq = () => { stil = mq.matches; if (stil) standStil(); meet(); };
    window.addEventListener('scroll', opScroll, { passive: true });
    /* vóór zacht scrollen (src/scripts/zachtscrollen.js, op window zonder capture): wat hier wordt afgevangen, scrolt daar niet */
    window.addEventListener('wheel', opWiel, { passive: false, capture: true });
    window.addEventListener('keydown', opToets, { capture: true });
    window.addEventListener('resize', opResize);
    mq.addEventListener?.('change', opMq);
    meet();
    const beeld = $<HTMLImageElement>('[data-o8-beeld]');
    if (!beeld.complete) beeld.addEventListener('load', () => { if (o8.isConnected) zetSchermen(); }, { once: true });
    /* de video vast laden zodra de pagina rustig is (alleen als het effect kan) */
    const vooruit = () => { if (aan && o8.isConnected) { maakHeen(); doekKlaar(); } };
    const rustF = (window as any).requestIdleCallback as undefined | ((f: () => void, o?: { timeout: number }) => number);
    const begin = () => (rustF ? rustF(vooruit, { timeout: 3000 }) : window.setTimeout(vooruit, 1200));
