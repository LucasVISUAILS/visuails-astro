    /* voor de toetsen (tests/opening-90-browser.test.mjs): waar de animatie staat */
    (window as any).__o8Stand = () => {
      const sp = speler();
      return { fase, richting, stap, snel, vast: vastY, eindZonderVideo, s: Math.round(sNu()),
        beeld: sp ? orig(sp, beeldVan(sp)) : 0, kanSpelen: !!heen?.kan, terugKlaar: !!terug?.kan,
        gepauzeerd: sp ? sp.v.paused : null, snelheid: sp ? sp.v.playbackRate : null, breedte: heen?.b ?? null,
        src: heen ? heen.v.currentSrc : '', zichtbaar: [heen, terug].filter((x) => x && !x.v.hidden).map((x) => (x!.terug ? 'terug' : 'heen')),
        fotoWeg: o8.classList.contains('o8-speelt'), winkelUit: o8.classList.contains('o8-winkel-uit') };
    };

    function meet() {
      aan = kanHet();
      html.classList.toggle('o8-aan', aan);
      zetSchermen();
      if (aan) { opScroll(); return; }
      rustDirect(); laden.hidden = true;
      if (isMaken && maken!.classList.contains('m8-dicht') && !onderHetScherm()) openMaken();
    }
    let rt = 0;
    const opResize = () => { clearTimeout(rt); rt = window.setTimeout(meet, 120); };
    const opMq = () => { stil = mq.matches; if (stil) standStil(); meet(); };
    window.addEventListener('scroll', opScroll, { passive: true });
    /* vóór zacht scrollen (src/scripts/zachtscrollen.js, op window zonder capture): wat hier wordt afgevangen, scrolt daar niet */
    window.addEventListener('wheel', opWiel, { passive: false, capture: true });
    window.addEventListener('keydown', opToets, { capture: true });
    window.addEventListener('resize', opResize);
    mq.addEventListener?.('change', opMq);
    meet();
    /* de foto kan een andere breedte krijgen (de browser kiest uit srcset): dan de schermen opnieuw */
    beeld.addEventListener('load', () => { if (o8.isConnected) zetSchermen(); });
    /* de video vast laden zodra de pagina rustig is (alleen als het effect kan) */
    const vooruit = () => { if (aan && o8.isConnected) maakHeen(); };
    const rustF = (window as any).requestIdleCallback as undefined | ((f: () => void, o?: { timeout: number }) => number);
    const begin = () => (rustF ? rustF(vooruit, { timeout: 3000 }) : window.setTimeout(vooruit, 1200));
    if (document.readyState === 'complete') begin(); else window.addEventListener('load', begin, { once: true });

    ruim = () => {
      window.removeEventListener('scroll', opScroll);
      window.removeEventListener('wheel', opWiel, { capture: true } as EventListenerOptions);
      window.removeEventListener('keydown', opToets, { capture: true } as EventListenerOptions);
      window.removeEventListener('touchmove', opVinger);
      window.removeEventListener('resize', opResize);
      mq.removeEventListener?.('change', opMq);
      opgeruimd = true; aan = false; binnenhalen.abort();
      cancelAnimationFrame(raf); clearTimeout(rt); clearTimeout(wachtTimer); clearTimeout(uitTimer); clearTimeout(vervaagTimer); clearTimeout(wisselTimer);
      pauzeer(); standOpruim(); makenIo?.disconnect(); nietMeerInDeBuurt();
      for (const sp of [heen, terug]) { if (!sp) continue; if (sp.blob) URL.revokeObjectURL(sp.blob); sp.v.removeAttribute('src'); sp.v.load(); sp.v.remove(); }
      heen = null; terug = null;
      html.classList.remove('o8-aan');
      delete o8.dataset.o8Klaar; delete (window as any).__o8Stand;
      ruim = null;
    };
  }

  start();
  document.addEventListener('astro:page-load', start);
  document.addEventListener('astro:before-swap', () => ruim?.());
</script>
