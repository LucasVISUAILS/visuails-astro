    }
    /* aangekomen: alles wit. Wat we maken met zijn bovenkant onder de balk (alles is wit, dus de sprong zie je niet) */
    function naarKlaar() {
      fase = 'klaar'; stap = ''; snel = 1; pauzeer();
      sKlaar = isMaken ? Math.round(window.scrollY + maken!.getBoundingClientRect().top - balk()) : window.scrollY;
      los(); scrollNaar(sKlaar);
