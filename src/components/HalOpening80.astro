    }
    function keer() {
      if (stap === 'rit') {
        richting = richting === 1 ? -1 : 1; snel = 1;
        if (richting === -1) { dichtMaken(); bereidTerug(); }
        zetRit(richting === 1 ? 1 : 0);
        return;
      }
      if (stap === 'maken') { clearTimeout(makenTimer); richting = 1; snel = 1; naarKlaar(); return; }
      /* heen wachtte nog op de video: terug naar rust, de pagina los */
      if (stap === 'wacht' && richting === 1) { rustDirect(); return; }
      if (stap === 'video' || stap === 'wacht') {
        /* van richting wisselen in de video kan alleen als de andere video er is (anders speelt hij door) */
        const ander = richting === 1 ? terug : heen;
        if (!ander || !ander.kan) return;
        pauzeer(); richting = richting === 1 ? -1 : 1; snel = 1;
        speelVideo();
      }
    }
    /* de video's klaarzetten voor terug: heen op het beeld van het vertrek (de rit leest eruit), terug op 110 − dat beeld */
    function bereidTerug() {
      const h = maakHeen();
      if (h.kan && videoBeeld(h) < METRO_BEELD) { h.v.currentTime = (METRO_BEELD + 0.5) / fps; rit.van = METRO_BEELD; }
      if (getekend < 0 && h.kan && doekKlaar()) {
        const zet = () => { if (fase === 'speelt' && richting === -1) { tekenaar!.bron(h.v); teken(videoBeeld(h)); } };
        if (h.v.seeking) h.v.addEventListener('seeked', zet, { once: true }); else zet();
