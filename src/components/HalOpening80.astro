      doelScroll = s <= 8 ? 0 : metroAan ? Math.min(METRO_BEELD, beeldBij(q)) : beeldBij(q);
      doelBeeld = videoDoel();
      laden.hidden = !(onderweg && video && !kanSpelen);
      stuur();
      /* de metro: vertrekt waar de video ophoudt, rijdt terug als je terug scrolt; scrol je ver voor hem uit, dan haalt hij in */
      if (metroAan) {
        const van = R * METRO_VIDEO * (loop[METRO_BEELD] ?? 0.88);
        if (s >= van - 1) zetRit(1); else if (s < van - METRO_TERUG) zetRit(0);
        rit.tempo = 1 + 1.5 * Math.max(0, Math.min(1, (s - van - R * METRO_INHALEN) / (R * 0.1)));
        if (metroAan) return;
      }
      /* het wit langs de snede */
      const t = Math.max(0, Math.min(1, (s - R * DEEL.veegVan) / (R * (DEEL.veegTot - DEEL.veegVan))));
      rand = rand * 0.8 + (RAND + Math.min(RAND_EXTRA, snel * 0.12)) * 0.2;
      veeg.style.setProperty('--o8-e', `calc(${((1 - t) * 100).toFixed(3)}% + ${((1 - t) * (rand + 4) - t * 4).toFixed(1)}px)`);
      veeg.style.setProperty('--o8-z', `${rand.toFixed(1)}px`);
      o8.classList.toggle('o8-veegt', t > 0 && t < 1);
      o8.classList.toggle('o8-wit', t >= 1);
      /* de rand loopt nog even uit als je stopt met scrollen */
      if (snel > 2 && t > 0 && t < 1 && !raf) raf = requestAnimationFrame(bij);
    }
    const opScroll = () => { if (!raf) raf = requestAnimationFrame(bij); };
    /* voor de toetsen (tests/opening-88-browser.test.mjs): waar de animatie staat */
    (window as any).__o8Stand = () => ({ rit: rit.u, metro: metroAan ? soort : '', doel: doelBeeld, getekend,
      /* levering 88b: hoe ver het doek de laptop nu schuift (breukdeel van de breedte), en het beeld waar de rit hem wil */
      schuif: (schuifBij(getekend) || [0])[0], ritBeeld: ritBeeld(), ritVeeg, beeld: videoBeeld(), zoekt, kanSpelen, gepauzeerd: video ? video.paused : null, snelheid: video ? video.playbackRate : null, klaar: video ? video.readyState : null, src: video ? video.currentSrc : '' });

    function meet() {
      aan = kanHet();
      html.classList.toggle('o8-aan', aan);
      zetSchermen();
      if (aan) { opScroll(); return; }
      video?.pause(); naarStil(); laden.hidden = true;
      onderweg = false;
      o8.classList.remove('o8-onderweg', 'o8-veegt', 'o8-wit'); standVast(false); stopRit();
    }
    let rt = 0;
    const opResize = () => { clearTimeout(rt); rt = window.setTimeout(meet, 120); };
    const opMq = () => { stil = mq.matches; if (stil) standStil(); meet(); };
    window.addEventListener('scroll', opScroll, { passive: true });
    window.addEventListener('resize', opResize);
    mq.addEventListener?.('change', opMq);
    meet();
    const beeld = $<HTMLImageElement>('[data-o8-beeld]');
    if (!beeld.complete) beeld.addEventListener('load', () => { if (o8.isConnected) zetSchermen(); }, { once: true });
    /* de video vast laden zodra de pagina rustig is (alleen als het effect kan) */
    const vooruit = () => { if (aan && o8.isConnected) { maakVideo(); doekKlaar(); } };
    const rustF = (window as any).requestIdleCallback as undefined | ((f: () => void, o?: { timeout: number }) => number);
    const begin = () => (rustF ? rustF(vooruit, { timeout: 3000 }) : window.setTimeout(vooruit, 1200));
    if (document.readyState === 'complete') begin(); else window.addEventListener('load', begin, { once: true });

    ruim = () => {
      window.removeEventListener('scroll', opScroll);
      window.removeEventListener('resize', opResize);
      mq.removeEventListener?.('change', opMq);
      opgeruimd = true; aan = false; binnenhalen.abort();
      cancelAnimationFrame(raf); clearTimeout(rustTimer); clearTimeout(rt);
      if (video && tekenId) (video as any).cancelVideoFrameCallback?.(tekenId);
      standOpruim(); tekenaar?.weg(); video?.pause(); makenIo?.disconnect(); stopRit(); metro?.weg(); metro = null;
      if (blobUrl) URL.revokeObjectURL(blobUrl);
      if (video) { video.removeAttribute('src'); video.load(); video = null; }
      html.classList.remove('o8-aan');
      delete o8.dataset.o8Klaar; delete (window as any).__o8Beelden; delete (window as any).__o8Stand;
      ruim = null;
    };
  }

  start();
  document.addEventListener('astro:page-load', start);
  document.addEventListener('astro:before-swap', () => ruim?.());
</script>
