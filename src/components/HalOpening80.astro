    }
    function afmaken() { if (richting === 1) klaarDirect(); else rustDirect(); }
    function opgeven() { if (kapot) return; kapot = true; laden.hidden = true; if (fase === 'speelt') rustDirect(); }

    /* ── het wiel, de toetsen en een vinger ── */
    let laatsteWiel = -1e9;
    function opWiel(e: WheelEvent) {
      if (!aan || kapot || e.ctrlKey || e.metaKey) return;
