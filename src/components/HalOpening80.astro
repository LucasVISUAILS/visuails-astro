    function vast() { vastY = window.scrollY; (window as any).__visZachtStop?.(); window.addEventListener('touchmove', opVinger, { passive: false }); }
    function los() { vastY = -1; window.removeEventListener('touchmove', opVinger); }

    /* ── heen en terug ── */
    function speel(r: 1 | -1) {
