        inDeBuurt(() => opBeeld(h, laatste, () => { if (fase === 'klaar' && heen === h) { toonAlleen(h); fotoWeg(); o8.classList.add('o8-winkel-uit'); } }));
      } else { o8.classList.remove('o8-onderweg'); standVast(false); }
    }
    function rustDirect() {
      clearTimeout(wachtTimer); clearTimeout(uitTimer); clearTimeout(vervaagTimer); clearTimeout(wisselTimer); pauzeer(); los(); nietMeerInDeBuurt();
      fase = 'rust'; stap = ''; snel = 1; eindZonderVideo = false; laden.hidden = true;
      fotoTerug();
      o8.classList.remove('o8-winkel-uit', 'o8-onderweg'); standVast(false);
