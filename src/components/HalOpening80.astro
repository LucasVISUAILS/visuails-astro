      if (terug && terug.kan) speelVideo(); else vervaag();
    }
    /* zonder omgekeerde video: de laptop vervaagt naar de foto (die eronder al klaar staat) */
    function vervaag() {
      stap = 'video';
      o8.classList.remove('o8-speelt');
      doek.style.transition = `opacity ${VERVAAG}ms cubic-bezier(.4, 0, .2, 1)`;
      requestAnimationFrame(() => { doek.style.opacity = '0'; });
