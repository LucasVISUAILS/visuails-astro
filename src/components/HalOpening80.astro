      if (fase === 'speelt') { e.preventDefault(); if (nieuw && Math.abs(dy) >= 1 && Math.abs(dy) >= Math.abs(e.deltaX)) speel(dy > 0 ? 1 : -1); return; }
      if (Math.abs(dy) < 1 || Math.abs(e.deltaX) > Math.abs(dy)) return;
      const s = sNu(), Z = rustLengte();
      /* in rust, met het podium (bijna) onder de balk, of deze tik brengt hem erin: deze scroll start hem */
      if (fase === 'rust' && dy > 0) { if ((s >= -2 && s <= Z) || (s < -2 && s + dy > 0)) { e.preventDefault(); speel(1); } return; }
      /* klaar, met het podium weer helemaal in beeld (Wat we maken eronder weg): deze scroll omhoog speelt hem terug */
      if (fase === 'klaar' && dy < 0 && s >= -2 && s <= Z + 2) { e.preventDefault(); speel(-1); }
    }
    function opToets(e: KeyboardEvent) {
      if (!aan || kapot || fase !== 'speelt' || e.altKey || e.ctrlKey || e.metaKey) return;
      const el = e.target as HTMLElement | null;
      if (el && (el.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(el.tagName))) return;
      const omhoog = TOETS_OMHOOG.has(e.key) || (e.key === ' ' && e.shiftKey), omlaag = !omhoog && TOETS_OMLAAG.has(e.key);
      if (!omhoog && !omlaag) return;
      e.preventDefault(); if (!e.repeat) speel(omlaag ? 1 : -1);
    }
    function opVinger(e: TouchEvent) { if (aan && fase === 'speelt' && e.cancelable) e.preventDefault(); }

    /* de baan: waar sta je, en wat hoort daarbij */
    let raf = 0;
    function bij() {
      raf = 0;
      if (!aan || kapot) return;
      const s = sNu(), Z = rustLengte(), L = lengte();
      if (eerste) { eerste = false; if (s > DREMPEL) { klaarDirect(); return; } }
      if (fase === 'speelt') {
        /* vast: alleen de schuifbalk kan nog scrollen; een klein stukje zetten we terug, een grote sleep maakt hem af */
        if (vastY >= 0) { const d = window.scrollY - vastY; if (Math.abs(d) > SLEEP) afmaken(); else if (Math.abs(d) > 1) scrollNaar(vastY); }
        return;
      }
      /* in rust: ver voorbij gesprongen is meteen klaar; een klein stukje de baan in (toetsen, schuifbalk) speelt hem */
      if (fase === 'rust') { if (s > Math.max(Z, L * 0.5)) klaarDirect(); else if (s > DREMPEL) speel(1); return; }
      /* klaar: helemaal boven het podium is meteen rust; met de toetsen of de schuifbalk de rustzone in speelt hem terug */
      if (fase === 'klaar') {
        if (s > Z + DREMPEL) uitZone = true;
        if (s < -Math.max(DREMPEL, window.innerHeight * 0.5)) rustDirect();
        /* (alleen als je eerst verder was: net na de video sta je zelf in de rustzone) */
