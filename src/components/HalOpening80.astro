---
/**
 * VISUAILS — de opening van de voorpagina in rust (levering 80, 1 november 2026).
 * ═══════════════════════════════════════════════════════════════════════════════
 *
 * Lucas, 17:05: "Ik wil de homepage zoals in de foto: eerst groot tekst van wat VISUAILS is en daaronder
 * al licht de laptop in beeld" (lijst 64: gecentreerd zoals zijn voorbeeld, voor nu zonder model) … "1x omlaag
 * scrollen wanneer de laptop volledig in beeld is en de hele animatie speelt zich af in de golvende lijn
 * beweging." Zijn antwoorden (17:13): twee stappen, de winkel klapt mee, de preloader alleen als nodig.
 * Vervangt HalLaptopBreed.astro (79). Alle maten: docs/RUST-80.md en opening-80.css.
 *
 * LEVERING 87 (4 november 2026, lijst 74). Lucas: "de fade begint met wit en gaat naar blue hour" (F2), "de dias in de
 * laptop doorklikken door een hele minimalistic klik systeem onder de laptop … geen blok eromheen" (K1: drie strepen),
 * de kop iets lager met genoeg ruimte eromheen, de arm van de telefoon aan de zijkant (de foto en de video op 120,5 %),
 * en: "op de eerste sectie geen scroll effect met de snappy scroll … je scrollt dus normaal naar de laptop waarna de
 * laptop sectie sticky is en als je door scrollt je de animatie van de laptop krijgt en je het motion blur effect krijgt
 * tot de sectie wit is en de services komen. Het motion blur effect moet overigens kort en subtiel zijn."
 *
 * WAT ER GEBEURT (computer met een muis of trackpad, ≥ 1100 px, met beweging; html.o8-aan)
 *   laden     de titel, de zin, de knoppen en de feiten in het midden tussen de balk en de klep, iets lager dan het
 *             midden; onderaan steekt de klep het beeld in. Niets beweegt.
 *   scrollen  gewoon, tot het podium onder de balk staat. Dan blijft het staan (sticky) en speelt het scrollen de video:
 *             elke centimeter evenveel beweging (loop in laptopVideo.json), terug scrollen speelt hem terug. Als de
 *             laptop links en de telefoon rechts het beeld uit gaan, trekken ze een kort spoor (de bewegingsonscherpte
 *             in laptopdoek.js, naar hoe snel ze schuiven en hoe snel je scrolt). Tegelijk veegt het wit langs de snede
 *             (53°) het blauwe uur weg, met een zachte rand die breder wordt als je sneller scrolt. Als alles wit is,
 *             schuift Wat we maken over het witte podium omhoog (maken-80.css) en scrolt de pagina daarna gewoon.
 *   de strepen onder de laptop: de winkel, het bericht, de clip. De streep die loopt is de tijd; klikken of de pijltjes
 *             wisselen. Pas na de eerste beweging van de bezoeker lopen ze.
 *
 * ZONDER SCRIPT, ZONDER WEBGL, BIJ MINDER BEWEGING, OP DE TELEFOON EN DE TABLET: alles staat stil onder
 * elkaar; de laptop staat open met de winkel erop, en Wat we maken volgt gewoon.
 */
import '../styles/opening-80.css';
import { openingStanden, openingVersie } from '../data/openingStanden.js';
import { laptopReeks } from '../data/laptopSlides.js';
import { IKOON } from '../data/iconen.js';
import VIDEO from '../data/laptopVideo.json';
import { createHash } from 'node:crypto';
import { existsSync, readFileSync } from 'node:fs';
import path from 'node:path';

interface Props {
  lang: 'en' | 'nl';
  kop: [string, string];
  zin: string;
  feiten?: string[];
  knop: { label: string; href: string; attrs?: Record<string, string> };
  link: { label: string; href: string };
  /* lijst 64, knoppen: "een ingelogde klant [ziet] andere knoppen en soms ook tekst". Wie al bestelde
     krijgt in plaats van de proef de link naar Studio (data-vis-uit / data-vis-klant-in, interactions.js). */
  klantLink?: { label: string; href: string };
  /* lijst 76: welke metro (n1 zakken, n2 strepen, n3 lamellen; leeg = de veeg van levering 87). Lucas koos n3. */
  metro?: string;
}
const { lang, kop, zin, feiten = [], knop, link, klantLink, metro = 'n3' } = Astro.props as Props;
const nl = lang === 'nl';

/* De standen: één per dienst (lijst 64, A7 advies a): de winkel, het Instagram-bericht, de clip. */
const alle = openingStanden(lang);
const standen = ['catalog', 'lifestyle', 'video'].map((s) => alle.find((x) => x.set === s)).filter(Boolean) as typeof alle;
const [cat, life, vid] = laptopReeks(lang);
const SET: Record<string, string> = { catalog: cat.naam, lifestyle: life.naam, video: vid.naam };
const eerste = standen[0] ?? { lap: `/img/hal/opening/scherm-${lang}-laptop`, tel: '/img/hal/opening/scherm-telefoon', set: 'catalog', duur: 0 };
const V = openingVersie();
const mv = (u: string) => `${u}?v=${V}`;

/* De foto van de laptop in beeld 0 (dezelfde als in 79: de video is van deze foto gemaakt) */
const MATEN = [960, 1440, 1920, 2560, 3200, 3840, 4608];
/* levering 87: de foto staat op 120,5 % (opening-80.css, --o8-fw), dus de browser moet een bestand voor 120,5 vw kiezen */
const SIZES = '(max-width: 900px) 160vw, 120.5vw';
const set = (ext: string) => MATEN.map((w) => `${mv(`/img/hal/breed/laptop-${w}.${ext}`)} ${w}w`).join(', ');

/* De schermen van de stilstaande foto, in breukdelen van het beeld (gemeten uit de foto zelf, scripts/laptop-video-na.py:
   zijn gaten zijn 2 tot 3 beeldpunten ruimer dan beeld 0 van de video; levering 84). De stilstaande schermen
   krijgen een matrix3d in px van een vak van 1000 × 1000 dat de css schaalt (het script zet de echte). */
const STIL = ((VIDEO as { stil?: number[][][] }).stil ?? VIDEO.schermen[0]) as number[][][];
/* de video begint onder de lege bovenkant (scripts/laptop-video.mjs): het canvas ook */
const BOVEN = ((VIDEO as { boven?: number }).boven ?? 0) / VIDEO.h;
const DOEK = `top:${(BOVEN * 100).toFixed(4)}%;height:${((1 - BOVEN) * 100).toFixed(4)}%`;
const [Q_LAP, Q_FON] = STIL as [number[][], number[][]];
const pct = (q: number[][]) => {
  const xs = q.map((p) => p[0]), ys = q.map((p) => p[1]);
  return `left:${(Math.min(...xs) * 100).toFixed(3)}%;top:${(Math.min(...ys) * 100).toFixed(3)}%;width:${((Math.max(...xs) - Math.min(...xs)) * 100).toFixed(3)}%;height:${((Math.max(...ys) - Math.min(...ys)) * 100).toFixed(3)}%`;
};

const T = nl
  ? { groep: 'De voorbeeldschermen', pauze: 'Zet de beelden stil', speel: 'Laat de beelden lopen',
      laptop: 'Twee handen houden een laptop met de webshop van een merk en een telefoon met de telefoonfoto van hetzelfde product', laden: 'De video laadt' }
  : { groep: 'The example screens', pauze: 'Pause the images', speel: 'Play the images',
      laptop: 'Two hands hold a laptop showing a brand’s web shop and a phone with the phone photo of the same product', laden: 'The video is loading' };
const VIDEO_MATEN = [1280, 1920, 2400];
/* het teken achter de video: verandert de video, dan haalt elke browser hem opnieuw (public/_headers laat
   /img/* zeven dagen staan; zoals openingVersie voor de beelden) */
const vh = createHash('sha1');
for (const b of VIDEO_MATEN) for (const ext of ['mp4', 'webm']) {
  const f = path.join(process.cwd(), 'public', 'img', 'hal', 'laptop-video', `laptop-84-${b}.${ext}`);
  if (existsSync(f)) vh.update(readFileSync(f));
}
const VIDEO_V = vh.digest('hex').slice(0, 10);
---
<script is:inline>
  /* Het effect staat er vanaf het eerste beeld (dan verspringt er niets): o8-aan als het kan. Het script
     hieronder haalt hem weg als WebGL of de video ontbreekt. */
  (function () { try { if (innerWidth >= 1100 && matchMedia('(pointer: fine)').matches && !matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('o8-aan'); } catch (e) { /* dan zet het script het */ } })();
</script>
<section class:list={['o8', { 'o8-metro-aan': !!metro }]} data-o8 data-o-v={V} data-video-v={VIDEO_V} data-stand={eerste.set} data-metro={metro} aria-labelledby="h-h1">
  <div class="o8-held">
    <div class="o8-tekst">
      <h1 id="h-h1" class="o8-kop h-kop" aria-label={kop.join(' ')}>
        <span class="o8-r" aria-hidden="true">{kop[0]}</span><span class="o8-r" aria-hidden="true">{kop[1]}</span>
      </h1>
      <p class="o8-zin">{zin}</p>
      <p class="o8-acties">
        <a class="h-knop h-knop-inkt" href={knop.href} {...(knop.attrs || {})}><span data-vis-label>{knop.label}</span><span class="o"><svg class="ik" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill-rule="evenodd" d={IKOON.pijl} /></svg></span></a>
        <a class="h-link" href={link.href} data-vis-uit>{link.label}</a>
        {klantLink && <a class="h-link" href={klantLink.href} data-vis-klant-in hidden>{klantLink.label}</a>}
      </p>
      {feiten.length > 0 && <ul class="o8-feiten" role="list">{feiten.map((f) => <li set:html={f} />)}</ul>}
    </div>
  </div>

  {/* de baan (levering 87): zo lang als het scrollen door de animatie duurt; het podium blijft erin staan (sticky) */}
  <div class="o8-baan" data-o8-baan>
  <div class="o8-podium" data-o8-podium>
    <span class="o8-vlak" aria-hidden="true"></span>
    {/* het wit dat langs de snede (53°) het blauwe uur wegveegt aan het eind van de animatie */}
    <span class="o8-veeg" data-o8-veeg aria-hidden="true"></span>
    {/* lijst 76: het blauwe uur dat naar beneden wegrijdt, de metro (src/scripts/metro.js); alleen tijdens de rit zichtbaar */}
    <canvas class="o8-metro" data-o8-metro aria-hidden="true" hidden></canvas>
    <div class="o8-foto" data-o8-foto>
      <div class="o8-sc o8-lap" data-o8-lap aria-hidden="true" style={pct(Q_LAP)}>
        <picture class="o8-st is-nu" data-o8-st-lap="0">
          <source type="image/avif" srcset={mv(`${eerste.lap}.avif`)} />
          <img src={mv(`${eerste.lap}.webp`)} width="1600" height="1034" alt="" decoding="async" />
        </picture>
      </div>
      <div class="o8-sc o8-fon" data-o8-fon aria-hidden="true" style={pct(Q_FON)}>
        <picture class="o8-st is-nu" data-o8-st-fon={eerste.tel}>
          <source type="image/avif" srcset={mv(`${eerste.tel}.avif`)} />
          <img src={mv(`${eerste.tel}.webp`)} width="540" height="1170" alt="" decoding="async" />
        </picture>
      </div>
      <picture>
        <source type="image/avif" srcset={set('avif')} sizes={SIZES} />
        <img class="o8-beeld" data-o8-beeld src={mv('/img/hal/breed/laptop-1920.webp')} srcset={set('webp')} sizes={SIZES}
             width="2944" height="1248" decoding="async" alt={T.laptop} />
      </picture>
      <canvas class="o8-doek" data-o8-doek aria-hidden="true" hidden style={DOEK}></canvas>
      {/* het vlagje vult zich met de snede van het logo (levering 86, D8; de fade #vs-v-snede staat in de sprite van Layout.astro) */}
      <span class="o8-laden" data-o8-laden role="img" aria-label={T.laden} hidden>
        <svg viewBox="0 0 702 813.25" aria-hidden="true"><path fill="var(--h-inkt)" opacity=".18" d="M 0.0 16.0 L 144.25 266.75 L 463.25 813.25 L 662.75 354.75 L 619.25 408.25 L 515.5 546.25 L 264.5 119.0 A 201.21 201.21 0 0 0 101.0 15.75 L 0.0 16.0 Z"/><path fill="var(--h-inkt)" opacity=".18" d="M 701.75 0.0 L 543.25 366.25 L 507.25 453.75 L 652.0 259.25 L 702.0 338.25 L 701.75 0.0 Z"/><clipPath id="o8-vlag"><rect data-o8-vul x="0" y="813.25" width="702" height="0" /></clipPath><path fill="url(#vs-v-snede)" clip-path="url(#o8-vlag)" d="M 701.75 0.0 L 543.25 366.25 L 507.25 453.75 L 652.0 259.25 L 702.0 338.25 L 701.75 0.0 Z"/></svg>
      </span>
    </div>
    {standen.length > 1 && (
      /* K1 (lijst 74): drie strepen, de naam van de set in mono en de pauzeknop, zonder blok eromheen. De streep die
         loopt is de tijd van de stand; klikken of de pijltjes wisselen. */
      <div class="o8-stand" role="group" aria-label={T.groep} data-o8-stand>
        <div class="o8-strepen" data-o8-strepen>
          {standen.map((s, i) => (
            <button type="button" class="o8-kies" data-o8-kies={i} aria-pressed={i === 0 ? 'true' : 'false'} aria-label={SET[s.set]} tabindex={i === 0 ? 0 : -1}><span class="o8-k-streep" aria-hidden="true"><i></i></span></button>
          ))}
        </div>
        <p class="o8-stand-naam" data-o8-naam aria-hidden="true">{SET[eerste.set]}</p>
        <button type="button" class="o8-pauze" data-o8-pauze aria-pressed="false" aria-label={T.pauze} data-uit={T.pauze} data-aan={T.speel}><svg class="ik" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path class="o8-p-uit" fill-rule="evenodd" d={IKOON.pauze} /><path class="ik-m" d={IKOON['pauze-m']} /><path class="o8-p-aan" fill-rule="evenodd" d={IKOON.afspelen} /></svg></button>
      </div>
    )}
    <script type="application/json" data-o8-data set:html={JSON.stringify({
      standen: standen.map((s) => ({ set: s.set, duur: s.duur, lap: s.lap, tel: s.tel })), sets: SET,
      video: { maten: VIDEO_MATEN, fps: VIDEO.fps, beelden: VIDEO.beelden, b: VIDEO.b, h: VIDEO.h, boven: (VIDEO as { boven?: number }).boven ?? 0, stil: STIL, schermen: VIDEO.schermen, vaart: (VIDEO as { vaart?: number[] }).vaart ?? [], loop: (VIDEO as { loop?: number[] }).loop ?? [] },
    })} />
  </div>
  </div>
</section>

<script>
  import { maakDoek, cssMatrix, RUIMER } from '../scripts/laptopdoek.js';
  import { maakMetro, SOORTEN, SLUIT } from '../scripts/metro.js';
  type Stand = { set: string; duur: number; lap: string; tel: string };
  type Q = number[][] | null;
  type Data = { standen: Stand[]; sets: Record<string, string>; video: { maten: number[]; fps: number; beelden: number; b: number; h: number; boven: number; stil: [Q, Q]; schermen: [Q, Q][]; vaart: number[]; loop: number[] } };

  /* ── DE BAAN (levering 87) ──────────────────────────────────────────────────────────────────────────────────────
     Het podium staat stil (sticky) zolang je door de baan scrolt; s is hoe ver, R de lengte (opening-80.css, --o8-R).
     In breukdelen van R:
       0     – .625  de video, beeld voor beeld (de loop: elke centimeter evenveel beweging)
       .44   – .66   het wit veegt langs de snede het blauwe uur weg, terwijl de laptop en de telefoon het beeld uit gaan
       .66   – 1     alles wit; vanaf .656 schuift Wat we maken over het podium omhoog (--o8-O in opening-80.css)
     Terug scrollen doet alles terug. */
  const DEEL = { video: 0.625, veegVan: 0.44, veegTot: 0.66 };
  /* de video loopt naar het beeld dat bij de scroll hoort: vooruit speelt hij (zo snel dat hij in ± 0,16 s bij is),
     achteruit of een grote sprong zoekt hij (de video heeft elke 6 beelden een sleutelbeeld, scripts/laptop-video.mjs) */
  const BIJ = 0.16, SPRONG = 14, MAX_SNEL = 8;
  /* levering 87, na de controle: een paar beelden vooruit zoeken in plaats van spelen (spelen op hoge snelheid schiet
     voorbij het doel, want het beeld dat hem moet stoppen komt pas een tik later) */
  const DICHTBIJ = 3;
  /* de bewegingsonscherpte: de helft van de afstand die het beeld aflegt sinds het vorige getekende beeld, hoogstens 3 %
     van de breedte (Lucas: "kort en subtiel ... niet te heftig") */
  const VEEG_DEEL = 0.5;
  /* de rand van het wit: 56 px, en breder als je sneller scrolt (hoogstens 56 + 200 px) */
  const RAND = 56, RAND_EXTRA = 200;
  /* ── DE METRO (lijst 76) ────────────────────────────────────────────────────────────────────────────────────────
     Lucas: "een soort metro gevoel met de motion blur … alsof het blauwe weg racet smooth naar het witte waarna de service
     omhoog komen." En om 12:13: "naar beneden … niet van de zijkant." Lijst 76: N3 (lamellen), vanzelf. Om 16:05: "De metro
     animatie mag ongeveer tegelijkertijd met de laptop verdwijnen. Misschien iets later als dat beter oogt."
     Met de metro aan speelt de scroll de video tot beeld METRO_BEELD; daar vertrekt het blauw (metro.js) en neemt het de
     laptop mee. De rit loopt op zijn eigen klok (een metro trekt op zoals hij optrekt, niet zoals jij scrolt) en terug
     scrollen laat hem terugrijden. Pas als alles wit is komt Wat we maken omhoog. Scrol je ver voor de rit uit, dan haalt
     hij in. */
  /* de video loopt over METRO_VIDEO van de baan. Het blauw vertrekt bij beeld METRO_BEELD: de telefoon is weg, van de laptop
     staat nog een derde in beeld (tot 522 px op 1440, gemeten in de video). De laptop gaat dan verder op de klok van de rit,
     alsof beeld 86 → 110 over METRO_MEE van de rit speelt (0,9 s, iets sneller dan het tempo van de video). De golf van de
     banen (metro.js, n3: 0,8 s, de laatste baan begint halverwege) loopt zo met de laptop mee: de laptop gaat links het beeld
     uit (beeld 102, driekwart van de rit) terwijl de laatste baan valt (lijst 77: "in een golf mee … smoother met elkaar"). */
  const METRO_VIDEO = 0.6, METRO_BEELD = 86, METRO_MEE = 1.125, METRO_TERUG = 24, METRO_INHALEN = 0.25;
  /* LEVERING 88b (Lucas, 4 november: "In de video lagged de laptop een beetje"). Twee oorzaken, allebei gemeten:
     1 · de scroll en de rit gaven de video elk een eigen doel (4 beelden verschil), dus stopte, zocht en speelde hij om
         beurten, en aan het eind sloeg hij beeld 100 – 103 over (de laptop sprong het beeld uit);
     2 · de video heeft 24 beelden per seconde en het blauw elk schermbeeld: naast elkaar schokt de laptop.
     Nu houdt de video tijdens de rit beeld 86 vast en schuift het doek de laptop zelf (laptopdoek.js), elk schermbeeld, op
     de klok van de rit, met de sluiter van de banen. Vanaf beeld 76 schuift de laptop in de video alleen nog naar links,
     zonder van vorm te veranderen: 38,0 beeldpunten per beeld op 1920 (rechte lijn door beeld 86 – 104, hoogstens 5
     beeldpunten ernaast); de rand van de telefoon rechts 12,5 per beeld naar rechts (op elke breedte buiten beeld). */
  const SCHUIF_LAPTOP = 38.0 / 1920, SCHUIF_TELEFOON = 12.5 / 1920;
  /* liep de video bij het vertrek nog achter (hij haalt de scroll in ± 0,16 s in), dan begint de laptop waar hij stond en
     loopt dat verschil in ± 0,4 s weg: geen sprong vooruit bij het vertrek, en geen sprong terug als de rit terug is */
  const SCHUIF_INLOOP = 400;

  let ruim: (() => void) | null = null;

  function start() {
    const o8 = document.querySelector<HTMLElement>('[data-o8]');
    if (o8 && o8.dataset.o8Klaar && ruim) return;
    ruim?.();
    if (!o8) return;
    o8.dataset.o8Klaar = '1';
    const $ = <T extends Element = HTMLElement>(s: string) => o8.querySelector<T>(s)!;
    const html = document.documentElement;
    const data = JSON.parse($('[data-o8-data]').textContent || '{}') as Data;
    const baan = $('[data-o8-baan]'), podium = $('[data-o8-podium]'), foto = $('[data-o8-foto]'), veeg = $('[data-o8-veeg]');
    const lap = $('[data-o8-lap]'), fon = $('[data-o8-fon]');
    const doek = $<HTMLCanvasElement>('[data-o8-doek]'), laden = $('[data-o8-laden]'), vul = $<SVGRectElement>('[data-o8-vul]');
    const metroDoek = $<HTMLCanvasElement>('[data-o8-metro]');
    const soort = (o8.dataset.metro || '').toLowerCase();
    let metroAan = /^n[123]$/.test(soort);
    o8.classList.toggle('o8-metro-aan', metroAan);
    /* inloop (levering 88b): hoeveel beelden de laptop bij het vertrek achter liep (≤ 0), loopt weg in SCHUIF_INLOOP */
    const rit = { u: 0, doel: 0, vorig: 0, raf: 0, tempo: 1, inloop: 0 };
    let metro: ReturnType<typeof maakMetro> = null;
    const klok = () => ((window as any).__o8Klok ? (window as any).__o8Klok() : performance.now());
    const mq = matchMedia('(prefers-reduced-motion: reduce)');
    let stil = mq.matches;

    /* ── de stilstaande schermen: in perspectief op de gaten van de stilstaande foto ── */
    const [q0l, q0f] = data.video.stil || data.video.schermen[0];
    function zetSchermen() {
      const r = foto.getBoundingClientRect(); if (!r.width) return;
      for (const [el, q] of [[lap, q0l], [fon, q0f]] as [HTMLElement, Q][]) {
        if (!q) continue;
        const b = el.offsetWidth || 1, h = el.offsetHeight || 1;
        const px = q.map(([x, y]) => [x * r.width, y * r.height]);
        /* RUIMER bronpixels ruimer, zodat de rand van het toestel het scherm afsnijdt (dezelfde maat als het doek) */
        const k = (RUIMER / data.video.b) * r.width, cx = px.reduce((s, p) => s + p[0], 0) / 4, cy = px.reduce((s, p) => s + p[1], 0) / 4;
        const bw = Math.max(...px.map((p) => p[0])) - Math.min(...px.map((p) => p[0])), bh = Math.max(...px.map((p) => p[1])) - Math.min(...px.map((p) => p[1]));
        const rq = px.map(([x, y]) => [cx + (x - cx) * (1 + (2 * k) / bw), cy + (y - cy) * (1 + (2 * k) / bh)]);
        el.style.left = '0'; el.style.top = '0';
        el.style.transform = cssMatrix(rq, b, h);
      }
    }

    /* ── de standen: drie, één per dienst, met de strepen (K1) ── */
    const lijst = data.standen || [];
    const standKnop = o8.querySelector<HTMLElement>('[data-o8-stand]');
    let standVast = (_v: boolean) => {}, standOpruim = () => {}, standStil = () => {}, naToon = () => {};
    if (standKnop && lijst.length > 1) {
      const kiezers = [...standKnop.querySelectorAll<HTMLButtonElement>('[data-o8-kies]')];
      const naam = $('[data-o8-naam]'), pauze = $<HTMLButtonElement>('[data-o8-pauze]');
      let nu = 0, loopt = !stil, zicht = false, erboven = false, vast = false, bewogen = false;
      const laps = new Map<number, { el: HTMLElement; img: HTMLImageElement; p: Promise<void> }>();
