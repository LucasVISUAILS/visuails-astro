---
/*
 * FigStudio — onze kant van een bestelling, op de marketingsite.
 *
 * ── WAAROM DIT BESTAAT ──────────────────────────────────────────────────────
 *
 * Lucas, 9 augustus 2026: *"Maak ook een mock-up van de 'Our side of it',
 * bedenk hoe je dit interessant verkoopt en klanten enthousiast maakt door
 * duidelijk en eerlijk te vertellen hoe het proces gaat."*
 *
 * Wat er stond was een grijs vlak met "ADMIN SIDE · DELIVERY CALENDAR" erin. Op
 * precies de plek waar een bezoeker moet beslissen of hij een datum van ons
 * gelooft.
 *
 * ── WAT DIT MOET VERKOPEN, EN WAAROM DAT UITGERKEND HIER LUKT ───────────────
 *
 * De belofte van deze band is niet "we hebben een mooi adminpaneel". Het is:
 * een datum die je van ons krijgt, is een datum die al bestond voordat we hem
 * noemden. Dat is een bewering over PROCES, en een bewering over proces geloof je
 * pas als je het mechanisme ziet.
 *
 * Dus laat deze figuur het mechanisme zien, en niet het resultaat:
 *
 *   1 · DE AGENDA — capaciteit per week, in producten. Er staat een week vol, en
 *       die wordt als vol aangeboden. Dat is het enige beeld dat "we beloven geen
 *       datum die we niet hebben" waar máákt in plaats van beweert.
 *   2 · DE BESTELLINGEN — de tabel waar we in werken, met de statuskolom. Eén rij
 *       is de jouwe, en die is gemarkeerd.
 *   3 · DEZELFDE SCHRIJFACTIE — de statuswijziging die wij doen, staat op hetzelfde
 *       moment op jouw tijdlijn. Niet gesynchroniseerd: één schrijfactie, twee
 *       schermen. Dat is de reden dat het portaal nooit achterloopt, en het is het
 *       soort detail dat een leverancier van een concurrent onderscheidt.
 *
 * ── EERLIJK, EN DAAROM OVERTUIGEND ──────────────────────────────────────────
 *
 * De volle week blijft vol. De verleiding is om een agenda te tekenen waar alles
 * kan; dat is precies de belofte die elke leverancier doet en die niemand meer
 * gelooft. Een agenda met een dichte week erin is het bewijs dat de andere weken
 * echt open zijn.
 *
 * Om dezelfde reden staat er een bestelling met status "wordt nagekeken" in de
 * tabel en niet alleen rijen die klaar zijn.
 *
 * ── HET IS EEN MOCK-UP, EN DAT MOET ZICHTBAAR ZIJN ──────────────────────────
 *
 * Zelfde afspraak als FigDash: geen enkele echte handeling, geen link naar
 * /admin, verzonnen gegevens, en er staat met zoveel woorden bij dat het een
 * voorbeeld is. Merk VOLT en referentie VIS-2608-4471, dezelfde als in FigDash en
 * in scripts/account-render.mjs, zodat de drie over hetzelfde merk gaan.
 *
 * GEEN ECHTE ADRESSEN OF NAMEN. Zie de langere noot daarover in FigDash.astro:
 * hier stond eerder op de homepage het huisadres van de eigenaar omdat het "maar
 * een voorbeeld" was.
 *
 * ── GEEN JAVASCRIPT ─────────────────────────────────────────────────────────
 *
 * Radio-inputs en `:has()`, net als FigDash, en om dezelfde reden: dit staat op
 * de homepage en de homepage wordt op trage telefoons geopend. Kent een browser
 * `:has()` niet, dan staat het eerste paneel open en blijven de andere bereikbaar
 * via hun label.
 */
interface Props { lang?: 'en' | 'nl' }
const { lang = 'en' } = Astro.props;
const nl = lang === 'nl';

/* Eén id-voorvoegsel per instantie, zodat twee figuren op één pagina niet dezelfde
   radiogroep delen. Zelfde truc als FigDash. */
const uid = `fs${Math.random().toString(36).slice(2, 8)}`;

const C = nl
  ? {
      note: 'Voorbeeld met verzonnen gegevens — dit is ons scherm, niet het jouwe.',
      tabs: [
        ['De agenda', 'Wat er per week in past'],
        ['De bestellingen', 'Waar alles staat, en van wie'],
        ['Eén schrijfactie', 'Waarom jouw scherm nooit achterloopt'],
      ],

      /* 1 · AGENDA */
      calH: 'Capaciteit per week',
      calSub: 'Geteld in producten, niet in bestellingen.',
      calWeeks: [
        { label: '3 – 7 aug', used: 96, cap: 100, state: 'full' },
        { label: '10 – 14 aug', used: 30, cap: 100, state: 'mine' },
        { label: '17 – 21 aug', used: 42, cap: 100, state: 'open' },
        { label: '24 – 28 aug', used: 8, cap: 100, state: 'open' },
      ],
      calFull: 'Vol',
      calMine: 'Jouw bestelling',
      calOpen: 'Ruimte',
      calUnit: (u, c) => `${u} van ${c} producten`,
      calRules: [
        ['Een volle week wordt als vol aangeboden.', 'Je krijgt geen datum die we niet hebben. Dat is de hele reden dat deze agenda vóór de belofte wordt gelezen en niet erna.'],
        ['Wat er staat, blijft staan.', 'Een bestelling die al in de agenda staat, schuift nooit op om een latere erin te krijgen.'],
      ],

      /* 2 · BESTELLINGEN */
      tblH: 'Bestellingen',
      tblCols: ['Referentie', 'Merk', 'Producten', 'Leverdatum', 'Status'],
      tblRows: [
        { ref: 'VIS-2608-4471', brand: 'VOLT', n: '30', win: '10 – 14 aug', status: 'In productie', tone: 'run', mine: true },
        { ref: 'VIS-2608-4468', brand: 'Nord Label', n: '12', win: '3 – 7 aug', status: 'Wordt nagekeken', tone: 'check' },
        { ref: 'VIS-2608-4462', brand: 'Studio Halte', n: '8', win: '3 – 7 aug', status: 'Geleverd', tone: 'done' },
        { ref: 'VIS-2607-9920', brand: 'Kade 4', n: '4', win: '—', status: 'Wacht op betaling', tone: 'wait' },
      ],
      tblMine: 'Jouw bestelling',
      tblNote: 'Elke bestelling staat op dezelfde lijst, in dezelfde tabel. Er is geen aparte rij voor grote klanten.',

      /* 3 · ÉÉN SCHRIJFACTIE */
      syncH: 'Eén handeling, twee schermen',
      syncOurs: 'Wij zetten hem op',
      syncYours: 'Jij ziet meteen',
      syncFrom: 'In productie',
      syncTo: 'Wordt nagekeken',
      syncStamp: 'vandaag 14:02',
      syncLine: 'Er is geen nachtelijke synchronisatie en geen handmatige update naar jou. De statuswijziging en jouw tijdlijn zijn dezelfde schrijfactie, dus wat wij zien is wat jij ziet.',
      syncEvents: [
        ['Ontvangen', '1 aug 09:12'],
        ['Betaling binnen', '1 aug 09:14'],
        ['Leverdatum vastgezet · 10 – 14 aug', '1 aug 09:14'],
        ['In productie', '8 aug 08:30'],
        ['Wordt nagekeken', 'vandaag 14:02'],
      ],
    }
  : {
      note: 'Example with made-up data — this is our screen, not yours.',
      tabs: [
        ['The calendar', 'What fits in a week'],
        ['The orders', 'Where everything stands, and whose it is'],
        ['One write', 'Why your screen is never behind'],
      ],

      calH: 'Capacity per week',
      calSub: 'Counted in products, not in orders.',
      calWeeks: [
        { label: '3 – 7 Aug', used: 96, cap: 100, state: 'full' },
        { label: '10 – 14 Aug', used: 30, cap: 100, state: 'mine' },
        { label: '17 – 21 Aug', used: 42, cap: 100, state: 'open' },
        { label: '24 – 28 Aug', used: 8, cap: 100, state: 'open' },
      ],
      calFull: 'Full',
      calMine: 'Your order',
      calOpen: 'Room',
      calUnit: (u, c) => `${u} of ${c} products`,
      calRules: [
        ['A full week is offered as full.', 'You never get a date we do not have. That is the whole reason this calendar is read before the promise instead of after it.'],
        ['What is booked stays booked.', 'An order already in the calendar is never moved to fit a later one in.'],
      ],

      tblH: 'Orders',
      tblCols: ['Reference', 'Brand', 'Products', 'Delivery', 'Status'],
      tblRows: [
        { ref: 'VIS-2608-4471', brand: 'VOLT', n: '30', win: '10 – 14 Aug', status: 'In production', tone: 'run', mine: true },
        { ref: 'VIS-2608-4468', brand: 'Nord Label', n: '12', win: '3 – 7 Aug', status: 'Being checked', tone: 'check' },
        { ref: 'VIS-2608-4462', brand: 'Studio Halte', n: '8', win: '3 – 7 Aug', status: 'Delivered', tone: 'done' },
        { ref: 'VIS-2607-9920', brand: 'Kade 4', n: '4', win: '—', status: 'Awaiting payment', tone: 'wait' },
      ],
      tblMine: 'Your order',
      tblNote: 'Every order sits on the same list, in the same table. There is no separate row for big accounts.',

      syncH: 'One action, two screens',
      syncOurs: 'We set it',
      syncYours: 'You see it',
      syncFrom: 'In production',
      syncTo: 'Being checked',
      syncStamp: 'today 14:02',
      syncLine: 'There is no overnight sync and no manual update to you. The status change and your timeline are the same write, so what we see is what you see.',
      syncEvents: [
        ['Received', '1 Aug 09:12'],
        ['Payment received', '1 Aug 09:14'],
        ['Delivery date reserved · 10 – 14 Aug', '1 Aug 09:14'],
        ['In production', '8 Aug 08:30'],
        ['Being checked', 'today 14:02'],
      ],
    };
---

<figure class="fs" aria-label={C.tabs.map((t) => t[0]).join(', ')}>
  {/* De radiogroep. Verborgen voor het oog, niet voor het toetsenbord: ze horen bij
      de labels eronder en blijven met tab en de pijltjestoetsen bereikbaar. */}
  {C.tabs.map((_, i) => (
    <input class="fs-radio" type="radio" name={`${uid}-tab`} id={`${uid}-${i}`} checked={i === 0} />
  ))}

  <div class="fs-frame">
    <div class="fs-bar">
      <span class="fs-mark">VISUAILS</span>
      <span class="fs-side">{nl ? 'Studiokant' : 'Studio side'}</span>
      <span class="fs-badge">{C.note}</span>
    </div>

    <div class="fs-body">
      <nav class="fs-nav">
        {C.tabs.map(([name, sub], i) => (
          <label class="fs-tab" for={`${uid}-${i}`}>
            <span class="fs-tab-n">{name}</span>
            <span class="fs-tab-s">{sub}</span>
          </label>
        ))}
      </nav>

      <div class="fs-panes">
        {/* ── 1 · DE AGENDA ─────────────────────────────────────────────────
            De balk per week is het hele argument. Een percentage zou hetzelfde
            zeggen en niets laten zien; een balk die tegen zijn eigen rand aanloopt
            is wat "vol" betekent. */}
        <div class="fs-pane" data-pane="0">
          <div class="fs-card">
            <div class="fs-head">
              <p class="fs-h">{C.calH}</p>
              <p class="fs-sub">{C.calSub}</p>
            </div>
            <ul class="fs-weeks">
              {C.calWeeks.map((w) => (
                <li class={`fs-week is-${w.state}`}>
                  <span class="fs-week-l">{w.label}</span>
                  <span class="fs-bar-track" aria-hidden="true">
                    <span class="fs-bar-fill" style={`--pct: ${Math.round((w.used / w.cap) * 100)}%`}></span>
                  </span>
                  <span class="fs-week-n">{C.calUnit(w.used, w.cap)}</span>
                  <span class="fs-week-s">
                    {w.state === 'full' ? C.calFull : w.state === 'mine' ? C.calMine : C.calOpen}
                  </span>
                </li>
              ))}
            </ul>
          </div>
          <dl class="fs-rules">
            {C.calRules.map(([h, body]) => (
              <div class="fs-rule">
                <dt>{h}</dt>
                <dd>{body}</dd>
              </div>
            ))}
          </dl>
        </div>

        {/* ── 2 · DE BESTELLINGEN ───────────────────────────────────────────
            Eén rij is gemarkeerd als de jouwe. Dat is wat een tabel van iemand
            anders leesbaar maakt: je zoekt jezelf en vindt jezelf. */}
        <div class="fs-pane" data-pane="1">
          <div class="fs-card">
            <div class="fs-head"><p class="fs-h">{C.tblH}</p></div>
            <div class="fs-tblwrap">
              <table class="fs-tbl">
                <thead>
                  <tr>{C.tblCols.map((col, i) => <th class={i > 1 ? 'is-num' : ''}>{col}</th>)}</tr>
                </thead>
                <tbody>
                  {C.tblRows.map((r) => (
                    <tr class={r.mine ? 'is-mine' : ''}>
                      <td>
                        <b>{r.ref}</b>
                        {r.mine ? <span class="fs-you">{C.tblMine}</span> : null}
                      </td>
                      <td>{r.brand}</td>
                      <td class="is-num">{r.n}</td>
                      <td class="is-num">{r.win}</td>
                      <td class="is-num"><span class={`fs-pill is-${r.tone}`}>{r.status}</span></td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
          <p class="fs-note">{C.tblNote}</p>
        </div>

        {/* ── 3 · ÉÉN SCHRIJFACTIE ──────────────────────────────────────────
            Twee kaarten naast elkaar met dezelfde tijdstempel erin. Dat is de
            hele bewijsvoering: niet "we synchroniseren snel" maar "het is één
            gebeurtenis". */}
        <div class="fs-pane" data-pane="2">
          <div class="fs-sync">
            <div class="fs-card is-half">
              <p class="fs-cap">{C.syncOurs}</p>
              <div class="fs-swap">
                <span class="fs-pill is-was">{C.syncFrom}</span>
                <span class="fs-arrow" aria-hidden="true">→</span>
                <span class="fs-pill is-check">{C.syncTo}</span>
              </div>
              <p class="fs-stamp">{C.syncStamp}</p>
            </div>
            <div class="fs-card is-half">
              <p class="fs-cap">{C.syncYours}</p>
              <ol class="fs-events">
                {C.syncEvents.map(([label, when], i) => (
                  <li class={i === C.syncEvents.length - 1 ? 'is-new' : ''}>
                    <span class="fs-ev-dot" aria-hidden="true"></span>
                    <span class="fs-ev-l">{label}</span>
                    <span class="fs-ev-t">{when}</span>
                  </li>
                ))}
              </ol>
            </div>
          </div>
          <p class="fs-note">{C.syncLine}</p>
        </div>
      </div>
    </div>
  </div>
</figure>

<style>
  /* ── DE MAAT WORDT MET EEN CONTAINER QUERY GEMETEN, NIET MET HET VENSTER ────
     Zelfde reden als FigDash: deze figuur staat in een halve kolom van een
     bredere band, dus wat hij moet weten is hoe breed die KOLOM is en niet hoe
     breed het scherm is. Met een media query zou hij op een laptop denken dat hij
     780px heeft terwijl hij er 460 krijgt. */
  .fs {
    container-type: inline-size;
    margin: 0;
    --fs-ink: var(--ink);
    --fs-line: var(--line);
  }

  /* De radio's zijn er voor het toetsenbord en de schermlezer; ze staan alleen
     buiten beeld. `position: absolute` en niet `display: none`, want een
     verborgen input is niet focusbaar. */
  .fs-radio {
    position: absolute;
    width: 1px; height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  .fs-frame {
    border: 1px solid var(--line-strong);
    border-radius: var(--r-lg);
    background: var(--surface);
    overflow: hidden;
    box-shadow: 0 30px 70px -30px rgb(0 0 0 / 0.8);
  }

  /* De titelbalk. Zelfde vorm als FigDash's, zodat de twee schermen op deze
     pagina als twee kanten van hetzelfde systeem lezen en niet als twee
     producten. */
  .fs-bar {
    display: flex; align-items: center; gap: .7rem; flex-wrap: wrap;
    padding: .7rem 1rem;
    background: var(--surface-2);
    box-shadow: inset 0 -1px 0 var(--line);
  }
  .fs-mark { font-size: .72rem; font-weight: 700; letter-spacing: .2em; color: var(--ink); }
  /* "Studiokant" hoort erbij en niet in de badge: het is wat dit scherm IS, niet
     een voorbehoud erover. */
  .fs-side {
    font-size: .62rem; font-weight: 600; letter-spacing: .08em; text-transform: uppercase;
    padding: .18rem .5rem; border-radius: var(--r-pill);
    background: var(--accent); color: var(--accent-on);
  }
  .fs-badge { font-size: .66rem; color: var(--ink-3); }

  .fs-body { padding: 1rem; display: grid; gap: 1rem; }

  /* ── DE TABS ──────────────────────────────────────────────────────────────
     Drie labels naast elkaar. Onder 30rem stapelen ze, want drie tabs met een
     ondertitel naast elkaar op een telefoon geeft drie kolommen van vier
     letters. */
  .fs-nav { display: grid; grid-template-columns: repeat(3, 1fr); gap: .4rem; }
  @container (max-width: 30rem) { .fs-nav { grid-template-columns: 1fr; } }
  .fs-tab {
    display: grid; gap: .1rem;
    padding: .55rem .7rem;
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    cursor: pointer;
    transition: border-color .16s ease, background .16s ease;
  }
  .fs-tab:hover { border-color: var(--line-strong); }
  .fs-tab-n { font-size: .78rem; font-weight: 600; color: var(--ink-2); }
  .fs-tab-s { font-size: .64rem; line-height: 1.35; color: var(--ink-3); }

  /* De actieve tab en het bijbehorende paneel, met :has() op de figuur. Vier
     regels per tab in plaats van een script; zie de kop van dit bestand. */
  .fs-panes > .fs-pane { display: none; }
  .fs-panes > .fs-pane[data-pane='0'] { display: grid; }
  .fs:has(.fs-radio:nth-of-type(1):checked) .fs-nav .fs-tab:nth-child(1),
  .fs:has(.fs-radio:nth-of-type(2):checked) .fs-nav .fs-tab:nth-child(2),
  .fs:has(.fs-radio:nth-of-type(3):checked) .fs-nav .fs-tab:nth-child(3) {
    border-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 8%, transparent);
  }
  .fs:has(.fs-radio:nth-of-type(1):checked) .fs-nav .fs-tab:nth-child(1) .fs-tab-n,
  .fs:has(.fs-radio:nth-of-type(2):checked) .fs-nav .fs-tab:nth-child(2) .fs-tab-n,
  .fs:has(.fs-radio:nth-of-type(3):checked) .fs-nav .fs-tab:nth-child(3) .fs-tab-n { color: var(--ink); }
  .fs:has(.fs-radio:nth-of-type(2):checked) .fs-panes > .fs-pane[data-pane='0'],
  .fs:has(.fs-radio:nth-of-type(3):checked) .fs-panes > .fs-pane[data-pane='0'] { display: none; }
  .fs:has(.fs-radio:nth-of-type(2):checked) .fs-panes > .fs-pane[data-pane='1'],
  .fs:has(.fs-radio:nth-of-type(3):checked) .fs-panes > .fs-pane[data-pane='2'] { display: grid; }

  .fs-pane { gap: .9rem; align-content: start; }

  .fs-card {
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    background: var(--bg, var(--surface));
    padding: .9rem;
  }
  .fs-head { margin-bottom: .8rem; }
  .fs-h { margin: 0; font-size: .84rem; font-weight: 600; color: var(--ink); }
  .fs-sub { margin: .15rem 0 0; font-size: .68rem; color: var(--ink-3); }
  .fs-cap {
    margin: 0 0 .6rem; font-size: .62rem; font-weight: 600; letter-spacing: .08em;
    text-transform: uppercase; color: var(--ink-3);
  }
  .fs-note { margin: 0; font-size: .7rem; line-height: 1.5; color: var(--ink-3); max-width: 62ch; }

  /* ── DE AGENDA ────────────────────────────────────────────────────────────
     Een rij per week: label, balk, aantal, en de toestand als woord. Het woord
     staat erbij omdat kleur alleen geen informatie mag dragen — dezelfde regel
     die account.css aanhoudt voor zijn statuspillen. */
  .fs-weeks { list-style: none; margin: 0; padding: 0; display: grid; gap: .55rem; }
  .fs-week {
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr) auto auto;
    align-items: center; gap: .7rem;
    font-size: .72rem;
  }
  @container (max-width: 34rem) {
    .fs-week { grid-template-columns: minmax(0, 1fr) auto; row-gap: .2rem; }
    .fs-week .fs-bar-track { grid-column: 1 / -1; order: 3; }
    .fs-week .fs-week-n { order: 4; }
    .fs-week .fs-week-s { order: 2; }
  }
  .fs-week-l { font-weight: 600; color: var(--ink-2); }
  .fs-week-n { font-size: .66rem; color: var(--ink-3); white-space: nowrap; }
  .fs-week-s {
    font-size: .6rem; font-weight: 600; letter-spacing: .06em; text-transform: uppercase;
    padding: .16rem .45rem; border-radius: var(--r-pill);
    border: 1px solid var(--line-strong); color: var(--ink-3);
    white-space: nowrap;
  }
  .fs-bar-track { display: block; height: 8px; border-radius: var(--r-pill); background: var(--surface-2); overflow: hidden; }
  .fs-bar-fill { display: block; height: 100%; width: var(--pct); border-radius: var(--r-pill); background: var(--ink-3); }

  /* Vol is de enige toestand met een waarschuwingskleur. Niet rood: er is niets
     fout, de week is alleen bezet — en een rode balk in een verkooppagina leest
     als een storing. */
  .fs-week.is-full .fs-bar-fill { background: var(--warn-ink, #C9A227); }
  .fs-week.is-full .fs-week-s { border-color: var(--warn-ink, #C9A227); color: var(--warn-ink, #C9A227); }
  .fs-week.is-mine .fs-bar-fill { background: var(--accent); }
  .fs-week.is-mine .fs-week-s { border-color: var(--accent); color: var(--accent); }
  .fs-week.is-mine .fs-week-l { color: var(--ink); }

  .fs-rules { margin: 0; display: grid; gap: .7rem; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  @container (max-width: 34rem) { .fs-rules { grid-template-columns: 1fr; } }
  .fs-rule { padding-top: .6rem; box-shadow: inset 0 1px 0 var(--line); }
  .fs-rule dt { font-size: .74rem; font-weight: 600; color: var(--ink-2); }
  .fs-rule dd { margin: .2rem 0 0; font-size: .68rem; line-height: 1.5; color: var(--ink-3); }

  /* ── DE TABEL ─────────────────────────────────────────────────────────────*/
  .fs-tblwrap { overflow-x: auto; }
  .fs-tbl { width: 100%; border-collapse: collapse; font-size: .72rem; }
  .fs-tbl th {
    text-align: left; padding: 0 .7rem .5rem 0;
    font-size: .6rem; font-weight: 600; letter-spacing: .06em; text-transform: uppercase;
    color: var(--ink-3); white-space: nowrap;
    box-shadow: inset 0 -1px 0 var(--line);
  }
  .fs-tbl td { padding: .6rem .7rem .6rem 0; box-shadow: inset 0 -1px 0 var(--line); color: var(--ink-3); vertical-align: middle; }
  .fs-tbl tr:last-child td { box-shadow: none; }
  .fs-tbl .is-num { text-align: right; padding-right: 0; white-space: nowrap; }
  .fs-tbl b { color: var(--ink-2); font-weight: 600; }
