---
/*
 * VISUAILS — StyleRows: de looks, en het kiezen ervan.
 * 4 september 2026, herzien dezelfde dag.
 *
 * ── WAT ER VERANDERDE, EN WAAROM ───────────────────────────────────────────
 *
 * Deze component begon als "elke stijl zijn eigen sectie": een raster van
 * gelijke tegels werd een rij per look, met de eigen look bovenaan als eerste
 * ingang. Dat was een OPMAAK-verandering. Wat nu volgt is een verandering in
 * wat de sectie IS.
 *
 * Lucas: *"de klant moet op de lifestyle pagina eerst een style kiezen die bij
 * hem past of een custom style wanneer hij deze heeft, het kiezen van een style
 * gaat dan niet meer in het bestelformulier maar als eerste keuze van de klant
 * en daarna pas het formulier met gegevens."*
 *
 * Daarmee is dit geen etalage meer maar STAP 1 van het bestellen. Drie dingen
 * volgen daaruit, en ze zitten alle drie in deze component:
 *
 *   1. ELKE LOOK HEEFT ÉÉN DUIDELIJKE HANDELING. "Kies deze look" gaat naar
 *      het formulier mét de keuze erin (?style=<slug>), en het formulier vraagt
 *      hem niet nog een keer — zie StylePicker.astro. De tweede knop is geen
 *      knop meer maar een tekstlink: twee even zware knoppen naast elkaar is
 *      de keuze doorschuiven in plaats van aanbieden.
 *
 *   2. DE VASTE LOOKS STAAN VOOROP EN "OP MAAT" SLUIT DE RIJ. Dat is een
 *      omkering van vanochtend, en met reden: een look op maat is het antwoord
 *      op "hier zit niet wat ik zoek", en die vraag kán een bezoeker pas hebben
 *      nadat hij gezien heeft wat er is. Bovenaan koste hij iedereen die wél
 *      iets vindt een scherm, en hij is een AANVRAAG zonder tarief — de traagste
 *      weg, op de snelste plek. De bovenste plek is niet verdwenen: daar staat
 *      nu de eigen look van de klant die er al een heeft, en dát is een look die
 *      hij met één klik kan kiezen.
 *
 *   3. WAT ER IN DE MAAK IS, STAAT ER OOK. Zie src/data/komendeStijlen.js.
 *
 * ── DE WAAIER TELT WAT JE KRIJGT ───────────────────────────────────────────
 *
 * Lucas: *"Alleen bij catalog 4 foto's als resultaat omdat dit ook echt zo is.
 * Bij lifestyle moeten dus 3 + before foto."* De waaier is dus geen decoratie
 * met een willekeurig aantal beelden: het aantal kaarten IS de belofte van de
 * dienst. Catalog vier plus de telefoonfoto, lifestyle drie plus de
 * telefoonfoto, video één clip plus de telefoonfoto. De pagina geeft precies
 * zoveel `photos` mee als de dienst levert; een beeld dat nog niet bestaat is
 * een kaart met de naam erop ("Achterkant") en niet een kaart die wegvalt.
 *
 * Daarom is de oude "vul aan tot drie"-regel weg. Die maakte van één beeld drie
 * kaarten om de waaier vol te laten lijken — precies het soort opmaak dat een
 * belofte doet die de dienst niet waarmaakt.
 */
import ProductScene from './ProductScene.astro';
import { komendeStijlen } from '../data/komendeStijlen.js';
/* De namen van de geleverde beelden — zie de kop van LEVERVLAKKEN in
   pricing.js. Geen bedragen hier; alleen hoe de vakken heten. */
import { levervlakken } from '../data/pricing.js';

export interface Media {
  src?: string; w?: number; h?: number; alt?: string;
  icon?: 'bottle' | 'sneaker' | 'jar' | 'bag'; width?: string; badge?: string;
  label?: string;            // zonder src/icon: een "foto volgt"-kaart met deze naam (bijv. "Achterkant")
}
export interface Item {
  slug: string;
  name: string;
  tagline: string;
  desc: string;
  price: string;
  bestFor: string[];
  media: Media;              // het eerste beeld (of de getekende scène)
  photos?: Media[];          // precies zoveel beelden als de dienst levert
  before?: Media;            // de telefoonfoto waar het van gemaakt is — de kleine kaart
  tint?: string;             // de kleuraccenten van deze look
  naLabel?: string;          // wat er op het geleverde beeld staat (standaard "Geleverd")
  detailHref: string;
  detailLabel: string;
  orderHref?: string;
  orderLabel?: string;       // leeg → "Kies deze look"
}
interface Props {
  lang: 'en' | 'nl';
  dienst: 'catalog' | 'lifestyle' | 'video';
  h: string;                 // de sectiekop, mag <em> bevatten
  lead: Item;                // de look op maat
  items: Item[];             // de vaste looks, in volgorde
  leadSteps?: string[];      // drie stappen naar een eigen look
  levert: string;            // "vier foto's per product" — wat élke look oplevert
  bestelBasis?: string;      // '/nl/start/lifestyle/' — waar een eigen stijl van de klant heen gaat
}
const { lang, dienst, h, lead, items, leadSteps, levert, bestelBasis } = Astro.props;
const nl = lang === 'nl';

/* De kaarten van één look: eerst de geleverde beelden op hun vaste plek, dan de
   ingestuurde telefoonfoto. `data-n` op de waaier zegt hoeveel het er zijn, en
   de CSS heeft voor elk aantal een eigen indeling. */
const VOLGORDE = [2, 1, 3, 4];
type Kaart = { slot: number; m: Media | null; voor?: boolean };
const waaier = (it: Item): Kaart[] => {
  const fotos = (it.photos && it.photos.length ? it.photos : [it.media]).slice(0, 4);
  const uit: Kaart[] = fotos.map((m, i) => ({ slot: VOLGORDE[i], m: (m.src || m.icon || m.label) ? m : null }));
  if (it.before) uit.push({ slot: fotos.length >= 4 ? 5 : 4, m: it.before, voor: true });
  return uit;
};
const isLeeg = (m: Media | null) => !m || !(m.src || m.icon);
const altVan = (naam: string, m: Media | null, i: number, voor?: boolean) =>
  voor ? (nl ? `De ingestuurde telefoonfoto waar ${naam} van gemaakt wordt` : `The phone photo ${naam} is made from`)
       : (m?.alt || (nl ? `${naam} — voorbeeld ${i + 1}` : `${naam} — example ${i + 1}`));

/* ═══════════════════════════════════════════════════════════════════════════
 * DE SET IS TERUG IN DE TEGEL — 17 SEPTEMBER 2026
 * ═══════════════════════════════════════════════════════════════════════════
 *
 * Lucas: *"Ik wil weer de oude, maar wel geupgraded, look van de stylekeuze —
 * 1 kleine foto en 3 foto's erachter met de resultaten, zodat de klant gelijk
 * kan zien wat hij kan verwachten. 1 foto voor een style is simpelweg te
 * weinig."*
 *
 * ── WAT ER OP 10 SEPTEMBER WERD WEGGEHAALD, EN OF DAT KLOPTE ──────────────
 *
 * Toen verving één beeld de waaier, met als reden: *"drie van de vier waaiers
 * waren leeg — vijftien kaarten, één echte foto."* Nagemeten op 17 september
 * klopt die reden nog steeds voor /catalog en /video (die hebben nul foto's en
 * draaien op getekende scènes) en klopt hij NIET voor /lifestyle: flash heeft
 * er acht op schijf, glow zes, phone-made elf. Daar was de waaier niet leeg,
 * en daar is hij dus ten onrechte gesneuveld.
 *
 * Het echte probleem was nooit de waaier maar het LEGE VAK: een grijs kader met
 * "Foto volgt" leest als een gat, en vier gaten naast elkaar lezen als een site
 * die niet af is. Dus is dát wat verandert, en niet de vorm.
 *
 * ── DE PLAAT ─────────────────────────────────────────────────────────────
 *
 * Een vak zonder foto is nu een PLAAT: de kleur van de look, en de naam van het
 * beeld dat er komt ("Achterkant", "Op model") in mono. Het leest als een
 * gereserveerd kader op een contactvel, niet als een mislukte afbeelding — en
 * het doet iets wat een foto niet doet: het zegt WAT je krijgt. Zodra Lucas'
 * content er is, wordt dezelfde plek een foto en verdwijnt de naam; de volgorde
 * en het aantal veranderen niet mee.
 *
 * De namen komen uit LEVERVLAKKEN in pricing.js, één bron met wat de dienst
 * belooft — zie de kop daar. Vier bij catalog, drie bij lifestyle, één bij
 * video, en dat is meteen waarom deze drie pagina's er nu hetzelfde uitzien
 * zonder dat er ergens een aantal is ingetypt.
 *
 * ── WAAROM DE KAARTEN NIET MEER SCHUIN OVER ELKAAR VALLEN ────────────────
 *
 * De oude waaier was gemaakt voor een blok van een halve pagina; in een tegel
 * van 280 pixels wordt datzelfde gebaar een kluwen waarin geen enkel beeld nog
 * te herkennen is. Hier staan ze bijna naast elkaar met een paar graden
 * verschil en een kleine overlap — genoeg om een SET te zijn en niet drie losse
 * tegels, weinig genoeg om alle drie te kunnen zien. De telefoonfoto staat
 * linksonder, kleiner, met een lichte rand: het formaat zegt al dat het de
 * invoer is en niet het resultaat.
 */
type Vlak = { m: Media | null; naam: string };

/* De verhouding van een geleverd beeld per dienst. Een catalogbeeld is
   vierkant, een lifestylebeeld staand, een clip verticaal — dezelfde
   verhoudingen als komendRatio hierboven, en om dezelfde reden: een kader met
   de verkeerde vorm belooft een ander bestand dan er komt.

   DIT IS HET ENIGE WAT PER DIENST VERSCHILT aan het vel. De indeling, de
   tussenruimte, de stippellijn om de ingestuurde foto, het bijschrift onder
   elke tegel en de regel eronder zijn op alle drie de pagina's hetzelfde —
   zie de noot bij .sr-k-vel in de stijl hieronder. */
const VELRATIO: Record<string, string> = { catalog: '1 / 1', lifestyle: '3 / 4', video: '9 / 16' };

/* ── EEN REM OP DE BREEDTE, ALLEEN WAAR HIJ NODIG IS — 20 september 2026 ───
   Het vel vult de kolom. Bij catalog (vier vierkanten) en lifestyle (drie
   staande kaarten) is dat precies goed. Bij video staat er één clip van 9:16
   naast de telefoonfoto: over de volle kolom wordt die tegel ~420 px breed en
   dus 750 px hoog, hoger dan het scherm van de bezoeker. Vandaar één grens,
   en alleen daar. `none` is geen ontbrekende waarde maar de bedoelde: geen
   grens. */
/* 22rem → 15rem op 23 september 2026: de drie videosoorten staan nu naast
   elkaar (zie .sr-kamers.is-video), en zolang de clips op aanvraag zijn is
   het tweede vak een lege plaat — die hoort niet het hoogste op de pagina te
   zijn. */
const VELMAX: Record<string, string> = { catalog: 'none', lifestyle: 'none', video: '15rem' };

const velVan = (it: Item): { vlakken: Vlak[]; voor: Media | null } => {
  const namen = levervlakken(dienst, lang);
  const n = namen.length || 1;
  const bron = (it.photos && it.photos.length ? it.photos : [it.media]).slice(0, n);
  const vlakken = namen.map((naam, i) => {
    const m = bron[i] || null;
    return { m: m && (m.src || m.icon) ? m : null, naam };
  });
  return { vlakken, voor: it.before && (it.before.src || it.before.icon) ? it.before : null };
};

/* ── HET BEELD DAT DE TEGEL DROEG — 10 september, vervangen 17 september ────
 * Hier stond tegelbeeld(): één beeld per look in plaats van de set, met als
 * argument dat het verhaal "drie foto's plus de telefoonfoto" al twee keer op
 * de pagina staat en een derde keer de keuze onleesbaar maakt.
 *
 * Dat argument ging over HERHALING en het echte probleem was de LEGE KAART —
 * zie de kop van velVan(). Een set die je kunt zien is geen herhaling van een
 * etiket; het is het enige moment waarop een bezoeker ziet wat hij koopt, en
 * dat is precies wat Lucas terugvroeg: *"1 foto voor een style is simpelweg te
 * weinig."* De functie is weg en niet uitgezet, zodat er geen tweede manier
 * blijft bestaan om dezelfde tegel te vullen.
 */

/* ── EN DE PRIJS ÉÉN KEER ─────────────────────────────────────────────────
 * Vier tegels met exact dezelfde regel eronder ("€109 – €49 / product · excl.
 * btw") is vier keer dezelfde mededeling op de plek waar het verschil hoort te
 * staan. Kosten ze hetzelfde, dan staat het bij de kop; verschillen ze, dan
 * staat het per tegel. Dat is geen aanname over de tarieven maar een vraag aan
 * de gegevens, dus een look met een eigen prijs blijft hem gewoon tonen. */
const prijzen = [...new Set(items.map((i) => i.price).filter(Boolean))];
const prijsSamen = prijzen.length === 1 ? prijzen[0] : '';

const komend = komendeStijlen(dienst, lang);
/* De verhouding van het placeholderbeeld volgt de dienst: een catalogbeeld is
   vierkant, een lifestylebeeld staand, een clip en een hook verticaal. Een
   kaart met de verkeerde verhouding belooft een ander bestand dan er komt. */
const komendRatio = dienst === 'catalog' ? '1/1' : (dienst === 'video' || dienst === 'hooks' ? '9/16' : '4/5');
/* De eigen stijlen van een klant bestaan alleen bij catalog en lifestyle
   (customer_styles.service), dus video krijgt het lege vak niet eens mee. */
const eigenVak = dienst !== 'video' && !!bestelBasis;

const c = nl ? {
  stap: 'Stap 1 — kies je look',
  intro: '',
  levertL: 'Elke look levert',
  kies: 'Kies deze look',
  bekijk: 'Bekijk voorbeelden',
  bestFor: 'Past bij',
  voor: 'Ingestuurd', na: 'Geleverd',
  /* ── EN EEN KORTERE VOOR DE TEGEL — 17 september 2026 ────────────────────
     "Ingestuurd" is 87 pixels en de telefoonkaart in een tegel is er 74. Het
     woord kleiner zetten mag niet (11,5px is de ondergrens van de
     leesbaarheidskeuring) en de kaart groter maken ook niet — het formaat is
     juist wat hem als invoer laat lezen. Dus een korter woord, en het is
     bovendien beter: "jouw foto" zegt van wie hij is, "ingestuurd" zegt alleen
     dat er iets gebeurd is. In de grote waaier blijft "Ingestuurd" staan; daar
     is de ruimte er wel en staat het naast "Geleverd" als een paar. */
  voorKort: 'Jouw foto',
  /* ── DE REGEL ONDER HET VEL — 20 september 2026 ───────────────────────
     Zie de lange noot bij de markup. Het vel toont de ONDERGRENS en niet het
     plafond; deze zin is wat dat verschil draagt. Hij noemt eerst wat vastligt
     (dit krijg je altijd, bij dit bedrag) en dan pas de ruimte, want andersom
     leest het als een verkoopregel in plaats van als een belofte. */
  altijd: 'Meer beelden kies je erbij in het bestelformulier.',
  volgt: 'Foto volgt',
  eigenH: 'Jouw eigen look',
  eigenSub: 'Voor jouw merk gemaakt. Alleen jij ziet hem hier.',
  eigenKies: 'Kies deze look',
  komendH: 'In de maak',
  komendSub: 'Nog niet te bestellen.',
  /* ── EN DEZELFDE ZIN VOOR ÉÉN — 22 september 2026 ──────────────────────
     Catalog hield vandaag één komende look over. "Zit die van jou ertussen"
     vraagt naar een lijst, en bij één regel is er niets om tussen te zitten;
     de zin gaat dan over een lijst die de lezer niet ziet. Eén variant dus,
     gekozen op `komend.length`. */
  komendSubEen: 'Nog niet te bestellen.',
  komendVoet: 'Binnenkort',
  maatEyebrow: 'Geen van deze?',
  maatSub: '',
  steps: leadSteps || ['Intake', 'Haalbaarheidscheck', 'Offerte'],
} : {
  stap: 'Step 1 — pick your look',
  intro: '',
  levertL: 'Every look delivers',
  kies: 'Pick this look',
  bekijk: 'See examples',
  bestFor: 'Best for',
  voor: 'Submitted', na: 'Delivered',
  /* Zie de Nederlandse tegenhanger. */
  voorKort: 'Your photo',
  /* Zie de Nederlandse tegenhanger. */
  altijd: 'More images can be added in the order form.',
  volgt: 'Photo to come',
  eigenH: 'Your own look',
  eigenSub: 'Made for your brand. Nobody else sees it here.',
  eigenKies: 'Pick this look',
  komendH: 'In the works',
  komendSub: 'Not orderable yet.',
  komendSubEen: 'Not orderable yet.',
  komendVoet: 'Coming',
  maatEyebrow: 'None of these?',
  maatSub: '',
  steps: leadSteps || ['Intake', 'Feasibility check', 'Quote'],
};
---

{/* ── GEEN id="looks" HIER — 17 september 2026 ─────────────────────────────
    Dat stond er wél, en op /catalog, /lifestyle en /video staat het óók op de
    <section class="paneel"> die dit onderdeel omsluit. Twee elementen met
    hetzelfde id op één pagina: ongeldige HTML, en een browser die `#looks`
    oplost pakt de eerste — het werkte dus bij toeval. Het anker hoort bij de
    PAGINA (die weet waar het blok begint, inclusief zijn eigen bovenruimte) en
    niet bij dit onderdeel. Zet dit onderdeel ooit op een pagina die zelf geen
    anker heeft, geef die pagina dan een id — niet dit bestand. */}
<section class="sr">
  <div class="container">
    <header class="sr-top">
      <div class="sr-top-woord">
        <p class="sr-stap">{c.stap}</p>
        <h2 class="sr-h2" set:html={h} />
        {c.intro && <p class="sr-intro">{c.intro}</p>}
      </div>
      {/* Wat de look LEVERT en wat hij KOST horen bij elkaar en niet onder de
          inleiding: zie de noot bij .sr-top in de stijl hieronder. */}
      <div class="sr-top-feit">
        <p class="sr-levert"><span>{c.levertL}</span> {levert}</p>
        {/* ── DE ONDERGRENS, ÉÉN KEER ──────────────────────────────────────
            Deze zin stond eerst onder elk vel. Bij zes looks op /video stond
            hij dus zes keer woordelijk hetzelfde op één pagina — precies wat
            een regel eerder al is aangepakt bij de prijs (zie prijsSamen). Hij
            geldt voor alle looks, dus hoort hij bij de kop, en hij staat hier
            direct onder de chip die het aantal noemt: dat aantal is waar hij
            over gaat. */}
        {c.altijd && <p class="sr-levert-bij">{c.altijd}</p>}
        {prijsSamen && <p class="sr-kopprijs">{prijsSamen}</p>}
      </div>
    </header>

    {/* ── DE EIGEN LOOK VAN DEZE KLANT ────────────────────────────────────────
        Leeg en verborgen in de HTML: hij wordt gevuld uit /account/me, dat de
        enige plek is die weet wie er kijkt. Een uitgelogde bezoeker ziet niets
        en er is niets te zien — er staat geen naam van een andere klant in de
        pagina, want de pagina kent er geen. */}
    {eigenVak && (
      <div class="sr-eigen" data-sr-eigen data-sr-dienst={dienst} data-sr-basis={bestelBasis} data-sr-kies={c.eigenKies} hidden>
        <div class="sr-eigen-kop">
          <h3 class="sr-alt-h">{c.eigenH}</h3>
          <p class="sr-alt-sub">{c.eigenSub}</p>
        </div>
        <ul class="sr-eigen-lijst" data-sr-eigen-lijst></ul>
      </div>
    )}

    {/* ── DE VASTE LOOKS, NAAST ELKAAR IN PLAATS VAN ONDER ELKAAR ──────────
        10 september 2026. Lucas: *"Ik wil ook dat je gaat kijken naar de style
        secties hoe je ze er wat minder generiek eruit kan laten zien"* en, over
        de site als geheel: *"je verliest het overzicht omdat er gewoon teveel
        tegelijk gebeurt waardoor men snel afhaakt. Het mag allemaal wel wat
        moderner en lab achtiger (minimalistic) maar wel direct en duidelijk."*

        ── WAT ER STOND, GEMETEN ─────────────────────────────────────────────
        Vier looks, elk een eigen regel van een halve schermhoogte, om en om
        links en rechts. Samen 2033 pixels in een sectie van 3405 — op
        /lifestyle de grootste sectie van de hele site. Elke regel herhaalde
        dezelfde vijf dingen: waaier, naam, tagline, beschrijving, "past bij",
        prijs, knop, link.

        Drie dingen gingen daar mis, en geen ervan is "te veel informatie":
        · JE KUNT ZE NIET VERGELIJKEN. Een look kiezen is per definitie een
          vergelijking, en bij een halve schermhoogte per look zie je er nooit
          twee tegelijk. Je onthoudt de vorige in plaats van hem te zien.
        · HET OM EN OM IS DE VORM ZELF EN ZEGT NIETS. Links-rechts-links-rechts
          is precies de opmaak die elke sjabloonpagina heeft; hij suggereert dat
          er per rij iets anders aan de hand is terwijl elke rij hetzelfde doet.
        · DRIE VAN DE VIER WAAIERS WAREN LEEG. Vijftien kaarten, één echte foto:
          de rest waren grijze vlakken die op een foto lijken. Dat is wat "goedkoop"
          en "generiek" er in de praktijk uit ziet.

        ── WAT ER NU STAAT ───────────────────────────────────────────────────
        Hetzelfde contactblad als op /per-product: een raster met haarlijnen
        ertussen, geen kaarten, geen schaduw, geen ronding. Vier looks in één
        blik, elk met het beeld waar je hem aan herkent, de zin die zegt waar
        hij voor is, en één handeling. De beschrijving en het verhaal van de
        waaier staan op de detailpagina, waar je heen gaat als deze look je iets
        doet — kijken en kiezen zijn twee dingen. */}
    {/* ═══ ELKE LOOK EEN EIGEN KAMER — 17 SEPTEMBER 2026 ════════════════════
        Lucas, na de tegelrij van vanochtend: *"Ik vind dit er echt niet goed
        uitzien en laat elke style lijken als maar zomaar iets, terwijl elke
        style zijn eigen identiteit is en belangrijk aan moet voelen voor de
        klant. Je mag die hele look van die pagina aanpassen en de stylen van
        elkaar los trekken om ze hun eigen sectie te geven."*

        Hij heeft gelijk, en het is niet de eerste keer dat deze sectie hierop
        omvalt. Op 10 september werd een rij van vier gelijke tegels gekozen
        met als argument dat je looks moet kunnen VERGELIJKEN, en dat klopt —
        maar vier identieke kaders naast elkaar leveren geen vergelijking op.
        Ze leveren het idee op dat het vier varianten van hetzelfde zijn, en
        dan is er niets te vergelijken. Een look is geen optie in een lijst;
        het is de wereld waarin het product komt te staan.

        ── WAT ELKE KAMER DOET ──────────────────────────────────────────────
        Eén zin, van links naar rechts: JOUW FOTO → een pijl → WAT JE TERUG
        KRIJGT. Dat is de hele dienst in één beeld, en het staat nu vier keer
        op de pagina in vier verschillende werelden in plaats van één keer
        weggestopt in een tegel van 280 pixels.

        ── EN HOE ZE UIT ELKAAR GETROKKEN ZIJN ─────────────────────────────
        Niet met links-rechts-links-rechts: dat is de vorm zelf en zegt niets
        (het was op 10 september een van de drie redenen om die opzet weg te
        halen, en die reden staat nog steeds). Wél met KLEUR: elke kamer draagt
        de tint van zijn eigen look als grond, als lijn en als nummerteken.
        Dunes is zand, Flash is koud licht, Glow is paars, Phone-made is
        telefoonblauw — dat stond al in TINT in de pagina's en werd tot vandaag
        uitgegeven aan een streepje van drie pixels.

        ── VERGELIJKEN KAN NOG STEEDS ──────────────────────────────────────
        Elke kamer draagt dezelfde vier dingen op dezelfde plek: naam, waar hij
        bij past, wat hij levert, wat hij kost. Wie wil vergelijken leest die
        vier regels op vier plekken; wie wil kiezen ziet vier werelden. Dat is
        de goede volgorde — niemand vergelijkt looks op een spec. */}
    <ol class={`sr-kamers is-${dienst}`} role="list">
      {items.map((s, ki) => {
        const { vlakken, voor } = velVan(s);
        return (
        <li class="sr-kamer" id={`look-${s.slug}`} style={s.tint ? `--sr-tint:${s.tint}` : undefined}>
          <div class="sr-k-kop">
            <h3 class="sr-k-h">{s.name}</h3>
            <p class="sr-k-tag">{s.tagline}</p>
          </div>

          {/* ═══ HET VEL — 20 SEPTEMBER 2026 ═══════════════════════════════
              Lucas koos ontwerp B uit kladblok/stijlkaart/: *"Ik vind B 'het
              vel' het beste (…) B mag daarnaast bij alle style categorieën
              worden toegepast en maak het enorm consistent om rust te
              bewaren."*

              ── WAT ERVOOR STOND ────────────────────────────────────────────
              Een baan van drie delen: de telefoonfoto klein links, een pijl,
              en daarnaast een set waarin het eerste beeld de volle hoogte
              droeg en de rest in een smalle kolom stond. Dat had een
              rangorde die de dienst niet heeft — het openingsbeeld is niet
              belangrijker dan het detail, je krijgt ze allemaal — en het gaf
              drie verschillende indelingen op drie dienstpagina's, want bij
              één clip viel de hele opzet weg.

              ── WAT HET NU IS ───────────────────────────────────────────────
              Eén rij gelijke tegels, als een contactvel. De ingestuurde foto
              is de eerste tegel, iets smaller en met een stippellijn: hij
              hoort bij de rij en hij is iets anders. Elke geleverde tegel
              draagt zijn eigen naam ("01 · Voorkant"), dus je ziet het aantal
              én wat elk beeld is zonder één woord extra.

              Dezelfde opzet op alle drie de dienstpagina's. Wat verschilt is
              alleen de VERHOUDING van een tegel — vierkant bij catalog,
              staand bij lifestyle, verticaal bij een clip — en dat is geen
              inconsistentie maar het formaat van het bestand dat je krijgt.

              ── EN DE REGEL ERONDER ─────────────────────────────────────────
              Lucas: *"het moet niet zo zijn dat de klant denkt dat hij alleen
              die beelden krijgt omdat er meer beelden per order per product
              toegevoegd kunnen worden. De beelden die er staan zijn wat de
              klant altijd voor het bedrag mag verwachten."*

              Een contactvel leest als een volledige opsomming — dat is
              precies zijn kracht en precies het risico. De regel onder het
              vel zegt daarom in één zin wat het vel WEL is (de ondergrens,
              altijd, bij dit bedrag) en dat er meer bij kan. Zonder die regel
              zou het vel een plafond beloven dat er niet is. */}
          <div class="sr-k-baan">
            <ol class={`sr-k-vel${voor ? ' heeft-voor' : ''}`} role="list"
                style={`--sr-n:${vlakken.length}; --sr-vr:${VELRATIO[dienst] || '3 / 4'}; --sr-velmax:${VELMAX[dienst] || 'none'}`}>
              {voor && (
                <li class="sr-k-tegel is-voor">
                  <span class="sr-k-vak">
                    {voor.src
                      ? <img src={voor.src} alt={altVan(s.name, voor, 0, true)} loading="lazy" decoding="async" />
                      : <ProductScene icon={voor.icon!} width="52%" wide />}
                  </span>
                  <span class="sr-k-bij">{c.voorKort}</span>
                </li>
              )}
              {vlakken.map((v, i) => (
                <li class="sr-k-tegel">
                  <a class={`sr-k-vak${v.m ? '' : ' is-plaat'}`} href={s.detailHref}
                     aria-label={i === 0 ? s.detailLabel : undefined}
                     tabindex={i === 0 ? undefined : -1} aria-hidden={i === 0 ? undefined : 'true'}>
                    {v.m?.src
                      ? <img src={v.m.src} alt={i === 0 ? altVan(s.name, v.m, 0) : ''} loading="lazy" decoding="async" width={v.m.w} height={v.m.h} />
                      : v.m?.icon ? <ProductScene icon={v.m.icon} width={v.m.width || '52%'} badge={v.m.badge} wide />
                      /* ── GEEN NAAM MEER IN DE PLAAT — 20 september 2026 ──
                         Hij stond er wél, en dat was juist zolang de tegel
                         geen bijschrift had. Nu draagt elke tegel zijn naam
                         eronder, dus stond "ACHTERKANT" twee keer boven
                         elkaar in hetzelfde vak. Wat blijft is het vak zelf
                         (papier met een haarlijn) en een bijschrift in het
                         lichtere grijs; de zin hieronder is er voor wie de
                         pagina niet ziet maar hoort. */
                      : <span class="sr-verborgen">{c.volgt}</span>}
                  </a>
                  <span class={`sr-k-bij is-na${v.m ? '' : ' is-volgt'}`}>{String(i + 1).padStart(2, '0')} · {v.naam}</span>
                </li>
              ))}
            </ol>
          </div>

          <div class="sr-k-woord">
            {s.bestFor.length > 0 && (
              <p class="sr-best sr-k-best"><span class="sr-best-l">{c.bestFor}</span> {s.bestFor.slice(0, 2).join(' · ')}</p>
            )}
            {!prijsSamen && s.price && <p class="sr-t-prijs">{s.price}</p>}
            <div class="sr-k-cta">
              {s.orderHref && <a class="btn btn-primary sr-t-knop" href={s.orderHref}>{s.orderLabel || c.kies}</a>}
              <a class={s.orderHref ? 'sr-link' : 'btn btn-primary sr-t-knop'} href={s.detailHref}>
                {s.orderHref ? c.bekijk : s.detailLabel}
                {s.orderHref && <svg viewBox="0 0 24 24" class="i" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>}
              </a>
            </div>
          </div>
        </li>
        );
      })}
    </ol>

    {/* ── WAT ER IN DE MAAK IS — IN ÉÉN REGEL SINDS 23 september 2026 ──────
        Hier stonden kaarten met een gestippelde plaatshouder per komende look
        (396 px op /catalog voor één look). Lucas keurde PAGINA-OPBOUW.md goed:
        *"het blok dat de meeste ruimte pakt, zegt het minst."* Wat je nog niet
        kunt bestellen, krijgt een naam en een zin — geen leeg beeld. */}
    {komend.length > 0 && (
      <div class="sr-komend">
        <h3 class="sr-alt-h">{c.komendH}</h3>
        <div class="sr-komend-rechts">
          <ul class="sr-komend-lijst" role="list">
            {komend.map((k) => (
              <li><span class="sr-komend-naam">{k.naam}</span> <span class="sr-komend-regel">{k.regel}</span></li>
            ))}
          </ul>
          <p class="sr-komend-noot">{komend.length === 1 ? c.komendSubEen : c.komendSub}</p>
        </div>
      </div>
    )}

    {/* ── EN ALS ER NIETS TUSSEN ZIT: OP MAAT — ÉÉN BALK ────────────────────
        23 september 2026: de waaier met lege kaarten is eruit (439 px). Wat
        blijft: wat het is, hoe het gaat (de drie stappen als één regel), wat
        het kost en de knop. */}
    <article class="sr-maat" style={lead.tint ? `--sr-tint:${lead.tint}` : undefined}>
      <div class="sr-maat-body">
        <p class="sr-eyebrow">{c.maatEyebrow}</p>
        <h3 class="sr-maat-h">{lead.name}</h3>
        <p class="sr-desc">{lead.tagline}{c.maatSub ? ` ${c.maatSub}` : ''}</p>
        <p class="sr-maat-stappen">{c.steps.join(' → ')}</p>
      </div>
      <div class="sr-maat-zij">
        <p class="sr-price">{lead.price}</p>
        <div class="sr-cta">
          <a class="btn btn-primary" href={lead.orderHref || lead.detailHref}>{lead.orderLabel || lead.detailLabel}</a>
          {lead.orderHref && (
            <a class="sr-link" href={lead.detailHref}>{lead.detailLabel}
              <svg viewBox="0 0 24 24" class="i" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </a>
          )}
        </div>
      </div>
    </article>
  </div>
</section>

{/* ── DE EIGEN STIJLEN VAN DEZE KLANT ────────────────────────────────────────
    Dezelfde weg als de tegels in het bestelformulier (pipeline.js,
    addOwnStyles): /account/me draagt ze, en die vraag doet de layout al één
    keer per bezoek (window.visAccount, zie Layout.astro).

    DRIE DINGEN DIE DIT MET OPZET NIET DOET.
    · Het vraagt NIETS als de layout net heeft vastgesteld dat er niemand is
      ingelogd — dan kost een categoriepagina geen extra verzoek.
    · Er komt geen HTML uit de API de pagina in. Naam en regel gaan via
      textContent, de link wordt uit een id opgebouwd dat op cijfers is
      gecontroleerd. Zelfde discipline als addOwnStyles().
    · Het vak blijft verborgen als er niets past. Een lege kop "Jouw eigen look"
      is erger dan geen kop. */}
<script is:inline data-astro-rerun>
  (function () {
    var vak = document.querySelector('[data-sr-eigen]');
    if (!vak || typeof window.visAccount !== 'function') return;
    var lijst = vak.querySelector('[data-sr-eigen-lijst]');
    var dienst = vak.getAttribute('data-sr-dienst') || '';
    var basis = vak.getAttribute('data-sr-basis') || '';
    if (!lijst || !basis) return;

    /* Alleen overslaan als we NET hebben gezien dat er niemand is. Weten we het
       niet, dan hangt dit aan het verzoek dat de layout toch al doet. */
    try {
      var s = JSON.parse(sessionStorage.getItem('vis_acct') || 'null');
      if (s && s.v === 1 && Date.now() - s.at < 120000 && !s.in) return;
    } catch (e) { /* geen opslag is geen antwoord — gewoon vragen */ }

    window.visAccount().then(function (me) {
      var alle = me && Array.isArray(me.styles) ? me.styles : [];
      var past = alle.filter(function (st) {
        return st && /^\d{1,9}$/.test(String(st.id)) && (st.service === 'both' || st.service === dienst);
      });
      if (!past.length) return;

      past.forEach(function (st) {
        var li = document.createElement('li');
        li.className = 'sr-eigen-kaart';

        var fig = document.createElement('span');
        fig.className = 'sr-eigen-fig';
        if (st.preview) {
          var img = document.createElement('img');
          img.src = st.preview;
          img.alt = '';
          img.loading = 'lazy';
          img.decoding = 'async';
          fig.appendChild(img);
        }
        li.appendChild(fig);

        var body = document.createElement('span');
        body.className = 'sr-eigen-body';

        var naam = document.createElement('span');
        naam.className = 'sr-eigen-naam';
        naam.textContent = st.name || '';
        body.appendChild(naam);

        if (st.line) {
          var regel = document.createElement('span');
          regel.className = 'sr-eigen-regel';
          regel.textContent = st.line;
          body.appendChild(regel);
        }

        var a = document.createElement('a');
        a.className = 'btn btn-primary btn-sm';
        a.href = basis + '?style=cs-' + String(st.id);
        a.textContent = vak.getAttribute('data-sr-kies') || '';
        body.appendChild(a);

        li.appendChild(body);
        lijst.appendChild(li);
      });

      vak.hidden = false;
    });
  })();
</script>

<style>
  /* ── DE KOP VAN DE SECTIE ───────────────────────────────────────────────── */
  /* ── DE KOP VULDE 55% EN DE RIJEN ERONDER 100% — 13 september 2026 ──────
     Gemeten op 1440: de kop stond 702 breed in een kolom van 1277, de
     stijlrijen eronder 1147. Dat verschil van 445 pixels zie je, en het leest
     als "hier is iets vergeten".

     De lopende tekst mag NIET breder: 62ch is de leesbare regellengte en
     daarboven wordt een inleiding vervelend om te lezen. Wat wel kan is de
     twee FEITEN — wat je krijgt en wat het kost — naast de tekst zetten in
     plaats van eronder. De kop vult daarmee de breedte, de regel blijft even
     lang, en de prijs staat op de plek waar het oog na de kop naartoe gaat in
     plaats van drie regels lager. Onder 62rem staat alles weer onder elkaar. */
  /* ── DEZELFDE 316 PIXELS ALS BIJ FigWalk — 20 september 2026 ─────────────
     global.css zet `section { padding-block: clamp(4.5rem, 9vw, 9rem) }` voor
     de secties die een PAGINA opbouwen. Dit blok is ook een <section>, maar het
     staat binnen de <section class="paneel"> van /catalog, /lifestyle en
     /video — en die heeft zijn eigen 64 px al. Gemeten op 1440: 64 + 158,4 =
     222 px leegte boven "Stap 1 — kies je look", en nog eens 222 eronder.

     Niemand heeft die 158,4 gekozen; ze lekken uit een regel die over iets
     anders gaat. De ruimte die dit blok van zijn buren scheidt, komt van het
     paneel (64 px) en van de marge boven .sr-kamers, en die twee zijn wél
     gekozen. Zie dezelfde noot bij .wk in FigWalk.astro. */
  .sr { padding-block: 0; }

  .sr-top { max-width: 62ch; }
  @media (min-width: 62rem) {
    .sr-top { display: grid; grid-template-columns: minmax(0, 62ch) minmax(0, auto); gap: clamp(1.6rem, 4vw, 3.5rem); align-items: end; max-width: none; }
    .sr-top-feit { display: grid; gap: .55rem; justify-items: start; align-content: end; }
  }
  /* Sectie 21: de stap- en etiketlabels in de mono-stem van de site — sinds
     sectie 22 is dat Martian Mono, en de regel leest --font-mono, dus hij
     verhuisde vanzelf mee. Zoals de kopregels op de voorpagina: het label is
     een aantekening bij de kop, geen tweede kop. */
  .sr-stap {
    margin: 0 0 .6rem; font-family: var(--font-mono); font-stretch: 82%; font-size: .68rem; font-weight: 500;
    letter-spacing: .08em; text-transform: uppercase; color: var(--ink-3);
  }
  .sr-h2 { margin: 0; font-size: var(--t-page-h2, clamp(1.9rem, 4vw, 3rem)); line-height: 1.04; }
  .sr-intro { margin: .8rem 0 0; color: var(--ink-2); font-size: 1rem; line-height: 1.6; }
  .sr-levert {
    margin: 1rem 0 0; display: inline-flex; flex-wrap: wrap; gap: .4rem;
    padding: .4rem .75rem; border: 1px solid var(--line-strong); border-radius: 999px;
    font-size: .86rem; color: var(--ink-2);
  }
  /* .75rem: zie de noot in HeroFacts.astro — niets onder 11,5px. */
  .sr-levert span { font-family: var(--font-mono); font-stretch: 82%; font-size: .75rem; letter-spacing: .06em; text-transform: uppercase; color: var(--ink-3); align-self: center; }
  /* De zin die zegt dat het vel een ondergrens is en geen plafond. Zie de noot
     bij de markup. 46ch omdat hij in de rechterkolom van de kop staat en daar
     naast de inleiding moet passen zonder hem te verdringen. */
  .sr-levert-bij { margin: .7rem 0 0; font-size: .84rem; line-height: 1.55; color: var(--ink-3); max-width: 46ch; }

  .sr-eyebrow { margin: 0 0 .5rem; font-family: var(--font-mono); font-stretch: 82%; font-size: .68rem; font-weight: 500; letter-spacing: .08em; text-transform: uppercase; color: var(--ink-3); }
  .sr-alt-h { margin: 0; font-size: clamp(1.3rem, 2.2vw, 1.7rem); }
  /* .4rem was 6px na de regelhoogte van de kop — gemeten met
     kladblok/te-dicht.mjs, en dat is te krap voor een kop en zijn lead. Op
     .7rem staan ze als kop-met-uitleg en niet als twee regels die tegen
     elkaar aan liggen. */
  .sr-alt-sub { margin: .7rem 0 0; color: var(--ink-3); font-size: .92rem; line-height: 1.6; max-width: 60ch; }

  /* ═══ DE KAMERS ═════════════════════════════════════════════════════════
     Zie de noot bij de markup hierboven voor waarom elke look een eigen blok
     is. Wat hier volgt is de tweede ronde van 17 september.

     ── GEEN KLEUR MEER ────────────────────────────────────────────────────
     De eerste versie gaf elke kamer de tint van zijn look als grond, met een
     gekleurde balk erboven en een gekleurde plaat voor een ontbrekende foto.
     Lucas: *"Ik vind de style secties wat goedkoop ogen door allemaal van die
     kleuren toe te voegen. Dit moet gewoon echt strak en clean overkomen, meer
     white space, de foto's moeten die style sectie echt gevoel geven — niet
     kleuren eromheen."*

     Hij heeft gelijk en het is een fout met een naam: ik loste "deze looks
     voelen inwisselbaar" op met DECORATIE in plaats van met de foto's. Vier
     gekleurde vlakken maken vier verschillende vlakken, niet vier verschillende
     werelden — en een zandkleurig verloop achter een strandfoto vertelt precies
     niets wat die foto niet al zegt.

     Wat een look nu uit elkaar trekt: witruimte, formaat en de beelden zelf.
     Geen grond, geen rand, geen schaduw, geen ronding om over te praten, geen
     draaiing. Eén haarlijn tussen twee kamers, en verder lucht.

     De tint is niet weg uit de gegevens — TINT staat nog in de pagina's en de
     detailpagina's gebruiken hem. Hij staat alleen niet meer OM de foto's heen. */
  .sr-kamers {
    list-style: none; margin: clamp(2.4rem, 5vw, 4rem) 0 0; padding: 0;
    display: grid; gap: 0;
  }
  .sr-kamer {
    min-width: 0;
    display: grid; gap: clamp(1.2rem, 2.6vw, 2.2rem);
    grid-template-columns: minmax(0, 1fr) minmax(0, 14rem);
    grid-template-areas: "kop kop" "baan woord";
    align-items: start;
    /* 19 september 2026: van 2.2–3.6rem naar 1.6–2.6rem, en de set hieronder
       van 24rem naar 21rem hoog. Vier looks op /lifestyle waren 4.300 px;
       de doorlichting vroeg om 30–40 % kortere dienstpagina's, en de ruimte
       tussen twee looks was het grootste deel dat geen informatie droeg. */
    padding: clamp(1.6rem, 3.2vw, 2.6rem) 0;
  }
  /* De enige scheiding tussen twee looks. Niet eromheen maar ertussen: een
     kader maakt er een kaart van en een kaart maakt er weer een optie in een
     lijst van. */
  .sr-kamer + .sr-kamer { border-top: 1px solid var(--line); }

  /* ── .25rem WAS VIER PIXELS — 20 september 2026 ─────────────────────────
     Gemeten met kladblok/te-dicht.mjs op alle drie de dienstpagina's: tussen
     "Classic" (32 px) en "Strak. Consistent. Zonder concessies." zat 4 px. Bij
     een kop van die maat lezen die twee dan als één blok tekst met een rare
     regelafstand, en dat is precies waar Lucas op wees: *"wenkbrauwen die
     gelijk op de kop staan (…) alles moet rustig ogen dus ook whitespace
     bevatten."*

     .55rem is 9 px. Dezelfde ondergrens die .sr-alt-sub hierboven op
     17 september al kreeg, en om dezelfde reden genoteerd. */
  .sr-k-kop { grid-area: kop; display: grid; gap: .55rem; min-width: 0; margin-bottom: clamp(.6rem, 1.4vw, 1.1rem); }
  /* Groot, en met ruimte eromheen: dit is de naam van een wereld. Het plafond
     van 3,2rem is gemeten op "PHONE-MADE" in de smalste kolom waarin een kamer
     nog naast zijn tekst staat. */
  .sr-k-h {
    margin: 0; font-size: clamp(1.6rem, 3.2vw, 2.8rem); line-height: .96;
    letter-spacing: -.025em; text-wrap: balance;
  }
  .sr-k-tag { margin: 0; font-size: clamp(.98rem, 1.5vw, 1.15rem); color: var(--ink-2); max-width: 46ch; }

  /* ══ HET VEL ════════════════════════════════════════════════════════════
     Eén rij gelijke tegels, als een contactvel. Zie de lange noot bij de
     markup voor waarom dit ontwerp het geworden is; hier staat alleen hoe.

     DE ENIGE VARIABELE IS --sr-vr, de verhouding van één tegel. Alles
     daaromheen — de kolombreedtes, de tussenruimte, de stippellijn, het
     bijschrift — is op alle drie de dienstpagina's identiek. Dat was de
     opdracht: *"maak het enorm consistent om rust te bewaren."* */
  .sr-k-baan { grid-area: baan; min-width: 0; }
  .sr-k-vel {
    list-style: none; margin: 0; padding: 0; min-width: 0;
    display: grid; gap: clamp(.4rem, 1vw, .65rem);
    grid-template-columns: repeat(var(--sr-n, 3), minmax(0, 1fr));
    max-width: var(--sr-velmax, none);
  }
  /* De ingestuurde foto is de eerste kolom en hij is SMALLER — .78 tegen 1.
     Dat verschil doet het werk dat eerst een pijl en twee etiketten deden: je
     ziet in één blik dat die ene tegel van een andere orde is, zonder dat er
     een woord bij hoeft. Kleiner dan .78 en hij wordt een postzegel — precies
     de klacht waar dit ontwerp uit voortkomt. */
  .sr-k-vel.heeft-voor { grid-template-columns: .78fr repeat(var(--sr-n, 3), minmax(0, 1fr)); }
  .sr-k-tegel { min-width: 0; display: flex; flex-direction: column; }
  /* ── ALLE BIJSCHRIFTEN OP ÉÉN LIJN ──────────────────────────────────────
     De ingestuurde foto is .78 zo breed als de rest en heeft dezelfde
     verhouding, dus zou hij ook .78 zo hoog zijn — en dan staat "JOUW FOTO"
     twintig procent hoger dan de bijschriften ernaast. Zeven tegels met hun
     naam op twee verschillende hoogtes is precies de onrust die dit ontwerp
     moest wegnemen. Dus rekt dat ene vak mee tot de hoogte van de rij (de
     tegel staat toch al op stretch) en snijdt de telefoonfoto een fractie
     smaller — wat hij toch al is. */
  @media (min-width: 64.01rem) {
    .sr-k-tegel.is-voor .sr-k-vak { aspect-ratio: auto; flex: 1 1 auto; min-height: 0; }
  }

  .sr-k-vak {
    display: block; overflow: hidden; border-radius: 2px;
    background: var(--paper-2); aspect-ratio: var(--sr-vr, 3 / 4); min-width: 0;
  }
  .sr-k-vak img, .sr-k-vak :global(.vis) { width: 100%; height: 100%; object-fit: cover; display: block; }
  /* Stippellijn, en verder niets. Geen kleur, geen schaduw, geen draaiing —
     zie de noot bij .sr-kamers over waarom decoratie hier eerder is weggehaald
     dan toegevoegd. De stippel is het stilste teken dat "dit is invoer, geen
     resultaat" zegt, en hij zegt het ook in zwart-wit. */
  .sr-k-tegel.is-voor .sr-k-vak {
    background: var(--paper);
    box-shadow: none; border: 1px dashed var(--line-strong);
  }
  /* ── EEN VAK WAAR DE FOTO NOG VOOR GEMAAKT WORDT ───────────────────────
     Geen kleur en geen streepjespatroon — dat was precies het "goedkoop" waar
     Lucas op wees. Wat overblijft is het stilste dat nog iets zegt: een leeg
     vlak in de papierkleur, een haarlijn eromheen, en de naam van het beeld
     dat er komt. Naast een echte foto leest dat als een gereserveerd kader. */
  .sr-k-vak.is-plaat {
    display: grid; place-items: center; padding: .5rem;
    background: var(--paper);
    box-shadow: 0 0 0 1px var(--line) inset;
  }
  /* Alleen voor wie de pagina hoort: het vak is leeg en dat is te zien, maar
     niet te horen. Zelfde truc als .sr-only elders; hier lokaal omdat deze
     component zijn eigen stijl draagt. */
  .sr-verborgen {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0;
  }
  /* Het bijschrift onder elke tegel: "JOUW FOTO" en "01 · VOORKANT". Daarmee
     draagt het vel het aantal én de inhoud, en hoeft er onder de rij geen
     opsomming meer te staan die hetzelfde nog eens zegt.
     .72rem en niet .68: gemeten 10,9 px, net onder de 11,5 die dit project
     aanhoudt. */
  .sr-k-bij {
    margin: .5rem 0 0; font-family: var(--font-mono); font-size: .72rem;
    letter-spacing: .07em; text-transform: uppercase; color: var(--ink-3); line-height: 1.3;
    text-wrap: balance;
  }
  .sr-k-bij.is-na { color: var(--ink-2); }
  /* Een beeld dat nog gemaakt moet worden houdt zijn plek en zijn naam, maar
     niet het gewicht van een beeld dat er al is. Eén tint lichter is genoeg —
     en het is dezelfde tint als "JOUW FOTO", dus er komt geen derde kleur bij. */
  .sr-k-bij.is-na.is-volgt { color: var(--ink-3); }

  /* ── HET WOORD ───────────────────────────────────────────────────────── */
  .sr-k-woord { grid-area: woord; display: flex; flex-direction: column; gap: .7rem; min-width: 0; }
  .sr-k-best { margin: 0; font-size: .85rem; line-height: 1.55; }
  .sr-k-cta { margin-top: .4rem; display: grid; justify-items: start; gap: .6rem; }
  .sr-t-prijs { margin: 0; font-weight: 700; font-size: .9rem; font-variant-numeric: tabular-nums lining-nums; }
  .sr-t-knop { font-size: .84rem; padding: .55rem 1rem; max-width: 100%; text-wrap: balance; }

  /* De gedeelde prijs, één keer, bij de kop waar hij hoort. */
  .sr-kopprijs {
    margin: .7rem 0 0; font-weight: 700; color: var(--ink);
    font-size: .95rem; font-variant-numeric: tabular-nums lining-nums;
  }

  /* ── DE WAAIER ─────────────────────────────────────────────────────────────
     Kaarten op vaste plekken in een 4:3-vak, elk iets gedraaid, de grootste
     vooraan. Alle maten in procenten van het vak, dus op 390 px dezelfde stapel
     als op 1440.

     ── DE GLOED IS ERAF — 20 september 2026 ────────────────────────────────
     Hier stond een weerkaatsing: een breed, laag radiaal verloop in de
     accentkleur, 34px onscherp, onder de stapel. Dat was op de limoengrond een
     verdedigbaar effect, maar het violette schema verbiedt het op drie punten
     tegelijk — *"Nooit 1: geen verloop, nergens"*, *"Nooit 2: geen gloed en
     geen schaduw in de accentkleur"* en *"Nooit 4: violet nooit als grote
     vulling"*. Een onscherpe violette vlek van 4:3 onder elke stapel is precies
     die grote vulling.

     Wat het deed — de stapel zijn eigen kleur geven — doet het schema met de
     foto's zelf: *"de foto's zijn het grootste gekleurde object op elke
     pagina, niet de interface"*. Er gaat dus niets verloren; er gaat een laag
     af die er niet had mogen zijn. Gemeten was hij op de lichte grond
     bovendien nauwelijks zichtbaar (13% van violet, 34px uitgesmeerd).

     `--sr-tint` stond hier ook, en is meegegaan: binnen de waaier gebruikte
     alleen die gloed hem. `.sr-streep` verderop leest hem van `.sr-kamer` /
     `.sr-maat`, waar de look zijn eigen tint zet — dat pad loopt niet via de
     waaier en verandert dus niet. */
  .sr-fan { display: block; position: relative; aspect-ratio: 4 / 3; isolation: isolate; }
  .sr-card {
    position: absolute; display: block; overflow: hidden; border-radius: 12px;
    /* ── EEN LIJN, GEEN SLAGSCHADUW — 20 september 2026 ────────────────────
       Hier stond `0 16px 34px -20px rgb(0 0 0 / .7)`: diepte uit onscherpte.
       KLEURENSCHEMA "Altijd 5" zegt dat diepte uit een lijn of een tweede vlak
       komt en nooit uit een schaduw, en de rand die ernaast stond was een
       overblijfsel van de donkere site — wit op 9% is op deze grond niets.

       De stapel overlapt zichzelf, dus de scheiding moet er WEL zijn: elke
       kaart krijgt daarom een echte haarlijn in inkt. Die leest over een lichte
       foto én over een donkere, waar een witte rand alleen over een donkere
       leest en een schaduw alleen over een lichte. */
    background: var(--paper-2); border: 1px solid rgb(0 0 0 / 0.17);
    transform: rotate(var(--r)) translate(0, 0);
    transition: transform .7s cubic-bezier(.16,1,.3,1);
  }
  .sr-card img, .sr-card :global(.vis) { width: 100%; height: 100%; object-fit: cover; display: block; }

  /* VIER KAARTEN — drie geleverde beelden plus de telefoonfoto (lifestyle).
     Ook de terugval voor een look die geen telefoonfoto meegeeft. */
  .sr-card-1 { left: 2%;  top: 13%; width: 34%; aspect-ratio: 3 / 4; --r: -5deg; z-index: 1; }
  .sr-card-2 { left: 30%; top: 4%;  width: 40%; aspect-ratio: 3 / 4; --r: 2deg;  z-index: 3; }
  .sr-card-3 { left: 66%; top: 15%; width: 32%; aspect-ratio: 3 / 4; --r: 6deg;  z-index: 2; }
  .sr-card-4 { left: 56%; top: 61%; width: 23%; aspect-ratio: 3 / 4; --r: -3deg; z-index: 4; }

  /* VIJF — een catalogset van vier plus de telefoonfoto: vier op een rij, licht
     waaierend, de telefoonfoto klein onder het midden. */
  .sr-fan[data-n="5"] .sr-card { aspect-ratio: 1 / 1; }   /* een catalogset is vierkant */
  .sr-fan[data-n="5"] .sr-card-1 { left: 0%;  top: 17%; width: 27%; --r: -6deg; z-index: 1; }
  .sr-fan[data-n="5"] .sr-card-2 { left: 21%; top: 4%;  width: 33%; --r: -1deg; z-index: 3; }
  .sr-fan[data-n="5"] .sr-card-3 { left: 48%; top: 9%;  width: 29%; --r: 3deg;  z-index: 2; }
  .sr-fan[data-n="5"] .sr-card-4 { left: 73%; top: 20%; width: 26%; --r: 7deg;  z-index: 1; }
  .sr-fan[data-n="5"] .sr-card-5 { left: 40%; top: 63%; width: 21%; aspect-ratio: 3 / 4; --r: -3deg; z-index: 5; }

  /* DRIE — twee beelden plus de telefoonfoto. */
  .sr-fan[data-n="3"] .sr-card-1 { left: 6%;  top: 13%; width: 37%; --r: -5deg; z-index: 1; }
  .sr-fan[data-n="3"] .sr-card-2 { left: 37%; top: 3%;  width: 42%; --r: 2deg;  z-index: 3; }
  .sr-fan[data-n="3"] .sr-card-4 { left: 62%; top: 58%; width: 24%; --r: -3deg; z-index: 4; }

  /* ÉÉN — een look die (nog) één beeld heeft en geen telefoonfoto: de kaart
     staat gecentreerd en groter, zodat het niet leest als een stapel waar er
     drie zijn weggevallen. */
  .sr-fan[data-n="1"] .sr-card-2 { left: 28%; top: 4%; width: 44%; aspect-ratio: 3 / 4; --r: -2deg; }

  /* TWEE — één geleverd beeld plus de telefoonfoto. Zo staat video erbij: je
     krijgt één clip, dus er hangt één kaart. Rechtop, want een clip is voor een
     feed en dus staand. */
  .sr-fan[data-n="2"] .sr-card-2 { left: 17%; top: 2%;  width: 37%; aspect-ratio: 9 / 16; --r: -2deg; z-index: 3; }
  .sr-fan[data-n="2"] .sr-card-4 { left: 58%; top: 34%; width: 26%; aspect-ratio: 9 / 16; --r: 4deg;  z-index: 4; }

  /* De telefoonfoto: een smallere kaart met een dikkere lichte rand, zoals een
     telefoonscherm, en het etiket in de hoek. De grote kaart krijgt GELEVERD. */
  /* ── DE VOOR-KAART HEEFT EEN BODEM — 8 september 2026 ────────────────────
     Het etiket "Ingestuurd" is 87px breed en de kaart was op een telefoon 70px:
     er stond "INGESTU" en de rest lag buiten de kaart, die afknipt. In de
     mediaquery hieronder stond daar een reparatie voor — `.sr-etiket` op .5rem
     — maar die verloor het van `.s22.s22 .sr-etiket` en deed dus al een tijd
     niets. Kleiner mocht sowieso niet: 11,52px is de ondergrens van de
     leesbaarheidskeuring, en dat is precies wat dit etiket meet.
     Dus niet de letter kleiner maar de kaart groter, en alleen waar het nodig
     is: 6,4rem is 102px, ruim boven de 87 van het woord, en op een breed scherm
     is de kaart met zijn 112px toch al groter — daar verandert er niets. */
  .sr-card.is-voor { aspect-ratio: 3 / 4; border: 2px solid rgb(255 255 255 / 0.5); border-radius: 10px; min-width: 6.4rem; }
  .sr-etiket {
    position: absolute; left: .4rem; bottom: .4rem; z-index: 2;
    padding: .2em .5em; border-radius: 999px;
    font-family: var(--font-mono); font-stretch: 82%; font-size: .58rem; line-height: 1.2; font-weight: 500; letter-spacing: .06em; text-transform: uppercase;
    background: rgb(17 17 17 / 0.72); color: #fff; box-shadow: inset 0 0 0 1px rgb(255 255 255 / .18); backdrop-filter: blur(6px); white-space: nowrap;
  }
  /* GELEVERD staat bovenaan en INGESTUURD onderaan. Ze stonden allebei
     linksonder, en in een stapel die elkaar overlapt betekent dat: het etiket van
     de grote kaart landt op de tekst van de kaart erachter (op 390 px viel
     "Geleverd" over "Achterkant"). Boven en onder houdt ze uit elkaar en zet het
     de twee woorden bovendien in de volgorde waarin je ze leest. */
  .sr-etiket.is-na { top: .4rem; bottom: auto; background: var(--accent); color: var(--accent-ink); }
  .sr-card.is-leeg { border-style: dashed; border-color: var(--line-strong); background: var(--paper); display: grid; place-items: center; }
  /* 10,6px in de lijnkleur (--ink-4, 2,8:1) — twee keer onleesbaar in één
     regel, en het is de tekst die zegt WELKE foto er nog moet komen. Lucas:
     *"Wel even altijd goed controleren op leesbaarheid."* Nu 12px en --ink-3,
     dezelfde behandeling als .sr-komend-voet een paar regels verderop.
     7 september 2026. */
  .sr-leeg { font-size: .75rem; letter-spacing: .08em; text-transform: uppercase; color: var(--ink-3); text-align: center; padding: .4rem; }

  /* Rustiger dan het uit elkaar waaieren dat hier stond: de stapel komt een
     haar omhoog. (De regel die de weerkaatsing sterker maakte hoorde bij de
     gloed en is met de gloed mee verdwenen.) */
  @media (hover: hover) {
    .sr-maat:hover .sr-card-2 { transform: rotate(1deg) translate(0, -1.5%); }
    .sr-maat:hover .sr-card-1 { transform: rotate(-6deg) translate(-1%, .5%); }
    .sr-maat:hover .sr-card-3 { transform: rotate(7deg) translate(1%, .5%); }
  }

  .sr-fan.is-lead { align-self: center; }
  .sr-body { min-width: 0; }
  .sr-h { margin: 0; font-size: clamp(1.8rem, 3vw, 2.5rem); line-height: 1; }
  /* Sectie 21: rechtop. De cursief was de accenttaal van sectie 19; de site zet
     een accentwoord nu als geel vlak of gewoon rechtop, nooit schuin. */
  .sr-h em { font-style: normal; }
  /* Het enige plekje waar de kleur van de look als KLEUR terugkomt: een streepje
     van 34 px onder de naam. Dat doet wat de gloed deed — de looks uit elkaar
     houden — zonder een lamp achter de foto's te zetten. */
  .sr-streep { display: block; width: 34px; height: 2px; margin-top: .7rem; border-radius: 2px; background: var(--sr-tint, var(--accent)); opacity: .85; }
  .sr-tag { margin: .7rem 0 0; font-size: 1.05rem; color: var(--ink-2); }
  .sr-desc { margin: .8rem 0 0; color: var(--ink-2); font-size: .97rem; line-height: 1.6; max-width: 56ch; }
  .sr-best { margin: .8rem 0 0; font-size: .88rem; color: var(--ink-3); line-height: 1.5; }
  .sr-best-l { font-weight: 700; color: var(--ink-2); margin-right: .25rem; }
  /* Rustiger dan de accentkleur die hier stond: op deze pagina is het accent de
     KNOP, en een prijs in dezelfde kleur trekt de aandacht weg van de handeling. */
  .sr-price { margin: .9rem 0 0; font-weight: 700; color: var(--ink); font-size: .95rem; font-variant-numeric: tabular-nums lining-nums; }
  .sr-cta { margin-top: 1.2rem; display: flex; flex-wrap: wrap; align-items: center; gap: 1rem; }
  /* De tweede handeling is een link en geen knop — zie de noot bovenaan. */
  .sr-link {
    display: inline-flex; align-items: center; gap: .35rem;
    font-size: .92rem; font-weight: 700; color: var(--ink-2);
    text-decoration: none; border-bottom: 1px solid var(--line-strong);
    padding-bottom: .12rem;
    transition: color var(--dur-1) var(--ease), border-color var(--dur-1) var(--ease);
  }
  .sr-link .i { width: 15px; height: 15px; fill: none; stroke: currentColor; stroke-width: 2; }
  .sr-link:hover { color: var(--ink); border-color: var(--accent); }
  .sr-link:focus-visible { outline: 2px solid var(--focus-ring); outline-offset: 3px; }

  /* ── JOUW EIGEN LOOK ────────────────────────────────────────────────────── */
  .sr-eigen {
    margin-top: clamp(1.6rem, 3vw, 2.4rem);
    padding: clamp(1.1rem, 2.2vw, 1.6rem);
    border: 1px solid var(--accent-line, var(--line-strong)); border-radius: var(--r-lg);
    background: var(--accent-soft, var(--paper-2));
  }
  .sr-eigen-lijst { list-style: none; margin: 1rem 0 0; padding: 0; display: grid; gap: .8rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr)); }
  .sr-eigen-kaart {
    display: grid; grid-template-columns: 5.5rem minmax(0, 1fr); gap: .9rem; align-items: center;
    padding: .7rem; border: 1px solid var(--line-strong); border-radius: var(--r-md); background: var(--surface);
  }
  .sr-eigen-fig { display: block; aspect-ratio: 4 / 5; border-radius: var(--r-sm); overflow: hidden; background: var(--paper-2); }
  .sr-eigen-fig img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .sr-eigen-body { display: grid; gap: .3rem; justify-items: start; min-width: 0; }
  .sr-eigen-naam { font-family: var(--font-display); font-weight: 800; font-size: 1.05rem; color: var(--ink); }
  .sr-eigen-regel { font-size: .86rem; color: var(--ink-3); line-height: 1.5; }
  .sr-eigen-kaart .btn { margin-top: .3rem; }

  /* ── IN DE MAAK, IN ÉÉN REGEL — 23 september 2026 ──────────────────────
     Kop links, de looks als tekst rechts. Geen beeld: wat er nog niet is,
     hoort niet het grootste op de pagina te zijn. */
  .sr-komend { margin-top: clamp(1.6rem, 3vw, 2.4rem); padding-top: clamp(1.2rem, 2.4vw, 1.6rem); border-top: 1px solid var(--line); display: grid; gap: .8rem; }
  @media (min-width: 62rem) {
    .sr-komend { grid-template-columns: minmax(0, 16rem) minmax(0, 1fr); gap: clamp(1.6rem, 4vw, 3.2rem); align-items: baseline; }
  }
  .sr-komend-rechts { display: grid; gap: .5rem; min-width: 0; }
  .sr-komend-lijst { list-style: none; margin: 0; padding: 0; display: grid; gap: .35rem; }
  .sr-komend-naam { font-weight: 700; color: var(--ink); }
  .sr-komend-regel { font-size: .92rem; color: var(--ink-2); line-height: 1.55; }
  .sr-komend-noot { margin: 0; font-size: .86rem; color: var(--ink-2); }

  /* ── OP MAAT, ALS SMALLE BALK ───────────────────────────────────────────── */
  .sr-maat {
    display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: clamp(1.2rem, 3vw, 3rem); align-items: center;
    margin-top: clamp(1.6rem, 3vw, 2.4rem);
    padding: clamp(1.2rem, 2.4vw, 1.8rem);
    border: 1px solid var(--line-strong); border-radius: var(--r-lg);
    background: var(--paper-2);
  }
  .sr-maat-body { display: grid; gap: .1rem; min-width: 0; }
  .sr-maat-h { margin: 0; font-size: clamp(1.4rem, 2.4vw, 1.9rem); line-height: 1.05; }
  .sr-maat-stappen { margin: .6rem 0 0; font-size: .9rem; color: var(--ink-2); line-height: 1.5; }
  .sr-maat-zij { display: grid; gap: .2rem; justify-items: start; }
  .sr-maat-zij .sr-price { margin: 0; }
  .sr-maat-zij .sr-cta { margin-top: .6rem; }

  /* ── HET BREEKPUNT STOND OP 52rem EN DAT WAS TE LAAG — 12 sept 2026 ─────
     Gemeten op een tablet van 834 pixels (iPad in portret): 52rem is 832, dus
     zo'n scherm viel nét in de BREDE modus. Drie videolooks kregen daar
     kolommen van 218 pixels, en de knop "Kies deze look" is er 239 tot 298 —
     die stak dus 21 tot 80 pixels buiten zijn eigen tegel, over de buurtegel
     heen.

     64rem (1024) zet elke tablet in portret op twee ruime kolommen van zo'n
     390 pixels. Dat lost niet alleen de knop op: drie beelden van 218 pixels
     naast elkaar op een scherm van die maat waren sowieso te klein om iets aan
     te zien, en dit is de sectie waar de bezoeker zijn look uitkiest. */
  @media (max-width: 64rem) {
    /* De kaarten worden op een telefoon smaller dan het etiket breed is, en
       .sr-card knipt af (overflow: hidden) — "Ingestuurd" stond er half op.
       Kleiner lettertype en minder ruimte eromheen houdt het woord heel. */
    /* Het lettertype NIET kleiner — zie de noot bij .sr-card.is-voor. Wat hier
       blijft staan is de plaatsing: strakker tegen de hoek, zodat er meer kaart
       overblijft voor het woord zelf. */
    .sr-etiket { padding: .18em .4em; letter-spacing: .04em; left: .3rem; bottom: .3rem; }
    .sr-etiket.is-na { top: .3rem; }
    /* ── DE KAMER OP EEN TELEFOON ────────────────────────────────────────
       Eén kolom: naam, vel, woord. Gemeten op 390 en 430px. */
    .sr-kamer {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: "kop" "baan" "woord";
      gap: 1rem; padding: 1rem .9rem 1.2rem;
    }
    /* ── HET VEL OP EEN TELEFOON — 20 september 2026 ──────────────────────
       Vijf tegels naast elkaar in 340 px is 60 px per beeld: dan is het geen
       contactvel meer maar een strook postzegels. Het vel blijft dus hetzelfde
       vel, alleen met omslag: de tegels vullen rijen van minstens 4,75rem
       breed. Op 390 px zijn dat er drie per rij, op 560 vier of vijf.

       De ingestuurde foto blijft de eerste tegel en dus linksboven, en hij
       houdt zijn stippellijn — daaraan herken je hem, niet aan zijn plaats in
       de rij. Vandaar dat de kolombreedte van .78fr hier vervalt en de
       stippel niet: het teken dat blijft werken is het teken dat blijft. */
    /* 7rem: op 390 px zijn dat twee kolommen van ~143 px, op een grotere
       telefoon of een tablet drie of vier. Twee is het getal waarop lifestyle
       (drie beelden plus de foto) precies uitkomt en waarop een tegel nog een
       beeld is en geen postzegel. En de tegels rekken hier NIET mee met de
       hoogste buur: een bijschrift dat op de ene tegel twee regels beslaat en
       op de andere één mag de foto's niet ongelijk maken. */
    .sr-k-vel,
    .sr-k-vel.heeft-voor { grid-template-columns: repeat(auto-fill, minmax(7rem, 1fr)); max-width: none; align-items: start; }
    .sr-k-bij { white-space: normal; }
    .sr-k-cta { justify-items: stretch; }
    .sr-t-knop { text-align: center; }
    .sr-maat { grid-template-columns: 1fr; }
    /* De oude twee regels hier zetten de tekstrijen op smal om. Het raster
       hierboven doet dat nu zelf met auto-fit, dus er valt niets meer om te
       zetten. */
    .sr-eigen-kaart { grid-template-columns: 4.5rem minmax(0, 1fr); }
  }
  /* ── TWEE LOOKS NAAST ELKAAR — 19 september 2026 ──────────────────────────
     Lucas, na de eerste snoeironde: *"Diepere snoei op /catalog e.d. …
     doorvoeren."* Vier looks onder elkaar op /lifestyle waren 2.800 px, de
     zes op /video 3.500: elke look een volle band van kop, baan en woord.
     Op breed staan ze nu twee naast elkaar, elk als één kolom (kop, baan,
     woord) met een smaller vel. Wat blijft: dezelfde rij tegels met dezelfde
     bijschriften — alleen kleiner en met z'n tweeën in het beeld, want de
     tegels schalen mee met de kolom. Eén look (Catalog)
     houdt de volle breedte: één kolom van de helft naast niets is geen raster
     maar een gat. */
  @media (min-width: 64.01rem) {
    .sr-kamers:has(.sr-kamer + .sr-kamer) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: clamp(2rem, 4vw, 3.5rem);
    }
    .sr-kamers:has(.sr-kamer + .sr-kamer) .sr-kamer {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: "kop" "baan" "woord";
      gap: 1rem; padding: clamp(1.4rem, 2.4vw, 2rem) 0;
      border-top: 1px solid var(--line);
    }
    .sr-kamers:has(.sr-kamer + .sr-kamer) .sr-k-kop { margin-bottom: 0; }
    .sr-kamers:has(.sr-kamer + .sr-kamer) .sr-k-h { font-size: clamp(1.4rem, 2.2vw, 2rem); }
    .sr-kamers:has(.sr-kamer + .sr-kamer) .sr-k-tag { font-size: .98rem; }
    .sr-kamers:has(.sr-kamer + .sr-kamer) .sr-k-woord {
      flex-direction: row; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: .6rem 1.2rem;
    }
    .sr-kamers:has(.sr-kamer + .sr-kamer) .sr-k-best { flex: 1 1 16rem; }
