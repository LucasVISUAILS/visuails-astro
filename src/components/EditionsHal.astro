 * DEZELFDE INHOUD ALS EditionsPage.astro: de frontmatter hieronder (COPY, de
 * bedragen en aantallen uit pricing.js, het kopbeeld zodra editions-maandgrid
 * er is) is daar letterlijk uit overgenomen. Dezelfde vijf blokken: wat het is ·
 * de twee sets naast elkaar · wat het kost · vragen · slot met de Studiobrief.
 * Editions is binnenkort: de knoppen gaan naar een gesprek en naar de
 * abonnementen. Wat in de tekst anders is, staat in kladblok/TEKSTEN-VIDEO.md.
 * ═══════════════════════════════════════════════════════════════════════════ */
import '@fontsource-variable/urbanist/index.css';
import '../styles/hal.css';
import { ikoon, IKOON } from '../data/iconen.js';
import HalVragen from './HalVragen.astro';
import Disclose from './Disclose.astro';
