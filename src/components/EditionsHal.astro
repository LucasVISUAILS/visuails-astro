      ['De stille dagen', 'tussen de ene drop en de volgende.'],
      ['Stories en reels', 'die een achtergrond nodig hebben en geen product.'],
      ['Je grid', 'zodat er geen drie packshots naast elkaar komen te staan.'],
      ['Mail en banners', 'waar het product al in woorden genoemd wordt.'],
    ],

    hoeH: 'Eén keer opzetten, daarna loopt hij elke maand.',
    hoe: [
      ['Wij zetten je merk op', 'Stijl, locaties en kleurenpalet bepalen we samen en leggen we daarna vast. Dat is het eenmalige deel, en het is wat maand elf op maand één laat lijken.'],
      ['Dezelfde opzet draait opnieuw', 'Elke maand, met andere invalshoeken erin. Niet elke keer een nieuw idee — hetzelfde merk, van een andere kant gezien.'],
      ['Wij kijken hem na', 'Voordat hij landt: de kleuren moeten kloppen, en de set moet als één merk lezen in plaats van als twintig losse beelden.'],
      ['Hij komt in VISUAILS Studio', 'Aan het begin van de maand, naast je bestellingen. Eén plek, één download, geen tweede bibliotheek om bij te houden.'],
    ],
    hoeFoot: 'Er gaat geen product van jou in, dus je hoeft ons maandelijks niets te sturen. Na de opzet doe jij niets meer.',

    prijsH: 'Wat Editions kost',
    prijsMaand: `<strong>${maand} per maand</strong> ${vatLabel('excl', 'nl')}, bovenop je abonnement.`,
    prijsOpzet: `<strong>${opzet} eenmalig</strong> om je stijl op te zetten.`,
    prijsWaaromH: 'Waarom twee bedragen en niet één',
    prijsWaarom: 'Omdat er twee verschillende dingen gebeuren. De opzet is werk dat één keer per merk gedaan wordt; de maand is de set zelf. De opzet in het maandbedrag vouwen zou hem uitsmeren over maanden waar je nog niet aan vastzit — en dan hangt de prijs stilletjes af van hoe lang je blijft.',
    zekerH: 'Waar je op kunt rekenen.',
    zeker: [
      `${STOCK_ON_BRAND} beelden per maand`,
      'Alleen voor jouw merk gemaakt',
      'In VISUAILS Studio bij je bestellingen',
      reviewClaim('unattended', 'nl'),
    ],
    prijsCta: 'Praat met ons over Editions',

    rechtMeta: '( Rechten en vermelding )',
    rechtH: 'Gedeeld betekent gedeeld, en dat zeggen we liever hier dan in de kleine lettertjes.',
    rechtP: [
      'Onze klanten zijn kledingmerken, en dus elkaars concurrenten. Twee merken die hetzelfde beeld plaatsen staan in dezelfde feed voor dezelfde koper, dus een gedeelde maandset is geen detail om weg te stoppen — het is het eerste wat je moet weten over de helft die niets kost.',
      'De twee sets dragen daarom twee verschillende licenties, en in het bestand dat meekomt staat welke van de twee je hebt. De maandset is niet-exclusief: van jou om te bewerken, te publiceren en commercieel te gebruiken, en van jou om te houden als je opzegt, maar hetzelfde beeld kan bij een ander merk opduiken. Editions is exclusief, net als elke bestelling die je plaatst — niemand anders mag die beelden gebruiken.',
    ],
    rechtLijst: [
      ['Allebei met AI gemaakt, en dat staat in het bestand', `Elk bestand draagt een machineleesbare herkomsttag: “${TAG_WOORD[MAANDSETTAG].nl}”${MAANDSETTAG === LEVERTAG ? ', dezelfde waarde als elke levering van ons' : `, de sterkste van de twee waardes, omdat er geen foto van jou in zit (een eigen bestelling zegt “${TAG_WOORD[LEVERTAG].nl}”)`}. De zichtbare vermelding op je eigen post plaats je nog steeds zelf; op <a href="${lp('/ai-act')}">de AI-verordeningspagina</a> staat de zin.`],
      ['Geen gezichten, in geen van beide sets', 'Modellen per set kiezen maakt van een maandelijkse ronde elke keer een controleronde, en dát is wat het duur zou maken. Verandert dat, dan staat het hier als eerste.'],
      ['Zeg je op, dan hou je wat je hebt opgehaald', 'Allebei de licenties blijven na het abonnement staan. Er hoeft niets offline; je krijgt alleen geen nieuwe sets meer.'],
    ],

    faqs: serviceFaqs('editions', 'nl'),
    ctaH: 'Vul de maand waar <br>je niets voor hebt.',
    ctaP: `${STOCK_OFF_BRAND} gedeelde beelden zitten bij elk abonnement. ${STOCK_ON_BRAND} eigen beelden kosten ${maand} per maand, na een opzet van ${opzet}.`,
    belofte: 'Geen van beide sets loopt al; er wordt niets afgeschreven.',
  },
};
const c = COPY[lang];

/* ── DE HAL ────────────────────────────────────────────────────────────── */
/* Een kop met een <br> wordt de kop in twee tonen: eerst het lichte deel. */
const tonen = (h: string) => h.split(/<br\s*\/?>/).map((d) => d.replace(/<[^>]+>/g, '').trim());
const pil = (s: string) => s.replace(/^\(\s*|\s*\)$/g, '');
/* De iconen uit het kit (levering 54, afvinklijst 34): links de naam in dit
   onderdeel, rechts het icoon in src/data/iconen.js. */
const ICOON = { rechts: 'pijl', pijl: 'pijl-schuin', check: 'vink', klok: 'klok' } as const;
const ik = (n: keyof typeof ICOON) => ikoon(ICOON[n]);
const H = nl ? {
  vgl: ['Twee sets, en maar', 'één ervan kost iets.'], zeker: ['Waar je op', 'kunt rekenen.'],
  vglPil: 'Twee sets', prijsPil: 'Wat het kost', slotPil: 'Editions',
} : {
  vgl: ['Two sets, and only', 'one of them costs anything.'], zeker: ['What you', 'can count on.'],
  vglPil: 'Two sets', prijsPil: 'What it costs', slotPil: 'Editions',
};
const feiten = [...c.trust, (nl ? ['Elke maand', 'zodra Editions loopt'] : ['Every month', 'once Editions runs'])];
/* Het beeld in de opening: afvinklijst 20 (v20-opening a), live sinds afvinklijst 21. Zolang het eigen
   beeld er niet is, staat er de getalkaart; staat het er, dan wint het eigen beeld (v21-beelden a). */
const kaartBeeld = !kopBeeld;
const BEELD = {
  soort: 'getal' as const,
  label: lang === 'nl' ? 'Editions · per maand' : 'Editions · per month',
  getal: String(STOCK_OFF_BRAND), eenheid: lang === 'nl' ? 'beelden' : 'images',
  voet: lang === 'nl' ? `Bij elk abonnement. ${STOCK_ON_BRAND} extra, alleen op jouw merk gebouwd: ${maand} per maand.` : `With every plan. ${STOCK_ON_BRAND} more, built on your brand alone: ${maand} a month.`,
};
---
<div class="h-pagina h-ed">

  {/* ── 1 · DE KOP ─────────────────────────────────────────────────────────── */}
  <header class:list={['h-paginakop', 'h-hk-kop', kopBeeld && 'met-beeld', kaartBeeld && 'met-kopbeeld']}>
    <div class="h-hk-kop-tekst">
      <p class="h-pil h-op" style="--d:0"><span>{pil(c.eyebrow)}</span></p>
      <h1 class="h-kop h-h1 h-op" style="--d:1"><span class="l">{tonen(c.h1)[0]}</span> <span>{tonen(c.h1)[1]}</span></h1>
      <p class="h-lede h-op" style="--d:2">{c.lead}</p>
      <p class="h-acties h-op" style="--d:3">
        <a class="h-knop h-knop-inkt" href={lp('/contact')}>{c.ctaPrimary}<span class="o" set:html={ik('rechts')} /></a>
        <a class="h-knop h-knop-lijn" href={lp('/plans')}>{c.ctaPlans}</a>
      </p>
      <ul class="h-feiten h-vd-feiten h-op" style="--d:4" role="list">
        {feiten.map(([sterk, rest]) => <li><span><b>{sterk}</b> {rest}</span></li>)}
      </ul>
      <p class="h-vd-wacht h-op" style="--d:5"><span class="h-chip h-pl-tag">{c.soonTag}</span> {c.queueNote}</p>
    </div>
    {kaartBeeld && <KopBeeld {...BEELD} />}
    {kopBeeld && (
      <figure class="h-hk-kop-beeld h-op" style={`--d:2; aspect-ratio: ${r('maandgrid')}`}>
        <img src={kopBeeld.src} alt={p('maandgrid', 'subject')} width={kopBeeld.w} height={kopBeeld.h} decoding="async" fetchpriority="high" />
      </figure>
    )}
  </header>

  {/* ── 2 · DE GEDEELDE SET EN DE EIGEN SET ──────────────────────────────── */}
  <section class="h-sec h-ed-vgl-sec" aria-labelledby="ed-vgl">
    <header class="h-sec-kop h-in">
      <div>
        <p class="h-pil"><span>{H.vglPil}</span></p>
        <h2 id="ed-vgl" class="h-kop h-h2"><span class="l">{H.vgl[0]}</span> {H.vgl[1]}</h2>
      </div>
      <p class="h-vs-kopzin">{c.vglSub}</p>
    </header>
    <ul class="h-ed-vgl" role="list">
      {[c.gedeeld, c.eigen].map((kolom, i) => (
        <li class:list={['h-in', i === 1 && 'is-eigen']} style={`--d:${i}`}>
          <p class="h-ed-vgl-kop"><b>{kolom.naam}</b> <span class="h-chip h-chip-wit">{kolom.tag}</span></p>
          <dl class="h-ed-rijen">
            {kolom.rijen.map(([label, waarde]) => <div><dt>{label}</dt><dd>{waarde}</dd></div>)}
          </dl>
          <a class="h-link" href={lp(kolom.href)}>{kolom.cta}<span class="h-cirkel h-cirkel-mini h-cirkel-wit" aria-hidden="true" set:html={ik('pijl')} /></a>
        </li>
      ))}
    </ul>
    {c.vglFoot && <p class="h-hk-voet h-in">{c.vglFoot}</p>}
  </section>

  {/* ── 3 · WAAR JE OP KUNT REKENEN, EN WAT HET KOST ─────────────────────── */}
  <section class="h-sec h-vd-koop-sec" aria-labelledby="ed-zeker">
    <header class="h-sec-kop h-in">
      <div>
        <p class="h-pil"><span>{H.prijsPil}</span></p>
        <h2 id="ed-zeker" class="h-kop h-h2"><span class="l">{H.zeker[0]}</span> {H.zeker[1]}</h2>
      </div>
    </header>
    <div class="h-vd-twee">
      <div class="h-vd-krijg h-in">
        <ul class="h-bm-vink" role="list">
          {c.zeker.map((li) => <li><i set:html={ik('check')} /><span>{li}</span></li>)}
        </ul>
      </div>
      <div class="h-vd-kopen h-in" style="--d:1">
        <h3 class="h-kop h-h3">{c.prijsH}</h3>
        <p set:html={c.prijsMaand} />
        <p set:html={c.prijsOpzet} />
        <Disclose summary={c.prijsWaaromH} tone="plain"><p>{c.prijsWaarom}</p></Disclose>
        <p class="h-acties">
          <a class="h-knop h-knop-inkt" href={lp('/contact')}>{c.prijsCta}<span class="o" set:html={ik('rechts')} /></a>
        </p>
      </div>
    </div>
  </section>

  {/* ── 4 · VRAGEN ─────────────────────────────────────────────────────────── */}
  <HalVragen lang={lang} id="ed-faq" dienst="editions" faqs={c.faqs} />

  {/* ── 5 · HET SLOT, MET DE STUDIOBRIEF ─────────────────────────────────── */}
  <section class="h-sec h-lk-slot-sec" aria-labelledby="ed-slot">
    <div class="h-lk-slot h-ed-slot h-in">
      <span class="h-korrel" aria-hidden="true"></span>
      <p class="h-pil h-pil-wit"><span>{H.slotPil}</span></p>
      <h2 id="ed-slot" class="h-kop h-h2"><span class="l">{tonen(c.ctaH)[0]}</span> {tonen(c.ctaH)[1]}</h2>
      <p class="h-vd-slot-zin">{c.ctaP}</p>
      <p class="h-acties">
        <a class="h-knop h-knop-inkt" href={lp('/contact')}>{c.ctaPrimary}<span class="o" set:html={ik('rechts')} /></a>
        <a class="h-knop h-knop-lijn" href={lp('/plans')}>{c.ctaPlans}</a>
      </p>
      <p class="h-vd-belofte">{c.belofte}</p>
      <div class="h-ed-brief">
        <Studiobrief lang={lang} bron="editions"
          kop={lang === 'nl' ? 'Hoor het als Editions opent' : 'Hear when Editions opens'}
          zin={lang === 'nl' ? 'In de Studiobrief: hooguit één mail per maand, met nieuwe looks en wat er verandert. Geen acties.' : 'In the Studio letter: one email a month at most, with new looks and what changes. No promotions.'} />
      </div>
    </div>
  </section>
</div>
<HalBeweging />
