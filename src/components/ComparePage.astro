      {
        label: 'Wat jij regelt',
        a: shoot.items.join(' · ') + '.',
        b: 'Een map met productfoto’s en een korte notitie over de look.',
      },
    ],
    caveat: shoot.caveat,
    caveatNote: 'Dat is een echte bandbreedte voor een echte dag, niet het duurste geval om ons eigen bedrag mooier te laten lijken. Het is wat de hele dag kost zodra je elke regel hierboven meetelt. De onderkant is een bescheiden stadsstudio waar je veel zelf doet. Beide bedragen zijn netto, dus het zijn dezelfde soort getallen.',

    // FigConverge (taak #246) — zie de EN-tak hierboven voor waarom de labels
    // naamwoordgroepen zijn en geen stellingen. convTitle en seqTitle zijn
    // woordelijk colA en colB, zodat de figuur en de matrix hetzelfde ding
    // hetzelfde noemen; wijkt er één af, dan leest de figuur als een derde
    // partij in plaats van als dezelfde twee kolommen, getekend.
    convergeH: 'Wat op één lijn moet komen',
    convergeSub: 'Even los van geld en planning: dit is wat er allemaal op één lijn moet komen voordat er één beeld bestaat.',
    convTitle: 'Een productiedag',
    convLanes: [
      { label: 'Een studio, op een datum' },
      { label: 'Een model, op die datum' },
