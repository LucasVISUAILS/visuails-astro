     * daarna doet niet.
     */
    heroSlideLabel: 'What we make',
    heroCarouselName: 'What VISUAILS makes',
    heroPause: 'Pause the slideshow',
    heroPlay: 'Play the slideshow',
    heroSlides: [
      { card: 'All in one house style' },
      { card: 'Catalog set',        eyebrow: 'What we make', h: 'Four images per product.',   lede: 'Front, back, a fabric or logo close-up, and one worn on a model — the same on every product in the range.', cta: 'See Catalog',      href: '/catalog',       img: 0 },
      { card: 'Lifestyle carousel', eyebrow: 'What we make', h: 'Three images, one scene.',   lede: 'Your product in a styled world instead of on a white background, cut for a carousel and ready to post.',        cta: 'See Lifestyle',    href: '/lifestyle',     img: 1 },
      { card: 'Video clip',         eyebrow: 'What we make', h: 'The same product, moving.',  lede: 'One short vertical clip, cut for Reels, TikTok and paid — without a second shoot to get it.',                    cta: 'See Video',        href: '/video',         img: 2 },
      { card: 'Your Brand Model',   eyebrow: 'What we make', h: 'One face, only yours.',      lede: 'Built once for your brand and used on no one else, then in every order you run after it.',                       cta: 'See Brand Models', href: '/custom-models', img: 3 },
    ],

    // ── THE PRICE BAND ────────────────────────────────────────────────────
    // Everything this page says about money is in these keys and nowhere else.
    // The heading is the old drop band's, kept word for word: it was already
    // the shortest true statement of the model, and a merged band that renamed
    // itself would read to a returning visitor as a new offer.
    priceH: ['One price per product.', 'It falls as you add.'],
    priceLede: `A product is the unit — a catalog set and a lifestyle carousel, ${PER_PRODUCT_VISUALS} finished images. Take the pair or either half, and the rate comes down as the count goes up.`,
    // The ONE VAT statement for this band. Block level, above everything it
    // qualifies, rather than appended to each of the fifteen rates and three
    // totals below it — which is what "excl. VAT" ×8 in one band looked like.
    priceVat: `Every figure in this section is ${vatLabel('excl', 'en')}.`,
    ladCountCol: 'Products',
    // [column heading, what one product of that kind gets]
    ladKinds: [
      ['Complete', `${PER_PRODUCT_VISUALS} images`],
      ['Catalog set', `${CATALOG_IMAGES} images`],
      ['Lifestyle', `${LIFESTYLE_IMAGES} images`],
    ],
    ladPer: 'per product',
    // The bundle argument, without the arithmetic: the table prints all three
    // rates in one row, so a reader who wants to check that the pair is cheaper
    // than the halves can read across instead of being told the subtraction.
    ladNote: 'Both on the same product is one rate, not the two added together.',
    // Was "First order: 20% off." The discount is gone; this says why, which
    // is a stronger line than the discount was. See pricing.js.
    firstLead: 'The rate is the rate.',
    firstBody: `No first-order discount and nothing to negotiate — ${EX_SMALL} complete products is ${euro(Q_SMALL.net, 'en')}, whoever you are and whenever you ask.`,
    addOnNote: `A video clip is ${euro(AMOUNT.video, 'en')}, the same rate inside an order or on its own. Your Brand Model is ${euro(AMOUNT.brandModel, 'en')} once, credited back over your first ${BRAND_MODEL_CREDIT_DROPS} orders.`,
    // ── DE ABONNEMENTSBAND ─────────────────────────────────────────────────
    // Eén kop, één zin, ÉÉN getal, drie feiten en twee knoppen. Geen tweede
