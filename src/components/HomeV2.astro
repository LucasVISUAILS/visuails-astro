const c = COPY[lang];

/* ── DE HERO TOONT ALLEEN WAT JE KUNT BESTELLEN — 25 AUGUSTUS 2026 ──────────
   Lucas, met een schermafdruk van het eerste scherm erbij: *"misschien kan deze
   homepage nu te heftig voelen."*

   `heroSlides` had zeven ingangen: vijf diensten die te bestellen zijn, plus
   Hooks en Editions met `soon: true`. In de kaartrij onder de hero stonden die
   twee dus in het EERSTE scherm, allebei met NOG NIET KLAAR erop. Twee van de
   zeven kaarten vertelden een nieuwe bezoeker dat iets er niet is, voordat hij
   één ding had gezien dat er wel is.

   ZE VERDWIJNEN NIET VAN DE PAGINA, en dat is de hele reden dat dit mag. Ze
   staan verderop in `hv-svc-rail`, uit `svcSoonList`, met hun eigen uitleg, hun
   eigen tag en de uitgeschakelde knop — de plek die voor ze gemaakt is en die
   ongemoeid blijft. Wat hier weggaat is hun TWEEDE optreden, bovenaan.

   FILTEREN EN NIET SCHRAPPEN uit de tabel. `heroSlides` voedt drie dingen: de
   <img>-stapel, de kaartrij, en via `data-note` de wisselende regel. De twee
   staan achteraan, dus na dit filter lopen de indexen 0 t/m 4 ongewijzigd door
   naar KAART_FOTO[i] en SLIDE_ICON[i]. Het carrouselscript telt zijn dia's met
   querySelectorAll en gaat vanzelf van zeven naar vijf.

   ⚠ DIE INDEX-KOPPELING IS DE ZWAKKE PLEK, niet dit filter. Zet iemand ooit een
   `soon`-dia ergens in het MIDDEN van de tabel, dan blijft dit filter goed en
   verschuiven KAART_FOTO en SLIDE_ICON stil één op. Komt dat voor, dan hoort de
   foto en het icoon in de dia zelf te gaan staan — niet in een lijst ernaast. */
const heroSlides = c.heroSlides.filter((sl) => !sl.soon);

/* ── DE DRIE BEZWAREN LEZEN HUN ANTWOORD UIT faq.js — 25 AUGUSTUS 2026 ──────
 *
 * De noot bij sectie 16 beweerde dat de formuleringen *"komen uit de antwoorden
 * die al in src/data/faq.js staan en zijn niet herschreven, zodat de homepage
 * niet iets kan beloven wat de FAQ-pagina tegenspreekt"*.
 *
 * Dat was niet waar. Dit bestand importeerde faq.js helemaal niet; de drie
 * antwoorden stonden hier apart ingetypt en waren inmiddels uit elkaar gelopen.
 * De homepage zei "one revision round comes with every order" waar /faq een heel
 * ander antwoord gaf. Een commentaar dat een garantie beschrijft die er niet is,
 * is erger dan geen commentaar: de volgende lezer controleert het niet meer.
 *
 * ── DE VRAAG BLIJFT VAN DE HOMEPAGE, HET ANTWOORD KOMT UIT DE BRON ─────────
 *
 * Bewust niet allebei. De VRAAG mag hier korter en directer staan — "Wat als ze
 * niet goed zijn?" tegenover "Wat als de visuals niet kloppen?" — omdat een
 * bezoeker die nog aan het kijken is wát je maakt, een andere toon nodig heeft
 * dan iemand die de FAQ doorzoekt. Dat is redactie, geen belofte.
 *
 * Het ANTWOORD is wel een belofte, en die hoort op één plek te wonen. Zeker het
 * eerste: daar staat de revisieronde in, en dat is iets waar een klant ons aan
 * kan houden.
 *
 * ── OPGEZOCHT OP DE ENGELSE VRAAG, EN NIET OP EEN INDEX ────────────────────
 *
 * `faqPageItems()` geeft een platte lijst zonder id's. Een index (11, 21, 2)
 * zou werken tot iemand een vraag verplaatst, en dan zou de homepage stil het
 * antwoord op een andere vraag tonen — precies het soort fout dat deze wijziging
 * moet uitsluiten. De Engelse vraagtekst is het dichtste bij een sleutel dat er
 * is, en de index die hij oplevert geldt voor beide talen omdat de twee lijsten
 * dezelfde volgorde hebben. Klopt dat ooit niet meer, dan valt de BOUW om.
 */
/* ── TWEE VAN DE DRIE, EN DE DERDE MET REDEN NIET ──────────────────────────
 * De eerste twee zijn BELOFTES — de revisieronde en de AI-vermelding — en die
 * horen uit één bron te komen. De derde is ADVIES ("een goed belichte
 * telefoonfoto is genoeg"), en faq.js heeft daar geen antwoord op: de dichtstbij
 * staande vraag is "Wat moet ik opsturen?", en dat beantwoordt een andere vraag
 * dan het bezwaar dat hier staat. Het koppelen zou hier dus geen drift oplossen
 * maar een verkeerd antwoord onder een goede vraag zetten — geprobeerd en
 * teruggedraaid op 25 augustus 2026.
 *
 * `faq: null` betekent: het antwoord blijft in de copytabel hieronder staan.
 * Komt er ooit een FAQ-vraag over fotokwaliteit, dan hoort hij hier ingevuld te
 * worden en het antwoord uit de tabel te verdwijnen. */
const OB_BRON = [
  { faq: 'What if the visuals are not right?', href: '/portal' },
  { faq: 'Are the visuals AI-generated?', href: '/ai-act' },
  { faq: null, href: '/upload-guidelines' },
];

const obEn = faqPageItems('en');
const obNl = faqPageItems('nl');
if (obEn.length !== obNl.length) {
  throw new Error(
    `HomeV2.astro: faq.js geeft ${obEn.length} Engelse en ${obNl.length} Nederlandse vragen. `
    + 'De drie bezwaren worden op index gekoppeld; bij een verschil in lengte kan dat niet kloppen.',
  );
}
const obItems = OB_BRON.map(({ faq, href }) => {
  if (!faq) return { antwoord: null, href };
  const i = obEn.findIndex((it) => it.q === faq);
  if (i < 0) {
    throw new Error(
      `HomeV2.astro: de vraag "${faq}" staat niet meer in faq.js. De bezwaren op de `
      + 'homepage lezen daar hun antwoord; pas OB_BRON aan of zet de vraag terug.',
    );
  }
  return { antwoord: { en: obEn[i].a, nl: obNl[i].a }, href };
});

/* ── DE HEROREGEL HERHAALT EEN BELOFTE DIE ELDERS WOONT ─────────────────────
   `heroClaim` zegt "one full revision round included with your order". Dat
   getal staat niet hier maar in AFTERCARE in pricing.js, en dat bestand is er
   uitdrukkelijk over hoe duur zo'n herhaling is: *"eleven surfaces used to type
   a revision count, every one of them had to be found and rewritten by hand
   when the count went away."*

   Deze zin is de twaalfde. Hij staat er voluit omdat Lucas hem zo geformuleerd
   wil hebben, dus in plaats van hem af te leiden staat er een SLOT op: gaat de
   belofte ooit van één ronde naar iets anders, dan valt de build om met deze
   melding in plaats van dat de homepage stil iets blijft beloven wat niet meer
   geldt. Een bouwfout is het goedkoopste moment om dit te ontdekken.

   Op 'en' en niet op beide talen: AFTERCARE is één bron met twee vertalingen,
   dus als het getal verandert verandert het aan allebei de kanten. */
if (!/\b1 revision round\b/i.test(aftercare('attended', 'en'))) {
  throw new Error(
    'HomeV2.astro: heroClaim belooft "one full revision round", maar AFTERCARE in '
    + 'pricing.js zegt inmiddels iets anders — pas heroClaim in BEIDE talen aan '
    + `voordat je verder gaat. AFTERCARE zegt nu: "${aftercare('attended', 'en')}"`
  );
}
const nl = lang === 'nl';

// De vijf FAQ-vragen die hier werden uitgekozen (FAQ_GROUPS / FAQ_PICK) zijn
// weg met de accordeon die ze toonde — zie de noot bij sectie 16. Ze werden
// per groep gekozen in plaats van van de voorkant van de platte lijst
// afgesneden, en die redenering geldt nu op /faq zelf, waar dezelfde objecten
// staan.
---

{/* ═══ SECTION ORDER — CHANGED 2 AUG 2026, AND HERE IS THE ARGUMENT ═══════════
    The price table used to be section 2, directly under the hero. It is now 5,
    and the before/after — which was 6 — is now 2. Lucas asked whether price
    first was wise; it was not, for one reason specific to this page and two
    general ones.

    THE SPECIFIC ONE. The ladder prices a COMPLETE PRODUCT: four catalog images
    plus three lifestyle. That unit is defined in the services band. A reader
    who met the table first had no denominator, so €149 read as the price of one
    photograph — the most expensive possible misreading, and entirely
    self-inflicted. Services now comes first and the table is legible when it
    arrives.

    THE GENERAL ONES. Ten comparable studios and tools were read for their
    section order (soona, Superside, Design Pickle, Photoroom, Botika, Pebblely,
    Flair, ManyPixels, Picjam, DesignJoy). NOT ONE puts price at position 2 —
    the most price-forward of them, DesignJoy, puts it at 10 of 14. And in eight
    of the ten, position 3 is the proof slot: logos, cases, reviews. This studio
    has none of those, so the before/after — a real client’s phone photo beside
    what was delivered — takes that slot. It is also what DESIGN.md's first
    principle has always demanded: show the work before the claim.

    WHAT WAS NOT DONE, deliberately. Price is not buried. NN/g's B2B research
    finds price is business buyers' top information need and that its absence
    sends them to competitors; HockeyStack measured across 31M visits that
    transparent pricing halves form fills but nearly doubles the share that
    become real pipeline. With this studio's traffic that trade is worth making.
    So the hero carries a one-line anchor with a real figure, and the table
    follows once the unit means something.

    WHAT WOULD REVERSE THIS: evidence that most visitors are returning
    comparison-shoppers who came to check price. Analytics on direct entries to
    /pricing is where that would show.
    ═══════════════════════════════════════════════════════════════════════════ */}

{/* ── 1 · HERO ──────────────────────────────────────────────────────────
    Full-bleed, and the photograph is the only lit thing in the frame. On the
    espresso ground that is not a metaphor: everything above and below it is
    near-black, so the garment is the first colour a visitor sees. */}
<section class="hv-hero" data-hero-carousel
         role="region"
         aria-roledescription={c.heroCarouselName}
         aria-label={c.heroCarouselName}>

  {/* ── EEN ANDERE FOTO KRIJGT EEN ANDERE NAAM — 22 augustus 2026 ───────────
      Dit beeld heette `brand-car`. Toen het door een andere opname uit dezelfde
      reeks werd vervangen bleef die naam staan, en dat is precies één keer te
      doen: `public/_headers` geeft /img/* zeven dagen cache omdat een vaste naam
      dáár vaste inhoud betekent. Na de deploy stond de HTML goed — de alt-tekst
      klopte — en kwam de foto uit de cache van de browser en de rand van
      Cloudflare. Lucas zag de oude achtergrond op een site die volgens elke
      meting in orde was.

      Dus: vervang je een beeld door een ANDER beeld, geef het dan een andere
      naam. Zelfde foto opnieuw uitgesneden of anders gecomprimeerd mag onder de
      oude naam blijven; een andere opname niet. `-lens` staat voor waar deze
      zich van de vorige onderscheidt: hij kijkt in de lens.

      ── DE FOTO'S ────────────────────────────────────────────────────────────
      Eén <img> per dia, allemaal in de DOM en over elkaar heen. Alleen de
      eerste krijgt fetchpriority="high" en decoding="sync" — dat is het beeld
      dat de Largest Contentful Paint bepaalt en het enige dat de bezoeker in de
      eerste seconde ziet. De andere vier staan op lazy: ze mogen de eerste
      render niet vertragen voor een dia die pas na zeven seconden komt. */}
  <div class="hv-hero-bg rand-los-voet">
    {heroSlides.map((sl, i) => (
      <img
        src={i === 0 ? '/img/brand-car-lens.webp' : SERVICE_IMG[sl.img].src}
        {/* ── "undefined" STOND HIER IN DE ALT — 23 AUGUSTUS 2026 ────────────
            `sl.h` bestaat niet meer. De dia's zijn op 20 augustus teruggebracht
            tot `card` en `note` (zie de noot bij heroSlides), en deze regel bleef
            staan. Gevolg, gemeten in dist/index.html: vier herobeelden met
            alt="Catalog set — undefined", in beide talen. Dat is wat een
            schermlezer voorleest en wat Google indexeert.

            `note` is de zin die de dia beschrijft, dus dat is ook de zin die de
            foto beschrijft. */}
        alt={i === 0 ? c.heroAlt : `${sl.card} — ${sl.note}`}
        width={i === 0 ? 2048 : SERVICE_IMG[sl.img].w}
        height={i === 0 ? 1152 : SERVICE_IMG[sl.img].h}
        decoding={i === 0 ? 'sync' : 'async'}
        loading={i === 0 ? undefined : 'lazy'}
