  .hv-mood img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .hv-mood-cap { margin: .6rem 0 0; font-size: .78rem; line-height: 1.5; color: var(--ink-3); }
  .hv-stock-h { margin: 0 0 clamp(.8rem, 1.6vw, 1.1rem); font-size: var(--t-h3); font-weight: 700; color: var(--ink); }
  .hv-stock-item + .hv-stock-item { margin-top: clamp(.8rem, 1.6vw, 1.1rem); padding-top: clamp(.8rem, 1.6vw, 1.1rem); box-shadow: inset 0 1px 0 var(--line); }
  .hv-stock-n { margin: 0; font-size: 1.02rem; font-weight: 700; color: var(--ink); display: flex; align-items: center; gap: .6rem; flex-wrap: wrap; }
  .hv-stock-b { margin: .4rem 0 0; font-size: .9rem; line-height: 1.6; color: var(--ink-3); max-width: 58ch; }
  /* Wat er nog niet is, staat een stap zachter — dezelfde afspraak als bij de
     twee kaarten in de dienstenrij. */
  .hv-stock-item.is-soon .hv-stock-n { color: var(--ink-2); }
  @media (max-width: 820px) { .hv-stock { grid-template-columns: 1fr; } }
  .hv-sub-copy h2 { margin: 0; }
  .hv-sub-copy .lede { margin-top: .7rem; }
  .hv-sub-facts { list-style: none; margin: clamp(1.1rem, 2.2vw, 1.6rem) 0 0; padding: 0; display: grid; gap: .6rem; }
  .hv-sub-facts li { display: grid; grid-template-columns: 20px 1fr; gap: .75rem; font-size: .9rem; line-height: 1.55; color: var(--ink-3); }
  .hv-sub-facts svg { width: 18px; height: 18px; margin-top: .18rem; fill: none; stroke: var(--accent); stroke-width: 2; }
  /* ══ HET ZWEVENDE PANEEL ═════════════════════════════════════════════════
     Zie de lange noot bij de markup. Hier stonden tot vanochtend drie lagen
