      toggle.classList.add('is-paused');
      toggle.setAttribute('aria-label', toggle.dataset.play || toggle.getAttribute('data-play') || toggle.title);
    }
    schilder(nu);
  }

  if (toggle && !rust.matches) {
    toggle.hidden = false;
    var labelPauze = toggle.getAttribute('aria-label');
    var labelPlay = toggle.getAttribute('data-play') || labelPauze;
    toggle.addEventListener('click', function () {
      if (gestopt) {
        gestopt = false;
        toggle.classList.remove('is-paused');
        toggle.setAttribute('aria-label', labelPauze);
        toggle.title = labelPauze;
        herstart();
      } else {
        stop();
        toggle.setAttribute('aria-label', labelPlay);
        toggle.title = labelPlay;
      }
    });
  }

  /* ── BEWEGING PAUZEERT, AANWEZIGHEID NIET — 23 AUGUSTUS 2026 ──────────────
   *
   * Lucas: *"stop hem alleen wanneer de bezoeker de muis beweegt."*
   *
   * Hier stond `root.addEventListener('mouseenter', …)`, en `root` is de hele
   * hero — dat is op vrijwel elk scherm de volledige eerste schermvulling. Een
   * muis die daar toevallig stilstaat, zette de carrousel stil, en dus ook de
   * voortgangsbalk. Netto: op de meeste bezoeken liep er nooit een balk en
   * wisselde er nooit een dia, terwijl er niets aan de hand was. Dat is waarom
   * de balk leek te ontbreken: hij was er, hij kreeg alleen nooit de kans.
   *
   * Aanwezigheid van een cursor is geen signaal. BEWEGING wel: wie de muis
   * beweegt, is aan het kijken en gaat zo iets aanwijzen, en dan is het
   * vervelend als het beeld onder je hand vandaan wisselt.
   *
   * En de pauze is tijdelijk, want anders wisselt er op een gewoon bezoek nooit
   * meer iets — iedereen beweegt binnen zeven seconden zijn muis. Anderhalve
   * seconde stil is het teken dat de aandacht ergens anders is; dan pakt hij de
   * draad op waar hij bevroor, niet bij nul.
   *
   * `passive` omdat deze luisteraar niets annuleert en mousemove op een trackpad
   * tientallen keren per seconde afgaat. Het werk erin is één timeout resetten. */
  var beweegt = false;
  var hoveRij = false;
  var focusIn = false;
  function bijBeweging() {
    if (!beweegt) { beweegt = true; park(true); }
    window.clearTimeout(stilte);
    stilte = window.setTimeout(function () {
      beweegt = false;
      if (!hoveRij && !focusIn) park(false);
    }, 1500);
  }
  root.addEventListener('mousemove', bijBeweging, { passive: true });

  /* De kaartrij zelf is wél een plek waar stilstaan iets betekent: daar staat de
     cursor omdat de bezoeker de kaartjes leest. Dit is de enige hover die nog
     parkeert, en hij gaat over de rij en niet over de halve pagina. */
  var rij = root.querySelector('[data-hero-tabs]');
  if (rij) {
    rij.addEventListener('mouseenter', function () { hoveRij = true; park(true); });
    rij.addEventListener('mouseleave', function () {
      hoveRij = false;
      if (!beweegt && !focusIn) park(false);
    });
  }

  root.addEventListener('focusin', function () { focusIn = true; park(true); });
  root.addEventListener('focusout', function (e) {
    if (root.contains(e.relatedTarget)) return;
    focusIn = false;
    if (!beweegt && !hoveRij) park(false);
  });
  function bijZichtbaarheid() { park(document.hidden); }
  document.addEventListener('visibilitychange', bijZichtbaarheid);
  /* De timer en deze luisteraar hangen niet aan de opmaak en overleven dus een
     zachte navigatie. Zie de noot bij vOpruim() bovenaan dit blok. */
  vOpruim(function () {
    window.clearTimeout(timer);
    window.clearTimeout(stilte);
    document.removeEventListener('visibilitychange', bijZichtbaarheid);
  });

  /* HET ATTRIBUUT ERAF, DE KLASSE ERAAN. Vanaf hier beheert het script de
     zichtbaarheid; `hidden` was er alleen voor de bezoeker zonder JavaScript. */
  /* `is-live` EERST: de klasse die de verbergregels aanzet moet er staan
     voordat het `hidden`-attribuut eraf gaat, anders is er één frame waarin
     alle vijf de dia's zichtbaar zijn. */
  root.classList.add('is-live');
  zetNoot(0);
  /* EN DE EERSTE FOTO AANZETTEN. `is-live` zet elke hero-foto op opacity 0 en
     alleen `.is-on` haalt hem terug — die klasse wordt gezet in toon(), en
     toon() draait bij het laden nog niet. Gevolg zonder deze regel: de hero is
     zwart tot de eerste dia omslaat, zeven seconden lang, op het beeld dat de
     Largest Contentful Paint bepaalt. Gemeten opacity was 0. */
  imgs[0].classList.add('is-on');

  schilder(0);
  if (!rust.matches) herstart();
})();

/*
 * ══════════════════════════════════════════════════════════════════════════
 * DE PIJLEN NAAST EEN SCHUIFRIJ — 20 augustus 2026
 * ══════════════════════════════════════════════════════════════════════════
 *
 * Lucas: *"de pijlen bij de modellen werken gewoon niet."* Ze werkten niet
 * omdat er nooit iets aan hing: `data-rail-prev` en `data-rail-next` kwamen in
 * de hele repo precies twee keer voor — in de twee knoppen zelf. Geen listener,
 * geen script, nergens. Een knop die alleen een cursor verandert.
 *
 * ── ÉÉN BINDING VOOR ALLE RIJEN ────────────────────────────────────────────
 *
 * Elke rij draagt `data-rail="<naam>"`, elke pijlengroep `data-rail-nav`
 * met dezelfde naam. Zo hoeft dit script niets te weten over welke rijen er
 * bestaan, en kost een derde rij alleen twee attributen.
 *
 * ── DE STAP IS EEN KAART EN GEEN VAST GETAL ────────────────────────────────
 *
 * `scrollBy` met een vast aantal pixels loopt uit de pas zodra de kaartmaat
 * met het venster meebeweegt — en dat doet hij hier (clamp op vw). De stap
 * wordt daarom uit het eerste kind gelezen, inclusief de gap. Past er precies
 * één kaart, dan schuift hij één kaart; passen er vier, dan nog steeds één,
 * want een rij die per vier springt slaat kaarten over die je niet zag.
 *
 * ── EN DE KNOPPEN ZEGGEN WANNEER ZE NIETS MEER DOEN ────────────────────────
 *
 * Aan het begin of het eind gaat `disabled` erop. Een pijl die grijs wordt
 * vertelt dat de rij op is; een pijl die blijft glimmen en niets doet, is de
 * tweede keer dat dezelfde knop liegt.
 */
(function railNav() {
  /* Ook de prijstabel doet mee, zonder pijlen: hij hoeft alleen te zeggen of
     hij past. Zie de noot bij .hv-lad-wrap's mask-image. */
  [].slice.call(document.querySelectorAll('.hv-lad-wrap')).forEach(function (wrap) {
    var meet = function () { wrap.classList.toggle('is-fit', wrap.scrollWidth <= wrap.clientWidth + 2); };
    wrap.addEventListener('scroll', meet, { passive: true });
    window.addEventListener('resize', meet, { passive: true });
    /* De luisteraar op `wrap` gaat mee met het element; die op `window` niet. */
    vOpruim(function () { window.removeEventListener('resize', meet); });
    meet();
  });

  var groepen = [].slice.call(document.querySelectorAll('[data-rail-nav]'));
  groepen.forEach(function (nav) {
    var naam = nav.getAttribute('data-rail-nav');
    var rij  = document.querySelector('[data-rail="' + naam + '"]');
    var prev = nav.querySelector('[data-rail-prev]');
    var next = nav.querySelector('[data-rail-next]');
    if (!rij || !prev || !next) return;

    function stap() {
      var kind = rij.firstElementChild;
      if (!kind) return Math.round(rij.clientWidth * 0.8);
      var gap = parseFloat(getComputedStyle(rij).columnGap || '0') || 0;
      return Math.round(kind.getBoundingClientRect().width + gap);
    }

    function schuif(richting) {
      rij.scrollBy({ left: richting * stap(), behavior: 'smooth' });
    }

    function meet() {
      /* 2px speling: een scrollWidth die op een halve pixel uitkomt zou de
         laatste knop anders nooit uitschakelen. */
      var eind = rij.scrollWidth - rij.clientWidth;
      prev.disabled = rij.scrollLeft <= 2;
      next.disabled = rij.scrollLeft >= eind - 2;
      /* Past alles in beeld, dan is er niets te navigeren en hoort de hele
         groep weg — twee grijze pijlen naast een rij die past, zijn ruis. */
      nav.hidden = eind <= 2;
      /* En de randen. Zie de noot bij .hv-svc-rail's mask-image: het verloop
         hoort alleen te staan aan de kant waar de rij DOORLOOPT. */
      rij.classList.toggle('is-scrolled', rij.scrollLeft > 2);
      rij.classList.toggle('is-end', eind > 2 && rij.scrollLeft >= eind - 2);
    }

    prev.addEventListener('click', function () { schuif(-1); });
    next.addEventListener('click', function () { schuif(1); });
    rij.addEventListener('scroll', meet, { passive: true });
    window.addEventListener('resize', meet, { passive: true });
    vOpruim(function () { window.removeEventListener('resize', meet); });
    meet();
  });
})();
</script>

<style>
  /* ── hero ───────────────────────────────────────────────────────────────
     100svh, not 100vh: on iOS the URL bar makes vh taller than the visible
     area, so a "full height" hero puts its own bottom edge under the browser
     chrome and the plinth is the thing that disappears. */
  /* padding-block is reset explicitly: global.css gives every <section> a
     clamp(4.5rem, 9vw, 9rem) block padding, and on a full-bleed hero that
     lands as 130px of dead photograph under the plinth — measured, not
     guessed. A hero is not a band and does not take a band's rhythm. */
  /* `background: var(--ink-900)` stond hier en is 23 augustus 2026 weggehaald:
     een dekkende --bg-0 is een deksel over de verlichting van body::before, en
     de onderrand van deze hero dooft nu uit naar de ECHTE paginagrond in plaats
     van naar een geschilderde benadering ervan. Zie `.rand-los` in global.css. */
  .hv-hero { position: relative; min-height: 100svh; display: flex; flex-direction: column; overflow: hidden; margin-top: -76px; padding: 76px 0 0; isolation: isolate; }
  .hv-hero-bg { position: absolute; inset: 0; z-index: -2; }
  /* DE FOTO DOOFT DIEP UIT, DE SLUIER PAS LAAT. Twee verschillende hoogtes en
     dat is met opzet: in de band waar de foto wegvalt blijft de sluier op volle
     sterkte staan, zodat de grond onder de laatste regel tekst alleen maar
     donkerder wordt en nooit lichter. Andersom — sluier eerst weg — zou de foto
     daar onverzacht komen bloot te liggen, precies onder de knoppen. */
  .hv-hero-bg   { --los: clamp(5rem, 14vh, 11rem); }
  .hv-hero-scrim { --los: clamp(1.6rem, 4vh, 3.2rem); }
  .hv-hero-bg img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 26%; }
  /* ── DE OVERGANG TUSSEN DIA'S ─────────────────────────────────────────────
     Kruislings vervagen en niet schuiven. Schuiven verplaatst een foto van 2200
     pixels over het scherm en dat is precies het soort beweging waar iemand
     misselijk van wordt; vervagen is een opacity-animatie op de compositor en
     kost niets. Adobe schuift wel, maar Adobe heeft ook geen full-bleed foto
     van een model als achtergrond — daar schuift een illustratie mee met een
     tekstblok.

     `hidden` gaat er via het script af vlak vóór de fade, zodat het element
     eerst bestaat en dan pas doorzichtig wordt. Andersom krijg je een sprong. */
  /* ── `.is-live` EN NIET `.js` ──────────────────────────────────────────
     Eerste versie hing deze regels aan de `.js`-klasse op <html>. Dat is de
     verkeerde haak, en op twee manieren gevaarlijk: Layout.astro HAALT die
     klasse er weer af bij prefers-reduced-motion, en nog eens 600ms na `load`
     als de reveal-module niet heeft gemeld dat hij leeft. In allebei die
     gevallen zou hier de verbergregel wegvallen en zouden alle vijf de dia's
     tegelijk over elkaar heen staan — precies wat er op de schermafdruk
     gebeurde.

     Een carrousel hoort zijn eigen staat te dragen. `is-live` wordt door het
     script hieronder gezet, op de carrousel zelf, en door niets anders
     weggehaald. */
  .hv-hero-bg img[hidden] { display: none; }
  .hv-hero.is-live .hv-hero-bg img { opacity: 0; transition: opacity var(--dur-4) var(--ease-out-quint); }
  .hv-hero.is-live .hv-hero-bg img.is-on { opacity: 1; }
  @media (prefers-reduced-motion: reduce) {
    .hv-hero.is-live .hv-hero-bg img { transition: none; }
  }
  /* Two layers doing two jobs. The radial is the plate under the headline;
     the linear darkens the band the sticky nav stands on and lifts the foot
     so the plinth reads as a solid rail rather than as a floating strip. */
  /* ── EN EEN DERDE LAAG SINDS DE FOTO IN DE AUTO — 22 augustus 2026 ──────
     De duinfoto was links donker; deze is dat niet. Het onderwerp — een felle
     pufferjas — staat precies waar de kop staat, en leesbaar.mjs las de witte
     "You upload." af op 2,53 : 1 waar 3 de eis is. De radiaal hierboven mikt op
     16% van links en 84% van boven, dus die is bij de kop (op 40% hoogte) al
     bijna uitgewerkt.
     Deze laag is een strijklicht van links: donker aan de rand waar de tekst
     staat, weg op de helft, en de rechterkant van de foto — het raam, de
     donkere hoedenplank — blijft onaangeroerd. Een lineaire loop leest als
     natuurlijke afval van licht en niet als een vlek eroverheen. */
  .hv-hero-scrim { position: absolute; inset: 0; z-index: -1; background:
    linear-gradient(96deg, rgb(var(--scrim) / 0.80) 0%, rgb(var(--scrim) / 0.54) 26%, rgb(var(--scrim) / 0.14) 52%, transparent 68%),
    radial-gradient(92% 82% at 16% 84%, rgb(var(--scrim) / 0.90) 0%, rgb(var(--scrim) / 0.42) 54%, transparent 78%),
    linear-gradient(180deg, rgb(var(--scrim) / 0.76) 0%, rgb(var(--scrim) / 0.50) 13%, rgb(var(--scrim) / 0.14) 27%, transparent 52%, rgb(var(--scrim) / 0.46) 84%, rgb(var(--scrim) / 0.66) 100%); }
  /* ── OP EEN TELEFOON MOET DE PLAAT BREDER ZIJN ───────────────────────────
     De radiaal hierboven is een plaat ONDER de kop, gemikt op 16% van links —
     goed op een breed scherm, waar de kop in de linkerhelft staat en de foto
     rechts vrij blijft. Op 390px staat diezelfde kop over de volle breedte en
     valt het rechteruiteinde ("You upload." eindigt op 92% van de breedte)
     buiten de plaat, precies waar de foto het lichtst is.

     Gemeten met leesbaar.mjs, dat de pagina twee keer afdrukt en de werkelijke
     achtergrond onder elke regel afleest: 2,86 : 1 op een eis van 3. Niet
     dramatisch, wel onder de streep, en het is de grootste kop van de site.

     De reparatie is de plaat centreren en breder maken zodra de kop de volle
     breedte inneemt. Alleen de RADIAAL verandert; de lineaire laag eronder
     (de balk waar de koptekst op staat) blijft precies zoals hij is. */
  @media (max-width: 700px) {
    /* Ook hier moest de plaat mee omhoog toen de foto wisselde: op 390px staat
       de kop midden in het kader en daar zit nu de jas. Gemeten op /nl/ met de
       duinfoto 2,86 en met deze 2,40 — dus de radiaal begint hoger en houdt
       zijn dekking langer vast. */
    .hv-hero-scrim { background:
      radial-gradient(128% 88% at 50% 78%, rgb(var(--scrim) / 0.94) 0%, rgb(var(--scrim) / 0.72) 46%, rgb(var(--scrim) / 0.22) 76%, transparent 94%),
      linear-gradient(180deg, rgb(var(--scrim) / 0.76) 0%, rgb(var(--scrim) / 0.50) 13%, rgb(var(--scrim) / 0.14) 27%, transparent 52%, rgb(var(--scrim) / 0.46) 84%, rgb(var(--scrim) / 0.66) 100%); }
  }
  .hv-hero-inner { flex: 1; display: flex; align-items: flex-end; width: 100%; }
  .hv-hero-copy { max-width: 40rem; padding-block: 3rem clamp(2.5rem, 6vh, 4rem); }
  /* ── DE DIA'S LIGGEN OP ELKAAR, EN DE HOOGTE STAAT VAST ───────────────────
     Eerste poging was `position: absolute` op de dienstdia's. Dat brak de hero:
     alleen dia 1 stond nog in de stroom, dus zodra die verborgen werd had
     .hv-hero-inner geen inhoud meer, klapte hij in en zakte de hele hero tot
     de kaartrij. Op de schermafdruk liep de kop van dia 2 boven het scherm uit.

     Nu één rastercel waar alle vijf in liggen (`grid-area: 1 / 1`), en de
     inactieve dia's blijven staan met `visibility: hidden` in plaats van
     `display: none`. Dan bepaalt de LANGSTE dia de hoogte en beweegt er bij
     het wisselen niets — precies wat je van een carrousel wilt.

     `visibility: hidden` haalt een element ook uit de toegankelijkheidsboom en
     uit de tabvolgorde, dus de knoppen van een onzichtbare dia zijn niet te
     bereiken. Dat is dezelfde bescherming die het `hidden`-attribuut gaf.

     Het `hidden`-ATTRIBUUT blijft in de html staan voor wie geen JavaScript
     heeft; het script haalt het er bij het opstarten af en neemt het over met
     deze klasse. Zonder script is er dus één dia en geen stapel. */
  /* ── DE KAARTRIJ HOORT BINNEN HET EERSTE SCHERM ──────────────────────────
     Gemeten met de rij erin: hero 965px bij een venster van 900, dus de
     kaartjes vielen 65px onder de vouw — en op 800 zelfs 156. Dan is het geen
     carrousel meer maar een rij knoppen die je moet ontdekken.

     Het kopblok is met 808px het zwaarste onderdeel, en dat komt door dia 1:
     drie regels <h1>, een lede, twee knoppen, de proefvisual-voetnoot én vier
     bewijsregels. Die inhoud is te belangrijk om voor de opmaak te schrappen,
     dus komt de ruimte uit de PADDING en niet uit de tekst — boven en onder,
     en alleen zolang de carrousel echt loopt. Staat er geen script, dan is er
     ook geen kaartrij en houdt de hero zijn oude, ruimere maatvoering. */
  .hv-hero.is-live .hv-hero-copy { padding-block: 1.5rem clamp(1rem, 2vh, 1.6rem); }
  .hv-hero.is-live .hv-hero-foot { padding-bottom: clamp(1rem, 2vh, 1.6rem); }

  /* ── TWEE VAN DE VIER REDDINGEN ZIJN WEG — 25 AUGUSTUS 2026 ─────────────
     Hier stonden twee media-queries die allebei hetzelfde deden: de
     voorwaardenregel wegknippen, één keer op een laag venster en één keer op
     een telefoon. Plus een derde in `.hv-proof li` voor 150% tekstgrootte. Drie
     voorwaardelijke ontsnappingen voor één blok dat te groot was.

     Dat blok is nu weg — zie de noot bij `hv-cta-claim` in de markup — dus de
     regels die het wegknipten hebben geen doel meer. `.hv-sr` doet permanent
     wat zij per venster deden, en doet het voor iedereen hetzelfde.

     ── WAT WEL BLIJFT, EN WAAROM DAT GEEN REDDING IS ──────────────────────
     De <h1> wordt op een laag venster nog steeds kleiner. Dat is geen noodgreep
     voor een te vol blok maar gewone responsieve typografie: drie regels van
     96px zijn samen 290px, en op een 13-inch laptop hoort een display-letter
     mee te schalen met de hoogte die er is. Hij zou hier ook staan als deze
     kolom altijd al vier blokken had gehad.

     ⚠ EERLIJK OVER WAT DE INGREEP OPLEVERT. De voorwaardenregel en de vinkjes
     waren samen circa 92px; de claimregel die ervoor terugkomt is er circa 34.
     De kolom wordt dus zo'n 58px korter, niet 200. Op 800px hoog is dat niet
     genoeg om deze query overbodig te maken, en daarom staat hij er nog. Wie
     hem écht weg wil, moet aan de <h1> of aan de wisselende regel — en dat zijn
     allebei grotere beslissingen dan opruimwerk. */
  @media (max-height: 880px) and (min-width: 48rem) {
    .hv-hero.is-live .hv-h1 { font-size: clamp(2.6rem, 5.4vw, 4rem); }
  }
  /* Het raster met vijf overlappende tekstblokken is weg — er is er nog één.
     `.hv-hero-inner` blijft een grid omdat de foto’s er ook in liggen. */
  .hv-hero-inner { display: grid; }
  .hv-hero-inner > .hv-hero-copy { grid-area: 1 / 1; align-self: end; }

  /* ── DE REGEL DIE MEEWISSELT ────────────────────────────────────────────
     Eén regel, onder de kop, in de zachtere inktstap zodat hij een bijschrift
     is en geen tweede belofte. Vaste minimumhoogte: zonder dat springt de hele
     hero op en neer bij elke dia, want de regels verschillen per dia in lengte
     — en een kop die om de zeven seconden 28 pixels verschuift, is het
     tegenovergestelde van rustig. (Hier stond "dia 1 heeft geen regel"; dat is
     op 25 augustus 2026 rechtgezet — hij heeft er wel een.) */
  .hv-slide-note {
    margin: .9rem 0 0;
    /* Twee regels gereserveerd, ook als er één staat. Gemeten zonder deze
       regel: de kop sprong 17 pixels op en neer tussen dia 1 en dia 2, want het
       blok is onderaan verankerd en elke regel eronder duwt de kop omhoog. Een
       kop die om de zeven seconden verschuift is precies de onrust die hier
       weg moest. Dia 1 heeft daarom ook een regel gekregen — dan staat er
       nergens een leeg vak. */
    min-height: 3em;
    font-size: 1rem; line-height: 1.5;
    color: var(--paper-soft-on-dark);
    max-width: 46ch;
    transition: opacity var(--dur-2) var(--ease);
  }
  .hv-slide-note[hidden] { display: block; visibility: hidden; }
  .hv-slide-note-a {
    margin-inline-start: .5rem;
    font-weight: 700; color: var(--accent-bright);
    text-decoration: underline; text-decoration-color: rgb(255 255 255 / .28);
    text-underline-offset: 3px;
  }
  .hv-slide-note-a:hover { text-decoration-color: currentColor; }
  .hv-slide-note-a[hidden] { display: none; }
  @media (prefers-reduced-motion: reduce) { .hv-slide-note { transition: none; } }

  /* ══════════════════════════════════════════════════════════════════════════
     DE KAARTJES ONDER DE HERO, EN DE PAUZEKNOP
     ══════════════════════════════════════════════════════════════════════════
     Adobe zet ze als een rij donkere kaartjes op de onderrand van de foto, elk
     met een label en een chevron. Hier hetzelfde, met de balk erbij die laat
     zien hoe lang de dia nog duurt — dat is wat de rij van een navigatie een
     TIMER maakt, en het is de enige plek waar de bezoeker kan zien dat er
     straks iets vanzelf gaat gebeuren. */
  .hv-hero-foot {
    position: relative; z-index: 1;
    /* `end` en niet `stretch`: de pauzeknop is geen kaart meer (zie zijn eigen
       noot) en hoort dus ook niet meer tot kaarthoogte te worden uitgerekt. Hij
       lijnt onderaan uit met de rij, als een teken naast de rij en niet als een
       lid ervan. De rij zelf rekt gewoon door, want die is `flex: 1`. */
    display: flex; align-items: end; gap: clamp(.6rem, 1.2vw, 1rem);
    padding-bottom: clamp(1.2rem, 3vh, 2.2rem);
  }
  /* ── VAN RASTER NAAR FLEX — 25 AUGUSTUS 2026 ────────────────────────────
     Hier stond `grid-template-columns: repeat(7, minmax(0, 1fr))`, met een
     lange noot over waarom zeven en niet `auto-fit`.

     ⚠ DAT GETAL KLOPTE NIET MEER. De rij telt sinds vanochtend VIJF kaarten —
     Hooks en Editions staan er niet meer in, zie het filter bovenaan dit
     bestand. Zeven kolommen voor vijf kaarten betekende dat de rij twee lege
     kolommen breed was en de kaarten op 5/7 van de breedte eindigden, met een
     gat rechts. Nog een verouderd getal dat stil iets deed.

     FLEX EN NIET `repeat(5, ...)`, om twee redenen. Het aantal hoeft nu nergens
     meer te staan: `flex: 1 1 0` verdeelt wat er is, dus een zesde dienst past
     vanzelf en er is geen getal meer dat kan verlopen. En flex is wat het
     UITKLAPPEN mogelijk maakt — zie de noot bij .hv-slide-card hieronder. Een
     `grid-template-columns` per actieve kaart zou vijf :has()-regels kosten die
     allemaal op het aantal zijn vastgezet.

     `flex-wrap: nowrap` houdt de garantie die de oude noot beschermde: de rij
     breekt nooit af met één kaartje eronder, hij schuift. */
  .hv-slide-cards {
    flex: 1; display: flex; flex-wrap: nowrap; min-width: 0;
    gap: clamp(.4rem, .8vw, .7rem);
  }
  /* De grens ligt op 1200px omdat een kaartje daaronder smaller wordt dan de
     12rem waarop "Lifestyle carousel" op twee regels past zonder het label uit
     zijn kaart te duwen. Gemeten, niet gegokt. */
  @media (max-width: 1200px) and (min-width: 901px) {
    .hv-slide-cards {
      display: flex; min-width: 0;
      overflow-x: auto; scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }
    .hv-slide-cards::-webkit-scrollbar { display: none; }
    .hv-slide-cards > .hv-slide-card { flex: 0 0 auto; min-width: 11rem; scroll-snap-align: start; }
  }
  /* Icoon boven, label en chevron eronder — de indeling van Adobe’s `.rm-card`,
     die daardoor op 94px uitkomt. Een rij van icoon-label-chevron naast elkaar
     was de eerste versie en bleef op ~50px steken: dat leest als een tab, niet
     als een kaart. */
  /* De doos is sinds 20 augustus geen link meer maar een houder voor er twee:
     de grote wisselt de dia, het pijltje rechts gaat naar de pagina. Zie de noot
     bij de markup. De opmaak — rand, vulling, hoogte, de balk onderin — blijft
     bij de doos, zodat het één kaartje blijft om naar te kijken. */
  .hv-slide-card {
    position: relative; overflow: hidden;
    display: flex; align-items: stretch;
    /* ── LAGER — 25 AUGUSTUS 2026 ────────────────────────────────────────
       Lucas: *"misschien de knoppen wat minder hoog maken om rust te bewaren."*
       Was clamp(4.6rem, 5.4vw, 5.4rem). Samen met de korte titel op de eerste
       kaart gaat de gemeten hoogte van 109px naar ongeveer 72. */
    min-height: clamp(4rem, 4.4vw, 4.5rem);
    /* ── EN HIJ KLAPT UIT ALS HIJ AAN DE BEURT IS ────────────────────────
       Lucas: *"wanneer een knop geselecteerd is hij met een smooth animatie
       uitklapt."*

       `flex-grow` is een getal en dus overgankelijk. Dit is de reden dat de rij
       hierboven van raster naar flex is gegaan: één regel verderop zet de
       actieve kaart op 1.5 en de browser verdeelt de rest vanzelf, ongeacht
       hoeveel kaarten er staan.

       --dur-3 (450ms) en niet --dur-2: de carrousel schuift elke zeven seconden
       door, dus deze beweging herhaalt zich vanzelf. Bij 240ms is dat een tik,
       bij 450 met een uitdempende curve is het een verschuiving die je ziet
       gebeuren in plaats van aantreft. Dat is ook wat "rust bewaren" hier
       betekent: niet minder beweging, maar tragere. */
    flex: 1 1 0;
    border: 1px solid rgb(255 255 255 / .12);
    border-radius: var(--r-md);
    /* ── NIET DONKERDER MAAR DOORZICHTIGER — 25 AUGUSTUS 2026 ─────────────
       Lucas: *"niet alleen donkerder maken maar ook doorzichtiger maar wel
       leesbaar."*

       De eerste poging dimde de kaart met `opacity`. Die werkte niet, en om
       twee redenen die allebei de moeite van het onthouden waard zijn. Ten
       eerste animeert de binnenkomst hieronder `opacity` met `fill-mode: both`,
       en een ANIMATIE WINT IN DE CASCADE VAN EEN GEWONE DECLARATIE — de kaart
       bleef na afloop op 1 staan en de dimregel kwam er nooit doorheen. Ten
       tweede zou het ook te zwak zijn geweest: opacity blendt naar de
       achtergrond, en die is hier bijna even zwart als de kaart zelf.

       Dus is het nu een verschil in MATERIAAL en niet in tint. Niet aan de
       beurt is glas — deze waarde, met de blur uit het @supports-blok verderop
       en het miniatuur bijna weg. Aan de beurt is een dicht paneel. Dat leest
       in één blik, ook zonder twee kaarten naast elkaar te leggen.

       DEZE WAARDE IS DE VARIANT ZONDER BLUR en staat daarom hoger dan de
       waarde in het @supports-blok. Zonder blur is er niets dat de foto
       eronder verzacht, dus moet het zwart dat werk doen. */
    background: rgb(0 0 0 / .30);
    color: var(--paper-on-dark);
    font-size: .78rem; font-weight: 700; line-height: 1.3;
    transition: background var(--dur-1) var(--ease),
                border-color var(--dur-1) var(--ease),
                flex-grow var(--dur-3) var(--ease-out-expo);
  }
  .hv-slide-card:has([aria-selected='true']) { flex-grow: 1.5; }
  /* ── DE FOTO, EN DE SLUIER EROVER ────────────────────────────────────────
     De foto staat op een eigen laag onder de inhoud, met een verloop erover dat
     naar links donkerder wordt: daar staat de tekst. Rechts, waar alleen het
     pijltje staat, mag hij lichter zijn — dan zie je waar het over gaat zonder
     dat de titel eronder lijdt.

     18% is de bovengrens die npm run test:a11y toelaat op deze kaart: met de
     donkere sluier erboven houdt "Lifestyle carousel" ruim 7:1, en dat is waar
     hij vóór deze wijziging ook stond. Zichtbaar genoeg om iets te herkennen,
     te zwak om te lezen als een plaatje met tekst erop. */
  .hv-slide-card::before {
    content: '';
    position: absolute; inset: 0;
    background-image: var(--kaart-foto);
    background-size: cover; background-position: center;
    opacity: .07;
    /* De kleur is het sterkste onderscheid dat deze rij te geven heeft, en het
       kost niets: alleen de kaart die aan de beurt is, staat in kleur. Op een
       fotogedreven site hoort de foto dat te zeggen en niet een randtint.
       `--sat` staat op de kaart zodat hover en de actieve staat hem allebei
       met één waarde terugzetten. */
    filter: saturate(var(--sat, .15));
    pointer-events: none;
    transition: opacity var(--dur-2) var(--ease), filter var(--dur-2) var(--ease);
  }
  /* ALLEEN DE TWEE LINKS, en niet `> *`. Die bredere selector raakte ook de
     voortgangsbalk, en `position: relative` maakt van een absoluut geplaatst
     streepje een gewoon flex-item van nul breed — zichtbaar nergens. Gemeten:
     de balk stond op scaleX(0.6) en was niet te zien. */
  .hv-slide-card > a { position: relative; z-index: 1; }
  .hv-slide-card-main::before {
    content: '';
    position: absolute; inset: 0;
    background: linear-gradient(100deg, rgb(0 0 0 / .78) 0%, rgb(0 0 0 / .58) 55%, rgb(0 0 0 / .30) 100%);
    pointer-events: none;
  }
  .hv-slide-card-main > * { position: relative; }
  .hv-slide-card-main {
    flex: 1 1 auto; min-width: 0;
    /* ── GECENTREERD, NIET UIT ELKAAR GEDUWD — 25 AUGUSTUS 2026 ──────────
       Lucas: *"ik wil wel de titel etc. mooi gecentreerd hebben."*

       Hier stond `align-content: space-between` met een tussenruimte tot
       22,4px: het pictogram bovenaan, het label onderaan, en de kaart werd
       daar hoog van. Dat was de indeling van Adobe's kaartje, en die had een
       chevron als derde element om die ruimte te rechtvaardigen. Hier is de
       chevron een eigen link naast de doos, dus stonden er twee dingen zo ver
       mogelijk uit elkaar zonder reden.

       Nu als blok in het midden, met een tussenruimte die alleen nog
       pictogram en label scheidt. Dat haalt het grootste deel van de 37px weg
       die deze kaart lager wordt, en het is meteen de rustiger indeling. */
    display: grid; gap: clamp(.4rem, .9vw, .62rem);
    align-content: center;
    padding: clamp(.7rem, 1.4vw, .9rem) clamp(.4rem, .8vw, .6rem) calc(clamp(.7rem, 1.4vw, .9rem) + 3px) clamp(.8rem, 1.5vw, 1.1rem);
    color: inherit; text-decoration: none;
  }
  /* Het pijltje is een eigen doelwit en dus een eigen raakvlak: 44px breed en
     de volle hoogte van het kaartje, wat 2.5.8 als ondergrens noemt. Als span
     binnen dezelfde link was hij precies zo groot als de chevron zelf. */
  .hv-slide-card-go {
    flex: 0 0 auto; width: 44px;
    display: grid; place-items: center;
    color: var(--paper-soft-on-dark); text-decoration: none;
    font-size: 1rem; line-height: 1;
    transition: color var(--dur-1) var(--ease), background var(--dur-1) var(--ease);
  }
  .hv-slide-card-go:hover, .hv-slide-card-go:focus-visible { color: var(--accent); background: rgb(255 255 255 / .07); }
  /* ── HET PIJLTJE SCHUIFT, EN DAT IS GEEN VERSIERING ─────────────────────
     Dit is een EIGEN link naast de grote: de kaart wisselt de dia, het pijltje
     gaat naar de dienstpagina. Dat onderscheid is bewust gebouwd — zie de noot
     bij de markup — en het was tot nu toe onzichtbaar tot je er al op stond.
     Een pijl die naar rechts schuift, zegt precies wat hij doet.

     De span binnenin en niet de link zelf, want de link draagt de achtergrond
     en die moet blijven staan waar hij staat. */
  .hv-slide-card-go > span { display: block; transition: transform var(--dur-1) var(--ease); }
  .hv-slide-card-go:hover > span, .hv-slide-card-go:focus-visible > span { transform: translateX(3px); }
  @supports (backdrop-filter: blur(6px)) {
    /* Met blur mag het glas veel dunner: de blur doet het werk dat het zwart
       anders moet doen, en dan zie je door de kaart heen DAT er iets ligt
       zonder te gaan lezen wat. */
    .hv-slide-card { background: rgb(0 0 0 / .13); backdrop-filter: blur(8px); }
  }
  /* ── HOVER HEEFT VOORTAAN EEN EIGEN TAAL — 25 AUGUSTUS 2026 ─────────────
     Hier zat een echte verwarring in. Hover gaf achtergrond .60, foto .30 én
     een limoen pictogram; de actieve kaart gaf .58, foto .34 en een limoen
     pictogram. Het verschil was een randtint en het balkje — dus een kaart
     AANWIJZEN liet hem eruitzien alsof hij AAN stond.

     Nu heeft elke toestand één eigen middel: het glas zegt "deze niet", het
     limoen zegt "deze wel", en hover geeft alleen de kleur en de titel terug.
     Het limoen blijft gereserveerd voor de kaart die echt aan de beurt is. */
  .hv-slide-card:has(.hv-slide-card-main:hover), .hv-slide-card:has(.hv-slide-card-main:focus-visible) {
    background: rgb(0 0 0 / .58); border-color: rgb(255 255 255 / .28); --sat: 1;
  }
  .hv-slide-card:has(.hv-slide-card-main:hover)::before,
  .hv-slide-card:has(.hv-slide-card-main:focus-visible)::before { opacity: .30; }
  .hv-slide-card:has(.hv-slide-card-main:hover) .hv-slide-card-t,
  .hv-slide-card:has(.hv-slide-card-main:focus-visible) .hv-slide-card-t { color: var(--paper-on-dark); }
  /* ── DE ACTIEVE KAART, ZONDER DE SCHREEUW — 23 AUGUSTUS 2026 ─────────────
     Lucas: *"misschien ook de knoppen iets subtieler en minder heftig maken."*

     Hier stond `border-color: var(--accent)` — een volle limoen rand rondom, op
     een rij waar ook nog eens elk pictogram limoen was. Zeven limoen iconen plus
     één limoen kader is meer signaal dan er te geven valt, en dan valt het echte
     signaal juist weg.

     Wat er nu gebeurt: de rand wordt een gedempte limoen hairline, de foto komt
     een stap naar voren, en het enige dat vol limoen is, is de balk onderin die
     de tijd wegtelt. Eén ding schreeuwt, en dat is het ding dat iets zegt. */
  .hv-slide-card:has([aria-selected='true']) {
    border-color: rgb(198 241 0 / .42);
    /* Dicht, waar de andere glas zijn. Zie de noot bij de achtergrond van
       .hv-slide-card: het onderscheid zit in het materiaal. */
    background: rgb(0 0 0 / .62);
    --sat: 1;
  }
  .hv-slide-card:has([aria-selected='true'])::before { opacity: .34; }
  /* Het merkteken op de eerste kaart. Zie de noot bij de markup: dit is een
     GEVULD pad in een kader van 702×813, dus geen stroke-eigenschappen en een
     eigen breedte — 702/813 is smaller dan vierkant, en op dezelfde hoogte als
     de vier pictogrammen ernaast staat hij optisch gelijk. `currentColor` zodat
     hij dezelfde limoen/gedempt-wit route volgt als de rest. */
  .hv-slide-card-mrk {
    width: 17px; height: 20px; flex: none;
    fill: currentColor; stroke: none;
    color: rgb(255 255 255 / .55);
    transition: color var(--dur-1) var(--ease);
  }
  .hv-slide-card:has([aria-selected='true']) .hv-slide-card-mrk { color: var(--accent); }
  .hv-slide-card-i {
    width: 20px; height: 20px; flex: none;
    fill: none; stroke: currentColor; stroke-width: 2.4;
    stroke-linecap: round; stroke-linejoin: round;
    /* Gedempt op de kaarten die niet aan de beurt zijn. Zie de noot hierboven:
       zeven limoen iconen naast elkaar maken de rij druk zonder iets aan te
       wijzen. */
    color: rgb(255 255 255 / .55);
    transition: color var(--dur-1) var(--ease);
  }
  /* Alleen de kaart die aan de beurt is. Hover stond hier ook en is eruit —
     zie de noot bij hover hierboven: het limoen is het teken van "deze wel" en
     dat mag hover niet lenen. */
  .hv-slide-card:has([aria-selected='true']) .hv-slide-card-i { color: var(--accent); }

  /* Het label op de twee die nog niet klaar zijn. Zelfde woord als op de kaarten
     verderop op deze pagina (`svcSoonTag`), en met opzet gedempt: het is een
     mededeling en geen waarschuwing. */
  .hv-slide-card-soon {
    display: block; margin-top: .2rem;
    font-size: .66rem; font-weight: 600; font-style: normal;
    letter-spacing: .04em; text-transform: uppercase;
    color: rgb(255 255 255 / .52);
  }
  .hv-slide-card.is-soon .hv-slide-card-t { font-weight: 700; }
  /* `.hv-slide-card-row` en `.hv-slide-card-x` zijn weg met het splitsen van
     het kaartje: de rij bevatte de titel én de chevron, en de chevron is nu een
     eigen link naast de titel (.hv-slide-card-go hierboven). */
  /* ── DE TITEL DIMT ÉÉN STAP EN NOOIT TWEE ──────────────────────────────
     Dit is de grens van "doorzichtiger maar wel leesbaar". --paper-on-dark
     tegenover --paper-soft-on-dark is één inktstap en blijft ruim boven de
     contrasteis; de stap daaronder zakt erdoorheen bij tekst van deze grootte
     en dit is tekst van .78rem.

     Wil de rij ooit nóg verder naar de achtergrond, dan gaat dat in de
     achtergrond van de kaart en in de dekking van het miniatuur — in het glas
     dus, niet in de letter. Dat is de regel die npm run test:a11y bewaakt en
     die deze band al eerder heeft moeten leren: zie de noot bij ::before over
     waarom het miniatuur op 18% stond. */
  .hv-slide-card-t { min-width: 0; color: var(--paper-soft-on-dark);
    transition: color var(--dur-2) var(--ease); }
  .hv-slide-card:has([aria-selected='true']) .hv-slide-card-t { color: var(--paper-on-dark); }

  /* De voortgangsbalk. Hij zit ONDERIN de kaart en niet eronder, zodat de rij
     zijn hoogte houdt als hij verschijnt — vandaar de extra 3px padding-bottom
     hierboven, die de ruimte al vrijhoudt.

     scaleX vanaf links, want dat is een transform en die loopt op de
     compositor. Een animatie op `width` zou elke frame de rij opnieuw laten
     berekenen, en dat is zeven seconden lang layout-werk voor een streepje. */
  /* ── EN HIJ HEEFT EEN BAAN NODIG — 23 AUGUSTUS 2026 ──────────────────────
     De balk was limoen op een kaart die in actieve toestand een limoen RAND
     krijgt (`:has([aria-selected='true'])` hierboven). Drie pixel limoen tegen
     een limoen rand van één pixel leest niet als voortgang maar als een iets
     dikkere onderrand — en dan zie je niet dát hij loopt, laat staan hoe ver.

     Een voortgangsbalk heeft twee delen nodig: wat al voorbij is en wat er nog
     komt. De baan is dat tweede deel. Hij staat alleen op de actieve kaart,
     want op de vier andere loopt er niets en zou hij een streep zijn die niets
     betekent. */
  .hv-slide-card:has([aria-selected='true'])::after {
    content: '';
    position: absolute; left: 0; right: 0; bottom: 0; height: 3px;
    background: rgb(255 255 255 / .18);
    pointer-events: none;
  }
  .hv-slide-card-bar {
    position: absolute; left: 0; right: 0; bottom: 0; height: 3px;
    /* Bóven de baan én boven de twee links. Zonder dit tekent ::after hem over,
       want een pseudo-element staat later in de boom dan een span die ervoor
       komt. */
    z-index: 2;
    background: var(--accent);
    transform: scaleX(0); transform-origin: left center;
  }
  /* `:has()` en geen attribuut op de doos zelf: `aria-selected` staat op de
     LINK erin (.hv-slide-card-main), niet op .hv-slide-card. De oude selector
     `.hv-slide-card[aria-selected='true']` kon dus nooit raak zijn — dezelfde
     splitsing van 20 augustus die de regel hierboven in JavaScript brak. De
     rest van dit blok gebruikt `:has()` al; deze regel was de uitzondering. */
  .hv-slide-card:has([aria-selected='true']) .hv-slide-card-bar.is-running {
    animation: hv-slide-timer linear forwards;
    animation-duration: var(--hv-slide-ms, 7000ms);
  }
  @keyframes hv-slide-timer { from { transform: scaleX(0); } to { transform: scaleX(1); } }

  /* De pauzeknop. Vierkant, zelfde hoogte als de kaartrij ernaast, en hij
     draagt zijn staat in aria-label én in de vorm van het pictogram — een knop
     die alleen van kleur verandert, zegt tegen een schermlezer niets. */
  /* ── GEEN DOOS EROMHEEN — 20 AUGUSTUS 2026 ───────────────────────────────
     Lucas: *"de play button voor de slides hoeft geen box omheen, het voelt nu
     alsof er meer opties zijn die dan weergegeven worden als je erop klikt."*

     Hij had gelijk en de oorzaak stond in mijn eigen noot hierboven: "vierkant,
     zelfde hoogte als de kaartrij ernaast". Dat maakte hem tot een zesde kaart
     in een rij van vijf — dezelfde rand, dezelfde radius, dezelfde vulling,
     dezelfde hoogte. Vijf van die dozen kiezen een dia; de zesde doet iets
     totaal anders. Gelijk vormgeven is dan geen consistentie maar een leugen
     over wat het ding is.

     Nu is het alleen het teken: geen rand, geen vulling, geen radius, en een
     stap smaller dan een kaart. Het treffervlak blijft wél 44px hoog (WCAG
     2.5.8) — dat zit in de hoogte, niet in een zichtbare doos. */
  .hv-hero-toggle {
    flex: none;
    width: 2.75rem; min-height: 2.75rem;
    display: grid; place-items: center;
    border: 0; border-radius: var(--r-sm);
    background: none; color: var(--paper-on-dark);
    opacity: .62;
    cursor: pointer;
    transition: opacity var(--dur-1) var(--ease);
  }
  .hv-hero-toggle:hover { opacity: 1; }
  .hv-hero-toggle:focus-visible { outline: 2px solid var(--focus-ring); outline-offset: 3px; opacity: 1; }
  /* Pauze = twee streepjes; afspelen = een driehoek. Met border-box getekend in
     plaats van met een <svg>, zodat de omschakeling één klasse is en er geen
     tweede pictogram in de html hoeft te staan dat je moet verbergen. */
  .hv-hero-toggle-i {
    width: 10px; height: 12px;
    border-left: 3px solid currentColor; border-right: 3px solid currentColor;
  }
  .hv-hero-toggle.is-paused .hv-hero-toggle-i {
    width: 0; height: 0;
    border: 6px solid transparent; border-left: 10px solid currentColor; border-right: 0;
    margin-left: 3px;
  }

  @media (max-width: 900px) {
    /* Vijf kaartjes naast elkaar zijn op een telefoon vijf kolommen van
       zestig pixels: het label past niet en de rij leest als een tabbalk van
       afkortingen. Horizontaal schuiven houdt ze op leesbare breedte en is het
       gebaar dat op een telefoon toch al verwacht wordt. */
    /* ── EEN RIJ EN GEEN KOLOM — 20 augustus 2026 ─────────────────────────
       Hier stond `flex-direction: column`, en samen met de `align-items: end`
       die ik op de desktopvariant zette (om de pauzeknop onderaan uit te
       lijnen) leverde dat een echte fout op: in een KOLOM is `end` de
       horizontale as, dus werd de kaartrij op zijn inhoudsmaat gezet en naar
       rechts geduwd. Gemeten op 390: de rij was 1030 pixels breed en begon op
       x = −640. Vandaar de half afgesneden kaart aan de linkerrand op Lucas'
       schermafdruk, zonder enige manier om hem in beeld te schuiven —
       `overflow-x: auto` doet niets als het element zelf al zo breed is als
       zijn inhoud.

       Nu blijft het een rij: de kaarten schuiven, de pauzeknop staat ernaast op
       zijn eigen 44 bij 44. Dat is ook minder hoog, wat op een telefoon de
       plek is waar hoogte het duurst is. */
    .hv-hero-foot { align-items: center; gap: .6rem; }
    /* `min-width: 0` is wat de rij LAAT schuiven. Een flex-item heeft van
       zichzelf `min-width: auto` = zo breed als zijn inhoud, en een
       scrollcontainer die nooit smaller wordt dan zijn inhoud, scrolt nooit. */
    .hv-slide-cards { min-width: 0; }
    .hv-slide-cards {
      display: flex; overflow-x: auto; scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch; scrollbar-width: none;
      margin-inline: calc(var(--pad-x) * -1); padding-inline: var(--pad-x);
    }
    .hv-slide-cards::-webkit-scrollbar { display: none; }
    .hv-slide-card { flex: 0 0 auto; min-width: 12rem; scroll-snap-align: start; }
    /* Was `width: 100%` — dat hoorde bij de doos van vroeger, toen de knop een
       zesde kaart was en op een telefoon onder de rij een eigen balk kreeg.
       Zonder doos is een knop van 352 pixels breed alleen nog een groot
       onzichtbaar vlak. Zijn eigen maat, dus. */
    .hv-hero-toggle { width: 2.75rem; height: 2.75rem; }
  }
  /* 900, NOT 800 — Lucas: *"misschien kan je de witte tekst dikgedrukt maken."*
     The complaint underneath it was that "visualized." looks bigger than the
     two lines above. It is not: all three run at the same font-size and their
     x-heights are within 1% of each other. What differs is WEIGHT — the italic
     line's stems are 73px against the white lines' 26px at a 200px test size,
     2.8 times thicker — and mass reads as size.

     Big Shoulders at its maximum only closes part of that: 900 takes the stem
     from 26px to 30px, so the italic is still 2.4x thicker. That is the price
     of a condensed display face, whose stems stay narrow at every weight by
     construction. It is worth doing anyway — the perceived gap narrows much
     more than the stem ratio suggests, because at display size the counters
     close up too — but the two faces will never weigh the same, and chasing
     that with font-size would make the line genuinely smaller while still
     looking heavier. */
  .hv-h1 { font-family: var(--font-heading); font-weight: 900; font-size: var(--t-hero); line-height: 0.98; letter-spacing: -0.012em; margin: 0; color: var(--paper-on-dark); }
  .hv-line { display: block; }
  /* :global(), omdat deze <em> via set:html binnenkomt en dus geen
     data-astro-cid-attribuut draagt — precies dezelfde reden als bij
     `.pack-p :global(a)` in CatalogPage.astro. Zonder dit blijft het accent wit. */
  .hv-h1 :global(em) { font-family: var(--font-editorial); font-style: italic; font-weight: 900; letter-spacing: -0.03em; }
  .hv-cta { display: flex; gap: var(--gap-actions); flex-wrap: wrap; margin-top: clamp(1.6rem, 3vw, 2.2rem); }
  @media (max-width: 560px) { .hv-cta > .btn { width: 100%; } }

  /* ── DE ENE REGEL ONDER DE KNOPPEN ───────────────────────────────────────
     Was `.hv-cta-note`, een voetnoot met de voorwaarden van de proefvisual.
     Draagt nu de leverbelofte — het enige van de drie vinkjes dat niet verderop
     op deze pagina al staat. Zie de noot in de markup.

     KLEUR ONVERANDERD. --paper-soft-on-dark is de tint die op deze foto met het
     bestaande scrim door de contrasteis komt. Een tint dimmer "omdat het klein
     is" zakt daar onmiddellijk doorheen, en kleine tekst op een foto is precies
     waar dat niet mag.

     GROTER DAN DE OUDE VOETNOOT: .875rem in plaats van .8125rem, de maat die de
     vinkjes hadden. Dit is geen kleine lettertjes meer maar een belofte, en het
     is het laatste wat er gelezen wordt voor de klik.

     De marge is klein aan de bovenkant: dat is wat de regel aan de knoppen
     vastplakt in plaats van hem een eigen blok te laten worden. Nabijheid doet
     het groeperingswerk, geen lijn en geen kader. */
  .hv-cta-claim { margin: .85rem 0 0; max-width: 52ch;
    font-size: .875rem; line-height: 1.5; text-wrap: pretty;
    color: var(--paper-soft-on-dark); }

  /* ── ALLEEN VOOR EEN SCHERMLEZER ─────────────────────────────────────────
     De klassieke afkniptruc, en met opzet niet `display: none`: `aria-describedby`
     op de proefvisualknop wijst naar dit element, en `display: none` haalt het
     uit de toegankelijkheidsboom. Dan hoort juist de bezoeker die de voorwaarden
     nodig heeft, ze niet.

     `white-space: nowrap` hoort erbij: zonder dat kan een lange tekst in een
     doos van 1px per WOORD afbreken, en sommige schermlezers lezen dat dan als
     losse regels voor. */
  .hv-sr { position: absolute; width: 1px; height: 1px; overflow: hidden;
    clip-path: inset(50%); white-space: nowrap; }

  /* Hier stonden `.hv-proof`, `.hv-proof li` en `.hv-proof svg` — de drie
     vinkjes onder de knoppen, met de motivering om ze naast elkaar te zetten en
     de krimpregel die ze bij 150% tekstgrootte binnen de kolom hield. Het blok
     is op 25 augustus 2026 uit de hero gehaald; zie de noot bij `hv-cta-claim`
     in de markup voor waarom twee van de drie claims konden vervallen. */

  /* ═══════════════════════════════════════════════════════════════════════
     DE HERO KOMT OP VOLGORDE BINNEN — 25 AUGUSTUS 2026
     ═══════════════════════════════════════════════════════════════════════

     Lucas: *"misschien een animatie bedenken voor de knoppen zodat ze niet
     allemaal tegelijk zichtbaar zijn."*

     ── DE KOP EN DE FOTO BEWEGEN NIET MEE, EN DAT IS DE KERN ────────────────

     Die twee bepalen samen de Largest Contentful Paint, en een element op
     `opacity: 0` telt NIET als geverfd. De kop laten infaden verschuift die
     meting dus met de volle lengte van de animatie — op precies het beeld
     waarvoor `fetchpriority="high"` en `decoding="sync"` in de markup staan.
     Hier iets aan toevoegen is de duurste animatie op de hele site.

     Het is bovendien beter ontwerp: de belofte hoort er in beeld één te staan,
     en de rest bouwt zich eronder op.

     ── WAAROM `.js` EN NIET `.is-live` ─────────────────────────────────────

     `.js` staat er vóór de eerste verf (het inline-script in de <head> van
     Layout.astro) en gaat er weer AF als interactions.js niet komt opdagen.
     Geen script, geen verbergen, gewoon een zichtbare hero — dat is dezelfde
     poort die de scrollonthulling in global.css gebruikt, en om dezelfde reden.

     `.is-live` zou hier fout zijn, twee keer. Die klasse komt pas als de
     carrousel initialiseert, dus de knoppen zouden eerst te ZIEN zijn en dan
     wegspringen om alsnog binnen te komen. En bij een zachte navigatie terug
     naar de homepage komt hij soms helemaal niet — dat staat als gemeten
     gedrag in de noot bij het carrouselscript.

     ── DE WISSELENDE REGEL DOET NIET MEE ───────────────────────────────────

     `.hv-slide-note` staat `hidden` in de bron en wordt door zetNoot() zichtbaar
     gemaakt. Een animatie op een element met `display: none` draait niet, dus
     die zou pas starten op het moment dat het script hem toont — een ander
     moment dan de rest, en niet te voorspellen. Hij blijft daarom zoals hij was.

     ── DE TIJDEN ───────────────────────────────────────────────────────────

     Kolom 80ms per stap, rij 55ms. De rij loopt sneller met opzet: vijf kaarten
     op 80ms duren in hun eentje al 400ms en dan wordt het een optocht. Op 55ms
     leest de rij als één veeg, en dat klopt ook — de rij is één ding en de twee
     knoppen zijn twee beslissingen. Alles staat binnen 680ms stil.

     De stap per kaart komt uit `--stap` op de kaart zelf, gezet in de map. Niet
     uit nth-child: dan krijgt een zesde dienst stil geen vertraging. */
  @media (prefers-reduced-motion: no-preference) {
    /* EIGEN KEYFRAMES EN NIET `vis-rise` UIT global.css. Die bestaan daar en
       doen exact dit, maar dit is een SCOPED <style> van Astro: een naam die
       hier alleen wordt aangeroepen en niet gedefinieerd, is precies het soort
       verwijzing dat door de scoping kan glippen. Twee regels dupliceren is
       goedkoper dan een animatie die in de build stil niets doet. */
    .js .hv-hero .hv-cta > .btn,
    .js .hv-hero .hv-cta-claim { animation: hv-in var(--dur-2) var(--ease-out-expo) both; }
    .js .hv-hero .hv-cta > .btn:nth-child(1) { animation-delay: 0ms; }
    .js .hv-hero .hv-cta > .btn:nth-child(2) { animation-delay: 80ms; }
    .js .hv-hero .hv-cta-claim { animation-delay: 160ms; }

    .js .hv-hero .hv-slide-card {
      animation: hv-in-far var(--dur-2) var(--ease-out-expo) both;
      animation-delay: calc(220ms + var(--stap, 0) * 55ms);
    }
  }
  @keyframes hv-in     { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }
  @keyframes hv-in-far { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: none; } }

  @media (max-width: 760px) {
    /* The WhatsApp launcher is position: fixed at bottom-left and the hero is
       100svh, so on a phone the launcher and the foot of the hero occupy the
       same pixels on first paint — it used to sit on top of the third fact in
       the plinth, and after that on the third proof line. Both are gone since
       25 August 2026; what sits there now is the claim line under the buttons,
       and it needs the same clearance. 48px launcher + its 12px inset + air.
       Measured, not padded by feel. */
    .hv-hero-copy { padding-bottom: 5.25rem; }
  }

  /* ── the one accent word ────────────────────────────────────────────────
     Teal is spent on the primary action and one headline word. On the dark
     ground --teal-text is unreadable, so the highlight is carried by full
     paper against the soft paper the rest of the line runs at — value rather
     than hue, which is the same idea in the material the ground allows. */
  /* The accent word in a section heading. It was paper-on-paper — the same
     white as the rest of the line, so "accent" meant italics-turned-off and
     nothing else. It is the palette's blue now, which is what OPP does with
     the word that carries the sentence. */
  .hv-accent { font-style: normal; color: var(--fill-blue); }


  /* ── tiles ─────────────────────────────────────────────────────────────── */
  /* .hv-tile-sub droeg de regel "€ x per stuk" onder de drie uitgewerkte
     totalen. Die tegels staan sinds augustus 2026 alleen nog op /pricing, en de
     regel is met ze meegegaan. */

  /* ── the price band ────────────────────────────────────────────────────────
     THE ONE VAT LINE. It is a block qualifier, so it has to read as governing
     what comes after it rather than as the end of the lede — hence the rule
     above it and the uppercase tracking, which is the same treatment the
     .lad-kind-vat cell gets on /pricing — minus its uppercase, because that
     cell is two words and this is a sentence, and a sentence in caps shouts.
     It sits between the statement and the table on purpose: a qualifier under
     the figures is a footnote, and a footnote is what "excl. VAT" ×8 was
     trying to avoid being. */
  .hv-price-vat {
    margin: clamp(2rem, 4vw, 3rem) 0 0;
    padding-top: clamp(1rem, 2vw, 1.4rem);
    box-shadow: inset 0 1px 0 var(--line);
    font-size: .82rem; font-weight: 700; letter-spacing: .01em; color: var(--ink-2);
  }
  /* The rate card. Radius on the wrapper rather than the table, because a
     table cannot clip its own corners and --r-md is the step this system gives
     a surface inside a band. overflow-x so four columns survive a 320px
     screen without the page itself scrolling sideways. */
  .hv-lad-wrap {
    margin-top: clamp(1rem, 2vw, 1.4rem);
    border: 1px solid var(--line-strong);
    border-radius: var(--r-md);
    overflow-x: auto;
  }
  /* ── DE TABEL PAST NU OP EEN TELEFOON — 20 augustus 2026 ─────────────────
     Lucas stuurde er een foto van: de derde kolom liep van het scherm af,
     "€1…", "€8…", "€6…". Gemeten op 390: de tabel was 379 breed in een vak van
     350 — negenentwintig pixels te veel, dus hij schoof, maar zonder dat je
     ZAG dat hij schoof. Een tabel die half in beeld staat leest niet als
     "veeg naar rechts", die leest als kapot.

     Negenentwintig pixels is te halen zonder iets weg te laten: de
     zijpadding van de cellen omlaag, de bedragen een tikje kleiner, en de
     bovenregel van elke kolom ("4 beelden · per product") mag afbreken in
     plaats van de kolom breed te houden. Alle drie de kolommen blijven staan,
     want een prijstabel waar een kolom van afvalt is geen prijstabel.

     EN ALS HIJ TOCH NIET PAST (320px, of een grotere lettergrootte in het
     systeem) dan schuift hij nog steeds — met een verloop aan de rechterrand
     dat zegt dat er meer is. Zelfde middel als bij de dienstenrij. */
  .hv-lad-wrap {
    --fade: 1.6rem;
    -webkit-mask-image: linear-gradient(to right, #000 calc(100% - var(--fade)), transparent 100%);
            mask-image: linear-gradient(to right, #000 calc(100% - var(--fade)), transparent 100%);
  }
  /* Past hij helemaal, dan hoort er geen verloop te staan — een fade zonder
     iets erachter is een belofte dat er meer is. `:not(:has(...))` kan dat niet
     meten, dus doet het script het: railNav() zet `is-fit` zodra scrollWidth
     gelijk is aan clientWidth. Zie de noot daar. */
  .hv-lad-wrap.is-fit { -webkit-mask-image: none; mask-image: none; }
  /* Lining, tabular: rates in a column have to line up or the column stops
     being scannable, which is the whole reason this is a table. */
  .hv-lad { width: 100%; border-collapse: collapse; font-variant-numeric: tabular-nums lining-nums; }
  .hv-lad th, .hv-lad td { padding: clamp(.7rem, 1.4vw, 1rem) clamp(.7rem, 1.6vw, 1.3rem); text-align: right; vertical-align: top; }
  .hv-lad thead th { vertical-align: bottom; border-bottom: 1px solid var(--line-strong); }
  .hv-lad tbody tr + tr th, .hv-lad tbody tr + tr td { border-top: 1px solid var(--line); }
  .hv-lad thead th:first-child, .hv-lad tbody th { text-align: left; }
  .hv-lad-corner { font-size: .68rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--ink-3); white-space: nowrap; }
  .hv-lad-kind { display: block; font-size: .95rem; font-weight: 700; color: var(--ink); }

  /* A link in a table header needs a cue AT REST — nobody hovers five columns
     to find out which two are clickable. Hairline underline, accented on
     interaction, so the page's accent stays on the CTA. */
  .hv-lad-kind a { text-decoration: underline; text-decoration-thickness: 1px; text-decoration-color: var(--line-strong); text-underline-offset: 4px; }
  .hv-lad-kind a:hover, .hv-lad-kind a:focus-visible { text-decoration-thickness: 2px; text-decoration-color: var(--accent); }
  .hv-lad-sub { display: block; margin-top: .3rem; font-size: .74rem; font-weight: 400; line-height: 1.4; color: var(--ink-3); }

  @media (max-width: 30rem) {
    .hv-lad th, .hv-lad td { padding-inline: .45rem; }
    .hv-lad td { font-size: .95rem; }
    .hv-lad thead th:first-child, .hv-lad tbody th { padding-left: .7rem; }
    .hv-lad-kind { font-size: .88rem; }
    .hv-lad-sub { white-space: normal; }
    .hv-lad tbody th { font-size: .88rem; }
  }

  .hv-lad tbody th { font-family: var(--font-display); font-weight: 700; font-size: .95rem; color: var(--ink); white-space: nowrap; }
  .hv-lad td { font-family: var(--font-display); font-weight: 800; font-size: clamp(1rem, 1.6vw, 1.25rem); line-height: 1; letter-spacing: -0.02em; color: var(--ink); }
  /* Kleiner en groen, onder het tarief in dezelfde cel. Groen omdat het het
     enige getal in de tabel is dat een VOORDEEL uitdrukt in plaats van een
     prijs; alle andere cijfers zijn wat je betaalt. */
  .hv-lad-save { display: block; margin-top: .2rem; font-size: .72rem; font-weight: 600; color: var(--accent); white-space: nowrap; font-variant-numeric: tabular-nums; }
  .hv-lad-note { margin: 1rem 0 0; font-size: .85rem; line-height: 1.6; color: var(--ink-3); max-width: 62ch; }  /* The discount, on its own line with a rule above it, because it is a
     condition on every figure in the band and not a fourth worked example. */
  .hv-price-first {
    margin: clamp(1.6rem, 3vw, 2.2rem) 0 0;
    padding-top: clamp(1.1rem, 2vw, 1.5rem);
    box-shadow: inset 0 1px 0 var(--line);
    font-size: .9rem; line-height: 1.6; color: var(--ink-3); max-width: 62ch;
  }
  .hv-price-first strong { color: var(--ink); font-weight: 700; }
  /* ── DE VOET VAN DE PRIJSBAND — UITGELIJND, 18 augustus 2026 ──────────────
     Gemeten op de gebouwde pagina: onder de tabel van 940px stonden drie
     verschillende tekstbreedtes (520, 490 en 400px) en een knoppenrij die op
     niets uitlijnde. Vier linkerkanten die wel klopten, vier rechterkanten die
     nergens op eindigden. Dat is wat "rommelige marges" betekent als je het
     opmeet.

     Nu: één raster met twee kolommen die op de RANDEN VAN DE TABEL eindigen.
     De noten links, de knoppen rechts uitgelijnd op de rechterrand van de
     tabel erboven, en beide meten met dezelfde maat als de rest van de band.
     `align-items: end` zet de knoppen op de onderregel van de noten in plaats
     van te laten zweven op een hoogte die uit niets volgt. */
  .hv-price-foot {
    margin-top: clamp(1.4rem, 2.6vw, 2rem);
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: clamp(1.2rem, 3vw, 2.5rem);
    align-items: end;
  }
  .hv-price-notes { display: grid; gap: .7rem; }
  .hv-price-notes p { margin: 0; max-width: 62ch; font-size: .85rem; line-height: 1.6; color: var(--ink-3); }
  @media (max-width: 52rem) {
    /* Onder de 52rem past een knoppenrij niet meer naast tekst zonder dat er
       één woord per regel overblijft. Dan onder elkaar, en de knoppen links —
       uitlijnen op rechts heeft geen betekenis meer als er geen tweede kolom is. */
    .hv-price-foot { grid-template-columns: 1fr; }
  }
    /* `flex: 0 0 auto` refused to shrink, so at 360px the Dutch ghost button
     ("De volledige prijslijst", 174px against the English 138px) pushed the row
     to 370.8px and the whole page scrolled sideways. It may shrink now; the
     buttons wrap instead. */
  /* `flex-end` gaf op een telefoon twee knoppen die allebei tegen de
     rechterrand hingen op verschillende inspringing — de enige twee elementen
     op de hele pagina die dat deden. Onder de 40rem staan ze links en op volle
     breedte, zoals elke andere knoppenrij op deze site. */
  .hv-price-cta { min-width: 0; display: flex; gap: .75rem; flex-wrap: wrap; justify-content: flex-end; }
  @media (max-width: 40rem) {
    .hv-price-cta { justify-content: stretch; flex-direction: column; }
    .hv-price-cta .btn { width: 100%; }
  }
  /* vatNote() as a disclosure rather than as small print. It is forty words
     that matter enormously to the one reader in ten who is about to check
     whether reverse charge applies, and are noise to the other nine — which is
     exactly what <details> is for, and the pattern /faq and /start already use.
     The label above still says "excl. VAT" in plain sight; this is only the
     mechanism. Do not inline it back: that is how a price band grows a
     paragraph of tax law between the rate card and the button. */
  /* ══ DE DIENSTENRIJ ══════════════════════════════════════════════════════
     Zie de lange noot bij de markup voor wat er bij Adobe is opgemeten en
     waarom het raster van twee bij twee weg is. Hieronder staan de getallen.

     DE RIJ SCHUIFT ZELF, ER ZIT GEEN SCRIPT AAN. `overflow-x: auto` met
     scroll-snap doet wat hun `.elastic-carousel` met een transform en een
     transition doet, en het werkt met een muiswiel, een trackpad, een veeg én
     de pijltjestoetsen zodra de rij focus heeft. Een carrousel die JavaScript
     nodig heeft om te schuiven, is een carrousel die stukgaat zodra dat script
     niet aankomt.

     `scroll-padding-inline` en de negatieve marge samen: de kaarten mogen tot
     tegen de rand van het venster schuiven (anders lijkt de rij op te houden
     waar de container ophoudt) maar de eerste staat wél op de bladspiegel. */
  .hv-svc-rail {
    /* ── position: relative, EN DIT IS EEN ECHTE FOUT DIE HIER LAG ───────────
       Zonder deze regel schuift de HOMEPAGE ZIJWAARTS: 1336px document in een
       venster van 390. Gemeten in een gewone browser, zonder testcode, met
       niets anders aangezet dan wat een bezoeker zelf kan aanzetten.

       De keten: in deze rij staan twee `span.hv-q-say` — de onzichtbare labels
       bij de twee "binnenkort"-kaarten — en die staan op `position: absolute`.
       Een absoluut geplaatst element hangt aan zijn dichtstbijzijnde
       GEPOSITIONEERDE voorouder. De rij was `static`, dus die voorouder was
       `section.band-chapter`, en dan valt zo'n label buiten de rij: hij wordt
       niet meer door `overflow-x: auto` afgeknipt en telt gewoon mee voor de
       breedte van de pagina.

       Waarom het toch bijna altijd goed ging: `hv-float` zet een `transform` op
       deze rij, en een element met een transform is óók een bevattend blok. De
       fout was dus verstopt achter een animatie. Precies dáár waar die animatie
       niet draait, komt hij tevoorschijn:

         · bij `prefers-reduced-motion: reduce` — de hele hv-float-regel staat
           in een `@media (prefers-reduced-motion: no-preference)`;
         · in elke browser zonder `animation-timeline: view()`, want de regel
           staat óók in een `@supports` daarvoor.

       Dat is niet een randgeval maar precies de bezoeker die het minst met een
       zijwaarts wegschuivende pagina geholpen is. Gemeten met Playwright op
       390px: `reducedMotion: 'reduce'` gaf 946px zijwaartse scroll, zonder gaf
       0. Met deze regel: 0 in allebei.

       (Het is ook wat de visuele vangrail acht opnamen van de homepage 1336 in
       plaats van 390 pixels breed maakte — dezelfde oorzaak, want die zet
       animaties uit om te kunnen vergelijken.) */
    position: relative;
    margin-top: clamp(1.6rem, 3vw, 2.4rem);
    display: flex;
    /* STRETCH EN NIET START, en dat is een afwijking van Adobe met een reden.
       Hun vijf kaarten hebben allemaal dezelfde onderdelen, dus worden ze
       vanzelf even hoog en mag `start` de kortere korter laten. Hier hebben
       twee van de zes geen foto en een uitklapper die opengaat; met `start`
       staan er dan twee kaarten van halve hoogte tussen vier volle, en dat
       leest als een gat en niet als een verschil. */
    align-items: stretch;
    gap: clamp(.75rem, 1.1vw, 1.1rem);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x proximity;
    scroll-padding-inline: var(--pad-x);
    margin-inline: calc(-1 * var(--pad-x));
    padding-inline: var(--pad-x);
    padding-block-end: .6rem;         /* ruimte voor de schaduw bij hover */
    /* De balk zelf weg: de kaarten die half buiten beeld staan zijn de
       aanwijzing dat er meer naast staat, en die is duidelijker dan een grijs
       streepje dat op een Mac toch pas verschijnt als je al scrollt. */
    scrollbar-width: none;
    /* ── EN VERTICAAL NOOIT — 24 augustus 2026 ─────────────────────────────
       `overflow-x: auto` maakt van `overflow-y` automatisch `auto`; dat is de
       CSS-regel en niet te omzeilen met `visible`. Zolang er niets uitsteekt
       merkt niemand het, en dat is precies waarom het zo lang goed ging.

       `clip` en niet `hidden`: `hidden` maakt hier alsnog een scrollcontainer
       (met scrollTop en al) en `clip` niet. En de marge erbij, want de kaarten
       hebben een schaduw bij hover die anders op de rand wordt afgesneden — de
       `padding-block-end` hierboven dekt de onderkant, deze regel de rest.

       Dit is de GORDEL en de bretels staan in de markup: het omhulsel
       `.hv-svc-float` haalt de oorzaak weg, deze regel zorgt dat een volgende
       oorzaak geen scrollbalk meer kan worden. Ze vervangen elkaar niet — met
       alleen deze regel zou de notitie afgeknipt zijn in plaats van scrollbaar,
       en dat is geen verbetering. */
    overflow-y: clip;
    overflow-clip-margin: 1.5rem;
  }
  .hv-svc-rail::-webkit-scrollbar { display: none; }

  /* DE KAARTMAAT. Adobe: 294px op een venster van 1905, oftewel 15,4%. Hier
     staan er zes en niet vijf, en de tekst is Nederlands (langer), dus een
     tikje ruimer: 17rem tot 21rem. Op 1920 is dat 336px en passen er vijf en
     een halve in beeld — precies genoeg om te zien dat de rij doorloopt. */
  .hv-svc-card {
    /* position: relative omdat dit blok afknipt (overflow: hidden) én absoluut
       geplaatste kinderen heeft. Zonder deze regel hangen die kinderen aan een
       voorouder BUITEN dit blok en worden ze dus niet mee afgeknipt — dezelfde
       constructie die op 20 augustus de homepage 946px zijwaarts liet schuiven
       (zie de noot bij .hv-svc-rail). Hier is er nu geen schade van, want de
       ontsnappers zijn onzichtbaar en staan op hun eigen plek; de regel staat er
       zodat het zo blijft. `npm run keuring` bewaakt dit patroon. */
    position: relative;
    flex: 0 0 clamp(15.5rem, 18vw, 21rem);
    scroll-snap-align: start;
    display: flex; flex-direction: column;
    border-radius: var(--r-lg);
    background: var(--surface);
    border: 1px solid var(--line);
    /* Dezelfde lichtlijn en val als elke andere kaart op de site. De regel staat
       sinds 20 augustus in global.css op `.card, .tile`; deze kaart is geen van
       beide, dus staat hij hier — met dezelfde waarden, en dat is met opzet:
       één diepte voor de hele site. */
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.06),
      0 18px 34px -26px rgb(0 0 0 / 0.55);
    overflow: hidden;
    color: inherit;
    transition: background var(--dur-1) var(--ease),
                border-color var(--dur-1) var(--ease),
                transform var(--dur-1) var(--ease);
  }
  a.hv-svc-card:hover { background: var(--bg-raise); border-color: var(--line-strong); transform: translateY(-3px); }

  /* DE KOP. Adobe: 72px hoog, 24px padding, pictogram 24×24, categorie 14/700.
     Hier iets krapper omdat de kaart smaller is dan de hunne breed is. */
  .hv-svc-card-head {
    display: flex; align-items: center; gap: .6rem;
    padding: clamp(.9rem, 1.4vw, 1.15rem) clamp(1rem, 1.5vw, 1.25rem);
    min-height: 3.4rem;
  }
  .hv-svc-card-i { width: 22px; height: 22px; flex: none; fill: none; stroke: var(--accent-bright); stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  .hv-svc-card-eyebrow { font-size: .78rem; font-weight: 700; letter-spacing: .01em; color: var(--ink-3); }

  /* HET BEELD. Staand, zoals bij Adobe (294×399 ≈ 3:4). Dat is de kern van de
     klacht "sommige foto’s zijn veel te groot": een 16:9-beeld over een halve
     paginabreedte is 745 bij 410 pixels, een 3:4 in deze kaart is 336 bij 448.
     Kleiner in oppervlak, en tegelijk MEER beeld — een staand kader laat van
     een persoon of een kledingstuk meer zien dan een liggend. */
  .hv-svc-card-media {
    display: block; aspect-ratio: 3 / 4; overflow: hidden;
    margin-inline: clamp(1rem, 1.5vw, 1.25rem);
    border-radius: var(--r-md);
    background: var(--bg-0);
  }
  .hv-svc-card-media img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform var(--dur-3) var(--ease); }
  a.hv-svc-card:hover .hv-svc-card-media img { transform: scale(1.04); }

  .hv-svc-card-body {
    display: flex; flex-direction: column;
    padding: clamp(.9rem, 1.4vw, 1.15rem) clamp(1rem, 1.5vw, 1.25rem) clamp(1.1rem, 1.7vw, 1.4rem);
  }
  .hv-svc-card-t { font-family: var(--font-body); font-weight: 700; font-size: 1.02rem; line-height: 1.25; color: var(--ink); }
  .hv-svc-card-p { margin-top: .45rem; font-size: .875rem; line-height: 1.55; color: var(--ink-3); }
  .hv-svc-card-go {
    margin-top: clamp(.8rem, 1.4vw, 1.1rem);
    display: inline-flex; align-items: baseline; gap: .4rem;
    font-size: .82rem; font-weight: 700;
    color: var(--accent-bright);
  }
  .hv-svc-arrow { transition: transform var(--dur-1) var(--ease); }
  a.hv-svc-card:hover .hv-svc-arrow { transform: translateX(3px); }

  /* DE TWEE DIE NOG NIET KUNNEN. Zelfde maat, zelfde vorm, geen beeld — want
     er is nog niets van te laten zien, en een placeholder zou hier beloven dat
     er al werk ligt. Gedempte rand en geen hover, zodat de kaart er niet
     aanklikbaar uitziet. */
  .hv-svc-card.is-soon { background: transparent; border-style: dashed; }
  .hv-svc-card-media.is-empty {
    display: grid; place-items: center;
    background: color-mix(in srgb, var(--bg-0) 60%, transparent);
    border: 1px dashed var(--line);
  }
  .hv-svc-card-mark { width: 30px; height: auto; fill: var(--ink-1); opacity: .13; }
  /* De knop naar de onderrand, zodat hij bij alle kaarten op dezelfde hoogte
     staat ook als de omschrijving één regel korter is. `margin-top: auto` werkt
     alleen omdat de body een flexkolom is die de kaarthoogte vult. */
  .hv-soon-btn { margin-top: auto; padding-top: 0; align-self: start; }
  .hv-svc-card.is-soon .hv-svc-card-body { flex: 1; }
  .hv-svc-card.is-soon .hv-svc-card-p { margin-bottom: clamp(.9rem, 1.5vw, 1.2rem); }

  @media (prefers-reduced-motion: reduce) {
    .hv-svc-card, .hv-svc-card-media img, .hv-svc-arrow,
    a.hv-svc-card:hover, a.hv-svc-card:hover .hv-svc-card-media img,
    a.hv-svc-card:hover .hv-svc-arrow { transition: none; transform: none; }
  }

  /* ══ HET FLOATY-EFFECT ═══════════════════════════════════════════════════
     Adobe’s `.parallax-move-up`, opgemeten: translateY(100px) ver onder de
     vouw, naar 0 als het blok binnenkomt (100 → 75,7 → 6,1 → 0).

     Deze site had alleen `vis-rise` (10px) en `vis-rise-far` (18px). Tien
     pixels is geen beweging die je ziet — het is beweging die je meet. Dat is
     de hele reden dat het hier nooit "floaty" aanvoelde. Zeventig pixels op de
     rij als geheel, niet per kaart: de rij drijft omhoog als één vlak, en dat
     is wat het rustig houdt.

     Zelfde constructie als de rest van de site: een scroll-tijdlijn, geen
     listener, en zonder ondersteuning gebeurt er niets. Zie DE BEWEGING KOMT
     UIT DE SCROLL ZELF in global.css. */
  /* ── EN OP DE ANDERE BLOKKEN OOK — 20 augustus 2026 ───────────────────────
     Dit stond alleen op de dienstenrail, en dat was de openstaande helft van
     "soortgelijke effecten waar ze passen". Nu drijven de vijf blokken op deze
     pagina omhoog die als ÉÉN vlak lezen: de dienstenrail, de gezichtenrail, de
     drie abonnementen, het overzicht en de vragenstrook.

     WAT ER BEWUST NIET BIJ ZIT. De hero (staat er al voordat je scrolt), het
     abonnementspaneel zelf (dat is één groot vlak; zeventig pixels drijven maakt
     daar een schok van in plaats van een beweging) en alles wat al een eigen
     scroll-effect heeft. Meer dan vijf en de pagina begint te deinen — het effect
     werkt omdat het opvalt dat het er níet overal is.

     Op de rij als geheel en niet per kaart, precies zoals de noot hierboven
     zegt: één vlak dat opkomt is rustig, zes kaarten die los opkomen is een
     etalage. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      /* `.hv-svc-float` en NIET `.hv-svc-rail` — zie de lange noot bij dat
         omhulsel in de markup. Kort: de transform die deze animatie zet, maakt
         van zijn element het bevattend blok voor elk `position: fixed` kind, en
         in de dienstenrij zit zo'n kind (de zwevende notitie). Stond die
         transform op de scrollende rij zelf, dan werd de notitie erin gevangen
         en werd de rij 29px verticaal scrollbaar.

         `.hv-faces` staat hier nog wél rechtstreeks bij en dat kan: die rij
         bevat geen notitie. Komt daar er ooit een in, dan hoort hij dezelfde
         behandeling te krijgen — tests/homerail.test.mjs zegt het wanneer. */
      .hv-svc-float,
      .hv-faces,
      .hv-plans,
      .hv-dash-row,
      .hv-ob {
        animation: hv-float linear both;
        animation-timeline: view();
        animation-range: entry 0% cover 30%;
      }
    }
  }

  .hv-svc-foot { margin-top: clamp(1.6rem, 3vw, 2.4rem); }
  @keyframes hv-float {
    from { opacity: 0; transform: translateY(70px); }
    to   { opacity: 1; transform: none; }
  }

  @media (max-width: 700px) {
    .rail-nav { display: none; }
    /* Two cards fit inside 390px, separated by the rail's 1px rule — which
       put one item's caption hard against the next item's label with nothing
       between them but a hairline. One and a bit cards is the right number on
       a phone: it shows there is more without pretending to show it. The
       caption stacks as well, because a label and a note side by side inside
       a 15rem card is two columns of two words. */
    .rail > * { flex-basis: 74vw; }
    .plate-cap { flex-direction: column; gap: .15rem; }
  }

  /* ── pipeline ──────────────────────────────────────────────────────────── */
  /* Geen eigen bovengrens meer. Zie de noot bij .hv-bm-band's rail-head: drie
     koppen op deze pagina hadden er één en die drie waren precies de drie waar
     de lede in een kolom van rond de 280 pixels stond te knijpen, tussen vijf
     andere die op 562 staan. `.statement-split` verdeelt de volle breedte al;
     een tweede maat eroverheen maakt hem alleen smaller. */
  .hv-pipe-head { max-width: none; }
  .hv-pipe { list-style: none; margin: clamp(2.4rem, 5vw, 3.5rem) 0 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(15rem, 100%), 1fr)); gap: 1px; background: var(--line); }
  .hv-pipe > li { background: var(--bg); padding: clamp(1.25rem, 2.2vw, 1.9rem); }
  /* Outlined numerals: the colour is the STROKE, because a filled 2.4rem 900
     numeral in four hues would out-shout the step it labels. The four are
     7.91–8.07:1 on this ground, well past the 3:1 a large glyph needs. */
  /* Eén lijnkleur voor alle vier. Zie de noot bij de markup. */
  .hv-pipe-n { font-family: var(--font-display); font-weight: 900; font-size: 2.4rem; line-height: 1; color: transparent; -webkit-text-stroke: 1.5px var(--accent); display: block; }
  .hv-pipe h3 { margin: 1rem 0 .45rem; font-size: 1.02rem; font-weight: 700; color: var(--ink); }
  .hv-pipe p { margin: 0; font-size: .875rem; line-height: 1.55; color: var(--ink-3); }

  /* The .hv-vs* rules went with the "What an order replaces" band — see the
     note where that band used to be, above section 6. */

  /* ── DE DIENST DIE NOG NIET KAN ────────────────────────────────────────────
     Onder de vier tegels, met een hairline erboven: het hoort bij de diensten en
     het is er geen vijfde van. Geen omkadering en geen eigen ondergrond, want dan
     wordt een aankondiging een aanbod.

     De knop staat er UITGESCHAKELD en niet weggelaten. Weglaten zou de strook een
     mededeling maken; een knop die er is en niet werkt, zegt precies wat er aan de
     hand is — er komt hier iets, en vandaag nog niet. */
  /* ── DE TWEE DIE NOG NIET KUNNEN, 19 augustus 2026 ────────────────────────
   *
   * Dit waren twee STROKEN onder de vier kaarten: volle breedte, een haarlijn
   * erboven, kleine letter. Dat was de juiste keuze toen de vier kaarten nog
   * even hoog werden uitgerekt en er van een vijfde tegel een gat rechtsonder
   * kwam (zie de oude noot bij de markup, die reden staat er nog).
   *
   * Sinds de tegels op `align-items: start` staan en hun natuurlijke hoogte
   * houden, geldt dat argument niet meer — en het contrast werd juist erger van
   * het opknappen van de kaarten: vier royale kaarten met beeld, en daaronder
   * twee tabelrijen. Ze horen bij hetzelfde rijtje diensten, dus horen ze
   * hetzelfde te lezen.
   *
   * Nu twee halve kaarten in datzelfde raster. Wat ze ONDERSCHEIDT is niet
   * langer hun vorm maar hun afwerking: geen beeld, een gedempte grond en een
   * streepjesrand — dezelfde taal die de lege upload-vakjes in het
   * bestelformulier gebruiken voor "hier hoort iets te komen". Plus de
   * BINNENKORT-badge en de uitgeschakelde knop die er al stonden.
   *
   * De uitklapper, de id's (#hooks, #editions) en de dode knop blijven precies
   * zoals ze waren; alleen de omlijsting verandert.
   */
  /* De strook is een KAART geworden (20 augustus 2026, zie de noot bij de
     markup): dezelfde maat als de vier diensten, in dezelfde rij. Wat daarvan
     over moet blijven is het id-anker — er kan naar #hooks gelinkt worden en
     dan hoort de kaart niet onder de vaste balk te landen. Zelfde waarde als
     .faq-group. De vulling, de rand en de streepjesrand staan nu bij
     `.hv-svc-card.is-soon`; hier stond dat twee keer. */
  .hv-svc-card.is-soon { scroll-margin-top: clamp(5rem, 10vw, 7rem); }

  /* ── DE TITELREGEL VAN EEN DIENST DIE ER NOG NIET IS ─────────────────────
     Hier stond zeventig regels CSS voor een <details>: het driehoekje op drie
     manieren weg, een `fit-content`-klikvlak, een eigen rondje, een eigen
     onzichtbaar label en een eigen paneel. Dat is op 21 augustus 2026 allemaal
     vervangen door <Note>, dat precies dat doet en op de hele site één keer
     staat in plaats van hier nog een keer.

     Wat er over moet blijven is de REGEL zelf: naam en vraagteken naast elkaar,
     met dezelfde afbreekregel als eerst — in de smalle kolom van deze kaart moet
     het rondje bij de naam kunnen blijven ook als het niet meer past. */
  .hv-q-t { display: flex; flex-wrap: wrap; align-items: center; gap: .45rem; margin: 0; }

  /* Wat er in de notitie staat. Kop en tekst in ÉÉN alinea, niet in twee
     elementen boven elkaar: het is één mededeling met een aanhef, en twee
     blokken maken er een lijst van die met de vier diensttegels gaat
     concurreren. */
  :global(.nt-pop) .hv-q-row { margin: 0; font-size: .875rem; line-height: 1.65; }
  :global(.nt-pop) .hv-q-row + .hv-q-row { margin-top: .7rem !important; }
  :global(.nt-pop) .hv-q-k { color: var(--ink); font-weight: 700; }
  :global(.nt-pop) .hv-q-k::after { content: ' — '; color: var(--ink-3); font-weight: 400; }
  :global(.nt-pop) .hv-q-v { color: var(--ink-2); }
  :global(.nt-pop) .hv-q-foot {
    margin: .9rem 0 0; padding-top: .75rem;
    box-shadow: inset 0 1px 0 var(--line);
    font-size: .8rem; line-height: 1.6; color: var(--ink-3);
  }
  /* Hetzelfde rustige label als in het menu (.mi-soon in Layout.astro) en met
     opzet niet in de accentkleur: het accent is de kleur van een handeling, en dit
     is de reden om iets NIET te doen. */
  .hv-soon-tag {
    display: inline-block; margin-left: .5rem;
    font-style: normal; font-weight: 600;
    font-size: .64rem; letter-spacing: .08em; text-transform: uppercase;
    color: var(--ink-3);
    padding: .12rem .4rem;
    border: 1px solid var(--line-strong); border-radius: var(--r-pill);
    vertical-align: middle;
  }
  /* Uitgeschakeld hoort uitgeschakeld te ZIEN, en de cursor hoort het te zeggen
     voordat iemand klikt. `pointer-events` blijft aan: een cursor die niet
     verandert, is een knop waarvan je pas na de klik weet dat hij dood is. */
  .hv-soon-btn[disabled] {
    opacity: .45; cursor: not-allowed;
    color: var(--ink-3); border-color: var(--line);
  }

  /* ── the dashboard band ────────────────────────────────────────────────── */
  .hv-dash { margin-top: clamp(2.6rem, 5vw, 4rem); display: grid; gap: 1px; background: var(--line); }
  .hv-dash-row { background: var(--bg); display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(1.5rem, 3vw, 3rem); align-items: center; padding: clamp(1.5rem, 3vw, 2.6rem); }
  /* ── DE ZWEVENDE SCHERMEN ──────────────────────────────────────────────────
     De kolommen worden EXPLICIET geplaatst, niet met `order` en niet met
     `direction`. Beide zijn hier geprobeerd en beide hebben een stille bijwerking:

     · `order` wisselt wel de leesvolgorde maar niet de tracks, dus de FIGUUR
       kreeg de smalle 5fr en de TEKST de brede 7fr. Op 1240px stond het scherm in
       432px terwijl de tekst 605px had waarvan 220px leeg bleef.
     · `direction: rtl` wisselt de tracks wél, maar keert ook de kant op waar een
       te breed kind overloopt — en dit kind is met opzet 139% breed (zie --k
       hieronder). De figuur liep daardoor over de tekst.

     grid-column zegt gewoon welke kolom wat krijgt. De 7fr gaat altijd naar het
     scherm, aan welke kant het ook staat, en overloop blijft één richting op
     zodat transform-origin voor beide rijen hetzelfde kan zijn. */
  /* ── EN grid-row: 1 ERBIJ, WAT GEEN NETHEID IS MAAR DE BUG ─────────────────
     Lucas, 9 augustus 2026: *"de Our side mock-up moet gecentreerd worden met de
     tekst ernaast."* Hij stond niet naast die tekst maar eronder, en de reden is
     een regel hierboven die er niet staat.

     Alleen grid-column zetten is niet genoeg. Bij de omgekeerde rij krijgt de
     TEKST kolom 2 en wordt hij als eerste geplaatst; daarna moet de figuur naar
     kolom 1, en automatische plaatsing gaat nooit terug naar een kolom die al
     voorbij is. Dus maakte de browser een tweede rij aan. Gemeten in de gebouwde
     pagina: grid-template-rows stond op `172.766px 430.609px` — twee rijen — en
     `align-items: center` centreerde daarna netjes binnen elk van die twee. Het
     zag eruit als een uitlijnprobleem en het was een plaatsingsprobleem.

     Met een expliciete rij is er één rij, staan beide cellen ernaast, en doet
     align-items: center wat er al die tijd stond. De gestapelde variant onder de
     980px zet zijn eigen grid-row 1 en 2 — zie daar. */
  .hv-dash-row.is-showcase { align-items: center; }
  .hv-dash-row.is-showcase > .hv-dash-copy { grid-column: 1; grid-row: 1; }
  .hv-dash-row.is-showcase > .hv-stage { grid-column: 2; grid-row: 1; }
  .hv-dash-row.is-showcase.is-flip > .hv-dash-copy { grid-column: 2; grid-row: 1; }
  .hv-dash-row.is-showcase.is-flip > .hv-stage { grid-column: 1; grid-row: 1; }

  /* ── DE FIGUURKOLOM IS BREDER DAN DE TEKSTKOLOM, EN NU MEER DAN EERST ──────
     Lucas: *"beide mock up schermen kunnen wat groter."* Er zijn twee knoppen
     waarmee dat kan en ze doen niet hetzelfde:

       · deze verhouding — de figuur krijgt meer millimeters
       · --k hieronder — dezelfde millimeters, maar minder verkleind, dus grotere
         letters en knoppen in het scherm zelf

     Beide zijn opengedraaid, en de tekstkolom houdt genoeg over: de paragraaf
     heeft max-width 46ch en die haalt hij op 4.5fr nog. */
  .hv-dash-row.is-showcase { grid-template-columns: minmax(0, 4.5fr) minmax(0, 7.5fr); }
  .hv-dash-row.is-showcase.is-flip { grid-template-columns: minmax(0, 7.5fr) minmax(0, 4.5fr); }

  /* ── WAAROM --lift GEREGISTREERD IS ────────────────────────────────────────
     Een custom property die niet is aangemeld, heeft geen type. De browser kan
     dan niet tussen twee waarden rekenen en zet hem halverwege in één keer om:
     de figuur zou schokken in plaats van zweven. @property geeft hem een type en
     daarmee interpolatie.

     En waarom de animatie alleen --lift beweegt en niet de hele transform: een
     animatie wint in de cascade van een gewone declaratie. Zou hij `transform`
     zetten, dan zou de hover-transform hieronder nooit aankomen — ook niet met
     animation-play-state: paused, want een gepauzeerde animatie blijft zijn
     waarde opleggen. Door alleen de variabele te bewegen houdt de declaratie de
     regie en kunnen zweven en hover naast elkaar bestaan. */
  @property --lift {
    syntax: '<length>';
    inherits: false;
    initial-value: 0px;
  }

  /* Het podium geeft de perspectiefdiepte. Die hoort op de OUDER en niet op het
     element zelf: perspective op het element zelf laat elk kind zijn eigen
     verdwijnpunt krijgen, en dan kantelt de figuur niet als één plaat maar als
     een stapel losse kaarten. 1800px is ver genoeg dat de vervorming leest als
     een scherm dat een beetje wegdraait en niet als een fisheye. */
  .hv-stage { perspective: 1800px; perspective-origin: 50% 40%; }

  /* De kanteling en de zweving zijn twee TRANSFORMS OP ÉÉN ELEMENT, via een
     variabele: transform is één eigenschap, dus twee regels die hem beide zetten
     overschrijven elkaar. --lift wordt door de animatie bewogen, de rest staat
     vast. */
  /* ── OP WARE GROOTTE TEKENEN, DAARNA VERKLEINEN ──────────────────────────
     Eerste poging was: de figuur laten meekrimpen met de kolom. Dat paste, maar
     onder de 720px stapelt hij zijn zijbalk en dan las hij als een telefoon in
     plaats van als een dashboard — precies het beeld dat deze sectie niet wil
     verkopen.

     Dus krijgt hij een lay-outbreedte van 100%/--k (bij --k .72 is dat 139% van
     de kolom) en wordt hij met scale(--k) teruggebracht tot exact de kolom. De
     rekensom is bij elke vensterbreedte consistent, dus dit heeft geen
     breekpunten en geen JavaScript nodig: de figuur denkt altijd dat hij ~840px
     breed is, blijft dus zijn zijbalk tonen, en wat je ziet is een desktop-
     dashboard op schaal. De 7fr-track is minmax(0, 7fr), dus die 139% blaast de
     grid niet op — hij loopt over en de schaal haalt hem terug.

     transform-origin blijft voor BEIDE rijen links: de 39% overloop gaat altijd
     naar rechts (het document is links-naar-rechts), dus links ankeren laat de
     verkleinde figuur exact op de kolombreedte uitkomen — geen overloop, geen
     gat. Rechts ankeren zou hem de andere kant op duwen. */
  /* ── WAT --k MAG ZIJN, EN WAAR DIE GRENS VANDAAN KOMT ─────────────────────
     De figuur wordt op 100%/--k getekend en met scale(--k) teruggebracht, dus
     --k is letterlijk de zoomfactor van wat je ziet. Groter is beter tot precies
     één punt: FigDash heeft container queries op 560, 600 en 700px, en onder de
     700 wordt zijn fotorooster één kolom, onder de 600 gaat zijn zijbalk boven de
     panelen staan. Dan is het geen dashboard meer maar een telefoon, en dat is
     het beeld dat deze band niet verkoopt.

     De ondergrens is dus niet esthetisch maar meetbaar: de LAYOUTBREEDTE van de
     figuur — kolombreedte gedeeld door --k — moet boven de 700px blijven, ook op
     het smalste venster waar deze rij nog twee kolommen heeft (980px, zie de
     media query onderaan). Daarom staat --k in banden en niet op één waarde: op
     980px is er domweg minder te verdelen dan op 1600px.

     Gemeten na deze wijziging, aan het BEGIN van elke band — daar is de kolom het
     smalst en staat de vloer dus het dichtst bij:

        981px → 707px       1100px → 735px
       1250px → 796px       1500px → 748px      1920px en breder → 745px

     Elke band begint dus net boven de 700 en loopt daarboven op tot de volgende
     stap hem terugzet. Wie --k verder wil opendraaien, meet die kolom eerst: zakt
     hij onder de 700, dan verandert de figuur van VORM en niet van maat, en dat
     zie je niet als je alleen naar één vensterbreedte kijkt. */
  .hv-float {
    --k: .72;
    --lift: 0px;
    width: calc(100% / var(--k));
    transform-origin: left center;
    transform: scale(var(--k)) translate3d(0, var(--lift), 0) rotateY(-9deg) rotateX(3.5deg) rotateZ(-.6deg);
    transform-style: preserve-3d;
    will-change: transform;
    transition: transform .5s cubic-bezier(.16, 1, .3, 1);
    animation: hv-drift 7s cubic-bezier(.37, 0, .63, 1) infinite alternate;
  }
  /* De tweede rij staat aan de andere kant, dus draait hij de andere kant op —
     beide schermen kijken naar de tekst die erover gaat. */
  .is-flip .hv-float {
    transform: scale(var(--k)) translate3d(0, var(--lift), 0) rotateY(9deg) rotateX(3.5deg) rotateZ(.6deg);
    animation-delay: -3.5s;
  }
  /* Naar je toe komen als je erbij komt. Niet helemaal plat: dan springt de
     hoogte van de figuur en verschuift de rij eronder. */
  .hv-dash-row.is-showcase:hover .hv-float,
  .hv-dash-row.is-showcase:focus-within .hv-float {
    transform: scale(var(--k)) translate3d(0, calc(var(--lift) - 6px), 0) rotateY(-3deg) rotateX(1deg) rotateZ(-.2deg);
    animation-play-state: paused;
  }
  .is-flip:hover .hv-float,
  .is-flip:focus-within .hv-float {
    transform: scale(var(--k)) translate3d(0, calc(var(--lift) - 6px), 0) rotateY(3deg) rotateX(1deg) rotateZ(.2deg);
  }

  /* Meer ruimte, dus minder verkleinen. De bovengrens van elke band is gekozen op
     de 700px-vloer uit de noot bij .hv-float. */
  @media (min-width: 1100px) { .hv-float { --k: .78; } }
  @media (min-width: 1250px) { .hv-float { --k: .82; } }
  @media (min-width: 1500px) { .hv-float { --k: .86; } }

  @keyframes hv-drift {
    from { --lift: 6px; }
    to   { --lift: -6px; }
  }

  /* DESIGN.md haalt box-shadow als dieptesignaal weg — hairlines en papierwaarde
     doen dat werk. Een gekanteld scherm is de uitzondering waar die regel voor
     bedoeld is: zonder iets onder zich zweeft het niet, het staat schuin. Dus
     geen zachte wolk maar een gerichte schaduw die zegt waar de vloer is, in
     zwart en niet in een tint, zodat hij op elke ondergrond hetzelfde doet. */
  .hv-float > :global(*) { box-shadow: -18px 26px 48px -20px rgb(0 0 0 / .75); }
  .is-flip .hv-float > :global(*) { box-shadow: 18px 26px 48px -20px rgb(0 0 0 / .75); }

  /* Onder de 980px stapelt de rij en gaat de kanteling eraf: een scherm van
     driehonderd pixels breed dat ook nog wegdraait, is een scherm dat je niet
     meer kunt lezen. Zelfde grens als waar de rij zijn tweede kolom verliest. */
  @media (max-width: 980px) {
    .hv-dash-row.is-showcase { grid-template-columns: 1fr; align-items: start; }
    /* Gestapeld staat de tekst boven het scherm, ook in de omgekeerde rij. */
    .hv-dash-row.is-showcase.is-flip { grid-template-columns: 1fr; }
    .hv-dash-row.is-showcase > .hv-dash-copy,
    .hv-dash-row.is-showcase.is-flip > .hv-dash-copy { grid-column: 1; grid-row: 1; }
    .hv-dash-row.is-showcase > .hv-stage,
    .hv-dash-row.is-showcase.is-flip > .hv-stage { grid-column: 1; grid-row: 2; }
    .hv-stage { perspective: none; }
    /* Gestapeld: geen schaal, geen kanteling, gewoon de figuur op zijn eigen
       breedte — dan mag hij zijn zijbalk stapelen, want daar is hij dan ook echt
       smal genoeg voor. */
    .hv-float, .is-flip .hv-float {
      --k: 1; width: 100%; transform: none; animation: none; will-change: auto;
    }
    .hv-float > :global(*), .is-flip .hv-float > :global(*) {
      box-shadow: 0 18px 36px -22px rgb(0 0 0 / .7);
    }
  }

  /* Beweging is hier versiering, dus hij gaat er als eerste af. De KANTELING
     blijft: een statische transform is geen beweging, en het is de vorm die
     Lucas vroeg. Alleen het zweven en de overgang verdwijnen. */
  @media (prefers-reduced-motion: reduce) {
    .hv-float, .is-flip .hv-float { animation: none; transition: none; --lift: 0px; }
  }
  .hv-dash-copy h3 { margin: 0 0 .7rem; font-size: var(--t-h3); font-weight: 700; color: var(--ink); }
  .hv-dash-copy p { margin: 0 0 1.3rem; font-size: .95rem; line-height: 1.6; color: var(--ink-2); max-width: 46ch; }
  /* De voetnoot verving het derde paneel (.hv-dash-log) en zijn derde knop.
     Zelfde grond, zelfde binnenmaat — alleen één alinea in plaats van een kop,
     een alinea en een knop. */
  /* `max-width: none` stond hier om een geërfde cap af te zetten. Sinds de schil
     meegroeit met het scherm (zie --container in global.css) betekent "none" op
     1920px een regel van 212 tekens — de langste van de hele site. De cap komt
     terug, nu als bewuste maat: 72ch op .95rem is optisch dezelfde regellengte
     als 68ch op de kleinere noten. */
  /* ── HET GRIJZE VLAK — 20 augustus 2026 ──────────────────────────────────
     Lucas: *"bij What happens after you order ziet het grijze vlak er niet
     mooi uit."*

     Het was geen vlak maar een GAT. `.hv-dash` is een raster met `gap: 1px` en
     `background: var(--line)` — de haarlijnen tussen de panelen zijn die
     achtergrond die er doorheen schijnt. Elk paneel dekt hem af met een eigen
     vulling. Deze voetnoot deed dat ook, maar hij had `max-width: 72ch` en dus
     was zijn VULLING ook maar 72ch breed: gemeten 627 pixels in een raster van
     1566. De overige 939 pixels waren geen grijs vlak maar de lijnkleur van het
     raster, over de volle hoogte van de alinea.

     De oplossing is niet meer tekst maar de goede laag: het paneel dekt de hele
     rij af, en de LEESBREEDTE zit op de tekst erbinnen. Zo blijft het gat weg,
     hoe lang of kort de zin ook wordt. Meer tekst schrijven om een gat te
     vullen zou het gat alleen verplaatsen naar het moment dat iemand de zin
     inkort. */
  /* Zelfde lichtlijn en val als de dienstenkaarten hierboven, zodat het paneel
     onder het overzicht als ÉÉN voorwerp leest en niet als een gat in het raster
     — dat was precies de klacht ("het grijze vlak ziet er niet mooi uit"). */
  .hv-dash-foot { background: var(--bg); margin: 0; padding: clamp(1.5rem, 3vw, 2.6rem); font-size: .95rem; line-height: 1.65; color: var(--ink-2); box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.06), 0 18px 34px -26px rgb(0 0 0 / 0.5); }
  .hv-dash-foot > span { display: block; max-width: 78ch; }
  .hv-dash-foot a { color: var(--ink); text-decoration: underline; text-underline-offset: .18em; }
  .hv-dash-foot a:hover, .hv-dash-foot a:focus-visible { color: var(--accent); }
  @media (max-width: 820px) {
    .hv-dash-row { grid-template-columns: 1fr; }
  }

  /* The .hv-stat* rules went with the "What the numbers actually are" band —
     see the note where that band used to be, above section 8b. */

  /* ── the promise ───────────────────────────────────────────────────────── */
  .hv-promise-h span, .hv-promise-h em { display: block; }

  /* WAT ER GEZEGD WORDT LINKS, WIE HET ZEGT RECHTS. Het portret was een vakje
     van 13rem binnen de citaatkaart en is nu een eigen kolom van 7 tegen 5 —
     groot genoeg om een portret te zijn in plaats van een pasfoto.

     In de BRON staat het portret als laatste; `order` zet het op breed rechts en
     laat het op smal onder het citaat vallen. Zo hoort een schermlezer eerst de
     belofte, en staat er op een telefoon geen foto tussen de kop en wat er
     beloofd wordt. */
  .hv-promise { display: grid; gap: clamp(1.6rem, 3.5vw, 2.6rem); align-items: start; margin-top: clamp(2.2rem, 4.5vw, 3.4rem); }
  .hv-promise-said { display: flex; flex-direction: column; gap: clamp(1.4rem, 2.6vw, 2rem); }
  @media (min-width: 62rem) {
    .hv-promise { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); align-items: stretch; }
    /* HET PORTRET IS ZO HOOG ALS WAT ERNAAST STAAT. Op de vaste verhouding 4/5
       werd het in een kolom van 530 breed 662 hoog, naast een citaat plus twee
       vinkjes van samen 300 — en dan is de helft van de sectie een leeg vlak
       onder de tekst. Nu rekt het vlak mee met de rij en bepaalt de tekst de
       hoogte, wat de juiste volgorde is: het portret staat erbij, het draagt de
       sectie niet.

       `:global()` is nodig en geen luiheid: .ph-box zit IN Placeholder.astro en
       draagt diens scope-attribuut, niet dat van dit bestand. Een gewone regel
       hier zou nooit matchen — dezelfde val als .sp-human-shot en .hv-stock-shot,
       nu met de sanctie-uitweg in plaats van een omhullende div, omdat het hier
       juist om het binnenwerk gaat. */
    .hv-promise-face,
    .hv-promise-face :global(.ph) { height: 100%; }
    .hv-promise-face :global(.ph-box) { height: 100%; aspect-ratio: auto; min-height: 26rem; }
  }


  /* HET CITAAT IS EEN TEGEL, en dat is precies wat de huisregel voorschrijft
     voor een stuk dat eruit moet springen: een paneel, geen tweede ondergrond.
     Een groene streep links en de rand van .hv-ob-item eromheen — dezelfde
     twee middelen die de rest van de pagina ook gebruikt. */
  .hv-quotecard {
    margin: 0; padding: clamp(1.3rem, 2.4vw, 1.9rem);
    background: var(--surface); border: 1px solid var(--line);
    border-left: 3px solid var(--accent);
    /* Dezelfde lichtlijn en val als de dienstenkaarten: één stelsel voor alles
       wat op deze pagina als blok op de grond ligt. */
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.06), 0 18px 34px -26px rgb(0 0 0 / 0.5);
  }
  .hv-quotecard blockquote {
    margin: 0; font-family: var(--font-editorial); font-style: italic; font-weight: 500;
    font-size: clamp(1.05rem, 1.5vw, 1.25rem); line-height: 1.5; color: var(--ink);
  }
  .hv-quotecard figcaption { margin-top: 1rem; font-size: .85rem; color: var(--ink-3); }
  .hv-quotecard figcaption strong { color: var(--ink-2); }
  .hv-checks { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.1rem; }
  .hv-checks li { display: grid; grid-template-columns: 20px 1fr; gap: .75rem; font-size: .9rem; line-height: 1.55; color: var(--ink-3); }
  .hv-checks strong { color: var(--ink); }
  .hv-checks svg { width: 18px; height: 18px; margin-top: .18rem; fill: none; stroke: var(--ink-2); stroke-width: 2; }
  .hv-trust { list-style: none; display: flex; flex-wrap: wrap; gap: .5rem 1.8rem; margin: auto 0 0; padding: clamp(1.2rem, 2.2vw, 1.7rem) 0 0; box-shadow: inset 0 1px 0 var(--line); font-size: .82rem; color: var(--ink-3); }


  /* ── before / after ────────────────────────────────────────────────────── */
  .hv-ba-head { max-width: none; }   /* zie de noot bij .hv-pipe-head */
  /* 4fr/6fr sinds het beeld op 30rem is afgetopt: met 5fr bleef er 345 pixels
     lege kolom naast het beeld staan, en die ruimte kan de tekst beter gebruiken. */
  .hv-ba { margin-top: clamp(2.2rem, 4.5vw, 3.4rem); display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 6fr); gap: clamp(1.6rem, 4vw, 3.4rem); align-items: center; }
  /* Een bovengrens op de breedte, zodat het vlak op een breed scherm niet door
     blijft groeien met de kolom mee. Zonder deze regel is 3/4 op 1920 nog
     altijd ruim 900 pixels hoog.

     `width` + `justify-self` en NIET `max-width` + `margin-inline: auto`. Dat
     laatste stond er eerst en het klapte de vergelijker dicht tot 2 bij 3
     pixels: automatische zijmarges op een RASTERITEM zetten het item van
     `stretch` naar `fit-content`, en `.cmp` heeft geen intrinsieke breedte —
     zijn twee foto’s staan absoluut gepositioneerd, dus de inhoud meet nul. Op
     een gewoon blok was dezelfde regel onschuldig geweest; in een raster is het
     een andere regel dan hij lijkt.

     Gemeten op 390, 768 en 1440: overal 2×3 pixels, en op de pagina alleen een
     gat waar het beeld hoort.

     30rem en niet 40: met 40rem bleef het vlak 640 bij 853 en was er in hoogte
     niets gewonnen — de verhouding alleen aanpassen loste de klacht dus niet
     op, want een smaller kader dat even hoog blijft is even groot. Op 30rem is
     het 480 bij 640, naast een tekstkolom van 693 breed. */
  /* `start` en niet `center`: gecentreerd in een kolom van 825 begon het beeld
     op x=280 terwijl de kop erboven op x=176 begint. Twee linkerranden op één
     scherm is precies het soort scheefheid dat je niet aanwijst maar wel ziet. */
  .hv-ba-media { width: min(100%, 30rem); justify-self: start; }
  /* :global because .cmp is rendered inside Compare.astro and carries that
     component's scope attribute, not this one's. */
  .hv-ba-media :global(.cmp) { border-radius: var(--r-lg); }
  .hv-ba-points { list-style: none; margin: 0; padding: 0; }
  .hv-ba-points li { padding: clamp(1rem, 2vw, 1.4rem) 0; }
  .hv-ba-points li:first-child { padding-top: 0; }
  .hv-ba-points li + li { box-shadow: inset 0 1px 0 var(--line); }
  .hv-ba-points h3 { margin: 0 0 .4rem; font-size: 1.02rem; font-weight: 700; color: var(--ink); }
  .hv-ba-points p { margin: 0; font-size: .9rem; line-height: 1.6; color: var(--ink-3); }
  .hv-ba-note { margin: clamp(1.2rem, 2.4vw, 1.8rem) 0 0; padding-top: clamp(1.1rem, 2vw, 1.5rem); box-shadow: inset 0 1px 0 var(--line); font-size: .85rem; line-height: 1.6; color: var(--ink-3); }
  .hv-ba-note a { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 3px; text-decoration-color: var(--line-strong); white-space: nowrap; }
  .hv-ba-note a:hover { text-decoration-color: var(--accent); }
  @media (max-width: 900px) { .hv-ba { grid-template-columns: 1fr; } }

  /* ── the dream ─────────────────────────────────────────────────────────── */
  /* The page's second full-bleed photograph, and the only band with nothing to
     count. The scrim is horizontal rather than the hero's vertical one so the
     photograph stays open on the right where there is no copy over it — the
     picture is the argument, the text just names it. */
  /* Geen `background: var(--ink-900)` meer, en geen `.ground-blend`: de foto
     dooft aan zijn eigen boven- en onderrand uit en de paginagrond loopt
     eronder gewoon door. Zie `.rand-los` in global.css. */
  .hv-dream { position: relative; isolation: isolate; overflow: hidden; display: grid; align-items: center; min-height: min(84svh, 44rem); padding-block: clamp(4.5rem, 10vw, 8rem); }
  .hv-dream-bg { position: absolute; inset: 0; z-index: -2; width: 100%; height: 100%; object-fit: cover; object-position: center 28%; --los: clamp(4rem, 9vw, 9rem); }
  .hv-dream-scrim { --los: clamp(1.4rem, 3vw, 2.6rem); }
  .hv-dream-scrim { position: absolute; inset: 0; z-index: -1; background:
    linear-gradient(90deg, rgb(var(--scrim) / 0.94) 0%, rgb(var(--scrim) / 0.78) 44%, rgb(var(--scrim) / 0.24) 100%); }
  .hv-kicker { margin: 0; font-size: .72rem; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--fill-blue); }
  /* --t-statement en niet --t-hero: op 96px stond deze kop even groot als de
     <h1> van de hero, en twee grootste dingen zijn geen grootste ding. Zie de
     noot bij --t-statement in global.css. */
  .hv-dream-h { margin: .9rem 0 0; max-width: 15ch; font-size: var(--t-statement); line-height: .98; letter-spacing: -0.04em; color: var(--paper-on-dark); text-wrap: balance; }
  .hv-dream-lede { margin: clamp(1.2rem, 2.4vw, 1.8rem) 0 0; max-width: 50ch; font-size: var(--t-lg); line-height: 1.6; color: var(--paper-soft-on-dark); }
  .hv-dream .btn { margin-top: clamp(1.6rem, 3vw, 2.2rem); }
  @media (max-width: 700px) {
    .hv-dream-scrim { background: linear-gradient(180deg, rgb(var(--scrim) / 0.60) 0%, rgb(var(--scrim) / 0.92) 55%); }
  }

  /* ── the week you get back ─────────────────────────────────────────────── */
  /* ── minmax(min(16rem, 100%), 1fr) EN NIET minmax(16rem, 1fr) ────────────
     Een ondergrens in `rem` groeit mee met de tekstinstelling van de bezoeker.
     Bij 150 % is 16rem 384 px, en dat is breder dan de 332 px die deze lijst op
     een telefoon van 390 px krijgt: de baan werd 384 px, de lijst liep buiten
     beeld en er was niets om naartoe te scrollen, dus de rechterkant van elke
     regel viel gewoon weg. `min(…, 100%)` zegt: deze ondergrens, tenzij de
     container smaller is. Bij normale tekst verandert er niets. Deze correctie
     staat op alle 23 rasters van dit type op de site. */
  .hv-week { list-style: none; margin: clamp(2.4rem, 5vw, 3.5rem) 0 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(16rem, 100%), 1fr)); gap: 1px; background: var(--line); }
  .hv-week > li { background: var(--bg); padding: clamp(1.3rem, 2.4vw, 2rem); }
  .hv-week-d { display: block; font-family: var(--font-display); font-weight: 900; font-size: clamp(1.5rem, 2.4vw, 1.9rem); line-height: 1; letter-spacing: -0.03em; color: var(--accent-bright); }
  .hv-week p { margin: .9rem 0 0; font-size: .9rem; line-height: 1.6; color: var(--ink-3); }
  .hv-back { margin-top: clamp(2rem, 4vw, 3rem); padding-top: clamp(1.4rem, 2.5vw, 2rem); box-shadow: inset 0 1px 0 var(--line); }
  .hv-back-h { margin: 0 0 clamp(1.2rem, 2.4vw, 1.8rem); font-size: .72rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--ink-3); }
  /* Vier koppen zonder uitleg eronder — zie de noot bij `back` in de copy.
     Geen raster meer maar een rij: een kolomraster geeft elke kop een even
     brede baan, en op 1440 werd dat 320px per baan voor ~200px tekst. Vier
     losse eilanden dus, waar het één zin in vieren hoort te zijn. Flex laat ze
     op hun eigen breedte staan en houdt ze bij elkaar; op een telefoon vallen
     ze vanzelf om. Geen opsommingstekens: het zijn koppen, geen lijstje. */
  .hv-back-list {
    display: flex; flex-wrap: wrap;
    gap: .7rem clamp(1.5rem, 3vw, 2.75rem);
    margin: 0; padding: 0; list-style: none;
  }
  .hv-back-list li { margin: 0; font-size: .95rem; font-weight: 700; line-height: 1.35; color: var(--ink); text-wrap: balance; }
  /* The euro half of the shoot-day argument, in one line, handing off to
     /compare. Same treatment the deleted .hv-vs-note had, because it is the
     same sentence doing the same job in a quarter of the space. */
  .hv-back-note { margin: clamp(1.4rem, 2.6vw, 2rem) 0 0; font-size: .85rem; line-height: 1.6; color: var(--ink-3); max-width: 64ch; }
  .hv-back-note a { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 3px; text-decoration-color: var(--line-strong); }
  .hv-back-note a:hover { text-decoration-color: var(--accent); }

  /* ── where the visuals land ────────────────────────────────────────────── */

  /* ── the roster and your brand model ───────────────────────────────────── */
  /* ── DE BESCHRIJVING ZAT OPGEKROPT — 20 augustus 2026 ────────────────────
     Lucas: *"ook bij de modellen sectie voelt de beschrijving heel erg
     opgekropt."*

     Hier stond `.hv-bm-band .statement-left { max-width: 46rem }`. Die regel is
     specifieker dan `.statement-split { max-width: none }` in global.css en won
     dus: de kop-en-lede-verdeling van deze band moest in 736 pixels passen
     terwijl er 1566 beschikbaar waren. Gemeten: de lede was 312 pixels breed en
     liep over ZES regels, terwijl dezelfde soort lede in vijf andere banden 562
     breed is en er twee nodig heeft.

     `flex: 1 1 auto` erbij, want in `.rail-head` (een flexrij) krimpt een item
     zonder die regel alsnog naar zijn inhoud. Zie de noot bij .statement-split
     in global.css. */
  .hv-bm-band .rail-head > .statement-left,
  .hv-svc-band .rail-head > .statement-left { max-width: none; flex: 1 1 auto; }

  /* ══ DE RAND WAAR DE RIJ DOORLOOPT ═══════════════════════════════════════
     Lucas: *"bij What we make een soort schaduw fade creëren om de site wat
     meer editorial te maken en doe dit op nog meer plekken waar dat toegepast
     kan worden en subtiel blijft."*

     Dit is de plek waar het ook een FUNCTIE heeft en niet alleen een sfeer.
     De rij loopt aan de rechterkant het beeld uit; zonder iets aan die rand
     eindigt hij daar met een harde snee die eruitziet als een fout in de
     opmaak. Een verloop op de laatste kolom zegt "hier gaat het door" — het is
     dezelfde afspraak die een tijdschrift met een aflopende pagina maakt.

     `mask-image` en geen laag met een gradiënt eroverheen: een overlay met de
     paginakleur werkt alleen zolang de grond precies die kleur is, en dat is op
     deze site nadrukkelijk niet zo — de grond heeft een lamp en een vignet (zie
     ONE GROUND in global.css). Een masker snijdt de RIJ zelf weg en laat de
     grond doen wat hij doet, wat hij ook is.

     Links geen verloop zolang je aan het begin staat: de eerste kaart hoort op
     de bladspiegel te beginnen, niet uit het niets te komen. De klasse
     `is-scrolled` komt van railNav() zodra er iets weggeschoven is. */
  .hv-svc-rail {
    --fade: clamp(2rem, 5vw, 5rem);
    -webkit-mask-image: linear-gradient(to right, #000 calc(100% - var(--fade)), transparent 100%);
            mask-image: linear-gradient(to right, #000 calc(100% - var(--fade)), transparent 100%);
  }
  .hv-svc-rail.is-scrolled {
    -webkit-mask-image: linear-gradient(to right, transparent 0, #000 var(--fade), #000 calc(100% - var(--fade)), transparent 100%);
            mask-image: linear-gradient(to right, transparent 0, #000 var(--fade), #000 calc(100% - var(--fade)), transparent 100%);
  }
  .hv-svc-rail.is-end {
    -webkit-mask-image: linear-gradient(to right, transparent 0, #000 var(--fade), #000 100%);
            mask-image: linear-gradient(to right, transparent 0, #000 var(--fade), #000 100%);
  }
  .hv-faces { margin-top: clamp(1.6rem, 3vw, 2.2rem); }
  /* Narrower than the output rail on purpose: a face needs less width than a
     garment, and ten of them at rail width would be a scroll with no end. */
  .hv-faces > * { flex: 0 0 clamp(8.5rem, 14vw, 11.5rem); }
  .hv-face { display: block; color: inherit; }
  .hv-face .plate { display: block; aspect-ratio: 3 / 4; }
  .hv-face .plate img { transition: transform var(--dur-3) var(--ease); }
  .hv-face:hover .plate img { transform: scale(1.03); }
  .hv-face .plate-cap span { text-transform: lowercase; }
  .hv-bm-foot { margin-top: clamp(1.8rem, 3.5vw, 2.6rem); padding-top: clamp(1.4rem, 2.5vw, 2rem); box-shadow: inset 0 1px 0 var(--line); display: flex; gap: clamp(1rem, 3vw, 2.5rem); align-items: center; justify-content: space-between; flex-wrap: wrap; }
  .hv-bm-foot p { margin: 0; max-width: 58ch; font-size: .9rem; line-height: 1.6; color: var(--ink-3); }
  @media (prefers-reduced-motion: reduce) {
    .hv-face .plate img, .hv-face:hover .plate img { transition: none; transform: none; }
  }

  /* The .hv-pr* rules went with the monthly-plan grid — see the note where
     that band used to be, above section 7c. */

  /* ── planning backwards ────────────────────────────────────────────────── */

  /* ── the objections ────────────────────────────────────────────────────── */
  .hv-ob { margin-top: clamp(2.4rem, 5vw, 4rem); display: grid; grid-template-columns: repeat(auto-fit, minmax(min(18rem, 100%), 1fr)); gap: 1px; background: var(--line); }
  .hv-ob-item { background: var(--surface); padding: clamp(1.4rem, 2.6vw, 2.1rem); display: flex; flex-direction: column; }
  /* De <summary> is de vraag. Het driehoekje moet op DRIE manieren weg, want de
     engines zijn het oneens — zie dezelfde drie regels bij .hv-q hierboven. */
  .hv-ob-item > summary {
    list-style: none; cursor: pointer;
    display: flex; align-items: start; justify-content: space-between; gap: 1rem;
    font-size: 1.08rem; font-weight: 700; color: var(--ink); line-height: 1.3;
  }
  .hv-ob-item > summary::marker { content: ''; }
  .hv-ob-item > summary::-webkit-details-marker { display: none; }
  .hv-ob-item > summary:focus-visible { outline: 2px solid var(--focus-ring); outline-offset: 4px; border-radius: var(--r-sm); }
  /* Een plus die een min wordt: één teken, twee toestanden, geen tweede icoon
     in de html dat je moet verbergen. Met randen getekend zodat er niets te
     laden valt. */
  .hv-ob-plus { position: relative; flex: none; width: 14px; height: 14px; margin-top: .35rem; }
  .hv-ob-plus::before, .hv-ob-plus::after {
    content: ''; position: absolute; inset: 0; margin: auto;
    background: var(--ink-3); transition: transform var(--dur-1) var(--ease), opacity var(--dur-1) var(--ease);
  }
  .hv-ob-plus::before { width: 14px; height: 2px; }
  .hv-ob-plus::after  { width: 2px; height: 14px; }
  .hv-ob-item[open] .hv-ob-plus::after { transform: scaleY(0); opacity: 0; }
  .hv-ob-item[open] > summary { color: var(--accent-bright); }
  .hv-ob-item[open] .hv-ob-plus::before { background: var(--accent-bright); }
  @media (prefers-reduced-motion: reduce) {
    .hv-ob-plus::before, .hv-ob-plus::after { transition: none; }
  }
  .hv-ob-item p { margin: .9rem 0 0; font-size: .9rem; line-height: 1.6; color: var(--ink-3); }
  .hv-ob-foot { margin-top: clamp(1.8rem, 3.5vw, 2.6rem); padding-top: clamp(1.4rem, 2.5vw, 2rem); box-shadow: inset 0 1px 0 var(--line); display: flex; gap: clamp(1rem, 3vw, 2.5rem); align-items: center; justify-content: space-between; flex-wrap: wrap; }
  .hv-ob-foot p { margin: 0; max-width: 60ch; font-size: .85rem; line-height: 1.6; color: var(--ink-3); }
  .hv-ob-link { margin-top: auto; padding-top: 1.2rem; font-size: .85rem; font-weight: 700; color: var(--accent); }
  .hv-ob-link:hover { color: var(--accent-dim); }


  /* ── the test sample ───────────────────────────────────────────────────── */
  .hv-ts { display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); gap: clamp(1.8rem, 4vw, 3.6rem); align-items: center; }
  .hv-ts-h { margin: .9rem 0 0; font-size: var(--t-h2); line-height: 1.04; letter-spacing: -0.035em; color: var(--ink); text-wrap: balance; }
  .hv-ts-copy .lede { margin-top: clamp(1rem, 2vw, 1.5rem); max-width: 52ch; }
  .hv-ts-cta { margin-top: clamp(1.4rem, 2.6vw, 2rem); }
  .hv-ts-points { margin: 0; display: grid; gap: 0; background: var(--line); border-radius: var(--r-md); overflow: hidden; }
  .hv-ts-points > div { background: var(--surface); padding: clamp(1rem, 2vw, 1.4rem); }
  .hv-ts-points dt { margin: 0; font-size: .95rem; font-weight: 700; color: var(--ink); }
  .hv-ts-points dd { margin: .35rem 0 0; font-size: .85rem; line-height: 1.55; color: var(--ink-3); }
  @media (max-width: 900px) { .hv-ts { grid-template-columns: 1fr; } }

  /* ── afsluiting ─────────────────────────────────────────────────────────
     Wat hier stond ging over een plaat met een eigen gradiënt, een eigen
     hoogte en een kop op heroformaat. Die plaat is er niet meer (zie de noot
     bij sectie 19): het is nu een gewone band met een statement erin, en een
     statement heeft al een maat, een breedte en een uitlijning. Wat overblijft
     is één regel lucht boven de knoppen. */
  .hv-close .actions { margin-top: clamp(1.4rem, 2.6vw, 2rem); display: flex; gap: .7rem; flex-wrap: wrap; justify-content: center; }
  /* ── DE LICHTPLAS ONDER DE AFSLUITING ────────────────────────────────────
     Zie de noot bij de markup. Drie lagen die elk één ding doen:

       de foto      ligt op z-index -2, schermvullend, en is met `object-fit`
                    bijgesneden zodat hij bij elke bandhoogte klopt;
       de sluier    op -1 haalt hem terug tot sfeer en trekt de boven- en
                    onderrand naar de paginagrond, zodat er geen naad ontstaat
                    met de banden ernaast;
       de inhoud    staat er op z-index 1 gewoon bovenop.

     `.hv-close-lit` en niet `.hv-close`: die tweede klasse draagt al de
     opmaak van de band zelf en wordt elders gelezen. Een aparte klasse voor de
     verlichting maakt het weghalen ervan één regel werk. */
  .hv-close-lit { position: relative; isolation: isolate; overflow: clip; }
  .hv-close-lit > .container { position: relative; z-index: 1; }
  .hv-close-bg {
    position: absolute; inset: 0; z-index: -2;
    width: 100%; height: 100%; object-fit: cover; object-position: center 62%;
    opacity: .55;
    pointer-events: none;
  }
  /* DE BOVEN- EN ONDERSTOP GINGEN NAAR DEKKEND --bg-0, en dat was een naad in
     vermomming: een rij dekkend #08090B (9) op een pagina die daar 15 tot 20
     staat. De sluier trekt zijn randen nu naar TRANSPARANT en de foto eronder
     dooft mee uit — dan is de rand van deze band de paginagrond zelf en niet
     een kleur die erop lijkt. */
  .hv-close-scrim {
    position: absolute; inset: 0; z-index: -1;
    pointer-events: none;
    --los: clamp(1.4rem, 3vw, 2.6rem);
    background:
      linear-gradient(to bottom, rgb(8 9 11 / 0.72) 0%, rgb(8 9 11 / 0.45) 26%, rgb(8 9 11 / 0.45) 74%, rgb(8 9 11 / 0.72) 100%),
      radial-gradient(72% 62% at 50% 52%, rgb(8 9 11 / 0.62), rgb(8 9 11 / 0.30) 70%, transparent 100%);
  }
  .hv-close-bg { --los: clamp(4rem, 9vw, 9rem); }
  /* ── DE ZACHTE KLEUR ONDER DE DASHBOARDBAND ──────────────────────────────
     Zie de noot bij de markup. Drie lagen, dezelfde volgorde als bij de andere
     fotobanden: beeld op -2, sluier op -1, korrel er als laatste overheen. De
     inhoud staat in de normale stroom en komt daar vanzelf bovenop, want de
     band isoleert. */
  .hv-dash-band { position: relative; isolation: isolate; overflow: hidden; }
  /* De uitdoving is hier korter dan bij een schermbrede band: dit blok is
     ongeveer 500px hoog en 9rem uitdoving zou er bijna het hele blok van maken. */
  .hv-dash-band .rand-los { --los: clamp(2rem, 4vw, 3.5rem); }
  .hv-dash-bg {
    position: absolute; inset: 0; z-index: -2;
    width: 100%; height: 100%;
    object-fit: cover;
    /* De bundel komt laag links binnen en eindigt rechts, onder het scherm. */
    object-position: 58% 64%;
    opacity: .28;
    pointer-events: none;
  }
  .hv-dash-scrim {
    position: absolute; inset: 0; z-index: -1;
    pointer-events: none;
    /* Strijklicht van links: donker waar de kop en de alinea staan, open waar
       het scherm staat. Dezelfde vorm als de sluier op de hero. */
    background:
      linear-gradient(96deg, rgb(var(--scrim) / 0.88) 0%, rgb(var(--scrim) / 0.66) 30%, rgb(var(--scrim) / 0.34) 58%, rgb(var(--scrim) / 0.16) 100%),
      linear-gradient(180deg, rgb(var(--scrim) / 0.30) 0%, transparent 34%, transparent 66%, rgb(var(--scrim) / 0.30) 100%);
  }
  /* Op een telefoon staat de tekst over de volle breedte en is een strijklicht
     van links niet genoeg: daar gaat de sluier over de hele band. */
  @media (max-width: 900px) {
    .hv-dash-scrim { background: linear-gradient(180deg, rgb(var(--scrim) / 0.72) 0%, rgb(var(--scrim) / 0.58) 52%, rgb(var(--scrim) / 0.72) 100%); }
    .hv-dash-bg { opacity: .22; }
  }

  /* ── het abonnement ──────────────────────────────────────────────────────
     Tekst links, het bedrag op een plaat rechts. Dat is dezelfde tweedeling
     als de proefvisualband eronder gebruikt, met opzet: de twee banden vragen
     allebei één beslissing en horen er hetzelfde uit te zien. */
  .hv-sub { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: clamp(1.6rem, 3.2vw, 3rem); align-items: start; }
  .hv-sub-right { display: grid; gap: clamp(1.2rem, 2.2vw, 1.8rem); align-content: start; }
  /* De beeldbank onder de plaat en niet ernaast: het bedrag en de beelden zijn
     twee argumenten, geen twee kolommen van één argument. Een haarlijn ertussen
     zegt dat, en verder niets. */
  .hv-stock {
    margin-top: clamp(1.6rem, 3vw, 2.4rem);
    padding-top: clamp(1.4rem, 2.6vw, 2rem);
    box-shadow: inset 0 1px 0 var(--line);
    display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(1.6rem, 3.5vw, 3rem); align-items: center;
  }
  /* Afgetopt zodat het vlak niet met de kolom mee blijft groeien: op 1920 was
     het 633 bij 474 naast een tekstkolom van 289 hoog, en dan is het beeld het
     onderwerp geworden in plaats van het bewijs. */
  .hv-stock-shot { width: min(100%, 23rem); }
  /* ── HET SFEERRASTER ─────────────────────────────────────────────────────
     Vier beelden in een vierkant raster, met de verhouding van de doos vast op
     4/3 zodat het blok geen sprong maakt terwijl de foto's laden — dezelfde
     maat als de plaatshouder die hier stond.

     `object-fit: cover` op elk beeld: de vier hebben verschillende
     verhoudingen (een liggende trui, twee vierkanten, een staand paar laarzen)
     en in een raster horen ze even groot te zijn. Bijsnijden is hier goed —
     het zijn sfeerbeelden, er is geen onderwerp dat je niet mag afsnijden.

     De hairline tussen de cellen komt uit `gap` op de paginagrond en niet uit
     een rand: vier randen naast elkaar geven een dubbele lijn in het midden. */
  .hv-mood {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: 1fr 1fr;
    gap: 2px;
    aspect-ratio: 4 / 3;
    border-radius: var(--r-md);
    overflow: hidden;
    background: var(--bg-0);
  }
  .hv-mood img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .hv-mood-cap { margin: .6rem 0 0; font-size: .78rem; line-height: 1.5; color: var(--ink-3); }
  .hv-stock-h { margin: 0 0 clamp(.8rem, 1.6vw, 1.1rem); font-size: var(--t-h3); font-weight: 700; color: var(--ink); }
  .hv-stock-item + .hv-stock-item { margin-top: clamp(.8rem, 1.6vw, 1.1rem); padding-top: clamp(.8rem, 1.6vw, 1.1rem); box-shadow: inset 0 1px 0 var(--line); }
  .hv-stock-n { margin: 0; font-size: 1.02rem; font-weight: 700; color: var(--ink); display: flex; align-items: center; gap: .6rem; flex-wrap: wrap; }
  .hv-stock-b { margin: .4rem 0 0; font-size: .9rem; line-height: 1.6; color: var(--ink-3); max-width: 58ch; }
  /* Wat er nog niet is, staat een stap zachter — dezelfde afspraak als bij de
     twee kaarten in de dienstenrij. */
  .hv-stock-item.is-soon .hv-stock-n { color: var(--ink-2); }
  @media (max-width: 820px) { .hv-stock { grid-template-columns: 1fr; } }
  .hv-sub-copy h2 { margin: 0; }
  .hv-sub-copy .lede { margin-top: .7rem; }
  .hv-sub-facts { list-style: none; margin: clamp(1.1rem, 2.2vw, 1.6rem) 0 0; padding: 0; display: grid; gap: .6rem; }
  .hv-sub-facts li { display: grid; grid-template-columns: 20px 1fr; gap: .75rem; font-size: .9rem; line-height: 1.55; color: var(--ink-3); }
  .hv-sub-facts svg { width: 18px; height: 18px; margin-top: .18rem; fill: none; stroke: var(--accent); stroke-width: 2; }
  /* ══ HET ZWEVENDE PANEEL ═════════════════════════════════════════════════
     Zie de lange noot bij de markup. Hier stonden tot vanochtend drie lagen
     spotlight op de BAND — een lamp op accent, een tweede in wit, en een
     randlicht op de plaat. Die zijn weg: ze waren gemaakt om een donkere grond
     te laten leven, en dit is geen donkere grond meer.

     `overflow: hidden` omdat het merkteken bewust groter is dan het paneel en
     er aan twee kanten uit loopt. Dat afsnijden is wat het van een logo een
     drukwerkmerk maakt — dezelfde afspraak als bij het woordmerk in de footer.

     De schaduw is ruim en zacht (70px, 55% zwart): een blok dat op de pagina
     ligt heeft er een, en zonder schaduw is limoen op zwart een gat in plaats
     van een voorwerp. */
  /* Het paneel, de lichtlaag, de korrel en de prijsplaat staan sinds 20 augustus
     in global.css als `.lime-panel` — zie de noot daar. Ze zijn hierheen
     verhuisd omdat de abonnementenpagina hetzelfde blok gebruikt, en één blok
     dat er op twee plekken hetzelfde uitziet mag niet op twee plekken
     gedefinieerd staan. Wat hier blijft, is wat alleen deze band doet. */

  /* ── DE BOVENKOP ─────────────────────────────────────────────────────────
     Klein, gespatieerd en in de inkt van het paneel — niet in het accent, want
     het accent IS hier de grond. Zie de noot bij de markup. */
  .hv-sub-eyebrow {
    margin: 0 0 .55rem;
    font-size: .72rem; font-weight: 700;
    letter-spacing: .16em; text-transform: uppercase;
    color: var(--ink-3);
  }

  /* HET MERKTEKEN, ALS LIJN. `fill: none` op de <use> plus een streek maakt van
     de twee gevulde paden van #markglyph precies de dunne omtrek die Lucas
     stuurde. Geen tweede symbool in de sprite, geen tweede bestand.

     `vector-effect: non-scaling-stroke` houdt de lijn even dik hoe groot het
     teken ook wordt geschaald — zonder dat wordt hij op een breed scherm een
     balk en op een telefoon een haar.

     Rechtsonder en half buiten beeld: linksboven zou hij achter de kop komen te
     staan, en een merkteken achter een kop is ruis. Hier staat hij in de hoek
     die anders leeg was. */
  /* ── DE BAND WAAR HET PANEEL OP LIGT ──────────────────────────────────────
     De foto ligt over de volle breedte achter het paneel en wordt door twee
     dingen teruggebracht tot sfeer: een dekking van 55 procent en een verloop
     eroverheen dat de boven- en onderrand naar de paginagrond trekt. Zonder dat
     verloop heeft de band een zichtbare naad met de sectie erboven, en een naad
     is precies wat een tweede grond verraadt.

     `.hv-sub-band` krijgt hiervoor een stapelcontext (position + isolation), en
     de container erin staat erboven. */
  /* Ruimer dan een `band-tight` normaal is, en dat is de hele reden dat de foto
     erachter iets doet: met de standaardmarges bedekte het paneel bijna de hele
     band en zag je van het beeld alleen een randje. Nu ligt er licht omheen. */
  .hv-sub-band { position: relative; isolation: isolate; overflow: hidden; padding-block: clamp(3.5rem, 8vw, 7rem); }
  .hv-sub-band > .container { position: relative; z-index: 1; }
  /* .hv-sub-bg, .hv-sub-bg img en .hv-sub-bg::after stonden hier en zijn weg —
     de foto zit sinds 20 augustus in het paneel zelf. Zie de noot bij de markup
     hierboven en bij .lime-panel in global.css. */

  .hv-sub-from { margin: 0; font-size: .72rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--ink-3); }
  .hv-sub-fig { margin: .3rem 0 0; font-family: var(--font-display); font-weight: 900; font-size: clamp(2.6rem, 6vw, 3.8rem); line-height: 1; color: var(--ink); }
  .hv-sub-unit { margin: .5rem 0 0; font-size: .9rem; color: var(--ink-2); }
  .hv-sub-vat { margin: .35rem 0 0; font-size: .78rem; color: var(--ink-3); }
  .hv-sub-cta { margin-top: clamp(1.4rem, 3vw, 2rem); display: flex; flex-wrap: wrap; gap: .7rem; }

  /* ── DE DRIE ABONNEMENTEN ────────────────────────────────────────────────
     Drie tegels op de heldere grond, in de vulling van de plaat maar lichter:
     ze horen bij het bedrag erboven en mogen er niet mee wedijveren. Vandaar
     ook geen knoppen erin — er staat er al één in de plaat, en drie kaarten met
     elk een eigen knop maakt van dit blok een prijspagina. */
  .hv-plans {
    list-style: none;
    margin: clamp(1.3rem, 2.4vw, 1.9rem) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(13rem, 100%), 1fr));
    gap: clamp(.7rem, 1.4vw, 1rem);
  }
  .hv-plan {
    padding: clamp(.85rem, 1.6vw, 1.15rem);
    border-radius: var(--r-md);
    background: rgb(8 9 11 / 0.07);
    box-shadow: inset 0 0 0 1px rgb(8 9 11 / 0.14);
  }
  .hv-plan-n { margin: 0; font-size: .72rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--ink-3); }
  .hv-plan-p { margin: .3rem 0 0; font-family: var(--font-display); font-weight: 900; font-size: clamp(1.5rem, 2.6vw, 1.95rem); line-height: 1; color: var(--ink); display: flex; align-items: baseline; gap: .4rem; flex-wrap: wrap; }
  .hv-plan-p span { font-family: var(--font-body); font-weight: 400; font-size: .8rem; color: var(--ink-3); }
  .hv-plan-b { margin: .55rem 0 0; font-size: .88rem; font-weight: 700; color: var(--ink); }
  .hv-plan-x { margin: .2rem 0 0; font-size: .84rem; line-height: 1.5; color: var(--ink-2); }

  /* ── WAT EEN CREDIT IS ───────────────────────────────────────────────────
     Onder de plaat en op zijn eigen breedte, met een lijn links. Die lijn doet
     hetzelfde werk als bij .pl-ctx in de bestelstroom: hij zegt dat dit bij het
     getal erboven hoort en er een gevolg van is, in plaats van een nieuw
