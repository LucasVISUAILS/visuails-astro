  </div>
</section>

{/* ── 6 · THE FOUR DELIVERABLES ──────────────────────────────────────────── */}
<section class="band">
  <div class="container">
    <div class="statement">
      <h2>{c.madeH}</h2>
      <p class="lede">{c.madeLede}</p>
    </div>
    <div class="tiles hv-made-tiles">
      {c.made.map(([t, b, href, price], i) => (
