  .hv-sub-cta { margin-top: clamp(1.4rem, 3vw, 2rem); display: flex; flex-wrap: wrap; gap: .7rem; }

  /* ── DE DRIE ABONNEMENTEN ────────────────────────────────────────────────
     Drie tegels op de heldere grond, in de vulling van de plaat maar lichter:
