    .hv-dream-scrim { background: linear-gradient(180deg, rgb(var(--scrim) / 0.60) 0%, rgb(var(--scrim) / 0.92) 55%); }
  }

  /* ── the week you get back ─────────────────────────────────────────────── */
  .hv-week { list-style: none; margin: clamp(2.4rem, 5vw, 3.5rem) 0 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); gap: 1px; background: var(--line); }
  .hv-week > li { background: var(--bg); padding: clamp(1.3rem, 2.4vw, 2rem); }
  .hv-week-d { display: block; font-family: var(--font-display); font-weight: 900; font-size: clamp(1.5rem, 2.4vw, 1.9rem); line-height: 1; letter-spacing: -0.03em; }
  .hv-week p { margin: .9rem 0 0; font-size: .9rem; line-height: 1.6; color: var(--ink-3); }
  .hv-back { margin-top: clamp(2rem, 4vw, 3rem); padding-top: clamp(1.4rem, 2.5vw, 2rem); box-shadow: inset 0 1px 0 var(--line); }
  .hv-back-h { margin: 0 0 clamp(1.2rem, 2.4vw, 1.8rem); font-size: .72rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--ink-3); }
  .hv-back-list { display: grid; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); gap: clamp(1.2rem, 3vw, 2.4rem); margin: 0; }
  .hv-back-list dt { margin: 0; font-size: .95rem; font-weight: 700; color: var(--ink); }
  .hv-back-list dd { margin: .45rem 0 0; font-size: .85rem; line-height: 1.55; color: var(--ink-3); }
  /* The euro half of the shoot-day argument, in one line, handing off to
     /compare. Same treatment the deleted .hv-vs-note had, because it is the
     same sentence doing the same job in a quarter of the space. */
  .hv-back-note { margin: clamp(1.4rem, 2.6vw, 2rem) 0 0; font-size: .85rem; line-height: 1.6; color: var(--ink-3); max-width: 64ch; }
  .hv-back-note a { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 3px; text-decoration-color: var(--line-strong); }
  .hv-back-note a:hover { text-decoration-color: var(--accent); }

  /* ── where the visuals land ────────────────────────────────────────────── */
  .hv-ch { list-style: none; margin: clamp(2.4rem, 5vw, 3.5rem) 0 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); gap: 1px; background: var(--line); }
  .hv-ch > li { background: var(--bg); padding: clamp(1.1rem, 2vw, 1.5rem); display: grid; gap: .35rem; align-content: start; }
  .hv-ch-t { font-size: .95rem; font-weight: 700; color: var(--ink); }
  .hv-ch-n { font-size: .84rem; line-height: 1.5; color: var(--ink-3); }
  .hv-ch-note { margin: 1.4rem 0 0; font-size: .85rem; line-height: 1.6; color: var(--ink-3); }

  /* ── the roster and your brand model ───────────────────────────────────── */
  .hv-bm-band .statement-left { max-width: 46rem; }
  .hv-faces { margin-top: clamp(1.6rem, 3vw, 2.2rem); }
  /* Narrower than the output rail on purpose: a face needs less width than a
     garment, and ten of them at rail width would be a scroll with no end. */
  .hv-faces > * { flex: 0 0 clamp(8.5rem, 14vw, 11.5rem); }
  .hv-face { display: block; color: inherit; }
  .hv-face .plate { display: block; aspect-ratio: 3 / 4; }
  .hv-face .plate img { transition: transform var(--dur-3) var(--ease); }
  .hv-face:hover .plate img { transform: scale(1.03); }
  .hv-face .plate-cap span { text-transform: lowercase; }
  .hv-bm-foot { margin-top: clamp(1.8rem, 3.5vw, 2.6rem); padding-top: clamp(1.4rem, 2.5vw, 2rem); box-shadow: inset 0 1px 0 var(--line); display: flex; gap: clamp(1rem, 3vw, 2.5rem); align-items: center; justify-content: space-between; flex-wrap: wrap; }
  .hv-bm-foot p { margin: 0; max-width: 58ch; font-size: .9rem; line-height: 1.6; color: var(--ink-3); }
  @media (prefers-reduced-motion: reduce) {
    .hv-face .plate img, .hv-face:hover .plate img { transition: none; transform: none; }
  }

  /* The .hv-pr* rules went with the monthly-plan grid — see the note where
     that band used to be, above section 7c. */

  /* ── planning backwards ────────────────────────────────────────────────── */
  .hv-pl-head { max-width: 42rem; }
  .hv-pl { list-style: none; margin: clamp(2.2rem, 4.5vw, 3.2rem) 0 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); gap: clamp(1.4rem, 3vw, 2.6rem); }
  .hv-pl > li { position: relative; padding-top: 1.6rem; box-shadow: inset 0 1px 0 var(--line); }
  /* One dot per date, sitting on the rule — the closest this system gets to a
     timeline without drawing a connector that would be wrong the moment the
     grid wraps to one column. */
  .hv-pl-dot { position: absolute; top: -4px; left: 0; width: 9px; height: 9px; background: var(--ink-1); }
  .hv-pl h3 { margin: 0 0 .45rem; font-size: 1.02rem; font-weight: 700; }
  .hv-pl p { margin: 0; font-size: .875rem; line-height: 1.6; color: var(--ink-3); }
  .hv-pl-foot { margin-top: clamp(1.8rem, 3.5vw, 2.6rem); display: flex; gap: clamp(1rem, 3vw, 2.5rem); align-items: center; justify-content: space-between; flex-wrap: wrap; }
  .hv-pl-foot p { margin: 0; max-width: 66ch; font-size: .85rem; line-height: 1.6; color: var(--ink-3); }

  /* ── the objections ────────────────────────────────────────────────────── */
  .hv-ob { margin-top: clamp(2.4rem, 5vw, 4rem); display: grid; grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr)); gap: 1px; background: var(--line); }
  .hv-ob-item { background: var(--surface); padding: clamp(1.4rem, 2.6vw, 2.1rem); display: flex; flex-direction: column; }
  .hv-ob-item h3 { margin: 0 0 .7rem; font-size: 1.08rem; font-weight: 700; color: var(--ink); }
  .hv-ob-item p { margin: 0; font-size: .9rem; line-height: 1.6; color: var(--ink-3); }
  .hv-ob-link { margin-top: auto; padding-top: 1.2rem; font-size: .85rem; font-weight: 700; color: var(--accent); }
  .hv-ob-link:hover { color: var(--accent-dim); }

  /* ── faq ───────────────────────────────────────────────────────────────── */
  .hv-faq { margin-top: clamp(2rem, 4vw, 3rem); border-top: 1px solid var(--line); }
  .hv-faq-item { border-bottom: 1px solid var(--line); }
  .hv-faq-item summary { list-style: none; cursor: pointer; display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; padding: 1.1rem 0; font-size: 1rem; font-weight: 700; color: var(--ink); }
  .hv-faq-item summary::-webkit-details-marker { display: none; }
  .hv-faq-item summary:hover { color: var(--accent); }
  .hv-faq-item summary svg { flex: 0 0 auto; width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 1.5; transition: transform var(--dur-2) var(--ease); }
  .hv-faq-item[open] summary svg { transform: rotate(45deg); }
  .hv-faq-a { padding: 0 0 1.3rem; }
  /* :global — an answer carrying {html} is injected with set:html, so its <p>
     and <a> never receive this component's scope attribute. */
  .hv-faq-a :global(p) { margin: 0; font-size: .92rem; line-height: 1.65; color: var(--ink-3); max-width: 64ch; }
  .hv-faq-a :global(a) { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }
  .hv-faq-foot { margin-top: clamp(1.6rem, 3vw, 2.2rem); }
  @media (prefers-reduced-motion: reduce) {
    .hv-faq-item summary svg { transition: none; }
  }

  /* ── the test sample ───────────────────────────────────────────────────── */
  .hv-ts { display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); gap: clamp(1.8rem, 4vw, 3.6rem); align-items: center; }
  .hv-ts-h { margin: .9rem 0 0; font-size: var(--t-h2); line-height: 1.04; letter-spacing: -0.035em; color: var(--ink); text-wrap: balance; }
  .hv-ts-copy .lede { margin-top: clamp(1rem, 2vw, 1.5rem); max-width: 52ch; }
  .hv-ts-cta { margin-top: clamp(1.4rem, 2.6vw, 2rem); }
  .hv-ts-points { margin: 0; display: grid; gap: 0; background: var(--line); border-radius: var(--r-md); overflow: hidden; }
  .hv-ts-points > div { background: var(--surface); padding: clamp(1rem, 2vw, 1.4rem); }
  .hv-ts-points dt { margin: 0; font-size: .95rem; font-weight: 700; color: var(--ink); }
  .hv-ts-points dd { margin: .35rem 0 0; font-size: .85rem; line-height: 1.55; color: var(--ink-3); }
  @media (max-width: 900px) { .hv-ts { grid-template-columns: 1fr; } }

  /* ── closing ───────────────────────────────────────────────────────────── */
  /* The closing panel — see .panel-tonal in
     global.css for what that scope restates and why it has to. The only thing
     added here is the radius: the panel is full-bleed, so it takes corners on
     its top edge alone, where it meets the dark page above it. */
  /* No top radius any more. .panel-tonal fades its own top edge back into the
     page ground now (.ground-blend in global.css), and a rounded corner under
     a 100px fade is a corner nobody can see — it only showed as two slivers of
     --bg-0 beside a plate that was already dissolving. */
  .hv-close { overflow: hidden; }
</style>

<script>
  // THE RAILS. Both horizontal scrollers on this page — the output rail and the
  // model roster — are native overflow-x with scroll-snap, so they already work
  // by drag, wheel and keyboard with no script at all. This adds the arrows.
  //
  // WHY IT EXISTS AT ALL: the output rail has shipped with a prev/next pair
  // since the page was written and nothing was ever bound to them. They were
  // two dead buttons with aria-labels, which is worse than no buttons — a
  // screen reader announces a control that does nothing. Adding a second rail
  // was the point at which that had to be fixed rather than duplicated.
  //
  // Buttons are found within the rail's own <section>, not as siblings: the
  // head and the rail sit in two different .container wrappers so that the rail
  // can bleed wider than the copy above it.
  function initRails() {
    document.querySelectorAll('[data-rail]:not([data-rail-bound])').forEach((rail) => {
      const scope = rail.closest('section');
      if (!scope) return;
      const prev = scope.querySelector('[data-rail-prev]');
      const next = scope.querySelector('[data-rail-next]');
      if (!prev && !next) return;
      rail.setAttribute('data-rail-bound', '');

      // One card plus one gap, measured rather than assumed — every rail on the
      // site sizes its items in clamp(), so there is no constant to hard-code.
      const step = () => {
        const first = rail.firstElementChild;
        if (!first) return rail.clientWidth * 0.8;
        const gap = parseFloat(getComputedStyle(rail).columnGap || '0') || 0;
        return first.getBoundingClientRect().width + gap;
      };

      // Disable at the ends rather than wrapping around: a rail that jumps back
      // to the start reads as a carousel, and this is a shelf.
      const sync = () => {
        const max = rail.scrollWidth - rail.clientWidth - 2;
        if (prev) prev.disabled = rail.scrollLeft <= 2;
        if (next) next.disabled = rail.scrollLeft >= max;
      };

      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const go = (dir) => rail.scrollBy({ left: dir * step(), behavior: reduce ? 'auto' : 'smooth' });
      if (prev) prev.addEventListener('click', () => go(-1));
      if (next) next.addEventListener('click', () => go(1));
      rail.addEventListener('scroll', sync, { passive: true });
      window.addEventListener('resize', sync);
      sync();
    });
  }

  initRails();
  // ClientRouter swaps the document without reloading, so first paint is not
  // enough — same hook every other init on this site uses.
  document.addEventListener('astro:page-load', initRails);
</script>
