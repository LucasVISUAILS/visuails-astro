     bij elke diawissel én één keer bij het opstarten. Stond hij alleen in
     toon(), dan bleef dia 1 zonder regel staan — toon(0) wordt bij het laden
     namelijk nooit aangeroepen, want de teller staat al op 0. Gemeten:
     `verborgen=true` op dia 1 en `false` op de vier andere. */
  function zetNoot(i) {
    if (!noot || !nootT || !nootA) return;
    var n = noten[i] || { t: '', a: '', h: '' };
    if (!n.t) { noot.hidden = true; return; }
    nootT.textContent = n.t;
    nootA.textContent = n.a;
    nootA.setAttribute('href', n.h);
    nootA.hidden = !n.a;
    noot.hidden = false;
  }

  /* ── DE BALK IS EEN BROER VAN DE TAB, GEEN KIND — 23 AUGUSTUS 2026 ────────
   *
   * Hier stond `t.querySelector('.hv-slide-card-bar')`, met `t` de tab. Dat gaf
   * `null`, elke keer, op elk kaartje — en daarmee is dit de reden dat er nooit
   * een voortgangsbalk te zien is geweest.
   *
   * Op 20 augustus is het kaartje gesplitst: de doos `.hv-slide-card` werd een
   * houder voor twee links, de grote (`.hv-slide-card-main`, dát is de tab) en
   * het pijltje. De balk bleef waar hij was, in de doos. Vanaf dat moment was
   * hij geen afstammeling meer van de tab maar een broer, en deze regel bleef
   * ongewijzigd staan.
   *
   * Het viel niet op omdat er niets stukging: `if (!bar) return` sloeg de hele
   * animatie stil over. Een verdwenen streepje geeft geen foutmelding.
   *
   * Vanaf de DOOS opzoeken en niet vanaf de tab, want de doos is waar de balk
   * hoort — hij gaat over het kaartje en niet over de link erin. */
  function balk(i) {
    var t = tabs[i];
    var doos = t && t.closest ? t.closest('.hv-slide-card') : null;
    return doos ? doos.querySelector('.hv-slide-card-bar') : null;
