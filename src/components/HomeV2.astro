const c = COPY[lang];

// The five questions the FAQ band shows, picked one group at a time rather
// than sliced off the front of the flattened list. Two reasons: the front of
// the list is all "getting started", which is the one thing a visitor who has
// scrolled this far no longer needs; and the "rights and usage" group is
// deliberately left out because the objection band above it already answers
// those in full — a page that asks the same question twice reads as padding.
const FAQ_GROUPS = faqPageGroups(lang);
const FAQ_PICK = [
  FAQ_GROUPS[0]?.items[0],
  FAQ_GROUPS[0]?.items[1],
  FAQ_GROUPS[1]?.items[0],
  FAQ_GROUPS[2]?.items[0],
  FAQ_GROUPS[3]?.items[0],
].filter(Boolean);
---

{/* ── 1 · HERO ───────────────────────────────────────────────────────────────
    Full-bleed, and the photograph is the only lit thing in the frame. On the
    espresso ground that is not a metaphor: everything above and below it is
    near-black, so the garment is the first colour a visitor sees. */}
<section class="hv-hero">
  <div class="hv-hero-bg">
    <img src="/img/hero-dunes.webp" alt={c.heroAlt} width="2200" height="1228" decoding="sync" fetchpriority="high" transition:name="hero-photo" />
  </div>
  <div class="hv-hero-scrim" aria-hidden="true"></div>
  <div class="container hv-hero-inner">
    <div class="hv-hero-copy">
      <h1 class="hv-h1">{c.h1.map((line, i) => (
        <span class="hv-line">{i === c.h1.length - 1 ? <em>{line}</em> : line}</span>
      ))}</h1>
      <p class="hv-lede">{c.heroLede}</p>
      <div class="hv-cta">
        <a href={lp('/start')} class="btn btn-primary btn-lg">{c.ctaStart}</a>
        <a href={lp('/test-sample')} class="btn btn-ghost btn-lg">{c.ctaSample}</a>
      </div>
    </div>
  </div>
  <div class="hv-plinth">
    <dl class="container hv-plinth-row">
      {c.facts.map(([k, v], i) => (
        <div class={`hv-fact${i === 0 ? ' is-flag' : i === 1 ? ' is-verify' : ''}`}>
          <dt>{k}</dt><dd>{v}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

{/* ── 2 · WHAT A DROP IS ─────────────────────────────────────────────────────
    A statement, then the evidence for it as three tiles of unequal weight on
    one plate. The middle tile is a photograph rather than a claim. */}
<section class="band">
  <div class="container">
    <div class="statement">
      <h2>{c.dropH[0]} <em class="hv-accent">{c.dropH[1]}</em></h2>
      <p class="lede">{c.dropLede}</p>
    </div>
    <div class="tiles hv-drop-tiles">
      <div class="tile s-4">
        <div class="tile-body">
          <p class="tile-k">{c.dropSpecK}</p>
          <p class="tile-v">{c.dropSpecP}</p>
          <p class="hv-tile-sub">{c.dropSpecV}</p>
          <p class="tile-n">{c.dropSpecN}</p>
        </div>
      </div>
      {/* Media bleeds to the tile's edge and the caption sits on it — the one
          gradient the system allows, and it is a legibility plate rather than
          decoration. */}
      <div class="tile s-4">
        <div class="tile-media tile-media-fill">
          <img src="/img/catalog-after.webp" alt={c.dropPlateAlt} width="1800" height="1800" loading="lazy" decoding="async" />
          <span class="tile-cap"><b>{c.dropPlateCap}</b><span>{c.dropPlateSub}</span></span>
        </div>
      </div>
      {/* THE one coloured tile in this grid, and it is on the deadline
          because the deadline is the thing being sold. .on-bright recomputes
          the ink ramp; .tile-c-blue only names the colour. */}
      <div class="tile s-4 on-bright tile-c-blue">
        <div class="tile-body">
          <p class="tile-k">{c.dropWinK}</p>
          <p class="tile-v">{c.dropWinV}</p>
          <p class="tile-n">{c.dropWinN}</p>
        </div>
      </div>
    </div>
  </div>
</section>

{/* ── 3 · THE OUTPUT RAIL ────────────────────────────────────────────────────
    Show the work before the claim. Six real photographs, pushed sideways,
    each one a link to the page that explains it. */}
<section class="band-tight hv-rail-band">
  <div class="container">
    <div class="rail-head">
      <div class="statement statement-left">
        <h2>{c.railH[0]} <em class="hv-accent">{c.railH[1]}</em></h2>
        <p class="lede">{c.railLede}</p>
      </div>
      <div class="rail-nav">
        <button type="button" data-rail-prev aria-label={c.railPrev}><svg viewBox="0 0 24 24"><path d="M15 5 8 12l7 7" /></svg></button>
        <button type="button" data-rail-next aria-label={c.railNext}><svg viewBox="0 0 24 24"><path d="M9 5l7 7-7 7" /></svg></button>
      </div>
    </div>
  </div>
  <div class="container">
    <div class="rail" data-rail>
      {RAIL.map((r, i) => (
        <a class="hv-rail-item" href={lp(r.href)}>
          <span class="plate"><img src={r.src} alt={`${c.railCaps[i][0]} — ${c.railCaps[i][1]}`} width={r.w} height={r.h} loading="lazy" decoding="async" /></span>
          <span class="plate-cap"><b>{c.railCaps[i][0]}</b><span>{c.railCaps[i][1]}</span></span>
        </a>
      ))}
    </div>
  </div>
</section>

{/* ── 3b · WHO IT IS FOR ─────────────────────────────────────────────────────
    Placed directly after the proof rail, which is the first point on the page
    where a visitor has seen enough to ask "but is this for me". Four
    situations rather than four personas: a persona ("ambitious founder") is a
    flattering description a reader agrees with and takes nothing from, a
    situation is something they either recognise or do not.

    The disqualification list under it is the part that does the work. It is
    standard on strong productized-service pages and it is the cheapest
    credibility a vendor with no testimonials can buy: naming who should not
    buy is a claim only someone confident of the rest can afford to make. */}
<section class="band">
  <div class="container">
    <div class="statement">
      <h2>{c.whoH}</h2>
      <p class="lede">{c.whoLede}</p>
    </div>
    <div class="tiles hv-who-tiles">
      {c.who.map(([t, b], i) => (
        <div class="tile s-3">
          <div class="tile-body">
            <span class={`hv-who-i ${['w-blue', 'w-violet', 'w-pink', 'w-coral'][i] || ''}`}>{String(i + 1).padStart(2, '0')}</span>
            <p class="tile-h">{t}</p>
            <p class="tile-n">{b}</p>
          </div>
        </div>
      ))}
    </div>
    <div class="hv-notfor">
      <p class="hv-notfor-h">{c.notForH}</p>
      <ul>{c.notFor.map((x) => (<li>{x}</li>))}</ul>
    </div>
  </div>
</section>

{/* ── 4 · THE PIPELINE ───────────────────────────────────────────────────────
    A real ordered sequence, so it is the one place on the page numbers are
    allowed — see DESIGN.md on why 01/02/03 above every section is scaffolding
    and above an actual sequence is not. */}
<section class="band well-deep">
  <div class="container">
    <div class="statement statement-left hv-pipe-head">
      <h2>{c.pipeH}</h2>
      <p class="lede">{c.pipeLede}</p>
    </div>
    <ol class="hv-pipe">
      {c.pipe.map(([t, b], i) => (
        <li>
          <span class={`hv-pipe-n ${['s-blue', 's-violet', 's-pink', 's-coral'][i] || ''}`}>{String(i + 1).padStart(2, '0')}</span>
          <h3>{t}</h3>
          <p>{b}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

{/* ── 4b · BEFORE / AFTER ────────────────────────────────────────────────────
    The single most persuasive asset the studio owns and it was sitting unused:
    catalog-before.webp is a real client phone photo, catalog-after.webp is
    what was delivered from it. Everything else on this page is output; this is
    the only place a visitor sees the INPUT, which is the thing they are
    actually being asked to believe ("a phone photo is enough").

    Deliberately placed four bands below the drop tiles that also show
    catalog-after — close enough to be the same story, far enough that the
    photograph does not read as repeated.

    Compare.astro rather than a hand-rolled slider: it is already on /catalog
    and /gallery, it drifts on its own so the comparison is legible without
    interaction, and it throws at build time on an image with no intrinsic
    size on record. */}
<section class="band well-deep">
  <div class="container">
    <div class="statement statement-left hv-ba-head">
      <h2>{c.baH[0]} <em class="hv-accent">{c.baH[1]}</em></h2>
      <p class="lede">{c.baLede}</p>
    </div>
    <div class="hv-ba">
      <div class="hv-ba-media">
        <Compare
          before="/img/catalog-before.webp"
          after="/img/catalog-after.webp"
          beforeAlt={c.baBeforeAlt}
          afterAlt={c.baAfterAlt}
          beforeLabel={c.baBefore}
          afterLabel={c.baAfter}
          ratio="4/5"
        />
      </div>
      <div class="hv-ba-copy">
        <ol class="hv-ba-points">
          {c.baPoints.map(([t, b]) => (
            <li>
              <h3>{t}</h3>
              <p>{b}</p>
            </li>
          ))}
        </ol>
        <p class="hv-ba-note">
          {c.baNote} <a href={lp('/upload-guidelines')}>{c.baNoteLink}</a>
        </p>
      </div>
    </div>
  </div>
</section>

{/* ── 4c · THE DREAM ─────────────────────────────────────────────────────────
    Lucas asked for this one by name: the page explains the mechanism well and
    never once says what the mechanism is FOR. Full-bleed photograph, one
    sentence, no tiles and no figures — the only band on the page with nothing
    to compare or count, which is what makes it read as a pause rather than
    another argument.

    The claim is deliberately about perception rather than results ("looks like
    a brand that has its act together", not "sells more"), because a conversion
    claim here would be a number this studio cannot yet evidence. */}
<section class="hv-dream">
  <img class="hv-dream-bg" src="/img/lifestyle-glow-06.webp" alt={c.dreamAlt} width="2400" height="1792" loading="lazy" decoding="async" />
  <div class="hv-dream-scrim" aria-hidden="true"></div>
  <div class="container hv-dream-inner">
    <p class="hv-kicker">{c.dreamKicker}</p>
    <h2 class="hv-dream-h">{c.dreamH}</h2>
    <p class="hv-dream-lede">{c.dreamLede}</p>
    <a class="btn btn-primary btn-lg" href={lp('/gallery')}>{c.dreamCta}</a>
  </div>
</section>

{/* ── 4d · THE WEEK YOU GET BACK ─────────────────────────────────────────────
    The second thing Lucas asked for: time, expressed as time rather than as
    money. The cost band below this one already argues the euros, and putting
    the two next to each other is intentional — a shoot costs a day AND a fee,
    and only one of those two is on the invoice.

    Three weekdays rather than a duration ("saves you 20 hours") because an
    hours-saved figure is a claim about the reader's business that this studio
    has no way to know. A named Monday is a story; a saved hour is arithmetic
    someone else did. */}
<section class="band">
  <div class="container">
    <div class="statement">
      <h2>{c.weekH}</h2>
      <p class="lede">{c.weekLede}</p>
    </div>
    <ol class="hv-week">
      {c.week.map(([d, b], i) => (
        <li>
