const PLANS = plans(lang);
// The incl.-VAT twin of a plan's price. plans() returns the net figure because
// every figure in pricing.js is net; BRIEF-14's rule is that no price is
// printed without saying which it is, so the label and the gross figure travel
// together and neither is typed.
// Net only — see the note above vatNote() in pricing.js for why the gross
// twin came off every page: VAT is not one rate, so a second figure printed
// beside the first is only true for a Dutch reader.
const netLabel = vatLabel('excl', lang);

const c = COPY[lang];

// The five questions the FAQ band shows, picked one group at a time rather
// than sliced off the front of the flattened list. Two reasons: the front of
// the list is all "getting started", which is the one thing a visitor who has
// scrolled this far no longer needs; and the "rights and usage" group is
// deliberately left out because the objection band above it already answers
// those in full — a page that asks the same question twice reads as padding.
const FAQ_GROUPS = faqPageGroups(lang);
const FAQ_PICK = [
  FAQ_GROUPS[0]?.items[0],
  FAQ_GROUPS[0]?.items[1],
  FAQ_GROUPS[1]?.items[0],
  FAQ_GROUPS[2]?.items[0],
  FAQ_GROUPS[3]?.items[0],
].filter(Boolean);
---

{/* ── 1 · HERO ───────────────────────────────────────────────────────────────
    Full-bleed, and the photograph is the only lit thing in the frame. On the
    espresso ground that is not a metaphor: everything above and below it is
    near-black, so the garment is the first colour a visitor sees. */}
<section class="hv-hero">
  <div class="hv-hero-bg">
    <img src="/img/hero-dunes.webp" alt={c.heroAlt} width="2200" height="1228" decoding="sync" fetchpriority="high" transition:name="hero-photo" />
  </div>
  <div class="hv-hero-scrim" aria-hidden="true"></div>
  <div class="container hv-hero-inner">
    <div class="hv-hero-copy">
      <h1 class="hv-h1">{c.h1.map((line, i) => (
        <span class="hv-line">{i === c.h1.length - 1 ? <em>{line}</em> : line}</span>
      ))}</h1>
      <p class="hv-lede">{c.heroLede}</p>
      <div class="hv-cta">
        <a href={lp('/start')} class="btn btn-primary btn-lg">{c.ctaStart}</a>
        <a href={lp('/test-sample')} class="btn btn-ghost btn-lg">{c.ctaSample}</a>
      </div>
    </div>
  </div>
  <div class="hv-plinth">
    <dl class="container hv-plinth-row">
      {c.facts.map(([k, v], i) => (
        <div class={`hv-fact${i === 0 ? ' is-flag' : i === 1 ? ' is-verify' : ''}`}>
          <dt>{k}</dt><dd>{v}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

{/* ── 2 · WHAT A DROP IS ─────────────────────────────────────────────────────
    A statement, then the evidence for it as three tiles of unequal weight on
    one plate. The middle tile is a photograph rather than a claim. */}
<section class="band">
  <div class="container">
    <div class="statement">
      <h2>{c.dropH[0]} <em class="hv-accent">{c.dropH[1]}</em></h2>
      <p class="lede">{c.dropLede}</p>
    </div>
    <div class="tiles hv-drop-tiles">
      <div class="tile s-4">
        <div class="tile-body">
          <p class="tile-k">{c.dropSpecK}</p>
          <p class="tile-v">{c.dropSpecP}</p>
          <p class="hv-tile-sub">{c.dropSpecV}</p>
          <p class="tile-n">{c.dropSpecN}</p>
        </div>
      </div>
      {/* Media bleeds to the tile's edge and the caption sits on it — the one
          gradient the system allows, and it is a legibility plate rather than
          decoration. */}
      <div class="tile s-4">
        <div class="tile-media tile-media-fill">
          <img src="/img/catalog-after.webp" alt={c.dropPlateAlt} width="1800" height="1800" loading="lazy" decoding="async" />
          <span class="tile-cap"><b>{c.dropPlateCap}</b><span>{c.dropPlateSub}</span></span>
        </div>
      </div>
      {/* THE one coloured tile in this grid, and it is on the deadline
          because the deadline is the thing being sold. .on-bright recomputes
          the ink ramp; .tile-c-blue only names the colour. */}
      <div class="tile s-4 on-bright tile-c-blue">
        <div class="tile-body">
          <p class="tile-k">{c.dropWinK}</p>
          <p class="tile-v">{c.dropWinV}</p>
          <p class="tile-n">{c.dropWinN}</p>
        </div>
      </div>
    </div>
  </div>
</section>

{/* ── 3 · THE SERVICES ───────────────────────────────────────────────────────
    WHAT WAS HERE AND WHY IT WENT. A horizontal rail of six photographs headed
    "Real output. Zero photoshoots." It showed the work, which is this brand's
    first principle, but it was the third band on a page whose next four bands
    are also photographs — so it was proof stacked on proof, and the one thing
    a visitor could not find anywhere above the fold was the actual offer. That
    had to be inferred from four tiles eleven bands down.

    THIS BAND REPLACES BOTH. It is the whole offer in one place: what each
    service is, what you receive, what it costs, and a photograph of it. The
    "four deliverables" band that used to sit at section 6 IS DELETED rather
    than reduced — it named the same four services, linked to the same four
    pages and carried the same four prices, and two bands saying that on one
    page leaves a reader deciding which is the real price list. What it had
    that this does not is the "look bigger than you are" framing, and that
    argument is already made in full by the Dream band at 4c.

    FIVE TILES, TWO WEIGHTS. Catalog and lifestyle take half the row each
    because they are what a product actually gets; the other three are
    additions to that, and a grid of five equal tiles would say they are five
    equal choices. The plans tile is a pointer, not a plan grid — the pricing
    band at 7b renders plans() in full and this one only says they exist. */}
<section class="band hv-svc-band">
  <div class="container">
    <div class="statement">
      <h2>{c.svcH[0]} <em class="hv-accent">{c.svcH[1]}</em></h2>
      <p class="lede">{c.svcLede}</p>
    </div>
    <div class="tiles hv-svc-tiles">
      {c.svc.map(([name, line, get, price, terms, href], i) => (
        <a class={`tile ${i < 2 ? 's-6' : 's-4'} hv-svc-tile`} href={lp(href)}>
          <span class={`tile-media hv-svc-media${i < 2 ? ' is-wide' : ''}`}>
            <img src={SERVICE_IMG[i].src} alt={`${name} — ${line}`} width={SERVICE_IMG[i].w} height={SERVICE_IMG[i].h} loading="lazy" decoding="async" />
