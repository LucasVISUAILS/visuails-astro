  /* Verder waar hij gebleven was. Alleen de resterende tijd, en de balk pakt de
     draad op waar hij bevroor. */
  function verder() {
    window.clearTimeout(timer);
    if (gestopt || rust.matches || resterend <= 0) return;
    loopSinds = Date.now();
    balkStand('running');
    timer = window.setTimeout(tik, resterend);
