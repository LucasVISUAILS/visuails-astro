</style>

<script>
  // THE RAILS. Both horizontal scrollers on this page — the output rail and the
  // model roster — are native overflow-x with scroll-snap, so they already work
  // by drag, wheel and keyboard with no script at all. This adds the arrows.
  //
  // WHY IT EXISTS AT ALL: the output rail has shipped with a prev/next pair
  // since the page was written and nothing was ever bound to them. They were
  // two dead buttons with aria-labels, which is worse than no buttons — a
  // screen reader announces a control that does nothing. Adding a second rail
  // was the point at which that had to be fixed rather than duplicated.
  //
  // Buttons are found within the rail's own <section>, not as siblings: the
  // head and the rail sit in two different .container wrappers so that the rail
  // can bleed wider than the copy above it.
  function initRails() {
    document.querySelectorAll('[data-rail]:not([data-rail-bound])').forEach((rail) => {
      const scope = rail.closest('section');
      if (!scope) return;
      const prev = scope.querySelector('[data-rail-prev]');
      const next = scope.querySelector('[data-rail-next]');
      if (!prev && !next) return;
      rail.setAttribute('data-rail-bound', '');

      // One card plus one gap, measured rather than assumed — every rail on the
      // site sizes its items in clamp(), so there is no constant to hard-code.
      const step = () => {
        const first = rail.firstElementChild;
        if (!first) return rail.clientWidth * 0.8;
        const gap = parseFloat(getComputedStyle(rail).columnGap || '0') || 0;
        return first.getBoundingClientRect().width + gap;
      };

      // Disable at the ends rather than wrapping around: a rail that jumps back
      // to the start reads as a carousel, and this is a shelf.
      const sync = () => {
        const max = rail.scrollWidth - rail.clientWidth - 2;
        if (prev) prev.disabled = rail.scrollLeft <= 2;
        if (next) next.disabled = rail.scrollLeft >= max;
      };

      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const go = (dir) => rail.scrollBy({ left: dir * step(), behavior: reduce ? 'auto' : 'smooth' });
      if (prev) prev.addEventListener('click', () => go(-1));
      if (next) next.addEventListener('click', () => go(1));
      rail.addEventListener('scroll', sync, { passive: true });
      window.addEventListener('resize', sync);
      sync();
    });
  }

  initRails();
  // ClientRouter swaps the document without reloading, so first paint is not
  // enough — same hook every other init on this site uses.
  document.addEventListener('astro:page-load', initRails);
</script>
