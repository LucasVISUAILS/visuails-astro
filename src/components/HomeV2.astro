// band multiplies this by the drop size, and a figure like "175–210 images" is
// exactly the kind of number that goes stale silently if it is typed by hand.
const PER_PRODUCT_VISUALS = 4 + 3;
const DROP_VISUALS_MIN = PER_PRODUCT_VISUALS * FULL_DROP_MIN;
const DROP_VISUALS_MAX = PER_PRODUCT_VISUALS * FULL_DROP_MAX;

