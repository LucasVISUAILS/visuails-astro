---
// VISUAILS — the homepage, rebuilt on the espresso ground. Section 17.
//
// WHY A NEW FILE RATHER THAN A REWRITE OF HomePage.astro. The old file is 81 kB
// of markup with four sections' worth of argued decisions embedded in its
// comments, and its copy is priced, bilingual and evidence-checked. Rebuilding
// in place would have meant editing all of that at once, with no way back and
// no way to compare. This file composes from the section primitives in
// global.css instead, borrows the copy lines that were already right, and is
// switched on by one import in src/pages/index.astro. The old page stays as
// reference until the rebuild is finished across the site; rolling back is one
// line, which is the only reason it is safe to move this fast.
//
// THE LANE, named before anything was drawn, because the register reference is
// explicit that unnamed ambition becomes beige: a colour proof on a press-room
// table under low light. Registration marks, exact figures, a dark room in
// which the photographs are the only lit objects. Not "dark SaaS" — the tell
// for that would be three equal feature cards with icons, a gradient hero and a
// badge row, which is the modal page in this category and the one this brand
// exists to be the opposite of.
//
// The rhythm is onlinepaymentplatform.com's, at Lucas's direction: full-bleed
// bands, one idea per fold, a centred statement before any explanation, tiles
// of unequal weight, a rail you push sideways, a closing panel that takes the
// viewport. The geometry is not theirs — OPP is pills and 24px radii, this
// system has no radius at all.
//
// SECTION 19 · THE PRICE IS SAID ONCE. This page used to explain what it costs
// four separate times, in four bands that were not next to each other — "One
// price per product" (123 words), "Everything the studio makes, and what it
// costs" (360), "Or put it on a monthly plan" (278) and "What the numbers
// actually are" (69). 830 words on one subject, and a reader who wanted the
// number had to assemble it from four places and hope they agreed. They are
// ONE band now, at section 2, and the three that were folded into it are
// listed at the top of that band with what became of each line.
import {
  AMOUNT, euro, TEST_SAMPLE,
  BRAND_MODEL_CREDIT_DROPS, turnaround, reviewClaim, turnaroundShort, reviewClaimShort, plans,
  LADDER, ladderRate, quote, vatLabel, vatNote,
  WINDOW_THRESHOLD, PLAN_AMOUNT, PLAN_PRODUCTS,
  CATALOG_IMAGES, LIFESTYLE_IMAGES,
} from '../data/pricing.js';
import { STOCK_OFF_BRAND, STOCK_ON_BRAND, PLAN_ROLLOVER_MONTHS } from '../data/pricing.js';
import { localizedPath } from '../i18n/ui.js';
import { TAGLINE } from '../data/brand.js';
import { waHref } from '../data/whatsapp.js';
import Disclose from './Disclose.astro';
import Compare from './Compare.astro';
import Placeholder from './Placeholder.astro';
// De doorlooptour van het klantdashboard. Zie FigDash.astro: hij verving een
// grijs vlak met een productienotitie erin.
import FigDash from './FigDash.astro';
// FigStudio.astro stond hier tot augustus 2026 — onze kant van dezelfde
// bestelling. Hij is uit deze band gehaald omdat hij dezelfde capaciteitsbalken
// tekende die FigGate op /studio al tekent (HERONTWERP.md §2.6). Zie de noot bij
// sectie 12: er is geen feit mee verdwenen, alleen een tweede figuur.
import { ROSTER, modelId, TRAITS } from '../data/models.js';
import Note from './Note.astro';
// faqPageGroups is hier niet meer nodig: de accordeon met vijf vragen uit
// faq.js is opgegaan in de bezwarenband (sectie 16). Die vijf antwoorden
// stonden woord voor woord al op /faq, en daar staan ze nog.

interface Props { lang: 'en' | 'nl'; }
const { lang } = Astro.props;
const lp = (p: string) => localizedPath(lang, p);
const sample = TEST_SAMPLE[lang];
// SHOOT_DAY came out with the "What an order replaces" band — see the comment
// where that band used to be, above the week band.

// One photograph per service. Real output, not placeholders — the studio has
// 73 real images and "show the work before the claim" is this brand's first
// design principle. Placeholders are only for the surfaces nothing exists for
// yet, which on this page is the dashboard band and nothing else.
//
// WHY THE CATALOG TILE IS NOT catalog-after.webp, WHICH WOULD BE THE OBVIOUS
// PICK. That flat-lay is already on this page twice — the plate in the band
// directly above this one, and the "after" half of the before/after compare —
// and a third appearance one fold below the second reads as the page having
// run out of work to show. banners-11 is a garment worn against a plain wall,
// which is the fourth image in every catalog set, so the tile is still showing
// the thing it is selling. If the studio ever shoots a second flat-lay, this
// is the slot it belongs in.
//
// FOUR, not five. The fifth was "A monthly plan", which is not a thing the
// studio MAKES — it is a way of paying for the other four, and it now says so
// once in the price band. Its photograph (lifestyle-phone-made-09) is off this
// page rather than reassigned: every tile here shows the service it names, and
// a stock lifestyle frame over a plan tile was the one that did not.
/*
 * ── DE ICONEN OP DE HERO-KAARTJES — 19 augustus 2026 ─────────────────────────
 *
 * Nagemeten op adobe.com/nl: hun `.rm-card` is 244 × 94px en bevat een
 * <img class="rm-card-icon"> met het productlogo, daaronder het label en rechts
 * een chevron. Dat icoon is precies wat de kaartjes hier misten.
 *
 * GETEKEND IN DE TAAL DIE DEZE SITE AL HEEFT en niet als vijf nieuwe plaatjes:
 * 24×24, `fill: none`, `stroke: currentColor`, dikte 2.6, ronde uiteinden —
 * dezelfde vorm als de vinkjes in .hv-proof en .checklist. Adobe kan losse
 * logo's gebruiken omdat elk product er een heeft; hier is er één merk en vijf
 * diensten, en dan is een consistente lijnstijl het antwoord in plaats van vijf
 * verzonnen merkjes.
 *
 * Elk pictogram zegt wat de dienst OPLEVERT en niet wat hij is: vier vlakken
 * voor de catalogset, een carousel met randen die eruit lopen, een verticaal
 * kader met een driehoek voor de clip, een gezicht voor het merkmodel. De
 * eerste is een stapel — alles in één huisstijl.
 */
const SLIDE_ICON = [
  // stapel · alles in één huisstijl
  'M12 3 3 8l9 5 9-5-9-5z M3 14l9 5 9-5',
  // vier vlakken · catalogset
  'M4 4h7v7H4z M13 4h7v7h-7z M4 13h7v7H4z M13 13h7v7h-7z',
  // carousel · een kader met buren die eruit lopen
  'M7 5h10v14H7z M3.5 8v8 M20.5 8v8',
  // verticaal kader met afspeeldriehoek · videoclip
  'M7 3h10v18H7z M10.8 9.6l4 2.4-4 2.4z',
  // gezicht · je merkmodel
  'M12 11.5a4 4 0 1 0 0-8 4 4 0 0 0 0 8z M4.5 20.5a7.5 7.5 0 0 1 15 0',
];

/*
 * De twee aangekondigde diensten staan sinds 20 augustus 2026 in dezelfde rij
 * als de vier die je kunt bestellen, dus hebben ze ook een pictogram nodig.
 * Apart van SLIDE_ICON gehouden: die rij hoort bij de vijf dia's van de hero en
 * die vijf zijn niet dezelfde vijf.
 */
const SOON_ICON = [
  // haak · Hooks
  'M8 4h5a4 4 0 0 1 4 4v9 M17 17l-3-3 M17 17l3-3',
  // stapel bladen met een kalenderstreep · Editions
  'M4 8h16v12H4z M8 4h12v12 M8 12h8 M8 16h5',
];

const SERVICE_IMG = [
  { src: '/img/banners-11.webp', w: 1200, h: 896 },
  { src: '/img/lifestyle-glow-02.webp', w: 2400, h: 1792 },
  { src: '/img/banners-16.webp', w: 2400, h: 1792 },
  { src: '/img/custom-models-04.webp', w: 1200, h: 1200 },
];

// The roster rail in the Brand Model band. Every face here is a real entry in
// src/data/models.js, which is the same list /models and /custom-models read —
// so the homepage cannot end up advertising a face the roster no longer has.
/*
 * De eigenschappen van een model zijn SLEUTELS ('warm', 'approachable'), geen
 * woorden. TRAITS[lang] maakt er woorden van. Dit stond hier niet en het gevolg
 * was Engelse sleutels op de Nederlandse homepage — zie de noot bij de rij zelf.
 * Onbekende sleutel: de sleutel zelf, zodat een nieuwe eigenschap zichtbaar
 * ontbreekt in plaats van stil te verdwijnen.
 */
const traitWords = (m) => (m.traits || []).map((k) => (TRAITS[lang] || TRAITS.en)[k] || k);

const FACES = ROSTER;

// VISUALS PER PRODUCT, derived rather than typed. A catalog set is four photos
// and a lifestyle carousel is three, which is what one product on the
// `complete` ladder gets. The channel band multiplies this by an example count,
// and a figure like "210 images" is exactly the kind of number that goes stale
// silently if it is typed by hand.
//
// The two counts are named because the services band states them one by one
// ("4 images per product") and the channel band states their sum. They were the
// same two numbers typed in two places until the services band arrived; one
// source is why the two bands cannot end up promising six images and seven.
const CATALOG_IMAGES = 4;
const LIFESTYLE_IMAGES = 3;
const PER_PRODUCT_VISUALS = CATALOG_IMAGES + LIFESTYLE_IMAGES;

// DE DRIE UITGEWERKTE TOTALEN — 5, 14 en 30 producten — stonden hier als drie
// tegels onder de prijstabel. Ze staan sinds augustus 2026 alleen nog op
// /pricing, waar ze uit dezelfde quote() komen; zie de noot in de prijsband.
//
// EX_SMALL en Q_SMALL blijven, want firstBody rekent er nog mee: "14 complete
// producten kosten X, wie je ook bent". Veertien is het aantal waar de oude
// pakketten geen prijs voor hadden — een merk met veertien producten viel
// tussen een Pilot van acht en een Full Drop van vijfentwintig en betaalde à
// la carte méér dan een Full Drop van dertig. Dat getal noemen is de kortste
// manier om te laten zien dat het gat weg is, en het is precies daarom dat
// juist déze zin het overleefde.
//
// EX_FULL (30, een heel seizoen) staat nog in de dienstenlede.
const EX_SMALL = 14;
const EX_FULL = 30;
const Q_SMALL = quote('complete', EX_SMALL);
// ── ER STAAT GEEN PRIJSREGEL MEER IN DE HERO ───────────────────────────────
// Er stond er een: "Per product — from €149, down to €65 as the count rises."
// Lucas haalde hem eruit op 20 augustus 2026, en de reden is de juiste reden:
// die zin gaat over FOTO'S, en de site verkoopt inmiddels ook video, merkmodellen
// en abonnementen. Een enkel bedrag boven de vouw dat maar één van die vier dekt,
// leest als HET tarief van VISUAILS, en dat is het niet.
//
// Dus is de hero weer wat hij hoort te zijn — kop, dia, twee knoppen — en staat
// de prijs waar hij hoort: in de staffeltabel verderop deze pagina, en voluit op
// /pricing en /plans. Drie constanten hebben hier achter elkaar gestaan voor
// precies dit soort zin (ENTRY_RATE, FLOOR_RATE, FLOOR_RATE_EN) en alle drie zijn
// ze weer weggehaald. Zet er geen vierde neer: de tabel is de zin al.
//
// ladderFloor is met de laatste mee de import uit; ladderRate blijft, want de
// tabel roept hem aan.
const EX_VISUALS = PER_PRODUCT_VISUALS * EX_FULL;

// ── THE LADDER, AS A TABLE ─────────────────────────────────────────────────
// The band used to print each service's entry rate and floor as prose — "from
// €89 per product, down to €33 as the count rises", five times over. That is a
// rate card written out in sentences, and it cost 360 words to say what a
// fifteen-cell table says without a verb. Same shape as /pricing's, three
// columns and five rungs, because a reader who has seen one should recognise
// the other.
const KIND_IDS = ['complete', 'catalog', 'lifestyle'] as const;
// Two of the three are a pillar page under another name, so the column heading
// is the link — the brief's internal-linking rule without a row of chips.
// `complete` is both of the others bought together and has no page of its own.
const KIND_PAGE: Record<string, string | null> = {
  complete: null,
  catalog: '/catalog',
  lifestyle: '/lifestyle',
};
// Row labels come off ONE kind and are reused for all three columns, which is
// only honest if the three break at the same counts. They do — see LADDER in
// pricing.js — but /pricing asserts it rather than trusting it, and a homepage
// that quietly disagreed with the price list would be the worse of the two
// places to find out. Same check, same reason.
const RUNGS = LADDER.complete.map(([lo, hi]) => ({
  at: lo,
  label: hi === null ? `${lo}+` : `${lo}–${hi}`,
}));
for (const id of KIND_IDS) {
  const shape = LADDER[id].map(([lo, hi]) => `${lo}:${hi}`).join(',');
  if (shape !== LADDER.complete.map(([lo, hi]) => `${lo}:${hi}`).join(',')) {
    throw new Error(`HomeV2: ladder kind "${id}" breaks at different counts than "complete" — the shared row labels would lie.`);
  }
}

// The plans get one line and one figure on this page, not a plan grid. The
// grid was 278 words to say what /pricing says in full three clicks' worth of
// detail better; the homepage's job is to say that the other axis exists.
const PLAN_FROM = Math.min(...Object.values(PLAN_AMOUNT));
const PLAN_LOW = Math.min(...Object.values(PLAN_PRODUCTS));
const PLAN_HIGH = Math.max(...Object.values(PLAN_PRODUCTS));

// ── DE ABONNEMENTSBAND · ÉÉN GETAL, EN DAT GETAL IS AFGELEID ────────────────
// Het goedkoopste plan bepaalt zowel het bedrag als het aantal producten, en
// die twee moeten bij ELKAAR horen. Los van elkaar het laagste bedrag en het
// laagste aantal pakken werkt hier toevallig — starter is allebei — maar het
// is een som die stilletjes gaat liegen zodra er een vierde plan bij komt met
// een ander verband. Dus: zoek het goedkoopste plan op, en lees zijn beide
// getallen daaruit.
const PLAN_CHEAPEST = Object.keys(PLAN_AMOUNT)
  .reduce((a, b) => (PLAN_AMOUNT[b] < PLAN_AMOUNT[a] ? b : a));
const PLAN_FROM_PRODUCTS = PLAN_PRODUCTS[PLAN_CHEAPEST];
const PLAN_COUNT = Object.keys(PLAN_AMOUNT).length;

const COPY = {
  en: {
    heroAlt: 'A VISUAILS campaign visual — a figure in a puffer jacket on a back seat, lit acid green',
    // THE HEADLINE CARRIES ITS OWN EMPHASIS as of 6 August 2026 — the <em> is in
    // the copy instead of being applied to whatever line happens to be last.
    // Lucas, looking at the old behaviour: *"de hele zin toxic groen maken vind
    // ik wat minder"*, and the line before it broke with "Wij" alone. Both came
    // from the same place: the component decided the accent and nobody decided
    // the line breaks. Now the sentence says both.
    //
    // Written as English, not translated from the Dutch. "You upload. We deliver
    // the campaign." is the same two beats — the customer's one action, then
    // ours — and "campaign" is the word an established brand already uses for
    // what it runs. Nothing here says they are not a brand yet; that was the
    // objection to the previous draft.
    h1: TAGLINE.en.lines,
    // THE ANCHOR CARRIES A NUMBER NOW. It used to say "priced per product, and
    // the rate falls" — true, and unfalsifiable, which is the shape of a claim
    // rather than a price. With the table moved to section 5 this line is the
    // only figure above the fold, and a visitor who came to find out what it
    // costs should not have to scroll five bands to learn the studio is not an
    // agency that quotes on request.
    //
    // 20 AUGUSTUS: DE ZIN ERVOOR IS WEG. Er stond eerst "One folder of product
    // photos becomes a whole collection — catalog, lifestyle and video in a
    // single house style." Lucas: *"Verwijder nou eens de onnodige tekst,
    // hierdoor is het beginscherm zo druk."* Terecht, want die zin zei precies
    // wat de regel onder de kop al zegt ("One order, every image in the same
    // house style") en wat de vier kaartjes eronder tonen. Wat hij als ENIGE
    // deed was het getal inleiden, en een getal heeft geen inleiding nodig.
    // Wat overblijft is de prijs, want dat is het enige cijfer boven de vouw en
    // de reden dat deze regel er staat.
    ctaStart: 'Start an order',
    // KORT, want dit is een knop en geen zin. De hele belofte stond hier in het
    // label en dat maakte de pil breder dan de primaire knop ernaast — een
    // secundaire actie die meer ruimte inneemt dan de primaire leest als de
    // hoofdactie. Wat je krijgt staat nu in ctaSampleNote eronder, waar het
    // gelezen mag worden in plaats van gescand.
    ctaSample: `Request a test sample · ${sample.price}`,
    // Begint met het woord "Test sample", niet met "One product photo": deze
    // regel staat onder BEIDE knoppen en moet zonder twijfel bij de tweede
    // horen. Zonder dat woord lijkt het of een bestelling ook € 1 kost.
    //
    // KORTER GEMAAKT OP 20 AUGUSTUS, want dit was met vier regels het grootste
    // stuk hoogte in de hero dat geen kop, knop of beeld is. Eruit: "send the
    // same photos as a normal order — front and back at least". Dat is een
    // INSTRUCTIE en geen aanbod; wie op de knop drukt komt op /test-sample waar
    // hij voluit staat, en niemand hoeft te weten hoe hij foto’s moet aanleveren
    // vóórdat hij besloten heeft of hij het wil. Wat blijft staan is wat je
    // erin stopt, wat je terugkrijgt, en dat het één keer per bedrijf kan.
    ctaSampleNote: `Test sample: your own photos in, ${sample.deliverable} back. ${sample.unit.charAt(0).toUpperCase() + sample.unit.slice(1)}.`,
    // ── THE PROOF LINE, and it used to be a plinth ────────────────────────
    // Lucas: *"ik wil de rand onder de hero wat meer conversiegericht maken
    // omdat deze nu een beetje saai oogt, en eigenlijk geen rand ervan maken,
    // liever op de hero zelf zulke info tonen zonder balk erachter."*
    //
    // What was here: a 0.86-alpha bar across the foot of the hero holding
    // WINDOW / REVIEW / STUDIO as a definition list. Three labels and three
    // values, which is a SPEC SHEET — the format a datasheet uses, and the
    // reason it read as furniture. "STUDIO — Enschede, NL" in particular
    // answers a question nobody has above the fold.
    //
    // Three lines now, each one an objection rather than an attribute: when do
    // I get it, is it actually any good, and can I use what I get. The third
    // is new; the first two are the same two typed helpers as before.
    //
    // STILL NOT TYPED BY HAND. pricing.js's header says "pages use this, never
    // a literal" and this file broke that rule in four places — which is
    // exactly how the NL copy ended up saying "bevestigd voor je betaalt"
    // while six other NL pages said "voordat je betaalt". Two promises, two
    // wordings, one studio. The licence line is the one string here that has
    // no helper, and it is quoted from the promise band verbatim.
    // ── KORT, WANT ZE STAAN NU NAAST ELKAAR ───────────────────────────────
    // Lucas, 20 augustus: *"mogen de 3 vinkjes achter elkaar met genoeg ruimte
    // ertussen zodat de homepage niet zo lang voelt."* Onder elkaar was deze
    // lijst 76px hoog; naast elkaar met de VOLLE zinnen liep hij op 976px en
    // dus over de foto heen, in een kolom van 640. Dus de korte vormen — zie
    // turnaroundShort() en reviewClaimShort() in pricing.js, waar ze pal naast
    // de lange staan zodat ze niet uit elkaar kunnen lopen.
    //
    // De licentieregel heeft geen helper en wordt hier ingekort: de opsomming
    // "shop, marketplaces, ads and feeds" is een voorbeeldenrij en geen extra
    // toezegging, en staat voluit in de beloftenband verderop op deze pagina.
    proof: [
      turnaroundShort('attended', 'en'),
      reviewClaimShort('attended', 'en'),
      'Yours to use, anywhere',
    ],

    /*
     * ══════════════════════════════════════════════════════════════════════
     * DE HERO-CARROUSEL — 19 augustus 2026
     * ══════════════════════════════════════════════════════════════════════
     *
     * Lucas, met twee schermafdrukken van adobe.com/nl erbij: *"Ook wel leuk om
     * op de homepage net als bij adobe die timer diaslide toe te voegen met wat
     * visuails allemaal maakt."*
     *
     * Adobe’s hero is vijf dia's die vanzelf doorlopen, met onderaan vijf
     * kaartjes die de dia kiezen en een pauzeknop ernaast. Hier hetzelfde, met
     * de inhoud die deze studio heeft: de belofte, en dan de vier dingen die we
     * maken.
     *
     * ── DIA 1 IS DE BESTAANDE HERO EN BLIJFT DAT ─────────────────────────
     *
     * "Jij uploadt. Wij leveren de campagne." is de positionering van het merk
     * en het eerste wat laadt. Die dia houdt zijn twee knoppen en zijn
     * bewijsregel; de vier dia's erna zijn lichter, precies zoals bij Adobe:
     * bovenkop, kop, één zin, één knop.
     *
     * ── DE KOPPEN ZIJN FEITEN EN GEEN BELOFTES ───────────────────────────
     *
     * "Vier beelden per product", niet "meer verkopen". Dezelfde regel als bij
     * de dienstkaarten verderop, en de toets in promises.test.mjs bewaakt hem
     * daar al: wat wij leveren mogen we zeggen, wat een platform of een koper
     * daarna doet niet.
     */
    heroSlideLabel: 'What we make',
    heroCarouselName: 'What VISUAILS makes',
    // De naam voor het pijltje rechts in elk kaartje: het kaartje wisselt de dia,
    // het pijltje gaat naar de pagina.
    heroGoTo: 'Go to',
    heroPause: 'Pause the slideshow',
    heroPlay: 'Play the slideshow',
    /*
     * ── DE TEKST BLIJFT STAAN, ALLEEN HET BEELD WISSELT — 20 augustus 2026 ──
     *
     * Lucas: *"ik wil dat de tekst op de eerste slide gewoon doorloopt op de
     * volgende slides, alleen wanneer je denkt dat het nodig is een hele korte
     * beschrijving onder de kop die het uitlegt."*
     *
     * Wat hier stond: vijf volledige tekstblokken die elkaar aflosten — elk met
     * een eigen bovenregel, eigen kop, eigen alinea en eigen knop. Vier keer
     * ruim veertig woorden die na zeven seconden weer weg waren, en een
     * bezoeker die halverwege een zin zat, raakte hem kwijt. Dat is de
     * "veel te druk" waar hij het over heeft: het is niet één pagina met veel
     * tekst maar vijf pagina's over elkaar.
     *
     * Nu staat de belofte stil en wisselt alleen het beeld, met één regel
     * eronder die zegt wat je ziet. `h`, `lede` en `eyebrow` zijn daarmee weg —
     * dat is 164 woorden minder in de html — en wat overblijft is `note`: één
     * zin, en de link naar de pagina van die dienst zodat de route blijft.
     */
    heroSlides: [
      { card: 'All in one house style', note: 'One order, every image in the same house style.' },
      { card: 'Catalog set',        note: 'Four images per product: front, back, detail, on-model.', cta: 'See Catalog',      href: '/catalog/',       img: 0 },
      { card: 'Lifestyle carousel', note: 'Three images in one styled scene, ready to post.',        cta: 'See Lifestyle',    href: '/lifestyle/',     img: 1 },
      { card: 'Video clip',         note: 'One vertical clip, cut for Reels and TikTok.',            cta: 'See Video',        href: '/video/',         img: 2 },
      { card: 'Your Brand Model',   note: 'One face, only yours, in every order you run.',           cta: 'See Brand Models', href: '/custom-models/', img: 3 },
    ],

    // ── THE PRICE BAND ────────────────────────────────────────────────────
    // Everything this page says about money is in these keys and nowhere else.
    // The heading is the old drop band's, kept word for word: it was already
    // the shortest true statement of the model, and a merged band that renamed
    // itself would read to a returning visitor as a new offer.
    priceH: ['One price per product.', 'It falls as you add.'],
    priceLede: `A product is the unit — a catalog set and a lifestyle carousel, ${PER_PRODUCT_VISUALS} finished images. Take the pair or either half, and the rate comes down as the count goes up.`,
    // The ONE VAT statement for this band. Block level, above everything it
    // qualifies, rather than appended to each of the fifteen rates and three
    // totals below it — which is what "excl. VAT" ×8 in one band looked like.
    priceVat: `Every figure in this section is ${vatLabel('excl', 'en')}.`,
    ladCountCol: 'Products',
    // [column heading, what one product of that kind gets]
    ladKinds: [
      ['Complete', `${PER_PRODUCT_VISUALS} images`],
      ['Catalog set', `${CATALOG_IMAGES} images`],
