    // regel per punt in plaats van twee.
    tsPoints: [
      ['One per business', 'No trial, no card kept on file, no account, nothing to cancel.'],
      ['No shortcuts for a sample', 'Same production and the same human check as a paid order.'],
      ['No obligation after', 'If it is not right, that is the end of it.'],
    ],
    tsCta: 'Get your test sample',
    tsAlt: 'Or start an order',

    // The rail's two arrow labels survive its deletion: the Brand Model band
    // further down renders the same .rail-nav buttons and reads these keys.
    railPrev: 'Previous',
    railNext: 'Next',

    // ── THE SERVICES BAND, WITH THE PRICES TAKEN OUT ──────────────────────
    // Each tile used to carry a figure and a terms line, which is where 8 of
