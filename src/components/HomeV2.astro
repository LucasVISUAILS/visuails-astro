                met tab te bereiken, en kan niet per ongeluk toch iets doen. */}
            <button class="btn btn-ghost hv-soon-btn" type="button" disabled>{soon.cta}</button>
          </span>
        </div>
      ))}
    </div>
    </div>{/* /.hv-svc-float */}

    <div class="hv-svc-foot">
      <a class="btn btn-ghost" href={lp('/start')}>{c.svcCta}</a>
    </div>
  </div>
</section>

{/* ── 4 · WHO IT IS FOR — VERHUISD NAAR /about, augustus 2026 ───────────
    Vier situaties plus de "waarschijnlijk niets voor je als"-lijst, 179
