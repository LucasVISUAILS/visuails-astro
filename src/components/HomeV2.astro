<style>
  /* ── hero ───────────────────────────────────────────────────────────────
     100svh, not 100vh: on iOS the URL bar makes vh taller than the visible
     area, so a "full height" hero puts its own bottom edge under the browser
     chrome and the plinth is the thing that disappears. */
  /* padding-block is reset explicitly: global.css gives every <section> a
     clamp(4.5rem, 9vw, 9rem) block padding, and on a full-bleed hero that
     lands as 130px of dead photograph under the plinth — measured, not
     guessed. A hero is not a band and does not take a band's rhythm. */
  .hv-hero { position: relative; min-height: 100svh; display: flex; flex-direction: column; overflow: hidden; margin-top: -76px; padding: 76px 0 0; isolation: isolate; background: var(--ink-900); }
  .hv-hero-bg { position: absolute; inset: 0; z-index: -2; }
  .hv-hero-bg img { width: 100%; height: 100%; object-fit: cover; object-position: center 26%; }
  /* Two layers doing two jobs. The radial is the plate under the headline;
     the linear darkens the band the sticky nav stands on and lifts the foot
     so the plinth reads as a solid rail rather than as a floating strip. */
  .hv-hero-scrim { position: absolute; inset: 0; z-index: -1; background:
    radial-gradient(92% 82% at 16% 84%, rgb(var(--scrim) / 0.90) 0%, rgb(var(--scrim) / 0.42) 54%, transparent 78%),
    linear-gradient(180deg, rgb(var(--scrim) / 0.76) 0%, rgb(var(--scrim) / 0.50) 13%, rgb(var(--scrim) / 0.14) 27%, transparent 52%, rgb(var(--scrim) / 0.46) 84%, rgb(var(--scrim) / 0.66) 100%); }
  .hv-hero-inner { flex: 1; display: flex; align-items: flex-end; width: 100%; }
  .hv-hero-copy { max-width: 40rem; padding-block: 3rem clamp(2.5rem, 6vh, 4rem); }
  .hv-h1 { font-size: var(--t-hero); line-height: 0.98; letter-spacing: -0.04em; margin: 0; color: var(--paper-on-dark); }
  .hv-line { display: block; }
  .hv-h1 em { font-family: var(--font-editorial); font-style: italic; font-weight: 700; }
  .hv-lede { margin: clamp(1.2rem, 2.4vw, 1.9rem) 0 0; max-width: 46ch; font-size: var(--t-lg); line-height: 1.55; color: var(--paper-soft-on-dark); }
  .hv-cta { display: flex; gap: .75rem; flex-wrap: wrap; margin-top: clamp(1.6rem, 3vw, 2.2rem); }
  @media (max-width: 560px) { .hv-cta > .btn { width: 100%; } }

  /* The plinth: three facts that are true before anyone talks to us. Ink at
     0.86 rather than a lower alpha because it sits on a photograph whose
     brightest pixel is not ours to choose. */
  .hv-plinth { position: relative; background: rgb(var(--scrim) / 0.86); box-shadow: inset 0 1px 0 var(--line-strong); }
  .hv-plinth-row { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(1rem, 3vw, 3rem); margin: 0; padding-block: 1.15rem 1.35rem; }
  .hv-fact dt { font-size: .68rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--paper-muted-on-dark); margin: 0; }
  .hv-fact dd { margin: .35rem 0 0; font-size: .86rem; line-height: 1.4; color: var(--paper-on-dark); }
  /* Colour as a rule under one fact the copy already states, never as a fill —
     a delivery window is Flag, a review claim is Verify. */
  .hv-fact.is-flag dd, .hv-fact.is-verify dd { display: inline-block; border-bottom: 3px solid; padding-bottom: .18rem; }
  .hv-fact.is-flag dd { border-color: var(--clay); }
  .hv-fact.is-verify dd { border-color: var(--teal); }
  @media (max-width: 760px) {
    .hv-plinth-row { grid-template-columns: 1fr; gap: .9rem; }
    /* The WhatsApp launcher is position: fixed at bottom-left, and the plinth
       is the bottom of a 100svh hero — so on a phone they occupy the same
       pixels on first paint and the launcher sat on top of the third fact.
       48px launcher + its 12px inset + a little air. Measured, not padded by
       feel. */
    .hv-plinth-row { padding-bottom: 5.25rem; }
  }

  /* ── the one accent word ────────────────────────────────────────────────
     Teal is spent on the primary action and one headline word. On the dark
     ground --teal-text is unreadable, so the highlight is carried by full
     paper against the soft paper the rest of the line runs at — value rather
     than hue, which is the same idea in the material the ground allows. */
  /* The accent word in a section heading. It was paper-on-paper — the same
     white as the rest of the line, so "accent" meant italics-turned-off and
     nothing else. It is the palette's blue now, which is what OPP does with
     the word that carries the sentence. */
  .hv-accent { font-style: normal; color: var(--fill-blue); }


  /* ── tiles ─────────────────────────────────────────────────────────────── */
  .hv-tile-sub { margin: .45rem 0 0; font-size: .9rem; color: var(--ink-2); }
  /* Declared AFTER .hv-tile-v, which also sets colour at the same specificity —
     source order is the whole difference and it silently made the one clay
     moment on the page render as paper. §7 holds clay to one stat or one chip
     at a time; on this page it is the window figure and the €0.99. */
  .tile-v.hv-clay, .hv-stat dt.hv-clay { color: var(--clay); }
  .on-paper .tile-v.hv-clay, .on-paper .hv-stat dt.hv-clay { color: var(--clay-text); }
  .hv-drop-tiles, .hv-svc-tiles { margin-top: clamp(2.4rem, 5vw, 4rem); }

  /* ── the services ──────────────────────────────────────────────────────────
     A whole-tile link, so the target is the card and not a word inside it.
     Radii are inherited: .tile carries --r-lg and clips its own media, which
     is why nothing here sets a corner except the inset .hv-svc-get plate —
     that one is a surface of its own and takes --r-md, the step below the
     card that contains it. Nothing in this band is allowed a hard corner. */
  .hv-svc-tile { color: inherit; transition: background var(--dur-1) var(--ease); }
  .hv-svc-tile:hover { background: var(--bg-raise); }
  /* Two aspect ratios for two tile widths. A 4/3 crop inside a half-row tile
     is 480px of photograph before a word is read; the wide pair get 16/9 so
     the copy under them still starts above the fold of the tile. */
  .hv-svc-media { aspect-ratio: 4 / 3; }
  .hv-svc-media.is-wide { aspect-ratio: 16 / 9; }
  .hv-svc-media img { transition: transform var(--dur-3) var(--ease); }
  .hv-svc-tile:hover .hv-svc-media img { transform: scale(1.03); }
  @media (prefers-reduced-motion: reduce) {
    .hv-svc-media img, .hv-svc-tile:hover .hv-svc-media img { transition: none; transform: none; }
  }
  .hv-svc-body { gap: 0; }
  .hv-svc-line { font-size: .875rem; line-height: 1.55; color: var(--ink-3); }
  .hv-svc-get {
    margin-top: 1rem;
    padding: .7rem .85rem;
    background: var(--surface-2);
    border-radius: var(--r-md);
    font-size: .82rem; line-height: 1.5; color: var(--ink-2);
  }
  /* The price sits on the tile's floor with a rule above it, so five tiles of
     unequal copy length still line their figures up with each other. */
  .hv-svc-price { margin-top: auto; padding-top: 1.2rem; display: block; }
  .hv-svc-price b {
    display: block;
    font-family: var(--font-display); font-weight: 900;
    font-size: clamp(1.5rem, 2.4vw, 1.9rem); line-height: 1; letter-spacing: -0.03em;
    color: var(--ink); font-variant-numeric: tabular-nums lining-nums;
  }
  .hv-svc-price span { display: block; margin-top: .4rem; font-size: .78rem; line-height: 1.45; color: var(--ink-3); }
  /* The one sentence about VAT on this page, plus the bundle arithmetic. Left
     as prose rather than a tile: it qualifies all five figures above it and a
     sixth card would read as a sixth service. */
  .hv-svc-foot { margin-top: clamp(1.6rem, 3vw, 2.4rem); display: flex; align-items: flex-start; justify-content: space-between; gap: clamp(1.2rem, 3vw, 2.5rem); flex-wrap: wrap; }
  .hv-svc-foot p { margin: 0; max-width: 62ch; font-size: .85rem; line-height: 1.6; color: var(--ink-3); }
  .hv-svc-foot .btn { flex: 0 0 auto; }

  @media (max-width: 700px) {
    .rail-nav { display: none; }
    /* Two cards fit inside 390px, separated by the rail's 1px rule — which
       put one item's caption hard against the next item's label with nothing
       between them but a hairline. One and a bit cards is the right number on
       a phone: it shows there is more without pretending to show it. The
       caption stacks as well, because a label and a note side by side inside
       a 15rem card is two columns of two words. */
    .rail > * { flex-basis: 74vw; }
    .plate-cap { flex-direction: column; gap: .15rem; }
  }

  /* ── pipeline ──────────────────────────────────────────────────────────── */
  .hv-pipe-head { max-width: 40rem; }
  .hv-pipe { list-style: none; margin: clamp(2.4rem, 5vw, 3.5rem) 0 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); gap: 1px; background: var(--line); }
  .hv-pipe > li { background: var(--bg); padding: clamp(1.25rem, 2.2vw, 1.9rem); }
  /* Outlined numerals: the colour is the STROKE, because a filled 2.4rem 900
     numeral in four hues would out-shout the step it labels. The four are
     7.91–8.07:1 on this ground, well past the 3:1 a large glyph needs. */
  .hv-pipe-n { font-family: var(--font-display); font-weight: 900; font-size: 2.4rem; line-height: 1; color: transparent; -webkit-text-stroke: 1.5px var(--line-ui); display: block; }
  .hv-pipe-n.s-blue   { -webkit-text-stroke-color: var(--fill-blue); }
  .hv-pipe-n.s-violet { -webkit-text-stroke-color: var(--fill-violet); }
  .hv-pipe-n.s-pink   { -webkit-text-stroke-color: var(--fill-pink); }
  .hv-pipe-n.s-coral  { -webkit-text-stroke-color: var(--fill-coral); }
  .hv-pipe h3 { margin: 1rem 0 .45rem; font-size: 1.02rem; font-weight: 700; color: var(--ink); }
  .hv-pipe p { margin: 0; font-size: .875rem; line-height: 1.55; color: var(--ink-3); }

  /* ── the comparison ────────────────────────────────────────────────────── */
  .hv-vs { display: grid; grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr)); gap: 1px; background: var(--line); margin-top: clamp(2.4rem, 5vw, 3.5rem); }
  .hv-vs-col { background: var(--bg); padding: clamp(1.4rem, 2.6vw, 2.2rem); }
  .hv-vs-col.is-drop { background: var(--surface); }
  .hv-vs-list { list-style: none; margin: 1.2rem 0 0; padding: 0; display: grid; gap: .5rem; }
  .hv-vs-list li { position: relative; padding-left: 1.1rem; font-size: .875rem; line-height: 1.5; color: var(--ink-2); }
  .hv-vs-list li::before { content: ''; position: absolute; left: 0; top: .55em; width: 6px; height: 1px; background: var(--line-ui); }
  .hv-vs-note { margin: 1.4rem 0 0; font-size: .85rem; line-height: 1.6; color: var(--ink-3); max-width: 64ch; }
  .hv-vs-note a { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 3px; text-decoration-color: var(--line-strong); }
  .hv-vs-note a:hover { text-decoration-color: var(--accent); }

  /* ── the dashboard band ────────────────────────────────────────────────── */
  .hv-dash { margin-top: clamp(2.6rem, 5vw, 4rem); display: grid; gap: 1px; background: var(--line); }
  .hv-dash-row { background: var(--bg); display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(1.5rem, 3vw, 3rem); align-items: center; padding: clamp(1.5rem, 3vw, 2.6rem); }
  .hv-dash-row.is-flip .hv-dash-copy { order: 2; }
  .hv-dash-copy h3 { margin: 0 0 .7rem; font-size: var(--t-h3); font-weight: 700; color: var(--ink); }
  .hv-dash-copy p { margin: 0 0 1.3rem; font-size: .95rem; line-height: 1.6; color: var(--ink-2); max-width: 46ch; }
  .hv-dash-log { background: var(--bg); padding: clamp(1.5rem, 3vw, 2.6rem); }
  .hv-dash-log h3 { margin: 0 0 .7rem; font-size: var(--t-h3); font-weight: 700; color: var(--ink); }
  .hv-dash-log p { margin: 0 0 1.3rem; font-size: .95rem; line-height: 1.6; color: var(--ink-2); max-width: 68ch; }
  @media (max-width: 820px) {
    .hv-dash-row { grid-template-columns: 1fr; }
    .hv-dash-row.is-flip .hv-dash-copy { order: 0; }
  }

  /* ── stats ─────────────────────────────────────────────────────────────── */
  .hv-stats-h { font-size: var(--t-h3); font-weight: 700; margin: 0 0 clamp(1.6rem, 3vw, 2.4rem); max-width: 30ch; color: var(--ink); }
  .hv-stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0; margin: 0; }
  .hv-stat { padding: 0 clamp(1rem, 2vw, 1.8rem); }
  .hv-stat:first-child { padding-left: 0; }
  .hv-stat + .hv-stat { border-left: 1px solid var(--line); }
  .hv-stat dt { font-family: var(--font-display); font-weight: 900; font-size: clamp(2.4rem, 4.2vw, 3.125rem); line-height: 1; letter-spacing: -0.035em; color: var(--ink); font-variant-numeric: tabular-nums lining-nums; }
  /* The coloured figure, set HERE rather than relying on the global .w-*
     utility. Astro scopes this block with a [data-astro-cid] attribute, so
     `.hv-stat dt` renders as (0,3,1) and outranks any global class utility no
     matter how many times it is doubled. A scoped stylesheet always wins; the
     override has to live in the same scope that caused the conflict. */
  .hv-stat dt.w-blue   { color: var(--fill-blue); }
  .hv-stat dt.w-violet { color: var(--fill-violet); }
  .hv-stat dt.w-pink   { color: var(--fill-pink); }
  .hv-stat dt.w-coral  { color: var(--fill-coral); }
  .hv-stat dd { margin: .75rem 0 0; font-size: .875rem; line-height: 1.5; color: var(--ink-3); max-width: 26ch; }
  @media (max-width: 880px) {
    .hv-stats { grid-template-columns: repeat(2, 1fr); row-gap: clamp(1.6rem, 4vw, 2.4rem); }
    .hv-stat:nth-child(odd) { padding-left: 0; border-left: 0; }
  }
  @media (max-width: 460px) {
    .hv-stats { grid-template-columns: 1fr; }
    .hv-stat { padding: 0; border-left: 0; }
    .hv-stat + .hv-stat { padding-top: 1.4rem; border-top: 1px solid var(--line); }
  }

  /* ── the promise ───────────────────────────────────────────────────────── */
  .hv-promise { display: grid; grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr)); gap: clamp(2rem, 5vw, 4rem); align-items: start; }
  .hv-promise-h { font-size: var(--t-h2); line-height: 1.05; letter-spacing: -0.035em; margin: 0; }
  .hv-promise-h span { display: block; }
  .hv-promise-h .dim { color: var(--ink-3); }
  .hv-quote { font-family: var(--font-editorial); font-style: italic; font-weight: 500; font-size: clamp(1.15rem, 1.9vw, 1.45rem); line-height: 1.45; color: var(--ink); margin: 1.4rem 0 0; max-width: 40ch; }
  .hv-sign { margin: 1rem 0 0; font-size: .875rem; color: var(--ink-3); }
  .hv-sign strong { color: var(--ink-2); }
  .hv-checks { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.1rem; }
  .hv-checks li { display: grid; grid-template-columns: 20px 1fr; gap: .75rem; font-size: .9rem; line-height: 1.55; color: var(--ink-3); }
  .hv-checks strong { color: var(--ink); }
  .hv-checks svg { width: 18px; height: 18px; margin-top: .18rem; fill: none; stroke: var(--ink-2); stroke-width: 2; }
  .hv-trust { list-style: none; display: flex; flex-wrap: wrap; gap: .5rem 1.8rem; margin: clamp(2.2rem, 4vw, 3rem) 0 0; padding: clamp(1.4rem, 2.5vw, 2rem) 0 0; box-shadow: inset 0 1px 0 var(--line); font-size: .82rem; color: var(--ink-3); }

  /* ── who it is for ─────────────────────────────────────────────────────── */
  .hv-who-tiles { margin-top: clamp(2.4rem, 5vw, 4rem); }
  /* The index is a label, not a step: the four situations are alternatives, so
     it is set small and coloured rather than drawn as the stroked numerals the
     pipeline uses — those mean sequence, and reusing them here would promise an
     order that does not exist. */
  .hv-who-i { display: block; font-family: var(--font-display); font-weight: 900; font-size: .74rem; letter-spacing: .14em; margin-bottom: 1.1rem; }
  .hv-notfor { margin-top: clamp(2rem, 4vw, 3rem); padding-top: clamp(1.4rem, 2.5vw, 2rem); box-shadow: inset 0 1px 0 var(--line); display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2.2fr); gap: clamp(1rem, 3vw, 3rem); }
  .hv-notfor-h { margin: 0; font-size: .72rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--ink-3); }
  .hv-notfor ul { list-style: none; margin: 0; padding: 0; display: grid; gap: .65rem; }
  .hv-notfor li { position: relative; padding-left: 1.4rem; font-size: .9rem; line-height: 1.55; color: var(--ink-3); }
  /* Coral, not the blue accent: this is the one list on the page that is a
     warning rather than an offer, and the palette already reserves coral for
     the figure that is being counted against you. */
  .hv-notfor li::before { content: ''; position: absolute; left: 0; top: .64em; width: 9px; height: 1px; background: var(--fill-coral); }
  @media (max-width: 720px) { .hv-notfor { grid-template-columns: 1fr; } }

  /* ── before / after ────────────────────────────────────────────────────── */
  .hv-ba-head { max-width: 44rem; }
  .hv-ba { margin-top: clamp(2.2rem, 4.5vw, 3.4rem); display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: clamp(1.6rem, 4vw, 3.4rem); align-items: center; }
  /* :global because .cmp is rendered inside Compare.astro and carries that
     component's scope attribute, not this one's. */
  .hv-ba-media :global(.cmp) { border-radius: var(--r-lg); }
  .hv-ba-points { list-style: none; margin: 0; padding: 0; }
  .hv-ba-points li { padding: clamp(1rem, 2vw, 1.4rem) 0; }
  .hv-ba-points li:first-child { padding-top: 0; }
  .hv-ba-points li + li { box-shadow: inset 0 1px 0 var(--line); }
  .hv-ba-points h3 { margin: 0 0 .4rem; font-size: 1.02rem; font-weight: 700; color: var(--ink); }
  .hv-ba-points p { margin: 0; font-size: .9rem; line-height: 1.6; color: var(--ink-3); }
  .hv-ba-note { margin: clamp(1.2rem, 2.4vw, 1.8rem) 0 0; padding-top: clamp(1.1rem, 2vw, 1.5rem); box-shadow: inset 0 1px 0 var(--line); font-size: .85rem; line-height: 1.6; color: var(--ink-3); }
  .hv-ba-note a { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 3px; text-decoration-color: var(--line-strong); white-space: nowrap; }
  .hv-ba-note a:hover { text-decoration-color: var(--accent); }
  @media (max-width: 900px) { .hv-ba { grid-template-columns: 1fr; } }

  /* ── the dream ─────────────────────────────────────────────────────────── */
  /* The page's second full-bleed photograph, and the only band with nothing to
     count. The scrim is horizontal rather than the hero's vertical one so the
     photograph stays open on the right where there is no copy over it — the
     picture is the argument, the text just names it. */
  .hv-dream { position: relative; isolation: isolate; overflow: hidden; display: grid; align-items: center; min-height: min(84svh, 44rem); padding-block: clamp(4.5rem, 10vw, 8rem); background: var(--ink-900); }
  .hv-dream-bg { position: absolute; inset: 0; z-index: -2; width: 100%; height: 100%; object-fit: cover; object-position: center 28%; }
  .hv-dream-scrim { position: absolute; inset: 0; z-index: -1; background:
    linear-gradient(90deg, rgb(var(--scrim) / 0.94) 0%, rgb(var(--scrim) / 0.78) 44%, rgb(var(--scrim) / 0.24) 100%); }
  .hv-kicker { margin: 0; font-size: .72rem; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--fill-blue); }
  .hv-dream-h { margin: .9rem 0 0; max-width: 15ch; font-size: var(--t-hero); line-height: .98; letter-spacing: -0.04em; color: var(--paper-on-dark); text-wrap: balance; }
  .hv-dream-lede { margin: clamp(1.2rem, 2.4vw, 1.8rem) 0 0; max-width: 50ch; font-size: var(--t-lg); line-height: 1.6; color: var(--paper-soft-on-dark); }
  .hv-dream .btn { margin-top: clamp(1.6rem, 3vw, 2.2rem); }
  @media (max-width: 700px) {
    .hv-dream-scrim { background: linear-gradient(180deg, rgb(var(--scrim) / 0.60) 0%, rgb(var(--scrim) / 0.92) 55%); }
  }

  /* ── the week you get back ─────────────────────────────────────────────── */
  .hv-week { list-style: none; margin: clamp(2.4rem, 5vw, 3.5rem) 0 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); gap: 1px; background: var(--line); }
  .hv-week > li { background: var(--bg); padding: clamp(1.3rem, 2.4vw, 2rem); }
  .hv-week-d { display: block; font-family: var(--font-display); font-weight: 900; font-size: clamp(1.5rem, 2.4vw, 1.9rem); line-height: 1; letter-spacing: -0.03em; }
  .hv-week p { margin: .9rem 0 0; font-size: .9rem; line-height: 1.6; color: var(--ink-3); }
  .hv-back { margin-top: clamp(2rem, 4vw, 3rem); padding-top: clamp(1.4rem, 2.5vw, 2rem); box-shadow: inset 0 1px 0 var(--line); }
  .hv-back-h { margin: 0 0 clamp(1.2rem, 2.4vw, 1.8rem); font-size: .72rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--ink-3); }
  .hv-back-list { display: grid; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); gap: clamp(1.2rem, 3vw, 2.4rem); margin: 0; }
  .hv-back-list dt { margin: 0; font-size: .95rem; font-weight: 700; color: var(--ink); }
  .hv-back-list dd { margin: .45rem 0 0; font-size: .85rem; line-height: 1.55; color: var(--ink-3); }

  /* ── where the visuals land ────────────────────────────────────────────── */
  .hv-ch { list-style: none; margin: clamp(2.4rem, 5vw, 3.5rem) 0 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); gap: 1px; background: var(--line); }
  .hv-ch > li { background: var(--bg); padding: clamp(1.1rem, 2vw, 1.5rem); display: grid; gap: .35rem; align-content: start; }
  .hv-ch-t { font-size: .95rem; font-weight: 700; color: var(--ink); }
  .hv-ch-n { font-size: .84rem; line-height: 1.5; color: var(--ink-3); }
  .hv-ch-note { margin: 1.4rem 0 0; font-size: .85rem; line-height: 1.6; color: var(--ink-3); }

  /* ── the roster and your brand model ───────────────────────────────────── */
  .hv-bm-band .statement-left { max-width: 46rem; }
  .hv-faces { margin-top: clamp(1.6rem, 3vw, 2.2rem); }
  /* Narrower than the output rail on purpose: a face needs less width than a
     garment, and ten of them at rail width would be a scroll with no end. */
  .hv-faces > * { flex: 0 0 clamp(8.5rem, 14vw, 11.5rem); }
  .hv-face { display: block; color: inherit; }
  .hv-face .plate { display: block; aspect-ratio: 3 / 4; }
  .hv-face .plate img { transition: transform var(--dur-3) var(--ease); }
  .hv-face:hover .plate img { transform: scale(1.03); }
  .hv-face .plate-cap span { text-transform: lowercase; }
  .hv-bm-foot { margin-top: clamp(1.8rem, 3.5vw, 2.6rem); padding-top: clamp(1.4rem, 2.5vw, 2rem); box-shadow: inset 0 1px 0 var(--line); display: flex; gap: clamp(1rem, 3vw, 2.5rem); align-items: center; justify-content: space-between; flex-wrap: wrap; }
  .hv-bm-foot p { margin: 0; max-width: 58ch; font-size: .9rem; line-height: 1.6; color: var(--ink-3); }
  @media (prefers-reduced-motion: reduce) {
    .hv-face .plate img, .hv-face:hover .plate img { transition: none; transform: none; }
  }

  /* ── the three tiers ───────────────────────────────────────────────────── */
  .hv-pr-tiles { margin-top: clamp(2.4rem, 5vw, 4rem); }
  .hv-pr-inc { list-style: none; margin: 1.1rem 0 0; padding: 0; display: grid; gap: .45rem; }
  .hv-pr-inc li { position: relative; padding-left: 1.1rem; font-size: .84rem; line-height: 1.5; color: var(--ink-3); }
  .hv-pr-inc li::before { content: ''; position: absolute; left: 0; top: .55em; width: 6px; height: 1px; background: var(--line-ui); }
  /* The saving line is the plan's whole argument, so it sits apart from the
     inclusions rather than as one more bullet among them. */
  .hv-pr-saving { margin: 1.1rem 0 0; padding-top: .9rem; box-shadow: inset 0 1px 0 var(--line); font-size: .84rem; line-height: 1.5; font-weight: 700; color: var(--ink-2); }
  .hv-pr-foot { margin-top: clamp(1.8rem, 3.5vw, 2.6rem); display: flex; gap: clamp(1rem, 3vw, 2.5rem); align-items: center; justify-content: space-between; flex-wrap: wrap; }
  .hv-pr-foot p { margin: 0; max-width: 62ch; font-size: .9rem; line-height: 1.6; color: var(--ink-3); }

  /* ── planning backwards ────────────────────────────────────────────────── */
  .hv-pl-head { max-width: 42rem; }
  .hv-pl { list-style: none; margin: clamp(2.2rem, 4.5vw, 3.2rem) 0 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); gap: clamp(1.4rem, 3vw, 2.6rem); }
  .hv-pl > li { position: relative; padding-top: 1.6rem; box-shadow: inset 0 1px 0 var(--line); }
  /* One dot per date, sitting on the rule — the closest this system gets to a
     timeline without drawing a connector that would be wrong the moment the
     grid wraps to one column. */
  .hv-pl-dot { position: absolute; top: -4px; left: 0; width: 9px; height: 9px; background: var(--ink-1); }
  .hv-pl h3 { margin: 0 0 .45rem; font-size: 1.02rem; font-weight: 700; }
  .hv-pl p { margin: 0; font-size: .875rem; line-height: 1.6; color: var(--ink-3); }
  .hv-pl-foot { margin-top: clamp(1.8rem, 3.5vw, 2.6rem); display: flex; gap: clamp(1rem, 3vw, 2.5rem); align-items: center; justify-content: space-between; flex-wrap: wrap; }
  .hv-pl-foot p { margin: 0; max-width: 66ch; font-size: .85rem; line-height: 1.6; color: var(--ink-3); }

  /* ── the objections ────────────────────────────────────────────────────── */
  .hv-ob { margin-top: clamp(2.4rem, 5vw, 4rem); display: grid; grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr)); gap: 1px; background: var(--line); }
  .hv-ob-item { background: var(--surface); padding: clamp(1.4rem, 2.6vw, 2.1rem); display: flex; flex-direction: column; }
  .hv-ob-item h3 { margin: 0 0 .7rem; font-size: 1.08rem; font-weight: 700; color: var(--ink); }
  .hv-ob-item p { margin: 0; font-size: .9rem; line-height: 1.6; color: var(--ink-3); }
  .hv-ob-link { margin-top: auto; padding-top: 1.2rem; font-size: .85rem; font-weight: 700; color: var(--accent); }
  .hv-ob-link:hover { color: var(--accent-dim); }

  /* ── faq ───────────────────────────────────────────────────────────────── */
  .hv-faq { margin-top: clamp(2rem, 4vw, 3rem); border-top: 1px solid var(--line); }
  .hv-faq-item { border-bottom: 1px solid var(--line); }
  .hv-faq-item summary { list-style: none; cursor: pointer; display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; padding: 1.1rem 0; font-size: 1rem; font-weight: 700; color: var(--ink); }
  .hv-faq-item summary::-webkit-details-marker { display: none; }
  .hv-faq-item summary:hover { color: var(--accent); }
  .hv-faq-item summary svg { flex: 0 0 auto; width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 1.5; transition: transform var(--dur-2) var(--ease); }
  .hv-faq-item[open] summary svg { transform: rotate(45deg); }
  .hv-faq-a { padding: 0 0 1.3rem; }
  /* :global — an answer carrying {html} is injected with set:html, so its <p>
     and <a> never receive this component's scope attribute. */
  .hv-faq-a :global(p) { margin: 0; font-size: .92rem; line-height: 1.65; color: var(--ink-3); max-width: 64ch; }
  .hv-faq-a :global(a) { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }
  .hv-faq-foot { margin-top: clamp(1.6rem, 3vw, 2.2rem); }
  @media (prefers-reduced-motion: reduce) {
    .hv-faq-item summary svg { transition: none; }
  }

  /* ── closing ───────────────────────────────────────────────────────────── */
  /* The closing panel is the page's one gradient ground — see .panel-grad in
     global.css for what that scope restates and why it has to. The only thing
     added here is the radius: the panel is full-bleed, so it takes corners on
     its top edge alone, where it meets the dark page above it. */
  .hv-close { border-radius: var(--r-lg) var(--r-lg) 0 0; }
</style>

<script>
  // THE RAILS. Both horizontal scrollers on this page — the output rail and the
  // model roster — are native overflow-x with scroll-snap, so they already work
  // by drag, wheel and keyboard with no script at all. This adds the arrows.
  //
  // WHY IT EXISTS AT ALL: the output rail has shipped with a prev/next pair
  // since the page was written and nothing was ever bound to them. They were
  // two dead buttons with aria-labels, which is worse than no buttons — a
  // screen reader announces a control that does nothing. Adding a second rail
  // was the point at which that had to be fixed rather than duplicated.
  //
  // Buttons are found within the rail's own <section>, not as siblings: the
  // head and the rail sit in two different .container wrappers so that the rail
  // can bleed wider than the copy above it.
  function initRails() {
    document.querySelectorAll('[data-rail]:not([data-rail-bound])').forEach((rail) => {
      const scope = rail.closest('section');
      if (!scope) return;
      const prev = scope.querySelector('[data-rail-prev]');
      const next = scope.querySelector('[data-rail-next]');
      if (!prev && !next) return;
      rail.setAttribute('data-rail-bound', '');

      // One card plus one gap, measured rather than assumed — every rail on the
      // site sizes its items in clamp(), so there is no constant to hard-code.
      const step = () => {
        const first = rail.firstElementChild;
        if (!first) return rail.clientWidth * 0.8;
        const gap = parseFloat(getComputedStyle(rail).columnGap || '0') || 0;
        return first.getBoundingClientRect().width + gap;
      };

      // Disable at the ends rather than wrapping around: a rail that jumps back
      // to the start reads as a carousel, and this is a shelf.
      const sync = () => {
        const max = rail.scrollWidth - rail.clientWidth - 2;
        if (prev) prev.disabled = rail.scrollLeft <= 2;
        if (next) next.disabled = rail.scrollLeft >= max;
      };

      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const go = (dir) => rail.scrollBy({ left: dir * step(), behavior: reduce ? 'auto' : 'smooth' });
      if (prev) prev.addEventListener('click', () => go(-1));
      if (next) next.addEventListener('click', () => go(1));
      rail.addEventListener('scroll', sync, { passive: true });
      window.addEventListener('resize', sync);
      sync();
    });
  }

  initRails();
  // ClientRouter swaps the document without reloading, so first paint is not
  // enough — same hook every other init on this site uses.
  document.addEventListener('astro:page-load', initRails);
</script>
