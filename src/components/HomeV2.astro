const c = COPY[lang];
---

{/* ── 1 · HERO ───────────────────────────────────────────────────────────────
    Full-bleed, and the photograph is the only lit thing in the frame. On the
    espresso ground that is not a metaphor: everything above and below it is
    near-black, so the garment is the first colour a visitor sees. */}
<section class="hv-hero">
  <div class="hv-hero-bg">
    <img src="/img/hero-dunes.webp" alt={c.heroAlt} width="2200" height="1228" decoding="sync" fetchpriority="high" transition:name="hero-photo" />
  </div>
  <div class="hv-hero-scrim" aria-hidden="true"></div>
  <div class="container hv-hero-inner">
    <div class="hv-hero-copy">
      <h1 class="hv-h1">{c.h1.map((line, i) => (
        <span class="hv-line">{i === c.h1.length - 1 ? <em>{line}</em> : line}</span>
      ))}</h1>
      <p class="hv-lede">{c.heroLede}</p>
      <div class="hv-cta">
        <a href={lp('/start')} class="btn btn-primary btn-lg">{c.ctaStart}</a>
        <a href={lp('/test-sample')} class="btn btn-ghost btn-lg">{c.ctaSample}</a>
      </div>
    </div>
  </div>
  <div class="hv-plinth">
    <dl class="container hv-plinth-row">
      {c.facts.map(([k, v], i) => (
        <div class={`hv-fact${i === 0 ? ' is-flag' : i === 1 ? ' is-verify' : ''}`}>
          <dt>{k}</dt><dd>{v}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

{/* ── 2 · WHAT A DROP IS ─────────────────────────────────────────────────────
    A statement, then the evidence for it as three tiles of unequal weight on
    one plate. The middle tile is a photograph rather than a claim. */}
<section class="band">
  <div class="container">
    <div class="statement">
      <h2>{c.dropH[0]} <em class="hv-accent">{c.dropH[1]}</em></h2>
      <p class="lede">{c.dropLede}</p>
    </div>
    <div class="tiles hv-drop-tiles">
      <div class="tile s-4">
        <div class="tile-body">
          <p class="tile-k">{c.dropSpecK}</p>
          <p class="tile-v">{c.dropSpecP}</p>
          <p class="hv-tile-sub">{c.dropSpecV}</p>
          <p class="tile-n">{c.dropSpecN}</p>
        </div>
      </div>
      {/* Media bleeds to the tile's edge and the caption sits on it — the one
          gradient the system allows, and it is a legibility plate rather than
          decoration. */}
      <div class="tile s-4">
        <div class="tile-media tile-media-fill">
          <img src="/img/catalog-after.webp" alt={c.dropPlateAlt} width="1800" height="1800" loading="lazy" decoding="async" />
          <span class="tile-cap"><b>{c.dropPlateCap}</b><span>{c.dropPlateSub}</span></span>
        </div>
      </div>
      {/* THE one coloured tile in this grid, and it is on the deadline
          because the deadline is the thing being sold. .on-bright recomputes
          the ink ramp; .tile-c-blue only names the colour. */}
      <div class="tile s-4 on-bright tile-c-blue">
        <div class="tile-body">
          <p class="tile-k">{c.dropWinK}</p>
          <p class="tile-v">{c.dropWinV}</p>
          <p class="tile-n">{c.dropWinN}</p>
        </div>
      </div>
    </div>
  </div>
</section>

{/* ── 3 · THE OUTPUT RAIL ────────────────────────────────────────────────────
    Show the work before the claim. Six real photographs, pushed sideways,
    each one a link to the page that explains it. */}
<section class="band-tight hv-rail-band">
  <div class="container">
    <div class="rail-head">
      <div class="statement statement-left">
        <h2>{c.railH[0]} <em class="hv-accent">{c.railH[1]}</em></h2>
        <p class="lede">{c.railLede}</p>
      </div>
      <div class="rail-nav">
        <button type="button" data-rail-prev aria-label={c.railPrev}><svg viewBox="0 0 24 24"><path d="M15 5 8 12l7 7" /></svg></button>
        <button type="button" data-rail-next aria-label={c.railNext}><svg viewBox="0 0 24 24"><path d="M9 5l7 7-7 7" /></svg></button>
      </div>
    </div>
  </div>
  <div class="container">
    <div class="rail" data-rail>
      {RAIL.map((r, i) => (
        <a class="hv-rail-item" href={lp(r.href)}>
          <span class="plate"><img src={r.src} alt={`${c.railCaps[i][0]} — ${c.railCaps[i][1]}`} width={r.w} height={r.h} loading="lazy" decoding="async" /></span>
          <span class="plate-cap"><b>{c.railCaps[i][0]}</b><span>{c.railCaps[i][1]}</span></span>
        </a>
      ))}
    </div>
  </div>
</section>

{/* ── 4 · THE PIPELINE ───────────────────────────────────────────────────────
    A real ordered sequence, so it is the one place on the page numbers are
    allowed — see DESIGN.md on why 01/02/03 above every section is scaffolding
    and above an actual sequence is not. */}
<section class="band well-deep">
  <div class="container">
    <div class="statement statement-left hv-pipe-head">
      <h2>{c.pipeH}</h2>
      <p class="lede">{c.pipeLede}</p>
    </div>
    <ol class="hv-pipe">
      {c.pipe.map(([t, b], i) => (
        <li>
          <span class={`hv-pipe-n ${['s-blue', 's-violet', 's-pink', 's-coral'][i] || ''}`}>{String(i + 1).padStart(2, '0')}</span>
          <h3>{t}</h3>
          <p>{b}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

{/* ── 5 · WHAT IT REPLACES — the one paper interruption on this page ─────────
    A paper band has to earn itself: this is a specification the reader has to
    sit with and compare, which is reading rather than looking. Two figures,
    itemised, no invented per-line euros. */}
<section class="band on-paper">
  <div class="container">
    <div class="statement">
      <h2>{c.vsH}</h2>
      <p class="lede">{c.vsLede}</p>
