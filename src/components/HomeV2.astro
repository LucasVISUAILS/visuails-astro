const c = COPY[lang];

// The five questions the FAQ band shows, picked one group at a time rather
// than sliced off the front of the flattened list. Two reasons: the front of
// the list is all "getting started", which is the one thing a visitor who has
// scrolled this far no longer needs; and the "rights and usage" group is
// deliberately left out because the objection band above it already answers
// those in full — a page that asks the same question twice reads as padding.
const FAQ_GROUPS = faqPageGroups(lang);
const FAQ_PICK = [
  FAQ_GROUPS[0]?.items[0],
  FAQ_GROUPS[0]?.items[1],
  FAQ_GROUPS[1]?.items[0],
  FAQ_GROUPS[2]?.items[0],
  FAQ_GROUPS[3]?.items[0],
].filter(Boolean);
