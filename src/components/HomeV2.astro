        </div>
        <div class="ph" style="--ph-ratio: 16 / 10">
          <div>
            <p class="ph-label">{c.dashPortalPh}</p>
            <p class="ph-note">{c.dashPortalNote}</p>
            <p class="ph-spec">{c.dashPortalSpec}</p>
          </div>
        </div>
      </div>

      <div class="hv-dash-row is-flip">
        <div class="hv-dash-copy">
          <h3>{c.dashStudioK}</h3>
          <p>{c.dashStudioN}</p>
          <a class="btn btn-ghost" href={lp('/studio')}>{c.dashStudioCta}</a>
        </div>
        <div class="ph" style="--ph-ratio: 16 / 10">
          <div>
            <p class="ph-label">{c.dashStudioPh}</p>
            <p class="ph-note">{c.dashStudioNote}</p>
            <p class="ph-spec">{c.dashStudioSpec}</p>
