      <div class="hv-dash-log">
        <h3>{c.dashLogK}</h3>
        <p>{c.dashLogN}</p>
        <a class="btn btn-ghost" href={lp('/ai-act')}>{c.dashLogCta}</a>
      </div>
    </div>
  </div>
</section>

{/* ── 8 · STATS ─────────────────────────────────────────────────────────────
    Every figure is about this studio's own operation. A number describing a
    client's business is a testimonial and there are none. */}
<section class="band-tight">
  <div class="container">
    <h2 class="hv-stats-h">{c.statsH}</h2>
    <dl class="hv-stats">
      {/* One hue per figure, in the palette's own order. OPP does exactly
          this and it is the cheapest colour on the page: no fill, no plate,
          just the number carrying it. The labels stay muted so the figure is
          what the eye lands on. All four measure 7.91–8.07:1 on this ground —
          see the --fill-* note in global.css. */}
      {c.stats.map(([n, l], i) => (
        <div class="hv-stat">
          <dt class={['w-blue', 'w-violet', 'w-coral', 'w-pink'][i] || ''}>{n}</dt>
          <dd>{l}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

{/* ── 9 · THE PROMISE ────────────────────────────────────────────────────────
    Lit by the WebGL chrome field. .hero-fallback carries the same scene when
    the shader never initialises, which is what makes the material removable
    rather than load-bearing. */}
<section class="ch ch-promise band">
  <div class="hero-fallback" aria-hidden="true"></div>
  <canvas id="hero-shader" aria-hidden="true"></canvas>
  <div class="container">
    <div class="hv-promise">
      <div>
        <h2 class="hv-promise-h"><span>{c.promiseH[0]}</span><span class="dim">{c.promiseH[1]}</span></h2>
        <p class="hv-quote">{c.promiseQuote}</p>
        <p class="hv-sign"><strong>Lucas</strong> · {c.promiseSign}</p>
      </div>
      <ul class="hv-checks">
        {c.promiseChecks.map(([t, b]) => (
          <li>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 6L9 17l-5-5" /></svg>
            <span><strong>{t}</strong> — {b}</span>
          </li>
        ))}
      </ul>
    </div>
    <ul class="hv-trust">{c.trust.map((t) => (<li>{t}</li>))}</ul>
  </div>
</section>

{/* ── 10 · CLOSING ─────────────────────────────────────────────────────────── */}
<section class="band-tall hv-close panel-grad">
  <div class="container closing">
    <div>
      <h2>{c.closeH}</h2>
      <p class="lede">{c.closeLede}</p>
      <div class="statement actions">
        <a href={lp('/test-sample')} class="btn btn-primary btn-lg">{c.closeCta}</a>
        <a href={lp('/start')} class="btn btn-ghost btn-lg">{c.closeAlt}</a>
      </div>
    </div>
  </div>
</section>

<style>
  /* ── hero ───────────────────────────────────────────────────────────────
     100svh, not 100vh: on iOS the URL bar makes vh taller than the visible
     area, so a "full height" hero puts its own bottom edge under the browser
     chrome and the plinth is the thing that disappears. */
  /* padding-block is reset explicitly: global.css gives every <section> a
     clamp(4.5rem, 9vw, 9rem) block padding, and on a full-bleed hero that
     lands as 130px of dead photograph under the plinth — measured, not
     guessed. A hero is not a band and does not take a band's rhythm. */
  .hv-hero { position: relative; min-height: 100svh; display: flex; flex-direction: column; overflow: hidden; margin-top: -76px; padding: 76px 0 0; isolation: isolate; background: var(--ink-900); }
  .hv-hero-bg { position: absolute; inset: 0; z-index: -2; }
  .hv-hero-bg img { width: 100%; height: 100%; object-fit: cover; object-position: center 26%; }
  /* Two layers doing two jobs. The radial is the plate under the headline;
     the linear darkens the band the sticky nav stands on and lifts the foot
     so the plinth reads as a solid rail rather than as a floating strip. */
  .hv-hero-scrim { position: absolute; inset: 0; z-index: -1; background:
    radial-gradient(92% 82% at 16% 84%, rgb(var(--scrim) / 0.90) 0%, rgb(var(--scrim) / 0.42) 54%, transparent 78%),
    linear-gradient(180deg, rgb(var(--scrim) / 0.76) 0%, rgb(var(--scrim) / 0.50) 13%, rgb(var(--scrim) / 0.14) 27%, transparent 52%, rgb(var(--scrim) / 0.46) 84%, rgb(var(--scrim) / 0.66) 100%); }
  .hv-hero-inner { flex: 1; display: flex; align-items: flex-end; width: 100%; }
  .hv-hero-copy { max-width: 40rem; padding-block: 3rem clamp(2.5rem, 6vh, 4rem); }
  .hv-h1 { font-size: var(--t-hero); line-height: 0.98; letter-spacing: -0.04em; margin: 0; color: var(--paper-on-dark); }
  .hv-line { display: block; }
  .hv-h1 em { font-family: var(--font-editorial); font-style: italic; font-weight: 700; }
  .hv-lede { margin: clamp(1.2rem, 2.4vw, 1.9rem) 0 0; max-width: 46ch; font-size: var(--t-lg); line-height: 1.55; color: var(--paper-soft-on-dark); }
  .hv-cta { display: flex; gap: .75rem; flex-wrap: wrap; margin-top: clamp(1.6rem, 3vw, 2.2rem); }
  @media (max-width: 560px) { .hv-cta > .btn { width: 100%; } }

  /* The plinth: three facts that are true before anyone talks to us. Ink at
     0.86 rather than a lower alpha because it sits on a photograph whose
     brightest pixel is not ours to choose. */
  .hv-plinth { position: relative; background: rgb(var(--scrim) / 0.86); box-shadow: inset 0 1px 0 var(--line-strong); }
  .hv-plinth-row { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(1rem, 3vw, 3rem); margin: 0; padding-block: 1.15rem 1.35rem; }
  .hv-fact dt { font-size: .68rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--paper-muted-on-dark); margin: 0; }
  .hv-fact dd { margin: .35rem 0 0; font-size: .86rem; line-height: 1.4; color: var(--paper-on-dark); }
  /* Colour as a rule under one fact the copy already states, never as a fill —
     a delivery window is Flag, a review claim is Verify. */
  .hv-fact.is-flag dd, .hv-fact.is-verify dd { display: inline-block; border-bottom: 3px solid; padding-bottom: .18rem; }
  .hv-fact.is-flag dd { border-color: var(--clay); }
  .hv-fact.is-verify dd { border-color: var(--teal); }
  @media (max-width: 760px) {
    .hv-plinth-row { grid-template-columns: 1fr; gap: .9rem; }
    /* The WhatsApp launcher is position: fixed at bottom-left, and the plinth
       is the bottom of a 100svh hero — so on a phone they occupy the same
       pixels on first paint and the launcher sat on top of the third fact.
       48px launcher + its 12px inset + a little air. Measured, not padded by
       feel. */
    .hv-plinth-row { padding-bottom: 5.25rem; }
  }

  /* ── the one accent word ────────────────────────────────────────────────
     Teal is spent on the primary action and one headline word. On the dark
     ground --teal-text is unreadable, so the highlight is carried by full
     paper against the soft paper the rest of the line runs at — value rather
     than hue, which is the same idea in the material the ground allows. */
  /* The accent word in a section heading. It was paper-on-paper — the same
     white as the rest of the line, so "accent" meant italics-turned-off and
     nothing else. It is the palette's blue now, which is what OPP does with
     the word that carries the sentence. */
  .hv-accent { font-style: normal; color: var(--fill-blue); }


  /* ── tiles ─────────────────────────────────────────────────────────────── */
  .hv-tile-sub { margin: .45rem 0 0; font-size: .9rem; color: var(--ink-2); }
  /* Declared AFTER .hv-tile-v, which also sets colour at the same specificity —
     source order is the whole difference and it silently made the one clay
     moment on the page render as paper. §7 holds clay to one stat or one chip
     at a time; on this page it is the window figure and the €0.99. */
  .tile-v.hv-clay, .hv-stat dt.hv-clay { color: var(--clay); }
  .on-paper .tile-v.hv-clay, .on-paper .hv-stat dt.hv-clay { color: var(--clay-text); }
  .hv-drop-tiles, .hv-made-tiles { margin-top: clamp(2.4rem, 5vw, 4rem); }

  /* ── rail ──────────────────────────────────────────────────────────────── */
  .hv-rail-band .rail-head { align-items: flex-end; }
  .hv-rail-band .statement-left { max-width: 34rem; }
  .hv-rail-item { display: block; color: inherit; }
  .hv-rail-item .plate { display: block; aspect-ratio: 4 / 5; }
  .hv-rail-item:hover .plate img { transform: scale(1.02); }
  .hv-rail-item .plate img { transition: transform var(--dur-3) var(--ease); }
  @media (prefers-reduced-motion: reduce) { .hv-rail-item .plate img { transition: none; } .hv-rail-item:hover .plate img { transform: none; } }
  @media (max-width: 700px) {
    .rail-nav { display: none; }
    /* Two cards fit inside 390px, separated by the rail's 1px rule — which
       put one item's caption hard against the next item's label with nothing
       between them but a hairline. One and a bit cards is the right number on
       a phone: it shows there is more without pretending to show it. The
       caption stacks as well, because a label and a note side by side inside
       a 15rem card is two columns of two words. */
    .rail > * { flex-basis: 74vw; }
    .plate-cap { flex-direction: column; gap: .15rem; }
  }

  /* ── pipeline ──────────────────────────────────────────────────────────── */
  .hv-pipe-head { max-width: 40rem; }
  .hv-pipe { list-style: none; margin: clamp(2.4rem, 5vw, 3.5rem) 0 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); gap: 1px; background: var(--line); }
  .hv-pipe > li { background: var(--bg); padding: clamp(1.25rem, 2.2vw, 1.9rem); }
  /* Outlined numerals: the colour is the STROKE, because a filled 2.4rem 900
     numeral in four hues would out-shout the step it labels. The four are
     7.91–8.07:1 on this ground, well past the 3:1 a large glyph needs. */
  .hv-pipe-n { font-family: var(--font-display); font-weight: 900; font-size: 2.4rem; line-height: 1; color: transparent; -webkit-text-stroke: 1.5px var(--line-ui); display: block; }
  .hv-pipe-n.s-blue   { -webkit-text-stroke-color: var(--fill-blue); }
  .hv-pipe-n.s-violet { -webkit-text-stroke-color: var(--fill-violet); }
  .hv-pipe-n.s-pink   { -webkit-text-stroke-color: var(--fill-pink); }
  .hv-pipe-n.s-coral  { -webkit-text-stroke-color: var(--fill-coral); }
  .hv-pipe h3 { margin: 1rem 0 .45rem; font-size: 1.02rem; font-weight: 700; color: var(--ink); }
  .hv-pipe p { margin: 0; font-size: .875rem; line-height: 1.55; color: var(--ink-3); }

  /* ── the comparison ────────────────────────────────────────────────────── */
  .hv-vs { display: grid; grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr)); gap: 1px; background: var(--line); margin-top: clamp(2.4rem, 5vw, 3.5rem); }
  .hv-vs-col { background: var(--bg); padding: clamp(1.4rem, 2.6vw, 2.2rem); }
  .hv-vs-col.is-drop { background: var(--surface); }
  .hv-vs-list { list-style: none; margin: 1.2rem 0 0; padding: 0; display: grid; gap: .5rem; }
  .hv-vs-list li { position: relative; padding-left: 1.1rem; font-size: .875rem; line-height: 1.5; color: var(--ink-2); }
  .hv-vs-list li::before { content: ''; position: absolute; left: 0; top: .55em; width: 6px; height: 1px; background: var(--line-ui); }
  .hv-vs-note { margin: 1.4rem 0 0; font-size: .85rem; line-height: 1.6; color: var(--ink-3); max-width: 64ch; }
  .hv-vs-note a { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 3px; text-decoration-color: var(--line-strong); }
  .hv-vs-note a:hover { text-decoration-color: var(--accent); }

  /* ── the four deliverables ─────────────────────────────────────────────── */
  .hv-made-tile { color: inherit; transition: background var(--dur-1) var(--ease); }
  .hv-made-tile:hover { background: var(--bg-raise); }
  .hv-made-media { aspect-ratio: 4 / 3; }
  .hv-made-media img { transition: transform var(--dur-3) var(--ease); }
  .hv-made-tile:hover .hv-made-media img { transform: scale(1.03); }
  @media (prefers-reduced-motion: reduce) {
    .hv-made-media img, .hv-made-tile:hover .hv-made-media img { transition: none; transform: none; }
  }

  /* ── the dashboard band ────────────────────────────────────────────────── */
  .hv-dash { margin-top: clamp(2.6rem, 5vw, 4rem); display: grid; gap: 1px; background: var(--line); }
  .hv-dash-row { background: var(--bg); display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(1.5rem, 3vw, 3rem); align-items: center; padding: clamp(1.5rem, 3vw, 2.6rem); }
  .hv-dash-row.is-flip .hv-dash-copy { order: 2; }
  .hv-dash-copy h3 { margin: 0 0 .7rem; font-size: var(--t-h3); font-weight: 700; color: var(--ink); }
  .hv-dash-copy p { margin: 0 0 1.3rem; font-size: .95rem; line-height: 1.6; color: var(--ink-2); max-width: 46ch; }
  .hv-dash-log { background: var(--bg); padding: clamp(1.5rem, 3vw, 2.6rem); }
  .hv-dash-log h3 { margin: 0 0 .7rem; font-size: var(--t-h3); font-weight: 700; color: var(--ink); }
  .hv-dash-log p { margin: 0 0 1.3rem; font-size: .95rem; line-height: 1.6; color: var(--ink-2); max-width: 68ch; }
  @media (max-width: 820px) {
    .hv-dash-row { grid-template-columns: 1fr; }
    .hv-dash-row.is-flip .hv-dash-copy { order: 0; }
  }

  /* ── stats ─────────────────────────────────────────────────────────────── */
  .hv-stats-h { font-size: var(--t-h3); font-weight: 700; margin: 0 0 clamp(1.6rem, 3vw, 2.4rem); max-width: 30ch; color: var(--ink); }
  .hv-stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0; margin: 0; }
  .hv-stat { padding: 0 clamp(1rem, 2vw, 1.8rem); }
  .hv-stat:first-child { padding-left: 0; }
  .hv-stat + .hv-stat { border-left: 1px solid var(--line); }
  .hv-stat dt { font-family: var(--font-display); font-weight: 900; font-size: clamp(2.4rem, 4.2vw, 3.125rem); line-height: 1; letter-spacing: -0.035em; color: var(--ink); font-variant-numeric: tabular-nums lining-nums; }
  /* The coloured figure, set HERE rather than relying on the global .w-*
     utility. Astro scopes this block with a [data-astro-cid] attribute, so
     `.hv-stat dt` renders as (0,3,1) and outranks any global class utility no
     matter how many times it is doubled. A scoped stylesheet always wins; the
     override has to live in the same scope that caused the conflict. */
  .hv-stat dt.w-blue   { color: var(--fill-blue); }
  .hv-stat dt.w-violet { color: var(--fill-violet); }
  .hv-stat dt.w-pink   { color: var(--fill-pink); }
  .hv-stat dt.w-coral  { color: var(--fill-coral); }
  .hv-stat dd { margin: .75rem 0 0; font-size: .875rem; line-height: 1.5; color: var(--ink-3); max-width: 26ch; }
  @media (max-width: 880px) {
    .hv-stats { grid-template-columns: repeat(2, 1fr); row-gap: clamp(1.6rem, 4vw, 2.4rem); }
    .hv-stat:nth-child(odd) { padding-left: 0; border-left: 0; }
  }
  @media (max-width: 460px) {
    .hv-stats { grid-template-columns: 1fr; }
    .hv-stat { padding: 0; border-left: 0; }
    .hv-stat + .hv-stat { padding-top: 1.4rem; border-top: 1px solid var(--line); }
  }

  /* ── the promise ───────────────────────────────────────────────────────── */
  .hv-promise { display: grid; grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr)); gap: clamp(2rem, 5vw, 4rem); align-items: start; }
  .hv-promise-h { font-size: var(--t-h2); line-height: 1.05; letter-spacing: -0.035em; margin: 0; }
  .hv-promise-h span { display: block; }
  .hv-promise-h .dim { color: var(--ink-3); }
  .hv-quote { font-family: var(--font-editorial); font-style: italic; font-weight: 500; font-size: clamp(1.15rem, 1.9vw, 1.45rem); line-height: 1.45; color: var(--ink); margin: 1.4rem 0 0; max-width: 40ch; }
  .hv-sign { margin: 1rem 0 0; font-size: .875rem; color: var(--ink-3); }
  .hv-sign strong { color: var(--ink-2); }
  .hv-checks { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.1rem; }
  .hv-checks li { display: grid; grid-template-columns: 20px 1fr; gap: .75rem; font-size: .9rem; line-height: 1.55; color: var(--ink-3); }
  .hv-checks strong { color: var(--ink); }
  .hv-checks svg { width: 18px; height: 18px; margin-top: .18rem; fill: none; stroke: var(--ink-2); stroke-width: 2; }
  .hv-trust { list-style: none; display: flex; flex-wrap: wrap; gap: .5rem 1.8rem; margin: clamp(2.2rem, 4vw, 3rem) 0 0; padding: clamp(1.4rem, 2.5vw, 2rem) 0 0; box-shadow: inset 0 1px 0 var(--line); font-size: .82rem; color: var(--ink-3); }

  /* ── closing ───────────────────────────────────────────────────────────── */
  /* The closing panel is the page's one gradient ground — see .panel-grad in
     global.css for what that scope restates and why it has to. The only thing
     added here is the radius: the panel is full-bleed, so it takes corners on
     its top edge alone, where it meets the dark page above it. */
  .hv-close { border-radius: var(--r-lg) var(--r-lg) 0 0; }
</style>
