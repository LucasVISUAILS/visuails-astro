<style>
  /* ── hero ───────────────────────────────────────────────────────────────
     100svh, not 100vh: on iOS the URL bar makes vh taller than the visible
     area, so a "full height" hero puts its own bottom edge under the browser
     chrome and the plinth is the thing that disappears. */
  /* padding-block is reset explicitly: global.css gives every <section> a
     clamp(4.5rem, 9vw, 9rem) block padding, and on a full-bleed hero that
     lands as 130px of dead photograph under the plinth — measured, not
     guessed. A hero is not a band and does not take a band's rhythm. */
  .hv-hero { position: relative; min-height: 100svh; display: flex; flex-direction: column; overflow: hidden; margin-top: -76px; padding: 76px 0 0; isolation: isolate; background: var(--ink-900); }
  .hv-hero-bg { position: absolute; inset: 0; z-index: -2; }
  .hv-hero-bg img { width: 100%; height: 100%; object-fit: cover; object-position: center 26%; }
  /* Two layers doing two jobs. The radial is the plate under the headline;
     the linear darkens the band the sticky nav stands on and lifts the foot
     so the plinth reads as a solid rail rather than as a floating strip. */
  .hv-hero-scrim { position: absolute; inset: 0; z-index: -1; background:
    radial-gradient(92% 82% at 16% 84%, rgb(var(--scrim) / 0.90) 0%, rgb(var(--scrim) / 0.42) 54%, transparent 78%),
    linear-gradient(180deg, rgb(var(--scrim) / 0.76) 0%, rgb(var(--scrim) / 0.50) 13%, rgb(var(--scrim) / 0.14) 27%, transparent 52%, rgb(var(--scrim) / 0.46) 84%, rgb(var(--scrim) / 0.66) 100%); }
  .hv-hero-inner { flex: 1; display: flex; align-items: flex-end; width: 100%; }
  .hv-hero-copy { max-width: 40rem; padding-block: 3rem clamp(2.5rem, 6vh, 4rem); }
  .hv-h1 { font-size: var(--t-hero); line-height: 0.98; letter-spacing: -0.04em; margin: 0; color: var(--paper-on-dark); }
  .hv-line { display: block; }
  .hv-h1 em { font-family: var(--font-editorial); font-style: italic; font-weight: 700; }
  .hv-lede { margin: clamp(1.2rem, 2.4vw, 1.9rem) 0 0; max-width: 46ch; font-size: var(--t-lg); line-height: 1.55; color: var(--paper-soft-on-dark); }
  .hv-cta { display: flex; gap: .75rem; flex-wrap: wrap; margin-top: clamp(1.6rem, 3vw, 2.2rem); }
  @media (max-width: 560px) { .hv-cta > .btn { width: 100%; } }

  /* The plinth: three facts that are true before anyone talks to us. Ink at
     0.86 rather than a lower alpha because it sits on a photograph whose
     brightest pixel is not ours to choose. */
  .hv-plinth { position: relative; background: rgb(var(--scrim) / 0.86); box-shadow: inset 0 1px 0 var(--line-strong); }
  .hv-plinth-row { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(1rem, 3vw, 3rem); margin: 0; padding-block: 1.15rem 1.35rem; }
  .hv-fact dt { font-size: .68rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--paper-muted-on-dark); margin: 0; }
  .hv-fact dd { margin: .35rem 0 0; font-size: .86rem; line-height: 1.4; color: var(--paper-on-dark); }
  /* Colour as a rule under one fact the copy already states, never as a fill —
     a delivery window is Flag, a review claim is Verify. */
  .hv-fact.is-flag dd, .hv-fact.is-verify dd { display: inline-block; border-bottom: 3px solid; padding-bottom: .18rem; }
  .hv-fact.is-flag dd { border-color: var(--clay); }
  .hv-fact.is-verify dd { border-color: var(--teal); }
  @media (max-width: 760px) {
    .hv-plinth-row { grid-template-columns: 1fr; gap: .9rem; }
    /* The WhatsApp launcher is position: fixed at bottom-left, and the plinth
       is the bottom of a 100svh hero — so on a phone they occupy the same
       pixels on first paint and the launcher sat on top of the third fact.
       48px launcher + its 12px inset + a little air. Measured, not padded by
       feel. */
    .hv-plinth-row { padding-bottom: 5.25rem; }
  }

  /* ── the one accent word ────────────────────────────────────────────────
     Teal is spent on the primary action and one headline word. On the dark
     ground --teal-text is unreadable, so the highlight is carried by full
     paper against the soft paper the rest of the line runs at — value rather
     than hue, which is the same idea in the material the ground allows. */
  /* The accent word in a section heading. It was paper-on-paper — the same
     white as the rest of the line, so "accent" meant italics-turned-off and
     nothing else. It is the palette's blue now, which is what OPP does with
     the word that carries the sentence. */
  .hv-accent { font-style: normal; color: var(--fill-blue); }


  /* ── tiles ─────────────────────────────────────────────────────────────── */
  .hv-tile-sub { margin: .45rem 0 0; font-size: .9rem; color: var(--ink-2); }
  /* Declared AFTER .hv-tile-v, which also sets colour at the same specificity —
     source order is the whole difference and it silently made the one clay
     moment on the page render as paper. §7 holds clay to one stat or one chip
     at a time; on this page it is the window figure and the €0.99. */
  .tile-v.hv-clay, .hv-stat dt.hv-clay { color: var(--clay); }
  .on-paper .tile-v.hv-clay, .on-paper .hv-stat dt.hv-clay { color: var(--clay-text); }
  .hv-drop-tiles, .hv-made-tiles { margin-top: clamp(2.4rem, 5vw, 4rem); }

  /* ── rail ──────────────────────────────────────────────────────────────── */
  .hv-rail-band .rail-head { align-items: flex-end; }
  .hv-rail-band .statement-left { max-width: 34rem; }
  .hv-rail-item { display: block; color: inherit; }
  .hv-rail-item .plate { display: block; aspect-ratio: 4 / 5; }
  .hv-rail-item:hover .plate img { transform: scale(1.02); }
  .hv-rail-item .plate img { transition: transform var(--dur-3) var(--ease); }
  @media (prefers-reduced-motion: reduce) { .hv-rail-item .plate img { transition: none; } .hv-rail-item:hover .plate img { transform: none; } }
  @media (max-width: 700px) {
    .rail-nav { display: none; }
    /* Two cards fit inside 390px, separated by the rail's 1px rule — which
       put one item's caption hard against the next item's label with nothing
       between them but a hairline. One and a bit cards is the right number on
       a phone: it shows there is more without pretending to show it. The
       caption stacks as well, because a label and a note side by side inside
       a 15rem card is two columns of two words. */
    .rail > * { flex-basis: 74vw; }
    .plate-cap { flex-direction: column; gap: .15rem; }
  }

  /* ── pipeline ──────────────────────────────────────────────────────────── */
  .hv-pipe-head { max-width: 40rem; }
  .hv-pipe { list-style: none; margin: clamp(2.4rem, 5vw, 3.5rem) 0 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); gap: 1px; background: var(--line); }
  .hv-pipe > li { background: var(--bg); padding: clamp(1.25rem, 2.2vw, 1.9rem); }
  /* Outlined numerals: the colour is the STROKE, because a filled 2.4rem 900
     numeral in four hues would out-shout the step it labels. The four are
     7.91–8.07:1 on this ground, well past the 3:1 a large glyph needs. */
  .hv-pipe-n { font-family: var(--font-display); font-weight: 900; font-size: 2.4rem; line-height: 1; color: transparent; -webkit-text-stroke: 1.5px var(--line-ui); display: block; }
  .hv-pipe-n.s-blue   { -webkit-text-stroke-color: var(--fill-blue); }
  .hv-pipe-n.s-violet { -webkit-text-stroke-color: var(--fill-violet); }
  .hv-pipe-n.s-pink   { -webkit-text-stroke-color: var(--fill-pink); }
