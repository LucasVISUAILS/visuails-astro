  .hv-ob-foot { margin-top: clamp(1.8rem, 3.5vw, 2.6rem); padding-top: clamp(1.4rem, 2.5vw, 2rem); box-shadow: inset 0 1px 0 var(--line); display: flex; gap: clamp(1rem, 3vw, 2.5rem); align-items: center; justify-content: space-between; flex-wrap: wrap; }
  .hv-ob-foot p { margin: 0; max-width: 60ch; font-size: .85rem; line-height: 1.6; color: var(--ink-3); }
