  /* ── EEN PAUZE DIE DE BALK BEVRIEST IN PLAATS VAN HEM TE WISSEN ────────────
   *
   * Hier stond `bar.classList.remove('is-running')` bij élke herteken-beurt, en
   * dat zette de balk terug op scaleX(0). Bij een pauze verdween hij dus, en bij
   * het hervatten begon hij overnieuw — terwijl er misschien nog maar een
   * seconde van de zeven over was. Een voortgangsbalk die bij een pauze op nul
   * springt, liegt over hoeveel tijd er nog is, en dat is erger dan geen balk.
   *
   * `animation-play-state` bevriest hem waar hij staat en laat hem verdergaan
   * waar hij gebleven was. De JS-timer moet dat volgen, en dat is waar
   * `resterend` voor is: bij het parkeren wordt afgetrokken wat er verstreken
   * is, bij het hervatten loopt de timeout nog precies zo lang als de balk. */
  function balkStand(staat) {
    var b = balk(nu);
    if (b) b.style.animationPlayState = staat;
  }

  /* Een verse balk voor een nieuwe dia. De reflow ertussen is nodig: zonder het
     lezen van offsetWidth voegt de browser het weghalen en terugzetten samen en
     herstart de animatie niet. */
  function balkOpnieuw(i) {
    tabs.forEach(function (t, k) {
      var b = balk(k);
      if (!b) return;
      b.classList.remove('is-running');
      b.style.animationPlayState = '';
      if (k === i && !gestopt && !geparkeerd && !rust.matches) {
        void b.offsetWidth;
        b.classList.add('is-running');
      }
    });
