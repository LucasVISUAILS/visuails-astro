---
/**
 * VISUAILS — de opening van de voorpagina met de scrollvideo, en "Hoe het werkt" in
 * hetzelfde scherm. 25 oktober 2026 (levering 74), opnieuw ingedeeld in levering 75.
 * ═══════════════════════════════════════════════════════════════════════════════
 *
 * Lucas (25 oktober, 12:17): *"Ik wil de begin sectie pagina een andere indeling geven
 * zoals het bijgevoegde voorbeeld. Ik heb dan ook een video hiervan die ik als scroll
 * animatie op de beginsectie wil hebben … Nadat de laptop en telefoon weg zijn wil ik dat
 * het lijkt alsof je niet omlaag hebt gescrollt maar nog steeds op de eerste pagina staat
 * en de "How it works" uitleg naar boven komt."* Het plan staat in
 * kladblok/PLAN-OPENING-SCROLL.md, de leveringen in kladblok/LEVERING-74.md en -75.md.
 *
 * LEVERING 75 (Lucas, 25 oktober, 23:35): *"De home pagina voelt nu te druk. Ik wil de foto
 * groot maar wel gecentreerd, goed in verhouding en niet dat het het hele beeld vult en zet
 * de kop eronder niet ernaast. Daarnaast zijn de mogelijkheden van de laptop en het wisselen
 * van scherm (zoals het instagram voorbeeld mockup) verdwenen … ik wil dit terug. … Het "how
 * it works" gedeelte mag ook wel wat compacter en mag smooth overlopen met de laptop animatie
 * dus dat die sectie mooi tijdens dat de laptop verdwijnt al licht te zien is en erin snapt
 * waardoor het echt voelt als 1 pagina."* Zijn keuzes daarna: de kop links, op de rand van
 * de foto; de armen lopen door tot de rand van het venster.
 *
 * DE INDELING (één, op elk scherm; opening.css rekent hem uit, zonder script al goed):
 *   - Het beeld is de video over de hele breedte (scripts/opening-reeks.py), met de armen
 *     doorgetrokken tot 720 videopixels links en rechts. De apparaten staan in het midden, op
 *     hoogstens 58 % van de breedte van het venster, en zo groot als er boven de kop past.
 *   - De bovenkant van de laptop net onder de balk, de kop eronder: links op de rand van de
 *     laptop, tot de rechterrand van de telefoon, op één regel (gemeten in de browser).
 *   - Eronder de zin, en rechts daarvan de standen van de schermen: de webshop met de vier
 *     catalogbeelden, het Instagram-bericht met de vier lifestylebeelden, de clip. Met de
 *     streep (de klok), vorige en volgende, en pauze; dezelfde reeks als de laptop vóór 74.
 *
 * LEVERING 76 (Lucas, 26 oktober): *"Past de laptop en kop wel samen in 1 beeld. Voor mijn
 * gevoel is het nog krap."* Meer lucht en de apparaten op hoogstens 48 % (opening.css). En
 * *"een effect dat wanneer je scrollt de tekst weg word gesneden op een VISUAILS style manier
 * tijdens dat de laptop ook verdwijnt en dan heel kort wit scherm dan komt de tekst op de
 * nieuwe plek terecht met een soortgelijk effect en komen de elementen tevoorschijn."*
 *
 * HOE HET WERKT, IN VOLGORDE VAN DE SCROLL (één weg van 1,6 schermhoogte, u van 0 tot 1)
 *   0       Het rustbeeld: de still met de schermen van de stand die er staat.
 *   0–.70   De video: beeld 17 – 133 op een canvas, de schermen per beeld op hun hoeken.
 *   .36–.56 Eén snede op 53° gaat door kop, zin en standen (links ervan is weg), met een dunne
 *           lijn in het wit erachter, terwijl de apparaten het beeld uit schuiven.
 *   .52–.66 Het beeld lost op. Tot .72 is het scherm even wit.
 *   .72–.84 Dezelfde snede legt het label ("Zonder shoot") en de kop van Hoe het werkt bloot;
 *           dan gaat het vlagje van het label aan als een tl-buis.
 *   .80–.96 De tabs, de blokken en de balk eronder verschijnen, kort na elkaar. Dan de stop:
 *           het voelt als één pagina. Daarna gewoon verder scrollen.
 *
 * ZONDER SCRIPT, BIJ MINDER BEWEGING, OP DE TELEFOON (< 900 px) EN OP EEN SCHERM DAT TE LAAG
 * IS VOOR DE BLOKKEN: geen scrollvideo. Dezelfde opening, en Hoe het werkt gewoon eronder.
 */
import '../styles/opening.css';
import SCHERMEN from '../data/openingSchermen.json';
import { openingStanden } from '../data/openingStanden.js';
import { laptopReeks } from '../data/laptopSlides.js';
import { ikoon, IKOON } from '../data/iconen.js';

interface Props {
  lang: 'en' | 'nl';
  kop: { lines: string[]; plain: string };
  lede: string;
  hoeKop: [string, string];
  /** de uitleg speelt (data-uitleg, UitlegBalk.astro) */
  uitleg?: boolean;
}
const { lang, kop, lede, hoeKop, uitleg = false } = Astro.props as Props;
const nl = lang === 'nl';
const kaal = (s: string) => s.replace(/<[^>]+>/g, '');
/* De kop is "Al je productbeelden. Zonder shoot.": de laatste regel is het accentwoord.
   Die regel is ook het label boven Hoe het werkt, zonder de punt. */
const voor = kop.lines.slice(0, -1).map(kaal).join(' ');
const accent = kaal(kop.lines[kop.lines.length - 1]);
const label = accent.replace(/[.!?]$/, '');
/* Per dienst de tijden van de drie stappen (UitlegBalk leest ze bij elke start): catalog
   heeft in stap 2 alleen de lagen in 3D (5,2 s; levering 75, eerst 12,9 s met het handwerk),
   lifestyle en video een upload (3 s). */
const TABS = [['catalog', 'Catalog', '2250 5200 2250'], ['lifestyle', 'Lifestyle', '2250 3000 2250'], ['video', 'Video', '2250 3000 2250']] as const;
const kies = nl ? 'Kies wat je wilt zien' : 'Pick what you want to see';

/* ── de maten van het rustbeeld, als deel van de breedte van het beeld ──
   Uit beeld 0 (openingSchermen.json, in pixels van de reeks): de bovenkant van de laptop, de
   linkerrand van de laptop, de rechterrand van de telefoon en de onderkant van de linkerhand.
   opening.css zet er het beeld en de kop mee neer; het script meet alleen de tekst. */
const [lapQ, fonQ] = SCHERMEN.b[0] as number[][][];
const xs = [...lapQ, ...fonQ].map((p) => p[0]), ys = [...lapQ, ...fonQ].map((p) => p[1]);
/* de bovenkant van de laptop is de rand om het scherm: 12 px boven het scherm zelf (gemeten in de still) */
const Q_TOP = Math.min(...ys) - 12, Q_LINKS = Math.min(...xs), Q_RECHTS = Math.max(...xs);
/* De tekst mag 90 px (in pixels van de reeks) voorbij de telefoon: daar is het nog wit, de
   rechterarm komt pas ± 180 px verder onder de hand door (gemeten op de hoogte van de kop). */
const Q_TEKST_EXTRA = 90;
/* het deel van de breedte van het venster dat de apparaten hoogstens beslaan */
const APPARATEN = 0.48;
const deel = (v: number) => (v / SCHERMEN.w).toFixed(5);
const MATEN = [
  `--o-q-top:${deel(Q_TOP)}`,
  `--o-q-mid:${deel((Q_LINKS + Q_RECHTS) / 2)}`,
  `--o-q-half:${deel((Q_RECHTS - Q_LINKS) / 2)}`,
  `--o-q-dev:${deel(Q_RECHTS - Q_LINKS)}`,
  `--o-q-tekst:${deel(Q_RECHTS - Q_LINKS + Q_TEKST_EXTRA)}`,
  `--o-q-hand:${deel(SCHERMEN.hand - Q_TOP)}`,
  /* hoe breed het beeld mag: de apparaten op hoogstens 48 % van het venster (levering 76, was
     58 %: "nog krap"), en zo hoog als past */
  `--o-q-per-hoogte:${(SCHERMEN.w / (SCHERMEN.hand - Q_TOP)).toFixed(4)}`,
  `--o-q-per-breedte:${((APPARATEN * SCHERMEN.w) / (Q_RECHTS - Q_LINKS)).toFixed(4)}`,
].join(';');

/* Zonder script (en zolang het script de schermen nog niet op hun hoeken heeft gezet) staat elk
   scherm in de rechthoek om zijn vierhoek in beeld 0; de still ligt erboven en dekt de rand af. */
const rechthoek = (q: number[][]) => {
  const qx = q.map((p) => p[0]), qy = q.map((p) => p[1]);
  const x0 = Math.min(...qx), y0 = Math.min(...qy), x1 = Math.max(...qx), y1 = Math.max(...qy);
  const pc = (v: number, op: number) => `${((v / op) * 100).toFixed(3)}%`;
  return `--o-x:${pc(x0, SCHERMEN.w)};--o-y:${pc(y0, SCHERMEN.h)};--o-b:${pc(x1 - x0, SCHERMEN.w)};--o-h:${pc(y1 - y0, SCHERMEN.h)}`;
};

/* ── de standen (src/data/openingStanden.js) ── */
const standen = openingStanden(lang);
const [cat, life, vid] = laptopReeks(lang);
const SET: Record<string, string> = { catalog: cat.naam, lifestyle: life.naam, video: vid.naam };
const eerste = standen[0] ?? { lap: `/img/hal/opening/scherm-${lang}-laptop`, tel: '/img/hal/opening/scherm-telefoon', set: 'catalog', duur: 0 };
const T = nl
  ? { groep: 'De voorbeeldschermen', vorige: 'Vorig beeld', volgende: 'Volgend beeld', pauze: 'Zet de beelden stil', speel: 'Laat de beelden lopen' }
  : { groep: 'The example screens', vorige: 'Previous image', volgende: 'Next image', pauze: 'Pause the images', speel: 'Play the images' };
const STILL = [1800, 2700, 3600];
const STILL_H = Math.round((3600 * SCHERMEN.h) / SCHERMEN.w);
/* het beeld is op de computer ± 1,4 – 1,75 × zo breed als het venster, op de telefoon 2,84 × */
const SIZES = '(max-width: 900px) 284vw, 170vw';
---
<section class="o-podium" data-o-podium aria-labelledby="h-h1" style={MATEN}>
  <span class="o-snap" data-o-snap="0" aria-hidden="true"></span>
  <span class="o-snap" data-o-snap="1" aria-hidden="true"></span>
  <div class="o-vast" data-o-vast>
    <div class="o-toneel" data-o-toneel>
      <div class="o-beeld" data-o-beeld>
        <div class="o-schermen" aria-hidden="true">
          <div class="o-sc o-sc-lap" data-o-lap style={rechthoek(lapQ)}>
            <picture class="o-st is-nu" data-o-st-lap="0">
              <source type="image/avif" srcset={`${eerste.lap}.avif`} />
              <img src={`${eerste.lap}.webp`} width="1600" height="1034" alt="" decoding="async" />
            </picture>
            <span class="o-donker" data-o-donker></span>
          </div>
          <div class="o-sc o-sc-fon" data-o-fon style={rechthoek(fonQ)}>
            <picture class="o-st is-nu" data-o-st-fon={eerste.tel}>
              <source type="image/avif" srcset={`${eerste.tel}.avif`} />
              <img src={`${eerste.tel}.webp`} width="540" height="1170" alt="" decoding="async" />
            </picture>
          </div>
        </div>
        <picture>
          <source type="image/avif" srcset={STILL.map((w) => `/img/hal/opening/still-${w}.avif ${w}w`).join(', ')} sizes={SIZES} />
          <img class="o-still" data-o-still src="/img/hal/opening/still-2700.webp"
               srcset={STILL.map((w) => `/img/hal/opening/still-${w}.webp ${w}w`).join(', ')} sizes={SIZES}
               width="3600" height={STILL_H} fetchpriority="high" decoding="async"
               alt={nl ? 'Twee handen houden een laptop met de webshop van een merk en een telefoon met de telefoonfoto van dezelfde roze jeans' : 'Two hands hold a laptop showing a brand’s web shop and a phone with the phone photo of the same pink jeans'} />
        </picture>
        <canvas class="o-doek" data-o-doek aria-hidden="true"></canvas>
      </div>

      <div class="o-tekst" data-o-tekst>
        <h1 id="h-h1" class="o-kop" data-o-kop aria-label={kop.plain}>
          <span class="o-kop-rest" data-o-rest aria-hidden="true">{voor}</span>{' '}
          <span class="o-acc" data-o-acc aria-hidden="true"><span class="o-acc-t" data-o-acc-t>{accent}</span><span class="o-acc-blauw">{accent}</span></span>
        </h1>
        <div class="o-rij" data-o-rij>
          <p class="o-lede" data-o-lede>{lede}</p>
          {standen.length > 1 && (
            <div class="o-stand" role="group" aria-label={T.groep} data-o-stand>
              <p class="o-stand-naam"><b data-o-naam>{SET[eerste.set]}</b><span class="o-stand-teller" data-o-teller>1 / {standen.length}</span><span class="o-stand-streep" aria-hidden="true"><i data-o-streep></i></span></p>
              <span class="h-paar"><button type="button" class="h-cirkel h-cirkel-klein" data-o-stap="-1" aria-label={T.vorige}><Fragment set:html={ikoon('pijl-links')} /></button><button type="button" class="h-cirkel h-cirkel-klein" data-o-stap="1" aria-label={T.volgende}><Fragment set:html={ikoon('pijl')} /></button></span>
              <button type="button" class="h-cirkel h-cirkel-klein o-pauze" data-o-pauze aria-pressed="false" aria-label={T.pauze} data-uit={T.pauze} data-aan={T.speel}><svg class="ik" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path class="o-p-uit" fill-rule="evenodd" d={IKOON.pauze} /><path class="o-p-aan" fill-rule="evenodd" d={IKOON.afspelen} /></svg></button>
            </div>
          )}
        </div>
        <span class="o-mes" data-o-mes aria-hidden="true"></span>
      </div>
      {standen.length > 1 && (
        <script type="application/json" data-o-standen set:html={JSON.stringify({ standen: standen.map((s) => ({ set: s.set, duur: s.duur, lap: s.lap, tel: s.tel })), sets: SET })} />
      )}
    </div>

    {/* De wortel van de uitleg (UitlegBalk.astro): data-uitleg, de tijden van de drie
        stappen en id="hoe" (tests/doorloop-27c en laptop-standen spelen hem zo af). */}
    <section class="o-hoe h-hoe" id="hoe" data-o-hoe data-dienst="catalog" aria-labelledby="h-hoe"
             data-uitleg={uitleg ? '' : undefined} data-uitleg-maat="2250 5200 2250" data-uitleg-start="300">
      <header class="o-hoe-kop" data-o-kopdeel>
        <div class="o-hoe-titel" data-o-titel>
          {/* het sectielabel van de site (hal.css, p.h-pil): vlagje, nummer, naam in mono */}
          <p class="h-pil o-label" data-o-pil><span data-o-label>{label}</span></p>
          <h2 id="h-hoe" class="h-kop h-h2 o-h2"><span class="l">{hoeKop[0]}</span> {hoeKop[1]}</h2>
          <span class="o-mes" data-o-mes-in aria-hidden="true"></span>
        </div>
        {/* Eén paneel voor drie tabs: de blokken blijven staan, de inhoud wisselt per dienst. */}
        <div class="o-tabs" role="tablist" aria-label={kies} data-o-tabs>
          {TABS.map(([id, naam, maat], i) => (
            <button type="button" role="tab" id={`o-tab-${id}`} data-dienst={id} data-maat={maat} aria-controls="o-blokken" aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>{naam}</button>
          ))}
        </div>
      </header>
      <div class="o-blokken" id="o-blokken" role="tabpanel" aria-labelledby="o-tab-catalog" data-o-panelen>
        <slot name="stappen" />
      </div>
      <div class="o-voet" data-o-voet>
        <slot name="balk" />
        <div class="o-acties"><slot name="acties" /></div>
      </div>
    </section>
  </div>
</section>

<script>
  import Q from '../data/openingSchermen.json';
  /* Het gedrag. Elke luisteraar op window gaat bij een zachte navigatie weer weg
     (tests/zachte-navigatie.test.mjs telt ze); alles hangt aan één podium tegelijk. */
  /* een deel dat de snede doorsnijdt: waar het in zijn vak staat (vak = de tekst of de titel) */
  type Deel = { el: HTMLElement; l: number; t: number; w: number; h: number };
  type Wortel = HTMLElement & { _u?: { stop: () => void; opnieuw: () => void } };
  type Stand = { set: string; duur: number; lap: string; tel: string };
  let ruim: (() => void) | null = null;
  /* De beelden van de video één keer per bezoek (25 oktober, de controle): bij een zachte navigatie
     terug naar de voorpagina hoeven ze niet opnieuw geladen en gedecodeerd te worden. naBeeld is
     de opening die nu leeft; een oude krijgt de beelden niet meer. */
  const BEELDEN: (HTMLImageElement | undefined)[] = [];
  let reeksBegon = false;
  let naBeeld: ((i: number) => void) | null = null;
  function laadReeks() {
    if (reeksBegon) return; reeksBegon = true;
    for (let i = Q.eerste; i <= Q.laatste; i++) {
      const im = new Image();
      im.decoding = 'async';
      im.onload = () => { (im.decode ? im.decode() : Promise.resolve()).catch(() => {}).then(() => { BEELDEN[i] = im; naBeeld?.(i); }); };
      im.src = `/img/hal/opening/f/${String(i).padStart(3, '0')}.avif`;
    }
  }

  const klem = (x: number) => Math.max(0, Math.min(1, x));
  const tussen = (a: number, b: number, x: number) => klem((x - a) / (b - a));
  const zacht = (x: number) => x * x * x * (x * (x * 6 - 15) + 10);          // smootherstep: rustig weg, rustig aan
  const uit5 = (x: number) => 1 - Math.pow(1 - x, 5);                         // ease-out quint: snel erin, zacht aankomen

  /* Een rechthoek (b × h) op een vierhoek zetten (Heckbert). */
  function matrix(b: number, h: number, q: number[][]) {
    const [[x0, y0], [x1, y1], [x2, y2], [x3, y3]] = q;
    const sx = x0 - x1 + x2 - x3, sy = y0 - y1 + y2 - y3;
    let g = 0, k = 0;
    if (Math.abs(sx) > 1e-6 || Math.abs(sy) > 1e-6) {
      const dx1 = x1 - x2, dx2 = x3 - x2, dy1 = y1 - y2, dy2 = y3 - y2, den = dx1 * dy2 - dx2 * dy1;
      g = (sx * dy2 - dx2 * sy) / den; k = (dx1 * sy - sx * dy1) / den;
    }
    const a = x1 - x0 + g * x1, bb = x3 - x0 + k * x3, d = y1 - y0 + g * y1, e = y3 - y0 + k * y3;
    return `matrix3d(${[a / b, d / b, 0, g / b, bb / h, e / h, 0, k / h, 0, 0, 1, 0, x0, y0, 0, 1].join(',')})`;
  }

  /* ── DE WEG VAN DE SCROLL (u van 0 tot 1, over 1,6 schermhoogte) — levering 76 ──────────────
     Lucas (26 oktober): "de tekst weg word gesneden op een VISUAILS style manier tijdens dat de
     laptop ook verdwijnt en dan heel kort wit scherm dan komt de tekst op de nieuwe plek terecht
     met een soortgelijk effect en komen de elementen tevoorschijn." Dat vervangt de letters die
     naar het label vlogen (74, 75) en de lichte stand van Hoe het werkt (75). */
  const W = {
    video: 0.7,                 // beeld 17 – 133 over u 0 – 0,70 (vanaf ± 0,40 schuiven de apparaten het beeld uit)
    snedeUit: [0.36, 0.56],     // de snede gaat door kop, zin en standen, terwijl de laptop weggaat
    beeldUit: [0.52, 0.66],     // het beeld lost op
    /* 0,66 – 0,72: alleen wit */
    snedeIn: [0.72, 0.84],      // dezelfde snede legt het label en de kop van Hoe het werkt bloot
    rest: [0.8, 0.9],           // de tabs, de blokken en de balk eronder verschijnen, kort na elkaar
    binnen: 0.95,               // alles staat
  };
  const ZAK = 14;               // hoeveel lager de delen beginnen (px)
  const SNEDE = 0.75;           // de snede: 53,13°, horizontaal 0,75 × de hoogte (de V)

  function start() {
    const podium = document.querySelector<HTMLElement>('[data-o-podium]');
    /* start() draait bij het laden van de module én op astro:page-load; dat is bij de eerste keer
       dezelfde pagina. Eén keer opzetten (25 oktober, de controle: alles gebeurde twee keer). */
    if (podium && podium.dataset.oKlaar && ruim) return;
    ruim?.();
    if (!podium) return;
    podium.dataset.oKlaar = '1';
    const $ = <T extends Element = HTMLElement>(s: string) => podium.querySelector<T>(s)!;
    const html = document.documentElement, body = document.body;
    const vast = $('[data-o-vast]'), toneel = $('[data-o-toneel]'), beeld = $('[data-o-beeld]'), doek = $<HTMLCanvasElement>('[data-o-doek]'), still = $('[data-o-still]');
    const lap = $('[data-o-lap]'), fon = $('[data-o-fon]'), donker = $('[data-o-donker]');
    const tekst = $('[data-o-tekst]'), kop = $('[data-o-kop]'), rest = $('[data-o-rest]'), acc = $('[data-o-acc]'), rijTekst = $('[data-o-rij]');
    const lede = $('[data-o-lede]'), standDeel = podium.querySelector<HTMLElement>('[data-o-stand]');
    const mesUit = $('[data-o-mes]'), mesIn = $('[data-o-mes-in]');
    const hoe = $<Wortel>('[data-o-hoe]'), kopdeel = $('[data-o-kopdeel]'), titel = $('[data-o-titel]'), tabs = $('[data-o-tabs]'), panelen = $('[data-o-panelen]'), voet = $('[data-o-voet]');
    const pil = $('[data-o-pil]'), h2 = hoe.querySelector<HTMLElement>('#h-hoe')!;
    const rij = panelen.querySelector<HTMLElement>('ol') || panelen;
    const blokken = [...rij.querySelectorAll<HTMLElement>(':scope > li')];
    const snap1 = $('[data-o-snap="1"]');
    /* wat na de snede verschijnt: de tabs, de blokken, de balk eronder */
    const delen = [tabs, rij, voet];
    const ctx = doek.getContext('2d')!;
    let stil = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let actief = false, VW = 0, VH = 0, kF = 1, V = 1, podTop = 0, beeldNu = -1, geland = false, binnen = false;

    /* ── de beelden: pas na de still, en alleen als ze gebruikt worden (laadReeks, bovenaan) ── */
    naBeeld = (i: number) => { if (Math.abs(i - beeldNu) < 20) { beeldNu = -1; werk(); } };
    const dichtstbij = (i: number) => { for (let d = 0; d < 24; d++) { if (BEELDEN[i - d]) return i - d; if (BEELDEN[i + d]) return i + d; } return -1; };

    function zetSchermen(i: number) {
      podium.classList.add('o-gezet');   // vanaf nu de hoeken uit het script, niet meer de rechthoek uit de css
      const b = Q.b[i] || [null, null], s = kF;
      const schaal = (q: number[][]) => q.map(([x, y]) => [x * s, y * s]);
      if (b[0]) { lap.style.visibility = 'visible'; lap.style.transform = matrix(1600, 1034, schaal(b[0])); donker.style.opacity = String(Q.d[i]); }
      else lap.style.visibility = 'hidden';
      if (b[1]) {
        fon.style.visibility = 'visible'; fon.style.transform = matrix(540, 1170, schaal(b[1]));
        const v0 = Q.b[Math.max(0, i - 1)][1];
        const v = v0 ? Math.hypot((b[1][0][0] + b[1][2][0] - v0[0][0] - v0[2][0]) / 2, (b[1][0][1] + b[1][2][1] - v0[0][1] - v0[2][1]) / 2) * s : 0;
        fon.style.filter = v > 2 ? `blur(${Math.min(5, v * 0.12).toFixed(1)}px)` : '';
      } else fon.style.visibility = 'hidden';
    }
    function tekenBeeld(i: number) {
      if (i === beeldNu) return; beeldNu = i;
      if (i <= Q.eerste) { zetSchermen(0); doek.style.visibility = 'hidden'; still.style.visibility = ''; return; }
      const j = dichtstbij(i);                           // nog niet binnen: het dichtstbijzijnde beeld, met zijn eigen schermen
      if (j < 0) { zetSchermen(0); doek.style.visibility = 'hidden'; still.style.visibility = ''; return; }
      zetSchermen(j);
      ctx.clearRect(0, 0, doek.width, doek.height);
      ctx.drawImage(BEELDEN[j]!, 0, 0, doek.width, doek.height);
      doek.style.visibility = 'visible'; still.style.visibility = 'hidden';
    }

    /* ── de snede (levering 76) ────────────────────────────────────────────────────────────
       Eén rechte lijn op 53,13° door een vak (de tekst onder de apparaten, of de titel van Hoe
       het werkt). c is waar de lijn de onderrand van het vak snijdt; hogerop ligt hij 0,75 × de
       hoogte verder naar rechts. Elk deel in het vak krijgt een clip-path met dezelfde lijn, in
       zijn eigen maten: zo snijdt één snede door alles heen. Gemeten in meet(), niet per beeld. */
    const vakUit = { w: 0, h: 0 }, vakIn = { w: 0, h: 0 };
    let uitDelen: Deel[] = [], inDelen: Deel[] = [], kier = 4;
    function meetSnede() {
      const plek = (vak: DOMRect, el: HTMLElement): Deel => { const r = el.getBoundingClientRect(); return { el, l: r.left - vak.left, t: r.top - vak.top, w: r.width, h: r.height }; };
      [kop, lede, standDeel, pil, h2].forEach((e) => { if (e) e.style.clipPath = ''; });
      const a = tekst.getBoundingClientRect(), b = titel.getBoundingClientRect();
      vakUit.w = a.width; vakUit.h = a.height; vakIn.w = b.width; vakIn.h = b.height;
      uitDelen = [kop, lede, standDeel].filter((e): e is HTMLElement => !!e).map((e) => plek(a, e));
      inDelen = [pil, h2].map((e) => plek(b, e));
      /* de kier van de V: 7,6 % van de hoogte, hier van de kop; loodrecht, dus horizontaal × 1,25 */
      kier = Math.max(3, parseFloat(getComputedStyle(kop).fontSize) * 0.076) * 1.25;
    }
    /* p van 0 tot 1: de lijn loopt van net links van het vak tot net rechts ervan.
       weg = true: wat links ligt is weg (de kop gaat); weg = false: wat links ligt is er (de titel komt). */
    const M = 48;   // marge om de letters heen (de gloed van het accentwoord, de staart van de j)
    function snij(delen: Deel[], vak: { w: number; h: number }, mes: HTMLElement, p: number, weg: boolean) {
      const c = -SNEDE * vak.h - M + p * (vak.w + SNEDE * vak.h + 2 * M);
      for (const d of delen) {
        const s = d.el.style;
        if (p <= 0) { s.clipPath = weg ? '' : 'inset(0 100% 0 0)'; continue; }
        if (p >= 1) { s.clipPath = weg ? 'inset(0 0 0 100%)' : ''; continue; }
        const xt = (c - d.l + SNEDE * (vak.h - d.t + M)).toFixed(1), xb = (c - d.l + SNEDE * (vak.h - d.t - d.h - M)).toFixed(1);
        s.clipPath = weg
          ? `polygon(${xt}px -${M}px, calc(100% + ${M}px) -${M}px, calc(100% + ${M}px) calc(100% + ${M}px), ${xb}px calc(100% + ${M}px))`
          : `polygon(-${M}px -${M}px, ${xt}px -${M}px, ${xb}px calc(100% + ${M}px), -${M}px calc(100% + ${M}px))`;
      }
      /* het mes: een dunne lijn in het wit, een kier van de snijrand (de echo, dun en verschoven) */
      const zicht = p > 0 && p < 1 ? Math.min(1, p / 0.08, (1 - p) / 0.14) : 0;
      mes.style.opacity = zicht > 0 ? zicht.toFixed(3) : '';
      if (zicht > 0) {
        const m = 10, x = c - SNEDE * m + (weg ? -kier : kier);
        mes.style.width = `${(SNEDE * (vak.h + 2 * m) + 2).toFixed(1)}px`; mes.style.height = `${(vak.h + 2 * m).toFixed(1)}px`;
        mes.style.transform = `translate(${x.toFixed(1)}px,${-m}px)`;
      }
    }

    /* ── de kop: op één regel, zo groot als de breedte onder de apparaten (gemeten) ──
       opening.css zet het beeld en de kop al neer met een geschatte hoogte van de tekst (--o-th);
       hier wordt de kop op maat gezet, de echte hoogte gemeten en teruggegeven. Twee rondes:
       een andere hoogte geeft een ander beeld en dus een andere breedte. */
    const KOP_MAX = 56.89;   // levering 76: hoogstens 56,89 px (de schaal van 4 : 3), net als opening.css
    function past() {
      const maxB = rijTekst.getBoundingClientRect().width;
      let lo = 28, hi = KOP_MAX + 1;
      for (let n = 0; n < 12; n++) {
        const f = (lo + hi) / 2;
        kop.style.fontSize = `${f}px`;
        const b = rest.getBoundingClientRect().width + acc.getBoundingClientRect().width + f * 0.25;
        if (b <= maxB) lo = f; else hi = f;
      }
      kop.style.fontSize = `${Math.min(KOP_MAX, Math.floor(lo))}px`;
    }
    function indeling() {
      const breed = VW > 900;
      kop.classList.toggle('o-kop-een', breed);
      if (!breed) { kop.style.fontSize = ''; toneel.style.removeProperty('--o-th'); return; }
      for (let n = 0; n < 3; n++) {
        past();
        toneel.style.setProperty('--o-th', `${Math.ceil(tekst.getBoundingClientRect().height)}px`);
      }
      past();
    }

    /* ── de hoogte van de beelden in de blokken, en Hoe het werkt midden onder de balk ──
       Levering 75: compacter ("niet zo in your face"), dus hoogstens 300 px beeld en het geheel
       in het midden van wat er onder de balk over is. */
    const BEELD_MIN = 180, BEELD_MAX = 300;
    function blokMaat(balk: number) {
      hoe.style.setProperty('--o-beeld', '240px');
      hoe.style.setProperty('--o-hoe-top', `${Math.round(balk + 20)}px`);
      const top = kopdeel.getBoundingClientRect().top, onder = voet.getBoundingClientRect().bottom;
      const H0 = onder - top;
      const vrij = VH - 24 - (balk + 20) - H0;
      const h = Math.floor(Math.min(BEELD_MAX, 240 + vrij));
      hoe.style.setProperty('--o-beeld', `${Math.max(BEELD_MIN, h)}px`);
      const H = H0 + (Math.max(BEELD_MIN, h) - 240);
      hoe.style.setProperty('--o-hoe-top', `${Math.round(balk + Math.max(20, (VH - balk - H) / 2 - 6))}px`);
      return h >= BEELD_MIN;
    }

    function meet() {
      VW = vast.clientWidth || window.innerWidth; VH = window.innerHeight;
      actief = window.innerWidth > 900 && !stil;   // > en niet >=: de css telt 900 als telefoon (25 okt)
      const balk = document.querySelector('.site-header .nav')?.getBoundingClientRect().bottom ?? 74;
      html.style.setProperty('--o-vh', `${VH / 100}px`);
      vast.style.setProperty('--o-balk', `${Math.round(balk)}px`);
      hoe.style.setProperty('--o-balk', `${Math.round(balk)}px`);
      if (actief) {
        /* past Hoe het werkt (kop, tabs, blokken, balk) niet in één scherm, dan gewoon onder elkaar */
        delen.forEach((e) => { e.style.transform = 'none'; e.style.opacity = ''; });
        blokken.forEach((e) => { e.style.transform = ''; });
        body.classList.add('o-aan'); body.classList.remove('o-stil');
        if (!blokMaat(balk)) actief = false;
      }
      body.classList.toggle('o-aan', actief); body.classList.toggle('o-stil', !actief);
      body.classList.toggle('o-onder', actief);   // de cookiekaart boven de kop (hal.css)
      html.classList.toggle('o-klik', actief && !STROOM.aan);
      indeling();
      kF = beeld.getBoundingClientRect().width / Q.w || 1;
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      doek.width = Math.round(Math.min(Q.w, beeld.getBoundingClientRect().width * dpr)); doek.height = Math.round(doek.width * Q.h / Q.w);
      if (actief) {
        V = VH * 1.6;
        podium.style.height = `${VH + V + VH * 0.4}px`;
        snap1.style.top = `${V}px`;
        /* De cookiekaart staat rechtsonder (Lucas, 25 okt); onder de handen gaat hij boven de kop staan. */
        html.style.setProperty('--o-cc-onder', `${Math.round(VH - tekst.getBoundingClientRect().top + vast.getBoundingClientRect().top + 12)}px`);
      } else {
        podium.style.height = '';
        html.style.removeProperty('--o-cc-onder');
        hoe.style.removeProperty('--o-beeld'); hoe.style.removeProperty('--o-hoe-top');
        delen.forEach((e) => { e.style.transform = ''; e.style.opacity = ''; });
        blokken.forEach((e) => { e.style.transform = ''; });
        snap1.style.top = `${hoe.offsetTop}px`;
      }
      podTop = podium.getBoundingClientRect().top + window.scrollY;
      if (actief) { meetSnede(); laadReeks(); }
      meetStops();
      /* Gaat de stroom uit (smaller venster, minder beweging): niet meer zweven en niet verder
         glijden; de wielluisteraar alleen als de stroom aan kan (25 okt, de controle) */
      if (!stroomAan()) { cancelAnimationFrame(glijRaf); glijdt = false; veegBezig = false; zweef(-1); }
      zetWiel();
      beeldNu = -1; werk();
    }

    function werk() {
      if (!actief) {
        if (VW) zetSchermen(0);
        [kop, lede, standDeel, pil, h2].forEach((e) => { if (e) e.style.clipPath = ''; });
        if (standDeel) standDeel.style.visibility = '';
        [mesUit, mesIn].forEach((m) => { m.style.opacity = ''; });
        beeld.style.opacity = '';
        delen.forEach((e) => { e.style.pointerEvents = ''; e.style.opacity = ''; e.style.transform = ''; });
        body.classList.remove('o-kopweg');
        if (!geland) { geland = true; body.classList.add('o-geland'); }
        standRust(true);
        houd(false);
        return;
      }
      const s = window.scrollY - podTop;
      if (hier >= 0 && !glijdt && Math.abs(window.scrollY - (stops[hier] ?? -1e9)) > 40) zweef(-1);
      const u = klem(s / V), pv = klem(u / W.video);
      standRust(s < 8);
      tekenBeeld(pv > 0 ? Math.round(Q.eerste + pv * (Q.laatste - Q.eerste)) : 0);
      /* de snede door kop, zin en standen; in het begin rustig, dan door (smootherstep) */
      const pu = zacht(tussen(W.snedeUit[0], W.snedeUit[1], u));
      snij(uitDelen, vakUit, mesUit, pu, true);
      /* de standen zijn weg: ook niet meer te bereiken met de tab-toets */
      if (standDeel) standDeel.style.visibility = pu >= 1 ? 'hidden' : '';
      body.classList.toggle('o-kopweg', pu >= 1);   // de kop is helemaal weg; de cookiekaart mag terug naar de hoek (hal.css)
      beeld.style.opacity = u > W.beeldUit[0] ? (1 - zacht(tussen(W.beeldUit[0], W.beeldUit[1], u))).toFixed(3) : '';
      /* even wit, dan legt dezelfde snede het label en de kop van Hoe het werkt bloot */
      const pi = uit5(tussen(W.snedeIn[0], W.snedeIn[1], u));
      snij(inDelen, vakIn, mesIn, pi, false);
      /* ... en verschijnen de tabs, de blokken en de balk, kort na elkaar (dekking en 14 px omhoog) */
      delen.forEach((e, n) => {
        const k = uit5(tussen(W.rest[0] + n * 0.03, W.rest[1] + n * 0.03, u));
        e.style.opacity = k < 0.999 ? k.toFixed(3) : '';
        e.style.transform = k < 1 ? `translateY(${(ZAK * (1 - k)).toFixed(1)}px)` : '';
        /* een deel dat staat, is aan te klikken */
        e.style.pointerEvents = k > 0.995 ? 'auto' : '';
      });
      blokken.forEach((e, n) => {
        const k = uit5(tussen(W.rest[0] + 0.03 + 0.02 * n, W.rest[1] + 0.03 + 0.02 * n, u));
        e.style.transform = k < 1 && n ? `translateY(${((1 - k) * 8 * n).toFixed(1)}px)` : '';
      });
      if (pi >= 1 && !geland) { geland = true; body.classList.add('o-geland'); }        // het vlagje gaat aan als een tl-buis (E4)
      else if (pi < 1 && geland) { geland = false; body.classList.remove('o-geland'); }
      if (u >= W.binnen && !binnen) { binnen = true; body.classList.add('o-binnen'); }
      else if (u < W.binnen && binnen) { binnen = false; body.classList.remove('o-binnen'); }
      /* de uitleg (UitlegBalk) begint pas als Hoe het werkt er echt staat */
      houd(u < W.binnen);
    }
    function houd(aan: boolean) {
      if (aan === ('uitlegHoud' in hoe.dataset)) return;
      if (aan) hoe.dataset.uitlegHoud = ''; else delete hoe.dataset.uitlegHoud;
      hoe.dispatchEvent(new Event('uitleg-houd'));
    }

    /* ── DE STANDEN VAN DE SCHERMEN — levering 75 ───────────────────────────────────────────
       Lucas (23:35): "de mogelijkheden van de laptop en het wisselen van scherm (zoals het
       instagram voorbeeld mockup) … ik wil dit terug." Zoals de laptop van vóór 74 (HalLaptop):
       de streep is de klok, pas wisselen als het volgende scherm geladen én gedecodeerd is, en
       dan in elkaar overvloeien. Alleen in het rustbeeld (bovenaan, nog niet gescrold), stil
       onder de muis of de focus en buiten beeld, en voorgoed stil na een pijl of pauze. Bij
       minder beweging loopt het niet vanzelf (de pijlen werken wel). "Niets beweegt bij het
       laden": net als het accentwoord begint het pas na de eerste beweging van de bezoeker. */
    const standJson = podium.querySelector('[data-o-standen]');
    const standKnop = podium.querySelector<HTMLElement>('[data-o-stand]');
    let standRust: (rust: boolean) => void = () => {};
    let standOpruim: () => void = () => {};
    if (standJson && standKnop) {
      const data = JSON.parse(standJson.textContent || '{}') as { standen: Stand[]; sets: Record<string, string> };
      const lijst = data.standen || [];
      const streep = $('[data-o-streep]'), naam = $('[data-o-naam]'), teller = $('[data-o-teller]');
      const pauze = $<HTMLButtonElement>('[data-o-pauze]');
      const rustig = stil;
      let nu = 0, loopt = !rustig, zicht = false, erboven = false, rust = true, bewogen = false;
      const laps = new Map<number, { el: HTMLElement; p: Promise<void> }>();
      const fons = new Map<string, { el: HTMLElement; p: Promise<void> }>();
      const klaar = (img: HTMLImageElement) => (img.complete && img.naturalWidth > 0 ? Promise.resolve() : new Promise<void>((r) => { img.addEventListener('load', () => r(), { once: true }); img.addEventListener('error', () => r(), { once: true }); }))
        .then(() => (typeof img.decode === 'function' ? img.decode().catch(() => {}) : undefined)).then(() => {});
      const bestaand = (el: HTMLElement | null) => (el ? { el, p: klaar(el.querySelector('img')!) } : null);
      const l0 = bestaand(lap.querySelector<HTMLElement>('[data-o-st-lap="0"]')); if (l0) laps.set(0, l0);
      const f0 = bestaand(fon.querySelector<HTMLElement>('[data-o-st-fon]')); if (f0) fons.set(f0.el.dataset.oStFon || '', f0);
      const maak = (pad: string, b: number, h: number) => {
        const pic = document.createElement('picture'); pic.className = 'o-st';
        const src = document.createElement('source'); src.type = 'image/avif'; src.srcset = `${pad}.avif`;
        const img = document.createElement('img'); img.width = b; img.height = h; img.alt = ''; img.decoding = 'async'; img.src = `${pad}.webp`;
        pic.append(src, img);
        return { el: pic as HTMLElement, img };
      };
      const klaarVoor = (k: number) => {
        const s = lijst[k];
        if (!laps.has(k)) { const { el, img } = maak(s.lap, 1600, 1034); lap.insertBefore(el, donker); laps.set(k, { el, p: klaar(img) }); }
        if (!fons.has(s.tel)) { const { el, img } = maak(s.tel, 540, 1170); fon.append(el); fons.set(s.tel, { el, p: klaar(img) }); }
        return Promise.all([laps.get(k)!.p, fons.get(s.tel)!.p]).then(() => {});
      };
      const toestand = () => {
        podium.classList.toggle('o-loopt', loopt && bewogen && zicht && rust && !erboven);
        pauze.setAttribute('aria-pressed', String(!loopt));
        pauze.setAttribute('aria-label', (loopt ? pauze.dataset.uit : pauze.dataset.aan) || '');
      };
      const wissel = (el: HTMLElement) => { if (!rustig && typeof el.animate === 'function') el.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 300, easing: 'cubic-bezier(.25, .8, .3, 1)' }); };
      const herstart = (ms: number) => {
        streep.style.animationDuration = `${ms}ms`;
        if (!streep.classList.contains('is-aan')) { streep.classList.add('is-aan'); return; }
        const a = typeof streep.getAnimations === 'function' ? streep.getAnimations()[0] : undefined;
        if (a) a.currentTime = 0;
        else { streep.classList.remove('is-aan'); requestAnimationFrame(() => streep.classList.add('is-aan')); }
      };
      const toon = (k: number) => {
        nu = (k + lijst.length) % lijst.length;
        const s = lijst[nu];
        podium.dataset.stand = s.set;
        laps.forEach((v, j) => v.el.classList.toggle('is-nu', j === nu));
        fons.forEach((v, t) => v.el.classList.toggle('is-nu', t === s.tel));
        const n = data.sets[s.set] || '';
        if (naam.textContent !== n) { naam.textContent = n; wissel(naam); }
        teller.textContent = `${nu + 1} / ${lijst.length}`;
        herstart(s.duur);
      };
      let beurt = 0, onderweg: number | null = null;
      const ga = (stap: number) => {
        /* twee keer snel op de pijl: de tweede telt vanaf waar de eerste heen ging */
        const doel = ((onderweg ?? nu) + stap + lijst.length) % lijst.length;
        onderweg = doel;
        const deze = ++beurt;
        klaarVoor(doel).then(() => { if (deze === beurt) { onderweg = null; toon(doel); klaarVoor((doel + 1) % lijst.length); } });
      };
      const opEind = () => { if (loopt) ga(1); };
      streep.addEventListener('animationend', opEind);
      for (const knop of standKnop.querySelectorAll<HTMLButtonElement>('[data-o-stap]')) knop.addEventListener('click', () => { loopt = false; toestand(); ga(Number(knop.dataset.oStap)); });
      pauze.hidden = rustig;
      pauze.addEventListener('click', () => { loopt = !loopt; toestand(); });
      const op = () => { erboven = true; toestand(); }, af = () => { erboven = false; toestand(); };
      /* Stil onder de muis: alleen boven de laptop en de telefoon zelf. Het beeld is met de
         doorgetrokken armen bijna zo groot als het venster; "boven het beeld" was dus altijd. */
      const opBeeld = (e: PointerEvent) => {
        const binnen = [lap, fon].some((el) => { if (el.style.visibility === 'hidden') return false; const r = el.getBoundingClientRect(); return e.clientX >= r.left - 12 && e.clientX <= r.right + 12 && e.clientY >= r.top - 12 && e.clientY <= r.bottom + 12; });
        if (binnen !== erboven) { erboven = binnen; toestand(); }
      };
      beeld.addEventListener('pointermove', opBeeld); beeld.addEventListener('pointerleave', af);
      standKnop.addEventListener('pointerenter', op); standKnop.addEventListener('pointerleave', af);
      standKnop.addEventListener('focusin', op); standKnop.addEventListener('focusout', af);
      const io = new IntersectionObserver(([e]) => { zicht = e.isIntersecting; toestand(); }, { threshold: 0.35 });
      io.observe(toneel);
      standRust = (r: boolean) => { if (r !== rust) { rust = r; toestand(); } };
      const EERST = ['pointermove', 'keydown', 'touchstart', 'wheel'] as const;
      const eerst = () => { bewogen = true; EERST.forEach((t) => window.removeEventListener(t, eerst)); toestand(); };
      if (!rustig) EERST.forEach((t) => window.addEventListener(t, eerst, { passive: true }));
      standOpruim = () => { io.disconnect(); streep.removeEventListener('animationend', opEind); EERST.forEach((t) => window.removeEventListener(t, eerst)); };
      toon(0);
      toestand();
      /* het volgende scherm meteen klaarzetten; de rest pas als de pagina rust, één tegelijk.
         Niet bij "databesparing": dan alleen steeds het volgende. */
      klaarVoor(1);
      const zuinig = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData === true;
      if (!zuinig) {
        const vooruit = async () => { for (let k = 2; k < lijst.length; k++) { if (!podium.isConnected) return; await klaarVoor(k); } };
        const rustF = (window as Window & { requestIdleCallback?: (f: () => void, o?: { timeout: number }) => number }).requestIdleCallback;
        const begin = () => (rustF ? rustF(() => { vooruit(); }, { timeout: 4000 }) : window.setTimeout(() => { vooruit(); }, 1500));
        if (document.readyState === 'complete') begin(); else window.addEventListener('load', begin, { once: true });
      }
    }

    /* ── de keuze per dienst (tabs, met de pijltjes) ──
       De blokken blijven staan; data-dienst op de sectie kiest wat erin staat (opening.css),
       en de uitleg begint opnieuw, zodat je het proces van die dienst ziet. */
    const knoppen = [...tabs.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    function kies(t: HTMLButtonElement, focus: boolean) {
      if (t.getAttribute('aria-selected') === 'true') { if (focus) t.focus(); return; }
      for (const b of knoppen) {
        const aan = b === t;
        b.setAttribute('aria-selected', aan ? 'true' : 'false'); b.tabIndex = aan ? 0 : -1;
      }
      hoe.dataset.dienst = t.dataset.dienst;
      if (t.dataset.maat) hoe.dataset.uitlegMaat = t.dataset.maat;
      panelen.setAttribute('aria-labelledby', t.id);
      if (focus) t.focus();
      /* 25 oktober (de controle): had je de uitleg met de hand stilgezet, dan begon hij bij een
         andere tab toch weer te bewegen. Nu krijg je de nieuwe dienst in zijn eindstand, stil;
         met "opnieuw" speel je hem af (WCAG 2.2.2: jouw pauze blijft gelden). */
      if (!stil && hoe.dataset.uitlegStaat && hoe.dataset.uitlegStaat !== 'wacht') {
        if (hoe.dataset.uitlegHand) hoe._u?.stop(); else hoe._u?.opnieuw();
      }
    }
    knoppen.forEach((b, i) => {
      b.addEventListener('click', () => kies(b, false));
      b.addEventListener('keydown', (e) => {
        const n = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : e.key === 'Home' ? -i : e.key === 'End' ? knoppen.length - 1 - i : 0;
        if (!n) return;
        e.preventDefault(); kies(knoppen[(i + n + knoppen.length) % knoppen.length], true);
      });
    });
    /* Met de tab-toets: komt de focus in Hoe het werkt terwijl dat nog niet staat, dan springt
       de pagina naar de stand waarin het staat (de tabs, Start een bestelling). */
    const opFocus = () => {
      if (!actief) return;
      const s = window.scrollY - podTop;
      if (s < V * W.binnen || s > V + VH * 0.4) window.scrollTo({ top: podTop + V, behavior: 'instant' as ScrollBehavior });
    };
    hoe.addEventListener('focusin', opFocus);

    /* ── DE STROOM: ÉÉN SCROLL, ÉÉN SECTIE — 25 oktober 2026, 16:56 ─────────────────────────
       Lucas: *"Wanneer ik omlaag scroll vanaf de laptop begin sectie wil ik dat hij afspeelt en
       gelijk in een soort smooth snelheid naar de volgende sectie gaat waarbij de elementen in die
       sectie heel langzaam golvend zweven (echt heel rustig en subtiel), tot je weer verder
       scrollt en je weer heel snel naar de volgende sectie gaat en weer hetzelfde gebeurt."* En:
       "Elke scroll = volgende sectie klopt tot en met de services/producten. Hierna … normaal
       doorscrollen", "Alleen op de computer", en "Smooth ontploffing … dit moet zo voelen in de
       scroll animatie" (snel weg, lang en zacht uitlopen).
       De stops: het begin, Hoe het werkt (na de video), Elk formaat, Wat we maken. Een wieltik of
       een toets (pijl, Page, spatie) daartussen glijdt naar de volgende stop; een sectie die
       langer is dan het scherm scrolt eerst gewoon door. Voorbij Wat we maken: gewoon scrollen.
       Aan en uit met STROOM hieronder ("misschien alleen bij de laptop": tot = 1). */
    const STROOM = { aan: true, tot: 3 };
    const bezier = (x1: number, y1: number, x2: number, y2: number) => (x: number) => {
      let lo = 0, hi = 1, t = x;
      for (let n = 0; n < 20; n++) { t = (lo + hi) / 2; const bx = 3 * (1 - t) * (1 - t) * t * x1 + 3 * (1 - t) * t * t * x2 + t * t * t; if (bx < x) lo = t; else hi = t; }
      return 3 * (1 - t) * (1 - t) * t * y1 + 3 * (1 - t) * t * t * y2 + t * t * t;
    };
    const VIDEO_CURVE = bezier(0.42, 0, 0.12, 1);      // de video: rustig op gang, lang uitlopen
    const SPRONG_CURVE = bezier(0.2, 0.75, 0.08, 1);   // de "smooth ontploffing": snel weg, zacht aankomen
    const fmtSec = document.querySelector<HTMLElement>('.h-fmt'), makenSec = document.querySelector<HTMLElement>('#maken');
    /* levering 76: Formaten staat niet meer op de voorpagina (in stap 3 van Hoe het werkt); een stop
       zonder sectie valt weg, en de stops en de secties blijven samen in één rij */
    const zweefAlle = [null, hoe, fmtSec, makenSec];
    let zweefDelen: (HTMLElement | null)[] = zweefAlle;
    let stops: number[] = [], glijdt = false, veegBezig = false, laatsteWiel = 0, glijRaf = 0, hier = -1, glijK = -1;
    const kopY = (s: HTMLElement | null) => {
      if (!s) return NaN;
      const k = s.querySelector<HTMLElement>('.h-sec-kop') || s;
      const balk = document.querySelector('.site-header .nav')?.getBoundingClientRect().bottom ?? 66;
      return Math.round(k.getBoundingClientRect().top + window.scrollY - balk - 36);
    };
    const stroomAan = () => STROOM.aan && actief && !stil && window.innerWidth > 900;
    function meetStops() {
      const paar = ([[podTop, null], [podTop + V, hoe], [kopY(fmtSec), fmtSec], [kopY(makenSec), makenSec]] as [number, HTMLElement | null][])
        .slice(0, STROOM.tot + 1).filter(([y]) => Number.isFinite(y));
      stops = paar.map(([y]) => y);
      zweefAlle.forEach((e) => e?.removeAttribute('data-o-stroom-eind'));
      zweefDelen = paar.map(([, e]) => e);
      /* de laatste sectie van de stroom: de €1-melding wacht tot die voorbij is (interactions.js),
         anders ligt hij linksonder over elke sectie die een scherm vult */
      zweefDelen.forEach((e) => e?.removeAttribute('data-o-stroom-eind'));
      if (stroomAan()) zweefDelen[stops.length - 1]?.setAttribute('data-o-stroom-eind', '');
    }
    function zweef(k: number) {
      hier = k;
      zweefDelen.forEach((e, i) => e?.classList.toggle('is-zweeft', i === k && stroomAan()));
    }
    function glijNaar(k: number) {
      const y0 = window.scrollY, y1 = stops[k], video = (k <= 1 && y0 <= stops[1] + 4);
      /* De tijd hangt af van de afstand (25 okt, de controle): 10 px voor de stop duurde 3 s en
         hield zolang elke tik tegen. De hele video 2,8 s (levering 75: de weg is korter, 1,6 schermhoogte), een hele sectie 1,15 s. */
      const afstand = Math.abs(y1 - y0);
      if (afstand < 4) { zweef(k); return; }
      const vol = video ? Math.max(1, stops[1] - stops[0]) : VH;
      const duur = (video ? 2800 : 1150) * Math.min(1, Math.max(video ? 0.2 : 0.35, afstand / vol));
      const curve = video ? VIDEO_CURVE : SPRONG_CURVE, t0 = performance.now();
      glijdt = true; veegBezig = true; glijK = k; zweef(-1);
      cancelAnimationFrame(glijRaf);
      const stap = (nu: number) => {
        const p = Math.min(1, (nu - t0) / duur);
        const doel = stops[k] ?? y1;                                     // verandert het venster onderweg, dan de nieuwe stop
        window.scrollTo({ top: y0 + (doel - y0) * curve(p), behavior: 'instant' as ScrollBehavior });
        if (p < 1) glijRaf = requestAnimationFrame(stap);
        else { glijdt = false; zweef(k); }
      };
      glijRaf = requestAnimationFrame(stap);
    }
    /* waar naartoe vanaf y in richting r; -1 = gewoon scrollen. Een sectie die langer is dan het
       scherm scrolt eerst gewoon door tot haar einde; het podium telt niet als lang (de rust
       na Hoe het werkt is geen inhoud). */
    const eindVan = (k: number) => {
      const s = zweefDelen[k]; if (!s || k <= 1) return -Infinity;
      const eind = s.getBoundingClientRect().bottom + window.scrollY - VH;
      return eind - stops[k] > VH * 0.25 ? eind : -Infinity;             // een kwart scherm extra telt nog niet als lang
    };
    function volgende(y: number, r: number) {
      if (stops.length < 2) return -1;
      const laatste = stops.length - 1;
      if (r > 0) {
        if (y < stops[1] - 4) return 1;                                  // de video speelt in één keer
        let cur = 0; for (let i = 0; i < stops.length; i++) if (stops[i] <= y + 4) cur = i;
        if (cur >= laatste) return -1;                                   // voorbij Wat we maken: vrij
        if (y < eindVan(cur) - 4) return -1;                             // eerst de rest van deze sectie
        return cur + 1;
      }
      if (y <= stops[1] + 4) return y > stops[0] + 4 ? 0 : -1;           // terug naar het begin
      if (y > stops[laatste] + 4) return -1;                             // onder Wat we maken: vrij
      let cur = -1; for (let i = 0; i < stops.length; i++) if (stops[i] < y - 4) cur = i;
      if (cur < 0) return -1;
      const opStop = stops.some((s) => Math.abs(s - y) <= 4);
      if (!opStop && eindVan(cur) > -Infinity) return -1;                // midden in een lange sectie: gewoon scrollen
      return cur;
    }
    /* een open dialoog (de cookie-instellingen) maakt de pagina erachter onbereikbaar: dan ook niet glijden */
    const modaal = () => { try { return !!document.querySelector(':modal'); } catch { return false; } };
    const opWiel = (e: WheelEvent) => {
      if (!stroomAan() || e.ctrlKey || !e.deltaY || Math.abs(e.deltaY) < Math.abs(e.deltaX) || modaal()) return;
      const nu = performance.now(), los = nu - laatsteWiel > 160; laatsteWiel = nu;
      if (glijdt || (veegBezig && !los)) { e.preventDefault(); return; }
      veegBezig = false;
      const k = volgende(window.scrollY, Math.sign(e.deltaY));
      if (k < 0) return;
      e.preventDefault(); glijNaar(k);
    };
    const TOETS: Record<string, number> = { ArrowDown: 1, PageDown: 1, ' ': 1, ArrowUp: -1, PageUp: -1 };
    const opToets = (e: KeyboardEvent) => {
      if (!stroomAan() || e.defaultPrevented || e.altKey || e.ctrlKey || e.metaKey || modaal()) return;
      const doel = e.target as HTMLElement | null;
      if (doel && doel.closest('input, textarea, select, button, a, [role="tab"], [contenteditable="true"]')) return;
      let r = TOETS[e.key]; if (!r) return;
      if (e.key === ' ' && e.shiftKey) r = -1;
      if (glijdt) { e.preventDefault(); return; }
      const k = volgende(window.scrollY, r);
      if (k < 0) return;
      e.preventDefault(); glijNaar(k);
    };
    /* niet-passief alleen als het moet: anders wacht elk wieltje op de pagina op dit script */
    let wielAan = false;
    function zetWiel() {
      const moet = stroomAan();
      if (moet && !wielAan) { window.addEventListener('wheel', opWiel, { passive: false }); wielAan = true; }
      else if (!moet && wielAan) { window.removeEventListener('wheel', opWiel); wielAan = false; }
    }
    window.addEventListener('keydown', opToets);

    /* ── het accentwoord ademt (Lucas, 13:52): pas na de eerste beweging van de bezoeker ── */
    const ADEM = ['pointermove', 'keydown', 'touchstart', 'wheel'] as const;
    const adem = () => { podium.classList.add('o-ademt'); ADEM.forEach((t) => window.removeEventListener(t, adem)); };
    if (!stil) ADEM.forEach((t) => window.addEventListener(t, adem, { passive: true }));

    /* ── luisteraars op window: één scroll en één resize, en weer weg bij een zachte navigatie ── */
    let bezig = false;
    const opScroll = () => { if (bezig) return; bezig = true; requestAnimationFrame(() => { bezig = false; werk(); }); };
    let rt = 0;
    const opResize = () => {
      clearTimeout(rt);
      rt = window.setTimeout(() => {
        const k = glijdt ? glijK : hier;                                 // stond je op een stop, dan blijf je daar
        meet();
        if (k >= 0 && stroomAan() && !glijdt && stops[k] !== undefined) { window.scrollTo({ top: stops[k], behavior: 'instant' as ScrollBehavior }); zweef(k); }
      }, 120);
    };
    const mq = matchMedia('(prefers-reduced-motion: reduce)');
    const opMq = () => { stil = mq.matches; meet(); };
    window.addEventListener('scroll', opScroll, { passive: true });
    window.addEventListener('resize', opResize);
    mq.addEventListener?.('change', opMq);

    /* /#hoe: dan Hoe het werkt zoals het staat, niet halverwege de video (25 okt, de controle) */
    const naarHoe = () => { if (location.hash === '#hoe' && actief && podium.isConnected) window.scrollTo({ top: podTop + V, behavior: 'instant' as ScrollBehavior }); };
    window.addEventListener('hashchange', naarHoe);

    meet();
    if (location.hash === '#hoe') { requestAnimationFrame(naarHoe); if (document.readyState !== 'complete') window.addEventListener('load', naarHoe, { once: true }); }
    document.fonts?.ready.then(() => { if (podium.isConnected) meet(); });
    if (still instanceof HTMLImageElement && !still.complete) still.addEventListener('load', () => { if (podium.isConnected) meet(); }, { once: true });

    ruim = () => {
      window.removeEventListener('scroll', opScroll);
      window.removeEventListener('resize', opResize);
      mq.removeEventListener?.('change', opMq);
      ADEM.forEach((t) => window.removeEventListener(t, adem));
      window.removeEventListener('wheel', opWiel); wielAan = false;
      window.removeEventListener('keydown', opToets);
      window.removeEventListener('hashchange', naarHoe);
      window.removeEventListener('load', naarHoe);
      naBeeld = null;
      standOpruim();
      delete hoe.dataset.uitlegHoud;
      podium.classList.remove('o-loopt');
      delete podium.dataset.oKlaar; podium.classList.remove('o-gezet');
      cancelAnimationFrame(glijRaf);
      zweefAlle.forEach((e) => { e?.classList.remove('is-zweeft'); e?.removeAttribute('data-o-stroom-eind'); });
      clearTimeout(rt);
      html.classList.remove('o-klik');
      [kop, lede, standDeel, pil, h2].forEach((e) => { if (e) e.style.clipPath = ''; });
      body.classList.remove('o-aan', 'o-stil', 'o-onder', 'o-kopweg', 'o-geland', 'o-binnen');
      html.style.removeProperty('--o-cc-onder');
      ruim = null;
    };
  }

  start();
  document.addEventListener('astro:page-load', start);
  document.addEventListener('astro:before-swap', () => ruim?.());
</script>
