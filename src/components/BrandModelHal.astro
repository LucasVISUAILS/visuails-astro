//
// Below the fold on THIS page, ROSTER is sliced to a four-model taste — see
// the #standard section — so the two pages are not indexing the same ten
// portraits twice; the full ten live at /models now.

// Our own finished work. Not before/afters, not client results — output.
// Intrinsic sizes, per photo, because these four are NOT all the same shape:
// 01 and 02 are 800x1071, 04 and 05 are 1200x1200. One shared width/height on
// the <img> reserved a square box for two portraits, which is layout shift.
/* De zes gedeelde gezichten achter het merkmodel in de hero. Kleine derivaten
   (380px, zie scripts/make-thumbs.mjs): ze worden getekend in vakjes van
   ongeveer 150 px en de hero is het eerste wat binnenkomt. */
const WALL = ['aaron', 'ava', 'elias', 'ryan', 'dana', 'rae']
  .map((n) => ({ src: `/img/model-${n}-w380.webp`, w: 380, h: 509 }));

