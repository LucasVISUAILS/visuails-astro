    ['Jij stuurt', 'Je stuurt referenties en vertelt welke look je wilt.'],
    ['Richtingen', 'We ontwerpen twee of drie richtingen waarop je kunt reageren.'],
    ['Jij kiest', 'Kies het gezicht dat past. Daarop krijg je één correctieronde.'],
    ['Vastgezet', 'We leggen het model vast, zodat het niet per bestelling gaat verschuiven.'],
    ['Per bestelling', 'Vanaf dan kies je per bestelling of je het gebruikt, en op welke producten.'],
  ],
};

const c = COPY[lang];
const nl = lang === 'nl';
const directions = DIRECTIONS[lang];
const steps = STEPS[lang];
const wa = waHref(c.waText);
/* Koppen in twee tonen. "Jouw model, niet <em>een</em> model." had een nadruk op
   "een"; in de hal draagt de tweede toon die nadruk. */
const KOP = nl ? {
  h1: [c.h1a, c.h1b], uit: ['Echt geleverd werk,', 'geen mock-up.'], wat: ['Jouw model,', 'niet een model.'],
  proces: ['Hoe een merkmodel', 'tot stand komt.'], richting: ['Negen vertrekpunten', 'om op te reageren.'], slot: [c.ctaH1, c.ctaEm],
  procesPil: 'Zo gaat het', richtingPil: 'Richtingen', kostPil: c.costSetupLabel, geleverdPil: 'Geleverd',
} : {
  h1: [c.h1a, c.h1b], uit: ['Real output,', 'not a mock-up.'], wat: ['Your model,', 'not a model.'],
  proces: ['How a Brand Model', 'comes together.'], richting: ['Nine starting points,', 'to argue with.'], slot: [c.ctaH1, c.ctaEm],
  procesPil: 'How it goes', richtingPil: 'Directions', kostPil: c.costSetupLabel, geleverdPil: 'Delivered',
};
const DRIE = (n: number) => String(n).padStart(2, '0');
const vasteReeksGecontroleerd = rosterVolledigGecontroleerd();
const zoekers = inWoorden(GEZICHTSZOEKERS.length, lang);
const CHECK = nl ? {
  kop: 'Gecontroleerd op bestaande gezichten',
  zin: `Elk merkmodel${vasteReeksGecontroleerd ? ', en elk gezicht in onze vaste reeks,' : ''} halen we vóór gebruik door ${zoekers} verschillende gezichtszoekmachines, om na te gaan dat het niet het gezicht van een bestaand persoon is. Zo zet je het met een gerust hart in je shop, je advertenties en je campagnes.`,
  link: 'Meer hierover in de voorwaarden',
} : {
  kop: 'Checked against real faces',
  zin: `Every Brand Model${vasteReeksGecontroleerd ? ', and every face in our standard roster,' : ''} goes through ${zoekers} different face-search engines before it is used, to check that it is not the face of an existing person. So you can put it in your shop, your ads and your campaigns with confidence.`,
  link: 'More on this in the terms',
};
const ICOON = {
  rechts: '<path d="M2.5 8h11M9 3.5L13.5 8 9 12.5"/>',
  pijl: '<path d="M4.5 11.5l7-7M5.5 4.5h6v6"/>',
  check: '<path d="M3 8.5l3.2 3L13 4.5"/>',
  schild: '<path d="M8 1.8l5 2v3.6c0 3.1-2.1 5.6-5 6.8-2.9-1.2-5-3.7-5-6.8V3.8z"/><path d="M5.6 8.1l1.7 1.6 3.1-3.3"/>',
};
const ik = (n: keyof typeof ICOON) => `<svg viewBox="0 0 16 16" aria-hidden="true">${ICOON[n]}</svg>`;
---
<div class="h-pagina h-bm">

  {/* ── 1 · DE KOP ─────────────────────────────────────────────────────────── */}
  <header class="h-paginakop h-bm-kop">
    <div class="h-bm-kop-tekst">
      <p class="h-pil h-op" style="--d:0"><span>{c.eyebrow}</span></p>
      <h1 class="h-kop h-h1 h-op" style="--d:1"><span class="l">{KOP.h1[0]}</span> <span>{KOP.h1[1]}</span></h1>
      <p class="h-lede h-op" style="--d:2">{c.lead}</p>
      <p class="h-acties h-op" style="--d:3">
        <a class="h-knop h-knop-inkt" href={lp('/start/brand-model')}>{c.ctaPrimary}<span class="o" set:html={ik('rechts')} /></a>
        <a class="h-knop h-knop-lijn" href={lp('/models')}>{c.libAllCta}</a>
      </p>
      <ul class="h-feiten h-op" style="--d:4" role="list">
        {c.trust.map((t) => <li><i set:html={ik('check')} /><span><b>{t[0]}</b> {t[1]}</span></li>)}
      </ul>
    </div>

    {/* ZES GEDEELDE GEZICHTEN, ÉÉN VAN JOU. De muur is aria-hidden (hij zegt niets
        wat de tekst niet zegt); het portret draagt de alt-tekst, en het
        onderschrift zegt dat het een voorbeeld is, geen merkmodel van een klant. */}
    <figure class="h-bm-cast h-op" style="--d:2">
      <div class="h-bm-muur" aria-hidden="true">
        {WALL.map((m) => <span class="h-bm-muur-vak"><img src={m.src} alt="" width={m.w} height={m.h} loading="lazy" decoding="async" /></span>)}
        <span class="h-bm-muur-naam">{c.castShared}</span>
      </div>
      <div class="h-bm-een">
        <img src="/img/custom-models-02.webp" alt={c.heroAlt} decoding="sync" width="800" height="1071" fetchpriority="high" />
        <span class="h-pil h-pil-glas h-bm-een-pil"><span>{c.castYours}</span></span>
      </div>
      <figcaption class="h-bm-noot">{c.castNote}</figcaption>
    </figure>
  </header>

  {/* ── 2 · ECHT GELEVERD WERK ──────────────────────────────────────────── */}
  <section class="h-sec h-bm-uit-sec" aria-labelledby="bm-uit-h">
    <header class="h-sec-kop h-in">
      <div>
        <p class="h-pil"><span>{KOP.geleverdPil}</span></p>
        <h2 id="bm-uit-h" class="h-kop h-h2"><span class="l">{KOP.uit[0]}</span> {KOP.uit[1]}</h2>
      </div>
    </header>
    <ul class="h-bm-uit" role="list">
      {EXAMPLES.map((photo, i) => (
        <li class="h-well h-in" style={`--d:${i}`}>
          <img src={photo.src} alt={`${c.outAlt} ${i + 1}`} loading="lazy" decoding="async" width={photo.w} height={photo.h} />
        </li>
      ))}
    </ul>
  </section>

  {/* ── 3 · WAT HET IS EN WAT HET KOST, NAAST ELKAAR ─────────────────────── */}
  <section class="h-sec h-bm-wk-sec" aria-labelledby="bm-nota">
    <div class="h-bm-wk">
      <div class="h-bm-wat h-in">
        <h2 id="bm-nota" class="h-kop h-h2"><span class="l">{KOP.wat[0]}</span> {KOP.wat[1]}</h2>
        <p class="h-bm-zin">{c.notALead}</p>
        <ul class="h-bm-props" role="list">
          {c.props.map((p) => <li><b>{p[0]}</b><span>{p[1]}</span></li>)}
        </ul>
        <p class="h-bm-regel"><b>{c.fitWhereH}</b> {c.fitWhere.map((w) => w[0]).join(' · ')}</p>
        <p class="h-bm-regel">{c.genKort} <a class="h-link" href={lp('/compare#ai-tools')}>{c.genCta}<span class="h-cirkel h-cirkel-mini" set:html={ik('pijl')} /></a></p>
      </div>
      <aside class="h-bm-kost h-in" style="--d:1" aria-labelledby="bm-kost">
        <h2 id="bm-kost" class="h-kop h-h3">{c.costH}</h2>
        <p class="h-bm-bedrag">
          <span class="h-pil h-pil-wit"><span>{KOP.kostPil}</span></span>
          <b class="h-getal">{brandModel.price}</b>
          <span class="h-bm-eenheid">{brandModel.unit} · {c.costSetupVat}</span>
        </p>
        <p class="h-bm-dekt">{c.costIncludes}</p>
        <ul class="h-bm-vink" role="list">
          {brandModel.includes.map((f) => <li><i set:html={ik('check')} /><span>{f}</span></li>)}
        </ul>
        <p class="h-bm-zin h-bm-klein">{c.costSequence}</p>
        <p class="h-bm-zin h-bm-klein">{c.costFree} <a class="h-bm-a" href={lp('/pricing')}>{c.costCta}</a></p>
      </aside>
    </div>
  </section>

  {/* ── 4 · HOE HET TOT STAND KOMT ──────────────────────────────────────── */}
  <section class="h-sec h-bm-proces-sec" aria-labelledby="bm-proces">
    <div class="h-st-band h-in">
      <span class="h-korrel" aria-hidden="true"></span>
      <header class="h-st-band-kop">
        <p class="h-pil h-pil-wit"><span>{KOP.procesPil}</span></p>
        <h2 id="bm-proces" class="h-kop h-h2"><span class="l">{KOP.proces[0]}</span> {KOP.proces[1]}</h2>
      </header>
      <ol class="h-st-stappen" role="list">
        {steps.map((s, i) => (
          <li class="h-st-stap" style={`--d:${i}`}>
            <p class="h-nr" aria-hidden="true"><b>{DRIE(i + 1)}</b><i></i><span>/ {DRIE(steps.length)}</span></p>
            <span class="h-st-stap-naam">{s[0]}</span>
            <span class="h-bm-stap-zin">{s[1]}</span>
          </li>
        ))}
      </ol>
      <div class="h-bm-ruil">
        <div class="h-bm-ruil-kaart">
          <h3 class="h-bm-ruil-kop">{c.giveH}</h3>
          <ul class="h-bm-vink" role="list">{c.give.map((g) => <li><i set:html={ik('check')} /><span set:html={g[1]} /></li>)}</ul>
        </div>
        <div class="h-bm-ruil-kaart">
          <h3 class="h-bm-ruil-kop">{c.getH}</h3>
          <ul class="h-bm-vink" role="list">{c.get.map((g) => <li><i set:html={ik('check')} /><span set:html={g[1]} /></li>)}</ul>
        </div>
      </div>
      <div class="h-bm-check">
        <span class="h-bm-check-i" aria-hidden="true" set:html={ik('schild')} />
        <div>
          <h3 class="h-bm-ruil-kop">{CHECK.kop}</h3>
          <p class="h-bm-zin">{CHECK.zin} <a class="h-bm-a" href={lp('/terms')}>{CHECK.link}</a></p>
        </div>
      </div>
    </div>
  </section>

  {/* ── 5 · DE NEGEN RICHTINGEN ─────────────────────────────────────────── */}
  <section class="h-sec h-bm-richting-sec" aria-labelledby="bm-richting">
    <header class="h-sec-kop h-in">
      <div>
        <p class="h-pil"><span>{KOP.richtingPil}</span></p>
        <h2 id="bm-richting" class="h-kop h-h2"><span class="l">{KOP.richting[0]}</span> {KOP.richting[1]}</h2>
      </div>
      <p class="h-bm-kopzin">{c.dirLead}</p>
    </header>
    <ul class="h-bm-richtingen" role="list">
      {directions.map((d, i) => (
        <li class="h-in" style={`--d:${i % 3}`} title={d[2]}><span class="h-bm-letter" aria-hidden="true">{d[0]}</span><b>{d[1]}</b></li>
      ))}
    </ul>
  </section>

  {/* ── 6 · DE STANDAARDBIBLIOTHEEK — #standard blijft het anker ─────────── */}
  <section class="h-sec h-bm-bieb-sec" id="standard" aria-labelledby="bm-bieb">
    <div class="h-bm-bieb h-in">
      <div class="h-bm-bieb-woord">
        <h2 id="bm-bieb" class="h-kop h-h3">{c.libH}</h2>
        <p class="h-bm-zin">{c.libNote}</p>
      </div>
      <a class="h-knop h-knop-lijn" href={lp('/models')}>{c.libAllCta}</a>
    </div>
  </section>

  {/* ── 7 · HET SLOT ─────────────────────────────────────────────────────── */}
  <section class="h-sec h-lk-slot-sec" aria-labelledby="bm-slot">
    <div class="h-lk-slot h-in">
      <span class="h-korrel" aria-hidden="true"></span>
      <h2 id="bm-slot" class="h-kop h-h2"><span class="l">{KOP.slot[0]}</span> {KOP.slot[1]}</h2>
      <p class="h-acties">
        <a class="h-knop h-knop-inkt" href={lp('/start/brand-model')}>{c.ctaStart}<span class="o" set:html={ik('rechts')} /></a>
        <a class="h-knop h-knop-lijn" href={lp('/pricing')}>{c.ctaPricing}</a>
      </p>
      <ServiceSwitch current={['brand-model']} lang={lang} class="h-lk-diensten" />
    </div>
  </section>
</div>
<HalBeweging />
