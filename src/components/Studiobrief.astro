---
/*
 * VISUAILS — het aanmeldveld voor de Studiobrief. 23 september 2026.
 *
 * Lucas koos, gevraagd naar de vorm: *"Studiobrief, hooguit één per maand"*, met
 * als eis dat het niet sales-achtig wordt — VISUAILS verkoopt aan bedrijven.
 * Daarom zegt het blok precies drie dingen en niets meer: wat je krijgt (nieuwe
 * looks, wat er verandert), hoe vaak (hooguit één keer per maand), en wat je
 * níét krijgt (geen acties). Geen "exclusief", geen "mis niets", geen korting.
 *
 * DRIE PLEKKEN, één component: de voettekst (`voet`, donker, elke pagina),
 * /guides (`gidsen`) en /editions (`editions`). `bron` gaat mee naar de server en
 * belandt in de toestemmingsrij, zodat Lucas later ziet waar het werkt.
 *
 * ZONDER JAVASCRIPT werkt het ook: het formulier post, de server stuurt terug
 * naar deze pagina met #brief-ok-<bron>, en de bevestiging staat al in de HTML
 * en wordt met :target zichtbaar. Met JavaScript wisselt het blok ter plekke.
 * Zie functions/api/studiobrief.js.
 */
import { localizedPath } from '../i18n/ui.js';

interface Props {
  lang: 'en' | 'nl';
  bron: 'voet' | 'gidsen' | 'editions';
  /** `donker` voor de voettekst en de kamer; `licht` voor een paneel. */
  vorm?: 'donker' | 'licht';
  /** Een eigen kop, voor een plek waar de brief om iets specifieks gaat (Editions). */
  kop?: string;
  zin?: string;
}
const { lang, bron, vorm = 'licht', kop, zin } = Astro.props;
const nl = lang === 'nl';
const id = `studiobrief-${bron}`;

const c = nl ? {
  kop: 'De Studiobrief',
  zin: 'Hooguit één mail per maand: nieuwe looks en wat er bij VISUAILS verandert. Geen acties.',
  label: 'Je e-mailadres',
  melding: 'Vul je e-mailadres in: daar sturen we de Studiobrief naartoe.',
  voorbeeld: 'naam@jouwmerk.nl',
  knop: 'Aanmelden',
  bezig: 'Even…',
  ok: 'Je staat erop. Er staat een bevestiging in je inbox.',
  fout: 'Dat lukte niet. Klopt het adres? Probeer het anders zo nog eens.',
  noot: 'Afmelden kan onderaan elke brief.',
  privacy: 'Privacy',
} : {
  kop: 'The Studio letter',
  zin: 'One email a month at most: new looks and what changes at VISUAILS. No promotions.',
  label: 'Your email address',
  melding: 'Fill in your email address: that is where the Studio letter goes.',
  voorbeeld: 'name@yourbrand.com',
  knop: 'Sign up',
  bezig: 'One moment…',
  ok: 'You are on the list. A confirmation is in your inbox.',
  fout: 'That did not work. Is the address right? Otherwise try again in a moment.',
  noot: 'Unsubscribe at the bottom of every letter.',
  privacy: 'Privacy',
};
---

<form
  class:list={['sb', `sb-${vorm}`]}
  id={id}
  action="/api/studiobrief"
  method="post"
  data-studiobrief
  data-bezig={c.bezig}
  aria-labelledby={`${id}-kop`}
>
  <input type="hidden" name="lang" value={lang} />
  <input type="hidden" name="bron" value={bron} />

  <div class="sb-woord">
    <p class="sb-kop" id={`${id}-kop`}>{kop || c.kop}</p>
    <p class="sb-zin">{zin || c.zin}</p>
  </div>

  <div class="sb-rechts">
    <div class="sb-veld">
      <label class="sb-sr" for={`${id}-email`}>{c.label}</label>
      <input id={`${id}-email`} type="email" name="email" required data-melding={c.melding} autocomplete="email" inputmode="email" placeholder={c.voorbeeld} />
      <button type="submit">{c.knop}</button>
    </div>
    {/* Een veld dat een mens niet ziet en een bot wel invult. */}
    <p class="sb-hp" aria-hidden="true"><label>Website <input type="text" name="website_hp" tabindex="-1" autocomplete="off" /></label></p>
    <p class="sb-ok" id={`brief-ok-${bron}`} role="status">{c.ok}</p>
    <p class="sb-fout" id={`brief-fout-${bron}`} role="alert">{c.fout}</p>
    <p class="sb-noot">{c.noot} <a href={localizedPath(lang, '/privacy')}>{c.privacy}</a></p>
  </div>
</form>

<script>
  /* Met JavaScript: posten zonder te herladen, en het blok ter plekke laten
     omslaan. Zonder JavaScript doet het formulier hetzelfde met een omleiding
     en :target — zie de kop van dit bestand. Eén luisteraar op het document,
     zodat het ook na een zachte navigatie werkt zonder dubbel te binden. */
  const w = window as unknown as { __visBrief?: boolean };
  if (!w.__visBrief) {
    w.__visBrief = true;
    document.addEventListener('submit', async (e) => {
      const form = (e.target as HTMLElement)?.closest?.('form[data-studiobrief]') as HTMLFormElement | null;
      if (!form) return;
      e.preventDefault();
      const knop = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
      const was = knop?.textContent || '';
      if (knop) { knop.disabled = true; knop.textContent = form.dataset.bezig || '…'; }
      form.classList.remove('is-fout');
      try {
        const data = new FormData(form);
        data.set('mode', 'json');
        const res = await fetch(form.action, { method: 'POST', body: data, headers: { accept: 'application/json' } });
        const uit = await res.json().catch(() => ({ ok: false }));
        if (uit && uit.ok) form.classList.add('is-klaar');
        else form.classList.add('is-fout');
      } catch {
        form.classList.add('is-fout');
      } finally {
        if (knop) { knop.disabled = false; knop.textContent = was; }
      }
    });
  }
</script>

<style>
  .sb {
    --sb-inkt: var(--inkt, #0b0c0e);
    --sb-inkt-2: var(--inkt-2, #55585f);
    --sb-lijn: var(--lijn-sterk, rgb(11 12 14 / .22));
    --sb-veld: #fff;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: clamp(1rem, 3vw, 3rem);
    align-items: center;
    margin: 0;
    color: var(--sb-inkt);
  }
  .sb-donker {
    --sb-inkt: #f2f3f5;
    --sb-inkt-2: rgb(242 243 245 / .66);
    --sb-lijn: rgb(242 243 245 / .24);
    --sb-veld: rgb(242 243 245 / .06);
  }
  .sb-kop {
    margin: 0 0 .35rem;
    font-family: var(--kop2, var(--font-heading, inherit));
    font-weight: 500;
    font-stretch: 125%;
    text-transform: uppercase;
    letter-spacing: -.01em;
    font-size: clamp(1.05rem, 1.6vw, 1.3rem);
  }
  .sb-zin { margin: 0; color: var(--sb-inkt-2); font-size: .95rem; line-height: 1.55; max-width: 34rem; text-wrap: pretty; }
  .sb-rechts { display: grid; gap: .55rem; }
  .sb-veld { display: flex; gap: .65rem; }
  .sb-veld input {
    flex: 1 1 auto;
    min-width: 0;
    height: 46px;
    padding: 0 1rem;
    border: 1px solid var(--sb-lijn);
    border-radius: 999px;
    background: var(--sb-veld);
    color: var(--sb-inkt);
    font: inherit;
    font-size: 1rem;
  }
  .sb-veld input::placeholder { color: var(--sb-inkt-2); opacity: 1; }
  .sb-veld input:focus-visible { outline: 2px solid var(--accent, #4A1FFF); outline-offset: 2px; }
  /* De knop is de actie, dus violet — het enige violet in dit blok
     (KLEURENSCHEMA: violet alleen voor actie). */
  .sb-veld button {
    flex: 0 0 auto;
    height: 46px;
    padding: 0 1.3rem;
    border: 0;
    border-radius: 999px;
    background: var(--accent, #4A1FFF);
    color: var(--on-accent, #fff);
    font-family: var(--mono2, var(--font-mono, ui-monospace, monospace));
    font-size: .78rem;
    font-stretch: 82%;
    letter-spacing: .08em;
    text-transform: uppercase;
    cursor: pointer;
  }
  .sb-veld button:disabled { opacity: .7; cursor: default; }
  .sb-veld button:focus-visible { outline: 2px solid var(--sb-inkt); outline-offset: 2px; }
  .sb-noot { margin: 0; font-size: .8rem; color: var(--sb-inkt-2); }
  .sb-noot a { color: inherit; text-decoration: underline; text-underline-offset: .2em; }
  .sb-ok, .sb-fout { display: none; margin: 0; font-size: .95rem; line-height: 1.5; }
  .sb-fout { color: var(--sb-inkt); }
  /* Na het aanmelden: het veld weg, de bevestiging erin. Met JS via een klasse,
     zonder JS via het anker waar de server naar terugstuurt. */
  .sb.is-klaar .sb-veld, .sb:has(.sb-ok:target) .sb-veld { display: none; }
  .sb.is-klaar .sb-ok, .sb-ok:target { display: block; }
  .sb.is-fout .sb-fout, .sb-fout:target { display: block; }
  .sb-sr, .sb-hp { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }

  @media (max-width: 760px) {
    .sb { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 420px) {
    .sb-veld { flex-direction: column; }
    .sb-veld button { width: 100%; }
  }
</style>
