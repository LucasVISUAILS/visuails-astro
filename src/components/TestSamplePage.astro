---
/*
 * VISUAILS — de proefpagina, gedeeld door /test-sample en /nl/test-sample.
 *
 * ── 13 AUGUSTUS 2026: DE PAGINA WIJST NAAR DE STROOM DIE ER AL LAG ─────────
 *
 * Deze pagina had een eigen bestelformulier: twee stappen, een eigen uploader,
 * een eigen wizard in interactions.js, een eigen stijlkiezer en een eigen
 * modelkiezer — allemaal naast de stroom die /start al gebruikt. OrderFlow.astro
 * kreeg op 11 augustus een `mode="sample"` die dat allemaal overbodig maakte, en
 * die stand werd door geen enkele pagina meegegeven. Het formulier is daarom weg
 * en de component staat ervoor in de plaats.
 *
 * WAT ER BLIJFT is de verkooppagina eromheen: de kop, wat je krijgt, hoe het
 * werkt, en het blok over de foto die je stuurt. Die tekst hoort bij deze pagina
 * en bij geen andere. Vandaar `hero={false}` op de component: de kop staat hier
 * al, en twee koppen is er een te veel.
 *
 * ── ÉÉN COMPONENT SINDS 7 SEPTEMBER 2026 ─────────────────────────────────
 *
 * Het waren twee bestanden van 270 en 265 regels, tot op de woorden na identiek
 * — inclusief twee weigeringsblokken die het bestel-endpoint met een `?error=`
 * opent. Bij zo'n blok weegt uit elkaar lopen zwaarder dan bij een verhaal: het
 * is de tekst die iemand leest op het moment dat zijn bestelling NIET doorging.
 * Zelfde behandeling als /gallery, /thank-you, /guides, /upload-guidelines, /404
 * en /contact.
 *
 * ── DE "NIET DOEN"-KAART IS EEN "WAT HET MAKKELIJKER MAAKT" GEWORDEN ──────
 *
 * Lucas, over de fotogids die met een verzoek om een foto meegaat: *"Ik wil niet
 * dat klanten denken dat ze niet goed genoeg hun best hebben gedaan."* Diezelfde
 * regel geldt hier, en hier zelfs eerder: dit is de pagina waar iemand voor het
 * eerst iets van zichzelf opstuurt. Een kaart met "Niet doen" ernaast leest als
 * een cijfer voordat er iets ingeleverd is. De inhoud is dezelfde; alleen de kop
 * en de volgorde van de zin zijn omgedraaid.
 */
import OrderFlow from './order/OrderFlow.astro';
/* Allebei de kiezers, en niet één. Op /start ligt de dienst vast voordat de
   pagina laadt; hier is hij de eerste vraag van het formulier, dus moeten ze er
   allebei staan en laat pipeline.js er één zien. Zie syncStyle() daar. */
import StylePicker from './order/StylePicker.astro';
import BackgroundPicker from './order/BackgroundPicker.astro';
/* De modelkeuze, in een dichte vouw — zie de noot bij het blok zelf, onderaan
   het formulier. Dezelfde twee componenten als op /start/lifestyle, alleen daar
   zitten ze in LifestyleModelFold.astro met een label dat "in de carousel" zegt;
   dat woord klopt hier maar de helft van de tijd. */
import Disclose from './Disclose.astro';
import ModelPicker from './order/ModelPicker.astro';
import { waHref } from '../data/whatsapp.js';
import { TEST_SAMPLE, turnaround, CATALOG_IMAGES, LIFESTYLE_IMAGES, RESOLUTIE } from '../data/pricing.js';
import { localizedPath } from '../i18n/ui.js';
import '../styles/stijl22.css';

interface Props { lang: 'en' | 'nl'; }
const { lang } = Astro.props;
const nl = lang === 'nl';
const lp = (p: string) => localizedPath(lang, p);
const SAMPLE = nl ? TEST_SAMPLE.nl : TEST_SAMPLE.en;
const TIMING = turnaround('unattended', lang);

const c = nl ? {
  etiket: 'Probeer VISUAILS',
  h1: ['Test VISUAILS met ', '1 product'],
  lead: `Je levert aan zoals bij een gewone bestelling — voorkant en achterkant in elk geval, plus een detail- of draagfoto als je die hebt — en je krijgt ${SAMPLE.deliverable} terug. Precies wat je bij een betaalde bestelling per product krijgt. Hoe meer je meestuurt, hoe beter we het kunnen maken.`,
  pillen: [`${CATALOG_IMAGES} foto’s, of ${LIFESTYLE_IMAGES}`, `Slechts ${SAMPLE.price}`, 'Met de hand gecontroleerd'],

  /* ── ZES VINKJES WAREN ER DRIE — 10 september 2026 ─────────────────────────
     Lucas: *"ik wil de test sample zo kort mogelijk en compact mogelijk
     hebben."* Van de zes regels die hier stonden, stonden er drie al ergens
     anders op deze pagina:

       · "Kies je catalog: 4 foto's…" en "Kies je lifestyle: 3 foto's…" zijn
         letterlijk de twee keuzetegels van de eerste vraag van het formulier,
         die allebei hun aantal en hun inhoud dragen — én ze staan in de
         openingszin bovenaan;
       · "Eenmalig € 1, één proef per bedrijf" staat woordelijk in de kleine
         lettertjes onderaan.

     Wat overblijft zijn de drie dingen die NERGENS anders staan: waar het
     binnenkomt en hoe groot, dat je onze belichting en afwerking te zien krijgt,
     en dat er een specialist naar kijkt. Dat zijn ook precies de drie waarop
     iemand besluit. */
  krijg: [
    `Op ${RESOLUTIE.standaard} px aan de lange zijde, in VISUAILS Studio — met de rechtstreekse link in je mail.`,
    'Een echte blik op onze belichting, kadrering en afwerking.',
    'Door een specialist gecontroleerd voordat het je bereikt.',
  ],
  beeldAlt: 'Voorbeeld van een VISUAILS-visual, Glow-stijl',
  beeldBij: 'Jouw proef, met de hand gecontroleerd',

  stapEtiket: 'Van foto naar set',
  stapKop: 'Hoe de proef werkt',
  stappen: [
    ['Upload je productfoto’s', 'Voorkant en achterkant in elk geval, en een detail- of draagfoto als je die hebt.'],
    ['Kies een stijl', 'Kies de look en, als je wilt, een model — of laat ons kiezen.'],
    ['Wij maken het', 'Geproduceerd in onze studio, daarna met de hand gecontroleerd.'],
    ['Keur goed en download', `Je afgewerkte foto’s staan in VISUAILS Studio, met de link in je mail — ${TIMING.toLowerCase()}.`],
  ],

  gidsLink: 'Lees de fotogids',
  gidsPdf: 'Download de fotogids (pdf)',

  vormEtiket: 'De aanvraag',
  vormKop: 'Probeer VISUAILS met één product',
  vormLead: 'Hetzelfde formulier als bij een betaalde bestelling, met het aantal vast op één product.',
  weigerGebruiktKop: 'Je hebt VISUAILS al geprobeerd.',
  weigerGebruikt: ['Het is er één per bedrijf, dus er is niets besteld en er is niets afgeschreven — je hebt hier niet voor betaald. Klaar voor het echte werk? De ', 'volledige diensten', ' beginnen bij één product, zonder minimumafname — of ', 'stuur ons een bericht', ' als de eerste proef nooit is aangekomen, of als een collega hem heeft aangevraagd zonder het te zeggen.'],
  weigerMailKop: 'Dat e-mailadres kwam niet door.',
  weigerMail: 'Controleer het even op een typefout en stuur het opnieuw — het is het adres waar de afgeronde visual op binnenkomt.',
  /* ── 10 september 2026 ────────────────────────────────────────────────────
     Zonder soort weet de studio niet wát ze moet maken: een catalogset en een
     lifestyle-carousel zijn ander werk. Het formulier vraagt het als eerste en
     de radio is verplicht, dus dit haalt alleen iemand die met de hand post —
     maar dan hoort er een zin te staan en geen stilte. */
  weigerSoortKop: 'Kies eerst wat we gaan maken.',
  weigerSoort: 'Een catalogset of een lifestyle-carousel — dat is ander werk, dus we kunnen er niet één van kiezen. Zet het hieronder aan en stuur het opnieuw.',

  modelVouw: 'De foto op een model',
  modelStand: 'wij kiezen er een',

  fijndruk: `Eén proef per bedrijf · ${SAMPLE.feeNote} · meer betaal je niet voor de proef.`,

  slotEtiket: 'Liever even overleggen',
  slotH: 'Liever gewoon even overleggen?',
  /* De reactietijd en het aanbod om de bestelling samen te plaatsen stonden in
     de hulpregel onder de kleine lettertjes; die regel is samengevoegd met dit
     slot (zie de noot bij ts-fijndruk) en de belofte reist mee. */
  slotP: 'Stuur ons je product op WhatsApp en we helpen je een stijl kiezen — meestal binnen een uur antwoord op werkdagen, en we plaatsen de bestelling met je.',
  slotWa: 'Hoi VISUAILS, ik wil VISUAILS graag eerst proberen.',
  slotCta: 'WhatsApp',
  slotCta2: 'Start een bestelling',
} : {
  etiket: 'Test sample',
  h1: ['Test VISUAILS with ', '1 product'],
  lead: `You send what a normal order needs — front and back at least, plus a detail or worn shot if you have them — and back come ${SAMPLE.deliverable}. Exactly what a paid order gets you per product. The more you send, the better we can make it.`,
  pillen: [`${CATALOG_IMAGES} photos, or ${LIFESTYLE_IMAGES}`, `Just ${SAMPLE.price}`, 'Human quality-checked'],

  /* Zie de Nederlandse tegenhanger. */
  krijg: [
    `At ${RESOLUTIE.standaard} px on the long edge, in VISUAILS Studio — with the direct link in your email.`,
    'A real look at our lighting, framing and finish.',
    'Reviewed by a specialist before it reaches you.',
  ],
  beeldAlt: 'Example VISUAILS lifestyle image, Glow style',
  beeldBij: 'Your sample, human-checked',

  stapEtiket: 'From photo to set',
  stapKop: 'How the sample works',
  stappen: [
    ['Upload your product photos', 'Front and back at least, and a detail or worn shot if you have one.'],
    ['Choose a style', 'Pick the look and, if you like, a model — or let us choose for you.'],
    ['We create it', 'Produced in our studio, then quality-checked by hand.'],
    ['Approve and download', `Your finished images land in VISUAILS Studio, with the link in your email — ${TIMING.toLowerCase()}.`],
  ],

  gidsLink: 'Read the photo guide',
  gidsPdf: 'Download the photo guide (pdf)',

  vormEtiket: 'The request',
  vormKop: 'Request your test sample',
  vormLead: 'The same form a paid order uses, with the count fixed at one product.',
  weigerGebruiktKop: 'You’ve already had your test sample.',
  weigerGebruikt: ['It is one per business, so nothing has been ordered and nothing has been charged — you have not paid for this. Ready for the real thing? The ', 'full services', ' start at a single product, with no minimum order — or ', 'send us a message', ' if the first sample never arrived, or a colleague ordered it without telling you.'],
  weigerMailKop: 'That email address didn’t go through.',
  weigerMail: 'Check it for a typo and send it again — it is the address the finished images arrive at.',
  /* Zie de Nederlandse tegenhanger. */
  weigerSoortKop: 'Pick what we should make first.',
  weigerSoort: 'A catalog set or a lifestyle carousel — that is different work, so we cannot pick one for you. Choose below and send it again.',

  modelVouw: 'The on-model shot',
  modelStand: 'we choose one',

  fijndruk: `One sample per business · a ${SAMPLE.feeNote} · that’s all you pay for the sample.`,

  slotEtiket: 'Rather talk it through',
  slotH: 'Rather just talk it through?',
  /* Zie de Nederlandse tegenhanger. */
  slotP: 'Send us your product on WhatsApp and we’ll help you pick a style — we usually reply within the hour on weekdays and can place the order with you.',
  slotWa: 'Hi VISUAILS, I’d like to try a test sample.',
  slotCta: 'WhatsApp',
  slotCta2: 'Place a full order',
};

const vink = 'M20 6L9 17l-5-5';
---

<div class="s22 ts">

  {/* ── EN NU STAAT HET FORMULIER TWEEDE — 10 september 2026 ────────────────
      Lucas: *"een test sample moet snel en moeiteloos zijn voor een eerste
      klant."*

      Hier stond een SPRONGKNOP ("Naar het formulier", #aanvraag), en die was op
      7 september het antwoord op precies deze klacht: het eerste invulveld lag
      toen op 3.991 van 9.241 pixels. Op 8 september ging het formulier van zesde
      naar derde en werd dat 1.848. Beter, en nog steeds twee volle schermen
      lezen voor een proef van één euro — terwijl /start/catalog, dat véél meer
      vraagt, zijn eerste veld op 371 pixels heeft staan.

      De rest van de reparatie is de volgorde zelf, en die kan nu wél: de eerste
      vraag van het formulier IS "wat moeten we maken?", met bij allebei de
      keuzes wat je ervoor terugkrijgt. "Wat je krijgt" stond dus twee keer op
      deze pagina, en één daarvan stond in de weg. Die uitleg staat nu ONDER het
      formulier, waar hij is wat hij altijd al was: geruststelling voor wie hem
      zoekt, in plaats van een drempel voor wie al besloten heeft.

      De sprongknop gaat daarmee weg. Een knop die naar het blok eronder springt
      is geen kortere weg maar een extra handeling. */}
  <section class="paneel ts-open">
    <div class="paneel-kop">
      <p class="etiket">{c.etiket}</p>
      <h1 class="hoog">{c.h1[0]}<em>{c.h1[1]}</em></h1>
      <p class="lopend">{c.lead}</p>
    </div>
    <ul class="ts-pillen" role="list">
      {c.pillen.map((p) => <li class="mono">{p}</li>)}
    </ul>
  </section>

  {/* Weigeringen komen van /api/order terug als een redirect met ?error=…, omdat
      het versturen eindigt in een echte navigatie. initFormRefusal() in
      interactions.js haalt het `hidden` van het passende blok en zet de focus
      erop. In de opmaak en niet vanuit JS, zodat de tekst mee vertaald wordt met
      de rest van de pagina en in een diff te zien is.

      role="status" en niet role="alert": de bezoeker is zojuist genavigeerd, dus
      dit is de toestand van de pagina waar hij aankomt — niet iets dat hem
      onderbrak.

      Ze staan direct BOVEN het formulier en niet meer in een eigen sectie met
      een kop erboven: die sectie was 378 pixels voor twintig woorden, en de kop
      erin ("Vraag je proef aan") stond een paar centimeter boven een formulier
      dat zichzelf al aankondigt. */}
  <div class="ts-weigeringen" id="aanvraag">
    <div class="ts-refused" data-form-refusal="sample-used" role="status" tabindex="-1" hidden>
      <strong>{c.weigerGebruiktKop}</strong>
      <span>{c.weigerGebruikt[0]}<a href={lp('/start')}>{c.weigerGebruikt[1]}</a>{c.weigerGebruikt[2]}<a href={lp('/contact')}>{c.weigerGebruikt[3]}</a>{c.weigerGebruikt[4]}</span>
    </div>
    <div class="ts-refused" data-form-refusal="email" role="status" tabindex="-1" hidden>
      <strong>{c.weigerMailKop}</strong>
      <span>{c.weigerMail}</span>
    </div>
    <div class="ts-refused" data-form-refusal="sample-soort" role="status" tabindex="-1" hidden>
      <strong>{c.weigerSoortKop}</strong>
      <span>{c.weigerSoort}</span>
    </div>
  </div>

  <OrderFlow lang={lang} service="lifestyle" mode="sample" hero={false}>
    {/* ── ÉÉN VRAAG, EN DAARNA PRECIES ÉÉN VERVOLGVRAAG — 10 september 2026 ──
        Dat was het ontwerp van 13 augustus en het staat nog steeds in de kop van
        tidyTestSampleDetails() in /api/order: *"catalog of lifestyle, en daarna
        precies één vervolgvraag — bij catalog de achtergrond, bij lifestyle de
        look."*

        Hier stond `<Step1Options>`, en die legde er drie vragen bovenop:
        waar-verkoop-je (zes vinkjes), welk gezicht (elf knoppen) en de
        achtergrond. Samen met de beeldvorm erboven vroeg een proef van één euro
        VIJF keuzes uit zesentwintig knoppen — méér dan /start/catalog, dat er
        drie uit twintig vraagt voor een bestelling van honderden euro's.

        Alleen de achtergrondkiezer blijft, want dát is de vervolgvraag bij
        catalog. De andere twee hebben allebei een veilig antwoord dat de studio
        zelf neemt: geen gekozen gezicht betekent "wij kiezen er een" (zoals de
        knop het ook noemt), en waar je verkoopt bepaalt niets aan één proefbeeld
        — dat is een vraag voor je eerste échte bestelling. */}
    <StylePicker lang={lang} />
    <BackgroundPicker lang={lang} />
    {/* ── DE MODELKEUZE, DICHT — 10 september 2026 ──────────────────────────
        Lucas: *"waar kan de klant het model kiezen voor de test sample, dit
        moet hij ook kunnen invullen."*

        Hij was hier vanmorgen uit gevallen: `<Step1Options>` droeg hem, en die
        is weggehaald omdat er nog twee vragen aan vastzaten die de proef niet
        stelt. De keuze zelf hoorde te blijven — in de proef zit één foto op een
        model, of het nu een catalogset of een carousel wordt, en op /catalog en
        /lifestyle staat allebei dat je dat gezicht mag kiezen.

        DICHT, EN NIET OPEN, want de andere eis van vandaag staat er nog:
        *"zo min mogelijk moeite [...] en zo snel mogelijk geleverd."* Elf
        portretten zijn de grootste keuze van het formulier en de minst
        dringende — de standaard is een ECHT antwoord ("wij kiezen er een"), en
        die staat in de dichte regel zelf, zodat je kunt zien wat er gebeurt als
        je hem laat staan. Wie wél een gezicht in gedachten heeft, klapt open.
        Dat is exact de behandeling die /start/lifestyle er al aan geeft.

        `name="s1"` is dezelfde accordeongroep als de beeldvormvouw op /start:
        twee vouwen die elkaar sluiten in plaats van samen de pagina verlengen.
        Op deze pagina is dit voorlopig de enige. */}
    <div class="ts-modelvouw">
      <Disclose
        summary={c.modelVouw}
        name="s1"
        liveAttr="data-pl-sum-model"
        liveText={c.modelStand}
      >
        <ModelPicker lang={lang} soort="proef" />
      </Disclose>
    </div>
  </OrderFlow>

  <section class="paneel ts-krijg">
    <div class="ts-twee">
      {/* ── DRIE KEER DEZELFDE ZIN IS TWEE KEER TE VEEL — 10 september 2026 ──
          Lucas: *"ik wil de test sample zo kort mogelijk en compact mogelijk
          hebben."*

          Hier stond `krijgKop` — letterlijk TEST_SAMPLE.deliverable, "4
          catalogbeelden of een lifestyle-carousel van 3" — en dat staat al in de
          openingszin bovenaan, én in de eerste vraag van het formulier, waar
          allebei de keuzes hun eigen aantal dragen. Drie plekken, dezelfde zin.

          De alinea eronder ("dezelfde productie en menselijke controle…") zegt
          wat de eerste twee vinkjes in de lijst hieronder ook zeggen.

          Wat WEL uniek was, blijft: de lijst en het voorbeeldbeeld. Dat beeld is
          het enige bewijs op deze pagina en gaat nergens heen. */}
      <div>
        <ul class="ts-lijst" role="list">
          {c.krijg.map((r) => (
            <li>
              <svg viewBox="0 0 24 24" class="ts-i" aria-hidden="true"><path d={vink} /></svg>
              <span>{r}</span>
            </li>
          ))}
        </ul>
      </div>
      <figure class="kaart kaart-stil ts-beeld">
        <img src="/img/lifestyle-glow-03.webp" alt={c.beeldAlt} loading="lazy" decoding="async" width="768" height="1376" />
        <figcaption class="foto-pil mono">{c.beeldBij}</figcaption>
      </figure>
    </div>
  </section>

  {/* De vier stappen stonden in een `kamer` — een donkere sectie met veel lucht
      eromheen, 970 pixels voor 105 woorden. Op deze pagina is dat de duurste
      geruststelling van allemaal. Als `paneel` staan dezelfde vier stappen er
      nog, in de helft van de ruimte. De leadzin ("vier korte stappen van jouw
      foto tot een afgewerkte set") is weg: dat is een omschrijving van de lijst
      die eronder staat. */}
  <section class="paneel ts-stappen-paneel">
    <div class="paneel-kop">
      <p class="etiket">{c.stapEtiket}</p>
      <h2 class="hoog hoog-2">{c.stapKop}</h2>
    </div>
    <ol class="stappen ts-stappen" role="list">
      {c.stappen.map(([kop, tekst], i) => (
        <li>
          <span class="stap-nr" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <b>{kop}</b>
          <p class="lopend">{tekst}</p>
        </li>
      ))}
    </ol>
  </section>

  {/* ── DE FOTOSECTIE IS WEG — 10 september 2026 ─────────────────────────────
      Lucas: *"Laatste 580px van proef pagina kunnen weg."*

      Hier stonden twee lijstjes van vier ("Wat het meest helpt" en "Wat het ons
      makkelijker maakt") met daaronder twee links naar de fotogids. Goede raad,
      maar op de verkeerde plek: wie hier is heeft nog niets geüpload. Stap 2 van
      het formulier — het scherm waar hij zijn foto's daadwerkelijk kiest — draagt
      dezelfde gids al als download, en /upload-guidelines heeft het hele verhaal.

      Drie plekken voor dezelfde vier tips, waarvan deze de enige was die je leest
      vóórdat het ertoe doet. Wat blijft is de link in de kleine lettertjes
      hieronder: één regel, op de pagina, voor wie hem zoekt. */}




  {/* ── TWEE KEER WHATSAPP ONDER ELKAAR IS ÉÉN KEER TE VEEL — 10 sept 2026 ───
      Hier stonden twee blokken op elkaar die allebei hetzelfde aanboden. De
      kleine lettertjes eindigden met *"Vastgelopen? Stuur ons een bericht op
      WhatsApp"* en het slot eronder vroeg *"Liever even overleggen?"* met
      dezelfde WhatsApp-knop. Samen 562 pixels om twee keer hetzelfde te zeggen.

      De voorwaarde blijft waar hij hoort — klein, onder het formulier — en het
      aanbod om te helpen staat nog één keer, in het slot, waar het een knop is
      in plaats van een zin. */}
  <section class="paneel ts-fijndruk">
    <p class="mono ts-fijn">{c.fijndruk}</p>
    {/* Het enige dat uit de fotosectie hierboven meeverhuisd is: de gids zelf.
        Eén regel in plaats van 580 pixels, en het formulier biedt hem straks
        nog een keer aan op het scherm waar je je foto's kiest. */}
    <p class="mono ts-fijn ts-gidsregel">
      <a href={lp('/upload-guidelines')}>{c.gidsLink}</a>
      <a href={`/downloads/visuails-fotogids-${lang}.pdf`} download>{c.gidsPdf}</a>
    </p>
  </section>

  <section class="paneel paneel-slot ts-slot">
    <p class="etiket">{c.slotEtiket}</p>
    <h2 class="hoog hoog-2">{c.slotH}</h2>
    <p class="lopend">{c.slotP}</p>
    <div class="acties">
      <a class="knop knop-inkt" href={waHref(c.slotWa)} target="_blank" rel="noopener">{c.slotCta}</a>
      <a class="knop knop-lijn" href={lp('/start')}>{c.slotCta2}</a>
    </div>
  </section>

</div>

<style>
  .ts-open { padding-block: clamp(2.5rem, 6vw, 5rem); }
  .ts-pillen { display: flex; flex-wrap: wrap; gap: .6rem; list-style: none; padding: 0; margin: 2rem 0 0; }
  .ts-pillen li {
    padding: .4rem .9rem; border: 1px solid var(--lijn-sterk); border-radius: 999px;
    color: var(--inkt-2); font-size: .75rem;
  }

  .ts-twee { display: grid; gap: clamp(2rem, 4vw, 3.5rem); align-items: center; }
  @media (min-width: 900px) { .ts-twee { grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); } }

  .ts-lijst { display: grid; gap: .9rem; list-style: none; padding: 0; margin: 1.6rem 0 0; }
  .ts-lijst li { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: .8rem; align-items: start; }
