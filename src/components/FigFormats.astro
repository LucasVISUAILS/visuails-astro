---
// VISUAILS — FigFormats: one visual, every shape the channels ask for.
//
// "High-resolution, e-commerce-ready files, sized for shop listings,
// marketplaces and ads" is a true sentence that shows a reader nothing. The
// thing it is describing is a shape problem: a shop listing wants a square, a
// feed wants 4:5, a reel wants 9:16, a banner wants 16:9, and a marketplace
// wants 3:4 — and getting one visual to survive all five is most of the work.
// Five frames at their real aspect ratios, all the same height, say that in
// one glance.
//
// The frames are honest by construction: each box IS the ratio it is labelled
// with (aspect-ratio, not a hand-picked width), and the crop you see is the
// crop that ratio produces from this source. Nothing is faked, because there
// is nothing here to fake — the drawing is the claim.
//
// RATIOS LIVE HERE, NOT IN THE PAGE. A ratio is drawing, not copy: "1:1" is
// the same string in every language, and putting it in a bilingual COPY table
// would mean maintaining two identical copies of a number for no reason. The
// page supplies only the words — where each shape goes — and check_lang_parity
// covers those. `frames` is indexed against RATIOS, so a page that passes
// more labels than there are ratios wraps rather than rendering undefined.
interface Frame { t: string; }
interface Props {
  photo: string;
  alt: string;
  frames: Frame[];
  objectPosition?: string;
  note?: string;
}
const { photo, alt, frames, objectPosition = '50% 50%', note } = Astro.props;

const RATIOS = [
  { css: '1 / 1',  label: '1:1' },
  { css: '4 / 5',  label: '4:5' },
  { css: '9 / 16', label: '9:16' },
  { css: '16 / 9', label: '16:9' },
  { css: '3 / 4',  label: '3:4' },
];
---

<figure class="fmt">
  <div class="fmt-strip">
    {frames.map((f, i) => (
      <div class="fmt-item">
        <div class="fmt-frame" style={`aspect-ratio:${RATIOS[i % RATIOS.length].css}`}>
          <img src={photo} alt={i === 0 ? alt : ''} loading="lazy" style={`object-position:${objectPosition}`} />
        </div>
        <p class="fmt-cap">
          <span class="fmt-r">{RATIOS[i % RATIOS.length].label}</span>
          <span class="fmt-t">{f.t}</span>
        </p>
      </div>
    ))}
  </div>
  {note && <figcaption class="fmt-note">{note}</figcaption>}
</figure>

<style>
  .fmt { margin: 0; }

  /* Equal heights are the whole point — a ratio you cannot compare against
     the one beside it is just a picture. Width follows from aspect-ratio. */
  .fmt-strip {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: clamp(.7rem, 2vw, 1.4rem);
  }
  .fmt-item { display: flex; flex-direction: column; }

  .fmt-frame {
    height: clamp(122px, 17vw, 208px);
    border: 1px solid var(--ink);
    background: var(--surface);
    overflow: hidden;
  }
  .fmt-frame img { display: block; width: 100%; height: 100%; object-fit: cover; }

  /* No max-width: the caption must not be the thing that decides how wide an
     item is, or a 9:16 frame ends up padded out by its own label and stops
     being 9:16 to the eye. overflow-wrap:anywhere drops its min-content width
     to a single character so the frame always wins. */
  .fmt-cap { margin-top: .55rem; display: flex; flex-direction: column; gap: .1rem; overflow-wrap: anywhere; }
  .fmt-r { font-size: .74rem; font-weight: 600; color: var(--ink); font-variant-numeric: tabular-nums; }
  .fmt-t { font-size: .78rem; line-height: 1.35; color: var(--ink-3); }

  .fmt-note {
    margin-top: 1.3rem;
    padding-top: .8rem;
    border-top: 1px solid var(--line);
    font-size: .82rem;
    color: var(--ink-3);
    max-width: 62ch;
  }
</style>
