diff --git a/scripts/run-tests.mjs b/scripts/run-tests.mjs
new file mode 100644
index 0000000..2855e7a
--- /dev/null
+++ b/scripts/run-tests.mjs
@@ -0,0 +1,121 @@
+/*
+ * VISUAILS — de testketen, als lijst in plaats van als één regel.
+ *
+ * ── WAAROM DIT BESTAAT ──────────────────────────────────────────────────────
+ *
+ * De `test`-regel in package.json was vijfenvijftig `npm run test:x`-aanroepen
+ * aan elkaar geknoopt met `&&`, op één regel van ruim tweeduizend tekens. Dat
+ * werkt prima en leest niet: er valt niet aan te zien welke suites er zijn, in
+ * welke volgorde ze lopen, of er per ongeluk één twee keer in staat, en of er
+ * één ontbreekt. Een verschil van één woord in die regel is in een diff niet te
+ * vinden.
+ *
+ * Hier staat dezelfde keten als lijst. Meer doet dit bestand niet.
+ *
+ * ── DE VOLGORDE IS DE VOLGORDE ──────────────────────────────────────────────
+ *
+ * Regel voor regel dezelfde als de oude `&&`-keten, en dat is geen netheid maar
+ * een eis: sommige suites bouwen op wat een eerdere heeft neergezet, en
+ * `test:paths` staat vooraan omdat die het goedkoopst faalt. Wie hier iets
+ * verplaatst, verandert wat er getest wordt — niet alleen wanneer.
+ *
+ * ── EN HET GEDRAG IS HET GEDRAG ─────────────────────────────────────────────
+ *
+ * `&&` stopt bij de eerste die faalt en geeft diens afsluitcode door. Dat doet
+ * deze lus ook, en om dezelfde reden: een keten die doorloopt na een rode suite
+ * levert een muur uitvoer op waarin de eerste fout — de enige die je nodig hebt —
+ * naar boven is weggescrold.
+ *
+ * De suites worden aangeroepen als `npm run test:x` en niet als `node
+ * tests/x.test.mjs`. Dat is met opzet: `test:mollie` draait er twee achter
+ * elkaar, en het scheelt één plek waar de lijst met bestandsnamen zou moeten
+ * kloppen. package.json blijft de plek waar staat wat een suite is; dit bestand
+ * zegt alleen welke er lopen en in welke volgorde.
+ *
+ * `shell: true` omdat dit op Windows draait en `npm` daar `npm.cmd` is;
+ * `stdio: 'inherit'` zodat de uitvoer van elke suite direct doorloopt in plaats
+ * van pas aan het eind te verschijnen.
+ */
+import { spawnSync } from 'node:child_process';
+
+/** De keten, in volgorde. Eén naam per regel, zodat een diff één regel is. */
+const SUITES = [
+  'test:paths',
+  'test:vat',
+  'test:gate',
+  'test:invoice',
+  'test:invoicing',
+  'test:credit',
+  'test:invoices',
+  'test:feedback',
+  'test:offsite',
+  'test:delivery',
+  'test:nav',
+  'test:figures',
+  'test:promises',
+  'test:schema',
+  'test:retention',
+  'test:backup',
+  'test:funnel',
+  'test:legal',
+  'test:register',
+  'test:scaffold',
+  'test:planning',
+  'test:wipe',
+  'test:beheer',
+  'test:wrangler',
+  'test:order',
+  'test:geld',
+  'test:sample',
+  'test:sampleinv',
+  'test:business',
+  'test:request',
+  'test:upload',
+  'test:keuring',
+  'test:merkmodel',
+  'test:aanhef',
+  'test:video',
+  'test:ratio',
+  'test:refs',
+  'test:pay',
+  'test:code',
+  'test:account',
+  'test:signin',
+  'test:admin',
+  'test:mollie',
+  'test:stripe',
+  'test:diagnose',
+  'test:plans',
+  'test:abo',
+  'test:incasso',
+  'test:email',
+  'test:garments',
+  'test:subscribe',
+  'test:planqueue',
+  'test:nazicht',
+  'test:steps',
+  'test:a11y',
+  'test:zacht',
+];
+
+/* Twee keer dezelfde naam is geen dubbele controle maar een suite die twee keer
+   draait, en dat kost minuten zonder iets te bewijzen. Hier gevonden in plaats
+   van in een keten waar je hem niet ziet staan. */
+const dubbel = SUITES.filter((naam, i) => SUITES.indexOf(naam) !== i);
+if (dubbel.length) {
+  console.error(`run-tests: deze staan er twee keer in — ${[...new Set(dubbel)].join(', ')}`);
+  process.exit(1);
+}
+
+for (const suite of SUITES) {
+  const uit = spawnSync(`npm run ${suite}`, { shell: true, stdio: 'inherit' });
+  /* `status` is null als het proces door een signaal is gestopt (Ctrl-C). Dan is
+     0 teruggeven onwaar: er is niet gepasseerd, er is afgebroken. */
+  const code = uit.status === null ? 1 : uit.status;
+  if (code !== 0) {
+    console.error(`\nrun-tests: gestopt bij ${suite} (afsluitcode ${code}).`);
+    process.exit(code);
+  }
+}
+
+console.log(`\nrun-tests: ${SUITES.length} suites, allemaal groen.`);
