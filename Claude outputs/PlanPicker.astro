---
// VISUAILS — /start/plan. De pagina waar een abonnement echt begint.
//
// WAT HIER STOND EN WAAROM HET WEG IS
// HoldingPage.astro, met de regel *"the plans are a minimum-term commitment.
// Both are conversations. A card form here would be the studio pretending a
// decision has been made that has not."* Dat was waar zolang er geen mandaat
// bestond en Lucas elke aanvraag met de hand omzette. Sinds 17 augustus 2026 is
// er een SEPA-machtiging via Mollie, een maandboekhouding en een dashboard — en
// dan is de pagina die zegt "dit kan nog niet" zelf het obstakel geworden.
//
// De brand-model- en videopagina houden HoldingPage; voor die twee klopt de
// redenering nog. Deze niet meer.
//
// ── GEEN JAVASCRIPT ────────────────────────────────────────────────────────
//
// Radio's en een <select>, en een gewone POST. Geen prijsberekening in de
// browser: de bedragen komen uit plans.js en staan al in de tekst. Wat de klant
// kiest, wordt op de server opnieuw gecontroleerd — PLAN_IDS en TERM_IDS in
// handleSubscribeStart(). Een keuze die alleen in de browser bestaat, is geen
// keuze maar een suggestie.
//
// ── WAAROM DE POST NAAR /account/plan/start GAAT ───────────────────────────
//
// Een abonnement hangt aan een klant, en accounts ontstaan in dit systeem alleen
// door te bestellen. De handler zit dus in account.js, achter de sessiecontrole:
// wie niet is ingelogd, komt op de inlogpagina en niet op een betaalscherm. Zie
// de kop van src/lib/subscribe.js voor waarom dat de goede kant op is.
/* MANDATE_AMOUNT stond hier tot 4 september 2026: de machtiging kostte een euro
   en de tekst noemde hem. Sinds de eerste betaling de eerste maand is, noemt de
   tekst geen bedrag meer voor de machtiging; AMOUNT blijft voor de proefvisual. */
import {
  plans, euro, vatLabel, AMOUNT, planSaving,
  CUSTOM_MONTH_ID, CUSTOM_MONTH_MIN_PRODUCTS, CUSTOM_MONTH_MAX_PRODUCTS,
  customMonthTotal, addOnRate, CATALOG_IMAGES, LIFESTYLE_IMAGES, COMPLETE_IMAGES,
} from '../../data/pricing.js';
import { TERMS, TERM_IDS, monthlyCents, productsFor, clipsFor, hasBrandModel, term as termOf } from '../../data/plans.js';
import { planName } from '../../data/planNames.js';
/* Het maandbudget en wat je ermee kunt. Zie de kop van budget.js: dit is Lucas'
   creditsysteem, met de euro als eenheid omdat een vaste creditwaarde stukloopt op
   de clip die op elk plan hetzelfde kost terwijl een catalogset dat niet doet. */
import { planBudget } from '../../data/budget.js';
import { localizedPath } from '../../i18n/ui.js';
import { EU_COUNTRIES, OTHER_COUNTRIES } from '../../data/vat.js';

import Note from '../Note.astro';
/* Zonder deze regel zijn .paneel, .hoog en .knop lege klassen. */
import '../../styles/stijl22.css';
interface Props {
  lang: 'en' | 'nl';
}
const { lang } = Astro.props;
const nl = lang === 'nl';
const lp = (p: string) => localizedPath(lang, p);

const planList = plans(lang);

/* ── DE LANDENLIJST ────────────────────────────────────────────────────────
   Uit vat.js en niet overgetypt: dat is dezelfde lijst waar vatDecision() mee
   rekent, dus een land dat hier gekozen kan worden, kan daar ook beoordeeld
   worden. Nederland vooraan — dat zijn de meeste klanten en het is ook het
   enige land waar de btw sowieso 21% blijft — daarna de rest van de EU
   alfabetisch in de taal van de bezoeker, en daarna de landen erbuiten. */
const LANDEN = (() => {
  const naam = (l: any) => (nl ? l.nl : l.en) || l.en;
  const eu = EU_COUNTRIES.map((l: any) => ({ code: l.id, naam: naam(l) }));
  const nlEerst = eu.filter((l) => l.code === 'NL');
  const rest = eu.filter((l) => l.code !== 'NL').sort((a, b) => a.naam.localeCompare(b.naam, nl ? 'nl' : 'en'));
  const buiten = OTHER_COUNTRIES.map((l: any) => ({ code: l.id, naam: naam(l) }));
  return [...nlEerst, ...rest, ...buiten];
})();

// De fout uit de vorige poging, als die er is. Eén zin per reden, en `vol` is de
// enige die niet over een vergissing gaat maar over capaciteit — zie de
// capaciteitspoort in handleSubscribeStart().
const fout = String(Astro.url.searchParams.get('fout') || '');
const FOUTEN: Record<string, string> = nl ? {
  plan: 'Kies eerst een abonnement.',
  termijn: 'Kies eerst een termijn.',
  vol: 'Er is deze maand geen plek meer voor dit abonnement. Mail hello@visuails.com — dan zetten we je op de lijst voor de eerstvolgende plek.',
  maat: `Kies bij een maand op maat minstens ${CUSTOM_MONTH_MIN_PRODUCTS} en hoogstens ${CUSTOM_MONTH_MAX_PRODUCTS} producten, en niet meer carrousels dan producten.`,
  gegevens: 'Vul je naam, e-mailadres en adres in — die staan straks op de factuur.',
  opslaan: 'We konden je aanvraag niet vastleggen. Probeer het opnieuw, of mail hello@visuails.com.',
  mollie: 'Het betaalscherm ging niet open. Er is niets afgeschreven. Probeer het opnieuw, of mail hello@visuails.com.',
} : {
  plan: 'Choose a plan first.',
  termijn: 'Choose a term first.',
  vol: 'There is no room for this plan this month. Email hello@visuails.com and we will put you on the list for the next opening.',
  maat: `A custom month needs at least ${CUSTOM_MONTH_MIN_PRODUCTS} and at most ${CUSTOM_MONTH_MAX_PRODUCTS} products, and no more carousels than products.`,
  gegevens: 'Fill in your name, email address and address — they go on the invoice.',
  opslaan: 'We could not record your request. Try again, or email hello@visuails.com.',
  mollie: 'The payment screen did not open. Nothing has been charged. Try again, or email hello@visuails.com.',
};
const foutTekst = FOUTEN[fout] || '';

/*
 * ── DE FOUTMELDING WERD NOOIT GETOOND, 18 augustus 2026 ────────────────────
 *
 * astro.config.mjs zegt `output: 'static'`. Deze pagina wordt dus ÉÉN keer
 * gebouwd, en `Astro.url` is op dat moment de bouw-URL zonder querystring.
 * `fout` was daarmee altijd leeg en `{foutTekst && ...}` heeft nog nooit iets
 * gerenderd — op geen enkele bezoeker, in geen van beide talen.
 *
 * Wat daar achter wegviel is niet klein. subscribe.js stuurt hier vijf redenen
 * heen, en drie ervan gaan over geld:
 *
 *   · vol      — de agenda zit vol voor dit plan deze maand;
 *   · mollie   — het betaalscherm ging niet open, er is niets afgeschreven;
 *   · opslaan  — we konden de aanvraag niet vastleggen.
 *
 * Wat de klant zag was: klik op "Doorgaan naar de machtiging", even niets, en
 * dan hetzelfde formulier terug. Geen zin, geen reden, geen bevestiging dat er
 * niets is afgeschreven. De kop van handleSubscribeStart() zegt letterlijk dat
 * een technische fout hier een zin hoort te zijn; die zin bestond, hij kwam
 * alleen nooit op het scherm.
 *
 * ── WAAROM DIT MET EEN SCRIPT MOET EN NIET ANDERS ─────────────────────────
 *
 * De pagina statisch houden is de bedoeling — zie de kop van dit bestand: geen
 * prijsberekening in de browser, gewone POST, alles opnieuw gecontroleerd op de
 * server. Een SSR-route hiervan maken om één zin te tonen, is de hele stroom
 * verbouwen voor het uitzonderingsgeval.
 *
 * Dus: alle vijf de zinnen staan al in de HTML, elk verborgen en elk met zijn
 * eigen sleutel. Het script zet er hoogstens één aan.
 *
 * ── EN HET ECHOT DE URL NIET ──────────────────────────────────────────────
 *
 * Het voor de hand liggende script leest ?fout= en schrijft de waarde in de
 * pagina. Dat is een reflected-XSS met extra stappen. Hier wordt de parameter
 * alleen gebruikt om een element OP TE ZOEKEN dat wij zelf hebben gerenderd:
 * staat er geen element met die sleutel, dan gebeurt er niets. Er gaat geen
 * enkel teken uit de URL de DOM in.
 */
const FOUT_IDS = Object.keys(FOUTEN);

/* ── HERONTWERP, 4 SEPTEMBER 2026 ────────────────────────────────────────────
 *
 * Lucas: *"het abonnement ziet er op het moment super saai en niet waardevol
 * uit, dit mag je volledig aanpassen."*
 *
 * Wat er stond: vier grijze vakken onder elkaar met een radio, drie regels
 * uitleg per vak en zes bedragen; daaronder nog drie vakken en een alinea over
 * de machtiging. Alles even zwaar, niets dat zei wat je KRIJGT. Het duurste
 * formulier van de site zag eruit als een enquête.
 *
 * Wat er nu staat: links de drie keuzes als korte stappen (welk plan, welke
 * termijn, welke week), rechts één plaat in de accentkleur — dezelfde plaat als
 * op /plans en de homepage — die per keuze laat zien wat de maand oplevert:
 * hoeveel beelden, wat het los zou kosten, wat er nu gebeurt, en de knop.
 *
 * ── NOG STEEDS ZONDER SCRIPT ───────────────────────────────────────────────
 *
 * De plaat wisselt mee met de radio's via `:has()` in CSS: alle zeven varianten
 * (drie plannen × twee termijnen, plus de maand op maat) staan in de HTML en er
 * is er precies één zichtbaar. Geen rekenwerk in de browser — de bedragen
 * komen uit plans.js en pricing.js bij het bouwen, zoals hiervoor. Een browser
 * zonder `:has()` (2022 en ouder) ziet alle varianten onder elkaar; dat is
 * lelijker, niet fout. */
const CHECK = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>';

type Regel = { t: string; sub?: string };
type Variant = {
  plan: string; term: string; naam: string; kop: string;
  bedrag: string; eenheid: string; per?: string;
  regels: Regel[]; los?: string; bespaar?: string;
};

const kopVan = (id: string) => ({
  starter: nl ? 'Elke maand iets nieuws.' : 'Something new every month.',
  studio: nl ? 'Elke week iets te posten.' : 'Something to post every week.',
  brand: nl ? 'Je hele collectie, met je eigen gezicht.' : 'Your whole collection, with your own face.',
}[id] || '');

const varianten: Variant[] = [];
for (const p of planList) {
  for (const t of TERM_IDS) {
    const n = productsFor(p.id);
    const k = clipsFor(p.id);
    const cents = monthlyCents(p.id, t);
    const tt = termOf(t);
    const besp = planSaving(p.id);
    const beelden = n * COMPLETE_IMAGES;
    const regels: Regel[] = [
      { t: nl ? `${n} producten` : `${n} products`,
        sub: nl
          ? `elk een catalogset van ${CATALOG_IMAGES} en een lifestyle-carrousel van ${LIFESTYLE_IMAGES} — ${beelden} afgemaakte beelden`
          : `each a ${CATALOG_IMAGES}-image catalog set and a ${LIFESTYLE_IMAGES}-image lifestyle carousel — ${beelden} finished images` },
      ...(k ? [{ t: nl ? `${k} motion-clips` : `${k} motion clips`, sub: nl ? 'het product in beweging, 8 seconden' : 'the product in motion, 8 seconds' }] : []),
      ...(hasBrandModel(p.id, t) ? [{ t: nl ? 'Je eigen merkmodel' : 'Your own brand model', sub: nl ? 'één gezicht, alleen voor jouw merk' : 'one face, for your brand only' }] : []),
      { t: nl ? 'Een vaste week' : 'A fixed week',
        sub: nl
          ? (tt.perks.includes('standingWindow') ? 'dezelfde dagen, elke maand, vóór iedereen vrijgehouden' : 'elke maand voor jou gereserveerd vóór andere bestellingen')
          : (tt.perks.includes('standingWindow') ? 'the same days every month, held before anyone else' : 'reserved for you every month before other orders') },
      { t: nl ? `Ongebruikt schuift ${tt.rollover} ${tt.rollover === 1 ? 'maand' : 'maanden'} door` : `Unused rolls over ${tt.rollover} month${tt.rollover === 1 ? '' : 's'}` },
      ...(tt.perks.includes('priceLock') ? [{ t: nl ? 'Prijsslot' : 'Price lock', sub: nl ? 'gaat het tarief omhoog, dan blijft het jouwe staan' : 'if the rate goes up, yours stays' }] : []),
      { t: tt.fixed
          ? (nl ? `Looptijd ${tt.months} maanden` : `${tt.months}-month term`)
          : (nl ? 'Maandelijks opzegbaar' : 'Cancel any month'),
        sub: tt.fixed ? undefined : (nl ? 'zelf, in je dashboard' : 'yourself, in your dashboard') },
    ];
    varianten.push({
      plan: p.id, term: t, naam: planName(p.id, lang), kop: kopVan(p.id),
      bedrag: euro(cents / 100, lang),
      eenheid: nl ? 'per maand' : 'per month',
      per: tt.fixed && cents !== monthlyCents(p.id, 'monthly')
        ? (nl ? `op de jaartermijn — ${euro(monthlyCents(p.id, 'monthly') / 100, lang)} maandelijks` : `on the 12-month term — ${euro(monthlyCents(p.id, 'monthly') / 100, lang)} monthly`)
        : undefined,
      regels,
      los: besp ? (nl ? `Los besteld: ${euro(besp.onLadder, lang)} per maand.` : `Ordered one-off: ${euro(besp.onLadder, lang)} a month.`) : undefined,
      bespaar: besp ? (nl ? `Je bespaart ${euro(besp.saving, lang)}` : `You save ${euro(besp.saving, lang)}`) : undefined,
    });
  }
}

/* De maand op maat heeft geen vast bedrag; hij volgt het laddertarief over jouw
   aantal. Drie voorbeelden zeggen meer dan de regel: wat vijf, tien en twintig
   producten mét carrousel kosten, uitgerekend met dezelfde functie als de
   server gebruikt. */
const maatVanaf = euro(customMonthTotal({ products: CUSTOM_MONTH_MIN_PRODUCTS }).total, lang);
const maatVoorbeelden = [CUSTOM_MONTH_MIN_PRODUCTS, 10, 20].map((n) => {
  const r = customMonthTotal({ products: n, carousels: n });
  return { n, bedrag: euro(r.total, lang), beelden: r.images };
});

